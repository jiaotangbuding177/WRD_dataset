    # refer to decoded JSON field, not manufactured byte offsets in escaped JSON.
    for index,block in enumerate(re.split(r'\r?\n\r?\n',src)):
        begin=src.find(block,offset);offset=begin+len(block)
        payload='\n'.join(l[5:].lstrip(' ') for l in block.splitlines() if l.startswith('data:'))
        if not payload:continue
