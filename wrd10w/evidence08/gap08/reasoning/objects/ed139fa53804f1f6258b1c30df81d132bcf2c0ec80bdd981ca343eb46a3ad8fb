            content.append(d.get('content') or '')
            for c in d.get('tool_calls',[]):
                row=cs.setdefault(c.get('index',0),{'id':'','name':'','arguments':''});f=c.get('function',{})
                if c.get('id'):row['id']=c['id']
                row['name']+=f.get('name','');row['arguments']+=f.get('arguments','')
