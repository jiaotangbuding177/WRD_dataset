    return {'ids':sorted(ids),'reasoning_text':''.join(reasoning),'content_text':''.join(content),'tool_calls':[cs[k] for k in sorted(cs)],'finish_reasons':finished,'DONE_count':done,'original_R_frame_spans':spans}

