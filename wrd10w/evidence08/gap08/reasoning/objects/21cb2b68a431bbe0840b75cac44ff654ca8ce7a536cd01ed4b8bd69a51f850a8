import {appendFileSync as appendFailureWire} from 'node:fs';
/**
 * openai-handler.js — OpenAI 兼容 API 的请求编排。
 *
 * 职责（候选2 拆分后）：会话编排、三条消费路径的装配、工具挂起与断开取消
 * 两个生命周期。纯策略与纯构造已拆出：
 *   queue-policy.js    排队/频控策略（isRateLimited / rateLimitDelayMs /
 *                      parseQuotaResetAt / runWithRateLimitRetry）
 *   prompt-builder.js  提示词构建（sanitizePrompt / buildPrompt / messageToText）
 *   response-builder.js 响应构造（buildToolCallResponse / buildFinalResponse / buildUsage）
 *   sink-factory.js    三条路径共用的 sink 装配（六个相同处理器只存一份）
 *
 * 委托工具闭环（zcode 技能支持）：
 *   zcode 请求带 tools → 注册为 WorkBuddy delegate tools
 *   WorkBuddy 发出 tool_call → 暂停流，以 OpenAI tool_calls 返回给 zcode
 *   zcode 执行技能后带 tool 消息回来 → 回传结果 → 继续消费流
 *
 * 事件消费统一走 StreamDriver（见 stream-driver.js）：三条路径
 * （首轮流式 / 首轮非流式 / 工具回传续跑）通过 sink-factory 装配，循环只有一份。
 */

import { SessionManager } from './session-manager.js';
import { latestToolResult, snapshotRequest, canContinuePending, ownsPendingHistory, ownershipAnchor, canHandoffOwnedTool, historyDiagnostic } from './continuation-policy.js';
import { StreamDriver, sseChunk, SSE_DONE, sseUsageChunk, STREAM_SOFT_TIMEOUT_MS, resWriter } from './stream-driver.js';
import { createSink } from './sink-factory.js';
import { rateLimitDelayMs, runWithRateLimitRetry } from './queue-policy.js';
import { sanitizePrompt, buildPrompt, blocksToPlainText, messageToText } from './prompt-builder.js';
import { buildToolCallResponse, buildFinalResponse, buildUsage } from './response-builder.js';
import { tokenStats, estimateTokens, estimatePromptTokens } from './token-stats.js';
import { ConversationCache } from './conversation-cache.js';
import { createHash, randomUUID } from 'node:crypto';
import { requestOutputLimit, sameOutputLimit, openAiFinishReason } from './output-limits.js';
import { accountPool } from './account-pool.js';

// Do not commit a successful SSE reply until content/tool output actually exists.
function lazyStreamResponse(res, completionId, created, model) {
  let started = false;
  return {
    get writableEnded() { return res.writableEnded; },
    write(chunk) {
      if (res.writableEnded || res.destroyed) return;
      if (!started) {
        res.writeHead(200, {'Content-Type':'text/event-stream','Cache-Control':'no-cache','Connection':'keep-alive'});
        started = true;
        res.write(sseChunk(completionId, created, model, {role:'assistant'}));
      }
      res.write(chunk);
    },
    end() { res.end(); }
  };
}

// 向后兼容的再导出（index.js 与外部引用沿用旧入口；测试已改指新模块）
export { isRateLimited, rateLimitDelayMs, parseQuotaResetAt } from './queue-policy.js';
export { sanitizePrompt } from './prompt-builder.js';

const EMPTY_USAGE = { prompt_tokens: 0, completion_tokens: 0 };

// 远程图片抓取上限：超时 15s、单图 10MB，避免把 WorkBuddy 的 prompt 撑爆
const REMOTE_IMAGE_TIMEOUT_MS = 15 * 1000;
const MAX_REMOTE_IMAGE_BYTES = 10 * 1024 * 1024;

/**
 * 抓回远程图片并转成 data URL。
 * ACP image 块只接受 base64，uri 字段仅作显示名（WorkBuddy 不会去下载），
 * 所以客户端传 http(s) 图片时必须在这里取回。
 *
 * @throws 抓取失败/非图片/超限——让客户端看到明确原因，而不是让模型对着"看不见的图"瞎猜
 */
async function fetchImageAsDataUrl(url) {
  const res = await fetch(url, { signal: AbortSignal.timeout(REMOTE_IMAGE_TIMEOUT_MS) });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);

  const buf = Buffer.from(await res.arrayBuffer());
  if (buf.length > MAX_REMOTE_IMAGE_BYTES) {
    throw new Error(`图片 ${buf.length} 字节，超过上限 ${MAX_REMOTE_IMAGE_BYTES}`);
  }

  const mimeType = res.headers.get('content-type')?.split(';')[0]?.trim() || 'image/png';
  return `data:${mimeType};base64,${buf.toString('base64')}`;
}
// Native OpenClaw sessions have a fixed 30-minute budget. A delegated tool
// can legally wait within that entire budget (ask_user alone can wait 900s).
// Keep its exact owner for that window plus five minutes for result/cleanup;
// this changes only bridge retention, never the actor or model-call budget.
export const PENDING_TTL_MS = 35 * 60 * 1000;
// 客户端断开后延迟取消 WorkBuddy 任务的宽限期。WorkBuddy 的 cancel 机制只给
// 5s 宽限就强杀流（日志：sweepOrphanedPromptResponse），压缩上下文时 agent
// 来不及响应 → 客户端看到 "discarded before streaming retry"。这里断开后先等
// 30s 再 cancel，期间客户端重连（新请求到达）则撤销取消。
const DISCONNECT_CANCEL_GRACE_MS = 30 * 1000;

/**
 * 代理默认模型：客户端**没有**显式指定模型（或写 `auto` / `default`）时使用。
 *
 * 默认取免费的 `hy4-preview-f`。网关的 `auto` 会路由到收费模型——实测一条
 * 3.2k prompt 的极短请求扣 0.52 积分，而多数客户端习惯不带 model 或写 auto，
 * 放任不管等于默认烧积分。要恢复网关的自动路由，设
 * `BUDDY2API_DEFAULT_MODEL=auto`。
 */
export function resolveDefaultModel(env = process.env) {
  return env.BUDDY2API_DEFAULT_MODEL || 'hy4-preview-f';
}

/**
 * 解析客户端请求的模型：显式给了具体 id 就原样透传（不做映射/替换），
 * 只有缺省或 `auto`/`default` 才回落到代理默认模型。
 */
export function resolveRequestedModel(requested, fallback = resolveDefaultModel()) {
  return !requested || requested === 'auto' || requested === 'default' ? fallback : requested;
}

export class OpenAiHandler {
  constructor(gatewayUrl = null) {
    this.sessions = new SessionManager(gatewayUrl);
    console.log(JSON.stringify({event:'pending_tool_retention',pending_ttl_ms:PENDING_TTL_MS}));
    // key -> 挂起的工具调用状态（跨 HTTP 请求保持）
    this.pending = new Map();
    // key -> { timer, client, sessionId }：客户端断开后的延迟取消计时器。
    // 客户端断开不立即 cancel WorkBuddy 任务——立即 cancel 会丢弃 WorkBuddy
    // 已生成的部分输出（客户端表现为 "Partial assistant output was discarded
    // before a streaming retry"），且 WorkBuddy 只给 5s 宽限期，压缩上下文时
    // agent 来不及响应就被强杀。改为宽限期后取消；期间客户端重连则撤销。
    this.disconnectCancels = new Map();
    // 会话亲和缓存：多轮对话复用同一后端会话、只发增量，稳定命中后端
    // 前缀缓存（否则每请求新建会话约 40% 全量 miss，白烧 ~22k tokens/次）。
    // 可用 BUDDY2API_SESSION_REUSE=0 关闭。
    this.sessionReuse = process.env.BUDDY2API_SESSION_REUSE !== '0';
    this.conversations = new ConversationCache();
    // 会话 → 账号 的亲和映射：后端与账号绑定，**同一会话**粘住同一账号可命中
    // 云端按账号计的前缀缓存，也避免交替轮换导致后端进程反复冷启动。
    // 粒度是会话而不是 API key——zcode 这类客户端所有会话共用一个 key，
    // 按 key 粘会把所有会话压到同一个账号上。上限裁剪防无限膨胀。
    this.convAccounts = new Map();
  }

  /**
   * 会话标识：账号亲和的粒度单位。
   *
   * OpenAI 协议没有会话概念，每轮重发全量历史，可用两个稳定信号区分会话：
   *   1. `user` 字段（OpenAI 标准，客户端显式指定的端用户/会话标识）——最优先
   *   2. 首条 user 消息文本的指纹：同一会话每轮都带同样的首条消息（任务描述），
   *      不同会话的任务不同。**不用 system prompt**——同一 agent 的所有会话
   *      system prompt 相同，区分不出会话。
   * 都拿不到（无 user 消息，如纯图片首消息）→ 回退到 API key（旧行为）。
   *
   * @returns {string} convId
   */
  _conversationId(request, key) {
    if (typeof request?.user === 'string' && request.user) {
      return `${key}|u:${request.user}`;
    }
    const firstUser = Array.isArray(request?.messages)
      ? request.messages.find((m) => m?.role === 'user')
      : null;
    const text = firstUser ? messageToText(firstUser) : '';
    if (text) {
      const fp = createHash('sha1').update(text.slice(0, 2000)).digest('hex').slice(0, 16);
      return `${key}|f:${fp}`;
    }
    return key;
  }

  /**
   * 记录会话最近使用的账号（LRU 式：刷新插入顺序，超上限丢最旧的）。
   */
  _setConvAccount(convId, accountId) {
    if (!convId || !accountId) return;
    const MAX_CONV_ACCOUNTS = 500;
    if (!this.convAccounts.has(convId) && this.convAccounts.size >= MAX_CONV_ACCOUNTS) {
      let drop = Math.floor(MAX_CONV_ACCOUNTS / 5);
      for (const k of this.convAccounts.keys()) {
        this.convAccounts.delete(k);
        if (--drop <= 0) break;
      }
    }
    this.convAccounts.delete(convId);
    this.convAccounts.set(convId, accountId);
  }

  /**
   * Handle /v1/models endpoint
   */
  async handleListModels(key = 'default') {
    let cached = this.sessions.getModels(key);
    // 缓存为空（服务刚启动，或该 key 从未发过对话请求）→ 主动连网关
    // 通过 session/new 拉取真实模型列表；失败才退回硬编码兜底值。
    if (cached.length === 0) {
      try {
        // Repeated readiness probes must share one cold start, not launch a
        // new CodeBuddy process every time an HTTP probe times out.
        this._modelDiscovery ||= new Map();
        if (!this._modelDiscovery.has(key)) {
          const pending = (async () => {
            const session = await this.sessions.acquire(key, { needsTools: this._needsTools(false) });
            this.sessions.release(key, session.poolId);
            return this.sessions.getModels(key);
          })().finally(() => this._modelDiscovery.delete(key));
          this._modelDiscovery.set(key,pending);
        }
        cached = await this._modelDiscovery.get(key);
      } catch (e) {
        console.warn(`[buddy2api] 获取真实模型列表失败，使用兜底列表: ${e.message}`);
      }
    }
    const now = Math.floor(Date.now() / 1000);
    const source = cached.length > 0 ? cached : FALLBACK_MODELS;

    return {
      object: 'list',
      data: source.map(m => ({
        id: m.id,
        object: 'model',
        created: now,
        owned_by: 'workbuddy',
        permission: [],
        root: m.id,
        parent: null,
        ...(m.name && m.name !== m.id ? { name: m.name } : {}),
        // 非标准扩展字段：网关的计费系数（x0.00 即免费）。
        // 仅在网关标注时附带——缺省**不等于**免费，auto 就属于未标注但仍计费。
        ...(m.coefficient != null
          ? { pricing: { coefficient: m.coefficient, free: m.free === true } }
          : {})
      }))
    };
  }

  /**
   * Handle /v1/chat/completions endpoint
   */
  async handleChatCompletions(request, res) {
    // Only a definite authentication refusal before any output can be retried
    // on another account. Never replay a successful or uncertain model result.
    const failedAccounts = new Set();
    const limit = Math.max(1, accountPool.accounts().length);
    for (let attempt=0; attempt<limit; attempt++) {
      try { return await this._handleChatCompletionsOnce(request, res, failedAccounts.size > 0); }
      catch (error) {
        if (error.status !== 401 || !error.accountId || res?.headersSent || res?.writableEnded || res?.destroyed || failedAccounts.has(error.accountId)) throw error;
        failedAccounts.add(error.accountId);
        console.warn(JSON.stringify({event:'auth_account_failover',attempt:attempt+1,output_sent:false}));
        // pick() excludes the rejected credential across all eight services.
        if (attempt+1 >= limit) throw error;
        accountPool.pick();
      }
    }
  }

  async _handleChatCompletionsOnce(request, res, authRecovery = false) {
    const { messages, stream = false, tools, stream_options } = request;
    const outputTokenLimit = requestOutputLimit(request);
    // model 是本次实际使用的模型 id：客户端未指定或写 auto/default 时回落到
    // 代理默认模型（默认免费的 hy4-preview-f），显式给了具体 id 则原样透传。
    // 响应回显与 token 归因都用它（绝不能是 undefined——省略 model 的请求回显成
    // undefined 会破坏 OpenAI 响应的形状）。
    const model = resolveRequestedModel(request.model);
    // 客户端**原始**请求值，仅用于记账里的 requestedModel 字段（保留
    // "客户端写的是 auto" 这一信息，便于区分显式指定与走了默认）。
    const clientModel = request.model || 'auto';
    const hasTools = Array.isArray(tools) && tools.length > 0;
    // Authentication is shared by callers; a pending stream is not. Match a
    // returned result by its actual tool-call ID, including after compaction.
    const authScope = createHash('sha256').update(request.apiKey || 'default').digest('hex');
    const convId = this._conversationId(request, authScope) + '|cap:' + (outputTokenLimit ?? 'default');
    const latest = latestToolResult(messages);
    const toolResult = latest?.message || null;
    const pendingKey = toolResult ? [...this.pending.entries()].find(([ownerKey, state]) =>
      ownerKey.startsWith(authScope + '|') && state.toolCall?.toolCallId === toolResult.tool_call_id
    )?.[0] : null;
    if (latest?.technicalTail && !pendingKey && !authRecovery) throw new Error('No owned pending tool call matches tool_call_id');
    let continuationKey = null;
    if (pendingKey) {
      const state = this.pending.get(pendingKey);
      if (state.resuming) throw new Error('Owned pending tool call is already claimed');
      const strictHistory = ownsPendingHistory(state.wireRequest, request, toolResult.tool_call_id);
      if (!strictHistory) {
        const safeHandoff = canHandoffOwnedTool(state.ownerAnchor || ownershipAnchor(state.wireRequest), request, state.toolCall);
        console.warn(JSON.stringify({ event: 'owned_history_compatibility', action: safeHandoff ? 'full_fresh_handoff' : 'reject_without_cancel',
          ...historyDiagnostic(state.wireRequest, request) }));
        if (!safeHandoff) { try { if (process.env.NATIVE_FAILURE_WIRE) appendFailureWire(process.env.NATIVE_FAILURE_WIRE, JSON.stringify({at:new Date().toISOString(),previous:state.wireRequest,incoming:snapshotRequest(request),pendingTool:{name:state.toolCall?.name,args:state.toolCall?.args,toolCallId:state.toolCall?.toolCallId}})+'\n'); } catch {} throw new Error('Pending tool identity does not own this message history'); }
      }
      // A compatibility fallback never continues on a changed/unknown prefix.
      if (sameOutputLimit(state.outputTokenLimit, outputTokenLimit) && strictHistory && latest.technicalTail && canContinuePending(state.wireRequest, request, toolResult.tool_call_id)) {
        continuationKey = pendingKey;
      } else {
        // Changed controller/menu or real new user: terminate the exact old
        // owner and let the unchanged complete request take the fresh path.
        await this._retireOwnedPending(pendingKey, state);
      }
    }
    const key = continuationKey || (hasTools ? `${authScope}|tool:${randomUUID()}` : `${convId}|chat`);
    res?.setHeader?.('X-Buddy2api-Continuation', continuationKey ? 'continue' : pendingKey ? 'handoff' : 'fresh');
    // 是否需要内置工具的后端。决定 prompt 前缀（~22.7k 全量 vs ~3.2k 精简）
    // 与委托工具可用性：委托工具会被 --tools 白名单过滤，所以带 tools 的请求
    // 必须走全量后端。纯聊天走精简后端省下 19k+ 工具定义。
    const needsTools = this._needsTools(hasTools);
    // 流式末尾是否追加 usage chunk（OpenAI stream_options.include_usage 语义）
    const includeUsage = Boolean(stream_options?.include_usage);

    // 客户端重连（同 key 新请求到达）：撤销上次断开的延迟取消，
    // 让 WorkBuddy 侧任务继续（若它还没被取消）。
    const prevCancel = this.disconnectCancels.get(key);
    if (prevCancel) {
      clearTimeout(prevCancel.timer);
      this.disconnectCancels.delete(key);
      console.log(`[buddy2api] Client reconnected for key=${key}, cancelling pending disconnect-cancel`);
    }

    // 消息中带 tool 角色 → 这是工具结果回传，续跑挂起的 ACP 流
    if (continuationKey) {
      res?.setHeader?.('X-Buddy2api-Output-Cap', String(outputTokenLimit ?? 'default'));
      return this._continuePending(key, messages, model, stream, res, includeUsage, request);
    }

    // 正常路径：优先复用同一对话的后端会话（前缀缓存稳定命中），否则新建。
    const resolved = await this._resolveRemoteImages(messages);
    const blocks = sanitizePrompt(this._buildPrompt(resolved));
    const fullText = blocksToPlainText(blocks);
    // 复用资格：纯文本 + 无委托工具。工具流程的会话状态更复杂（挂起/续跑），
    // 且带 tools 的请求通常也就一两轮，复用收益低、风险高，直接排除。
    const reuseEligible = this.sessionReuse && fullText != null && !hasTools;

    let session = null;
    let prompt = blocks;
    if (reuseEligible) {
      const hit = this.conversations.lookup(key, fullText, model, Date.now());
      if (hit) {
        const existing = this.sessions.acquireExisting(key, hit.entry.poolId, hit.entry.sessionId, outputTokenLimit);
        if (existing) {
          // 复用成功：只发增量。模型已在原会话设置过（lookup 要求 model 一致）。
          session = existing;
          prompt = [{ type: 'text', text: hit.delta }];
        } else {
          // 承载会话的连接已不在池中/正忙/过期 → 丢弃条目，回退新建
          this.conversations.forget(key, hit.entry.poolId);
        }
      }
    }

    // 会话标识：账号亲和的粒度（同会话粘住同账号，见 _conversationId）
    if (!session) {
      // 会话级账号亲和：同一会话粘住上次的账号（冷却时 acquire 内部自动回退轮转）
      session = await this.sessions.acquire(key, { needsTools, preferredAccountId: this.convAccounts.get(convId) || null, convId, outputTokenLimit });

      if (model && model !== 'auto' && model !== 'default') {
        // 客户端指定的模型 id 一律原样透传（不在网关列表里的隐藏 id 也能用）。
        // 但要显式告警：网关不认识的 id 会让会话留在默认模型上继续跑，
        // 客户端以为在用免费模型、实际按默认模型（如 auto）计费且无任何报错。
        const known = session.models || [];
        const advertised = known.find(m => m.id === model);
        if (known.length > 0 && !advertised) {
          const free = known.filter(m => m.free).map(m => m.id);
          console.warn(
            `[buddy2api] ⚠ 模型 "${model}" 不在网关公布的模型列表中（共 ${known.length} 个）。` +
            `将原样透传；若网关不认识该 id，会话会继续使用默认模型 "${session.client.defaultModel || 'auto'}" 并按其价格计费。` +
            (free.length ? ` 免费模型：${free.join('、')}` : '')
          );
        }
        try {
          await session.client.setModel(model, session.sessionId);
        } catch (e) {
          if (/\b401\b|\b403\b|Authentication required|unauthorized/i.test(e.message || '')) {
            e.status=401; e.accountId=session.accountId;
            this.sessions.reportAccountHealth(session.accountId,{ok:false,reason:e.message,tokenFingerprint:session.credentialFingerprint});
            this.sessions.retire(key,session.poolId);
            throw e;
          }
          console.warn(
            `[buddy2api] ⚠ 设置模型 "${model}" 失败，会话继续使用默认模型 ` +
            `"${session.client.defaultModel || 'auto'}"（可能产生费用）：${e.message}`
          );
        }
      }

      // 注册 zcode 传来的工具为 WorkBuddy 委托工具
      if (hasTools) {
        try {
          await session.client.delegateTools(session.sessionId, tools);
        } catch (e) {
          console.warn('Failed to register delegate tools:', e.message);
        }
      }
    }

    // 记下实际服务本请求的账号，作为该会话下次请求的亲和偏好。
    // 兜底路径（首选账号冷却/池满）换账号后，映射跟着实际走，保证
    // "粘住的永远是当前真正有缓存的那个账号"。会话缓存命中路径也刷新
    // LRU 顺序。
    this._setConvAccount(convId, session.accountId);
    res?.setHeader?.('X-Buddy2api-Output-Cap', String(outputTokenLimit ?? 'default'));
    res?.setHeader?.('X-Buddy2api-Output-Cap-Mechanism', 'native-codebuddy-process-env-v1');

    // 终态标记：仅 onDone（自然结束）置 true，用于决定是否把本次完整文本
    // 记入会话亲和缓存（超时/出错/中断时后端上下文状态不确定，不复用）。
    session.wireRequest = snapshotRequest(request);
    const outcome = { completed: false };

    // 客户端断开：不立即取消 WorkBuddy 任务（会丢弃已生成输出，触发客户端
    // "discarded before streaming retry"），改为宽限期后延迟取消；
    // 期间客户端重连（同 key 新请求到达）则撤销取消。
    let aborted = false;
    const onClose = () => {
      if (res && res.writableEnded) return;
      aborted = true;
      this._scheduleDisconnectCancel(key, session.client, session.sessionId);
    };
    if (res && typeof res.on === 'function') {
      res.on('close', onClose);
    }

    try {
      if (stream) {
        await this._handleStreamingResponse(session, prompt, model, clientModel, res, () => aborted, key, includeUsage, outcome);
      } else {
        const result = await this._handleNonStreamingResponse(session, prompt, model, clientModel, res, () => aborted, key, outcome);
        return result;
      }
    } finally {
      if (res && typeof res.off === 'function') {
        res.off('close', onClose);
      }
      // 若流已结束（非挂起状态），释放连接
      // A disconnected request still owns its backend during the existing
      // cancellation grace. Releasing now clears leaseOwner before retirement.
      if (!this.pending.has(key) && !aborted) {
        if (reuseEligible) {
          if (outcome.completed && !aborted) {
            this.conversations.remember(
              key,
              { sessionId: session.sessionId, poolId: session.poolId, model },
              fullText,
              Date.now()
            );
          } else {
            this.conversations.forget(key, session.poolId);
          }
        }
        this.sessions.release(key, session.poolId);
      }
    }
  }

  /**
   * 续跑挂起的 ACP 流：回传工具结果后继续消费。
   */
  async _continuePending(key, messages, model, stream, res, includeUsage = false, wireRequest = null) {
    const state = this.pending.get(key);
    const toolMsg = [...messages].reverse().find(m => m.role === 'tool');
    if (!state?.toolCall || state.toolCall.toolCallId !== toolMsg?.tool_call_id || state.resuming) {
      throw new Error('No available owned pending tool call matches tool_call_id');
    }
    state.resuming = true;
    if (wireRequest) state.wireRequest = snapshotRequest(wireRequest);
    clearTimeout(state.timer);
    const resultText = this._messageToText(toolMsg) || 'Tool executed.';

    try {
      // 响应 _codebuddy.ai/delegateTool 请求（JSON-RPC result）
      await state.client.respondToToolCall(state.toolCall.reqId, resultText);
    } catch (e) {
      await this._retireOwnedPending(key, state, true);
      throw new Error(`Failed to submit tool result: ${e.message}`);
    }

    state.toolCall = null;
    state.resuming = false;

    // 客户端断开：不立即取消 WorkBuddy 任务（同首轮路径），宽限期后延迟取消
    let aborted = false;
    const onClose = () => {
      if (res && res.writableEnded) return;
      aborted = true;
      this._scheduleDisconnectCancel(key, state.client, state.sessionId);
    };
    if (res && typeof res.on === 'function') {
      res.on('close', onClose);
    }

    try {
      return await this._consumePending(key, state, model, stream, res, () => aborted, includeUsage);
    } finally {
      if (res && typeof res.off === 'function') {
        res.off('close', onClose);
      }
    }
  }

  // ===== 后端工具风味选择 =====

  /**
   * 本次请求是否需要内置工具的后端。
   *
   * 默认按请求自动：带 tools 的用全量后端（否则委托工具注册不上），纯聊天用
   * 精简后端（`--tools ""`，prompt 前缀 ~22.7k → ~3.2k）。可用
   * BUDDY2API_TOOLS=on（强制全量，旧行为）/ off（强制精简）覆盖。
   */
  _needsTools(hasTools) {
    const mode = (process.env.BUDDY2API_TOOLS || 'auto').toLowerCase();
    if (mode === 'on') return true;
    if (mode === 'off') return false;
    return Boolean(hasTools);
  }

  async _retireOwnedPending(key, state, alreadyClaimed = false) {
    if (this.pending.get(key) !== state || (!alreadyClaimed && state.resuming)) {
      throw new Error('Owned pending tool call is unavailable');
    }
    state.resuming = true; // synchronous claim before any await
    this.pending.delete(key);
    clearTimeout(state.timer);
    // Fence before cancellation: no concurrent request may lease this backend.
    const retired = this.sessions.fence(key, state.poolId);
    if (!retired) throw new Error('Exact request-owned lease could not be fenced');
    let timer;
    try {
      await Promise.race([
        Promise.resolve().then(() => state.client.cancelPrompt(state.sessionId)),
        new Promise(resolve => { timer = setTimeout(resolve, 1000); })
      ]);
    } catch { /* retired backend is never returned to the available pool */ }
    finally {
      clearTimeout(timer);
      let closeTimer;
      try {
        await Promise.race([
          Promise.resolve().then(() => state.iterator?.return?.()),
          new Promise(resolve => { closeTimer = setTimeout(resolve, 250); })
        ]);
      } catch { /* backend remains fenced */ }
      finally { clearTimeout(closeTimer); }
      await this.sessions.finishRetire(retired);
    }
  }

  // ===== 排队/频控（策略在 queue-policy.js；保留薄包装维持测试注入点） =====

  /**
   * 退避延迟计算（可被测试覆盖为短值）。
   */
  _rateLimitDelayMs(attempt) {
    return rateLimitDelayMs(attempt);
  }

  /**
   * 执行 prompt 事件流，遇到频控/排队时退避重试（排队机制）。
   * 策略实现见 queue-policy.runWithRateLimitRetry；此处只注入
   * pending 状态访问（hasPending）与测试可覆盖的退避计算。
   *
   * @returns {Promise<*>} driver.run() 的返回值
   */
  _runWithRateLimitRetry({ key, client, sessionId, prompt, isAborted, sink, state }) {
    return runWithRateLimitRetry({
      key, client, sessionId, prompt, isAborted, sink, state,
      hasPending: () => this.pending.has(key),
      delayMsFn: (attempt) => this._rateLimitDelayMs(attempt)
    });
  }

  // ===== 三条消费路径（sink 由 sink-factory 装配） =====

  /**
   * 消费挂起的流直到结束或下一个工具调用。
   * 与首轮两条路径共用 StreamDriver + sink 工厂；差异（超时与结束的
   * 响应形态、清理动作）由注入的 onTimeout/onDone 表达。
   */
  async _consumePending(key, state, model, stream, res, isAborted, includeUsage = false) {
    const completionId = `chatcmpl-${Date.now()}`;
    const created = Math.floor(Date.now() / 1000);

    // 挂起续跑沿用已积累的内容；后续增量直接写回 state（修复多轮工具调用
    // 时 content 丢失的隐患——旧代码复制到局部 output 后从不回写 state）。
    const baseState = state;
    const streamRes = stream ? lazyStreamResponse(res, completionId, created, model) : res;
    const write = resWriter(streamRes);

    const sink = createSink({
      emit: stream ? 'stream' : 'accumulate',
      state: baseState, key, completionId, created, model, res:streamRes,
      onToolCall: (toolEvent) => this._suspendForToolCall(baseState, toolEvent, { stream, completionId, created, model, res:streamRes, key }),
      onTimeout: () => {
        console.warn(`[buddy2api] Pending stream soft timeout (${STREAM_SOFT_TIMEOUT_MS}ms) for key=${key}`);
        this.pending.delete(key);
        this._recordUsage(baseState, model, { stream, status: 'timeout' });
        if (stream) {
          if (baseState.content) {
            write(sseChunk(completionId, created, model, { content: '\n\n[WorkBuddy 响应超时]' }, 'stop'));
          }
          write(sseChunk(completionId, created, model, {}, 'stop'));
          if (includeUsage) write(sseUsageChunk(completionId, created, model, buildUsage(baseState.usage)));
          write(SSE_DONE);
          res.end();
          // 与非流式分支对齐：连接释放回池（_takeIdlePool 有 hasInflightPrompt
          // 守卫，后端若还在跑旧任务不会被复用），否则池里少一个可用连接。
          this.sessions.release(key, baseState.poolId);
          return null;
        }
        // 非流式：把已积累的内容作为最终响应返回，而不是挂住客户端
        this.sessions.release(key, baseState.poolId);
        return this._buildFinalResponse(baseState, completionId, created, model);
      },
      onDone: (completion) => {
        // StreamDriver also exits here after client abort. Keep the pending
        // owner/lease intact until the unchanged disconnect-grace callback.
        if (isAborted?.()) {
          this._recordUsage(baseState, model, { stream, status: 'aborted' });
          return null;
        }
        baseState.finishReason = openAiFinishReason(completion?.stopReason);
        if (completion?.outputLimitReached && !completion.cancelConfirmed) this.sessions.retire(key,baseState.poolId);
        this.pending.delete(key);
        this.sessions.reportAccountHealth(baseState.accountId, { ok: true });
        this.sessions.release(key, baseState.poolId);
        this._recordUsage(baseState, model, { stream, status: isAborted?.() ? 'aborted' : 'completed' });
        if (stream) {
          write(sseChunk(completionId, created, model, {}, baseState.finishReason));
          if (includeUsage) write(sseUsageChunk(completionId, created, model, buildUsage(baseState.usage)));
          write(SSE_DONE);
          res.end();
          return null;
        }
        return this._buildFinalResponse(baseState, completionId, created, model);
      }
    });

    try {
      // The tool result resumed the original prompt on the server. Starting
      // sendPrompt here duplicates the old user input and races that stream.
      const result = await new StreamDriver({iterator:state.iterator,client:state.client,isAborted,sink,outputTokenLimit:state.outputTokenLimit ?? null}).run();
      if (!this.pending.has(key)) state.iterator?.return?.().catch?.(()=>{});
      return result;
    } catch (error) {
      // 流异常：清挂起 + 丢连接（与首轮路径一致），避免挂起表泄漏
      console.error('Pending stream error:', error);
      this._recordUsage(baseState, model, { stream, status: 'error', error: error.message });
      this.pending.delete(key);
      this.sessions.reportAccountHealth(baseState.accountId, { ok: false, reason: error.message, tokenFingerprint:baseState.credentialFingerprint });
      this.sessions.retire(key, baseState.poolId);
      error.accountId = baseState.accountId;
      throw error;
    }
  }

  /**
   * Handle streaming response（首轮，新建会话）
   */
  async _handleStreamingResponse(session, prompt, model, clientModel, res, isAborted, key, includeUsage = false, outcome = null) {
    const completionId = `chatcmpl-${Date.now()}`;
    const created = Math.floor(Date.now() / 1000);

    const streamRes = lazyStreamResponse(res, completionId, created, model);

    const state = {
      key,
      wireRequest: session.wireRequest,
      ownerAnchor: ownershipAnchor(session.wireRequest),
      client: session.client,
      sessionId: session.sessionId,
      outputTokenLimit: session.outputTokenLimit,
      clientModel, // 客户端原始请求值（记账 requestedModel 用，区别于实际使用的 model）
      poolId: session.poolId, // 连接池 ID，用于释放时精确定位本请求的连接
      accountId: session.accountId || null, // 后端绑定的账号（多账号池：上报健康用）
      credentialFingerprint:session.credentialFingerprint,
      prompt, // 重试（429 频控退避）时需要重新 sendPrompt
      iterator: null,
      startedAt: Date.now(), // token 统计：请求耗时
      content: '',
      reasoning: '',
      usage: { ...EMPTY_USAGE },
      toolCall: null,
      toolCallCount: 0,
      timer: null
    };

    const write = resWriter(streamRes);

    const sink = createSink({
      emit: 'stream',
      state, key, completionId, created, model, res:streamRes,
      onToolCall: (toolEvent) => this._suspendForToolCall(state, toolEvent, { stream: true, completionId, created, model, res:streamRes, key }),
      onTimeout: () => {
        console.warn(`[buddy2api] Stream soft timeout (${STREAM_SOFT_TIMEOUT_MS}ms) for key=${key}`);
        this._recordUsage(state, model, { stream: true, status: 'timeout' });
        write(sseChunk(completionId, created, model, { content: '\n\n[WorkBuddy 响应超时，请重试]' }, 'stop'));
        if (includeUsage) write(sseUsageChunk(completionId, created, model, buildUsage(state.usage)));
        write(SSE_DONE);
        res.end();
        // 不 invalidate：连接本身可能没问题，只是这次请求慢（如上下文压缩）
        session.client.cancelPrompt(session.sessionId).catch(() => {});
        return null;
      },
      onDone: (completion) => {
        state.finishReason = openAiFinishReason(completion?.stopReason);
        if (completion?.outputLimitReached && !completion.cancelConfirmed) this.sessions.retire(key,state.poolId);
        if (outcome) outcome.completed = state.finishReason === 'stop';
        this._recordUsage(state, model, { stream: true, status: isAborted?.() ? 'aborted' : 'completed' });
        write(sseChunk(completionId, created, model, {}, state.finishReason));
        if (includeUsage) write(sseUsageChunk(completionId, created, model, buildUsage(state.usage)));
        write(SSE_DONE);
        res.end();
        this.sessions.reportAccountHealth(state.accountId, { ok: true });
        // 释放统一交给 handleChatCompletions 的 finally——这里再释放一次会造成
        // 双重归还：第二次会把刚被下一个请求占用的后端标回空闲（串台源）。
        return null;
      }
    });

    try {
      return await this._runWithRateLimitRetry({
        key, client: session.client, sessionId: session.sessionId,
        prompt, isAborted, sink, state
      });
    } catch (error) {
      console.error('Streaming error:', error);
      this._recordUsage(state, model, { stream: true, status: 'error', error: error.message });
      this.pending.delete(key);
      this.sessions.reportAccountHealth(state.accountId, { ok: false, reason: error.message, tokenFingerprint:state.credentialFingerprint });
      this.sessions.retire(key, state.poolId);
      error.accountId = state.accountId;
      if (!res.headersSent) throw error;
      try {
        write(`data: ${JSON.stringify({ error: { message: error.message, type: error.status===401 ? 'authentication_error' : 'server_error', code:error.status || 502 } })}\n\n`);
        res.end();
      } catch (e) { /* client gone */ }
    }
  }

  /**
   * Handle non-streaming response（首轮，新建会话）
   */
  async _handleNonStreamingResponse(session, prompt, model, clientModel, res, isAborted, key, outcome = null) {
    const completionId = `chatcmpl-${Date.now()}`;
    const created = Math.floor(Date.now() / 1000);

    const state = {
      key,
      wireRequest: session.wireRequest,
      ownerAnchor: ownershipAnchor(session.wireRequest),
      client: session.client,
      sessionId: session.sessionId,
      outputTokenLimit: session.outputTokenLimit,
      clientModel, // 客户端原始请求值（记账 requestedModel 用，区别于实际使用的 model）
      poolId: session.poolId, // 连接池 ID，用于释放时精确定位本请求的连接
      accountId: session.accountId || null, // 后端绑定的账号（多账号池：上报健康用）
      credentialFingerprint:session.credentialFingerprint,
      prompt, // 重试（429 频控退避）时需要重新 sendPrompt
      iterator: null,
      startedAt: Date.now(), // token 统计：请求耗时
      content: '',
      reasoning: '',
      usage: { ...EMPTY_USAGE },
      toolCall: null,
      toolCallCount: 0,
      timer: null
    };

    const sink = createSink({
      emit: 'accumulate',
      state, key, completionId, created, model, res,
      onToolCall: (toolEvent) => this._suspendForToolCall(state, toolEvent, { stream: false, completionId, created, model, res, key }),
      onTimeout: () => {
        console.warn(`[buddy2api] Non-stream soft timeout (${STREAM_SOFT_TIMEOUT_MS}ms) for key=${key}`);
        this._recordUsage(state, model, { stream: false, status: 'timeout' });
        // 不 invalidate：只取消当前任务，连接保留复用（catch 会兜底清理）
        session.client.cancelPrompt(session.sessionId).catch(() => {});
        throw new Error(`WorkBuddy 响应超时（${Math.round(STREAM_SOFT_TIMEOUT_MS / 60000)}分钟无事件，可能是上下文压缩过慢）`);
      },
      onDone: (completion) => {
        state.finishReason = openAiFinishReason(completion?.stopReason);
        if (completion?.outputLimitReached && !completion.cancelConfirmed) this.sessions.retire(key,state.poolId);
        if (outcome) outcome.completed = state.finishReason === 'stop';
        this.sessions.reportAccountHealth(state.accountId, { ok: true });
        this._recordUsage(state, model, { stream: false, status: 'completed' });
        // 释放统一交给 handleChatCompletions 的 finally（同流式路径，避免双重归还）
        return this._buildFinalResponse(state, completionId, created, model);
      }
    });

    try {
      return await this._runWithRateLimitRetry({
        key, client: session.client, sessionId: session.sessionId,
        prompt, isAborted, sink, state
      });
    } catch (error) {
      console.error('Non-streaming error:', error);
      this._recordUsage(state, model, { stream: false, status: 'error', error: error.message });
      this.pending.delete(key);
      this.sessions.reportAccountHealth(state.accountId, { ok: false, reason: error.message, tokenFingerprint:state.credentialFingerprint });
      this.sessions.retire(key, state.poolId);
      error.accountId = state.accountId;
      throw error;
    }
  }

  // ===== 工具挂起（单一 seam） =====

  /**
   * 工具调用挂起的统一实现（方案 C 的"单一 seam"）。
   *
   * 三个路径（首轮流式 / 首轮非流式 / 工具续跑）的 onToolCall 全部收敛到这里：
   * 记录 toolCall → 写 tool_calls SSE（流式）→ 置 pending 表 → 挂超时 →
   * 返回挂起响应（非流式）或 null（流式已写完）。
   *
   * 后续新增工具调用相关特性（多工具并行、工具参数流式、工具取消）只需改这一处
   * 与 acp-client 的 delegateTools/approveToolCall/respondToToolCall。
   *
   * @returns {object|null} 非流式返回 OpenAI tool_calls 挂起响应；流式返回 null
   */
  _suspendForToolCall(state, toolEvent, { stream, completionId, created, model, res, key }) {
    // Tool-call IDs are opaque API identities. GLM clients normalize them to
    // short alphanumeric strings; emit that form from the start so returned
    // results retain strict ownership. The ACP reqId remains the RPC owner.
    toolEvent = {
      ...toolEvent,
      backendToolCallId: toolEvent.toolCallId,
      toolCallId: 'call' + randomUUID().replace(/-/g, '')
    };
    state.toolCall = toolEvent;
    state.toolCallCount = (state.toolCallCount || 0) + 1; // token 统计：工具调用次数
    this.pending.set(key, state);
    this._armPendingTimeout(key);

    if (!stream) {
      return this._buildToolCallResponse(state, toolEvent, completionId, created, model);
    }

    const write = resWriter(res);
    write(sseChunk(completionId, created, model, {
      tool_calls: [{
        index: 0, id: toolEvent.toolCallId, type: 'function',
        function: { name: toolEvent.name, arguments: JSON.stringify(toolEvent.args) }
      }]
    }));
    write(sseChunk(completionId, created, model, {}, 'tool_calls'));
    write(SSE_DONE);
    res.end();
    return null;
  }

  /**
   * 给挂起的工具调用设置超时，超时后取消并清理。
   */
  _armPendingTimeout(key) {
    const state = this.pending.get(key);
    if (!state) return;
    clearTimeout(state.timer);
    state.timer = setTimeout(() => this._onPendingTimeout(key), PENDING_TTL_MS);
  }

  /**
   * 挂起的工具调用超时回调（取消并清理）。
   * 单独拆出方法便于单测——不用真等 5 分钟。
   */
  _onPendingTimeout(key) {
    const s = this.pending.get(key);
    // 条目不存在（流程已正常完成/被回传）或已在回传中 → 无可取消。
    // 之前这里的守卫是 `s && !s.toolCall`——条目缺失时反而继续往下执行，
    // invalidate(key, undefined) 会按 key 定位到**其他请求正在占用的连接**
    // 并销毁之（完成后 5 分钟延迟引爆的串台源）。
    if (!s || !s.toolCall) return;
    console.warn(`[buddy2api] Pending tool call for key=${key} timed out, cancelling`);
    this._retireOwnedPending(key, s).catch(() => {});
  }

  // ===== token 消耗统计 =====

  /**
   * 请求终态时把本次 token 消耗记入 tokenStats（明细 + 按模型聚合）。
   *
   * 实际模型归因（`model` 字段）优先级：usage 事件报告（usage_update 若带 model
   * 字段，最准）> 客户端指定的 model 参数（非 auto/default 时）> 会话当前模型
   * （session/new 的 currentValue，setModel 成功后同步更新）> 客户端原始请求值。
   * 另一个字段 `requestedModel` 记的是客户端**原始**请求值，不做归因。
   *
   * token 数量口径：usage_update 上报了就用精确值（usage_source: 'reported'）；
   * 当前网关版本大多不回传 usage 事件，此时按 prompt/content/reasoning 文本
   * 估算（usage_source: 'estimated'，CJK 1 字≈1token，其余 4 字符≈1token），
   * 保证统计明细不为 0，但不含图片 token（图片按文本无法估）。
   *
   * 纯错误（无任何模型输出）不记账：429 频控等场景估算也为 0，记了只会
   * 污染按模型的请求计数。
   */
  _recordUsage(state, requestedModel, { stream, status = 'completed', error = null } = {}) {
    if (!state || state.usageRecorded) return;
    state.usageRecorded = true; // 一次请求只记一笔（非流式超时路径 onTimeout 后还会走 catch）

    const usage = state?.usage || EMPTY_USAGE;
    const reportedPrompt = Number(usage.prompt_tokens) || 0;
    const reportedCompletion = Number(usage.completion_tokens) || 0;
    const reported = reportedPrompt > 0 || reportedCompletion > 0;

    const promptTokens = reportedPrompt || estimatePromptTokens(state?.prompt);
    const completionTokens = reportedCompletion || estimateTokens((state?.content || '') + (state?.reasoning || ''));
    if (status === 'error' && promptTokens === 0 && completionTokens === 0) return;

    // 缓存与计费口径：网关 usage 带 cached_tokens / prompt_cache_miss_tokens /
    // credit 时透传。prompt_tokens 的大头（工具定义等固定前缀）命中前缀缓存后
    // 不计费，单看 prompt_tokens 会高估开销。
    const cachedTokens = Number(usage.cached_tokens) || 0;
    const cacheMissTokens = usage.cache_miss_tokens != null ? Number(usage.cache_miss_tokens) || 0 : undefined;
    const credit = usage.credit != null ? Number(usage.credit) || 0 : undefined;

    const actualModel = usage.model
      || (requestedModel && requestedModel !== 'auto' && requestedModel !== 'default' ? requestedModel : null)
      || state?.client?.defaultModel
      || requestedModel
      || 'auto';

    tokenStats.record({
      model: actualModel,
      // 客户端**原始**请求值，与 actualModel 区分：能看出"客户端写的是 auto /
      // 没写 model，实际用的是代理默认模型"。
      requestedModel: state?.clientModel ?? requestedModel ?? null,
      promptTokens,
      completionTokens,
      cachedTokens,
      cacheMissTokens,
      credit,
      usageSource: reported ? 'reported' : 'estimated',
      key: state?.key,
      status,
      stream,
      toolCalls: state?.toolCallCount || 0,
      durationMs: state?.startedAt ? Date.now() - state.startedAt : undefined,
      error
    });
  }

  // ===== 断开取消生命周期 =====

  /**
   * 客户端断开后延迟取消 WorkBuddy 任务。
   * 立即 cancel 会丢弃 WorkBuddy 已生成的部分输出（客户端表现为
   * "Partial assistant output was discarded before a streaming retry"），
   * 且 WorkBuddy 的 cancel 只给 5s 宽限就强杀流，压缩上下文时 agent
   * 来不及响应。改为宽限期（DISCONNECT_CANCEL_GRACE_MS）后取消；
   * 期间客户端重连（同 key 新请求）由 handleChatCompletions 撤销。
   */
  _scheduleDisconnectCancel(key, client, sessionId, graceMs = DISCONNECT_CANCEL_GRACE_MS) {
    const prev = this.disconnectCancels.get(key);
    if (prev) clearTimeout(prev.timer);
    const timer = setTimeout(() => {
      this.disconnectCancels.delete(key);
      console.warn(`[buddy2api] Client disconnected for key=${key} beyond grace (${graceMs}ms), cancelling WorkBuddy task`);
      const pending = this.pending.get(key);
      if (pending && pending.client === client && pending.sessionId === sessionId) {
        this._retireOwnedPending(key, pending, Boolean(pending.resuming)).catch(() => {});
      } else {
        const owned = [...this.sessions.pools.values()].find(p => p.key === key && p.client === client);
        if (owned) this.sessions.retire(key, owned.id);
        client.cancelPrompt(sessionId).catch(() => {});
        client.destroy?.();
      }
    }, graceMs);
    this.disconnectCancels.set(key, { timer, client, sessionId });
  }

  // ===== 薄委托（逻辑在 prompt-builder / response-builder；保留方法形态作为测试注入点） =====

  _buildPrompt(messages) {
    return buildPrompt(messages);
  }

  /**
   * 把 content 中的远程图片 URL（http/https）就地换成 data URL，交给 buildPrompt
   * 内联成 ACP image 块。无远程图片时原样返回（零开销，也不改动输入）。
   *
   * 失败直接抛出：图片是用户明确要求模型看的内容，抓不到就该报错，
   * 若静默丢弃会让模型在看不见图的情况下作答——正是本次要修的问题。
   */
  async _resolveRemoteImages(messages) {
    if (!Array.isArray(messages)) return messages;

    const pending = [];
    for (const msg of messages) {
      if (!msg || !Array.isArray(msg.content)) continue;
      for (const part of msg.content) {
        if (part?.type !== 'image_url') continue;
        const url = typeof part.image_url === 'string' ? part.image_url : part.image_url?.url;
        if (typeof url === 'string' && /^https?:\/\//i.test(url)) {
          pending.push({ part, url });
        }
      }
    }
    if (pending.length === 0) return messages;

    await Promise.all(pending.map(async ({ part, url }) => {
      const dataUrl = await fetchImageAsDataUrl(url);
      if (typeof part.image_url === 'string') part.image_url = { url: dataUrl };
      else part.image_url.url = dataUrl;
    }));

    return messages;
  }

  _messageToText(msg) {
    return messageToText(msg);
  }

  _buildToolCallResponse(state, toolEvent, completionId, created, model) {
    return buildToolCallResponse(state, toolEvent, completionId, created, model);
  }

  _buildFinalResponse(state, completionId, created, model) {
    return buildFinalResponse(state, completionId, created, model);
  }

  _buildUsage(usage) {
    return buildUsage(usage);
  }

  /**
   * 关闭：清空挂起状态并取消任务。
   */
  async close() {
    for (const [key, state] of this.pending.entries()) {
      clearTimeout(state.timer);
      await state.client.cancelPrompt(state.sessionId).catch(() => {});
    }
    this.pending.clear();
    for (const [, entry] of this.disconnectCancels) {
      clearTimeout(entry.timer);
      entry.client.cancelPrompt(entry.sessionId).catch(() => {});
    }
    this.disconnectCancels.clear();
    await this.sessions.close();
  }
}

