{"type": "message", "id": "c4cbcde6-2bfb-48e1-9cec-5be204a332a3", "parentId": "b9913ece-e8a1-4dc7-9da5-ab447deec96a", "timestamp": "2026-10-20T09:28:50.308Z", "message": {"role": "toolResult", "toolCallId": "calle7cda50a0b3e4713aa0c0395157a09f3", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\n参数化结构化Excel分析引擎（Workflow Reuse Distillation）\n\n分析模式：读xlsx -> 按request列映射/分组/聚合 -> 分档 -> SHA核验\n        -> 写analysis_result.json + receipt.json -> 按request可选生成md/docx报告。\n\nrequest.json 驱动一切：数据文件路径、列映射（名称->角色）、分组维度、分档阈值\n（label/min/max）、聚合函数、输出格式。request里未映射却被引用的角色如实记入\nreceipt.uncovered（不报错）；已映射且被引用的角色必须算出结果。\n\nCLI: python run.py --request <request.json路径> [--output-root <输出根目录>]\n依赖：openpyxl / python-docx / 标准库。\n\"\"\"\nimport argparse\nimport datetime\nimport hashlib\nimport json\nimport os\nimport sys\n\ntry:\n    import openpyxl\nexcept ImportError:\n    openpyxl = None\n\n\ndef now_iso():\n    return datetime.datetime.now().isoformat(timespec=\"seconds\")\n\n\ndef sha256_file(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        for chunk in iter(lambda: f.read(65536), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef to_number(v):\n    \"\"\"宽松数值化：None/空/不可解析 -> None。\"\"\"\n    if v is None:\n        return None\n    if isinstance(v, bool):\n        return None\n    if isinstance(v, (int, float)):\n        return float(v)\n    s = str(v).strip().replace(\",\", \"\").replace(\"%\", \"\")\n    if not s:\n        return None\n    try:\n        return float(s)\n    except ValueError:\n        return None\n\n\ndef load_sheet(path, sheet=None, header_row=1):\n    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)\n    ws = wb[sheet] if sheet else wb[wb.sheetnames[0]]\n    rows = list(ws.iter_rows(values_only=True))\n    sheet_name = ws.title\n    wb.close()\n    if not rows:\n        return sheet_name, [], []\n    header = rows[header_row - 1]\n    headers = []\n    for i, h in enumerate(header):\n        name = str(h).strip() if h is not None else \"\"\n        headers.append(name or \"__col_%d\" % (i + 1))\n    data = []\n    for r in rows[header_row:]:\n        if r is None or all(c is None or (isinstance(c, str) and not c.strip()) for c in r):\n            continue\n        rec = {}\n        for i in range(len(headers)):\n            rec[headers[i]] = r[i] if i < len(r) else None\n        data.append(rec)\n    return sheet_name, headers, data\n\n\ndef resolve_column_map(column_map):\n    \"\"\"column_map: {列名: 角色字符串 或 {role: ...}} -> {角色: 列名}\"\"\"\n    role2col = {}\n    for col, spec in (column_map or {}).items():\n        if isinstance(spec, str):\n            role2col[spec] = col\n        elif isinstance(spec, dict) and spec.get(\"role\"):\n            role2col[spec[\"role\"]] = col\n    return role2col\n\n\ndef aggregate(values, agg):\n    nums = [x for x in (to_number(v) for v in values) if x is not None]\n    nonempty = [v for v in values if v is not None and str(v).strip() != \"\"]\n    if agg == \"count\":\n        return len(nonempty)\n    if agg == \"count_distinct\":\n        return len({str(v).strip() for v in nonempty})\n    if not nums:\n        return None\n    if agg == \"sum\":\n        return sum(nums)\n    if agg == \"avg\":\n        return sum(nums) / len(nums)\n    if agg == \"min\":\n        return min(nums)\n    if agg == \"max\":\n        return max(nums)\n    raise ValueError(\"未知聚合函数: %s\" % agg)\n\n\nKNOWN_AGGS = {\"sum\", \"count\", \"count_distinct\", \"avg\", \"min\", \"max\"}\n\n\ndef classify(value, thresholds):\n    \"\"\"按 label/min/max 顺序匹配：min<=v<=max（None 表示不设界），返回首个命中的label。\"\"\"\n    if value is None:\n        return None\n    for t in thresholds:\n        lo = t.get(\"min\")\n        hi = t.get(\"max\")\n        if (lo is None or value >= lo) and (hi is None or value <= hi):\n            return t.get(\"label\", \"?\")\n    return None\n\n\ndef run_analysis(request, request_path, output_root_arg):\n    uncovered = []\n    checks = []\n\n    def add_check(name, ok, detail=\"\"):\n        checks.append({\"name\": name, \"status\": \"PASS\" if ok else \"FAIL\", \"detail\": detail})\n        return ok\n\n    data_file = request.get(\"data_file\")\n    sheet = request.get(\"sheet\")\n    header_row = int(request.get(\"header_row\", 1))\n    column_map = request.get(\"column_map\") or {}\n    role2col = resolve_column_map(column_map)\n    group_by = request.get(\"group_by\") or []\n    measures = request.get(\"measures\") or []\n    bins = request.get(\"bins\") or []\n\n    # ---- 数据文件与SHA核验 ----\n    if not add_check(\"data_file_exists\", bool(data_file) and os.path.isfile(data_file),\n                     data_file or \"<missing>\"):\n        return None, {\"checks\": checks, \"uncovered\": uncovered, \"all_pass\": False}\n\n    actual_sha = sha256_file(data_file)\n    expected_sha = request.get(\"expected_sha256\")\n    if expected_sha:\n        add_check(\"sha256_match\", actual_sha.lower() == str(expected_sha).lower(), actual_sha)\n    else:\n        add_check(\"sha256_recorded\", True, actual_sha)\n\n    sheet_name, headers, data = load_sheet(data_file, sheet, header_row)\n    total_records = len(data)\n\n    # ---- 角色解析：已引用但未映射/列缺失 -> uncovered（不报错，继续分析） ----\n    def resolve(role):\n        col = role2col.get(role)\n        if col is None:\n            uncovered.append({\"kind\": \"role_not_mapped\", \"role\": role,\n                              \"detail\": \"group_by/measures/bins引用了该角色但column_map未映射\"})\n            return None\n        if col not in headers:\n            uncovered.append({\"kind\": \"column_not_found\", \"role\": role, \"column\": col,\n                              \"detail\": \"列在数据表中不存在\"})\n            return None\n        return col\n\n    group_roles = [r for r in group_by]\n    group_cols = {r: resolve(r) for r in group_roles}\n    measure_specs = []\n    for m in measures:\n        role = m.get(\"role\") if isinstance(m, dict) else m\n        agg = (m.get(\"agg\") if isinstance(m, dict) else None) or \"count\"\n        col = resolve(role)\n        measure_specs.append({\"role\": role, \"agg\": agg, \"column\": col})\n    bin_specs = []\n    for b in bins:\n        role = b.get(\"role\")\n        thresholds = b.get(\"thresholds\") or []\n        col = resolve(role)\n        bin_specs.append({\"role\": role, \"column\": col, \"thresholds\": thresholds})\n\n    # ---- 分组聚合 ----\n    groups = {}\n    order = []\n    for rec in data:\n        key = tuple((r, rec.get(group_cols[r]) if group_cols[r] else None) for r in group_roles if group_cols[r])\n        if not key:\n            key = ((\"__ALL__\", \"全部记录\"),)\n        if key not in groups:\n            groups[key] = {\"group\": {r: rec.get(group_cols[r]) for r in group_roles if group_cols[r]}\n                           if any(group_cols[r] for r in group_roles) else {\"__ALL__\": \"全部记录\"},\n                           \"record_count\": 0, \"measures\": {spec[\"role\"]: [] for spec in measure_specs}}\n            order.append(key)\n        g = groups[key]\n        g[\"record_count\"] += 1\n        for spec in measure_specs:\n            if spec[\"column\"]:\n                g[\"measures\"][spec[\"role\"]].append(rec.get(spec[\"column\"]))\n\n    group_rows = []\n    for key in order:\n        g = groups[key]\n        row = {\"group\": g[\"group\"], \"record_count\": g[\"record_count\"], \"measures\": {}}\n        for spec in measure_specs:\n            if spec[\"role\"] in g[\"measures\"]:\n                row[\"measures\"][spec[\"role\"]] = {\"agg\": spec[\"agg\"], \"value\": aggregate(g[\"measures\"][spec[\"role\"]], spec[\"agg\"])}\n        group_rows.append(row)\n\n    overall = {}\n    for spec in measure_specs:\n        if spec[\"column\"]:\n            overall[spec[\"role\"]] = {\"agg\": spec[\"agg\"], \"value\": aggregate([rec.get(spec[\"column\"]) for rec in data], spec[\"agg\"])}\n\n    # ---- 分档 ----\n    bin_results = []\n    for b in bin_specs:\n        col = b[\"column\"]\n        thresholds = b[\"thresholds\"]\n        entries = [{\"label\": t.get(\"label\"), \"min\": t.get(\"min\"), \"max\": t.get(\"max\"), \"count\": 0}\n                   for t in thresholds]\n        unclassified = 0\n        missing = 0\n        if col:\n            for rec in data:\n                v = to_number(rec.get(col))\n                if v is None:\n                    missing += 1\n                    continue\n                label = classify(v, thresholds)\n                hit = False\n                for e in entries:\n                    if e[\"label\"] == label and label is not None:\n                        e[\"count\"] += 1\n                        hit = True\n                        break\n                if not hit:\n                    unclassified += 1\n        valued = total_records - missing\n        add_check(\"bins_closed[%s]\" % b[\"role\"],\n                  (sum(e[\"count\"] for e in entries) + unclassified == valued) if col else True,\n                  \"valued=%d binned=%d unclassified=%d\" % (valued, sum(e[\"count\"] for e in entries), unclassified))\n        bin_results.append({\"role\": b[\"role\"], \"column\": col,\n                            \"total_valued\": valued if col else 0,\n                            \"missing_or_nonnumeric\": missing,\n                            \"unclassified\": unclassified,\n                            \"bins\": entries})\n\n    # ---- 闭合与覆盖核验 ----\n    add_check(\"groups_closed\", sum(g[\"record_count\"] for g in group_rows) == total_records,\n              \"groups_sum=%d total=%d\" % (sum(g[\"record_count\"] for g in group_rows), total_records))\n\n    mapped_referenced = [r for r in group_roles if role2col.get(r)] + \\\n                         [m[\"role\"] for m in measure_specs if role2col.get(m[\"role\"])] + \\\n                         [b[\"role\"] for b in bin_specs if role2col.get(b[\"role\"])]\n    computed_roles = set(overall.keys()) | {r for g in group_rows for r in g[\"measures\"]} | \\\n                     {b[\"role\"] for b in bin_results if b[\"column\"]} | \\\n                     {r for r in group_roles if group_cols[r]}\n    add_check(\"mapped_roles_computed\",\n              all(r in computed_roles for r in mapped_referenced),\n              \"mapped_referenced=%s\" % sorted(set(mapped_referenced)))\n    add_check(\"uncovered_is_informational\", True, \"未映射引用角色数=%d（如实记录，不影响通过）\" % len(uncovered))\n\n    result = {\n        \"generated_at\": now_iso(),\n        \"request_file\": os.path.abspath(request_path),\n        \"data_file\": os.path.abspath(data_file),\n        \"sheet\": sheet_name,\n        \"header_row\": header_row,\n        \"sha256\": actual_sha,\n        \"total_records\": total_records,\n        \"column_map\": column_map,\n        \"group_by\": [r for r in group_roles if group_cols[r]],\n        \"groups\": group_rows,\n        \"measures_overall\": overall,\n        \"bins\": bin_results,\n        \"uncovered\": uncovered,\n    }\n\n    # ---- 输出 ----\n    out_root = output_root_arg or request.get(\"output_root\") or \"outputs\"\n    outdir = os.path.join(out_root, request.get(\"output_name\") or \"analysis_run\")\n    os.makedirs(outdir, exist_ok=True)\n    result_path = os.path.join(outdir, \"analysis_result.json\")\n    receipt_path = os.path.join(outdir, \"receipt.json\")\n    with open(result_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n\n    report_cfg = request.get(\"report\") or {}\n    written = [result_path, receipt_path]\n    report_paths = {}\n    skill_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    if report_cfg.get(\"markdown\", True):\n        tpl = report_cfg.get(\"template\") or os.path.join(skill_root, \"assets\", \"report_template.md\")\n        md_path = os.path.join(outdir, \"report.md\")\n        try:\n            with open(tpl, \"r\", encoding=\"utf-8\") as f:\n                template = f.read()\n            with open(md_path, \"w\", encoding=\"utf-8\") as f:\n                f.write(render_report_md(template, result))\n            written.append(md_path)\n            report_paths[\"markdown\"] = md_path\n        except Exception as exc:\n            add_check(\"report_markdown\", False, str(exc))\n        else:\n            add_check(\"report_markdown\", True, md_path)\n    if report_cfg.get(\"docx\"):\n        docx_path = os.path.join(outdir, \"report.docx\")\n        try:\n            render_report_docx(docx_path, result, report_cfg.get(\"title\") or \"结构化数据分析报告\")\n            written.append(docx_path)\n            report_paths[\"docx\"] = docx_path\n        except Exception as exc:\n            add_check(\"report_docx\", False, str(exc))\n        else:\n            add_check(\"report_docx\", True, docx_path)\n\n    receipt = {\n        \"generated_at\": now_iso(),\n        \"request_file\": os.path.abspath(request_path),\n        \"output_dir\": os.path.abspath(outdir),\n        \"data_file\": os.path.abspath(data_file),\n        \"sha256\": actual_sha,\n        \"expected_sha256\": expected_sha,\n        \"total_records\": total_records,\n        \"group_count\": len(group_rows),\n        \"bins\": {b[\"role\"]: {e[\"label\"]: e[\"count\"] for e in b[\"bins\"]} for b in bin_results},\n        \"uncovered\": uncovered,\n        \"report_outputs\": report_paths,\n        \"checks\": checks,\n        \"all_pass\": False,\n    }\n    with open(receipt_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(receipt, f, ensure_ascii=False, indent=2)\n\n    # receipt.json 已落盘后再做输出完整性核验，并回写最终checks\n    written.append(receipt_path)\n    add_check(\"outputs_written\", all(os.path.isfile(fp) for fp in written),\n              \"; \".join(os.path.basename(fp) for fp in written))\n    receipt[\"checks\"] = checks\n    receipt[\"all_pass\"] = all(c[\"status\"] == \"PASS\" for c in checks)\n    with open(receipt_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(receipt, f, ensure_ascii=False, indent=2)\n    return result, receipt\n\n\ndef _fmt(v):\n    if v is None:\n        return \"-\"\n    if isinstance(v, float):\n        s = \"%.2f\" % v\n        s = s.rstrip(\"0\").rstrip(\".\")\n        return s if s not in (\"\", \"-\") else \"0\"\n    return str(v)\n\n\ndef render_report_md(template, result):\n    group_roles = result[\"group_by\"]\n    measure_roles = list(result[\"measures_overall\"].keys())\n    header_cells = [\"维度: \" + \"/\".join(group_roles) if group_roles else \"全部记录\"] + \\\n                   [\"%s(%s)\" % (m, result[\"measures_overall\"][m][\"agg\"]) for m in measure_roles] + [\"记录数\"]\n    lines = [\"| \" + \" | \".join(header_cells) + \" |\",\n             \"|\" + \"|\".join([\"---\"] * len(header_cells)) + \"|\"]\n    for g in result[\"groups\"]:\n        cells = [\" / \".join(_fmt(g[\"group\"][r]) for r in g[\"group\"])]\n        cells += [_fmt(g[\"measures\"][m][\"value\"]) if m in g[\"measures\"] else \"-\" for m in measure_roles]\n        cells.append(str(g[\"record_count\"]))\n        lines.append(\"| \" + \" | \".join(cells) + \" |\")\n    group_table = \"\\n\".join(lines)\n\n    overall_table = \"\\n\".join(\"| %s | %s | %s |\" % (m, result[\"measures_overall\"][m][\"agg\"],\n                                                     _fmt(result[\"measures_overall\"][m][\"value\"]))\n                              for m in measure_roles) or \"| （无度量） | - | - |\"\n\n    bin_blocks = []\n    for b in result[\"bins\"]:\n        rows = [\"| 分档 | 区间 | 计数 | 占比 |\", \"|---|---|---|---|\"]\n        for e in b[\"bins\"]:\n            lo = \"-inf\" if e[\"min\"] is None else _fmt(e[\"min\"])\n            hi = \"+inf\" if e[\"max\"] is None else _fmt(e[\"max\"])\n            share = (\"%.1f%%\" % (100.0 * e[\"count\"] / b[\"total_valued\"])) if b[\"total_valued\"] else \"-\"\n            rows.append(\"| %s | [%s, %s] | %d | %s |\" % (e[\"label\"], lo, hi, e[\"count\"], share))\n        note = \"（缺失/非数值 %d 条；未落入任何分档 %d 条）\" % (b[\"missing_or_nonnumeric\"], b[\"unclassified\"])\n        bin_blocks.append(\"**分档维度角色：%s**（列 %s，有效数值 %d 条）%s\\n\\n%s\"\n                          % (b[\"role\"], b[\"column\"] or \"-\", b[\"total_valued\"], note, \"\\n\".join(rows)))\n    bin_section = \"\\n\\n\".join(bin_blocks) if bin_blocks else \"（本次request未配置分档）\"\n\n    unc_lines = []\n    for u in result[\"uncovered\"]:\n        unc_lines.append(\"- %s：角色 `%s` %s\" % (u[\"kind\"], u[\"role\"], u[\"detail\"]))\n    uncovered_section = \"\\n\".join(unc_lines) if unc_lines else \"无（request引用的角色均已映射且算出结果）\"\n\n    out = template\n    replacements = {\n        \"{{generated_at}}\": result[\"generated_at\"],\n        \"{{data_file}}\": result[\"data_file\"],\n        \"{{sheet}}\": result[\"sheet\"] or \"-\",\n        \"{{total_records}}\": str(result[\"total_records\"]),\n        \"{{sha256}}\": result[\"sha256\"],\n        \"{{group_roles}}\": \" / \".join(group_roles) if group_roles else \"（未配置分组，按全部记录汇总）\",\n        \"{{group_table}}\": group_table,\n        \"{{overall_table}}\": overall_table,\n        \"{{bin_section}}\": bin_section,\n        \"{{uncovered_section}}\": uncovered_section,\n    }\n    for k, v in replacements.items():\n        out = out.replace(k, v)\n    return out\n\n\ndef render_report_docx(path, result, title):\n    from docx import Document\n    doc = Document()\n    doc.add_heading(title, 0)\n    doc.add_paragraph(\"数据文件：%s\" % result[\"data_file\"])\n    doc.add_paragraph(\"工作表：%s    记录总数：%d\" % (result[\"sheet\"] or \"-\", result[\"total_records\"]))\n    doc.add_paragraph(\"生成时间：%s    SHA256：%s\" % (result[\"generated_at\"], result[\"sha256\"]))\n\n    doc.add_heading(\"一、分组聚合结果\", level=1)\n    group_roles = result[\"group_by\"]\n    measure_roles = list(result[\"measures_overall\"].keys())\n    cols = len(group_roles) + len(measure_roles) + 1\n    table = doc.add_table(rows=1, cols=cols)\n    table.style = \"Table Grid\"\n    hdr = ([\"/\".join(group_roles) if group_roles else \"全部记录\"] +\n           [\"%s(%s)\" % (m, result[\"measures_overall\"][m][\"agg\"]) for m in measure_roles] + [\"记录数\"])\n    for i, h in enumerate(hdr):\n        table.rows[0].cells[i].text = h\n    for g in result[\"groups\"]:\n        cells = table.add_row().cells\n        vals = [\" / \".join(_fmt(g[\"group\"][r]) for r in g[\"group\"])]\n        vals += [_fmt(g[\"measures\"][m][\"value\"]) if m in g[\"measures\"] else \"-\" for m in measure_roles]\n        vals.append(str(g[\"record_count\"]))\n        for i, v in enumerate(vals):\n            cells[i].text = v\n\n    doc.add_heading(\"二、总体度量\", level=1)\n    t2 = doc.add_table(rows=1, cols=3)\n    t2.style = \"Table Grid\"\n    for i, h in enumerate([\"度量角色\", \"聚合方式\", \"总体值\"]):\n        t2.rows[0].cells[i].text = h\n    for m in measure_roles:\n        cells = t2.add_row().cells\n        cells[0].text = m\n        cells[1].text = result[\"measures_overall\"][m][\"agg\"]\n        cells[2].text = _fmt(result[\"measures_overall\"][m][\"value\"])\n\n    doc.add_heading(\"三、分档分布\", level=1)\n    for b in result[\"bins\"]:\n        doc.add_paragraph(\"分档角色：%s（列 %s，有效数值 %d 条，缺失/非数值 %d，未分档 %d）\"\n                          % (b[\"role\"], b[\"column\"] or \"-\", b[\"total_valued\"],\n                             b[\"missing_or_nonnumeric\"], b[\"unclassified\"]))\n        t3 = doc.add_table(rows=1, cols=4)\n        t3.style = \"Table Grid\"\n        for i, h in enumerate([\"分档\", \"区间\", \"计数\", \"占比\"]):\n            t3.rows[0].cells[i].text = h\n        for e in b[\"bins\"]:\n            cells = t3.add_row().cells\n            lo = \"-inf\" if e[\"min\"] is None else _fmt(e[\"min\"])\n            hi = \"+inf\" if e[\"max\"] is None else _fmt(e[\"max\"])\n            share = (\"%.1f%%\" % (100.0 * e[\"count\"] / b[\"total_valued\"])) if b[\"total_valued\"] else \"-\"\n            cells[0].text = str(e[\"label\"])\n            cells[1].text = \"[%s, %s]\" % (lo, hi)\n            cells[2].text = str(e[\"count\"])\n            cells[3].text = share\n\n    doc.add_heading(\"四、未覆盖维度（uncovered）\", level=1)\n    if result[\"uncovered\"]:\n        for u in result[\"uncovered\"]:\n            doc.add_paragraph(\"%s：角色 %s —— %s\" % (u[\"kind\"], u[\"role\"], u[\"detail\"]), style=\"List Bullet\")\n    else:\n        doc.add_paragraph(\"无（request引用的角色均已映射且算出结果）\")\n    doc.save(path)\n\n\ndef main(argv=None):\n    if openpyxl is None:\n        print(\"缺少依赖 openpyxl\", file=sys.stderr)\n        return 3\n    ap = argparse.ArgumentParser(description=\"参数化结构化Excel分析引擎\")\n    ap.add_argument(\"--request\", required=True, help=\"request.json 路径\")\n    ap.add_argument(\"--output-root\", default=None, help=\"输出根目录（默认取request.output_root或outputs）\")\n    args = ap.parse_args(argv)\n    with open(args.request, \"r\", encoding=\"utf-8\") as f:\n        request = json.load(f)\n    result, receipt = run_analysis(request, args.request, args.output_root)\n    print(json.dumps({\"exit\": 0 if receipt[\"all_pass\"] else 2,\n                      \"all_pass\": receipt[\"all_pass\"],\n                      \"output_dir\": receipt[\"output_dir\"],\n                      \"uncovered\": len(receipt[\"uncovered\"])}, ensure_ascii=False))\n    return 0 if receipt[\"all_pass\"] else 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792488530302, "__openclaw": {"runId": "4b44afa1-81f7-4550-bb1d-ea8d9237818e"}}}
