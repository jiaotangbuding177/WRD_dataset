"nodisc\": sum(1 for x in fr if x[\"finance\"] == \"无披露\"),\n        \"items\": sum(x[\"items\"] for x in fr),\n        \"conv_companies\": len({x[\"company\"] for x in conv}),\n    }\n\n# ---- 2) 金额档位（已实现=已转化；洽谈中单独计数） ----\nby_bin = []\nfor b in range(3):\n    inb = [x for x in rows if bin_of(x[\"amount\"]) == b]\n    conv = [x for x in inb if x[\"status\"] == \"已转化\"]\n    by_bin.append({\"label\": BIN_LABELS[b], \"n\": len(inb), \"conv\": len(conv),\n                   \"pend\": len(inb) - len(conv), \"amt\": sum(x[\"amount\"] for x in conv)})\n# 领域×档位（已转化）\ncross_fd = [[0]*3 for _ in FIELDS]\nfor x in rows:\n    if x[\"status\"] == \"已转化\":\n        cross_fd[FIELDS.index(x[\"field\"])][bin_of(x[\"amount\"])] += 1\n\n# ---- 3) 融资披露状态 ----\nby_fin = {}\nfor s in FINSTATES:\n    sr = [x for x in rows if x[\"finance\"] == s]\n    conv = [x for x in sr if x[\"status\"] == \"已转化\"]\n    by_fin[s] = {\"n\": len(sr), \"conv\": len(conv), \"pend\": len(sr)-len(conv),\n                 \"amt\": sum(x[\"amount\"] for x in conv),\n                 \"companies\": len({x[\"company\"] for x in sr})}\ncross_sf = {(s, st): 0 for s in FINSTATES for st in STATUSES}\nfor x in rows:\n    cross_sf[(x[\"finance\"], x[\"status\"])] += 1\n\n# ---- 总体 ----\ntotal = {\"n\": N,\n         \"conv\": sum(1 for x in rows if x[\"status\"] == \"已转化\"),\n         \"pend\": sum(1 for x in rows if x[\"status\"] == \"洽谈中\"),\n         \"amt\": sum(x[\"amount\"] for x in rows if x[\"status\"] == \"已转化\"),\n         \"companies\": len({x[\"company\"] for x in rows}),\n         \"fin\": by_fin[\"已融资\"][\"n\"], \"nodisc\": by_fin[\"无披露\"][\"n\"],\n         \"items\": sum(x[\"items\"] for x in rows)}\n\nstats = {\"by_field\": by_field, \"by_bin\": by_bin, \"cross_fd\": cross_fd, \"by_fin\": by_fin,\n         \"cross_sf\": {f\"{k[0]}|{k[1]}\": v for k, v in cross_sf.items()}, \"total\": total,\n         \"fields\": FIELDS, \"bin_labels\": BIN_LABELS, \"n\": N}\nwith open(f\"{TMP}/stats.json\", \"w\", enco