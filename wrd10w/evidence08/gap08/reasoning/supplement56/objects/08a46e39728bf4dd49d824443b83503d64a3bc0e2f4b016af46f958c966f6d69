中\\\", color=\\\"#F4B183\\\")\\nfor i in x:\\n    ax.text(i, conv[i]/2, str(conv[i]), ha=\\\"center\\\", va=\\\"center\\\", color=\\\"white\\\", fontsize=9)\\n    ax.text(i, conv[i]+pend[i]/2, str(pend[i]), ha=\\\"center\\\", va=\\\"center\\\", fontsize=9)\\nax.set_xticks(list(x)); ax.set_xticklabels(labels, fontsize=8.5)\\nax.set_title(\\\"转化金额档位项目数（覆盖全部64条记录）\\\", fontsize=11)\\nax.set_ylabel(\\\"项目数\\\"); ax.legend(fontsize=9)\\nfig.tight_layout(); fig.savefig(f\\\"{TMP}/fig2_bin.png\\\"); plt.close(fig)\\n\\n# 图3：融资披露状态\\nfig, ax = plt.subplots(figsize=(5.2, 3.6), dpi=150)\\nvals = [bfin[\\\"已融资\\\"][\\\"n\\\"], bfin[\\\"无披露\\\"][\\\"n\\\"]]\\nax.pie(vals, labels=[f\\\"已融资 {vals[0]}项\\\", f\\\"无披露 {vals[1]}项\\\"],\\n       autopct=\\\"%1.1f%%\\\", colors=[\\\"#2F5597\\\", \\\"#A9C4E4\\\"], startangle=90,\\n       textprops={\\\"fontsize\\\": 9})\\nax.set_title(\\\"融资披露状态项目数占比（无披露≠未融资）\\\", fontsize=11)\\nfig.tight_layout(); fig.savefig(f\\\"{TMP}/fig3_fin.png\\\"); plt.close(fig)\\nprint(\\\"figs saved\\\")\\n\\n# ---- docx ----\\nsec_amt = bb\\np1 = (f\\\"本摘要依据成果转化台账（inputs/成果转化.xlsx，共64条成果记录，覆盖材料、芯片、装备、生物四个技术领域各16条）编制。\\\"\\n      f\\\"统计口径：已实现转化金额仅计入状态为“已转化”的项目；12条洽谈中项目不计入已实现转化金额；“无披露”仅指台账未披露融资信息，不等于未融资。\\\"\\n      f\\\"经核验，已转化成果52条，已实现转化金额合计21,937.50万元；全部成果涉及去重创业公司16家。\\\"\\n      f\\\"金额档位按0–100万元（含100）、100万元以上–300万元（含300）、300万元以上三档划分，覆盖全部64条记录。\\\"\\n      f\\\"配套明细文件《成果赋权与转化分析.xlsx》含各维度数据表与图表，供逐项核对。\\\")\\np2 = (f\\\"四个技术领域的转化规模高度均衡。材料领域已转化13条、已实现金额5,466.75万元；芯片领域已转化13条、5,478.50万元；\\\"\\n      f\\\"装备领域已转化13条、5,490.25万元；生物领域已转化13条、5,502.00万元。四领域均各有3条洽谈中项目，合计12条。\\\"\\n      f\\\"去重公司数方面，各领域均涉及4家创业公司，全表去重共16家，每家公司平均对应4条成果记录。\\\"\\n      f\\\"赋权制度配套方面，装备领域制度条目数合计64条为最高，芯片48条、材料32条、生物16条，全表合计160条。\\\"\\n      f\\\"各领域金额差距不足40万元，说明成果转化在各技术方向推进较为均衡，尚未出现明显偏科。\\\")\\np3 = (f\\\"按金额档位看，300万元以上档是转化金额的绝对主力：该档共42条项目，其中已转化34条，已实现金额18,832.25万元，\\\"\\n      f\\\"占已实现总额的85.8%；另有8条洽谈中项目分布于此档。100万元以上–300万元（含300）档共17条，其中已转化14条，\\\"\\n      f\\\"已实现金额2,827.75万元；0–100万元（含100）档共5条，其中已转化4条，已实现金额277.50万元。\\\"\\n      f\\\"分领域看，材料、芯片领域已转化项目在300万元以上档各8条，装备、生物各9条，各领域0–100万元档均仅1条已转化项目。\\\"\\n      f\\\"整体呈“档位越高、项目越多”的分布，小金额成果占比低，建议关注小额成果的转化潜力。\\\")\\np4 = (f\\\"融资披露方面，已融资项目43条，其中已转化35条、已实现金额14,877.25万元；无披露项目21条，其中已转化17条、\\\"\\n      f\\\"已实现金额7,060.25万元。需要特别说明：无披露仅表示台账未记载融资信息，不等于该公司未融资，两组公司均覆盖全部16家去重公司，\\\"\\n      f\\\"不宜据此对企业融资状况下结论。洽谈中项目中，已融资8条、无披露4条。已融资项目的单项目平均已实现金额约425.06万元，\\\"\\n      f\\\"高于无披露项目的约415.31万元，两者差距不大。建议后续补充核实无披露项目的融资实情，并跟踪12条洽谈中项目的落地进展，\\\"\\n      f\\\"待其转化后再更新已实现金额。\\\")\\n\\nparas = [p1, p2, p3, p4]\\nfor i, t in enumerate(paras, 1):\\n    print(f\\\"para{i} chars={len(t)}\\\")\\n    assert len(t) <= 400, f\\\"para{i} over 400\\\"\\n\\ndoc = Document()\\nst = doc.styles[\\\"Normal\\\"]; st.font.name = \\\"Noto Sans CJK SC\\\"; st.font.size = Pt(10.5)\\ntitle = doc.add_heading(\\\"成果转化摘要\\\", level=0)\\nfor run in title.runs: run.font.name = \\\"Noto Sans CJK SC\\\"\\nmeta = doc.add_paragraph(\\\"技术转移中心 · 数据源：成果转化.xlsx（64条） · 生成日期：2026-10-20 · 单位：万元\\\")\\nmeta.runs[0].font.size = Pt(9)\\n\\nheads = [\\\"一、数据与统计口径\\\", \\\"二、技术领域分布\\\", \\\"三、转化金额档位与去重公司\\\", \\\"四、融资披露状态与建议\\\"]\\nfor h, t in zip(heads, paras):\\n    hp = doc.add_heading(h, level=1)\\n    for run in hp.runs: run.font.name = \\\"Noto Sans CJK SC\\\"\\n    doc.add_paragraph(t)\\n\\n# 可核图表\\ndoc.add_heading(\\\"附图（与xlsx数据表一致，可核对）\\\", level=1)\\ndoc.add_picture(f\\\"{TMP}/fig1_field.png\\\", width=Inches(5.8))\\ndoc.add_picture(f\\\"{TMP}/fig2_bin.png\\\", width=Inches(5.8))\\ndoc.add_picture(f\\\"{TMP}/fig3_fin.png\\\", width=Inches(4.8))\\n\\n# 附表\\ndoc.add_heading(\\\"附表：核心数据\\\", level=1)\\nt = doc.add_table(rows=1, cols=6); t.style = \\\"Table Grid\\\"\\nfor i, h in enumerate([\\\"技术领域\\\", \\\"成果数\\\", \\\"已转化\\\", \\\"洽谈中\\\", \\\"已实现金额(万元)\\\", \\\"去重公司数\\\"]):\\n    t.rows[0].cells[i].text = h\\nfor f in F:\\n    d = bf[f]\\n    cells = t.add_row().cells\\n    for i, v in enumerate([f, d[\\\"n\\\"], d[\\\"conv\\\"], d[\\\"pend\\\"], f\\\"{d['amt