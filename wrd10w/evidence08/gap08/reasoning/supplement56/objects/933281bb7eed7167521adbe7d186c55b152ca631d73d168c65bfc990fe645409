data.columns, 1):\n        w = max(len(str(col))*2.1, *(len(f'{v:.2f}') if isinstance(v,float) else len(str(v)) for v in data[col]))\n        ws.column_dimensions[get_column_letter(i)].width = min(w+4, 26)\n    if notes:\n        ws.append([])\n        for n in notes:\n            ws.append([n])\n            ws.cell(ws.max_row, 1).font = Font(size=9, italic=True, color='808080', name='微软雅黑')\n    ws.freeze_panes = ws.cell(r0+1, 1)\n    return r0\n\nnotes = ['口径：洽谈中项目不计已实现转化金额（金额记0，仅计项目数）；去重公司数=该组内不同创业公司编码个数；',\n         '融资披露状态为台账登记口径，无披露≠未融资；金额单位：万元。']\n\n# 1 交叉表\nws1 = wb.active; ws1.title = '领域×档位交叉'\nr0 = write_sheet(ws1, g, '技术领域 × 转化金额档位 交叉统计', notes)\nch = BarChart(); ch.type='col'; ch.grouping='stacked'; ch.overlap=100\nch.title='各领域×档位 已实现转化金额(万元)'\ndata_ref = Reference(ws1, min_col=5, min_row=r0, max_row=r0+12)\ncats = Reference(ws1, min_col=1, max_row=r0+12)\n# use multi columns: 金额 only\nch.add_data(data_ref, titles_from_data=True); ch.set_categories(cats)\nch.height, ch.width = 8, 16\nws1.add_chart(ch, 'A' + str(r0+16))\n\n# 2 按领域\nws2 = wb.create_sheet('按技术领域')\nr0 = write_sheet(ws2, byf, '按技术领域统计', notes)\nch = BarChart(); ch.type='col'; ch.title='各技术领域已实现转化金额(万元)'\nch.add_data(Reference(ws2, min_col=5, min_row=r0, max_row=r0+4), titles_from_data=True)\nch.set_categories(Reference(ws2, min_col=1, min_row=r0+1, max_row=r0+4))\nch.height, ch.width = 8, 14\nws2.add_chart(ch, 'A' + str(r0+9))\n\n# 3 按档位\nws3 = wb.create_sheet('按金额档位')\nr0 = write_sheet(ws3, byb, '按转化金额档位统计', notes)\nch = BarChart(); ch.type='col'; ch.title='各档位成果数与已实现金额'\nch.add_data(Reference(ws3, min_col=2, min_row=r0, max_row=r0+3), titles_from_data=True)\nch.add_data(Reference(ws3, min_col=5, min_row=r0, max_row=r0+3), titles_from_data=True)\nch.set_categories(Reference(ws3, min_col=1, min_row=r0+1, max_row=r0+3))\nch.height, ch.width = 8, 14\nws3.add_chart(ch, 'A' + str(r0+8))\n\n# 4 融资披露\nws4 = wb.create_sheet('融资披露状态')\nr0 = write_sheet(ws4, bs, '融资披露状态 × 转化状态',\n                 notes + ['注：无披露仅指台账未登记披露信息，不等于未融资，建议持续补录核实。'])\nch = BarChart(); ch.type='col'; ch.grouping='stacked'; ch.overlap=100\nch.title='融资披露状态×转化状态(项)'\nch.add_data(Reference(ws4, min_col=2, max_col=3, min_row=r0, max_row=r0+2), titles_from_data=True)\nch.set_categories(Reference(ws4, min_col=1, min_row=r0+1, max_row=r0+2))\nch.height, ch.width = 8, 12\nws4.add_chart(ch, 'A' + str(r0+9))\n\n# 5 基础数据\nws5 = wb.create_sheet('基础数据(含口径)')\nd2 = df[['成果编号','领域','转化金额万元','状态','创业公司编码','融资披露状态','制度条目数','金额档位','已实现金额万元']]\nd2 = d2.copy(); d2['金额档位'] = d2['金额档位'].astype(str)\nwrite_sheet(ws5, d2, '成果转化台账（含档位与已实现金额口径列）', notes)\n\nwb.save('/workspace/outputs/成果赋权与转化分析.xlsx')\nprint('xlsx saved')\n", "path": "/workspace/tmp/build_xlsx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792481717869, "responseId": "chatcmpl-1792481718001", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "c070be27-47c7-43dc-8259-beb81f9c5287"}}}
