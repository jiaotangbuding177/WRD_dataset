{"type": "message", "id": "a4fe95fd-c239-4a5f-abf4-d14a67e5054b", "parentId": "00c64b15-b1d9-4dd9-81e4-3e43f22242d6", "timestamp": "2026-10-23T11:39:23.271Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "calle3318887a5f64be58b4c2f8b5b976d57", "name": "write", "arguments": {"content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>魂斗罗 · 钢铁突击</title>\n<style>\n  html,body{margin:0;padding:0;background:#0d1117;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:\"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif;color:#9aa4b2;}\n  canvas{border:2px solid #30363d;box-shadow:0 0 24px rgba(0,0,0,.6);image-rendering:pixelated;}\n  #help{margin-top:10px;font-size:13px;letter-spacing:1px;}\n</style>\n</head>\n<body>\n<canvas id=\"game\" width=\"960\" height=\"540\"></canvas>\n<div id=\"help\">← → 移动 · ↑ 瞄准上方 · ↓ 蹲下/空中朝下 · J 或 Z 开火 · K / X / 空格 跳跃 · Enter 开始</div>\n<script>\n'use strict';\nconst cv=document.getElementById('game');\nconst ctx=cv.getContext('2d');\nconst W=960,H=540,LEVEL_W=6400,GROUND_Y=460;\nlet state='title',score=0,lives=3,camX=0,frameCount=0,spawnTimer=120;\n\n// ---------- level ----------\nconst solids=[];\nfunction addGround(x,w){solids.push({x:x,y:GROUND_Y,w:w,h:H-GROUND_Y,type:'ground'});}\nfunction addPlat(x,y,w){solids.push({x:x,y:y,w:w,h:14,type:'plat'});}\naddGround(0,900);addGround(1020,800);addGround(1940,900);addGround(2960,1100);addGround(4200,2200);\naddPlat(600,360,140);addPlat(1300,350,160);addPlat(1600,270,140);\naddPlat(2300,360,160);addPlat(2500,280,160);addPlat(2700,360,140);\naddPlat(3200,350,180);addPlat(3480,260,180);addPlat(3800,340,160);\naddPlat(4400,360,160);addPlat(4700,270,180);addPlat(5100,340,180);addPlat(5450,260,160);\nconst flag={x:6220,y:GROUND_Y-150,w:12,h:150};\nconst TURRETS=[[1360,320],[2450,430],[3650,430],[5050,430]];\nconst SHOOTERS=[[1650,270],[2560,280],[3520,260],[5480,260]];\nconst PU_POS=[[1330,300],[3520,200],[5120,290]];\nconst CHECKPOINTS=[80,1100,2000,3100,4300,5200];\n\nconst P={x:80,y:GROUND_Y-60,w:26,h:44,vx:0,vy:0,onGround:false,face:1,crouch:false,cool:0,inv:0,spread:false,anim:0,jheld:false};\nlet enemies=[],pbullets=[],ebullets=[],powerups=[];\nconst keys={};\n\nfunction ov(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}\n\nfunction initGame(full){\n  if(full){score=0;lives=3;P.spread=false;}\n  P.x=80;P.y=GROUND_Y-60;P.vx=0;P.vy=0;P.inv=90;P.face=1;P.crouch=false;P.cool=0;P.jheld=false;\n  camX=0;spawnTimer=120;enemies=[];pbullets=[];ebullets=[];\n  for(const t of TURRETS)enemies.push({type:'turret',x:t[0],y:t[1],w:36,h:30,hp:3,cool:80,ang:Math.PI});\n  for(const s of SHOOTERS)enemies.push({type:'shooter',x:s[0],y:s[1]-40,w:26,h:40,hp:1,cool:60,face:-1});\n  powerups=PU_POS.map(p=>({x:p[0],y:p[1],taken:false,t:Math.random()*6}));\n}\n\n// ---------- physics ----------\nfunction resolveX(e){\n  for(const s of solids){\n    if(s.type!=='ground'||!ov(e,s))continue;\n    if(e.x+e.w/2<s.x+s.w/2)e.x=s.x-e.w;else e.x=s.x+s.w;\n  }\n  if(e.x<0)e.x=0;\n  if(e.x>LEVEL_W-e.w)e.x=LEVEL_W-e.w;\n}\nfunction resolveY(e,dt){\n  e.onGround=false;\n  const prevBot=e.y+e.h-e.vy*dt;\n  for(const s of solids){\n    if(!ov(e,s))continue;\n    if(s.type==='plat'){\n      if(e.vy>=0&&prevBot<=s.y+2){e.y=s.y-e.h;e.vy=0;e.onGround=true;}\n      continue;\n    }\n    if(e.y+e.h/2<s.y+s.h/2){e.y=s.y-e.h;e.vy=0;e.onGround=true;}\n    else{e.y=s.y+s.h;if(e.vy<0)e.vy=0;}\n  }\n}\n\n// ---------- audio ----------\nlet AC=null;\nfunction beep(f,d,t,v){\n  try{\n    if(!AC)AC=new (window.AudioContext||window.webkitAudioContext)();\n    if(AC.state==='suspended')AC.resume();\n    const o=AC.createOscillator(),g=AC.createGain();\n    o.type=t;o.frequency.value=f;\n    g.gain.setValueAtTime(v,AC.currentTime);\n    g.gain.exponentialRampToValueAtTime(0.001,AC.currentTime+d);\n    o.connect(g);g.connect(AC.destination);\n    o.start();o.stop(AC.currentTime+d);\n  }catch(err){}\n}\n\n// ---------- player ----------\nfunction updatePlayer(dt){\n  const left=keys['ArrowLeft']||keys['a'],right=keys['ArrowRight']||keys['d'];\n  const up=keys['ArrowUp']||keys['w'],down=keys['ArrowDown']||keys['s'];\n  const jk=keys[' ']||keys['k']||keys['x'],fk=keys['j']||keys['z'];\n  P.crouch=!!(down&&P.onGround);\n  let mv=0;if(left)mv--;if(right)mv++;\n  if(mv!==0){P.face=mv;P.anim+=dt*0.25;P.vx=P.crouch?0:mv*3.2;}else P.vx*=0.55;\n  if(jk&&!P.jheld&&P.onGround){P.vy=-11.5;P.onGround=false;beep(500,0.08,'square',0.12);}\n  P.jheld=!!jk;\n  if(!jk&&P.vy<-4.5)P.vy=-4.5;\n  P.vy=Math.min(12,P.vy+0.55*dt);\n  if(P.cool>0)P.cool-=dt;\n  if(fk&&P.cool<=0){\n    P.cool=P.spread?8:10;\n    const bx=P.x+P.w/2,by=P.crouch?P.y+30:P.y+18;\n    let vx=0,vy=0;\n    const diag=up&&mv!==0;\n    if(diag){vx=P.face*6.4;vy=-6.4;}\n    else if(up){vy=-9;}\n    else if(down&&!P.onGround){vy=9;}\n    else{vx=P.face*9;}\n    const rot=a=>{const c=Math.cos(a),s=Math.sin(a);return{x:bx-3,y:by-3,w:6,h:6,vx:vx*c-vy*s,vy:vx*s+vy*c};};\n    if(P.spread)pbullets.push(rot(-0.22),rot(0),rot(0.22));\n    else pbullets.push(rot(0));\n    beep(900,0.05,'square',0.06);\n  }\n  P.x+=P.vx*dt;resolveX(P);\n  P.y+=P.vy*dt;resolveY(P,dt);\n  if(P.inv>0)P.inv-=dt;\n  if(P.y>H+80)loseLife();\n}\nfunction loseLife(){\n  lives--;beep(140,0.35,'sawtooth',0.18);\n  if(lives<0){state='over';return;}\n  let cp=80;for(const c of CHECKPOINTS)if(c<=P.x)cp=c;\n  P.x=cp;P.y=GROUND_Y-60;P.vx=0;P.vy=0;P.inv=130;\n  ebullets=ebullets.filter(b=>Math.abs(b.x-P.x)>200);\n}\nfunction damage(){if(P.inv>0)return;loseLife();}\n\n// ---------- enemies ----------\nfunction spawnRunner(side){\n  const x=side===1?camX-40:camX+W+40;\n  if(x<10||x>LEVEL_W-40)return;\n  let top=null;\n  for(const s of solids){if(s.type==='ground'&&x>=s.x-10&&x<=s.x+s.w+10){top=s.y;break;}}\n  if(top===null)return;\n  enemies.push({type:'runner',x:x,y:top-50,w:24,h:40,vx:0,vy:0,hp:1,face:-1,cool:0});\n}\nfunction updateEnemies(dt){\n  spawnTimer-=dt;\n  if(spawnTimer<=0){\n    spawnTimer=130;\n    if(enemies.filter(e=>e.type==='runner').length<6){spawnRunner(-1);if(Math.random()<0.4)spawnRunner(1);}\n  }\n  for(let i=enemies.length-1;i>=0;i--){\n    const e=enemies[i];\n    if(e.type==='runner'){\n      e.cool+=dt;\n      if(e.cool>30){e.cool=0;e.face=(P.x<e.x)?-1:1;e.vx=e.face*1.7;}\n      e.vy=Math.min(12,e.vy+0.55*dt);\n      e.x+=e.vx*dt;resolveX(e);\n      e.y+=e.vy*dt;resolveY(e,dt);\n      if(e.y>H+80){enemies.splice(i,1);continue;}\n      if(ov(P,e))damage();\n    }else if(e.type==='shooter'){\n      e.face=(P.x<e.x)?-1:1;\n      e.cool-=dt;\n      if(e.cool<=0&&Math.abs(P.x-e.x)<560){\n        e.cool=95;\n        ebullets.push({x:e.x+e.w/2-3,y:e.y+18,w:6,h:6,vx:e.face*4.5,vy:0});\n        beep(300,0.06,'sawtooth',0.05);\n      }\n    }else{\n      e.cool-=dt;\n      const dx=P.x+P.w/2-(e.x+18),dy=P.y+P.h/2-(e.y+15);\n      const dist=Math.hypot(dx,dy);\n      if(e.cool<=0&&dist<720){\n        e.cool=115;e.ang=Math.atan2(dy,dx);\n        ebullets.push({x:e.x+18,y:e.y+15,w:6,h:6,vx:Math.cos(e.ang)*3.8,vy:Math.sin(e.ang)*3.8});\n        beep(260,0.07,'sawtooth',0.05);\n      }\n    }\n  }\n}\n\n// ---------- bullets / items ----------\nfunction updateBullets(dt){\n  for(let i=pbullets.length-1;i>=0;i--){\n    const b=pbullets[i];\n    b.x+=b.vx*dt;b.y+=b.vy*dt;\n    if(b.x<camX-60||b.x>camX+W+60||b.y<-60||b.y>H+60){pbullets.splice(i,1);continue;}\n    let hit=false;\n    for(let j=enemies.length-1;j>=0;j--){\n      const e=enemies[j];\n      if(ov(b,e)){\n        hit=true;e.hp--;beep(200,0.06,'square',0.08);\n        if(e.hp<=0){\n          score+=(e.type==='turret')?300:(e.type==='shooter'?200:100);\n          enemies.splice(j,1);beep(120,0.15,'square',0.1);\n        }\n        break;\n      }\n    }\n    if(hit)pbullets.splice(i,1);\n  }\n  for(let i=ebullets.length-1;i>=0;i--){\n    const b=ebullets[i];\n    b.x+=b.vx*dt;b.y+=b.vy*dt;\n    if(b.x<camX-60||b.x>camX+W+60||b.y<-60||b.y>H+60){ebullets.splice(i,1);continue;}\n    if(ov(P,b)){ebullets.splice(i,1);damage();}\n  }\n}\nfunction updatePowerups(dt){\n  for(const p of powerups){\n    if(p.taken)continue;\n    p.t+=dt*0.06;\n    const box={x:p.x,y:p.y+Math.sin(p.t)*6,w:22,h:22};\n    if(ov(P,box)){p.taken=true;P.spread=true;score+=200;beep(660,0.1,'square',0.12);beep(990,0.15,'square',0.12);}\n  }\n}\n\nfunction update(dt){\n  updatePlayer(dt);\n  updateEnemies(dt);\n  updateBullets(dt);\n  updatePowerups(dt);\n  camX=Math.max(0,Math.min(LEVEL_W-W,P.x+P.w/2-W*0.4));\n  if(P.x+P.w>flag.x)state='win';\n}\n\n// ---------- drawing ----------\nfunction tri(bx,base,hgt,col){\n  ctx.fillStyle=col;ctx.beginPath();\n  ctx.moveTo(bx,base);ctx.lineTo(bx+150,base-hgt);ctx.lineTo(bx+300,base);\n  ctx.closePath();ctx.fill();\n}\nfunction drawBackdrop(){\n  const g=ctx.createLinearGradient(0,0,0,H);\n  g.addColorStop(0,'#3a6ea8');g.addColorStop(1,'#8fc1e3');\n  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n  ctx.fillStyle='rgba(255,255,255,0.8)';\n  for(let i=0;i<6;i++){\n    const cx2=((i*300-camX*0.15)%(W+400)+W+400)%(W+400)-200;\n    ctx.beginPath();ctx.ellipse(cx2,70+(i%3)*44,50,16,0,0,Math.PI*2);ctx.fill();\n  }\n  for(let i=0;i<8;i++){const bx=((i*380-camX*0.25)%(W+760)+W+760)%(W+760)-380;tri(bx,460,200,'#2c5570');}\n  for(let i=0;i<8;i++){const bx=((i*340-camX*0.4+170)%(W+680)+W+680)%(W+680)-340;tri(bx,460,140,'#3d7291');}\n}\nfunction drawPlayer(){\n  if(P.inv>0&&Math.floor(frameCount/6)%2===0)return;\n  ctx.save();ctx.translate(P.x+P.w/2,P.y);ctx.scale(P.face,1);\n  const run=P.vx!==0&&P.onGround,f=Math.floor(P.anim*4)%2;\n  ctx.fillStyle='#2b4bd7';\n  if(P.crouch){ctx.fillRect(-10,30,20,14);}\n  else if(run){\n    if(f){ctx.fillRect(-10,32,9,12);ctx.fillRect(2,32,9,12);}\n    else{ctx.fillRect(-12,32,9,12);ctx.fillRect(4,32,9,12);}\n  }else{ctx.fillRect(-9,32,8,12);ctx.fillRect(2,32,8,12);}\n  ctx.fillStyle='#d99a6c';ctx.fillRect(-9,14,18,18);\n  ctx.fillStyle='#7a3b2e';ctx.fillRect(-9,14,4,18);\n  ctx.fillStyle='#d99a6c';ctx.fillRect(-7,2,14,12);\n  ctx.fillStyle='#d42a2a';ctx.fillRect(-7,3,14,4);ctx.fillRect(4,4,9,2);\n  ctx.fillStyle='#333';ctx.fillRect(2,20,16,4);ctx.fillRect(2,17,6,5);\n  ctx.restore();\n}\nfunction drawEnemy(e){\n  if(e.type==='turret'){\n    ctx.save();ctx.translate(e.x+18,e.y+15);\n    ctx.fillStyle='#555';ctx.fillRect(-18,-2,36,17);\n    ctx.fillStyle='#8a8f98';ctx.beginPath();ctx.arc(0,0,15,Math.PI,0);ctx.fill();\n    ctx.rotate(e.ang||0);ctx.fillStyle='#333';ctx.fillRect(0,-3,24,6);\n    ctx.restore();return;\n  }\n  ctx.save();ctx.translate(e.x+e.w/2,e.y);ctx.scale(e.face||1,1);\n  if(e.type==='runner'){\n    ctx.fillStyle='#2f7d32';\n    ctx.fillRect(-8,32,7,12);ctx.fillRect(2,32,7,12);\n    ctx.fillRect(-8,14,16,18);\n    ctx.fillStyle='#d9a066';ctx.fillRect(-6,2,12,12);\n    ctx.fillStyle='#222';ctx.fillRect(-8,16,6,3);ctx.fillRect(2,20,14,3);\n  }else{\n    ctx.fillStyle='#33518f';\n    ctx.fillRect(-8,32,7,12);ctx.fillRect(2,32,7,12);\n    ctx.fillRect(-8,14,16,18);\n    ctx.fillStyle='#d9a066';ctx.fillRect(-6,2,12,12);\n    ctx.fillStyle='#8892a0';ctx.fillRect(-7,-2,14,6);\n    ctx.fillStyle='#222';ctx.fillRect(2,20,14,3);\n  }\n  ctx.restore();\n}\nfunction drawFlag(){\n  ctx.fillStyle='#cfd4da';ctx.fillRect(flag.x,flag.y,6,flag.h);\n  const wv=Math.sin(frameCount*0.1)*4;\n  ctx.fillStyle='#d42a2a';\n  ctx.beginPath();\n  ctx.moveTo(flag.x+6,flag.y+4);\n  ctx.lineTo(flag.x+52+wv,flag.y+14);\n  ctx.lineTo(flag.x+52+wv,flag.y+44);\n  ctx.lineTo(flag.x+6,flag.y+54);\n  ctx.closePath();ctx.fill();\n  ctx.fillStyle='#ffd54a';ctx.fillRect(flag.x-6,flag.y+flag.h-14,18,14);\n}\nfunction drawHUD(){\n  ctx.fillStyle='rgba(0,0,0,0.4)';ctx.fillRect(0,0,W,36);\n  ctx.fillStyle='#fff';ctx.font='16px \"Noto Sans CJK SC\",\"Microsoft YaHei\",monospace';\n  ctx.fillText('得分 '+score,14,24);\n  ctx.fillText('生命 ×'+Math.max(0,lives),160,24);\n  ctx.fillText('武器 '+(P.spread?'散弹':'普通'),280,24);\n}\nfunction overlay(title,lines,color){\n  ctx.fillStyle='rgba(0,0,0,0.55)';ctx.fillRect(0,0,W,H);\n  ctx.textAlign='center';\n  ctx.fillStyle=color;ctx.font='bold 48px \"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif';\n  ctx.fillText(title,W/2,H/2-70);\n  ctx.fillStyle='#fff';ctx.font='20px \"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif';\n  lines.forEach((l,i)=>ctx.fillText(l,W/2,H/2+i*36));\n  ctx.textAlign='left';\n}\nfunction draw(){\n  drawBackdrop();\n  ctx.save();ctx.translate(-camX,0);\n  for(const s of solids){\n    if(s.type==='ground'){\n      ctx.fillStyle='#5b3a20';ctx.fillRect(s.x,s.y,s.w,s.h);\n      ctx.fillStyle='#3f7d2c';ctx.fillRect(s.x,s.y,s.w,12);\n    }else{\n      ctx.fillStyle='#7a5230';ctx.fillRect(s.x,s.y,s.w,s.h);\n      ctx.fillStyle='#3f7d2c';ctx.fillRect(s.x,s.y,s.w,5);\n    }\n  }\n  drawFlag();\n  for(const p of powerups){\n    if(p.taken)continue;\n    const y=p.y+Math.sin(p.t)*6;\n    ctx.fillStyle='#c62828';ctx.fillRect(p.x,y,22,22);\n    ctx.fillStyle='#fff';ctx.fillRect(p.x+2,y+2,18,18);\n    ctx.fillStyle='#c62828';ctx.font='bold 15px monospace';ctx.textAlign='center';\n    ctx.fillText('S',p.x+11,y+17);ctx.textAlign='left';\n  }\n  for(const e of enemies)drawEnemy(e);\n  drawPlayer();\n  ctx.fillStyle='#ffe14d';for(const b of pbullets)ctx.fillRect(b.x,b.y,b.w,b.h);\n  ctx.fillStyle='#ff5a3c';for(const b of ebullets)ctx.fillRect(b.x,b.y,b.w,b.h);\n  ctx.restore();\n  drawHUD();\n  if(state==='title')overlay('魂斗罗 · 钢铁突击',\n    ['← → 移动    ↑ 瞄准上方    ↓ 蹲下 / 空中朝下','J 或 Z 开火    K / X / 空格 跳跃','击毁哨戒炮与敌兵，抵达终点旗帜即胜利','按 Enter 或 点击画面 开始任务'],'#ffd54a');\n  if(state==='over')overlay('GAME OVER',['最终得分 '+score,'按 Enter 重新开始'],'#ff5a3c');\n  if(state==='win')overlay('任务完成！',['最终得分 '+score,'按 Enter 再来一次'],'#7bd47b');\n}\n\n// ---------- input / loop ----------\naddEventListener('keydown',e=>{\n  if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].indexOf(e.key)>=0)e.preventDefault();\n  keys[e.key]=true;\n  if(e.key