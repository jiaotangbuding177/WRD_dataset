xdigest()\n\n\ndef to_number(v):\n    \"\"\"宽松数值化：None/空/不可解析 -> None。\"\"\"\n    if v is None:\n        return None\n    if isinstance(v, bool):\n        return None\n    if isinstance(v, (int, float)):\n        return float(v)\n    s = str(v).strip().replace(\",\", \"\").replace(\"%\", \"\")\n    if not s:\n        return None\n    try:\n        return float(s)\n    except ValueError:\n        return None\n\n\ndef load_sheet(path, sheet=None, header_row=1):\n    wb = openpyxl.load_workbook(path, data_only=True, read_only=True)\n    ws = wb[sheet] if sheet else wb[wb.sheetnames[0]]\n    rows = list(ws.iter_rows(values_only=True))\n    sheet_name = ws.title\n    wb.close()\n    if not rows:\n        return sheet_name, [], []\n    header = rows[header_row - 1]\n    headers = []\n    for i, h in enumerate(header):\n        name = str(h).strip() if h is not None else \"\"\n        headers.append(name or \"__col_%d\" % (i + 1))\n    data = []\n    for r in rows[header_row:]:\n        if r is None or all(c is None or (isinstance(c, str) and not c.strip()) for c in r):\n            continue\n        rec = {}\n        for i in range(len(headers)):\n            rec[headers[i]] = r[i] if i < len(r) else None\n        data.append(rec)\n    return sheet_name, headers, data\n\n\ndef resolve_column_map(column_map):\n    \"\"\"column_map: {列名: 角色字符串 或 {role: ...}} -> {角色: 列名}\"\"\"\n    role2col = {}\n    for col, spec in (column_map or {}).items():\n        if isinstance(spec, str):\n            role2col[spec] = col\n        elif isinstance(spec, dict) and spec.get(\"role\"):\n            role2col[spec[\"role\"]] = col\n    return role2col\n\n\ndef aggregate(values, agg):\n    nums = [x for x in (to_number(v) for v in values) if x is not None]\n    nonempty = [v for v in values if v is not None and str(v).strip() != \"\"]\n    if agg == \"count\":\n        return len(nonempty)\n    if agg == \"count_distinct\":\n        return len({str(v).strip() for v in nonempty})\n    if not nums:\n        return None\n    if agg == \"sum\":\n        return sum(nums)\n    if agg == \"avg\":\n        return sum(nums) / len(nums)\n    if agg == \"min\":\n        return min(nums)\n    if agg == \"max\":\n        return max(nums)\n    raise ValueError(\"未知聚合函数: %s\" % agg)\n\n\nKNOWN_AGGS = {\"sum\", \"count\", \"count_distinct\", \"avg\", \"min\", \"max\"}\n\n\ndef classify(value, thresholds):\n    \"\"\"按 label/min/max 顺序匹配：min<=v<=max（None 表示不设界），返回首个命中的label。\"\"\"\n    if value is None:\n        return None\n    for t in thresholds:\n        lo = t.get(\"min\")\n        hi = t.get(\"max\")\n        if (lo is None or value >= lo) and (hi is None or value <= hi):\n            return t.get(\"label\", \"?\")\n    return None\n\n\ndef run_analysis(request, request_path, output_root_arg):\n    uncovered = []\n    checks = []\n\n    def add_check(name, ok, detail=\"\"):\n        checks.append({\"name\": name, \"status\": \"PASS\" if ok else \"FAIL\", \"detail\": detail})\n        return ok\n\n    data_file = request.get(\"data_file\")\n    sheet = request.get(\"sheet\")\n    header_row = int(request.get(\"header_row\", 1))\n    column_map = request.get(\"column_map\") or {}\n    role2col = resolve_column_map(column_map)\n    group_by = request.get(\"group_by\") or []\n    measures = request.get(\"measures\") or []\n    bins = request.get(\"bins\") or []\n\n    # ---- 数据文件与SHA核验 ----\n    if not add_check(\"data_file_exists\", bool(data_file) and os.path.isfile(data_file),\n                     data_file or \"<missing>\"):\n        return None, {\"checks\": checks, \"uncovered\": uncovered, \"all_pass\": False}\n\n    actual_sha = sha256_file(data_file)\n    expected_sha = request.get(\"expected_sha256\")\n    if expected_sha:\n        add_check(\"sha256_match\", actual_sha.lower() == str(expected_sha).lower(), actual_sha)\n    else:\n        add_check(\"sha256_recorded\", True, actual_sha)\n\n    sheet_name, headers, data = load_sheet(data_file, sheet, header_row)\n    total_records = len(data)\n\n    # ---- 角色解析：已引用但未映射/列缺失 -> uncovered（不报错，继续分析） ----\n    def resolve(role):\n        col = role2col.get(role)\n        if col is None:\n            uncovered.append({\"kind\": \"role_not_mapped\", \"role\": role,\n                              \"detail\": \"group_by/measures/bins引用了该角色但column_map未映射\"})\n            return None\n        if col not in headers:\n            uncovered.append({\"kind\": \"column_not_found\", \"role\": role, \"column\": col,\n                              \"detail\": \"列在数据表中不存在\"})\n            return None\n        return col\n\n    group_roles = [r for r in group_by]\n    group_cols = {r: resolve(r) for r in group_roles}\n    measure_specs = []\n    for m in measures:\n        role = m.get(\"role\") if isinstance(m, dict) else m\n        agg = (m.get(\"agg\") if isinstance(m, dict) else None) or \"count\"\n        col = resolve(role)\n        measure_specs.append({\"role\": role, \"agg\": agg, \"column\": col})\n    bin_specs = []\n    for b in bins:\n        role = b.get(\"role\")\n        thresholds = b.get(\"thresholds\") or []\n        col = resolve(role)\n        bin_specs.append({\"role\": role, \"column\": col, \"thresholds\": thresholds})\n\n    # ---- 分组聚合 ----\n    groups = {}\n    order = []\n    for rec in data:\n        key = tuple((r, rec.get(group_cols[r]) if group_cols[r] else None) for r in group_roles if group_cols[r])\n        if not key:\n            key = ((\"__ALL__\", \"全部记录\"),)\n        if key not in groups:\n            groups[key] = {\"group\": {r: rec.get(group_cols[r]) for r in group_roles if group_cols[r]}\n                           if any(group_cols[r] for r in group_roles) else {\"__ALL__\": \"全部记录\"},\n                           \"record_count\": 0, \"measures\": {spec[\"role\"]: [] for spec in measure_specs}}\n            order.append(key)\n        g = groups[key]\n        g[\"record_count\"] += 1\n        for spec in measure_specs:\n            if spec[\"column\"]:\n                g[\"measures\"][spec[\"role\"]].append(rec.get(spec[\"column\"]))\n\n    group_rows = []\n    for key in order:\n        g = groups[key]\n        row = {\"group\": g[\"group\"], \"record_count\": g[\"record_count\"], \"measures\": {}}\n        for spec in measure_specs:\n            if spec[\"role\"] in g[\"measures\"]:\n                row[\"measures\"][spec[\"role\"]] = {\"agg\": spec[\"agg\"], \"value\": aggregate(g[\"measures\"][spec[\"role\"]], spec[\"agg\"])}\n        group_rows.append(row)\n\n    overall = {}\n    for spec in measure_specs:\n        if spec[\"column\"]:\n            overall[spec[\"role\"]] = {\"agg\": spec[\"agg\"], \"value\": aggregate([rec.get(spec[\"column\"]) for rec in data], spec[\"agg\"])}\n\n    # ---- 分档 ----\n    bin_results = []\n    for b in bin_specs:\n        col = b[\"column\"]\n        thresholds = b[\"thresholds\"]\n        entries = [{\"label\": t.get(\"label\"), \"min\": t.get(\"min\"), \"max\": t.get(\"max\"), \"count\": 0}\n                   for t in thresholds]\n        unclassified = 0\n        missing = 0\n        if col:\n            for rec in data:\n                v = to_number(rec.get(col))\n                if v is None:\n                    missing += 1\n                    continue\n                label = classify(v, thresholds)\n                hit = False\n                for e in entries:\n                    if e[\"label\"] == label and label is not None:\n                        e[\"count\"] += 1\n                        hit = True\n                        break\n                if not hit:\n                    unclassified += 1\n        valued = total_records - missing\n        add_check(\"bins_closed[%s]\" % b[\"role\"],\n                  (sum(e[\"count\"] for e in entries) + unclassified == valued) if col else True,\n                  \"valued=%d binned=%d unclassified=%d\" % (valued, sum(e[\"count\"] for e in entries), unclassified))\n        bin_results.append({\"role\": b[