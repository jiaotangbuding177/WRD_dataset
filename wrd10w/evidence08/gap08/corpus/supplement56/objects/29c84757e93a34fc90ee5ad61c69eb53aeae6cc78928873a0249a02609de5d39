mport WD_ALIGN_PARAGRAPH\n\ndoc = docx.Document()\nstyle = doc.styles['Normal']\nstyle.font.name = 'Noto Sans CJK SC'; style.font.size = Pt(10.5)\nstyle.element.rPr.rFonts.set(qn('w:eastAsia'), 'Noto Sans CJK SC')\n\ndef set_east(run):\n    run.font.name = 'Noto Sans CJK SC'\n    run._element.rPr.rFonts.set(qn('w:eastAsia'), 'Noto Sans CJK SC')\n\ndef para(text, bold=False, size=10.5, align=None):\n    p = doc.add_paragraph()\n    r = p.add_run(text); r.bold = bold; r.font.size = Pt(size); set_east(r)\n    if align: p.alignment = align\n    return p\n\ndef table(headers, rows, widths=None):\n    t = doc.add_table(rows=1, cols=len(headers)); t.style = 'Table Grid'\n    for i, h in enumerate(headers):\n        cell = t.rows[0].cells[i]\n        cell.text = ''\n        r = cell.paragraphs[0].add_run(str(h)); r.bold = True; r.font.size = Pt(9); set_east(r)\n        cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER\n    for row in rows:\n        cells = t.add_row().cells\n        for i, v in enumerate(row):\n            cells[i].text = ''\n            r = cells[i].paragraphs[0].add_run(str(v)); r.font.size = Pt(9); set_east(r)\n            cells[i].paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER\n    return t\n\nO = R['总览']\npara('成果转化摘要', bold=True, size=16, align=WD_ALIGN_PARAGRAPH.CENTER)\npara('统计口径：洽谈中项目不计入已实现转化金额；融资披露状态“无披露”仅指无公开披露，不等于未融资；去重公司数按创业公司编码去重；金额档位为0至100万元（含100）、超过100万元至300万元（含300）、超过300万元。数据源：inputs/成果转化.xlsx（64条成果记录）。全部数字与 成果赋权与转化分析.xlsx 及统计核验receipt.json一致，可逐项核对。', size=9)\n\n# Section 1\ns1 = (f\"全表共{O['成果数']}项成果，已转化{O['已转化数']}项、洽谈中{O['洽谈中数']}项；已实现转化金额{O['已实现转化金额万元']:,.2f}万元，\"\n      f\"洽谈中涉及金额{O['洽谈中涉及金额万元']:,.2f}万元未计入。四个技术领域各{R['按技术领域']['材料']['成果数']}项成果、\"\n      f\"已转化{R['按技术领域']['材料']['已转化数']}项、洽谈中{R['按技术领域']['材料']['洽谈中数']}项，结构完全均衡。\"\n      f\"已实现金额由高到低为：生物{R['按技术领域']['生物']['已实现转化金额万元']:,.2f}万元、装备{R['按技术领域']['装备']['已实现转化金额万元']:,.2f}万元、\"\n      f\"芯片{R['按技术领域']['芯片']['已实现转化金额万元']:,.2f}万元、材料{R['按技术领域']['材料']['已实现转化金额万元']:,.2f}万元，\"\n  