      add('source_id_missing', at)\n        if any((not text(x) for x in seq(ref.get('message_ids'), at + '/message_ids', True))):\n            add('message_ids_invalid', at)\n        if 'source_record_sha256' in ref and (not re.fullmatch('[a-f0-9]{64}', str(ref['source_record_sha256']))):\n            add('source_record_sha256_invalid', at)\n        if ref.get('origin') not in ('real_source', 'generated_fixture'):\n            add('fixture_origin_invalid', at)\n        filepin(ref.get('pin'), at + '/pin')\n\n    def identity(value, deps, at):\n        value = obj(value, at, _REQUIRED['interface'])\n        if value.get('kind') not in ('program', 'template', 'material', 'config'):\n            add('interface_kind_invalid', at)\n        for key in ('usage', 'contract_version'):\n            if not text(value.get(key)):\n                add('interface_' + key + '_missing', at)\n        for key in ('inputs', 'outputs'):\n            if any((not text(x) for x in seq(value.get(key), at + '/' + key, True))):\n                add('interface_' + key + '_invalid', at)\n        deps = seq(deps, at + '/dependencies')\n        for i, dep in enumerate(deps):\n            dep = obj(dep, at + '/dependencies/' + str(i))\n            if dep.get('kind') == 'runtime':\n                if not text(dep.get('name')) or not text(dep.get('version')) or dep.get('identity_sha256') != _FIXED_IMAGE.split(':')[1]:\n                    add('runtime_dependency_not_fixed_image', at)\n            elif dep.get('kind') == 'resource':\n                if any((not re.fullmatch('[a-f0-9]{64}', str(dep.get(k, ''))) for k in ('resource_id', 'content_sha256'))):\n                    add('resource_dependency_identity_missing', at)\n            else:\n                add('dependency_kind_invalid', at)\n        if value.get('kind') == 'program' and (not any((isinstance(d, dict) and d.get('kind') == 'runtime' for d in deps))):\n            add('program_requires_pinned_runtime_dependency', at)\n    files = set(