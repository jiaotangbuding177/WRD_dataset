os.walk(f\"{bind}/out\"):\n        for n in sorted(names):\n            p = os.path.join(root, n)\n            rel = os.path.relpath(p, f\"{bind}/out\")\n            raw = open(p, \"rb\").read()\n            out_files[rel] = {\"sha256\": hashlib.sha256(raw).hexdigest(), \"bytes\": len(raw)}\n    result = {\n        \"case\": cid, \"program\": program, \"argv\": argv,\n        \"expected_exit\": expect_exit, \"returncode\": r.returncode,\n        \"stdout\": r.stdout, \"stderr\": r.stderr,\n        \"outputs\": out_files,\n    }\n    ok = r.returncode == expect_exit\n    result[\"status\"] = \"PASS\" if ok else \"FAIL\"\n    print(json.dumps(result, ensure_ascii=False))\n    return result\n\nresults = [minimal_pin]\nresults.append(run_case(\"extract_normal\", \"scripts/extract_texts.py\", f\"{FIX}/manuscript.txt\", \"extracts\", 0))\nresults.append(run_case(\"extract_boundary\", \"scripts/extract_texts.py\", f\"{FIX}/tiny.txt\", \"out_boundary\", 0))\nresults.append(run_case(\"extract_docx\", \"scripts/extract_texts.py\", f\"{FIX}/manuscript.docx\", \"out_docx\", 0))\nresults.append(run_case(\"scan_normal\", \"scripts/scan_docx_keywords.py\", f\"{FIX}/manuscript.docx\", \"kh\", 0))\nresults.append(run_case(\"scan_boundary\", \"scripts/scan_docx_keywords.py\", f\"{FIX}/minimal.docx\", \"kh_boundary\", 0))\n\n# absent-path invalid cases: no file supplied\nfor cid, program in ((\"extract_absent\", \"scripts/extract_texts.py\"), (\"scan_absent\", \"scripts/scan_docx_keywords.py\")):\n    bind = f\"{REC}/bindings/{cid}\"\n    shutil.rmtree(bind, ignore_errors=True)\n    os.makedirs(f\"{bind}/input\", exist_ok=True)\n    os.makedirs(f\"{bind}/out\", exist_ok=True)\n    argv = [\"python\", f\"{SKILL}/{program}\", f\"{bind}/input/absent_file\", \"--out\", f\"{bind}/out/out_invalid\"]\n    r = subprocess.run(argv, capture_output=True, text=True)\n    results.append({\"case\": cid, \"program\": program, \"argv\": argv, \"expected_exit\": 2,\n                    \"returncode\":