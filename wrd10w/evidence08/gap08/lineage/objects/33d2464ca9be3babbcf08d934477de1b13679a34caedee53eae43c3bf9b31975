d('invalid_json_pointer', pos)\n            if kind in ('contains', 'not_contains', 'text_equals'):\n                if not text(value) or value.strip().upper() in ('PASS', 'SUCCESS', 'OK', 'TRUE'):\n                    add('vacuous_or_invalid_text_assertion', pos)\n                exhaustive |= kind == 'text_equals'\n            elif kind in ('json_equals', 'source_mapping', 'field_preservation'):\n                if value is None:\n                    add('expected_json_value_missing', pos)\n                categories.append('source_mapping' if kind == 'source_mapping' else 'field_preservation')\n                exhaustive |= pointer == ''\n            elif kind == 'json_count':\n                if type(value) is not int or value < 0:\n                    add('json_count_value_invalid', pos)\n                categories.append('record_count')\n            elif kind == 'json_keys':\n                if not isinstance(value, list) or not value or any((not text(x) for x in value)):\n                    add('json_keys_value_invalid', pos)\n            elif kind == 'explicit_error':\n                categories.append('explicit_error')\n            elif kind == 'sha256':\n                if not re.fullmatch('[a-f0-9]{64}', str(value)):\n                    add('expected_sha256_invalid', pos)\n                exhaustive = True\n            elif kind == 'zip_members':\n                if not isinstance(value, list) or not value:\n                    add('zip_members_must_be_nonempty_list', pos)\n                else:\n                    for member in value:\n                        relative(member, pos + '/value')\n                categories.append('artifact_structure')\n            elif kind == 'zip_xml_contains':\n                relative(a.get('member'), pos + '/member')\n                if not text(value):\n                    add('zip_xml_expected_text_missing', pos)\n                categories.append('artifact_structure')\n            elif kind == 'zip_member_count':