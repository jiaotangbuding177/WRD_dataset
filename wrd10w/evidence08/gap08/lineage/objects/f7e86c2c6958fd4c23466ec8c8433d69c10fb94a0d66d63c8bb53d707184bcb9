<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{TITLE}}</title>
<style>
:root{--bg:#0b1020;--panel:#141b33;--ink:#e8ecff;--muted:#9aa7d0;--accent:#38e1d4;--warn:#ff5d73;--line:#26304f}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:"Noto Sans SC","Microsoft YaHei",sans-serif;line-height:1.6}
nav{position:sticky;top:0;display:flex;gap:12px;padding:12px 20px;background:rgba(11,16,32,.92);border-bottom:1px solid var(--line);z-index:9;flex-wrap:wrap}
nav a{color:var(--muted);text-decoration:none;font-size:14px;padding:4px 10px;border-radius:6px}
nav a.active{color:var(--bg);background:var(--accent)}
header{padding:48px 20px 28px;text-align:center}
header h1{font-size:30px;letter-spacing:2px}
header p{color:var(--muted);margin-top:8px}
main{max-width:1080px;margin:0 auto;padding:0 20px 60px}
section{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;margin-top:28px;scroll-margin-top:70px;transition:transform .25s}
section:hover{transform:translateY(-3px)}
section h2{font-size:20px;border-left:4px solid var(--accent);padding-left:10px;margin-bottom:14px}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.badges span{border:1px solid var(--accent);color:var(--accent);border-radius:999px;padding:2px 12px;font-size:13px}
.stage{border:1px dashed var(--line);border-radius:10px;min-height:180px;display:flex;align-items:center;justify-content:center;color:var(--muted);margin:14px 0;text-align:center;padding:0 16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.card{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:14px}
.card h3{color:var(--accent);font-size:16px;margin-bottom:6px}
.card p{color:var(--muted);font-size:14px}
.card p.facts{color:var(--warn);font-size:13px;margin-top:6px}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{border:1px solid var(--line);padding:8px 10px;text-align:left}
th{background:var(--bg);color:var(--accent)}
.timeline{list-style:none}
.timeline li{border-left:2px solid var(--accent);padding:6px 0 6px 16px;position:relative}
.timeline li::before{content:"";position:absolute;left:-6px;top:14px;width:10px;height:10px;border-radius:50%;background:var(--accent)}
.quiz .question{margin-top:14px}
.quiz .question>p{margin-bottom:6px}
.quiz .options{display:flex;flex-wrap:wrap;gap:8px}
.quiz button{background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 14px;cursor:pointer}
.quiz button.correct{border-color:#39d98a;color:#39d98a}
.quiz button.wrong{border-color:var(--warn);color:var(--warn)}
.quiz .verdict{margin-top:8px;color:var(--muted);font-size:14px}
footer{text-align:center;color:var(--muted);font-size:13px;padding:24px}
@media (max-width:640px){header h1{font-size:22px}}
</style>
</head>
<body>
<nav id="top-nav">{{NAV_ITEMS}}</nav>
<header><h1>{{TITLE}}</h1><p>{{SUBTITLE}}</p></header>
<main>
{{SECTIONS}}
</main>
<footer>{{TITLE}} · 教学演示页 · 直接用浏览器打开本文件即可演示</footer>
<script>
document.querySelectorAll('.quiz .options').forEach(function(group){
  if(group.dataset.bound==='1'){return}
  group.dataset.bound='1';
  group.addEventListener('click',function(event){
    var btn=event.target.closest('button');
    if(!btn||group.dataset.done==='1'){return}
    group.dataset.done='1';
    var verdict=document.createElement('p');
    verdict.className='verdict';
    if(btn.dataset.correct==='1'){
      btn.classList.add('correct');
      verdict.textContent='回答正确！';
    }else{
      btn.classList.add('wrong');
      group.querySelectorAll('button[data-correct="1"]').forEach(function(ok){ok.classList.add('correct')});
      verdict.textContent='回答错误，正确答案已高亮。';
    }
    group.parentElement.appendChild(verdict);
  });
});
var links=document.querySelectorAll('#top-nav a');
if(links.length&&'IntersectionObserver' in window){
  var map={};
  links.forEach(function(a){map[a.getAttribute('href').slice(1)]=a});
  var watcher=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        links.forEach(function(a){a.classList.remove('active')});
        var link=map[entry.target.id];
        if(link){link.classList.add('active')}
      }
    });
  },{rootMargin:'-40% 0px -55% 0px'});
  document.querySelectorAll('main section').forEach(function(sec){watcher.observe(sec)});
}
</script>
</body>
</html>
