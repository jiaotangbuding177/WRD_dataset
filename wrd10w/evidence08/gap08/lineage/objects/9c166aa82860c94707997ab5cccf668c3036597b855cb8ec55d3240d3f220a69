{"type": "message", "id": "244f6bfb-0cd6-4680-a9bd-f804246cbdd0", "parentId": "b55b5546-9577-478c-a563-1e7cf7235099", "timestamp": "2026-10-21T16:26:10.715Z", "message": {"role": "toolResult", "toolCallId": "calle698e8b1f0364beb8351648cdd5c0255", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"知识库整理报告：用整理计划填报告模板，生成Markdown整理报告。\n\n方法：读取 kb_organize.py 产出的整理计划JSON（校验 schema）与报告模板MD，\n替换 {{KB_NAME}}/{{TOTAL_FILES}}/{{TOTAL_BYTES}}/{{CATEGORY_TABLE}}/\n{{DUPLICATE_SECTION}}/{{MOVE_SECTION}} 占位符；输出确定性文本，不写时间戳。\n公开用法（逐字见 SKILL.md）：\n  python {SKILL}/scripts/kb_report.py {INPUT}/plan.json --template {SKILL}/templates/maintenance_report_template.md --out {OUT}/maintenance_report.md\n用户要PDF时由Agent把报告转HTML后导出（Noto Sans CJK），失败按用户要求重试。\n错误一律打印 'kb_report_error: ...' 到 stderr 并退出 2。\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nimport sys\n\nSCHEMA = \"kb-organize-plan-v1\"\n\n\ndef fail(message: str) -> int:\n    print(\"kb_report_error: \" + message, file=sys.stderr)\n    return 2\n\n\ndef render(plan: dict, template: str) -> str:\n    rows = [\"| 分类 | 文件数 | 字节 |\", \"|---|---|---|\"]\n    for entry in plan.get(\"categories\", []):\n        rows.append(\"| \" + entry[\"category\"] + \" | \" + str(entry[\"file_count\"])\n                    + \" | \" + str(entry[\"bytes\"]) + \" |\")\n    if len(rows) == 2:\n        rows.append(\"| （空） | 0 | 0 |\")\n    category_table = \"\\n\".join(rows)\n    groups = plan.get(\"duplicates\", [])\n    if groups:\n        lines = []\n        for index, group in enumerate(groups, 1):\n            kept = group[0]\n            lines.append(\"- 组\" + str(index) + \"：\" + \"、\".join(group)\n                         + \" 内容重复（按 \" + plan.get(\"duplicate_policy\", \"report_only\")\n                         + \" 保留 \" + kept + \"，未删除）\")\n        duplicate_section = \"\\n\".join(lines)\n    else:\n        duplicate_section = \"未发现重复文件。\"\n    moves = plan.get(\"moves\", [])\n    if moves:\n        move_section = \"\\n\".join(\"- \" + m[\"from\"] + \" → \" + m[\"to\"] for m in moves)\n    else:\n        move_section = \"无移动。\"\n    summary = plan.get(\"summary\", {})\n    return (template\n            .replace(\"{{KB_NAME}}\", plan.get(\"kb_name\", \"kb\"))\n            .replace(\"{{TOTAL_FILES}}\", str(summary.get(\"total_files\", 0)))\n            .replace(\"{{TOTAL_BYTES}}\", str(summary.get(\"total_bytes\", 0)))\n            .replace(\"{{CATEGORY_TABLE}}\", category_table)\n            .replace(\"{{DUPLICATE_SECTION}}\", duplicate_section)\n            .replace(\"{{MOVE_SECTION}}\", move_section))\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"用整理计划与模板生成知识库整理报告Markdown\")\n    parser.add_argument(\"plan\", help=\"整理计划JSON路径（kb_organize.py 产出）\")\n    parser.add_argument(\"--template\", required=True, help=\"报告模板MD路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出报告MD路径\")\n    args = parser.parse_args()\n    if not os.path.isfile(args.plan):\n        return fail(\"plan file not found: \" + args.plan)\n    try:\n        with open(args.plan, encoding=\"utf-8-sig\") as fh:\n            plan = json.load(fh)\n    except (OSError, ValueError) as error:\n        return fail(\"plan is not valid JSON: \" + str(error))\n    if not isinstance(plan, dict) or plan.get(\"schema\") != SCHEMA:\n        return fail(\"plan schema mismatch (expected \" + SCHEMA + \")\")\n    if not os.path.isfile(args.template):\n        return fail(\"template file not found: \" + args.template)\n    try:\n        with open(args.template, encoding=\"utf-8-sig\") as fh:\n            template = fh.read()\n    except OSError as error:\n        return fail(\"cannot read template: \" + str(error))\n    report = render(plan, template)\n    try:\n        with open(args.out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(report)\n    except OSError as error:\n        return fail(\"cannot write output: \" + str(error))\n