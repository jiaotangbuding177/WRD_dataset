ma\": SCHEMA, \"kb_name\": kb_name,\n            \"total_files\": len(files), \"total_bytes\": sum(f[\"bytes\"] for f in files),\n            \"dirs\": dirs, \"files\": files}\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"扫描知识库目录生成JSON清单（含每文件sha256）\")\n    parser.add_argument(\"kb\", help=\"知识库目录路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出清单JSON路径\")\n    args = parser.parse_args()\n    try:\n        inventory = scan(args.kb)\n    except ValueError as error:\n        print(\"kb_inventory_error: \" + str(error), file=sys.stderr)\n        return 2\n    payload = json.dumps(inventory, ensure_ascii=False, indent=2) + \"\\n\"\n    try:\n        with open(args.out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(payload)\n    except OSError as error:\n        print(\"kb_inventory_error: cannot write output: \" + str(error), file=sys.stderr)\n        return 2\n    print(\"inventory written: \" + args.out + \" (\" + str(inventory[\"total_files\"]) + \" files)\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"知识库盘点：把知识库目录扫描成确定性的JSON清单。\n\n方法：递归 os.walk（跳过符号链接），逐文件计算 sha256，输出按路径排序；\n不写时间戳，同一批文件在任何绑定路径下输出一致（kb_name 取目录名）。\n公开用法（逐字见 SKILL.md）：\n  python {SKILL}/scripts/kb_inventory.py {INPUT}/kb --out {OUT}/inventory.json\n错误一律打印 'kb_inventory_error: ...' 到 stderr 并退出 2。\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport hashlib\nimport json\nimport os\nimport sys\n\nSCHEMA = \"kb-inventory-v1\"\n\n\ndef scan(kb_path: str) -> dict:\n    \"\"\"扫描目录；目录不存在时抛 ValueError。\"\"\"\n    if not os.path.isdir(kb_path):\n        raise ValueError(\"KB directory not found: \" + kb_path)\n    files, dirs = [], []\n    for root, dirnames, filenames in os.walk(kb_path):\n        dirnames[:] = sorted(d for d in dirnames if not os.path.islink(os.path.join(root, d)))\n        rel_root = os.path.relpath(root, kb_path)\n        for d in dirnames:\n            dirs.append(d if rel_root == \".\" else os.path.join(rel_root, d).replace(os.sep, \"/\"))\n        for name in sorted(filenames):\n            full = os.path.join(root, name)\n            if os.path.islink(full) or not os.path.isfile(full):\n                continue\n            rel = name if rel_root == \".\" else os.path.join(rel_root, name).replace(os.sep, \"/\")\n            with open(full, \"rb\") as fh:\n                data = fh.read()\n            ext = os.path.splitext(name)[1].lower().lstrip(\".\")\n            files.append({\"path\": rel, \"bytes\": len(data), \"ext\": ext,\n                          \"sha256\": hashlib.sha256(data).hexdigest()})\n    files.sort(key=lambda x: x[\"path\"])\n    dirs.sort()\n    kb_name = os.path.basename(os.path.normpath(kb_path))\n    return {\"schema\": SCHEMA, \"kb_name\": kb_name,\n            \"total_files\": len(files), \"total_bytes\": sum(f[\"bytes\"] for f in files),\n            \"dirs\": dirs, \"files\": files}\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"扫描知识库目录生成JSON清单（含每文件sha256）\")\n    parser.add_argument(\"kb\", help=\"知识库目录路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出清单JSON路径\")\n    args = parser.parse_args()\n    try:\n        inventory = scan(args.kb)\n    except ValueError as error:\n        print(\"kb_inventory_error: \" + str(error), file=sys.stderr)\n        return 2\n    payload = json.dumps(inventory, ensure_ascii=False, indent=2) + \"\\n\"\n    try:\n        with open(args.out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(payload)\n    except OSError as error:\n        print(\"kb_inventory_error: cannot write output: \" + str(error), file=sys.stderr)\n        return 2\n    print(\"inventory written: \" + args.out + \" (\" + str(inventory[\"total_files\"]) + \" files)\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}, "isError": false, "timestamp": 1792599