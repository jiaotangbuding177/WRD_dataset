 "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792600400120, "responseId": "chatcmpl-1792600400174", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "378df10b-af96-4a3f-9ab4-88705dd22335"}}}
