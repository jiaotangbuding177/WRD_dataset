{"type": "message", "id": "460b61c7-b058-4df2-acb3-60e653878b11", "parentId": "fdf4825c-0f18-4ef2-a5ea-8eabc74a0574", "timestamp": "2026-10-21T16:26:10.144Z", "message": {"role": "toolResult", "toolCallId": "call64b911357db7445eabdf63bbfdb8088b", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"知识库整理：按用户确认的口径生成分类/去重/重命名整理计划（默认不动文件）。\n\n方法：先校验口径JSON（categories 必须存在），再复用 kb_inventory.scan 盘点；\n按扩展名映射分类，相同 sha256 的文件判为重复（duplicate_policy=report_only 时\n只报告不移动，保留排序后首份），目标路径冲突自动加后缀重命名；输出确定性JSON。\n--apply 目标目录 时按计划复制归位（不删除、不覆盖已存在目标，原文件保留）。\n公开用法（逐字见 SKILL.md）：\n  python {SKILL}/scripts/kb_organize.py {INPUT}/kb --rules {SKILL}/templates/organize_rules.json --out {OUT}/organize_plan.json\n错误一律打印 'kb_organize_error: ...' 到 stderr 并退出 2。\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nimport shutil\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom kb_inventory import scan\n\nSCHEMA = \"kb-organize-plan-v1\"\n\n\ndef fail(message: str) -> int:\n    print(\"kb_organize_error: \" + message, file=sys.stderr)\n    return 2\n\n\ndef load_rules(path: str) -> dict:\n    if not os.path.isfile(path):\n        raise ValueError(\"rules file not found: \" + path)\n    try:\n        with open(path, encoding=\"utf-8-sig\") as fh:\n            rules = json.load(fh)\n    except (OSError, ValueError) as error:\n        raise ValueError(\"rules file is not valid JSON: \" + str(error))\n    if not isinstance(rules, dict) or not isinstance(rules.get(\"categories\"), dict) or not rules[\"categories\"]:\n        raise ValueError(\"rules missing categories mapping\")\n    for category, exts in rules[\"categories\"].items():\n        if not isinstance(category, str) or not isinstance(exts, list) or not all(isinstance(x, str) for x in exts):\n            raise ValueError(\"rules categories mapping invalid\")\n    return rules\n\n\ndef build_plan(kb_path: str, rules: dict) -> dict:\n    inventory = scan(kb_path)\n    suffix = rules.get(\"conflict_suffix\", \"-1\")\n    unmatched = rules.get(\"unmatched_category\", \"其他\")\n    category_by_ext = {}\n    for category, exts in rules[\"categories\"].items():\n        for ext in exts:\n            category_by_ext[ext.lower()] = category\n    by_hash = {}\n    for item in inventory[\"files\"]:\n        by_hash.setdefault(item[\"sha256\"], []).append(item[\"path\"])\n    duplicate_groups, duplicate_paths = [], set()\n    for digest, paths in sorted(by_hash.items()):\n        if len(paths) > 1:\n            ordered = sorted(paths)\n            duplicate_groups.append(ordered)\n            duplicate_paths.update(ordered[1:])\n    moves, renames, used, stats = [], [], set(), {}\n    for item in inventory[\"files\"]:\n        if item[\"path\"] in duplicate_paths:\n            continue\n        category = category_by_ext.get(item[\"ext\"], unmatched)\n        target = category + \"/\" + os.path.basename(item[\"path\"])\n        if target in used:\n            base, ext = os.path.splitext(os.path.basename(item[\"path\"]))\n            counter = 1\n            while True:\n                candidate = category + \"/\" + base + suffix + str(counter) + ext\n                if candidate not in used:\n                    break\n                counter += 1\n            renames.append({\"from\": item[\"path\"], \"to\": candidate})\n            target = candidate\n        used.add(target)\n        moves.append({\"from\": item[\"path\"], \"to\": target})\n        entry = stats.setdefault(category, {\"file_count\": 0, \"bytes\": 0})\n        entry[\"file_count\"] += 1\n        entry[\"bytes\"] += item[\"bytes\"]\n    categories = [{\"category\": c, \"file_count\": v[\"file_count\"], \"bytes\": v[\"bytes\"]}\n                  for c, v in sorted(stats.items())]\n    return {\"schema\": SCHEMA, \"kb_name\": inventory[\"kb_name\"],\n            \"summary\": {\"total_files\": inventory[\"total_files\"], \"total_bytes\": inventory[\"total_bytes\"],\n                        \"kept_files\": len(moves), \"duplicate_files\": len(duplicate_paths),\n                        \"move_count\": len(moves), \"rename_count\": len(renames)},\n            \"categories\": categories, \"moves\": moves, \"renames\": renames,\n            \"duplicates\": duplicate_groups,\n            \"duplicate_policy\": rules.get(\"duplicate_policy\", \"report_only\"), \"applied\": False}\n\n\ndef apply_plan(kb_path: str, dest: str, plan: dict) -> None:\n    for move in plan[\"moves\"]:\n        source = os.path.join(kb_path, move[\"from\"].replace(\"/\", os.sep))\n        target = os.path.join(dest, move[\"to\"].replace(\"/\", os.sep))\n        if os.path.exists(target):\n            raise ValueError(\"apply target already exists: \" + target)\n        os.makedirs(os.path.dirname(target), exist_ok=True)\n        shutil.copy2(source, target)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"按确认口径生成知识库整理计划JSON（默认不移动文件）\")\n    parser.add_argument(\"kb\", help=\"知识库目录路径\")\n    parser.add_argument(\"--rules\", required=True, help=\"整理口径JSON路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出整理计划JSON路径\")\n    parser.add_argument(\"--apply\", dest=\"apply_dest\", default=None,\n                        help=\"可选：用户确认后把保留文件复制归位到该目录（不删除原文件）\")\n    args = parser.parse_args()\n    try:\n        rules = load_rules(args.rules)\n        plan = build_plan(args.kb, rules)\n        if args.apply_dest:\n            apply_plan(args.kb, args.apply_dest, plan)\n            plan[\"applied\"] = True\n            plan[\"apply_dest\"] = args.apply_dest\n    except ValueError as error:\n        return fail(str(error))\n    payload = json.dumps(plan, ensure_ascii=False, indent=2) + \"\\n\"\n    try:\n        with open(args.out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(payload)\n    except OSError as error:\n        return fail(\"cannot write output: \" + str(error))\n    print(\"plan written: \" + args.out + \" (\" + str(plan[\"summary\"][\"move_count\"]) + \" moves, \"\n          + str(plan[\"summary\"][\"duplicate_files\"]) + \" duplicates)\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"知识库整理：按用户确认的口径生成分类/去重/重命名整理计划（默认不动文件）。\n\n方法：先校验口径JSON（categories 必须存在），再复用 kb_inventory.scan 盘点；\n按扩展名映射分类，相同 sha256 的文件判为重复（duplicate_policy=report_only 时\n只报告不移动，保留排序后首份），目标路径冲突自动加后缀重命名；输出确定性JSON。\n--apply 目标目录 时按计划复制归位（不删除、不覆盖已存在目标，原文件保留）。\n公开用法（逐字见 SKILL.md）：\n  python {SKILL}/scripts/kb_organize.py {INPUT}/kb --rules {SKILL}/templates/organize_rules.json --out {OUT}/organize_plan.json\n错误一律打印 'kb_organize_error: ...' 到 stderr 并退出 2。\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nimport shutil\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom kb_inventory import scan\n\nSCHEMA = \"kb-organize-plan-v1\"\n\n\ndef fail(message: str) -> int:\n    print(\"kb_organize_error: \" + message, file=sys.stderr)\n    return 2\n\n\ndef load_rules(path: str) -> dict:\n    if not os.path.isfile(path):\n        raise ValueError(\"rules file not found: \" + path)\n    try:\n        with open(path, encoding=\"utf-8-sig\") as fh:\n            rules = json.load(fh)\n    except (OSError, ValueError) as error:\n        raise ValueError(\"rules file is not valid JSON: \" + str(error))\n    if not isinstance(rules, dict) or not isinstance(rules.get(\"categories\"), dict) or not rules[\"categories\"]:\n        raise ValueError(\"rules missing categories mapping\")\n    for category, exts in rules[\"categories\"].items():\n        if not isinstance(category, str) or not isinstance(exts, list) or not all(isinstance(x, str) for x in exts):\n            raise ValueError(\"rules categories mapping invalid\")\n    return rules\n\n\ndef build_plan(kb_path: str, rules: dict) -> dict:\n    inventory = scan(kb_path)\n   