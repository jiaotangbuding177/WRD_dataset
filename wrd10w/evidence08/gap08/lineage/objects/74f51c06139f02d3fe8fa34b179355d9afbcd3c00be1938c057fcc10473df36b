#!/usr/bin/env python3
# 制作测试样例：模板(带公式+填报须知) + 源报表(.xls) + values.json
from openpyxl import Workbook
from pathlib import Path

base = Path(__file__).parent

wb = Workbook()
ws = wb.active
ws.title = "填报须知"
for i, line in enumerate([
    "填报须知",
    "1. 本模板按财会〔2019〕6号格式编制，一份表覆盖2023-2026年6月各期。",
    "2. 公司成立晚于某年度的，该年度列保持0，不得填写。",
    "3. 合计行/小计行为公式自动汇总，只填明细行，请勿修改表结构。",
], 1):
    ws.cell(row=i, column=1, value=line)

bs = wb.create_sheet("资产负债表")
bs["A1"] = "项目"
for col, y in zip("BCDE", ["2023年末", "2024年末", "2025年末", "2026年6月末"]):
    bs["%s1" % col] = y
rows = ["货币资金", "其他应收款", "流动资产合计", "实收资本", "未分配利润", "负债及所有者权益合计"]
for i, name in enumerate(rows, 2):
    bs["A%d" % i] = name
for col in "BCDE":
    bs["%s4" % col] = "=SUM(%s2:%s3)" % (col, col)
    bs["%s7" % col] = "=SUM(%s5:%s6)" % (col, col)

isx = wb.create_sheet("利润表")
isx["A1"] = "项目"
isx["B1"] = "2025年度"
isx["C1"] = "2026年1-6月"
for i, name in enumerate(["营业收入", "营业成本", "管理费用", "财务费用", "销售费用"], 2):
    isx["A%d" % i] = name
isx["A7"] = "营业利润"; isx["A8"] = "利润总额"; isx["A9"] = "净利润"
for col in "BC":
    isx["%s7" % col] = "=%s2-%s3-%s4-%s5-%s6" % (col, col, col, col, col)
    isx["%s8" % col] = "=%s7" % col
    isx["%s9" % col] = "=%s8" % col

cf = wb.create_sheet("现金流量表")
cf["A1"] = "项目"; cf["B1"] = "2025年度"; cf["C1"] = "2026年1-6月"
for i, name in enumerate(["支付其他与经营活动有关的现金", "经营活动产生的现金流量净额",
                          "吸收投资收到的现金", "筹资活动产生的现金流量净额",
                          "现金及现金等价物净增加额", "期初现金余额", "期末现金余额"], 2):
    cf["A%d" % i] = name
for col in "BC":
    cf["%s3" % col] = "=-%s2" % col
    cf["%s5" % col] = "=%s4" % col
    cf["%s6" % col] = "=%s3+%s5" % (col, col, col)
    cf["%s8" % col] = "=%s6+%s7" % (col, col, col)
wb.save(base / "公司财务报表模板.xlsx")

# 源报表（小企业会计准则风格，两期）
src = Workbook()
s1 = src.active; s1.title = "2025年度"
s1.append(["项目", "金额"])
for k, v in [("货币资金", 1076.49), ("其他应收款", 27100.00), ("实收资本", 60500.00),
             ("未分配利润", -32323.51), ("管理费用", 32232.00), ("财务费用", 91.51),
             ("支付其他与经营活动有关的现金", 59423.51), ("吸收投资收到的现金", 60500.00)]:
    s1.append([k, v])
s2 = src.create_sheet("2026年1-6月")
s2.append(["项目", "金额"])
for k, v in [("货币资金", 2488.39), ("其他应收款", 54900.00), ("实收资本", 120500.00),
             ("未分配利润", -63111.61), ("管理费用", 631.50), ("财务费用", 156.60),
             ("销售费用", 30000.00), ("支付其他与经营活动有关的现金", 58588.10),
             ("吸收投资收到的现金", 60000.00)]:
    s2.append([k, v])
src.save(base / "源报表.xlsx")
print("samples created")
