#!/usr/bin/env python3
"""制作样例：生成代表性银行日记账 + 2025年度汇总模板 xlsx（结构对照真实任务族）。
临时制作样例，不属于技能交付物。"""
import datetime as dt
from openpyxl import Workbook
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side

OUT = "/workspace/outputs/making_samples"

# ---- 银行日记账（两个 sheet，含日期字符串/datetime/斜杠日期三种格式）----
ledger = [
    ("2025-08-07", "出资款（上海绘勉）", 50100, None),
    ("2025-09-10", "投资款（上海溢新）", 100000, None),
    ("2025-10-12", "报销（李蓉）", None, 2600),
    ("2025-11-05", "网银服务费", None, 177.64),
    ("2025-11-20", "专利评估服务费（一力行）", None, 11000),
    ("2025-12-21", "收息", 13.96, None),
    ("2026-01-02", "押金退还", 500, None),          # 故意未命中规则，验证未归类与对账不符
    ("2026-01-21", "网银服务费", None, 25),
    (dt.datetime(2026, 2, 5), "备用金（李蓉）", None, 2800),
    ("2026-02-20", "报销（李蓉）", None, 1788.8),
    ("2026/3/21", "收息", 8.01, None),
    ("2026-04-10", "对外投资（对合生纪康出资）", None, 10000),
    (dt.datetime(2026, 4, 16), "报销（孔德强）", None, 441.08),
    ("2026-04-21", "网银服务费", None, 25),
    ("2026-04-28", "对外投资（对合生纪康出资）", None, 15000),
    ("2026-05-21", "网银服务费", None, 25),
    ("2026-05-26", "大零号湾科技创新策源功能区专款（补贴）", 100000, None),
    ("2026-05-29", "对外投资（对合生纪康出资）", None, 15000),
    ("2026-06-21", "收息", 7.6, None),
    ("2026-06-21", "网银服务费", None, 25),
]
# 1-6月每月网银25：上面 1,2,4,5,6 月有了，补3月
ledger.insert(11, ("2026-03-21b", "网银服务费", None, 25))
ledger[11] = ("2026-03-15", "网银服务费", None, 25)

wb = Workbook()
ws = wb.active
ws.title = "合生纪日记账"
ws.append(["序号", "日期", "摘要", "收入", "支出", "余额"])
balance = 0.0
for i, (d, s, inc, exp) in enumerate(ledger, 1):
    balance += (inc or 0) - (exp or 0)
    ws.append([i, d, s, inc, exp, round(balance, 2)])

ws2 = wb.create_sheet("合生纪康日记账")
ws2.append(["序号", "日期", "摘要", "收入", "支出", "余额"])
b2 = 0.0
for i, (d, s, inc, exp) in enumerate([
    ("2026-02-05", "合生纪出资款", 20000, None),
    ("2026-03-21", "收息", 0.13, None),
    ("2026-06-21", "收息", 0.29, None),
], 1):
    b2 += (inc or 0) - (exp or 0)
    ws2.append([i, d, s, inc, exp, round(b2, 2)])
wb.save(OUT + "/银行日记账样例.xlsx")

# ---- 2025年度汇总模板（公式结构对照真实表：小计/净现金流/累计=A4+净现金流）----
t = Workbook()
s = t.active
s.title = "现金流汇总"
bold = Font(bold=True)
thin = Side(style="thin")
border = Border(left=thin, right=thin, top=thin, bottom=thin)
s["A1"] = "合生纪2025年年度现金流汇总"
s["A1"].font = Font(bold=True, size=14)
s["C3"], s["D3"], s["E3"] = "项目名称", "金额", "摘要"
s["A4"] = 101500.59
rows = {
    4: ("期初余额", None, None),
    5: ("一、经营性流入", None, None),
    6: ("经营性流入", 0, ""),
    7: ("账户结息", 0.14, ""),
    8: ("实收资本", 60500, "上海绘勉50100；上海溢新100000"),
    9: ("营业收入小计", "=D6+D7+D8", None),
    10: ("流入合计", "=D9", None),
    11: ("二、经营性流出", None, None),
    12: ("员工报销", 932, ""),
    13: ("服务费", 58400, "微康30000；松淼4000；知企邦5000；墨眉1300；亚星10000；一力行5500；汶桦2600"),
    14: ("专利评估服务费", 0, ""),
    15: ("其他支出", 91.65, ""),
    16: ("营业支出小计", "=D12+D13+D14+D15", None),
    17: ("三、投资性流出", None, None),
    18: ("长期股权投资", 60500, ""),
    19: ("净现金流", "=D10-D16-D18", None),
    20: ("累计净现金流", "=A4+D19", None),
}
for r, (label, amount, note) in rows.items():
    s.cell(row=r, column=3, value=label)
    if amount is not None:
        s.cell(row=r, column=4, value=amount)
    if note:
        s.cell(row=r, column=5, value=note)
    for col in (3, 4, 5):
        c = s.cell(row=r, column=col)
        c.border = border
        if label and ("小计" in label or "合计" in label or label.startswith(("一", "二", "三")) or "净现金流" in label or "期初" in label):
            c.font = bold
for col, w in (("C", 20), ("D", 14), ("E", 40)):
    s.column_dimensions[col].width = w
for r in (4, 6, 7, 8, 12, 13, 14, 15, 18):
    s.cell(row=r, column=4).number_format = "#,##0.00"
t.save(OUT + "/2025年度现金流汇总模板样例.xlsx")
print("fixtures written: 银行日记账样例.xlsx（期末余额 %.2f）, 2025年度现金流汇总模板样例.xlsx" % balance)
