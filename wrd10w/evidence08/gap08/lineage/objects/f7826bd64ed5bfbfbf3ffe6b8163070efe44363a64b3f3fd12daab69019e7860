def slide_xml(index: int) -> str:
    return (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n'
        f'<p:sld xmlns:a="{NS["a"]}" xmlns:r="{NS["r"]}" xmlns:p="{NS["p"]}">'
        f'<p:cSld>{EMPTY_SPTREE}'
        f'<p:pic><p:nvPicPr><p:cNvPr id="2" name="Picture {index}"/>'
        '<p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr><p:nvPr/></p:nvPicPr>'
        '<p:blipFill><a:blip r:embed="rId1"/><a:stretch><a:fillRect/></a:stretch></p:blipFill>'
        f'<p:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="{SLIDE_W_EMU}" cy="{SLIDE_H_EMU}"/></a:xfrm>'
        '<a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr></p:pic>'
        '</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>'
    )


def slide_rels(index: int, extension: str) -> str:
    return (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n'
        f'<Relationships xmlns="{NS["rel"]}">'
        '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" '
        f'Target="../media/image{index}.{extension}"/>'
        '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout" Target="../slideLayouts/slideLayout1.xml"/>'
        "</Relationships>"
    )


def fail(message: str) -> None:
    print("pptx_error: " + message, file=sys.stderr)
    raise SystemExit(2)


def image_format(data: bytes):
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if data.startswith(b"\xff\xd8\xff"):
        return "jpeg"
    return None


def load_plan(path: str, images_dir: Path):
    try:
        raw = Path(path).read_bytes()
    except OSError as error:
        fail(f"cannot read plan file: {error}")
    try:
        plan = json.loads(raw.decode("utf-8-sig"))
    except (UnicodeError, ValueError) as error:
        fail(f"plan is not valid JSON: {error}")
    if not isinstance(plan, dict):
        fail("plan must be a JSON object")
    pages = plan.get("pages")
    if isinstance(pages, bool) or not isinstance(pages, int) or not 1 <= pages <= 50:
        fail("pages must be an integer between 1 and 50")
    slides = plan.get("slides")
    if not isinstance(slides, list):
        fail("slides must be a list")
    if len(slides) != pages:
        fail(f"slides count {len(slides)} does not match pages {pages}")
    entries = []
    for position, slide in enumerate(slides, start=1):
        if not isinstance(slide, dict):
            fail(f"slide {position} must be a JSON object")
        image_path = slide.get("image_path")
        if (
            not isinstance(image_path, str)
            or not image_path
            or PurePosixPath(image_path).is_absolute()
            or any(part in ("", ".", "..") for part in image_path.split("/"))
            or "\\" in image_path
            or ":" in image_path
        ):
            fail(f"slide {position} has an unsafe image_path")
        image = images_dir / image_path
        try:
            resolved = image.resolve()
            resolved.relative_to(images_dir.resolve())
        except (OSError, ValueError):
            fail(f"slide {position} image escapes the images directory")
        if not image.is_file():
            fail(f"slide {position} image file is missing: {image_path}")
        try:
            data = image.read_bytes()
        except OSError as error:
            fail(f"cannot read slide {position} image: {error}")
        extension = image_format(data)
        if extension is None:
            fail(f"slide {position} image is not a PNG or JPEG file")
        entries.append((image_path, extension, data))
    return pages, entries


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Assemble per-slide images into a 16:9 image-type PPTX."
    )
    parser.add_argument("plan", help="slide plan JSON path")
    parser.add_argument("--images", required=True, help="directory holding the slide images")
    parser.add_argument("--out", required=True, help="output PPTX path")
    args = parser.parse_args()

    images_dir = Path(args.images)
    if not images_dir.is_dir():
        fail("images directory does not exist")
    pages, entries = load_plan(args.plan, images_dir)

    out = Path(args.out)
    try:
        if out.parent and not out.parent.exists():
            out.parent.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        fail(f"cannot create output directory: {error}")

    slide_overrides = "".join(
        f'<Override PartName="/ppt/slides/slide{index}.xml" '
        'ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/>'
        for index in range(1, pages + 1)
    )
    parts: list[tuple[str, str]] = [
        ("[Content_Types].xml", CONTENT_TYPES.replace("{SLIDE_OVERRIDES}", slide_overrides)),
        ("_rels/.rels", ROOT_RELS),
        ("docProps/core.xml", CORE_XML),
        ("docProps/app.xml", app_xml(pages)),
        ("ppt/presentation.xml", presentation_xml(pages)),
        ("ppt/_rels/presentation.xml.rels", presentation_rels(pages)),
        ("ppt/slideMasters/slideMaster1.xml", SLIDE_MASTER),
        ("ppt/slideMasters/_rels/slideMaster1.xml.rels", SLIDE_MASTER_RELS),
        ("ppt/slideLayouts/slideLayout1.xml", SLIDE_LAYOUT),
        ("ppt/slideLayouts/_rels/slideLayout1.xml.rels", SLIDE_LAYOUT_RELS),
        ("ppt/theme/theme1.xml", THEME),
    ]
    for index, (image_path, extension, data) in enumerate(entries, start=1):
        parts.append((f"ppt/slides/slide{index}.xml", slide_xml(index)))
        parts.append((f"ppt/slides/_rels/slide{index}.xml.rels", slide_rels(index, extension)))
    media: dict[str, bytes] = {}
    for index, (image_path, extension, data) in enumerate(entries, start=1):
        name = f"image{index}.{ 'jpg' if extension == 'jpeg' else extension }"
        media[f"ppt/media/{name}"] = data

    try:
        with zipfile.ZipFile(out, "w", compression=zipfile.ZIP_STORED) as package:
            for name, content in parts:
                if name.startswith("ppt/media/"):
                    continue
                info = zipfile.ZipInfo(name, date_time=FIXED_ZIP_DATE)
                info.external_attr = 0o600 << 16
                package.writestr(info, content.encode("utf-8"))
            for name, data in media.items():
                info = zipfile.ZipInfo(name, date_time=FIXED_ZIP_DATE)
                info.external_attr = 0o600 << 16
                package.writestr(info, data)
    except OSError as error:
        fail(f"cannot write PPTX file: {error}")
    print(str(out))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
