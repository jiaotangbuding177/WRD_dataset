#!/usr/bin/env python3
"""Extract a teaching-page spec from a real conversation JSON.

Reads a conversation export and derives the teaching demo topic, the
interaction elements and the section plan that build_teaching_page.py needs,
so a new teaching page does not start from an unstructured transcript.

Public usage:
    python {SKILL}/scripts/extract_topic_spec.py {INPUT}/conversation.json --out {OUT}/page_spec.json

Input: conversation JSON {"session_id": str, "messages": [{"id": str, "content": str|list|dict}]}
Output: page-spec JSON {"topic","request_text","source_id","source_message_id","interactions","sections"}
Errors: exit 2 with a single-line "extract_topic_spec_error: ..." diagnostic on stderr.
"""
from __future__ import annotations

import argparse
import json
import re
import sys

REQUEST_PATTERN = re.compile(r"生成|教学|演示|讲解|制作|做一个")
POLITE_PREFIX = re.compile(r"^(请你|请|帮我|麻烦|帮忙)+")
REQUEST_VERB = re.compile(r"^(生成|制作|做|写|画)")
HTML_TOKEN = ***"html", re.IGNORECASE)
STRIP_CHARS = " ，,。.：:的份一"
SUBJECT_PATTERN = re.compile(r"([\u4e00-\u9fffA-Za-z0-9]+?)(演示|教学|动画|页面|网页|课件)")

INTERACTION_RULES = [
    ("slider", ("调节", "滑块", "拖动", "参数调节")),
    ("auto_demo", ("自动演示", "自动播放")),
    ("quiz", ("测验", "选择题", "答题")),
    ("nav", ("导航", "跳转", "目录")),
    ("animation", ("动画", "实时", "动态")),
]
SECTION_RULES = [
    ("demo", ("演示", "模拟", "实验")),
    ("cards", ("卡片", "详情", "介绍")),
    ("table", ("表格", "对比")),
    ("timeline", ("里程碑", "时间线", "历史", "探索")),
    ("quiz", ("测验", "选择题")),
]
SECTION_TITLES = {
    "demo": "互动演示",
    "cards": "知识卡片",
    "table": "数据对比",
    "timeline": "探索里程碑",
    "quiz": "课堂小测验",
}


class SpecError(Exception):
    pass


def text_leaves(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for item in value:
            yield from text_leaves(item)
    elif isinstance(value, dict):
        for item in value.values():
            yield from text_leaves(item)


def clean_request(text):
    cleaned = POLITE_PREFIX.sub("", text.strip())
    cleaned = REQUEST_VERB.sub("", cleaned, count=1)
    cleaned = HTML_TOKEN.sub("", cleaned)
    return cleaned.strip(STRIP_CHARS)


def extract_topic(cleaned):
    match = SUBJECT_PATTERN.search(cleaned)
    if match:
        return match.group(0)
    return cleaned


def detect(text, rules, seen):
    found = []
    for key, words in rules:
        if key in seen:
            continue
        if any(word in text for word in words):
            seen.add(key)
            found.append(key)
    return found


def build_spec(record):
    if not isinstance(record, dict):
        raise SpecError("conversation must be a JSON object")
    messages = record.get("messages")
    if not isinstance(messages, list):
        raise SpecError("conversation must have a messages list")
    session_id = record.get("session_id", record.get("source_id"))
    if not isinstance(session_id, str) or not session_id:
        raise SpecError("conversation needs a string session_id")
    texts = []
    for message in messages:
        if not isinstance(message, dict) or not isinstance(message.get("id"), str) or not message["id"]:
            raise SpecError("every message needs a non-empty string id")
        body = "".join(text_leaves(message.get("content", "")))
        texts.append((message["id"], body))
    request = next(
        ((mid, body) for mid, body in texts if REQUEST_PATTERN.search(body)),
        texts[0] if texts else ("", ""),
    )
    request_id, request_text = request
    topic = extract_topic(clean_request(request_text))
    corpus = "\n".join(body for _, body in texts)
    interactions = detect(corpus, INTERACTION_RULES, set())
    sections = [
        {"kind": kind, "title": SECTION_TITLES[kind]}
        for kind in detect(corpus, SECTION_RULES, set())
    ]
    return {
        "topic": topic,
        "request_text": request_text,
        "source_id": session_id,
        "source_message_id": request_id,
        "interactions": interactions,
        "sections": sections,
    }


def main():
    parser = argparse.ArgumentParser(description="Extract a teaching-page spec from a conversation JSON.")
    parser.add_argument("source", help="conversation JSON file to read")
    parser.add_argument("--out", required=True, help="path of the page-spec JSON to write")
    args = parser.parse_args()
    try:
        try:
            raw = open(args.source, "rb").read()
        except OSError as error:
            raise SpecError(f"cannot read source file: {error}")
        try:
            record = json.loads(raw.decode("utf-8-sig"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise SpecError(f"invalid JSON in conversation file: {error}")
        spec = build_spec(record)
        payload = json.dumps(spec, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
        try:
            with open(args.out, "w", encoding="utf-8") as handle:
                handle.write(payload)
        except OSError as error:
            raise SpecError(f"cannot write output file: {error}")
    except SpecError as error:
        print(f"extract_topic_spec_error: {error}", file=sys.stderr)
        return 2
    print(f"wrote {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
