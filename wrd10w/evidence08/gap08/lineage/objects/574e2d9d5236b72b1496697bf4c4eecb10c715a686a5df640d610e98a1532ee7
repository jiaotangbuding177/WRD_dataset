#!/usr/bin/env python3
"""程序化封面/标题页：背景图压暗 + 中文标题 + 副标题 + 多列清单 + 底部信息。

中文一律用本机 Noto Sans CJK 真字体渲染，零乱码（生图模型画中文必乱码）。
输入：规格 JSON + 可选背景图；输出：PNG 封面页（再交 images_to_pdf.py 合册）。

公开用法：
  python make_cover.py COVER_SPEC_JSON --out COVER.png
错误：exit 2（cover_error: ...）输入/路径/格式问题。
"""
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont


def fail(message: str) -> None:
    print("cover_error: " + message, file=sys.stderr)
    raise SystemExit(2)


def find_font(size: int) -> ImageFont.FreeTypeFont:
    if shutil.which("fc-match"):
        try:
            raw = subprocess.run(["fc-match", "-f", "%{file}", "Noto Sans CJK SC"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
        except subprocess.SubprocessError:
            raw = ""
        for path in filter(None, [raw, "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"]):
            candidate = Path(path)
            if candidate.is_file():
                try:
                    return ImageFont.truetype(str(candidate), size)
                except OSError:
                    continue
    fail("no CJK font found (need Noto Sans CJK SC)")


def load_spec(path: str) -> dict:
    try:
        with open(path, encoding="utf-8-sig") as handle:
            spec = json.load(handle)
    except OSError as error:
        fail(f"cannot read spec: {error}")
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"invalid spec JSON: {error}")
    if not isinstance(spec, dict) or not str(spec.get("title", "")).strip():
        fail("spec must be a JSON object with non-empty 'title'")
    return spec


def draw_centered(draw, y, text, font, color, width):
    left, top, right, bottom = draw.textbbox((0, 0), text, font=font)
    draw.text(((width - (right - left)) // 2, y), text, font=font, fill=color)
    return bottom - top


def main() -> int:
    parser = argparse.ArgumentParser(description="程序化生成封面页 PNG")
    parser.add_argument("spec", help="封面规格 JSON 路径")
    parser.add_argument("--out", required=True, help="输出 PNG 路径")
    args = parser.parse_args()
    spec = load_spec(args.spec)

    size = spec.get("page_size") or [1920, 1080]
    if (not isinstance(size, list) or len(size) != 2
            or not all(isinstance(v, int) and 100 <= v <= 8192 for v in size)):
        fail("page_size must be [width, height] ints in 100..8192")
    width, height = size
    accent = spec.get("accent", "#d4af37")
    try:
        bg_dark = float(spec.get("bg_dark", 0.55))
    except (TypeError, ValueError):
        fail("bg_dark must be a number in 0..1")
    if not 0 <= bg_dark <= 1:
        fail("bg_dark must be within 0..1")

    bg_path = spec.get("background")
    if bg_path:
        source = Path(bg_path)
        if not source.is_file():
            fail(f"background image not found: {bg_path}")
        try:
            background = Image.open(source).convert("RGB")
        except OSError as error:
            fail(f"cannot decode background: {error}")
        scale = max(width / background.width, height / background.height)
        background = background.resize(
            (round(background.width * scale), round(background.height * scale)))
        left = (background.width - width) // 2
        top = (background.height - height) // 2
        background = background.crop((left, top, left + width, top + height))
    else:
        background = Image.new("RGB", (width, height), "#101418")
    overlay = Image.new("L", (width, height), round(255 * bg_dark))
    background = Image.composite(Image.new("RGB", (width, height), "#000000"),
                                 background, overlay)
    draw = ImageDraw.Draw(background)

    title_font = find_font(round(height * 0.16))
    subtitle_font = find_font(round(height * 0.045))
    list_font = find_font(round(height * 0.038))
    footer_font = find_font(round(height * 0.032))

    y = round(height * 0.16)
    y += draw_centered(draw, y, spec["title"], title_font, accent, width) + round(height * 0.04)
    line_w = round(width * 0.24)
    draw.rectangle(((width - line_w) // 2, y, (width + line_w) // 2, y + 4), fill=accent)
    y += round(height * 0.035)
    for sub_line in str(spec.get("subtitle", "")).split("\n"):
        if sub_line.strip():
            y += draw_centered(draw, y, sub_line, subtitle_font, "#e8e8e8", width) + 8

    items = [str(item) for item in spec.get("items", []) if str(item).strip()]
    if items:
        columns = int(spec.get("list_columns", 2))
        if not 1 <= columns <= 3:
            fail("list_columns must be 1..3")
        rows = (len(items) + columns - 1) // columns
        col_w = round(width * 0.86) // columns
        x0 = round(width * 0.07)
        row_h = list_font.size + 14
        y_list = min(y + round(height * 0.05), height - rows * row_h - round(height * 0.16))
        for index, item in enumerate(items):
            row, col = divmod(index, columns)
            draw.text((x0 + col * col_w, y_list + row * row_h), item,
                      font=list_font, fill="#f0f0f0")

    footer = str(spec.get("footer", "")).strip()
    if footer:
        footer_y = height - round(height * 0.09) - (footer.count("\n")) * footer_font.size
        for footer_line in footer.split("\n"):
            footer_y += draw_centered(draw, footer_y, footer_line, footer_font,
                                      "#c8c8c8", width) + 6

    out = Path(args.out)
    try:
        if out.parent and not out.parent.exists():
            out.parent.mkdir(parents=True, exist_ok=True)
        background.save(out)
    except OSError as error:
        fail(f"cannot write output: {error}")
    print(f"{out} ({width}x{height})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
