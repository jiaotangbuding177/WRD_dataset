#!/usr/bin/env python3
"""反馈问题分类统计与图表生成（无状态子命令）。

用法（原样可执行，全部参数按当前任务实际文件传入）:
  python3 feedback_analyze.py stats <记录.csv|json|jsonl> --out stats.json
      [--type-col 问题类型] [--status-col 处理状态] [--priority-col 优先级]
      [--person-col 提出人] [--date-col 提交时间] [--text-col 反馈内容]
      [--id-col 编号] [--scenarios 场景关键词.json]
  python3 feedback_analyze.py charts stats.json --out-dir charts [--font 字体文件]

stats: 读反馈记录，产出 stats.json——类型/状态/优先级分布、类型×状态、
  缺陷优先级×状态（解决率）、按状态分组清单、提出人Top、日期趋势、
  场景归类（--scenarios 时）。它是报告全部数字与图的唯一口径来源。
  列名不猜：默认名找不到必需列（类型/状态）时退出2并列出全部列名。
charts: 由 stats.json 生成状态环形图、类型×优先级堆叠图、日期趋势图、
  缺陷优先级×状态堆叠图（缺数据的图自动跳过）。中文字体默认经
  fc-match 解析 Noto Sans CJK SC，可用 --font 指定字体文件。

退出码：0 成功；2 用法/输入错误（stderr 说明）。
"""
import argparse
import csv
import datetime as dt
import json
import re
import sys
from collections import Counter, defaultdict
from pathlib import Path

SCHEMA = "feedback-issue-stats-v1"

DEFAULTS = {
    "type": ["问题类型", "类型", "bug分类", "分类"],
    "status": ["处理状态", "状态", "当前状态"],
    "priority": ["优先级", "级别"],
    "person": ["提出人", "填写人", "反馈人", "账号", "提交人"],
    "date": ["提交时间", "填写日期", "日期", "创建时间", "反馈时间"],
    "text": ["反馈内容", "问题描述", "问题内容", "内容", "反馈"],
    "id": ["编号", "问卷编号", "问题编号", "ID", "id", "序号"],
}
DATE_FORMATS = ("%Y-%m-%d", "%Y/%m/%d", "%Y.%m.%d", "%Y-%m-%d %H:%M:%S",
                "%Y/%m/%d %H:%M", "%Y-%m-%dT%H:%M:%S", "%m/%d/%Y")


def fail(msg):
    print("feedback_analyze_error: " + msg, file=sys.stderr)
    return 2


def load_records(path):
    p = Path(path)
    if not p.is_file():
        raise ValueError("input not found: " + str(p))
    suffix = p.suffix.lower()
    if suffix == ".csv":
        raw = p.read_bytes()
        for enc in ("utf-8-sig", "gbk"):
            try:
                text = raw.decode(enc)
                break
            except UnicodeDecodeError:
                continue
        else:
            raise ValueError("csv decode failed (tried utf-8/gbk)")
        return list(csv.DictReader(text.splitlines()))
    if suffix == ".jsonl":
        return [json.loads(line) for line in p.read_text(encoding="utf-8").splitlines() if line.strip()]
    if suffix == ".json":
        data = json.loads(p.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            data = data.get("records")
        if not isinstance(data, list):
            raise ValueError("json must be a record array or {\"records\": [...]}")
        return data
    raise ValueError("unsupported suffix " + suffix + ": use csv/json/jsonl")


def resolve_columns(records, args):
    fields = set()
    for row in records:
        fields.update(k for k in row.keys() if k is not None)
    mapping, warnings = {}, []
    for role, names in DEFAULTS.items():
        explicit = getattr(args, role + "_col", None)
        if explicit:
            if explicit not in fields:
                raise ValueError("--%s-col '%s' not in columns; got: %s" % (role, explicit, ", ".join(sorted(fields))))
            mapping[role] = explicit
            continue
        hit = next((n for n in names if n in fields), None)
        if hit:
            mapping[role] = hit
        elif role in ("type", "status"):
            raise ValueError("required column for '%s' not found by default names %s. "
                             "Actual columns: %s. Pass --%s-col explicitly." %
                             (role, names, ", ".join(sorted(fields)), role))
        else:
            warnings.append("column '%s' not found; related output omitted" % role)
    return mapping, sorted(fields), warnings


def parse_date(value):
    value = (value or "").strip()
    for fmt in DATE_FORMATS:
        try:
            return dt.datetime.strptime(value, fmt).strftime("%Y-%m-%d")
        except ValueError:
            continue
    m = re.match(r"(\d{4})-(\d{1,2})-(\d{1,2})", value)
    if m:
        return "%04d-%02d-%02d" % (int(m.group(1)), int(m.group(2)), int(m.group(3)))
    return None


def count_stats(records, mapping, scenario_kw):
    valid, blank = [], []
    for i, row in enumerate(records, 1):
        row = {k: v for k, v in row.items() if k is not None}
        rec = {role: str(row.get(col) or "").strip() for role, col in mapping.items()}
        if not any(rec.values()):
            blank.append(i)
            continue
        rec["_no"] = i
        valid.append(rec)

    type_c = Counter(r["type"] or "（未填）" for r in valid)
    status_c = Counter(r["status"] or "（未填）" for r in valid)
    prio_c = Counter(r["priority"] for r in valid if r.get("priority"))

    def matrix(row_key, col_key):
        m = defaultdict(Counter)
        for r in valid:
            if r.get(row_key) and r.get(col_key):
                m[r[row_key]][r[col_key]] += 1
        return {k: dict(v) for k, v in m.items()}

    defects = [r for r in valid if "缺陷" in (r["type"] or "") or "bug" in (r["type"] or "").lower()]
    defect = None
    if defects and any(r.get("priority") for r in defects):
        solved = sum(1 for r in defects if "已解决" in (r["status"] or ""))
        defect = {
            "total": len(defects),
            "solved": solved,
            "solve_rate": round(solved / len(defects), 4),
            "priority_status": matrix_of(defects, "priority", "status"),
        }

    status_lists = defaultdict(list)
    for r in valid:
        status_lists[r["status"] or "（未填）"].append({
            k: r.get(k, "") for k in ("id", "person", "date", "type", "priority") if r.get(k)
        } | {"text": (r.get("text") or "")[:80]})

    daily, bad_dates = Counter(), 0
    dates = []
    if "date" in mapping:
        for r in valid:
            d = parse_date(r.get("date", ""))
            if d:
                daily[d] += 1
                dates.append(d)
            elif (r.get("date") or "").strip():
                bad_dates += 1

    scenarios = None
    if scenario_kw:
        kw = json.loads(Path(scenario_kw).read_text(encoding="utf-8"))
        scenarios = {name: {"count": 0, "keywords": names, "priority": Counter(), "examples": []}
                     for name, names in kw.items()}
        scenarios["未归类"] = {"count": 0, "keywords": [], "priority": Counter(), "examples": []}
        for r in valid:
            text = (r.get("text") or "")
            target = next((name for name, info in scenarios.items()
                           if info["keywords"] and any(k.lower() in text.lower() for k in info["keywords"])),
                          "未归类")
            scenarios[target]["count"] += 1
            if r.get("priority"):
                scenarios[target]["priority"][r["priority"]] += 1
            if len(scenarios[target]["examples"]) < 5:
                scenarios[target]["examples"].append({k: r.get(k, "") for k in ("id", "person") if r.get(k)}
                                                     | {"text": text[:60]})
        for info in scenarios.values():
            info["priority"] = dict(info["priority"])

    return {
        "schema": SCHEMA,
        "input": str(Path(mapping and "" or "")),
        "columns_used": mapping,
        "total": len(records),
        "valid": len(valid),
        "blank": len(blank),
        "blank_rows": blank,
        "type_counts": dict(type_c),
        "status_counts": dict(status_c),
        "priority_counts": dict(prio_c),
        "type_status": matrix("type", "status"),
        "type_priority": matrix("type", "priority"),
        "defect": defect,
        "status_lists": dict(status_lists),
        "person_counts": dict(Counter(r["person"] for r in valid if r.get("person")).most_common(10)),
        "date_range": {"min": min(dates), "max": max(dates)} if dates else None,
        "daily_counts": dict(sorted(daily.items())),
        "scenarios": scenarios,
        "warnings": (["%d date value(s) unparseable, excluded from trend" % bad_dates] if bad_dates else []),
    }


def matrix_of(rows, row_key, col_key):
    m = defaultdict(Counter)
    for r in rows:
        if r.get(row_key) and r.get(col_key):
            m[r[row_key]][r[col_key]] += 1
    return {k: dict(v) for k, v in m.items()}


def sorted_desc(counter_dict):
    return dict(sorted(counter_dict.items(), key=lambda kv: (-kv[1], kv[0])))


def cmd_stats(args):
    try:
        records = load_records(args.input)
    except (ValueError, json.JSONDecodeError) as e:
        return fail(str(e))
    if not records:
        return fail("no records in " + args.input)
    try:
        mapping, fields, warnings = resolve_columns(records, args)
    except ValueError as e:
        return fail(str(e))
    try:
        stats = count_stats(records, mapping, args.scenarios)
    except (json.JSONDecodeError, OSError, ValueError) as e:
        return fail("scenario keyword json: " + str(e))
    for key in ("type_counts", "status_counts", "priority_counts", "person_counts", "daily_counts"):
        stats[key] = sorted_desc(stats[key])
    stats["input"] = args.input
    stats["columns_used"] = mapping
    stats["all_columns"] = fields
    stats["warnings"] = (stats["warnings"] or []) + warnings
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(stats, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("stats -> %s | valid %d / blank %d | types %s | statuses %s" %
          (args.out, stats["valid"], stats["blank"],
           json.dumps(stats["type_counts"], ensure_ascii=False),
           json.dumps(stats["status_counts"], ensure_ascii=False)))
    for w in stats["warnings"]:
        print("WARN: " + w, file=sys.stderr)
    return 0


def cmd_charts(args):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib import font_manager

    p = Path(args.font) if args.font else None
    if not p:
        import subprocess
        try:
            f = subprocess.run(["fc-match", "-f", "%{file}", "Noto Sans CJK SC"],
                               capture_output=True, text=True, timeout=10).stdout.strip()
            p = Path(f) if f else None
        except Exception:
            p = None
    if p and Path(p).is_file():
        font_manager.fontManager.addfont(str(p))
        name = font_manager.FontProperties(fname=str(p)).get_name()
        plt.rcParams["font.family"] = name
    else:
        print("WARN: CJK font not found; charts may show boxes", file=sys.stderr)
    plt.rcParams["axes.unicode_minus"] = False

    stats = json.loads(Path(args.input).read_text(encoding="utf-8"))
    if stats.get("schema") != SCHEMA:
        print("WARN: unexpected schema " + str(stats.get("schema")), file=sys.stderr)
    outdir = Path(args.out_dir)
    outdir.mkdir(parents=True, exist_ok=True)
    generated, skipped = [], []
    colors = plt.cm.tab20.colors

    def finish(fig, name):
        fig.savefig(outdir / name, dpi=150, bbox_inches="tight")
        plt.close(fig)
        generated.append(name)

    status = stats["status_counts"]
    if status:
        labels, vals = list(status), list(status.values())
        total = sum(vals)

        def ring_label(pct):
            n = int(round(pct / 100 * total))
            match = next((l for l, v in zip(labels, vals) if v == n), None)
            return "%s\n%d条\n%.0f%%" % (match, n, pct) if match else ""

        fig, ax = plt.subplots(figsize=(7, 5.2))
        wedges, _, _ = ax.pie(
            vals, labels=None, autopct=ring_label, pctdistance=0.79,
            colors=colors[:len(vals)], startangle=90,
            wedgeprops=dict(width=0.42, edgecolor="white"))
        ax.legend(wedges, ["%s（%d）" % (k, v) for k, v in status.items()],
                  loc="center left", bbox_to_anchor=(1.0, 0.5), fontsize=10)
        ax.text(0, 0, "%d条反馈" % sum(vals), ha="center", va="center", fontsize=13)
        ax.set_title("处理状态分布", fontsize=14)
        finish(fig, "chart_status_donut.png")
    else:
        skipped.append("status donut (no status data)")

    tp = stats["type_priority"]
    if tp:
        types = sorted(tp, key=lambda t: -sum(tp[t].values()))
        prios = sorted({p for v in tp.values() for p in v})
        fig, ax = plt.subplots(figsize=(8, 5))
        bottom = [0] * len(types)
        for i, prio in enumerate(prios):
            vals = [tp[t].get(prio, 0) for t in types]
            ax.bar(types, vals, bottom=bottom, label=prio, color=colors[i])
            bottom = [b + v for b, v in zip(bottom, vals)]
        for x, t in enumerate(types):
            ax.text(x, bottom[x] + 0.15, str(bottom[x]), ha="center", va="bottom", fontsize=10)
        ax.set_ylim(0, max(bottom) * 1.2)
        ax.set_title("反馈类型 × 优先级", fontsize=14)
        ax.legend(title="优先级")
        finish(fig, "chart_type_priority.png")
    else:
        skipped.append("type×priority (no priority data)")

    daily = stats["daily_counts"]
    if daily:
        fig, ax = plt.subplots(figsize=(8, 4.2))
        xs = list(daily)
        ax.plot(xs, list(daily.values()), marker="o", color="#3b6ea5")
        ax.fill_between(xs, list(daily.values()), alpha=0.15, color="#3b6ea5")
        ax.set_title("反馈数量时间趋势", fontsize=14)
        fig.autofmt_xdate(rotation=45)
        finish(fig, "chart_daily_trend.png")
    else:
        skipped.append("daily trend (no date data)")

    d = stats.get("defect")
    if d and d.get("priority_status"):
        ps = d["priority_status"]
        prios = sorted(ps, key=lambda q: -sum(ps[q].values()))
        statuses = sorted({s for v in ps.values() for s in v})
        fig, ax = plt.subplots(figsize=(8, 5))
        bottom = [0] * len(prios)
        for i, st in enumerate(statuses):
            vals = [ps[q].get(st, 0) for q in prios]
            ax.bar(prios, vals, bottom=bottom, label=st, color=colors[i])
            bottom = [b + v for b, v in zip(bottom, vals)]
        for x, q in enumerate(prios):
            total, solved = sum(ps[q].values()), ps[q].get("已解决", 0)
            ax.text(x, bottom[x] + 0.15, "%d项\n解决%d%%" % (total, round(100 * solved / total)),
                    ha="center", va="bottom", fontsize=9)
        ax.set_ylim(0, max(bottom) * 1.3)
        ax.set_title("缺陷优先级 × 处理状态（共%d项，解决率%.0f%%）" % (d["total"], 100 * d["solve_rate"]),
                     fontsize=13)
        ax.legend(title="状态")
        finish(fig, "chart_defect_status.png")
    else:
        skipped.append("defect priority×status (no defect/priority data)")

    print("charts -> %d in %s%s" % (len(generated), outdir,
          "" if not generated else ": " + ", ".join(generated)))
    for s in skipped:
        print("SKIP: " + s)
    return 0 if generated else fail("no chart generated (all underlying data missing)")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("stats", help="统计口径 -> stats.json")
    s.add_argument("input")
    s.add_argument("--out", required=True)
    for role in DEFAULTS:
        s.add_argument("--%s-col" % role)
    s.add_argument("--scenarios", help="场景关键词JSON：{\"场景\": [\"词\", ...]}")
    s.set_defaults(func=cmd_stats)

    c = sub.add_parser("charts", help="stats.json -> 图表png")
    c.add_argument("input")
    c.add_argument("--out-dir", required=True)
    c.add_argument("--font", help="中文字体文件路径；默认fc-match Noto Sans CJK SC")
    c.set_defaults(func=cmd_charts)

    args = parser.parse_args()
    raise SystemExit(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
