#!/usr/bin/env python3
"""按既有汇总表模板生成新期间现金流量汇总（保留公式与样式）。

用法:
  python3 summary_build.py --template 上期汇总.xlsx --journal journal.json \
      --start YYYY-MM-DD --end YYYY-MM-DD --out 新汇总.xlsx \
      [--rules rules.json] [--opening 1076.49] [--title 新标题]

journal.json 由本技能 scripts/journal_extract.py 生成。
行为:
- 复制模板工作簿生成新表，样式/合并单元格/列宽/公式全部保留；
- 按 rules.categories 的摘要关键词把期内流水分类，回填到模板对应项目行（金额列）；
- extra_items 中金额非 0 的项目在 after 指定行后插入新行（复制行样式），
  小计公式自动扩展（加号式追加 +D行，SUM 式扩展区间），其余公式行号整体平移；
- 期初余额写入 rules.opening_cell：默认取开始日前最后一笔的余额，--opening 覆盖；
- 未命中任何规则的流水逐条列出，不编造归类，人工判断后补规则副本重跑；
- 退出码: 0 成功; 2 参数/文件错误; 3 模板中未找到项目行; 4 有未归类流水（文件仍生成）。
不修改输入文件。
"""
import argparse
import copy as copymod
import datetime as dt
import json
import re
import sys
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.utils import get_column_letter

DEFAULT_RULES = Path(__file__).resolve().parent.parent / "templates" / "summary_rules.json"
rules = {}


def parse_date(value):
    if value is None:
        return None
    if isinstance(value, dt.datetime):
        return value.date()
    if isinstance(value, dt.date):
        return value
    text = str(value).strip().replace("年", "-").replace("月", "-").replace("日", "")
    text = text.replace("/", "-").replace(".", "-")
    m = re.match(r"^(\d{4})-(\d{1,2})-(\d{1,2})", text)
    if not m:
        return None
    try:
        return dt.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        return None


def load_entries(journal_path):
    """读流水 JSON；只有金额列没有收入/支出列时，用余额增减判断方向。"""
    data = json.loads(Path(journal_path).read_text(encoding="utf-8"))
    entries = []
    for f in data.get("files", []):
        for s in f.get("sheets", []):
            prev_balance = None
            for e in s.get("entries", []):
                amounts = e.get("amounts", {})
                income, expense = amounts.get("income"), amounts.get("expense")
                amount, balance = amounts.get("amount"), amounts.get("balance")
                if income is None and expense is None and amount is not None:
                    if prev_balance is not None and balance is not None:
                        if balance > prev_balance:
                            income = amount
                        elif balance < prev_balance:
                            expense = amount
                    elif amount < 0:
                        expense = -amount
                    else:
                        income = amount
                if balance is not None:
                    prev_balance = balance
                entries.append({
                    "date": parse_date(e.get("date")),
                    "summary": (e.get("summary") or "") + " " + " ".join(e.get("raw", [])),
                    "summary0": e.get("summary") or "",
                    "income": income,
                    "expense": expense,
                    "balance": balance,
                })
    return entries


def classify(entries, start, end):
    """返回 (归类结果{label:[entry]}, 未归类[entry])；规则顺序首条命中生效。"""
    cats = rules.get("categories", []) + rules.get("extra_items", [])
    result = {c["label"]: [] for c in cats}
    unmatched = []
    for e in entries:
        if not (start <= e["date"] <= end):
            continue
        has_income = e["income"] not in (None, 0)
        has_expense = e["expense"] not in (None, 0)
        hit = None
        for c in cats:
            if any(k in e["summary"] for k in c.get("match", [])) and not any(
                    k in e["summary"] for k in c.get("exclude", [])):
                scope = c.get("scope")
                if scope == "income" and has_income:
                    hit = c
                elif scope == "expense" and has_expense:
                    hit = c
                if hit:
                    break
        if hit:
            result[hit["label"]].append(e)
        else:
            unmatched.append(e)
    return result, unmatched


def find_label_layout(ws, labels):
    """扫描工作表定位项目名称列（精确命中标签最多的列）及各标签所在行。"""
    col_hits, label_rows = {}, {}
    for row in ws.iter_rows():
        for cell in row:
            v = cell.value
            if not isinstance(v, str):
                continue
            text = v.strip()
            for lb in labels:
                if text == lb and lb not in label_rows:
                    label_rows[lb] = cell.row
                    col_hits[cell.column] = col_hits.get(cell.column, 0) + 1
    if not label_rows:
        return None, {}
    return max(col_hits, key=col_hits.get), label_rows


def shift_formulas(ws, min_row, offset):
    """insert_rows 不会平移公式引用，这里把行号 >= min_row 的引用 +offset。"""
    if offset == 0:
        return
    ref_re = re.compile(r'(\$?)([A-Z]{1,3})(\$?)(\d+)')
    for row in ws.iter_rows():
        for cell in row:
            v = cell.value
            if isinstance(v, str) and v.startswith("="):
                parts, last = [], 0
                for m in ref_re.finditer(v):
                    parts.append(v[last:m.start()])
                    r = int(m.group(4))
                    if r >= min_row:
                        r += offset
                    parts.append("%s%s%s%d" % (m.group(1), m.group(2), m.group(3), r))
                    last = m.end()
                parts.append(v[last:])
                cell.value = "".join(parts)


def copy_row_style(ws, src_row, dst_row, col_start, col_end):
    for col in range(col_start, col_end + 1):
        s, d = ws.cell(row=src_row, column=col), ws.cell(row=dst_row, column=col)
        d._style = copymod.copy(s._style)
    if src_row in ws.row_dimensions and "height" in ws.row_dimensions[src_row]:
        ws.row_dimensions[dst_row].height = ws.row_dimensions[src_row].height


def extend_subtotals(ws, label_col, anchor_row, new_rows):
    """把引用了锚点行的小计公式补上新行：加号式追加，SUM 式扩区间。"""
    marker = rules.get("subtotal_marker", "小计")
    col = get_column_letter(label_col + 1)
    first, last = new_rows[0], new_rows[-1]
    for row in ws.iter_rows():
        for cell in row:
            v = cell.value
            if not (isinstance(v, str) and v.startswith("=")):
                continue
            lb = ws.cell(row=cell.row, column=label_col).value
            if not (isinstance(lb, str) and marker in lb):
                continue
            plus_refs = [int(x) for x in re.findall(r'%s(\d+)' % col, v)]
            if anchor_row in plus_refs:
                cell.value = v + "+" + "+".join("%s%d" % (col, r) for r in new_rows)
                continue
            for m in re.finditer(r'SUM\(%s(\d+):%s(\d+)\)' % (col, col), v):
                lo, hi = int(m.group(1)), int(m.group(2))
                if lo <= anchor_row <= hi:
                    cell.value = v[:m.start()] + "SUM(%s%d:%s%d)" % (
                        col, min(lo, first), col, max(hi, last)) + v[m.end():]
                    break


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--template", required=True, help="上期汇总表 xlsx（作为格式与公式模板）")
    ap.add_argument("--journal", required=True, help="journal_extract.py 输出的流水 JSON")
    ap.add_argument("--start", required=True, help="数据起始日期 YYYY-MM-DD")
    ap.add_argument("--end", required=True, help="数据截止日期 YYYY-MM-DD")
    ap.add_argument("--out", required=True, help="输出文件")
    ap.add_argument("--rules", default=None, help="分类规则 JSON（用户口径不同时传修改后的副本）")
    ap.add_argument("--opening", type=float, default=None, help="期初余额覆盖；缺省取开始日前最后一笔余额")
    ap.add_argument("--title", default=None, help="可选：替换表标题（第一个非空字符串单元格）")
    args = ap.parse_args()

    global rules
    rules = json.loads(Path(args.rules or DEFAULT_RULES).read_text(encoding="utf-8"))
    start, end = parse_date(args.start), parse_date(args.end)
    if not start or not end or start > end:
        print("summary_build error: --start/--end 日期无效", file=sys.stderr)
        return 2
    if not Path(args.template).is_file() or not Path(args.journal).is_file():
        print("summary_build error: 模板或流水文件不存在", file=sys.stderr)
        return 2

    entries = [e for e in load_entries(args.journal) if e["date"]]
    if not entries:
        print("summary_build error: 流水中无可识别日期的条目", file=sys.stderr)
        return 2
    grouped, unmatched = classify(entries, start, end)

    wb = load_workbook(args.template)
    ws = wb.worksheets[0]
    all_labels = [c["label"] for c in rules.get("categories", [])] + \
                 [c["label"] for c in rules.get("extra_items", [])]
    label_col, label_rows = find_label_layout(ws, all_labels)
    if not label_rows:
        print("summary_build error: 模板中未找到任何规则里的项目行标签，检查 --rules 与模板是否匹配", file=sys.stderr)
        return 3
    missing_rows = [lb for lb in all_labels if lb not in label_rows]

    opening = args.opening
    if opening is None:
        prior = [e for e in entries if e["date"] < start and e["balance"] is not None]
        if prior:
            opening = prior[-1]["balance"]
        else:
            opening = 0
            print("summary_build: 开始日前无带余额流水，期初余额按 0 处理（可用 --opening 覆盖）", file=sys.stderr)
    oc = rules.get("opening_cell")
    if oc:
        ws[oc] = opening

    print("== 分类结果 (%s ~ %s) ==" % (start, end))
    for c in rules.get("categories", []):
        lb = c["label"]
        if lb not in label_rows:
            continue
        total = sum((e["income"] if c.get("scope") == "income" else e["expense"]) or 0 for e in grouped[lb])
        ws.cell(row=label_rows[lb], column=label_col + 1,
                value=int(total) if total == int(total) else total)
        print("%-12s %12.2f  %d笔" % (lb, total, len(grouped[lb])))
        for e in grouped[lb]:
            print("    %s %s %s" % (e["date"], e["summary0"][:30], e["income"] if c.get("scope") == "income" else e["expense"]))

    inserted_report = []
    for c in rules.get("extra_items", []):
        lb = c["label"]
        total = sum(e["expense"] or e["income"] or 0 for e in grouped[lb])
        anchor = label_rows.get(c.get("after") or "")
        if not total or anchor is None:
            inserted_report.append((lb, total, "金额为0未插入" if not total else "after锚点[%s]不存在未插入" % c.get("after")))
            continue
        insert_at = anchor + 1
        shift_formulas(ws, insert_at, 1)
        ws.insert_rows(insert_at)
        copy_row_style(ws, anchor, insert_at, 1, min(label_col + 3, ws.max_column))
        ws.cell(row=insert_at, column=label_col, value=lb)
        ws.cell(row=insert_at, column=label_col + 1,
                value=int(total) if total == int(total) else total)
        extend_subtotals(ws, label_col, anchor, [insert_at])
        for k in label_rows:
            if label_rows[k] >= insert_at:
                label_rows[k] += 1
        label_rows[lb] = insert_at
        inserted_report.append((lb, total, "已插入第%d行(在[%s]后)" % (insert_at, c.get("after"))))

    if args.title:
        for row in ws.iter_rows(min_row=1, max_row=3):
            done = False
            for cell in row:
                if isinstance(cell.value, str) and cell.value.strip():
                    cell.value = args.title
                    done = True
                    break
            if done:
                break

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    wb.save(out)

    print("期初余额(%s): %s" % (oc, opening))
    for lb, total, note in inserted_report:
        print("新行: %s %.2f %s" % (lb, total, note))
    for lb in missing_rows:
        print("注意: 模板中未找到项目行 [%s]" % lb, file=sys.stderr)
    if unmatched:
        print("!! 以下 %d 笔流水未命中任何规则，未编造归类，请人工判断后补规则副本重跑：" % len(unmatched), file=sys.stderr)
        for e in unmatched:
            print("   %s %s 收%s 支%s" % (e["date"], e["summary0"][:40], e["income"], e["expense"]), file=sys.stderr)
        return 4
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
