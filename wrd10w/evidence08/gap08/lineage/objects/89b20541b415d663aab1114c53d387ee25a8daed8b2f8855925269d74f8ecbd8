#!/usr/bin/env python3
"""Render a phone-price report spec into a styled .docx (A4, CJK font, tables, page numbers).

Usage: python make_word_report.py spec.json output.docx
spec fields: title (str), sections (list of {heading, paragraphs[], bullets[], table:{columns[], rows[][]}}).
All fields optional except an output path. Exits non-zero on bad spec; prints read-back stats on success.
"""
import argparse
import json
import sys
from pathlib import Path

from docx import Document
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml import OxmlElement
from docx.oxml.ns import qn
from docx.shared import Cm, Pt, RGBColor

CJK_FONT = "Noto Sans CJK SC"
ACCENT = "1F4E79"  # header row shading / title color


def set_font(run, size=10.5, bold=False, color=None):
    run.font.name = CJK_FONT
    run.font.size = Pt(size)
    run.font.bold = bold
    if color:
        run.font.color.rgb = RGBColor.from_string(color)
    run._element.rPr.rFonts.set(qn("w:eastAsia"), CJK_FONT)


def shade(cell, hexcolor):
    el = OxmlElement("w:shd")
    el.set(qn("w:val"), "clear")
    el.set(qn("w:fill"), hexcolor)
    cell._tc.get_or_add_tcPr().append(el)


def add_page_number(doc):
    footer = doc.sections[0].footer
    para = footer.paragraphs[0]
    para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = para.add_run()
    for tag, text in (("w:fldChar", None), ("w:instrText", "PAGE"), ("w:fldChar", None)):
        el = OxmlElement(tag)
        if tag == "w:fldChar":
            el.set(qn("w:fldCharType"), "begin" if text is None and len(run._r) == 0 else "end")
        else:
            el.set(qn("xml:space"), "preserve")
            el.text = text
        run._r.append(el)
    set_font(run, 9)


def render_table(doc, table, max_cols):
    cols = table["columns"]
    rows = table["rows"]
    if not cols or not rows:
        raise ValueError("table needs non-empty columns and rows")
    if any(len(r) != len(cols) for r in rows):
        raise ValueError("every table row must have exactly len(columns) cells")
    t = doc.add_table(rows=1 + len(rows), cols=len(cols))
    t.style = "Table Grid"
    small = len(cols) > 3
    size = 9 if small else 10.5
    for j, name in enumerate(cols):
        cell = t.rows[0].cells[j]
        cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER
        set_font(cell.paragraphs[0].add_run(name), size, bold=True, color="FFFFFF")
        shade(cell, ACCENT)
    for i, row in enumerate(rows, start=1):
        for j, val in enumerate(row):
            cell = t.rows[i].cells[j]
            if i % 2 == 0:
                shade(cell, "EAF1F8")
            set_font(cell.paragraphs[0].add_run(str(val)), size)
    doc.add_paragraph()


def build(spec):
    if not isinstance(spec, dict):
        raise ValueError("spec must be a JSON object")
    title = str(spec.get("title") or "").strip()
    if not title:
        raise ValueError("spec.title is required")
    sections = spec.get("sections", [])
    if not isinstance(sections, list):
        raise ValueError("spec.sections must be a list")

    doc = Document()
    sec = doc.sections[0]
    sec.page_width, sec.page_height = Cm(21.0), Cm(29.7)
    for style in (doc.styles["Normal"],):
        style.font.name = CJK_FONT
        style.font.size = Pt(10.5)
        style.element.rPr.rFonts.set(qn("w:eastAsia"), CJK_FONT)

    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    set_font(p.add_run(title), 18, bold=True, color=ACCENT)
    doc.add_paragraph()

    for i, s in enumerate(sections, start=1):
        if not isinstance(s, dict):
            raise ValueError(f"section #{i} must be an object")
        h = doc.add_paragraph()
        set_font(h.add_run(str(s.get("heading") or f"第{i}节")), 14, bold=True, color=ACCENT)
        for text in s.get("paragraphs") or []:
            set_font(doc.add_paragraph().add_run(str(text)))
        for text in s.get("bullets") or []:
            set_font(doc.add_paragraph(style="List Bullet").add_run(str(text)))
        if s.get("table"):
            render_table(doc, s["table"], len(s["table"]["columns"]))

    add_page_number(doc)
    return doc


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("spec")
    ap.add_argument("output")
    args = ap.parse_args()
    try:
        spec = json.loads(Path(args.spec).read_text(encoding="utf-8"))
        doc = build(spec)
    except (OSError, json.JSONDecodeError, ValueError) as e:
        print(f"make_word_report error: {e}", file=sys.stderr)
        return 2
    out = Path(args.output)
    out.parent.mkdir(parents=True, exist_ok=True)
    doc.save(str(out))

    check = Document(str(out))  # read-back verification
    paras = len([p for p in check.paragraphs if p.text.strip()])
    tables = len(check.tables)
    print(f"OK {out}: paragraphs={paras} tables={tables}")
    if paras == 0 and tables == 0:
        print("make_word_report error: generated document is empty", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
