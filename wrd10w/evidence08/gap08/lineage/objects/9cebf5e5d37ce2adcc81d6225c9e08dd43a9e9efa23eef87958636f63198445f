#!/usr/bin/env python3
"""按用户纠正修订生成计划：把指定条目标记为 regenerate 并记录纠正含义。

方法：读取 plan.json，把 --ids 列出的条目 status 置为 regenerate、写入
correction 字段，版本号 revision 加一，输出修订后的完整计划。先澄清纠正
含义再修订（来源：conv_0066cb5f2347:6bdc2cf0、conv_d6918e9034d3:msg_81）。
输入：plan.json；输出：plan_v2.json（修订版计划）。
"""
import argparse
import json
import sys


def fail(code, message, exit_code=2):
    print(f"{code}: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def main():
    parser = argparse.ArgumentParser(
        description="按用户纠正修订生成计划，标记需重生成的条目")
    parser.add_argument("plan", help="生成计划 plan.json 路径")
    parser.add_argument("--ids", default="",
                        help="需重生成的条目 id，逗号分隔；缺省不修改任何条目")
    parser.add_argument("--correction", default="",
                        help="用户纠正的含义说明，写入被修订条目")
    parser.add_argument("--out", required=True, help="输出修订版计划路径")
    args = parser.parse_args()
    try:
        with open(args.plan, encoding="utf-8-sig") as handle:
            plan = json.load(handle)
    except OSError as error:
        fail("plan_read_error", str(error))
    except UnicodeError as error:
        fail("plan_read_error", f"plan is not valid UTF-8: {error}")
    except json.JSONDecodeError as error:
        fail("plan_load_error",
             f"invalid JSON in {args.plan}: line {error.lineno} column {error.colno}")
    if not isinstance(plan, dict) or not isinstance(plan.get("prompts"), list):
        fail("plan_schema_error", "plan must be an object with a prompts list")
    wanted = [part.strip() for part in args.ids.split(",") if part.strip()]
    known = {}
    for prompt in plan["prompts"]:
        if isinstance(prompt, dict) and isinstance(prompt.get("id"), str):
            known[prompt["id"]] = prompt
    for item_id in wanted:
        if item_id not in known:
            fail("unknown_item_id", f"id not in plan: {item_id}", 4)
    for item_id in wanted:
        known[item_id]["status"] = "regenerate"
        known[item_id]["correction"] = args.correction
    plan["revision"] = int(plan.get("revision", 1)) + 1
    plan["pending"] = [prompt["id"] for prompt in plan["prompts"]
                       if isinstance(prompt, dict)
                       and prompt.get("status") != "generated"]
    with open(args.out, "w", encoding="utf-8") as handle:
        json.dump(plan, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    print(f"revised {len(wanted)} items -> {args.out} (revision {plan['revision']})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
