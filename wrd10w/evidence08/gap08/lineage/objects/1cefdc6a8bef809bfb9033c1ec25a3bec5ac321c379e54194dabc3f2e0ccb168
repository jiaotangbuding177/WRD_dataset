{
  "_comment": "演示规格模板：复制本文件后替换全部 {{占位符}}，保存为规格 JSON，再运行 build_animation.py。",
  "title": "{{动画标题}}",
  "objects": [
    {
      "name": "{{中心天体名，如 太阳}}",
      "color": "{{颜色，如 #ffcc33}}",
      "orbit": 0,
      "size": {{中心天体尺寸数值}},
      "period": 1.0
    },
    {
      "name": "{{运动对象名，如 行星}}",
      "color": "{{颜色，如 #6ea8fe}}",
      "orbit": {{轨道半径数值，0为中心天体，>0为绕转对象}},
      "size": {{对象尺寸数值}},
      "period": {{相对周期数值，>0，数值越大转得越慢}},
      "ring": {{true或false，是否绘制环带}}
    }
  ],
  "speed": 1.0,
  "stars": {{星空背景点数整数，0-2000，不需要则填0}},
  "labels": true
}
