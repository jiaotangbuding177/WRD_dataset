#!/usr/bin/env python3
"""按周期统计企业工作项，输出周报汇总块（markdown）。历史事故都在口径上，本脚本固化正确口径：
状态 state/issue_state ∈ 已完成/已验收；时间 updated_at 落在周期内；只统计当前周期；按 id 去重。

用法:
  python3 weekly_stats.py --input workitems.json --start 2026-05-11 --end 2026-05-18
  python3 weekly_stats.py --input workitems.json --last-week
  python3 weekly_stats.py --input workitems.json --start ... --end ... --pr-input workitems_pr.json --json

输入:
  --input    Gitee 导出的工作项 JSON 数组（collect_workitems.py 产物）；字段兼容
             state/issue_state、updated_at、type/issue_type、ident/number/id、title/subject/name。
  --pr-input 可选，PR JSON 数组，统计 merged_at 在周期内的合并 PR（按仓库计数）。
  --states   可选，完成状态列表，逗号分隔，默认「已完成,已验收」。
输出:
  stdout = markdown 汇总块（类型分布 + 工作项清单 + 口径核查线索）；--json 另附结构化结果。
  结果为 0 时输出排查线索（state=all、分页、时间字段三大历史坑）。
"""
import argparse
import json
import sys
from datetime import date, timedelta


def norm_type(raw):
    s = str(raw or "").strip().lower()
    if not s:
        return "未标注"
    if "需求" in s:
        return "需求"
    if "缺陷" in s or "bug" in s:
        return "缺陷"
    if "任务" in s or "task" in s:
        return "任务"
    return str(raw).strip()


def parse_day(v):
    if not v:
        return None
    s = str(v).strip()
    if len(s) >= 10 and s[4] == "-" and s[7] == "-":
        try:
            return date.fromisoformat(s[:10])
        except ValueError:
            return None
    return None


def field(item, names):
    for n in names:
        if item.get(n) not in (None, ""):
            return item[n]
    return None


def last_week_range(today=None):
    t = today or date.today()
    monday = t - timedelta(days=t.weekday() + 7)
    return monday, monday + timedelta(days=6)


def main():
    ap = argparse.ArgumentParser(description="工作项周期统计（正确口径固化）")
    ap.add_argument("--input", required=True, help="工作项 JSON 数组文件")
    ap.add_argument("--start", help="周期起始 YYYY-MM-DD（含）")
    ap.add_argument("--end", help="周期结束 YYYY-MM-DD（含）")
    ap.add_argument("--last-week", action="store_true", help="用上周一~上周日作为周期")
    ap.add_argument("--states", default="已完成,已验收", help="完成状态，逗号分隔")
    ap.add_argument("--pr-input", help="可选 PR JSON 文件，统计周期内合并 PR 按仓库计数")
    ap.add_argument("--json", action="store_true", help="额外输出结构化 JSON")
    args = ap.parse_args()

    if args.last_week:
        start, end = last_week_range()
    elif args.start and args.end:
        start, end = date.fromisoformat(args.start), date.fromisoformat(args.end)
    else:
        print("需要 --start/--end 或 --last-week", file=sys.stderr)
        sys.exit(2)
    if start > end:
        print("周期起止颠倒: %s > %s" % (start, end), file=sys.stderr)
        sys.exit(2)

    try:
        with open(args.input, encoding="utf-8") as f:
            items = json.load(f)
    except (OSError, ValueError) as e:
        print("读取输入失败: %s" % e, file=sys.stderr)
        sys.exit(2)
    if not isinstance(items, list):
        print("输入应是 JSON 数组，实际: %s" % type(items).__name__, file=sys.stderr)
        sys.exit(2)

    ok_states = {s.strip() for s in args.states.split(",") if s.strip()}
    matched, seen = [], set()
    excluded = {"非完成状态": 0, "时间不在周期": 0, "缺时间字段": 0, "重复": 0, "缺状态字段": 0, "格式异常": 0}
    for it in items:
        if not isinstance(it, dict):
            excluded["格式异常"] += 1
            continue
        state = field(it, ["state", "issue_state"])
        ident = field(it, ["ident", "number", "id"])
        key = str(ident) if ident is not None else json.dumps([field(it, ["title", "subject", "name"]), str(it.get("updated_at"))], ensure_ascii=False)
        if key in seen:
            excluded["重复"] += 1
            continue
        seen.add(key)
        if state is None:
            excluded["缺状态字段"] += 1
            continue
        if str(state).strip() not in ok_states:
            excluded["非完成状态"] += 1
            continue
        day = parse_day(field(it, ["updated_at"]))
        if day is None:
            excluded["缺时间字段"] += 1
            continue
        if not (start <= day <= end):
            excluded["时间不在周期"] += 1
            continue
        matched.append({
            "ident": str(ident) if ident is not None else "",
            "title": str(field(it, ["title", "subject", "name"]) or "").strip(),
            "type": norm_type(field(it, ["type", "issue_type", "kind"])),
            "updated_at": str(it.get("updated_at") or ""),
        })

    by_type = {}
    for m in matched:
        by_type[m["type"]] = by_type.get(m["type"], 0) + 1
    order = [t for t in ("需求", "缺陷", "任务") if t in by_type] + sorted(t for t in by_type if t not in ("需求", "缺陷", "任务"))

    pr_lines = []
    if args.pr_input:
        try:
            with open(args.pr_input, encoding="utf-8") as f:
                prs = json.load(f)
        except (OSError, ValueError) as e:
            print("读取 PR 输入失败: %s" % e, file=sys.stderr)
            sys.exit(2)
        by_repo = {}
        for pr in prs if isinstance(prs, list) else []:
            if not isinstance(pr, dict) or not pr.get("merged_at"):
                continue
            day = parse_day(pr.get("merged_at"))
            if day and start <= day <= end:
                repo = pr.get("_repo") or (pr.get("base") or {}).get("repo", {}).get("full_name", "未知仓库")
                by_repo[repo] = by_repo.get(repo, 0) + 1
        total_pr = sum(by_repo.values())
        pr_lines = ["| %s | %d |" % (r, c) for r, c in sorted(by_repo.items(), key=lambda x: -x[1])]
        pr_block = "\n\n### 合并 PR（按仓库）\n\n| 仓库 | 合并 PR |\n|------|--------|\n| **合计** | **%d** |\n%s" % (total_pr, "\n".join(pr_lines)) if pr_lines else "\n\n### 合并 PR\n\n本周期合并 PR：0 个"
    else:
        pr_block = ""

    lines = []
    lines.append("## 企业工作项汇总（%s ~ %s）" % (start.isoformat(), end.isoformat()))
    lines.append("")
    lines.append("统计口径：状态 %s；时间 updated_at 在周期内；仅本周期，不累计。" % "/".join(sorted(ok_states)))
    lines.append("")
    lines.append("### 类型分布")
    lines.append("")
    lines.append("| 类型 | 数量 |")
    lines.append("|------|------|")
    for t in order:
        lines.append("| %s | %d |" % (t, by_type[t]))
    lines.append("| **合计** | **%d** |" % len(matched))
    lines.append("")
    lines.append("### 工作项列表（写报告时相似项合并为「XX相关：ID1, ID2」）")
    lines.append("")
    for t in order:
        group = [m for m in matched if m["type"] == t]
        lines.append("- **%s**（%d）：" % (t, len(group)) + "；".join("%s %s" % (m["ident"], m["title"]) if m["ident"] else m["title"] for m in group))
    if pr_block.strip():
        lines.append("")
        lines.append(pr_block.strip("\n"))
    check = "、".join("%s %d" % (k, v) for k, v in excluded.items() if v)
    if not matched:
        lines.insert(2, "")
        lines.insert(2, "**⚠️ 统计结果为 0。重跑前先核对三处口径（历史全部踩过）：1) 采集是否带 state=all；2) 分页是否取全（per_page=100 循环到短页）；3) 时间字段是否用 updated_at 而非 finished_at。**")
        lines.insert(3, "")
    if check:
        lines.append("")
        lines.append("口径核查（被排除 %d 条）：%s。若与预期不符，先核对这些口径再改代码。" % (sum(excluded.values()), check))

    out = "\n".join(lines)
    if args.json:
        out += "\n```json\n" + json.dumps({"start": start.isoformat(), "end": end.isoformat(), "total": len(matched), "by_type": by_type, "excluded": {k: v for k, v in excluded.items() if v}, "items": matched}, ensure_ascii=False, indent=1) + "\n```"
    print(out)


if __name__ == "__main__":
    main()
