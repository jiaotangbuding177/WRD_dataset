import json, re
for f in ['/workspace/inputs/conversations/conv_d5047f96985d.json','/workspace/inputs/conversations/conv_073150ee30be.json']:
    print('=====', f)
    d = json.load(open(f))
    seen = set()
    for m in d['messages']:
        t = m.get('content') or ''
        for cmd in re.findall(r'lark-cli [^\n`]+', t):
            c = cmd.strip()
            if c not in seen:
                seen.add(c)
                print(c[:160])
