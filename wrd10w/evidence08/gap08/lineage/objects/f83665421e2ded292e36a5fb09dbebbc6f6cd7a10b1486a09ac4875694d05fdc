#!/usr/bin/env python3
"""知识库盘点：把知识库目录扫描成确定性的JSON清单。

方法：递归 os.walk（跳过符号链接），逐文件计算 sha256，输出按路径排序；
不写时间戳，同一批文件在任何绑定路径下输出一致（kb_name 取目录名）。
公开用法（逐字见 SKILL.md）：
  python {SKILL}/scripts/kb_inventory.py {INPUT}/kb --out {OUT}/inventory.json
错误一律打印 'kb_inventory_error: ...' 到 stderr 并退出 2。
"""
from __future__ import annotations
import argparse
import hashlib
import json
import os
import sys

SCHEMA = "kb-inventory-v1"


def scan(kb_path: str) -> dict:
    """扫描目录；目录不存在时抛 ValueError。"""
    if not os.path.isdir(kb_path):
        raise ValueError("KB directory not found: " + kb_path)
    files, dirs = [], []
    for root, dirnames, filenames in os.walk(kb_path):
        dirnames[:] = sorted(d for d in dirnames if not os.path.islink(os.path.join(root, d)))
        rel_root = os.path.relpath(root, kb_path)
        for d in dirnames:
            dirs.append(d if rel_root == "." else os.path.join(rel_root, d).replace(os.sep, "/"))
        for name in sorted(filenames):
            full = os.path.join(root, name)
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            rel = name if rel_root == "." else os.path.join(rel_root, name).replace(os.sep, "/")
            with open(full, "rb") as fh:
                data = fh.read()
            ext = os.path.splitext(name)[1].lower().lstrip(".")
            files.append({"path": rel, "bytes": len(data), "ext": ext,
                          "sha256": hashlib.sha256(data).hexdigest()})
    files.sort(key=lambda x: x["path"])
    dirs.sort()
    kb_name = os.path.basename(os.path.normpath(kb_path))
    return {"schema": SCHEMA, "kb_name": kb_name,
            "total_files": len(files), "total_bytes": sum(f["bytes"] for f in files),
            "dirs": dirs, "files": files}


def main() -> int:
    parser = argparse.ArgumentParser(description="扫描知识库目录生成JSON清单（含每文件sha256）")
    parser.add_argument("kb", help="知识库目录路径")
    parser.add_argument("--out", required=True, help="输出清单JSON路径")
    args = parser.parse_args()
    try:
        inventory = scan(args.kb)
    except ValueError as error:
        print("kb_inventory_error: " + str(error), file=sys.stderr)
        return 2
    payload = json.dumps(inventory, ensure_ascii=False, indent=2) + "\n"
    try:
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(payload)
    except OSError as error:
        print("kb_inventory_error: cannot write output: " + str(error), file=sys.stderr)
        return 2
    print("inventory written: " + args.out + " (" + str(inventory["total_files"]) + " files)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
