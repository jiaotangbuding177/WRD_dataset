def fixture(path, source_id, message_ids, purpose, derivation):
    p = pin(str(FIX / path))
    return {"path": path, "pin": p, "source_id": source_id, "message_ids": message_ids,
            "origin": "generated_fixture", "generated": True, "purpose": purpose,
            "derivation": derivation}

