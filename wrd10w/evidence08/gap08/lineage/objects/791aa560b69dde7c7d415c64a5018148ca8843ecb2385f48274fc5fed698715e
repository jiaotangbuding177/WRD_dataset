def office_asserts(path, texts):
    out = [{"kind": "zip_members", "path": path, "value": ["word/document.xml"]},
           {"kind": "zip_member_count", "path": path, "pattern": "word/document\\.xml", "value": 1}]
    for t in texts:
        out.append({"kind": "zip_xml_contains", "path": path, "member": "word/document.xml", "value": t})
    return out

