#!/usr/bin/env python3
"""读入银行日记账 xlsx，整理成流水行 JSON（路线 s1）。

用法:
  python3 journal_extract.py <日记账.xlsx>... --out <输出.json>

行为:
- 读每个工作表，自动定位表头行（含 日期 或 摘要 的行），按列名模糊映射：
  日期/时间 -> date；摘要/说明/事由/内容 -> summary；
  收入/借方/收款/入账 -> income；支出/贷方/付款/出账 -> expense；
  金额/发生额 -> amount；余额 -> balance。
- 每条流水输出 date/summary/amounts(数值) 并保留 raw 原始行；
- 输出 JSON：{files:[{file, sheets:[{sheet, header_row, columns, entries, raw_rows}]}]}
- 退出码: 0 成功; 2 用法错误/文件不存在; 3 全部工作表都没找到表头（JSON 里仍保留 raw_rows 供人工映射）。
不联网、不写输入文件。
"""
import argparse
import json
import sys
from pathlib import Path

from openpyxl import load_workbook

COLUMN_PATTERNS = [
    ("date", ("日期", "时间", "记账日期")),
    ("summary", ("摘要", "说明", "事由", "内容", "用途")),
    ("income", ("收入", "借方", "收款", "入账")),
    ("expense", ("支出", "贷方", "付款", "出账")),
    ("amount", ("金额", "发生额")),
    ("balance", ("余额", "结余")),
]


def to_number(value):
    if value is None or isinstance(value, (int, float)):
        return value if value != 0 else (value if isinstance(value, (int, float)) else None)
    text = str(value).replace(",", "").replace("¥", "").replace("￥", "").strip()
    if not text or text.startswith("="):
        return None
    try:
        number = float(text)
        return int(number) if number == int(number) else number
    except ValueError:
        return None


def cell_text(value):
    if value is None:
        return None
    text = str(value).strip()
    return text or None


def match_header(cells):
    names = [str(c).strip() if c is not None else "" for c in cells]
    matched = {}
    for key, patterns in COLUMN_PATTERNS:
        for index, name in enumerate(names):
            if name and any(p in name for p in patterns) and key not in matched:
                matched[key] = index
    if "date" in matched or "summary" in matched:
        return matched
    return None


def extract_sheet(sheet):
    rows = list(sheet.iter_rows(values_only=True))
    header_row_index, columns = None, None
    for index, row in enumerate(rows[:30]):
        columns = match_header(row)
        if columns:
            header_row_index = index + 1
            break
    result = {"sheet": sheet.title, "header_row": None, "columns": None,
              "entries": [], "raw_rows": len(rows)}
    if not columns:
        return result
    result["header_row"] = header_row_index
    result["columns"] = {key: index + 1 for key, index in columns.items()}
    for index, row in enumerate(rows[header_row_index:], header_row_index + 1):
        summary = cell_text(row[columns["summary"]]) if "summary" in columns else None
        date = cell_text(row[columns["date"]]) if "date" in columns else None
        values = {}
        for key in ("income", "expense", "amount", "balance"):
            if key in columns:
                number = to_number(row[columns[key]])
                if number is not None:
                    values[key] = number
        if not (summary or date or values):
            continue
        entry = {"row": index, "date": date, "summary": summary, "amounts": values}
        raw = [cell_text(v) for v in row if cell_text(v) is not None]
        entry["raw"] = raw
        result["entries"].append(entry)
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("inputs", nargs="+", help="一个或多个日记账 .xlsx")
    parser.add_argument("--out", required=True)
    args = parser.parse_args()
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    files, failed = [], 0
    for path in args.inputs:
        src = Path(path)
        if not src.is_file() or src.suffix.lower() not in (".xlsx", ".xlsm"):
            print("journal_extract error: 无法读取 " + str(src), file=sys.stderr)
            failed += 1
            continue
        try:
            workbook = load_workbook(src, data_only=True)
        except Exception as error:
            print("journal_extract error: " + str(src) + ": " + str(error), file=sys.stderr)
            failed += 1
            continue
        record = {"file": str(src), "sha256": None, "sheets": []}
        import hashlib
        record["sha256"] = hashlib.sha256(src.read_bytes()).hexdigest()[:16]
        for sheet in workbook.worksheets:
            record["sheets"].append(extract_sheet(sheet))
        files.append(record)
        entries = sum(len(s["entries"]) for s in record["sheets"])
        missing = [s["sheet"] for s in record["sheets"] if not s["columns"]]
        print("%s: %d sheets, %d 条流水" % (src.name, len(record["sheets"]), entries))
        for name in missing:
            print("%s#%s: 未找到表头，raw_rows 保留供人工映射" % (src.name, name), file=sys.stderr)
    result = {"files": files, "failed": failed}
    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    if failed:
        if not files:
            print("journal_extract: %d 个文件读取失败，无可用输出" % failed, file=sys.stderr)
            return 2
        print("journal_extract: %d 个文件读取失败，其余已输出，详见 stderr" % failed, file=sys.stderr)
        return 3
    no_header = all(not s["columns"] for f in files for s in f["sheets"])
    if no_header:
        print("journal_extract: 未在任何工作表找到表头（需 日期 或 摘要 列），raw_rows 已保留供人工映射", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
