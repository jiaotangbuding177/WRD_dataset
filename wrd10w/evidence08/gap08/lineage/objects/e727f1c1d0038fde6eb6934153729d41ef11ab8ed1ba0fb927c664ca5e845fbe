#!/usr/bin/env python3
"""对无文本层的扫描版/图片型 PDF 做 OCR，产出带页码标记的 .txt。

用法（原样可执行）:
  python3 ocr_pdf.py <扫描版.pdf> --out <输出.txt> [--lang chi_sim] [--dpi 300] [--first N] [--last N]

行为:
- pdftoppm 转页图（png）后逐页 tesseract OCR（默认 chi_sim，中文项目不需要 eng 混合）。
- 输出每页前加 "===== 第 N 页 =====" 标记，便于报告中标注依据页码。
- 退出码: 0 成功; 2 输入缺失/用法错误; 3 转换或 OCR 失败。
注意: OCR 结果有识别噪声（如"直接"误成"宣接"），报告引用的关键数字须对照原图核对。
"""
import argparse
import glob
import os
import shutil
import subprocess
import sys
import tempfile


def main(argv=None):
    ap = argparse.ArgumentParser(description="扫描版 PDF OCR 提取文本")
    ap.add_argument("input", help="扫描版/图片型 PDF 路径")
    ap.add_argument("--out", required=True, help="输出 .txt 路径")
    ap.add_argument("--lang", default="chi_sim", help="tesseract 语言（默认 chi_sim）")
    ap.add_argument("--dpi", type=int, default=300, help="渲染 DPI（默认 300）")
    ap.add_argument("--first", type=int, default=None, help="起始页（1 起，可选）")
    ap.add_argument("--last", type=int, default=None, help="结束页（可选）")
    args = ap.parse_args(argv)

    if not os.path.isfile(args.input):
        print("ocr_pdf error: 输入不存在: %s" % args.input, file=sys.stderr)
        return 2
    for tool in ("pdftoppm", "tesseract"):
        if not shutil.which(tool):
            print("ocr_pdf error: 缺少 %s" % tool, file=sys.stderr)
            return 2

    pages = []
    with tempfile.TemporaryDirectory() as tmp:
        prefix = os.path.join(tmp, "page")
        cmd = ["pdftoppm", "-r", str(args.dpi), "-png"]
        if args.first:
            cmd += ["-f", str(args.first)]
        if args.last:
            cmd += ["-l", str(args.last)]
        cmd += [args.input, prefix]
        try:
            subprocess.run(cmd, check=True, capture_output=True, timeout=1800)
        except subprocess.SubprocessError as e:
            print("ocr_pdf error: pdftoppm 转图失败: %s" % e, file=sys.stderr)
            return 3
        images = sorted(glob.glob(prefix + "-*.png"))
        if not images:
            print("ocr_pdf error: 未产出页图", file=sys.stderr)
            return 3
        for i, img in enumerate(images, 1):
            r = subprocess.run(
                ["tesseract", img, "-", "-l", args.lang],
                capture_output=True, timeout=600,
            )
            if r.returncode != 0:
                print("ocr_pdf error: tesseract 第 %d 页失败: %s"
                      % (i, r.stderr.decode("utf-8", "replace")[:200]), file=sys.stderr)
                return 3
            text = r.stdout.decode("utf-8", "replace").strip()
            pages.append("===== 第 %d 页 =====\n%s" % (i, text))

    out = "\n\n".join(pages) + "\n"
    out_path = os.path.dirname(os.path.abspath(args.out))
    os.makedirs(out_path, exist_ok=True)
    with open(args.out, "w", encoding="utf-8") as f:
        f.write(out)
    print("ocr_pdf: %d 页 -> %s（%d 字符）" % (len(pages), args.out, len(out)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
