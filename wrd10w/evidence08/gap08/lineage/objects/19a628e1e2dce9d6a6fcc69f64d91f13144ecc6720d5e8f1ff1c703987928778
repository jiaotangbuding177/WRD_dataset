#!/usr/bin/env python3
"""render_design_docx.py -- 组织架构设计方案 docx 渲染器。

用法:
  python3 render_design_docx.py build --in SPEC.json --out OUT.docx [--force]

SPEC 结构见 templates/design_doc.example.json。块类型（blocks 内顺序渲染）:
  heading(层级标题) / para(段落) / bullets(要点列表) / table(表格) /
  chart(等宽组织架构图) / pagebreak(分页)

封面与目录自动生成；目录在 Word 中按 F9 更新页码。
退出码: 0=成功 2=用法或spec错误
"""
import argparse, json, os, sys
from docx import Document
from docx.shared import Pt, Cm, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH, WD_BREAK
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml import OxmlElement
from docx.oxml.ns import qn

BLOCK_TYPES = {"heading", "para", "bullets", "table", "chart", "pagebreak"}


def set_font(run, name, size, bold=False, color=None, mono=False):
    run.font.name = "Consolas" if mono else name
    run._element.rPr.rFonts.set(qn("w:eastAsia"), name)
    run.font.size = Pt(size)
    run.font.bold = bold
    if color:
        run.font.color.rgb = RGBColor(*color)


def para(doc, text, font, size, bold=False, align=None, space_after=6,
         color=None, mono=False):
    p = doc.add_paragraph()
    if align is not None:
        p.alignment = align
    p.paragraph_format.space_after = Pt(space_after)
    set_font(p.add_run(text), font, size, bold, color, mono)
    return p


def add_toc(doc):
    p = doc.add_paragraph()
    run = p.add_run()
    fld = OxmlElement("w:fldSimple")
    fld.set(qn("w:instr"), "TOC \\o \"1-2\" \\h \\z \\u")
    hint = OxmlElement("w:t")
    hint.text = "目录生成后请在 Word 中全选并按 F9 更新"
    fld.append(hint)
    run._element.append(fld)


def add_table(doc, header, rows, font_body, font_label, size):
    n = len(header)
    t = doc.add_table(rows=1 + len(rows), cols=n)
    t.style = "Table Grid"
    t.alignment = WD_TABLE_ALIGNMENT.CENTER
    for j, h in enumerate(header):
        c = t.rows[0].cells[j]
        c.text = ""
        set_font(c.paragraphs[0].add_run(str(h)), font_label, size, True)
    for i, row in enumerate(rows):
        for j in range(n):
            c = t.rows[i + 1].cells[j]
            c.text = ""
            set_font(c.paragraphs[0].add_run(str(row[j]) if j < len(row) else ""),
                     font_body, size)
    return t


def validate(spec):
    errs = []
    if not isinstance(spec, dict):
        return ["spec 顶层必须是对象"]
    doc_cfg = spec.get("doc") or {}
    if not doc_cfg.get("title"):
        errs.append("doc.title 缺失")
    cover = spec.get("cover")
    if not (isinstance(cover, dict) and cover.get("title")):
        errs.append("cover.title 缺失")
    blocks = spec.get("blocks")
    if not isinstance(blocks, list) or not blocks:
        errs.append("blocks 缺失或为空")
    else:
        for i, b in enumerate(blocks):
            if not isinstance(b, dict) or b.get("type") not in BLOCK_TYPES:
                errs.append(f"blocks[{i}] type 缺失或未知（{b.get('type') if isinstance(b, dict) else b}）")
                continue
            bt = b["type"]
            if bt == "heading" and not b.get("text"):
                errs.append(f"blocks[{i}] heading 缺 text")
            if bt == "para" and not b.get("text"):
                errs.append(f"blocks[{i}] para 缺 text")
            if bt == "bullets" and not b.get("items"):
                errs.append(f"blocks[{i}] bullets 缺 items")
            if bt == "table" and not (b.get("header") and b.get("rows")):
                errs.append(f"blocks[{i}] table 缺 header/rows")
            if bt == "chart" and not b.get("text"):
                errs.append(f"blocks[{i}] chart 缺 text")
    return errs


def build(spec, out):
    doc_cfg = spec.get("doc") or {}
    fonts = doc_cfg.get("fonts") or {}
    label = fonts.get("label", "黑体")
    body = fonts.get("body", "宋体")
    sizes = doc_cfg.get("sizes") or {}
    s_body = sizes.get("body", 10.5)
    s_title = sizes.get("title", 16)

    doc = Document()
    sec = doc.sections[0]
    sec.top_margin = sec.bottom_margin = Cm(2.5)
    sec.left_margin = sec.right_margin = Cm(2.8)

    # 封面
    cover = spec["cover"]
    for _ in range(6):
        doc.add_paragraph()
    para(doc, cover["title"], label, s_title, True, WD_ALIGN_PARAGRAPH.CENTER, 12)
    if cover.get("subtitle"):
        para(doc, cover["subtitle"], body, s_body + 2, False, WD_ALIGN_PARAGRAPH.CENTER, 24)
    for k, v in (cover.get("fields") or []):
        para(doc, f"{k}：{v}", body, s_body, False, WD_ALIGN_PARAGRAPH.CENTER, 6)
    doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)

    # 目录
    para(doc, "目录", label, s_title, True, WD_ALIGN_PARAGRAPH.CENTER, 12)
    add_toc(doc)
    doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)

    for b in spec["blocks"]:
        bt = b["type"]
        if bt == "heading":
            lvl = int(b.get("level", 1))
            h = doc.add_heading(b["text"], level=lvl)
            for r in h.runs:
                r.font.name = label
                r._element.rPr.rFonts.set(qn("w:eastAsia"), label)
                r.font.size = Pt(s_title if lvl == 1 else s_body + 2)
                r.font.color.rgb = RGBColor(0, 0, 0)
        elif bt == "para":
            para(doc, b["text"], body, s_body)
        elif bt == "bullets":
            for it in b["items"]:
                para(doc, f"• {it}", body, s_body, space_after=3)
        elif bt == "table":
            add_table(doc, b["header"], b["rows"], body, label,
                      b.get("size", s_body))
            doc.add_paragraph().paragraph_format.space_after = Pt(4)
        elif bt == "chart":
            for line in b["text"].splitlines():
                para(doc, line, body, b.get("size", 9), mono=True, space_after=0)
        elif bt == "pagebreak":
            doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)

    doc.save(out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["build"])
    ap.add_argument("--in", dest="inp", required=True)
    ap.add_argument("--out", dest="out", required=True)
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()
    if os.path.exists(a.out) and not a.force:
        print(f"输出已存在：{a.out}（加 --force 覆盖）", file=sys.stderr)
        sys.exit(2)
    try:
        spec = json.load(open(a.inp, encoding="utf-8"))
    except Exception as e:
        print(f"读取 spec 失败：{e}", file=sys.stderr)
        sys.exit(2)
    errs = validate(spec)
    if errs:
        print("spec 校验失败：", file=sys.stderr)
        for e in errs:
            print(f"  - {e}", file=sys.stderr)
        sys.exit(2)
    build(spec, a.out)
    print(f"已生成 {a.out}")


if __name__ == "__main__":
    main()
