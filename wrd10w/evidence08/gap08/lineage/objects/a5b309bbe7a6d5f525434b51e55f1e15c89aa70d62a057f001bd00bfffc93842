hs), 'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(len(paragraphs)) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n====\n  51 /workspace/inputs/reusable/skill_1/scripts/extract_contract_text.py\n  72 /workspace/inputs/reusable/skill_1/scripts/scan_docx_keywords.py\n 123 total\n====\n# 阶段细节与来源教训\n\n来源证据（消息ID见各条）：解析与替换 conv_849a4af1be2e:b5352206、conv_69148bb26513:msg_1；审查与报告 conv_de8c70890684:msg_1、conv_381f48864647:msg_19。\n\n## 阶段1 解析原文\n\n- docx 用 `python {SKILL}/scripts/extract_contract_text.py {INPUT}/contract.docx --out {OUT}/text.json` 提取全文。\n- PDF：先 pdftotext，失败换 pypdf；两者都提不出文字层即扫描件，用 pdftoppm 转 300dpi 图后 `tesseract ... -l chi_sim`（conv_69148bb26513:2f4072d2、conv_69148bb26513:89420d9a、conv_69148bb26513:75c82670）。\n- 带修订标记的 docx：先接受全部既有修订作基底，再把本次修改做成新的修订标记，同时交付修订标记版与全部接受版（conv_849a4af1be2e:f7e1e853）。\n\n## 阶段2 定位全部关联点\n\n- 用 `python {SKILL}/scripts/scan_docx_keywords.py {INPUT}/contract.docx --keywords 甲方,乙方 --out {OUT}/scan.json` 全文档（含页眉页脚表格）扫描，命中点逐段归位核对后在计划内全量修改。\n- 教训：附件一同名时点句出现两次，只替换了第一处，必须全量替换（conv_849a4af1be2e:dd986d5c）。\n\n## 阶段3-4 起草与组稿\n\n- 变更范围以用户指定为准，全文一致落实；法律判断标注不确定性并提示单独核实（如\"间接持有\"股权可登记出质的是直接持有层，须写明持股路径，conv_381f48864647:msg_18）。\n- 口径类事实（投前/投后估值、签署方是否加入）不确定时单独列出请用户确认，不替用户决定（conv_381f48864647:msg_34、conv_69148bb26513:45a7a5c3）。\n- 格式（字体/字号/行距）严格按用户指定执行，如楷体+Times New Roman、小四、1.5倍行距；生成 docx 后用 pandoc/LibreOffice 实际验证正文与结构。\n- 直接改 OOXML 时教训：新插入段落误含原段落内容导致双 pPr 打包失败；加粗标记曾落在引号外，需核对 run 边界（conv_849a4af1be2e:4dc24b6c、conv_849a4af"}], "details": {"status": "completed", "exitCode": 0, "exitSignal": null, "exitReason": "exit", "durationMs": 48, "aggregated": "\"\"\"Extract plain text from a .docx contract into a JSON file.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> p