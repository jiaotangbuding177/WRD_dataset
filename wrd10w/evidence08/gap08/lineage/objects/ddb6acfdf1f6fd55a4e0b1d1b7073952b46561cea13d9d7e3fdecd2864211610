{"type": "message", "id": "ff79728c-8f02-4e89-a028-8fcfee021913", "parentId": "55c8379d-ca0b-4f21-8839-de37a6e8f8ec", "timestamp": "2026-10-23T07:47:14.418Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在我来处理设计文档渲染器（新的、最小化的、用于设计方案 docx 的规范驱动模式）。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-8397816a0e5840f7b84b0f6c\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "callebefddb3609c46e883fbfffcb3930d39", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"render_design_docx.py -- 组织架构设计方案 docx 渲染器。\n\n用法:\n  python3 render_design_docx.py build --in SPEC.json --out OUT.docx [--force]\n\nSPEC 结构见 templates/design_doc.example.json。块类型（blocks 内顺序渲染）:\n  heading(层级标题) / para(段落) / bullets(要点列表) / table(表格) /\n  chart(等宽组织架构图) / pagebreak(分页)\n\n封面与目录自动生成；目录在 Word 中按 F9 更新页码。\n退出码: 0=成功 2=用法或spec错误\n\"\"\"\nimport argparse, json, os, sys\nfrom docx import Document\nfrom docx.shared import Pt, Cm, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH, WD_BREAK\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\n\nBLOCK_TYPES = {\"heading\", \"para\", \"bullets\", \"table\", \"chart\", \"pagebreak\"}\n\n\ndef set_font(run, name, size, bold=False, color=None, mono=False):\n    run.font.name = \"Consolas\" if mono else name\n    run._element.rPr.rFonts.set(qn(\"w:eastAsia\"), name)\n    run.font.size = Pt(size)\n    run.font.bold = bold\n    if color:\n        run.font.color.rgb = RGBColor(*color)\n\n\ndef para(doc, text, font, size, bold=False, align=None, space_after=6,\n         color=None, mono=False):\n    p = doc.add_paragraph()\n    if align is not None:\n        p.alignment = align\n    p.paragraph_format.space_after = Pt(space_after)\n    set_font(p.add_run(text), font, size, bold, color, mono)\n    return p\n\n\ndef add_toc(doc):\n    p = doc.add_paragraph()\n    run = p.add_run()\n    fld = OxmlElement(\"w:fldSimple\")\n    fld.set(qn(\"w:instr\"), \"TOC \\\\o \\\"1-2\\\" \\\\h \\\\z \\\\u\")\n    hint = OxmlElement(\"w:t\")\n    hint.text = \"目录生成后请在 Word 中全选并按 F9 更新\"\n    fld.append(hint)\n    run._element.append(fld)\n\n\ndef add_table(doc, header, rows, font_body, font_label, size):\n    n = len(header)\n    t = doc.add_table(rows=1 + len(rows), cols=n)\n    t.style = \"Table Grid\"\n    t.alignment = WD_TABLE_ALIGNMENT.CENTER\n    for j, h in enumerate(header):\n        c = t.rows[0].cells[j]\n        c.text = \"\"\n        set_font(c.paragraphs[0].add_run(str(h)), font_label, size, True)\n    for i, row in enumerate(rows):\n        for j in range(n):\n            c = t.rows[i + 1].cells[j]\n            c.text = \"\"\n            set_font(c.paragraphs[0].add_run(str(row[j]) if j < len(row) else \"\"),\n                     font_body, size)\n    return t\n\n\ndef validate(spec):\n    errs = []\n    if not isinstance(spec, dict):\n        return [\"spec 顶层必须是对象\"]\n    doc_cfg = spec.get(\"doc\") or {}\n    if not doc_cfg.get(\"title\"):\n        errs.append(\"doc.title 缺失\")\n    cover = spec.get(\"cover\")\n    if not (isinstance(cover, dict) and cover.get(\"title\")):\n        errs.append(\"cover.title 缺失\")\n    blocks = spec.get(\"blocks\")\n    if not isinstance(blocks, list) or not blocks:\n        errs.append(\"blocks 缺失或为空\")\n    else:\n        for i, b in enumerate(blocks):\n            if not isinstance(b, dict) or b.get(\"type\") not in BLOCK_TYPES:\n                errs.append(f\"blocks[{i}] type 缺失或未知（{b.get('type') if isinstance(b, dict) else b}）\")\n                continue\n            bt = b[\"type\"]\n            if bt == \"heading\" and not b.get(\"text\"):\n                errs.append(f\"blocks[{i}] heading 缺 text\")\n            if bt == \"para\" and not b.get(\"text\"):\n                errs.append(f\"blocks[{i}] para 缺 text\")\n            if bt == \"bullets\" and not b.get(\"items\"):\n                errs.append(f\"blocks[{i}] bullets 缺 items\")\n            if bt == \"table\" and not (b.get(\"header\") and b.get(\"rows\")):\n                errs.append(f\"blocks[{i}] table 缺 header/rows\")\n            if bt == \"chart\" and not b.get(\"text\"):\n                errs.append(f\"blocks[{i}] chart 缺 text\")\n    return errs\n\n\ndef build(spec, out):\n    doc_cfg = spec.get(\"doc\") or {}\n    fonts = doc_cfg.get(\"fonts\") or {}\n    label = fonts.get(\"label\", \"黑体\")\n    body = fonts.get(\"body\", \"宋体\")\n    sizes = doc_cfg.get(\"sizes\") or {}\n    s_body = sizes.get(\"body\", 10.5)\n    s_title = sizes.get(\"title\", 16)\n\n    doc = Document()\n    sec = doc.sections[0]\n    sec.top_margin = sec.bottom_margin = Cm(2.5)\n    sec.left_margin = sec.right_margin = Cm(2.8)\n\n    # 封面\n    cover = spec[\"cover\"]\n    for _ in range(6):\n        doc.add_paragraph()\n    para(doc, cover[\"title\"], label, s_title, True, WD_ALIGN_PARAGRAPH.CENTER, 12)\n    if cover.get(\"subtitle\"):\n        para(doc, cover[\"subtitle\"], body, s_body + 2, False, WD_ALIGN_PARAGRAPH.CENTER, 24)\n    for k, v in (cover.get(\"fields\") or []):\n        para(doc, f\"{k}：{v}\", body, s_body, False, WD_ALIGN_PARAGRAPH.CENTER, 6)\n    doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)\n\n    # 目录\n    para(doc, \"目录\", label, s_title, True, WD_ALIGN_PARAGRAPH.CENTER, 12)\n    add_toc(doc)\n    doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)\n\n    for b in spec[\"blocks\"]:\n        bt = b[\"type\"]\n        if bt == \"heading\":\n            lvl = int(b.get(\"level\", 1))\n            h = doc.add_heading(b[\"text\"], level=lvl)\n            for r in h.runs:\n                r.font.name = label\n                r._element.rPr.rFonts.set(qn(\"w:eastAsia\"), label)\n                r.font.size = Pt(s_title if lvl == 1 else s_body + 2)\n                r.font.color.rgb = RGBColor(0, 0, 0)\n        elif bt == \"para\":\n            para(doc, b[\"text\"], body, s_body)\n        elif bt == \"bullets\":\n            for it in b[\"items\"]:\n                para(doc, f\"• {it}\", body, s_body, space_after=3)\n        elif bt == \"table\":\n            add_table(doc, b[\"header\"], b[\"rows\"], body, label,\n                      b.get(\"size\", s_body))\n            doc.add_paragraph().paragraph_format.space_after = Pt(4)\n        elif bt == \"chart\":\n            for line in b[\"text\"].splitlines():\n                para(doc, line, body, b.get(\"size\", 9), mono=True, space_after=0)\n        elif bt == \"pagebreak\":\n            doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)\n\n    doc.save(out)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"cmd\", choices=[\"build\"])\n    ap.add_argument(\"--in\", dest=\"inp\", required=True)\n    ap.add_argument(\"--out\", dest=\"out\", required=True)\n    ap.add_argument(\"--force\", action=\"store_true\")\n    a = ap.parse_args()\n    if os.path.exists(a.out) and not a.force:\n        print(f\"输出已存在：{a.out}（加 --force 覆盖）\", file=sys.stderr)\n        sys.exit(2)\n    try:\n        spec = json.load(open(a.inp, encoding=\"utf-8\"))\n    except Exception as e:\n        print(f\"读取 spec 失败：{e}\", file=sys.stderr)\n        sys.exit(2)\n    errs = validate(spec)\n    if errs:\n        print(\"spec 校验失败：\", file=sys.stderr)\n        for e in errs:\n            print(f\"  - {e}\", file=sys.stderr)\n        sys.exit(2)\n    build(spec, a.out)\n    print(f\"已生成 {a.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/render_design_docx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792741588579, "responseId": "chatcmpl-1792741588611", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "695a99cd-107b-4610-af96-641445ba6643"}}}
