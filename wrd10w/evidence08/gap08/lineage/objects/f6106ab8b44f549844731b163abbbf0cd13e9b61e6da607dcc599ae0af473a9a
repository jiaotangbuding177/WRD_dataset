{"type": "message", "id": "ea5429f6-0d45-4aab-9f8c-1b702e0208f3", "parentId": "f43cf482-3f78-44ce-b449-890141cafde6", "timestamp": "2026-10-22T19:42:36.932Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call4eb0395b59b04a70b158782962443dc2", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Markdown 回复信/勘误信 → 中文安全的 PDF。\n\n用法:\n  python3 md_to_pdf.py INPUT.md --out OUTPUT.pdf [--font \"Noto Sans CJK SC\"] [--title \"文档标题\"]\n\n输入: Markdown 文件(支持表格、标题、引用块)。\n输出: 单个 PDF;若 PDF 提取不到任何文字或转换失败,退出码非 0 且不产出半成品。\n\n管线: pandoc(md→html) + Chromium headless 打印 PDF。\n字体用本机实际存在的中文字体(默认 Noto Sans CJK SC,可用 fc-match 确认);\n用户点名微软雅黑等本机没有的字体时,由调用方先向用户说明替代,再用本脚本指定可用字体。\n\"\"\"\nimport argparse\nimport json\nimport pathlib\nimport subprocess\nimport sys\nimport tempfile\n\nCSS = \"\"\"\n@page { size: A4; margin: 22mm 20mm; }\nbody { font-family: '%(font)s', 'Noto Sans CJK SC', sans-serif;\n       font-size: 11pt; line-height: 1.6; color: #111; }\nh1 { font-size: 17pt; } h2 { font-size: 14pt; } h3 { font-size: 12pt; }\nh1, h2, h3 { border-bottom: 1px solid #ccc; padding-bottom: 3px; }\ntable { border-collapse: collapse; width: 100%%; margin: 8px 0; }\nth, td { border: 1px solid #999; padding: 4px 7px; text-align: left; }\nth { background: #f0f0f0; }\nblockquote { border-left: 3px solid #bbb; margin-left: 0; padding-left: 10px; color: #333; }\ncode { font-size: 10pt; }\n\"\"\"\n\nHTML_TMPL = \"\"\"<!DOCTYPE html><html><head><meta charset=\"utf-8\">\n<title>{title}</title><style>{css}</style></head><body>{body}</body></html>\"\"\"\n\n\ndef pdf_text(path: pathlib.Path) -> str:\n    \"\"\"用 pypdf 提取 PDF 文本,用于渲染检查;不可用时返回空串。\"\"\"\n    try:\n        from pypdf import PdfReader\n    except ImportError:\n        try:\n            from PyPDF2 import PdfReader  # 旧名兜底\n        except ImportError:\n            return \"\"\n    try:\n        return \"\\n\".join(p.extract_text() or \"\" for p in PdfReader(str(path)).pages)\n    except Exception:\n        return \"\"\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"input\", help=\"Markdown 输入文件\")\n    ap.add_argument(\"--out\", required=True, help=\"输出 PDF 路径\")\n    ap.add_argument(\"--font\", default=\"Noto Sans CJK SC\",\n                    help=\"CSS font-family 中文字体名(须为本机 fc-match 可命中的字体)\")\n    ap.add_argument(\"--title\", default=None, help=\"PDF 元数据标题,默认取文件名主干\")\n    args = ap.parse_args()\n\n    src = pathlib.Path(args.input)\n    if not src.is_file():\n        print(f\"pdf_error: input not found: {src}\", file=sys.stderr)\n        return 2\n    md = src.read_text(encoding=\"utf-8\").strip()\n    if not md:\n        print(f\"pdf_error: input is empty: {src}\", file=sys.stderr)\n        return 2\n    out = pathlib.Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    title = args.title or src.stem\n\n    with tempfile.TemporaryDirectory() as td:\n        td = pathlib.Path(td)\n        html_path = td / \"letter.html\"\n        pdf_tmp = td / \"letter.pdf\"\n\n        pandoc = subprocess.run(\n            [\"pandoc\", \"-f\", \"markdown\", \"-t\", \"html\", str(src)],\n            capture_output=True, text=True)\n        if pandoc.returncode != 0:\n            print(f\"pdf_error: pandoc failed: {pandoc.stderr.strip()[:300]}\", file=sys.stderr)\n            return 2\n        html_path.write_text(\n            HTML_TMPL.format(title=title, css=CSS % {\"font\": args.font}, body=pandoc.stdout),\n            encoding=\"utf-8\")\n\n        chromium = subprocess.run(\n            [\"chromium\", \"--headless\", \"--disable-gpu\", \"--no-sandbox\",\n             \"--no-pdf-header-footer\", \"--print-to-pdf=\" + str(pdf_tmp),\n             \"--virtual-time-budget=10000\", html_path.as_uri()],\n            capture_output=True, text=True, timeout=120)\n        if not pdf_tmp.is_file() or pdf_tmp.stat().st_size == 0:\n            print(f\"pdf_error: chromium print failed: {(chromium.stderr or '').strip()[:300]}\",\n                  file=sys.stderr)\n            return 2\n\n        # 渲染检查:能提取出文字才算成功(至少覆盖到中文正文,不是空白页)\n        text = pdf_text(pdf_tmp)\n        if text and not text.strip():\n            text = \"\"\n        if not text:\n            print(\"pdf_error: pdf produced but no extractable text (blank/garbled render?)\",\n                  file=sys.stderr)\n            return 3\n        pdf_tmp.replace(out)\n        print(json.dumps({\"out\": str(out), \"pages\": None, \"chars\": len(text)},\n                         ensure_ascii=False))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "path": "/workspace/outputs/skill/scripts/md_to_pdf.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792698137288, "responseId": "chatcmpl-1792698137329", "__openclaw": {"runId": "79683e52-65e2-4683-a2cc-e7c3275f11fa"}}}
