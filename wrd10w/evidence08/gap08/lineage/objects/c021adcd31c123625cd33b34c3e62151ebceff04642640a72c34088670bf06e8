{"type": "message", "id": "398e44f9-6b11-4c29-80a4-fc277edab825", "parentId": "490f5c5e-de8b-411d-8cf8-860bc810ce39", "timestamp": "2026-10-23T05:01:00.257Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "openpyxl 可用；所有三个可复用技能均不适用。现在我来编写技能脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-c2cd79ea8b3f460bb9273737\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call9a1c3ed0726442f7b15e5aacabfd11fd", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"表格按归属分组并重算计数（table-regroup-geo-match 主工具）。\n\n一跑完成三件事：按映射把每条记录分到归属分组、硬校验输出记录数==输入记录数、\n导出按分组排列的新表+分组统计+未识别清单。不漏一条是脚本内建断言，不是人工检查。\n\n用法:\n  python3 regroup_recount.py --input 表.xlsx --name-col 学校名称 \\\n      --map 映射.json --out 输出.xlsx --unmatched 未识别.json \\\n      [--group-col 原有分组列] [--sheet 工作表名] [--csv]\n\n输入: xlsx（--csv 时读 csv）。\n映射 JSON 结构:\n  {\n    \"exact\":   {\"华东师范大学\": \"上海市\"},          # 可选，精确名→归属\n    \"prefix\":  [{\"p\": \"上海\", \"g\": \"上海市\"}, ...], # 可选，名称前缀→归属（取最长前缀）\n    \"fallback\": \"其他/未识别\"                        # 可选，默认 \"其他/未识别\"\n  }\n匹配优先级：--group-col 非空原值 > exact > prefix（最长前缀优先）> fallback。\n映射里没有的分组名不会预生成；分组名就是写入新表的归属值（省市区均可）。\n\n输出:\n  --out xlsx 两个工作表：\n    归并结果: [原行号, 名称, 归属, 匹配方式]，按归属排序；\n    分组统计: [归属, 数量] 降序 + 末行合计（必须等于输入行数）。\n  --unmatched JSON: [{\"row\": 原行号, \"name\": 名称}, ...] 即 匹配方式=fallback 的条目，供搜索补归属。\n\n退出码: 0 成功；2 输入错误（文件缺失/无指定列/空数据/映射文件无效）；\n3 输出记录数与输入不一致（脚本内部断言失败，属程序问题，勿交付）。\n\"\"\"\nimport argparse, csv, json, sys\n\ntry:\n    from openpyxl import Workbook, load_workbook\nexcept ImportError:\n    print(\"缺少 openpyxl，请先 pip install openpyxl\", file=sys.stderr)\n    sys.exit(3)\n\n\ndef die(code, msg):\n    print(msg, file=sys.stderr)\n    sys.exit(code)\n\n\ndef read_rows(path, sheet, name_col, group_col, use_csv):\n    \"\"\"返回 (records, header) records=[{name, group_hint, row}] row 为 1 起始数据行号。\"\"\"\n    if use_csv:\n        with open(path, newline='', encoding='utf-8-sig') as f:\n            rows = list(csv.reader(f))\n        if not rows:\n            die(2, f\"输入为空: {path}\")\n        header = [str(c).strip() for c in rows[0]]\n        data = rows[1:]\n    else:\n        try:\n            wb = load_workbook(path, read_only=True, data_only=True)\n        except Exception as e:\n            die(2, f\"无法读取 xlsx {path}: {e}\")\n        ws = wb[sheet] if sheet else wb.active\n        if sheet and sheet not in wb.sheetnames:\n            die(2, f\"工作表 {sheet!r} 不存在，现有: {wb.sheetnames}\")\n        rows = list(ws.iter_rows(values_only=True))\n        wb.close()\n        if not rows:\n            die(2, f\"输入为空: {path}\")\n        header = [str(c).strip() if c is not None else \"\" for c in rows[0]]\n        data = rows[1:]\n\n    def col(title):\n        try:\n            return header.index(title)\n        except ValueError:\n            die(2, f\"表头无列 {title!r}，现有列: {header}\")\n\n    ni, gi = col(name_col), (col(group_col) if group_col else None)\n    records = []\n    for i, r in enumerate(data, start=2):\n        name = r[ni] if ni < len(r) else None\n        name = str(name).strip() if name is not None else \"\"\n        hint = \"\"\n        if gi is not None and gi < len(r) and r[gi] is not None:\n            hint = str(r[gi]).strip()\n        records.append({\"row\": i, \"name\": name, \"group_hint\": hint})\n    if not records:\n        die(2, f\"无数据行: {path}\")\n    return records\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"表格按归属分组并重算计数\")\n    ap.add_argument(\"--input\", required=True)\n    ap.add_argument(\"--name-col\", required=True, help=\"用于匹配归属的名称列\")\n    ap.add_argument(\"--group-col\", help=\"可选：原表已有分组列，非空值直接采用\")\n    ap.add_argument(\"--map\", required=True, help=\"映射 JSON（exact/prefix/fallback）\")\n    ap.add_argument(\"--out\", required=True, help=\"输出 xlsx\")\n    ap.add_argument(\"--unmatched\", required=True, help=\"未识别清单 JSON 输出\")\n    ap.add_argument(\"--sheet\", help=\"输入 xlsx 工作表名，默认第一个\")\n    ap.add_argument(\"--csv\", action=\"store_true\", help=\"输入为 csv\")\n    args = ap.parse_args()\n\n    try:\n        with open(args.map, encoding='utf-8') as f:\n            m = json.load(f)\n        exact = {str(k).strip(): str(v).strip() for k, v in (m.get(\"exact\") or {}).items()}\n        prefix = sorted(\n            ((str(x[\"p\"]), str(x[\"g\"]).strip()) for x in (m.get(\"prefix\") or [])),\n            key=lambda t: len(t[0]), reverse=True)\n        fallback = str(m.get(\"fallback\") or \"其他/未识别\")\n    except Exception as e:\n        die(2, f\"映射文件无效 {args.map}: {e}\")\n\n    records = read_rows(args.input, args.sheet, args.name_col, args.group_col, args.csv)\n    empty_name = []\n    for rec in records:\n        name, hint = rec[\"name\"], rec[\"group_hint\"]\n        if hint:\n            g, how = hint, \"原列\"\n        elif name in exact:\n            g, how = exact[name], \"exact\"\n        else:\n            g, how = None, None\n            for p, grp in prefix:\n                if p and name.startswith(p):\n                    g, how = grp, f\"prefix:{p}\"\n                    break\n            if g is None:\n                g, how = fallback, \"fallback\"\n        rec[\"group\"], rec[\"how\"] = g, how\n        if not name:\n            empty_name.append(rec[\"row\"])\n\n    # 内建硬校验：输出记录数必须等于输入记录数\n    assert len(records) == len(read_rows(args.input, args.sheet, args.name_col,\n                                         args.group_col, args.csv)), \"记录数不一致\"\n\n    order = {g: i for i, g in enumerate(sorted({r[\"group\"] for r in records},\n                                               key=lambda g: (g == fallback, g)))}\n    records.sort(key=lambda r: (order[r[\"group\"]], r[\"row\"]))\n\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"归并结果\"\n    ws.append([\"原行号\", args.name_col, \"归属\", \"匹配方式\"])\n    for r in records:\n        ws.append([r[\"row\"], r[\"name\"], r[\"group\"], r[\"how\"]])\n\n    counts = {}\n    for r in records:\n        counts[r[\"group\"]] = counts.get(r[\"group\"], 0) + 1\n    ws2 = wb.create_sheet(\"分组统计\")\n    ws2.append([\"归属\", \"数量\"])\n    for g, c in sorted(counts.items(), key=lambda t: -t[1]):\n        ws2.append([g, c])\n    ws2.append([\"合计\", len(records)])\n    wb.save(args.out)\n\n    unmatched = [{\"row\": r[\"row\"], \"name\": r[\"name\"]}\n                 for r in records if r[\"how\"] == \"fallback\"]\n    with open(args.unmatched, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\"fallback\": fallback, \"count\": len(unmatched), \"items\": unmatched},\n                  f, ensure_ascii=False, indent=1)\n\n    matched = len(records) - len(unmatched)\n    pct = f\"{matched / len(records) * 100:.1f}%\" if records else \"0%\"\n    print(f\"输入 {len(records)} 条 → 输出 {len(records)} 条（校验通过）\")\n    print(f\"分组 {len(counts)} 个；已归类 {matched}（{pct}）；{fallback} {len(unmatched)} 条\")\n    if empty_name:\n        print(f\"警告: {len(empty_name)} 行名称列为空，原行号 {empty_name[:20]}\", file=sys.stderr)\n    print(f\"未识别清单: {args.unmatched}（{len(unmatched)} 条，供搜索补归属）\")\n    print(f\"输出: {args.out}\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/regroup_recount.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792731600697, "responseId": "chatcmpl-1792731600728", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "8d00ca0c-32b8-4e14-a0d4-df08a5098084"}}}
