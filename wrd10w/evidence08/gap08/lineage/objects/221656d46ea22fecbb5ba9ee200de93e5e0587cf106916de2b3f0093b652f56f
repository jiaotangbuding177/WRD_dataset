{"type": "message", "id": "915e5dde-63cd-4a99-bed4-baae40907602", "parentId": "0a9313dd-5e3d-4400-9807-fa9e9a7866d8", "timestamp": "2026-10-23T03:26:48.017Z", "message": {"role": "toolResult", "toolCallId": "call2b370647a1494fb487de49ba8fb5dcf0", "toolName": "read", "content": [{"type": "text", "text": "\"\"\"Scan text-bearing XML parts of a .docx for keywords, with context.\n\nMethod: open the OOXML zip, read word/document.xml plus every\nword/headerN.xml / word/footerN.xml, strip tags per paragraph, and report each\nkeyword occurrence with a +-12 character context. Use it before a document-wide\nclause change so no referencing clause is missed.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_docx_keywords error: no keywords given', file=sys.stderr)\n        return 2\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx')\n        archive = zipfile.ZipFile(src)\n    except (OSError, ValueError, zipfile.BadZipFile) as error:\n        print('scan_docx_keywords error: ' + str(error), file=sys.stderr)\n        return 2\n    try:\n        members = sorted(n for n in archive.namelist()\n                         if re.fullmatch(r'word/(document|header\\d*|footer\\d*)\\.xml', n))\n        hits = []\n        for member in members:\n            xml = archive.read(member).decode('utf-8')\n            paragraphs = re.findall(r'<w:p[ >].*?</w:p>', xml, re.S)\n            for paragraph in paragraphs:\n                text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S)))\n                for keyword in keywords:\n                    start = 0\n                    while True:\n                        index = text.find(keyword, start)\n                        if index < 0:\n                            break\n                        hits.append({'keyword': keyword, 'member': member,\n                                     'context': text[max(0, index - 12):index + len(keyword) + 12]})\n                        start = index + len(keyword)\n        result = {'keywords': keywords, 'members_scanned': len(members),\n                  'total': len(hits), 'hits': hits}\n        out = Path(args.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n        print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '\n              + str(len(members)) + ' members -> ' + args.out)\n        return 0\n    finally:\n        archive.close()\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "\"\"\"Scan text-bearing XML parts of a .docx for keywords, with context.\n\nMethod: open the OOXML zip, read word/document.xml plus every\nword/headerN.xml / word/footerN.xml, strip tags per paragraph, and report each\nkeyword occurrence with a +-12 character context. Use it before a document-wide\nclause change so no referencing clause is missed.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_docx_keywords error: no keywords given', file=sys.stderr)\n        return 2\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx')\n        archive = zipfile.ZipFile(src)\n    except (OSError, ValueError, zipfile.BadZipFile) as error:\n        print('scan_docx_keywords error: ' + str(error), file=sys.stderr)\n        return 2\n    try:\n        members = sorted(n for n in archive.namelist()\n                         if re.fullmatch(r'word/(document|header\\d*|footer\\d*)\\.xml', n))\n        hits = []\n        for member in members:\n            xml = archive.read(member).decode('utf-8')\n            paragraphs = re.findall(r'<w:p[ >].*?</w:p>', xml, re.S)\n            for paragraph in paragraphs:\n                text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S)))\n                for keyword in keywords:\n                    start = 0\n                    while True:\n                        index = text.find(keyword, start)\n                        if index < 0:\n                            break\n                        hits.append({'keyword': keyword, 'member': member,\n                                     'context': text[max(0, index - 12):index + len(keyword) + 12]})\n                        start = index + len(keyword)\n        result = {'keywords': keywords, 'members_scanned': len(members),\n                  'total': len(hits), 'hits': hits}\n        out = Path(args.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n        print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '\n              + str(len(members)) + ' members -> ' + args.out)\n        return 0\n    finally:\n        archive.close()\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}, "isError": false, "timestamp": 1792726008014, "__openclaw": {"runId": "a1ddc3f2-db03-4b7b-ab66-627cb3b5a216"}}}
