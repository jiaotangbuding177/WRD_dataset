#!/usr/bin/env python3
"""知识库整理：按用户确认的口径生成分类/去重/重命名整理计划（默认不动文件）。

方法：先校验口径JSON（categories 必须存在），再复用 kb_inventory.scan 盘点；
按扩展名映射分类，相同 sha256 的文件判为重复（duplicate_policy=report_only 时
只报告不移动，保留排序后首份），目标路径冲突自动加后缀重命名；输出确定性JSON。
--apply 目标目录 时按计划复制归位（不删除、不覆盖已存在目标，原文件保留）。
公开用法（逐字见 SKILL.md）：
  python {SKILL}/scripts/kb_organize.py {INPUT}/kb --rules {SKILL}/templates/organize_rules.json --out {OUT}/organize_plan.json
错误一律打印 'kb_organize_error: ...' 到 stderr 并退出 2。
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from kb_inventory import scan

SCHEMA = "kb-organize-plan-v1"


def fail(message: str) -> int:
    print("kb_organize_error: " + message, file=sys.stderr)
    return 2


def load_rules(path: str) -> dict:
    if not os.path.isfile(path):
        raise ValueError("rules file not found: " + path)
    try:
        with open(path, encoding="utf-8-sig") as fh:
            rules = json.load(fh)
    except (OSError, ValueError) as error:
        raise ValueError("rules file is not valid JSON: " + str(error))
    if not isinstance(rules, dict) or not isinstance(rules.get("categories"), dict) or not rules["categories"]:
        raise ValueError("rules missing categories mapping")
    for category, exts in rules["categories"].items():
        if not isinstance(category, str) or not isinstance(exts, list) or not all(isinstance(x, str) for x in exts):
            raise ValueError("rules categories mapping invalid")
    return rules


def build_plan(kb_path: str, rules: dict) -> dict:
    inventory = scan(kb_path)
    suffix = rules.get("conflict_suffix", "-1")
    unmatched = rules.get("unmatched_category", "其他")
    category_by_ext = {}
    for category, exts in rules["categories"].items():
        for ext in exts:
            category_by_ext[ext.lower()] = category
    by_hash = {}
    for item in inventory["files"]:
        by_hash.setdefault(item["sha256"], []).append(item["path"])
    duplicate_groups, duplicate_paths = [], set()
    for digest, paths in sorted(by_hash.items()):
        if len(paths) > 1:
            ordered = sorted(paths)
            duplicate_groups.append(ordered)
            duplicate_paths.update(ordered[1:])
    moves, renames, used, stats = [], [], set(), {}
    for item in inventory["files"]:
        if item["path"] in duplicate_paths:
            continue
        category = category_by_ext.get(item["ext"], unmatched)
        target = category + "/" + os.path.basename(item["path"])
        if target in used:
            base, ext = os.path.splitext(os.path.basename(item["path"]))
            counter = 1
            while True:
                candidate = category + "/" + base + suffix + str(counter) + ext
                if candidate not in used:
                    break
                counter += 1
            renames.append({"from": item["path"], "to": candidate})
            target = candidate
        used.add(target)
        moves.append({"from": item["path"], "to": target})
        entry = stats.setdefault(category, {"file_count": 0, "bytes": 0})
        entry["file_count"] += 1
        entry["bytes"] += item["bytes"]
    categories = [{"category": c, "file_count": v["file_count"], "bytes": v["bytes"]}
                  for c, v in sorted(stats.items())]
    return {"schema": SCHEMA, "kb_name": inventory["kb_name"],
            "summary": {"total_files": inventory["total_files"], "total_bytes": inventory["total_bytes"],
                        "kept_files": len(moves), "duplicate_files": len(duplicate_paths),
                        "move_count": len(moves), "rename_count": len(renames)},
            "categories": categories, "moves": moves, "renames": renames,
            "duplicates": duplicate_groups,
            "duplicate_policy": rules.get("duplicate_policy", "report_only"), "applied": False}


def apply_plan(kb_path: str, dest: str, plan: dict) -> None:
    for move in plan["moves"]:
        source = os.path.join(kb_path, move["from"].replace("/", os.sep))
        target = os.path.join(dest, move["to"].replace("/", os.sep))
        if os.path.exists(target):
            raise ValueError("apply target already exists: " + target)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(source, target)


def main() -> int:
    parser = argparse.ArgumentParser(description="按确认口径生成知识库整理计划JSON（默认不移动文件）")
    parser.add_argument("kb", help="知识库目录路径")
    parser.add_argument("--rules", required=True, help="整理口径JSON路径")
    parser.add_argument("--out", required=True, help="输出整理计划JSON路径")
    parser.add_argument("--apply", dest="apply_dest", default=None,
                        help="可选：用户确认后把保留文件复制归位到该目录（不删除原文件）")
    args = parser.parse_args()
    try:
        rules = load_rules(args.rules)
        plan = build_plan(args.kb, rules)
        if args.apply_dest:
            apply_plan(args.kb, args.apply_dest, plan)
            plan["applied"] = True
            plan["apply_dest"] = args.apply_dest
    except ValueError as error:
        return fail(str(error))
    payload = json.dumps(plan, ensure_ascii=False, indent=2) + "\n"
    try:
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(payload)
    except OSError as error:
        return fail("cannot write output: " + str(error))
    print("plan written: " + args.out + " (" + str(plan["summary"]["move_count"]) + " moves, "
          + str(plan["summary"]["duplicate_files"]) + " duplicates)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
