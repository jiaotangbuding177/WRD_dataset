#!/usr/bin/env python3
"""扫描已提取的论文文本，产出表/图引用与数值出现清单（供一致性核对与报告引用）。

用法（原样可执行）:
  python3 scan_numeric_refs.py <提取文本.txt|.md> --out <scan.json>

方法:
- 逐行扫描，识别 表X(-Y)/Table X、图X(-Y)/Figure X/Fig.X 引用并记录行号；
- 统计含数值的行数与数值总个数（整数/小数）；
- 输出 JSON：tables/figures（按引用串排序，mentions 为升序行号）、
  tables_total、figures_total、numeric_lines、numbers_total、chars。
- 退出码: 0 成功（静默，结果只写 --out 文件）；2 输入缺失/类型不支持/无法读取。
不联网、不修改输入文件；不判定一致性结论，结论由审查阶段结合源数据判断。
"""
import argparse
import json
import re
import sys
from pathlib import Path

REF_PATTERNS = (
    ("table_cn", re.compile(r"表\s?\d+(?:[-.－]\d+)?")),
    ("table_en", re.compile(r"Table\s?\d+", re.IGNORECASE)),
    ("figure_cn", re.compile(r"图\s?\d+(?:[-.－]\d+)?")),
    ("figure_en", re.compile(r"(?:Figure|Fig\.?)\s?\d+", re.IGNORECASE)),
)
NUMBER = re.compile(r"\d+(?:\.\d+)?")
SUPPORTED = {".txt", ".md"}


def scan_text(text):
    tables, figures = {}, {}
    numeric_lines = 0
    numbers_total = 0
    for lineno, line in enumerate(text.splitlines(), 1):
        if NUMBER.search(line):
            numeric_lines += 1
            numbers_total += len(NUMBER.findall(line))
        for kind, pattern in REF_PATTERNS:
            for match in pattern.finditer(line):
                bucket = tables if kind.startswith("table") else figures
                entry = bucket.setdefault(match.group(0), {"kind": kind, "mentions": []})
                entry["mentions"].append(lineno)

    def as_list(bucket):
        return [
            {"ref": ref, "kind": bucket[ref]["kind"], "mentions": bucket[ref]["mentions"]}
            for ref in sorted(bucket)
        ]

    return {
        "tables": as_list(tables),
        "figures": as_list(figures),
        "tables_total": len(tables),
        "figures_total": len(figures),
        "numeric_lines": numeric_lines,
        "numbers_total": numbers_total,
        "chars": len(text),
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description="扫描论文文本中的表/图引用与数值")
    parser.add_argument("input", help="已提取的论文文本（.txt/.md）")
    parser.add_argument("--out", required=True, help="输出 scan.json 路径")
    args = parser.parse_args(argv)
    src = Path(args.input)
    try:
        if not src.is_file():
            raise ValueError("input not found: " + str(src))
        if src.suffix.lower() not in SUPPORTED:
            raise ValueError("unsupported input type " + src.suffix + ": expected .txt or .md")
        try:
            text = src.read_text(encoding="utf-8")
        except UnicodeError as error:
            raise ValueError("input is not valid UTF-8 text: " + str(error))
    except (OSError, ValueError) as error:
        print("scan_numeric_refs error: " + str(error), file=sys.stderr)
        return 2
    result = scan_text(text)
    result["source"] = src.name
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(result, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
