{
  "resources": [
    {
      "id": "minutes-format-program",
      "path": "scripts/apply_minutes_format.py",
      "kind": "program",
      "interface": {
        "kind": "program",
        "contract_version": "1",
        "usage": "python {SKILL}/scripts/apply_minutes_format.py {INPUT}/meeting_minutes.docx --out {OUT}/minutes_formatted.docx --report {OUT}/format_summary.json --remove-stars",
        "inputs": [
          "meeting_minutes_docx（录音转写/录音总结或既有纪要整理成的docx正文，中文段落可含行首*号列表标记）"
        ],
        "outputs": [
          "formatted_minutes_docx（排版后纪要正文，可直接接续成文或交付）",
          "format_report_json（样式参数、段落数、去星数、paragraph_texts全文清单）"
        ]
      },
      "dependencies": [
        {
          "kind": "runtime",
          "name": "OpenClaw-python",
          "version": "2026.9.5-python3.11.2",
          "identity_sha256": "97a0f55bec1ef293c15ddd5a17cc843050387bd2369dcf2fd388b1afd40810a2"
        }
      ],
      "applicability": {
        "supported": [
          "中文docx正文段落：设置中文/西文字体、正文字号、1.5倍行距、字符制首行缩进，可选去行首*号",
          "样式参数可用 --cn-font/--western-font/--body-size/--line-spacing/--first-line-indent 调整，默认值即既往纪要格式（楷体/Times New Roman/12pt/1.5/2字符）"
        ],
        "unsupported": [
          "不处理表格内段落、不嵌字体文件、不修复损坏docx关系引用",
          "不做录音转写、不做会议内容事实核对与补充",
          "无效输入（缺失文件/非docx）退出码2并在stderr报错，不产输出"
        ]
      },
      "source_evidence": [
