        "contract_version": "1",
        "usage": "阅读 {SKILL}/references/minutes_style_reference.md 作为 apply_format_and_style / compose_minutes_document 阶段的样式规范与成文约定；排版参数行直接映射为格式化程序参数",
        "inputs": [
          "organized_meeting_content（已组织的会议内容文本）"
        ],
        "outputs": [
          "styled_minutes_body（符合既定样式的纪要正文）"
        ]
      },
      "dependencies": [
