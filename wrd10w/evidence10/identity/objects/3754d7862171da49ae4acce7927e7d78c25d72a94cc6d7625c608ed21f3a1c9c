#!/usr/bin/env python3
"""装配"一页一项目"评审打印稿 docx（提问+点评+名次/建议，现场照页翻用）。

用法（原样可执行）:
  python3 build_review_pack.py --details <details.json> --out <输出.docx> [--ranks <ranks.csv>]

details.json 形状（字段缺省可省，程序按存在字段渲染）:
  {"title":"XX评审 打印稿",
   "projects":[{"name":"项目A","owner":"张三","affiliation":"某学院",
                "comment":"一两句点评",
                "questions":["提问1","提问2","提问3","提问4","提问5"],
                "suggestions":["建议1","建议2"]}]}

--ranks 为 rank_matrix.py solve 产出的 csv（列: 项目,<各维度>,合计）；
按项目名合并维度名次与合计；csv 中的顺序（合计升序）即页序与"第X位"编号。
无 --ranks 时按 details 中 projects 顺序出页，不显示名次行。

输出: A4、9pt、Noto Sans CJK SC，一项目一页，页间分页符；
stdout 打印 {"pages","projects","out"}。退出码: 0 成功; 2 用法/输入错误。
"""
import argparse
import csv
import json
import os
import sys

from docx import Document
from docx.enum.text import WD_BREAK
from docx.oxml.ns import qn
from docx.shared import Cm, Pt

FONT = "Noto Sans CJK SC"


def load_ranks(path):
    with open(path, "r", encoding="utf-8-sig") as f:
        rows = list(csv.reader(f))
    if not rows or rows[0][0] != "项目" or rows[0][-1] != "合计":
        raise ValueError("ranks csv 表头必须是 项目,<维度...>,合计")
    header = rows[0]
    dims = header[1:-1]
    out = []
    for r in rows[1:]:
        if not r or not r[0].strip():
            continue
        out.append({
            "name": r[0],
            "ranks": {dm: v for dm, v in zip(dims, r[1:-1])},
            "total": r[-1],
        })
    return out


def set_style(doc):
    st = doc.styles["Normal"]
    st.font.name = FONT
    st.font.size = Pt(9)
    st.element.rPr.rFonts.set(qn("w:eastAsia"), FONT)
    for s in doc.sections:
        s.top_margin = Cm(1.2)
        s.bottom_margin = Cm(1.2)
        s.left_margin = Cm(1.5)
        s.right_margin = Cm(1.5)


def add_para(doc, text, bold=False, size=9, space_after=2):
    p = doc.add_paragraph()
    run = p.add_run(text)
    run.bold = bold
    run.font.size = Pt(size)
    run.font.name = FONT
    run._element.rPr.rFonts.set(qn("w:eastAsia"), FONT)
    p.paragraph_format.space_after = Pt(space_after)
    return p


def main(argv):
    ap = argparse.ArgumentParser(description="装配一页一项目评审打印稿")
    ap.add_argument("--details", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--ranks")
    args = ap.parse_args(argv)

    try:
        with open(args.details, "r", encoding="utf-8") as f:
            details = json.load(f)
    except Exception as e:  # noqa: BLE001
        print("details 读取失败: %s" % e, file=sys.stderr)
        return 2
    projects = details.get("projects")
    if not projects or not isinstance(projects, list):
        print("details.projects 必须是非空数组", file=sys.stderr)
        return 2
    for p in projects:
        if not isinstance(p, dict) or not p.get("name"):
            print("details.projects[].name 必填", file=sys.stderr)
            return 2

    by_name = {p["name"]: p for p in projects}
    ranked = None
    if args.ranks:
        try:
            ranked = load_ranks(args.ranks)
        except Exception as e:  # noqa: BLE001
            print("ranks 读取失败: %s" % e, file=sys.stderr)
            return 2
    if ranked:
        missing = [r["name"] for r in ranked if r["name"] not in by_name]
        if missing:
            print("ranks 中项目在 details 中缺失: %s" % ",".join(missing), file=sys.stderr)
            return 2
        seq = [(i + 1, r["name"], by_name[r["name"]], r) for i, r in enumerate(ranked)]
    else:
        seq = [(i + 1, p["name"], p, None) for i, p in enumerate(projects)]

    doc = Document()
    set_style(doc)
    if details.get("title"):
        add_para(doc, details["title"], bold=True, size=12, space_after=4)
        doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)

    for idx, (pos, name, proj, rk) in enumerate(seq):
        n_total = len(seq)
        add_para(doc, "第%d位 ｜ 项目%d/%d ｜ %s" % (pos, idx + 1, n_total, name), bold=True, size=10.5)
        info = "负责人：%s" % proj.get("owner", "—")
        if proj.get("affiliation"):
            info += "（%s）" % proj["affiliation"]
        if rk:
            info += " ｜ 名次合计：%s" % rk["total"]
        add_para(doc, info)
        if rk and rk["ranks"]:
            add_para(doc, "维度名次（1=最优）：%s" % " ｜ ".join(
                "%s %s" % (dm, v) for dm, v in rk["ranks"].items()))
        if proj.get("comment"):
            add_para(doc, "【点评】%s" % proj["comment"])
        qs = proj.get("questions") or []
        if qs:
            add_para(doc, "【拟现场提问】", bold=True)
            for i, q in enumerate(qs, 1):
                add_para(doc, "%d. %s" % (i, q))
        sg = proj.get("suggestions") or []
        if sg:
            add_para(doc, "【申报书修改建议】", bold=True)
            for i, s in enumerate(sg, 1):
                add_para(doc, "%d. %s" % (i, s))
        add_para(doc, "现场记录：＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿")
        if idx < n_total - 1 or details.get("title"):
            doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)

    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    doc.save(args.out)
    print(json.dumps({"pages": len(seq), "projects": len(seq), "out": args.out}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
