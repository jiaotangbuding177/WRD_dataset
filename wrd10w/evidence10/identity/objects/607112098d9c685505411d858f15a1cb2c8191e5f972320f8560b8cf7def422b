"""Making-only bounded source reader. It emits text, never an Agent loop.

Reading a file is not evidence that a model received it. Only actual successful
native tool results containing these exact chunks can support that observation.
"""
from __future__ import annotations
import argparse
import hashlib
import json
from pathlib import Path
import re
import sys

SCHEMA = 'wrd-source-text-chunks-v1'


def leaves(value, pointer=''):
    if isinstance(value, str):
        yield pointer, value
    elif isinstance(value, list):
        for index, item in enumerate(value):
            yield from leaves(item, pointer + '/' + str(index))
    elif isinstance(value, dict):
        for key, item in value.items():
            escaped = str(key).replace('~', '~0').replace('/', '~1')
            yield from leaves(item, pointer + '/' + escaped)


def source_entries(paths):
    entries, ids = [], []
    for path in paths:
        path = Path(path)
        if path.is_symlink() or not path.is_file():
            raise ValueError('Source must be a regular file')
        record = json.loads(path.read_text(encoding='utf-8-sig'))
        sid = record.get('session_id', record.get('source_id'))
        if not isinstance(sid, str) or not sid or sid in ids:
            raise ValueError('Missing or duplicate source identity')
        ids.append(sid)
        for message in record['messages']:
            mid = message.get('id')
            if not isinstance(mid, str) or not mid:
                raise ValueError('Exact original message identity required')
            for pointer, text in leaves(message.get('content', '')):
                data = text.encode('utf-8')
                entries.append({'source_id': sid, 'message_id': mid, 'leaf_path': pointer,
                                'text': text, 'data': data, 'leaf_sha256': hashlib.sha256(data).hexdigest()})
    return ids, entries


def encoded(payload):
    return (json.dumps(payload, ensure_ascii=False, separators=(',', ':'), allow_nan=False) + '\n').encode('utf-8')


def make_batch(paths, cursor=None, max_bytes=6500):
    if type(max_bytes) is not int or not 2048 <= max_bytes <= 6500:
        raise ValueError('Use a total native tool output budget between 2048 and 6500 UTF8 bytes')
    ids, entries = source_entries(paths)
    cursor = '0:0' if cursor is None else cursor
    if not isinstance(cursor, str) or not re.fullmatch(r'[0-9]+:[0-9]+', cursor):
        raise ValueError('Cursor must be the exact previous next_cursor leafIndex:byteOffset')
    index, offset = map(int, cursor.split(':'))
    if index > len(entries) or (index == len(entries) and offset):
        raise ValueError('Cursor outside source leaves')
    chunks = []

    def frame(next_index, next_offset):
        done = next_index == len(entries)
        return {'schema': SCHEMA, 'source_ids': ids, 'cursor_in': cursor, 'chunks': chunks,
                'next_cursor': None if done else f'{next_index}:{next_offset}', 'complete': done,
                'file_read_is_not_model_receipt': True}

    while index < len(entries):
        entry = entries[index]
        if offset > len(entry['data']):
            raise ValueError('Cursor outside original UTF8 leaf')
        # Reject a fabricated cursor in the middle of a UTF8 code point.
        entry['data'][:offset].decode('utf-8')
        remaining = entry['data'][offset:].decode('utf-8')
        if not remaining:
            index += 1
            offset = 0
            continue

        def candidate(count):
            text = remaining[:count]
            raw = text.encode('utf-8')
            end = offset + len(raw)
            chunk = {key: entry[key] for key in ('source_id', 'message_id', 'leaf_path', 'leaf_sha256')}
            chunk.update(byte_start=offset, byte_end=end, text=text, text_sha256=hashlib.sha256(raw).hexdigest())
            complete_leaf = end == len(entry['data'])
            next_index, next_offset = (index + 1, 0) if complete_leaf else (index, end)
            return chunk, next_index, next_offset

        low, high = 0, len(remaining)
        while low < high:
            middle = (low + high + 1) // 2
            chunk, next_index, next_offset = candidate(middle)
            chunks.append(chunk)
            fits = len(encoded(frame(next_index, next_offset))) <= max_bytes
            chunks.pop()
            if fits:
                low = middle
            else:
                high = middle - 1
        if low == 0:
            if not chunks:
                raise ValueError('A source identity/header cannot fit the bounded output budget')
            break
        chunk, next_index, next_offset = candidate(low)
        chunks.append(chunk)
        index, offset = next_index, next_offset
        if index < len(entries) and offset:
            break
    payload = frame(index, offset)
    if len(encoded(payload)) > max_bytes:
        raise ValueError('Bounded source output exceeded its declared limit')
    return payload


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--source', nargs='+', required=True)
    parser.add_argument('--cursor')
    parser.add_argument('--max-bytes', type=int, default=6500)
    args = parser.parse_args()
    try:
        payload = make_batch(args.source, args.cursor, args.max_bytes)
    except (OSError, ValueError, KeyError, TypeError, UnicodeError) as error:
        print('source_reader_error: ' + str(error), file=sys.stderr)
        return 2
    sys.stdout.buffer.write(encoded(payload))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
