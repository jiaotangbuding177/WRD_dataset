irement_dimensions\"], \"output_types\": [\"jd_issue_list\"],\n                \"depends_on\": [\"s1\"], \"condition\": None,\n                \"source_evidence\": [\n                    {\"source_id\": \"conv_4dff386a54ac\", \"message_id\": \"conv_4dff386a54ac:7b470eb8\"}\n                ]\n            },\n            {\n                \"id\": \"s3\", \"operation\": \"revise_jd_text\",\n                \"input_types\": [\"requirement_dimensions\", \"jd_issue_list\", \"company_reference_documents\"],\n                \"output_types\": [\"jd_text\"],\n                \"depends_on\": [\"s2\"],\n                \"condition\": \"仅基于用户提供的JD与公司参考材料完善表述，材料不足处明确标注\",\n                \"source_evidence\": [\n                    {\"source_id\": \"conv_a9304334a810\", \"message_id\": \"conv_a9304334a810:msg_1\"}\n                ]\n            },\n            {\n                \"id\": \"s4\", \"operation\": \"export_jd_document\",\n                \"input_types\": [\"jd_text\"], \"output_types\": [\"word_document\"],\n                \"depends_on\": [\"s3\"],\n                \"condition\": \"用户要求交付文件时执行\",\n                \"source_evidence\": [\n                    {\"source_id\": \"conv_a9304334a810\", \"message_id\": \"conv_a9304334a810:msg_1\"}\n                ]\n            }\n        ],\n        \"branches\": []\n    },\n    \"value_plan\": {\n        \"schema\": \"wrd-reuse-value-plan-v2\",\n        \"workflow_id\": \"jd-review-refinement\",\n        \"source_ids\": [\"conv_4dff386a54ac\", \"conv_a9304334a810\", \"conv_7280f3693c03\"],\n        \"reusable_steps\": [\n            {\n                \"id\": \"jd_structure_composition\",\n                \"action\": \"按固定JD结构（岗位职责/任职要求/加分项/公司情况）组织与完善JD文本\",\n                \"replaces\": [\"output_composition\"],\n                \"resource_ids\": [\"r1\"],\n                \"support\": [\n                    {\"source_id\": \"conv_a9304334a810\", \"message_ids\": [\"conv_a9304334a810:msg_1\"]},\n                    {