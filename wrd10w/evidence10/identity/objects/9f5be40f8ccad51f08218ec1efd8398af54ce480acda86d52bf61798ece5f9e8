{"type": "message", "id": "8f34c8f7-102f-445f-94e2-2bbb01ae3dc9", "parentId": "89584c0a-01ad-4727-91ab-67fabe545b5d", "timestamp": "2026-10-21T18:58:38.498Z", "message": {"role": "toolResult", "toolCallId": "call862e64d08c2345b5ba746d85a2e000ca", "toolName": "exec", "content": [{"type": "text", "text": "\"\"\"Scan text-bearing XML parts of a .docx for keywords, with context.\n\nMethod: open the OOXML zip, read word/document.xml plus every\nword/headerN.xml / word/footerN.xml, strip tags per paragraph, and report each\nkeyword occurrence with a +-12 character context. Use it before a document-wide\nclause change so no referencing clause is missed.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_docx_keywords error: no keywords given', file=sys.stderr)\n        return 2\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx')\n        archive = zipfile.ZipFile(src)\n    except (OSError, ValueError, zipfile.BadZipFile) as error:\n        print('scan_docx_keywords error: ' + str(error), file=sys.stderr)\n        return 2\n    try:\n        members = sorted(n for n in archive.namelist()\n                         if re.fullmatch(r'word/(document|header\\d*|footer\\d*)\\.xml', n))\n        hits = []\n        for member in members:\n            xml = archive.read(member).decode('utf-8')\n            paragraphs = re.findall(r'<w:p[ >].*?</w:p>', xml, re.S)\n            for paragraph in paragraphs:\n                text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S)))\n                for keyword in keywords:\n                    start = 0\n                    while True:\n                        index = text.find(keyword, start)\n                        if index < 0:\n                            break\n                        hits.append({'keyword': keyword, 'member': member,\n                                     'context': text[max(0, index - 12):index + len(keyword) + 12]})\n                        start = index + len(keyword)\n        result = {'keywords': keywords, 'members_scanned': len(members),\n                  'total': len(hits), 'hits': hits}\n        out = Path(args.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n        print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '\n              + str(len(members)) + ' members -> ' + args.out)\n        return 0\n    finally:\n        archive.close()\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n===\n\"\"\"Extract plain text from a .docx contract into a JSON file.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> paragraph, unescape XML entities, and write {source_file, paragraphs,\ntext} JSON to --out. Only .docx is supported; scanned PDFs must be OCR'd first.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    for match in re.findall(r'<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    result = {'source_file': src.name, 'paragraphs': len(paragraphs), 'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(len(paragraphs)) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n===\n#!/usr/bin/env python3\n\"\"\"批量提取评审文档文本（pptx/docx/doc/pdf/md/txt -> 每文件一个 .txt + index.json）。\n\n用法（原样可执行）:\n  python3 extract_texts.py <输入文件或目录...> --out <输出目录>\n\n行为:\n- 目录会被递归展开，仅处理受支持扩展名；同目录同名输出自动加序号，不覆盖。\n- .pptx: python-pptx，递归组合形状/表格/备注，按 SLIDE 分节。\n- .docx: python-docx 段落+表格。\n- .doc:  先用 soffice --headless 转 docx（需镜像内有 soffice），再按 docx 提取。\n- .pdf:  pdftotext（需镜像内有 pdftotext）。\n- .md/.txt: 原文直读。\n- 输出: <输出目录>/<源名>.txt 与 index.json（含源 sha256、字节数、节数、字符数、错误记录）。\n- 退出码: 0 全部成功; 2 用法错误; 3 有文件提取失败（错误同时写入 index.json 与 stderr）。\n不联网、不写输入