ace('{INPUT}','inputs').replace('{FIXTURE}','outputs/reproduction_inputs').replace('{OUT}',outdir) for a in argv]\n    p=subprocess.run(argv,capture_output=True,text=True)\n    outfile=None\n    for o in case.get('outputs',[]):\n        outfile=os.path.join(outdir,o['path'])\n    res={'label':label,'exit':p.returncode,'expected_exit':case['expected_exit'],'stdout':p.stdout.strip(),'stderr':p.stderr.strip()}\n    ok = p.returncode==case['expected_exit']\n    if ok and outfile: ok = check_assertions(case,outfile,p.stderr,res)\n    if not ok: ok = check_assertions(case,outfile,p.stderr,res)\n    res['pass']=ok\n    results['all_pass'] &= ok\n    results['runs'].append(res)\n\nprog=replay['programs'][0]\nfor i,c in enumerate(prog['cases']):\n    run(c['argv'], f\"outputs/making_history/verify/case{i}\", c, f\"case{i}:{c['kind']}\")\nfor i,c in enumerate(replay['composition_cases']):\n    for cmd in c['commands']:\n        run(cmd, f\"outputs/making_history/verify/comp{i}\", c, f\"comp{i}:{c['kind']}\")\n\n# non-executable resource checks\ntpl=open('outputs/candidate/skill/templates/screening_table.template.md',encoding='utf-8').read()\nner=replay['non_executable_resources'][0]; checks=ner['checks']\nmissing=[p for p in checks['required_placeholders'] if p not in tpl]\nleaked=[v for v in checks['must_not_contain'] if v in tpl]\nner_res={'label':'template_checks','placeholders_missing':missing,'business_leaks':leaked,'pass':not missing and not leaked}\nresults['runs'].append(ner_res); results['all_pass'] &= ner_res['pass']\n\n# SKILL.md documented_usage must equal programs[0].documented_usage\nskill=open('outputs/candidate/skill/SKILL.md',encoding='utf-8').read()\ndu=replay['programs'][0]['documented_usage']\ndoc_ok = du in skill and ('python {SKILL}/scripts/extract_resumes.py {INPUT}/materials/conv_db09358aab86 {INPUT}/materials/conv_f8a56f4505e3 --out {OUT}/profiles_all.json' in skill)\nresults['runs'].append({'label':'documented_usage_in_skill','pass':doc_ok}); results