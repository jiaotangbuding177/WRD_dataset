r: {exc}\", file=sys.stderr)\n            return 2\n\n    result = {\n        \"schema\": \"resume-text-extraction-v1\",\n        \"inputs\": [\n            {\"path\": str(p), \"file_name\": p.name, \"sha256\": sha256_file(p)}\n            for p in args.inputs\n        ],\n        \"profiles\": profiles,\n    }\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    with open(out, \"w\", encoding=\"utf-8\") as f:\n        json.dump(result, f, ensure_ascii=False, indent=1)\n    print(f\"extracted {len(profiles)} resume(s) -> {out}\")\n    flagged = [p[\"file_name\"] for p in profiles if p[\"text_quality\"] != \"clean\"]\n    if flagged:\n        print(\"low_text_or_garbled (needs OCR, not extracted reliably): \" + \"; \".join(flagged), file=sys.stderr)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792568641877, "responseId": "chatcmpl-1792568641900", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "0da28eba-077f-4945-93cf-7538ae036a02"}}}
