{"type": "message", "id": "f0d1c87d-e9ed-4350-8a00-ec37b1e25ea7", "parentId": "ccc7d1ff-82df-4b12-a8df-6081864be184", "timestamp": "2026-10-21T08:13:58.583Z", "message": {"role": "toolResult", "toolCallId": "call4cafb8accdf04fb6bbadb97553924f55", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"批量提取评审文档文本（pptx/docx/doc/pdf/md/txt -> 每文件一个 .txt + index.json）。\n\n用法（原样可执行）:\n  python3 extract_texts.py <输入文件或目录...> --out <输出目录>\n\n行为:\n- 目录会被递归展开，仅处理受支持扩展名；同目录同名输出自动加序号，不覆盖。\n- .pptx: python-pptx，递归组合形状/表格/备注，按 SLIDE 分节。\n- .docx: python-docx 段落+表格。\n- .doc:  先用 soffice --headless 转 docx（需镜像内有 soffice），再按 docx 提取。\n- .pdf:  pdftotext（需镜像内有 pdftotext）。\n- .md/.txt: 原文直读。\n- 输出: <输出目录>/<源名>.txt 与 index.json（含源 sha256、字节数、节数、字符数、错误记录）。\n- 退出码: 0 全部成功; 2 用法错误; 3 有文件提取失败（错误同时写入 index.json 与 stderr）。\n不联网、不写输入目录；输出目录不存在会自动创建。\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\n\nSUPPORTED = {\".pptx\", \".docx\", \".doc\", \".pdf\", \".md\", \".txt\"}\n\n\ndef sha256_of(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef _walk_shapes(shapes):\n    for sh in shapes:\n        try:\n            if sh.shape_type == 6:  # GROUP\n                yield from _walk_shapes(sh.shapes)\n                continue\n        except Exception:\n            pass\n        yield sh\n\n\ndef extract_pptx(path):\n    from pptx import Presentation\n\n    prs = Presentation(path)\n    sections = []\n    for i, slide in enumerate(prs.slides, 1):\n        parts = []\n        for sh in _walk_shapes(slide.shapes):\n            try:\n                if getattr(sh, \"has_table\", False) and sh.has_table:\n                    for row in sh.table.rows:\n                        cells = [c.text.strip() for c in row.cells]\n                        line = \" | \".join(c for c in cells if c)\n                        if line:\n                            parts.append(line)\n                    continue\n                if sh.has_text_frame:\n                    tx = sh.text_frame.text.strip()\n                    if tx:\n                        parts.append(tx)\n            except Exception:\n                continue\n        if slide.has_notes_slide:\n            try:\n                nt = slide.notes_slide.notes_text_frame.text.strip()\n                if nt:\n                    parts.append(\"[备注] \" + nt)\n            except Exception:\n                pass\n        sections.append(\"===== SLIDE %d =====\\n%s\" % (i, \"\\n\".join(parts)))\n    return \"\\n\\n\".join(sections) + (\"\\n\" if sections else \"\"), len(sections)\n\n\ndef extract_docx(path):\n    import docx\n\n    d = docx.Document(path)\n    parts = []\n    for p in d.paragraphs:\n        t = p.text.strip()\n        if t:\n            parts.append(t)\n    tables = []\n    for tb in d.tables:\n        for row in tb.rows:\n            cells = [c.text.strip() for c in row.cells]\n            line = \" | \".join(c for c in cells if c)\n            if line:\n                tables.append(line)\n    text = \"\\n\".join(parts + [\"===== TABLE =====\"] + tables)\n    return text + (\"\\n\" if text else \"\"), len(parts) + len(tables)\n\n\ndef extract_doc(path, tmpdir):\n    soffice = shutil.which(\"soffice\") or shutil.which(\"libreoffice\")\n    if not soffice:\n        raise RuntimeError(\"缺少 soffice，无法转换 .doc\")\n    subprocess.run(\n        [soffice, \"--headless\", \"--convert-to\", \"docx\", \"--outdir\", tmpdir, path],\n        check=True, capture_output=True, timeout=300,\n    )\n    base = os.path.splitext(os.path.basename(path))[0] + \".docx\"\n    converted = os.path.join(tmpdir, base)\n    if not os.path.exists(converted):\n        raise RuntimeError(\"soffice 转换未产出 docx\")\n    return extract_docx(converted)\n\n\ndef extract_pdf(path):\n    pdftotext = shutil.which(\"pdftotext\")\n    if not pdftotext:\n        raise RuntimeError(\"缺少 pdftotext\")\n    r = subprocess.run(\n        [pdftotext, \"-enc\", \"UTF-8\", path, \"-\"],\n        check=True, capture_output=True, timeout=300,\n    )\n    text = r.stdout.decode(\"utf-8\", \"replace\")\n    return text, (text.count(\"\\f\") + 1) if text else 0\n\n\ndef collect_inputs(paths):\n    files = []\n    for p in paths:\n        if os.path.isdir(p):\n            for root, _dirs, names in os.walk(p):\n                for n in sorted(names):\n                    f = os.path.join(root, n)\n                    if os.path.splitext(n)[1].lower() in SUPPORTED:\n                        files.append(f)\n        elif os.path.isfile(p):\n            if os.path.splitext(p)[1].lower() not in SUPPORTED:\n                raise SystemExit(\"不支持的输入类型: %s\" % p)\n            files.append(p)\n        else:\n            raise SystemExit(\"输入不存在: %s\" % p)\n    return files\n\n\ndef main(argv):\n    ap = argparse.ArgumentParser(description=\"批量提取评审文档文本\")\n    ap.add_argument(\"inputs\", nargs=\"+\", help=\"输入文件或目录（可多个）\")\n    ap.add_argument(\"--out\", required=True, help=\"输出目录\")\n    args = ap.parse_args(argv)\n\n    try:\n        files = collect_inputs(args.inputs)\n    except SystemExit as e:\n        print(str(e), file=sys.stderr)\n        return 2\n    if not files:\n        print(\"未发现受支持的输入文件\", file=sys.stderr)\n        return 2\n\n    os.makedirs(args.out, exist_ok=True)\n    used_names = set()\n    records, errors = [], []\n    with tempfile.TemporaryDirectory() as tmpdir:\n        for src in files:\n            ext = os.path.splitext(src)[1].lower()\n            stem = os.path.splitext(os.path.basename(src))[0]\n            name = stem + \".txt\"\n            k = 1\n            while name in used_names:\n                k += 1\n                name = \"%s_%d.txt\" % (stem, k)\n            used_names.add(name)\n            dst = os.path.join(args.out, name)\n            try:\n                if ext == \".pptx\":\n                    text, sections = extract_pptx(src)\n                elif ext == \".docx\":\n                    text, sections = extract_docx(src)\n                elif ext == \".doc\":\n                    text, sections = extract_doc(src, tmpdir)\n                elif ext == \".pdf\":\n                    text, sections = extract_pdf(src)\n                else:\n                    with open(src, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n                        text = f.read()\n                    sections = text.count(\"\\n\")\n                with open(dst, \"w\", encoding=\"utf-8\") as f:\n                    f.write(text)\n                records.append({\n                    \"source\": os.path.basename(src), \"kind\": ext.lstrip(\".\"),\n                    \"sha256\": sha256_of(src), \"bytes\": os.path.getsize(src),\n                    \"sections\": sections, \"chars\": len(text), \"output\": name,\n                })\n            except Exception as e:  # 记录后继续处理其余文件\n                msg = \"提取失败 %s: %s\" % (os.path.basename(src), e)\n                print(msg, file=sys.stderr)\n                errors.append({\"source\": os.path.basename(src), \"error\": str(e)})\n\n    index = {\"files\": records, \"errors\": errors}\n    with open(os.path.join(args.out, \"index.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(index, f, ensure_ascii=False, indent=1)\n    print(json.dumps({\"extracted\": len(records), \"errors\": len(errors)}, ensure_ascii=False))\n    return 3 if errors else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"批量提取评审文档文本（pptx/docx/doc/pdf/md/txt -> 每文件一个 .txt + index.json）。\n\n用法（原样可执行）:\n  python3 extract_texts.py <输入文件或目录...> --out <输出目录>\n\n行为:\n- 目录会被递归展开，仅处理受支持扩展名；同目录同名输出自动加序号，不覆盖。\n- .pptx: python-pptx，递归组合形状/表格/备注，按 SLIDE 分节。\n- .docx: python-docx 段落+表格。\n- .doc:  先用 soffice --headless 转 docx（需镜像内有 soffice），再按 docx 提取。\n- .pdf:  pdftotext（需镜像内有 pdftotext）。\n- .md/.txt: 原文直读。\n- 输出: <输出目录>/<源名>.txt 与 index.json（含源 sha256、字节数、节数、字符数、错误记录）。\n- 退出码: 0 全部成功; 2 用法错误; 3 有文件提取失败（错误同时写入 index.json 与 stderr）。\n不联网、不写输入目录；输出目录不存在会自动创建。\n\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\n\nSUPPORTED = {\".pptx\", \".docx\", \".doc\", \".pdf\", \".md\", \".txt\"}\n\n\ndef sha256_of(path):\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        for chunk in iter(lambda: f.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef _walk_shapes(shapes):\n    for sh in shapes:\n        try:\n            if sh.shape_type == 6:  # GROUP\n                yield from _walk_shapes(sh.shapes)\n                continue\n        except Exception:\n            pass\n        yield sh\n\n\ndef extract_pptx(path):\n    from pptx import Presentation\n\n    prs = Presentation(path)\n    sections = []\n    for i, slide in enumerate(prs.slides, 1):\n        parts = []\n        for sh in _walk_shapes(slide.shapes):\n            try:\n                if getattr(sh, \"has_table\", False) and sh.has_table:\n                    for row in sh.table.rows:\n                        cells = [c.text.strip() for c in row.cells]\n                        line = \" | \".join(c for c in cells if c)\n                        if line:\n                            parts.append(line)\n                    continue\n                if sh.has_text_frame:\n                    tx = sh.text_frame.text.strip()\n                    if tx:\n                        parts.append(tx)\n            except Exception:\n                continue\n        if slide.has_notes_slide:\n            try:\n                nt = slide.notes_slide.notes_text_frame.text.strip()\n                if nt:\n                    parts.append(\"[备注] \" + nt)\n            except Exception:\n                pass\n        sections.append(\"===== SLIDE %d =====\\n%s\" % (i, \"\\n\".join(parts)))\n    return \"\\n\\n\".join(sections) + (\"\\n\" if sections else \"\"), len(sections)\n\n\ndef extract_docx(path):\n    import docx\n\n    d = docx.Document(path)\n    parts = []\n    for p in d.paragraphs:\n        t = p.text.strip()\n        if t:\n            parts.append(t)\n    tables = []\n    for tb in d.tables:\n        for row in tb.rows:\n            cells = [c.text.strip() for c in row.cells]\n            line = \" | \".join(c for c in cells if c)\n            if line:\n                tables.append(line)\n    text = \"\\n\".join(parts + [\"===== TABLE =====\"] + tables)\n    return text + (\"\\n\" if text else \"\"), len(parts) + len(tables)\n\n\ndef extract_doc(path, tmpdir):\n    soffice = shutil.which(\"soffice\") or shutil.which(\"libreoffice\")\n    if not soffice:\n        raise RuntimeError(\"缺少 soffice，无法转换 .doc\")\n    subprocess.run(\n        [soffice, \"--headless\", \"--convert-to\", \"docx\", \"--outdir\", tmpdir, path],\n        check=True, capture_output=True, timeout=300,\n    )\n    base = os.path.splitext(os.path.basename(path))[0] + \".docx\"\n    converted = os.path.join(tmpdir, base)\n    if not os.path.exists(converted):\n        raise RuntimeError(\"soffice 转换未产出 docx\")\n    return extract_docx(converted)\n\n\ndef extract_pdf(path):\n    pdftotext = shutil.which(\"pdftotext\")\n    if not pdftotext:\n        raise RuntimeError(\"缺少 pdftotext\")\n    r = subprocess.run(\n        [pdftotext, \"-enc\", \"UTF-8\", path, \"-\"],\n        check=True, capture_output=True, timeout=300,\n    )\n    text = r.stdout.decode(\"utf-8\", \"replace\")\n    return text, (text.count(\"\\f\") + 1) if text else 0\n\n\ndef collect_inputs(paths):\n    files = []\n    for p in paths:\n        if os.path.isdir(p):\n            for root, _dirs, names in os.walk(p):\n                for n in sorted(names):\n                    f = os.path.join(root, n)\n                    if os.path.splitext(n)[1].lower() in SUPPORTED:\n                        files.append(f)\n        elif os.path.isfile(p):\n            if os.path.splitext(p)[1].lower() not in SUPPORTED:\n                raise SystemExit(\"不支持的输入类型: %s\" % p)\n            files.append(p)\n        else:\n            raise SystemExit(\"输入不存在: %s\" % p)\n    return files\n\n\ndef main(argv):\n    ap = argparse.ArgumentParser(description=\"批量提取评审文档文本\")\n    ap.add_argument(\"inputs\", nargs=\"+\", help=\"输入文件或目录（可多个）\")\n    ap.add_argument(\"--out\", required=True, help=\"输出目录\")\n    args = ap.parse_args(argv)\n\n    try:\n        files = collect_inputs(args.inputs)\n    except SystemExit as e:\n        print(str(e), file=sys.stderr)\n        return 2\n    if not files:\n        print(\"未发现受支持的输入文件\", file=sys.stderr)\n        return 2\n\n    os.makedirs(args.out, exist_ok=True)\n    used_names = set()\n    records, errors = [], []\n    with tempfile.TemporaryDirectory() as tmpdir:\n        for src in files:\n            ext = os.path.splitext(src)[1].lower()\n            stem = os.path.splitext(os.path.basename(src))[0]\n            name = stem + \".txt\"\n            k = 1\n            while name in used_names:\n                k += 1\n                name = \"%s_%d.txt\" % (stem, k)\n            used_names.add(name)\n            dst = os.path.join(args.out, name)\n            try:\n                if ext == \".pptx\":\n                    text, sections = extract_pptx(src)\n                elif ext == \".docx\":\n                    text, sections = extract_docx(src)\n                elif ext == \".doc\":\n                    text, sections = extract_doc(src, tmpdir)\n                elif ext == \".pdf\":\n                    text, sections = extract_pdf(src)\n                else:\n                    with open(src, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n                        text = f.read()\n                    sections = text.count(\"\\n\")\n                with open(dst, \"w\", encoding=\"utf-8\") as f:\n                    f.write(text)\n                records.append({\n                    \"source\": os.path.basename(src), \"kind\": ext.lstrip(\".\"),\n                    \"sha256\": sha256_of(src), \"bytes\": os.path.getsize(src),\n                    \"sections\": sections, \"chars\": len(text), \"output\": name,\n                })\n            except Exception as e:  # 记录后继续处理其余文件\n                msg = \"提取失败 %s: %s\" % (os.path.basename(src), e)\n                print(msg, file=sys.stderr)\n                errors.append({\"source\": os.path.basename(src), \"error\": str(e)})\n\n    index = {\"files\": records, \"errors\": errors}\n    with open(os.path.join(args.out, \"index.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(index, f, ensure_ascii=False, indent=1)\n    print(json.dumps({\"extracted\": len(records), \"errors\": len(errors)}, ensure_ascii=False))\n    return 3 if errors else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n"}, "isError": false, "timestamp": 1792570438582, "__openclaw": {"runId": "38adbab5-bee5-48fc-95d9-a78aac672e4f"}}}
