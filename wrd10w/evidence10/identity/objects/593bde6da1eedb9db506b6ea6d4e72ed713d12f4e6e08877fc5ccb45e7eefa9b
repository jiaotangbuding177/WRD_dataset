\"w:eastAsia\"), FONT)\n    p.paragraph_format.space_after = Pt(space_after)\n    return p\n\n\ndef main(argv):\n    ap = argparse.ArgumentParser(description=\"装配一页一项目评审打印稿\")\n    ap.add_argument(\"--details\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--ranks\")\n    args = ap.parse_args(argv)\n\n    try:\n        with open(args.details, \"r\", encoding=\"utf-8\") as f:\n            details = json.load(f)\n    except Exception as e:  # noqa: BLE001\n        print(\"details 读取失败: %s\" % e, file=sys.stderr)\n        return 2\n    projects = details.get(\"projects\")\n    if not projects or not isinstance(projects, list):\n        print(\"details.projects 必须是非空数组\", file=sys.stderr)\n        return 2\n    for p in projects:\n        if not isinstance(p, dict) or not p.get(\"name\"):\n            print(\"details.projects[].name 必填\", file=sys.stderr)\n            return 2\n\n    by_name = {p[\"name\"]: p for p in projects}\n    ranked = None\n    if args.ranks:\n        try:\n            ranked = load_ranks(args.ranks)\n        except Exception as e:  # noqa: BLE001\n            print(\"ranks 读取失败: %s\" % e, file=sys.stderr)\n            return 2\n    if ranked:\n        missing = [r[\"name\"] for r in ranked if r[\"name\"] not in by_name]\n        if missing:\n            print(\"ranks 中项目在 details 中缺失: %s\" % \",\".join(missing), file=sys.stderr)\n            return 2\n        seq = [(i + 1, r[\"name\"], by_name[r[\"name\"]], r) for i, r in enumerate(ranked)]\n    else:\n        seq = [(i + 1, p[\"name\"], p, None) for i, p in enumerate(projects)]\n\n    doc = Document()\n    set_style(doc)\n    if details.get(\"title\"):\n        add_para(doc, details[\"title\"], bold=True, size=12, space_after=4)\n        doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)\n\n    for idx, (pos, name, proj, rk) in enumerate(seq):\n        n_total = len(seq)\n        add_para(doc, \"第%d位 ｜ 项目%d/%d ｜ %s\" % (pos, idx + 1, n_total, name), bold=True, size=10.5)\n        info = \"负责人：%s\" % proj.get(\"owner\", \"—\")\n        if proj.get(\"affiliation\"):\n            info += \"（%s）\" % proj[\"affiliation\"]\n        if rk:\n            info += \" ｜ 名次合计：%s\" % rk[\"total\"]\n        add_para(doc, info)\n        if rk and rk[\"ranks\"]:\n            add_para(doc, \"维度名次（1=最优）：%s\" % \" ｜ \".join(\n                \"%s %s\" % (dm, v) for dm, v in rk[\"ranks\"].items()))\n        if proj.get(\"comment\"):\n            add_para(doc, \"【点评】%s\" % proj[\"comment\"])\n        qs = proj.get(\"questions\") or []\n        if qs:\n            add_para(doc, \"【拟现场提问】\", bold=True)\n            for i, q in enumerate(qs, 1):\n                add_para(doc, \"%d. %s\" % (i, q))\n        sg = proj.get(\"suggestions\") or []\n        if sg:\n            add_para(doc, \"【申报书修改建议】\", bold=True)\n            for i, s in enumerate(sg, 1):\n                add_para(doc, \"%d. %s\" % (i, s))\n        add_para(doc, \"现场记录：＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿\")\n        if idx < n_total - 1 or details.get(\"title\"):\n            doc.add_paragraph().add_run().add_break(WD_BREAK.PAGE)\n\n    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)\n    doc.save(args.out)\n    print(json.dumps({\"pages\": len(seq), \"projects\": len(seq), \"out\": args.out}, ensure_ascii=False))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n"}, "isError": false, "timestamp": 1792570445312, "__openclaw": {"runId": "38adbab5-bee5-48fc-95d9-a78aac672e4f"}}}
