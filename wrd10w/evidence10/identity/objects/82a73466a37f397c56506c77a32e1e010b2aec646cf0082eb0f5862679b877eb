#!/usr/bin/env python3
"""Batch resume PDF text extraction for JD-resume screening.

Usage:
  python {SKILL}/scripts/extract_resumes.py <path> [<path> ...] --out <profiles.json>

Each <path> is a directory (scanned non-recursively for *.pdf, name-sorted) or a
single .pdf file. Requires PDFs with an extractable text layer; scanned or
garbled-font resumes are flagged, not OCR-ed.

Output JSON schema (resume-text-extraction-v1):
  inputs[]   : {path, file_name, sha256}
  profiles[] : {file_name, source_path, sha256, pages, text_chars, cjk_chars,
                text_quality, text}
text_quality: "clean" when cjk_chars >= 50, else "low_text_or_garbled"
(meaning: no reliable text layer; needs OCR, which this program does not do).

Exit codes: 0 = success (including zero profiles when no PDF found);
2 = usage error, missing path, or unreadable/invalid PDF (stderr names the file).
Paths must not overlap; duplicate paths are skipped by resolved path.
"""
import argparse
import hashlib
import json
import logging
import sys
from pathlib import Path

import pypdf

logging.getLogger("pypdf").setLevel(logging.ERROR)


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def collect_pdfs(paths):
    seen = set()
    pdfs = []
    for raw in paths:
        p = Path(raw)
        if not p.exists():
            raise FileNotFoundError(f"input path does not exist: {raw}")
        if p.is_dir():
            files = sorted(x for x in p.iterdir() if x.is_file() and x.suffix.lower() == ".pdf")
        elif p.suffix.lower() == ".pdf":
            files = [p]
        else:
            files = []
        for f in files:
            key = str(f.resolve())
            if key not in seen:
                seen.add(key)
                pdfs.append(f)
    return pdfs


def extract_one(pdf: Path) -> dict:
    try:
        reader = pypdf.PdfReader(str(pdf))
        pages = [(page.extract_text() or "") for page in reader.pages]
    except Exception as exc:
        raise ValueError(f"{pdf}: not a valid PDF or unreadable ({type(exc).__name__})") from exc
    text = "\n".join(pages)
    cjk = sum(1 for ch in text if "\u4e00" <= ch <= "\u9fff")
    return {
        "file_name": pdf.name,
        "source_path": str(pdf),
        "sha256": sha256_file(pdf),
        "pages": len(pages),
        "text_chars": len(text),
        "cjk_chars": cjk,
        "text_quality": "clean" if cjk >= 50 else "low_text_or_garbled",
        "text": text,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Batch resume PDF text extraction")
    parser.add_argument("inputs", nargs="+", help="directories or .pdf files")
    parser.add_argument("--out", required=True, help="output JSON path")
    args = parser.parse_args()

    try:
        pdfs = collect_pdfs(args.inputs)
    except (FileNotFoundError, NotADirectoryError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    profiles = []
    for pdf in pdfs:
        try:
            profiles.append(extract_one(pdf))
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2

    result = {
        "schema": "resume-text-extraction-v1",
        "inputs": [
            {
                "path": str(p),
                "kind": "file" if p.suffix.lower() == ".pdf" else "dir",
                **({"sha256": sha256_file(p)} if p.is_file() else {}),
            }
            for p in map(Path, args.inputs)
        ],
        "profiles": profiles,
    }
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=1)
    print(f"extracted {len(profiles)} resume(s) -> {out}")
    flagged = [p["file_name"] for p in profiles if p["text_quality"] != "clean"]
    if flagged:
        print(
            "low_text_or_garbled (needs OCR, not extracted reliably): " + "; ".join(flagged),
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
