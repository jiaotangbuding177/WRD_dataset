{"type": "message", "id": "d6dbe350-044d-43d2-8b55-bede0ef41feb", "parentId": "772ff7a6-81e7-4dbe-8309-b22793801f2e", "timestamp": "2026-10-21T07:56:26.467Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call8bf162532ae54f4384fab546c12c8683", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"名次矩阵配平与校验（排序制评分：每个维度列 1..N 各用一次、无并列）。\n\n用法（原样可执行）:\n  python3 rank_matrix.py solve --in <输入json> --out <输出csv路径>\n  python3 rank_matrix.py verify --in <矩阵csv>\n\nsolve 输入 json 形状:\n  {\"projects\":[{\"name\":\"甲\"},{\"name\":\"乙\"}],          # N>=2 个项目\n   \"dimensions\":[\"匹配度\",\"校企\"],                     # K>=1 个维度\n   \"target_order\":[\"甲\",\"乙\"],                        # 综合推荐顺序（最优在前）\n   \"prior\":{\"甲\":{\"匹配度\":1}}}                      # 可选：已有名次草稿，求解尽量贴近\n\nsolve 行为: 确定性局部搜索（逐维交换名次），目标=先满足综合顺序与名次合计严格递增，\n再最小化与 prior 的偏差；无 prior 时从\"名次=目标位置\"出发。输出:\n  <out>.csv  表头 项目,<各维度>,合计，按合计升序（=target_order）\n  <out>.json {\"n\",\"dimensions\",\"order\",\"sums\",\"verified\"}\nstdout 同步打印该 json。退出码: 0 成功; 2 用法错误; 3 输入不合法; 4 未找到满足约束的解。\n\nverify 行为: 校验每列是否恰为 1..N 的排列（无重复无缺号），并给出合计与隐含顺序；\nstdout 打印 {\"verified\":true,...}；违规时 exit 3，stderr 说明具体列与违规值。\n\"\"\"\nimport argparse\nimport csv\nimport json\nimport sys\n\n\ndef load_solve_input(path):\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        d = json.load(f)\n    names = [p[\"name\"] for p in d[\"projects\"]]\n    dims = list(d[\"dimensions\"])\n    order = list(d[\"target_order\"])\n    prior = d.get(\"prior\") or {}\n    if len(set(names)) != len(names) or not names:\n        raise ValueError(\"projects.name 必须非空且唯一\")\n    if sorted(order) != sorted(names):\n        raise ValueError(\"target_order 必须是全部项目名的排列\")\n    if not dims:\n        raise ValueError(\"dimensions 不能为空\")\n    return names, dims, order, prior\n\n\ndef is_order_ok(sums, order):\n    seq = sorted(sums, key=lambda n: sums[n])\n    vals = [sums[n] for n in order]\n    return seq == order and all(vals[i] < vals[i + 1] for i in range(len(vals) - 1))\n\n\ndef total_dist(matrix, prior, names, dims):\n    s = 0\n    for n in names:\n        for dm in dims:\n            p = prior.get(n, {}).get(dm)\n            if isinstance(p, int):\n                s += abs(matrix[dm][n] - p)\n    return s\n\n\ndef solve(names, dims, order, prior, max_rounds=20000):\n    n = len(names)\n    # 初始：无 prior 的维度用 名次=目标位置；有 prior 的维度优先用 prior 值\n    matrix = {}\n    for dm in dims:\n        col = {}\n        for i, nm in enumerate(order):\n            col[nm] = i + 1\n        matrix[dm] = col\n    for dm in dims:\n        vals = {}\n        ok = True\n        for nm in names:\n            v = prior.get(nm, {}).get(dm)\n            if not isinstance(v, int) or not (1 <= v <= n):\n                ok = False\n                break\n            vals[nm] = v\n        if ok and sorted(vals.values()) == list(range(1, n + 1)):\n            matrix[dm] = vals\n\n    def sums_of(m):\n        return {nm: sum(m[dm][nm] for dm in dims) for nm in names}\n\n    sums = sums_of(matrix)\n    dist = total_dist(matrix, prior, names, dims)\n    for _ in range(max_rounds):\n        improved = False\n        for dm in dims:\n            for i in range(n):\n                for j in range(i + 1, n):\n                    a, b = names[i], names[j]\n                    matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n                    s2 = sums_of(matrix)\n                    d2 = total_dist(matrix, prior, names, dims)\n                    better = (is_order_ok(s2, order) and not is_order_ok(sums, order)) or (\n                        is_order_ok(s2, order) == is_order_ok(sums, order) and d2 < dist\n                    )\n                    if better:\n                        sums, dist, improved = s2, d2, True\n                    else:\n                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n        if not improved and is_order_ok(sums, order):\n            break\n        if not improved:\n            break\n    if not is_order_ok(sums, order):\n        raise LookupError(\"未找到满足约束的名次配置；可调整 prior 或分批给出 target_order\")\n    return matrix, sums\n\n\ndef cmd_solve(args):\n    try:\n        names, dims, order, prior = load_solve_input(args.inp)\n    except Exception as e:  # noqa: BLE001\n        print(\"输入不合法: %s\" % e, file=sys.stderr)\n        return 3\n    try:\n        matrix, sums = solve(names, dims, order, prior)\n    except LookupError as e:\n        print(str(e), file=sys.stderr)\n        return 4\n    rows = sorted(names, key=lambda nm: sums[nm])\n    if args.out.endswith(\".csv\"):\n        csv_path, json_path = args.out, args.out[:-4] + \".json\"\n    else:\n        csv_path, json_path = args.out + \".csv\", args.out + \".json\"\n    with open(csv_path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n        w = csv.writer(f)\n        w.writerow([\"项目\"] + dims + [\"合计\"])\n        for nm in rows:\n            w.writerow([nm] + [matrix[dm][nm] for dm in dims] + [sums[nm]])\n    result = {\n        \"n\": len(names), \"dimensions\": dims, \"order\": rows,\n        \"sums\": {nm: sums[nm] for nm in rows}, \"verified\": True,\n    }\n    with open(json_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(result, f, ensure_ascii=False, indent=1)\n    print(json.dumps(result, ensure_ascii=False))\n    return 0\n\n\ndef cmd_verify(args):\n    try:\n        with open(args.inp, \"r\", encoding=\"utf-8-sig\") as f:\n            rows = list(csv.reader(f))\n    except Exception as e:  # noqa: BLE001\n        print(\"无法读取 %s: %s\" % (args.inp, e), file=sys.stderr)\n        return 3\n    if len(rows) < 2:\n        print(\"矩阵至少要有表头与一行数据\", file=sys.stderr)\n        return 3\n    header = rows[0]\n    if len(header) < 3 or header[0] != \"项目\" or header[-1] != \"合计\":\n        print(\"表头必须是 项目,<维度...>,合计\", file=sys.stderr)\n        return 3\n    dims = header[1:-1]\n    names, table = [], {dm: [] for dm in dims}\n    for r in rows[1:]:\n        if not r or not r[0].strip():\n            continue\n        if len(r) != len(header):\n            print(\"行 %r 列数与表头不一致\" % r, file=sys.stderr)\n            return 3\n        names.append(r[0])\n        for dm, cell in zip(dims, r[1:-1]):\n            try:\n                table[dm].append(int(cell))\n            except ValueError:\n                print(\"维度 %s 含非整数名次: %r\" % (dm, cell), file=sys.stderr)\n                return 3\n    n = len(names)\\n    for dm in dims:\n        col = table[dm]\n        if sorted(col) != list(range(1, n + 1)):\n            print(\"维度 %s 不是 1..%d 的排列（有重复或缺号）: %s\" % (dm, n, col), file=sys.stderr)\n            return 3\n    sums = {nm: sum(table[dm][i] for dm in dims) for i, nm in enumerate(names)}\n    order = sorted(names, key=lambda nm: sums[nm])\n    strict = all(sums[order[i]] < sums[order[i + 1]] for i in range(len(order) - 1))\n    result = {\n        \"verified\": True, \"n\": n, \"dimensions\": dims, \"order\": order,\n        \"sums\": {nm: sums[nm] for nm in order}, \"strict_order\": strict,\n    }\n    print(json.dumps(result, ensure_ascii=False))\n    return 0\n\n\ndef main(argv):\n    ap = argparse.ArgumentParser(description=\"名次矩阵配平与校验\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    p1 = sub.add_parser(\"solve\", help=\"按目标顺序配平各维名次\")\n    p1.add_argument(\"--in\", dest=\"inp\", required=True)\n    p1.add_argument(\"--out\", required=True)\n    p2 = sub.add_parser(\"verify\", help=\"校验名次矩阵 csv\")\n    p2.add_argument(\"--in\", dest=\"inp\", required=True)\n    args = ap.parse_args(argv)\n    if args.cmd == \"solve\":\n        return cmd_solve(args)\n    return cmd_verify(args)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n", "path": "/workspace/outputs/candidate/skill/scripts/rank_matrix.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost"