m][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n                        s2 = sums_of(matrix)\n                        v2 = violation(s2, order)\n                        d2 = total_dist(matrix, prior, names, dims)\n                        if (v2, d2) < (viol, dist):\n                            sums, viol, dist, improved = s2, v2, d2, True\n                        else:\n                            matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n            if not improved:\n                break\n        if viol != 0:\n            continue\n        # 阶段二：在 viol==0 约束内进一步贴近 prior\n        for _ in range(max_rounds):\n            improved = False\n            for dm in dims:\n                for i in range(n):\n                    for j in range(i + 1, n):\n                        a, b = names[i], names[j]\n                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n                        s2 = sums_of(matrix)\n                        if violation(s2, order) == 0:\n                            d2 = total_dist(matrix, prior, names, dims)\n                            if d2 < dist:\n                                sums, dist, improved = s2, d2, True\n                                continue\n                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]\n            if not improved:\n                break\n        cand = (dist, mode, {dm: dict(matrix[dm]) for dm in dims}, sums)\n        if best is None or cand[0] < best[0]:\n            best = cand\n    if best is None:\n        raise LookupError(\"未找到满足约束的名次配置；可调整 prior 或分批给出 target_order\")\n    _dist, _mode, matrix, sums = best\n    return matrix, sums\n\n\n'''\ns=s.replace(old,new)\nopen(p,'w').write(s)\nprint('patched')\nEOF\npython3 -m py_compile /workspace/outputs/candidate/skill/scripts/rank_matrix.py && echo COMPILE_OK\nSK=/workspace/outputs/candidate/skill/scripts; FX=/workspace/outputs/reproduction_inputs; OUT=/workspace/outputs/tmp/replay\nLOG=/wo