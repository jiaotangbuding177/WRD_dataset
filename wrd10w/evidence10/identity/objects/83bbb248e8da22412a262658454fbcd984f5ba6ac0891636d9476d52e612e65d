#!/usr/bin/env python3
"""名次矩阵配平与校验（排序制评分：每个维度列 1..N 各用一次、无并列）。

用法（原样可执行）:
  python3 rank_matrix.py solve --in <输入json> --out <输出csv路径>
  python3 rank_matrix.py verify --in <矩阵csv>

solve 输入 json 形状:
  {"projects":[{"name":"甲"},{"name":"乙"}],          # N>=2 个项目
   "dimensions":["匹配度","校企"],                     # K>=1 个维度
   "target_order":["甲","乙"],                        # 综合推荐顺序（最优在前）
   "prior":{"甲":{"匹配度":1}}}                      # 可选：已有名次草稿，求解尽量贴近

solve 行为: 确定性局部搜索（逐维交换名次），目标=先满足综合顺序与名次合计严格递增，
再最小化与 prior 的偏差；无 prior 时从"名次=目标位置"出发。输出:
  <out>.csv  表头 项目,<各维度>,合计，按合计升序（=target_order）
  <out>.json {"n","dimensions","order","sums","verified"}
stdout 同步打印该 json。退出码: 0 成功; 2 用法错误; 3 输入不合法; 4 未找到满足约束的解。

verify 行为: 校验每列是否恰为 1..N 的排列（无重复无缺号），并给出合计与隐含顺序；
stdout 打印 {"verified":true,...}；违规时 exit 3，stderr 说明具体列与违规值。
"""
import argparse
import csv
import json
import sys


def load_solve_input(path):
    with open(path, "r", encoding="utf-8") as f:
        d = json.load(f)
    names = [p["name"] for p in d["projects"]]
    dims = list(d["dimensions"])
    order = list(d["target_order"])
    prior = d.get("prior") or {}
    if len(set(names)) != len(names) or not names:
        raise ValueError("projects.name 必须非空且唯一")
    if sorted(order) != sorted(names):
        raise ValueError("target_order 必须是全部项目名的排列")
    if not dims:
        raise ValueError("dimensions 不能为空")
    return names, dims, order, prior


def is_order_ok(sums, order):
    seq = sorted(sums, key=lambda n: sums[n])
    vals = [sums[n] for n in order]
    return seq == order and all(vals[i] < vals[i + 1] for i in range(len(vals) - 1))


def violation(sums, order):
    # 与 target_order 的偏离量（位置偏差和）+ 并列惩罚
    pos = {nm: i for i, nm in enumerate(order)}
    seq = sorted(sums, key=lambda n: (sums[n], pos[n]))
    v = sum(abs(pos[nm] - i) for i, nm in enumerate(seq))
    for i in range(len(seq) - 1):
        if sums[seq[i]] == sums[seq[i + 1]]:
            v += len(sums)
    return v


def total_dist(matrix, prior, names, dims):
    s = 0
    for n in names:
        for dm in dims:
            p = prior.get(n, {}).get(dm)
            if isinstance(p, int):
                s += abs(matrix[dm][n] - p)
    return s


def solve(names, dims, order, prior, max_rounds=20000):
    n = len(names)

    def start_from(mode):
        m = {}
        for dm in dims:
            if mode == "target":
                m[dm] = {nm: i + 1 for i, nm in enumerate(order)}
            else:  # prior
                vals = {}
                for nm in names:
                    v = prior.get(nm, {}).get(dm)
                    vals[nm] = v if isinstance(v, int) and 1 <= v <= n else None
                if sorted(x for x in vals.values() if x is not None) != list(range(1, n + 1)):
                    m[dm] = {nm: i + 1 for i, nm in enumerate(order)}
                else:
                    m[dm] = vals
        return m

    def sums_of(m):
        return {nm: sum(m[dm][nm] for dm in dims) for nm in names}

    best = None
    for mode in ("prior", "target"):
        matrix = start_from(mode)
        sums = sums_of(matrix)
        viol = violation(sums, order)
        dist = total_dist(matrix, prior, names, dims)
        # 阶段一：最小化 (viol, dist)
        for _ in range(max_rounds):
            improved = False
            for dm in dims:
                for i in range(n):
                    for j in range(i + 1, n):
                        a, b = names[i], names[j]
                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]
                        s2 = sums_of(matrix)
                        v2 = violation(s2, order)
                        d2 = total_dist(matrix, prior, names, dims)
                        if (v2, d2) < (viol, dist):
                            sums, viol, dist, improved = s2, v2, d2, True
                        else:
                            matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]
            if not improved:
                break
        if viol != 0:
            continue
        # 阶段二：在 viol==0 约束内进一步贴近 prior
        for _ in range(max_rounds):
            improved = False
            for dm in dims:
                for i in range(n):
                    for j in range(i + 1, n):
                        a, b = names[i], names[j]
                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]
                        s2 = sums_of(matrix)
                        if violation(s2, order) == 0:
                            d2 = total_dist(matrix, prior, names, dims)
                            if d2 < dist:
                                sums, dist, improved = s2, d2, True
                                continue
                        matrix[dm][a], matrix[dm][b] = matrix[dm][b], matrix[dm][a]
            if not improved:
                break
        cand = (dist, mode, {dm: dict(matrix[dm]) for dm in dims}, sums)
        if best is None or cand[0] < best[0]:
            best = cand
    if best is None:
        raise LookupError("未找到满足约束的名次配置；可调整 prior 或分批给出 target_order")
    _dist, _mode, matrix, sums = best
    return matrix, sums


def cmd_solve(args):
    try:
        names, dims, order, prior = load_solve_input(args.inp)
    except Exception as e:  # noqa: BLE001
        print("输入不合法: %s" % e, file=sys.stderr)
        return 3
    try:
        matrix, sums = solve(names, dims, order, prior)
    except LookupError as e:
        print(str(e), file=sys.stderr)
        return 4
    rows = sorted(names, key=lambda nm: sums[nm])
    if args.out.endswith(".csv"):
        csv_path, json_path = args.out, args.out[:-4] + ".json"
    else:
        csv_path, json_path = args.out + ".csv", args.out + ".json"
    with open(csv_path, "w", encoding="utf-8", newline="") as f:
        w = csv.writer(f)
        w.writerow(["项目"] + dims + ["合计"])
        for nm in rows:
            w.writerow([nm] + [matrix[dm][nm] for dm in dims] + [sums[nm]])
    result = {
        "n": len(names), "dimensions": dims, "order": rows,
        "sums": {nm: sums[nm] for nm in rows}, "verified": True,
    }
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=1)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def cmd_verify(args):
    try:
        with open(args.inp, "r", encoding="utf-8-sig") as f:
            rows = list(csv.reader(f))
    except Exception as e:  # noqa: BLE001
        print("无法读取 %s: %s" % (args.inp, e), file=sys.stderr)
        return 3
    if len(rows) < 2:
        print("矩阵至少要有表头与一行数据", file=sys.stderr)
        return 3
    header = rows[0]
    if len(header) < 3 or header[0] != "项目" or header[-1] != "合计":
        print("表头必须是 项目,<维度...>,合计", file=sys.stderr)
        return 3
    dims = header[1:-1]
    names, table = [], {dm: [] for dm in dims}
    for r in rows[1:]:
        if not r or not r[0].strip():
            continue
        if len(r) != len(header):
            print("行 %r 列数与表头不一致" % r, file=sys.stderr)
            return 3
        names.append(r[0])
        for dm, cell in zip(dims, r[1:-1]):
            try:
                table[dm].append(int(cell))
            except ValueError:
                print("维度 %s 含非整数名次: %r" % (dm, cell), file=sys.stderr)
                return 3
    n = len(names)
    for dm in dims:
        col = table[dm]
        if sorted(col) != list(range(1, n + 1)):
            print("维度 %s 不是 1..%d 的排列（有重复或缺号）: %s" % (dm, n, col), file=sys.stderr)
            return 3
    sums = {nm: sum(table[dm][i] for dm in dims) for i, nm in enumerate(names)}
    order = sorted(names, key=lambda nm: sums[nm])
    strict = all(sums[order[i]] < sums[order[i + 1]] for i in range(len(order) - 1))
    result = {
        "verified": True, "n": n, "dimensions": dims, "order": order,
        "sums": {nm: sums[nm] for nm in order}, "strict_order": strict,
    }
    print(json.dumps(result, ensure_ascii=False))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description="名次矩阵配平与校验")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p1 = sub.add_parser("solve", help="按目标顺序配平各维名次")
    p1.add_argument("--in", dest="inp", required=True)
    p1.add_argument("--out", required=True)
    p2 = sub.add_parser("verify", help="校验名次矩阵 csv")
    p2.add_argument("--in", dest="inp", required=True)
    args = ap.parse_args(argv)
    if args.cmd == "solve":
        return cmd_solve(args)
    return cmd_verify(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
