ading(p)\n        if heading:\n            headings += 1\n        has_runs = False\n        for run in p.runs:\n            has_runs = True\n            set_run_fonts(run, args.cn_font, args.western_font)\n            if not heading:\n                run.font.size = Pt(args.body_size)\n        if has_runs:\n            styled += 1\n        p.paragraph_format.line_spacing = args.line_spacing\n        if not heading and args.first_line_indent > 0 and p.text.strip():\n            set_first_line_indent_chars(p, args.first_line_indent)\n\n    out_dir = os.path.dirname(os.path.abspath(args.out))\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n    doc.save(args.out)\n\n    report = {\n        \"cn_font\": args.cn_font,\n        \"western_font\": args.western_font,\n        \"body_size_pt\": int(args.body_size) if args.body_size == int(args.body_size) else args.body_size,\n        \"line_spacing\": args.line_spacing,\n        \"first_line_indent_chars\": args.first_line_indent,\n        \"remove_stars\": bool(args.remove_stars),\n        \"paragraphs_total\": total,\n        \"paragraphs_styled\": styled,\n        \"headings_kept_size\": headings,\n        \"stars_removed\": stars,\n        \"paragraph_texts\": [p.text for p in doc.paragraphs],\n    }\n    print(json.dumps(report, ensure_ascii=False))\n    if args.report:\n        rep_dir = os.path.dirname(os.path.abspath(args.report))\n        if rep_dir:\n            os.makedirs(rep_dir, exist_ok=True)\n        with open(args.report, \"w\", encoding=\"utf-8\") as f:\n            json.dump(report, f, ensure_ascii=False, indent=2)\n            f.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"Apply meeting-minutes formatting to a .docx document.\n\nSets per-run Chinese font (w:eastAsia), western/digit font (w:ascii/hAnsi/cs),\nbody font size, 1.5x line spacing, and char-based first-line indent. Hea