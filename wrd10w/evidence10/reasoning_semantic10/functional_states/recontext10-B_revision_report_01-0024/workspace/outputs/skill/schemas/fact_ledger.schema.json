{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wrd-fact-ledger-v1",
  "title": "通用事实/目标/约束账本 schema",
  "description": "制作成稿前先建账本：把用户素材拆成带出处的事实条目。fact_type 区分用户陈述/规划目标/明确要求/新假设；planned_goal 永远不得在成稿中被声明为已实现事实。explicit_user 与 must_keep 区分：素材中用户明确给出 ≠ 用户明确要求成稿逐字必保；压缩覆盖策略属派生规则（derived_rules，basis=derived_policy_not_explicit_user），不得冒充 explicit_user。",
  "type": "object",
  "required": ["schema", "ledger_id", "facts"],
  "properties": {
    "schema": {"const": "wrd-fact-ledger-v1"},
    "ledger_id": {"type": "string"},
    "sources": {
      "type": "array",
      "description": "可选内嵌源文本（也可经 CLI --sources 单独传入）。原文全量保留，缺件不虚构。",
      "items": {
        "type": "object",
        "required": ["source_id", "messages"],
        "properties": {
          "source_id": {"type": "string"},
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["message_id", "content"],
              "properties": {
                "message_id": {"type": "string"},
                "role": {"type": "string"},
                "content": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_id", "fact_type", "evidence_refs"],
        "properties": {
          "fact_id": {"type": "string"},
          "fact_type": {
            "enum": ["user_statement", "planned_goal", "explicit_requirement", "new_assumption"],
            "description": "user_statement=用户陈述（未独立核实）；planned_goal=规划/预计/目标口径；explicit_requirement=用户对成稿的明确要求；new_assumption=制作者新假设（成稿中必须显式标注）。"
          },
          "claim": {"type": "string", "description": "一句话陈述该事实内容"},
          "value": {"type": ["string", "null"], "description": "核心数值，字符串形式；一条事实一个核心数值，多数值拆多条"},
          "unit": {"type": ["string", "null"]},
          "time": {"type": ["string", "null"]},
          "subject": {"type": ["string", "null"], "description": "数值所属主体/口径"},
          "qualifiers": {"type": ["string", "null"], "description": "限定语，如 约/实测显示/预计/底线"},
          "explicit_user": {"type": "boolean", "description": "素材中用户明确给出的内容"},
          "must_keep": {
            "type": "boolean",
            "description": "仅当用户明确要求成稿必保时为 true。用户提到某事实 ≠ 必须逐字保留全部细节；不得把全部细节升级为 must_keep。"
          },
          "evidence_refs": {
            "type": "array",
            "description": "逐字引用出处。user_statement/planned_goal/explicit_requirement 必须非空。任何嵌套字段（如 task_switches）中的 evidence_refs 也会被校验器递归检查。",
            "items": {
              "type": "object",
              "required": ["source_id", "message_id", "quote"],
              "properties": {
                "source_id": {"type": "string"},
                "message_id": {"type": "string"},
                "quote": {"type": "string", "description": "必须是该源消息内容的连续原文子串，逐字不改"}
              }
            }
          },
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "derived_rules": {
      "type": "array",
      "description": "制作者派生的覆盖/压缩策略，必须声明 basis=derived_policy_not_explicit_user。",
      "items": {
        "type": "object",
        "required": ["rule_id", "description", "basis"],
        "properties": {
          "rule_id": {"type": "string"},
          "description": {"type": "string"},
          "basis": {"const": "derived_policy_not_explicit_user"},
          "evidence_refs": {"type": "array"}
        }
      }
    }
  }
}
