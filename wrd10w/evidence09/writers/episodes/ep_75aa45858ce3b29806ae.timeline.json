        "arguments": {
          "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>太阳系教学演示 — 八大行星公转</title>\n<style>\n  :root{\n    --bg:#0b1026;\n    --panel:rgba(255,255,255,.06);\n    --text:#eaf0ff;\n    --muted:#9fb0d8;\n    --accent:#f7c948;\n  }\n  *{box-sizing:border-box;margin:0;padding:0;}\n  body{\n    background:radial-gradient(ellipse at 50% 35%, #17224a 0%, #0b1026 55%, #060917 100%);\n    color:var(--text);\n    font-family:\"Noto Sans CJK SC\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;\n    min-height:100vh;\n    overflow-x:hidden;\n  }\n  header{\n    text-align:center;\n    padding:22px 16px 10px;\n  }\n  header h1{\n    font-size:28px;\n    letter-spacing:2px;\n    color:var(--accent);\n    text-shadow:0 0 18px rgba(247,201,72,.35);\n  }\n  header p{\n    color:var(--muted);\n    font-size:14px;\n    margin-top:6px;\n  }\n  .stage-wrap{\n    position:relative;\n    width:min(920px,96vw);\n    margin:10px auto 0;\n  }\n  #stage{\n    display:block;\n    width:100%;\n    height:auto;\n    background:transparent;\n    border-radius:14px;\n  }\n  .controls{\n    display:flex;\n    flex-wrap:wrap;\n    gap:12px;\n    justify-content:center;\n    align-items:center;\n    margin:14px auto 4px;\n    padding:12px 16px;\n    width:min(920px,96vw);\n    background:var(--panel);\n    border-radius:12px;\n  }\n  .controls label{\n    font-size:14px;\n    color:var(--muted);\n    display:flex;\n    align-items:center;\n    gap:8px;\n  }\n  .controls input[type=range]{width:160px;accent-color:var(--accent);}\n  .controls button{\n    background:rgba(247,201,72,.15);\n    border:1px solid rgba(247,201,72,.5);\n    color:var(--accent);\n    padding:7px 16px;\n    border-radius:8px;\n    font-size:14px;\n    cursor:pointer;\n  }\n  .controls button:hover{background:rgba(247,201,72,.3);}\n  .info{\n    width:min(920px,96vw);\n    margin:14px auto 30px;\n    background:var(--panel);\n    border-radius:12px;\n    padding:16px 20px;\n  }\n  .info h2{\n    font-size:18px;\n    color:var(--accent);\n    margin-bottom:10px;\n  }\n  .info .tip{\n    color:var(--muted);\n    font-size:14px;\n    margin-bottom:12px;\n  }\n  table{\n    width:100%;\n    border-collapse:collapse;\n    font-size:14px;\n  }\n  th,td{\n    padding:8px 10px;\n    text-align:left;\n    border-bottom:1px solid rgba(255,255,255,.08);\n  }\n  th{color:var(--accent);font-weight:600;white-space:nowrap;}\n  td .dot{\n    display:inline-block;\n    width:12px;height:12px;\n    border-radius:50%;\n    margin-right:8px;\n    vertical-align:middle;\n  }\n  .note{\n    margin-top:14px;\n    padding:10px 14px;\n    background:rgba(255,255,255,.04);\n    border-left:3px solid var(--accent);\n    font-size:13px;\n    color:var(--muted);\n    line-height:1.7;\n  }\n  footer{\n    text-align:center;\n    color:var(--muted);\n    font-size:12px;\n    padding:0 16px 24px;\n  }\n  .star{position:fixed;background:#fff;border-radius:50%;pointer-events:none;opacity:.7;}\n</style>\n</head>\n<body>\n<header>\n  <h1>太阳系教学演示</h1>\n  <p>八大行星绕太阳公转动画 · 适用于课堂演示（示意图，天体大小与距离未按真实比例）</p>\n</header>\n\n<div class=\"stage-wrap\">\n  <canvas id=\"stage\" width=\"1840\" height=\"1100\"></canvas>\n</div>\n\n<div class=\"controls\">\n  <button id=\"btnToggle\">暂停 / 继续</button>\n  <label>速度 <input id=\"speed\" type=\"range\" min=\"0.2\" max=\"4\" step=\"0.1\" value=\"1\"></label>\n  <label><input id=\"orbits\" type=\"checkbox\" checked> 显示轨道线</label>\n  <label><input id=\"labels\" type=\"checkbox\" checked> 显示行星名称</label>\n</div>\n\n<div class=\"info\">\n  <h2>八大行星基本信息（通用教学常识）</h2>\n  <p class=\"tip\">点击上方画布中的行星，可在此处高亮显示该行星；距离数值为与太阳的平均距离（天文单位 AU，1 AU ≈ 1.5 亿千米）。</p>\n  <table>\n    <thead>\n      <tr>\n        <th>行星</th><th>位置（由近到远）</th><th>平均距离</th><th>公转周期（约）</th><th>类型</th><th>教学要点</th>\n      </tr>\n    </thead>\n    <tbody id=\"tbody\"></tbody>\n  </table>\n  <div class=\"note\">\n    <strong>页面说明（未指定模块按通用默认处理）：</strong><br>\n    1. 本页为单文件 HTML，所有样式与脚本均内联，浏览器直接打开即可运行，无需后端或外部数据；<br>\n    2. 行星公转动画为教学示意：行星大小、间距与公转速度均<strong>未按真实比例</strong>，仅体现“由近到远、由快到慢”的相对顺序关系（水星最快、海王星最慢）；<br>\n    3. 表中数据取通用的教学常识数值（四舍五入），本页不虚构具体数据来源，精确数据请查阅教材或权威天文资料；<br>\n    4. 默认动画速度 1×，可通过滑块调节；轨道线与行星名称默认显示，可勾选关闭；<br>\n    5. 页面未指定视觉主题，默认采用深色星空课堂演示风格；背景星星为纯装饰元素。\n  </div>\n</div>\n\n<footer>太阳系教学演示页 · 课堂使用 · 内容为通用教学常识</footer>\n\n<script>\n(function(){\n  \"use strict\";\n  // 行星数据：radius=画面像素大小(示意), orbit=轨道半径(画面像素,示意),\n  // period=公转周期(地球年,真实相对值用于速度排序), color=示意色\n  var planets = [\n    {name:\"水星\", en:\"Mercury\", r:6,  orbit:70,  period:0.24, color:\"#b8b0a6\", dist:\"0.39 AU\", type:\"类地行星\", year:\"88 天\",   fact:\"离太阳最近、体积最小，表面昼夜温差极大\"},\n    {name:\"金星\", en:\"Venus\",   r:9,  orbit:110, period:0.62, color:\"#e8c46b\", dist:\"0.72 AU\", type:\"类地行星\", year:\"225 天\",  fact:\"天空中最亮的行星，被称为“启明星”\"},\n    {name:\"地球\", en:\"Earth\",   r:10, orbit:150, period:1.0,  color:\"#4a90d9\", dist:\"1.00 AU\", type:\"类地行星\", year:\"365 天\",  fact:\"目前已知唯一存在生命的行星，有一颗卫星——月球\"},\n    {name:\"火星\", en:\"Mars\",    r:8,  orbit:190, period:1.88, color:\"#d9603b\", dist:\"1.52 AU\", type:\"类地行星\", year:\"687 天\",  fact:\"表面呈红色（氧化铁），被称为“红色星球”\"},\n    {name:\"木星\", en:\"Jupiter\", r:20, orbit:260, period:11.9, color:\"#d8a86a\", dist:\"5.20 AU\", type:\"气态巨行星\", year:\"约 12 年\", fact:\"八大行星中体积、质量最大，有著名的大红斑风暴\"},\n    {name:\"土星\", en:\"Saturn\",  r:17, orbit:330, period:29.5, color:\"#e3cf9a\", dist:\"9.58 AU\", type:\"气态巨行星\", year:\"约 29 年\", fact:\"拥有壮观的行星环，主要由冰粒与岩石碎块构成\"},\n    {name:\"天王星\", en:\"Uranus\", r:13, orbit:395, period:84,   color:\"#8fd4d9\", dist:\"19.2 AU\", type:\"冰巨星\",  year:\"约 84 年\", fact:\"自转轴几乎“躺倒”，像在轨道上滚动前进\"},\n    {name:\"海王星\", en:\"Neptune\",r:13, orbit:455, period:165,  color:\"#4f6fd9\", dist:\"30.1 AU\", type:\"冰巨星\",  year:\"约 165 年\", fact:\"离太阳最远的行星，风速在行星中最快\"}\n  ];\n\n  var canvas = document.getElementById(\"stage\");\n  var ctx = canvas.getContext(\"2d\");\n  var W = canvas.width, H = canvas.height;\n  var CX = W/2, CY = H/2;\n\n  var running = true;\n  var speed = 1;\n  var showOrbits = true;\n  var showLabels = true;\n  var selected = -1;\n  var t = 0;              // 动画时间（年）\n  var lastTs = null;\n\n  // 角速度 ∝ 1/period（开普勒式示意：内快外慢）\n  planets.forEach(function(p){ p.angle = Math.random()*Math.PI*2; });\n\n  // 背景装饰星星（固定随机种子，避免闪烁变化）\n  var stars = [];\n  var seed = 42;\n  function rnd(){ seed = (seed*16807)%2147483647; return seed/2147483647; }\n  for(var i=0;i<120;i++){\n    stars.push({x:rnd()*W, y:rnd()*H, r:rnd()*1.8+0.4, a:rnd()*0.5+0.3});\n  }\n\n  function draw(){\n    ctx.clearRect(0,0,W,H);\n\n    // 装饰星星\n    stars.forEach(function(s){\n      ctx.globalAlpha = s.a;\n      ctx.fillStyle = \"#fff\";\n      ctx.beginPath();\n      ctx.arc(s.x,s.y,s.r,0,Math.PI*2);\n      ctx.fill();\n    });\n    ctx.globalAlpha = 1;\n\n    // 轨道线\n    if(showOrbits){\n      planets.forEach(function(p){\n        ctx.strokeStyle = (planets.indexOf(p)===selected) ? \"rgba(247,201,72,.55)\" : \"rgba(255,255,255,.13)\";\n        ctx.lineWidth = (planets.indexOf(p)===selected) ? 2.5 : 1.2;\n        ctx.beginPath();\n        ctx.arc(CX,CY,p.orbit,0,Math.PI*2);\n        ctx.stroke();\n      });\n    }\n\n    // 太阳\n    var sunGrad = ctx.createRadialGradient(CX,CY,4,CX,CY,46);\n    sunGrad.addColorStop(0,\"#fff3b0\");\n    sunGrad.addColorStop(0.45,\"#f7c948\");\n    sunGrad.addColorStop(1,\"rgba(247,150,50,0)\");\n    ctx.fillStyle = sunGrad;\n    ctx.beginPath();\n    ctx.arc(CX,CY,46,0,Math.PI*2);\n    ctx.fill();\n    ctx.fillStyle = \"#ffd94d\";\n    ctx.beginPath();\n    ctx.arc(CX,CY,26,0,Math.PI*2);\n    ctx.fill();\n    ctx.fillStyle = \"#7a5a12\";\n    ctx.font = \"600 18px 'Noto Sans CJK SC',sans-serif\";\n    ctx.textAlign = \"center\";\n    ctx.fillText(\"太阳\", CX, CY+62);\n\n    // 行星\n    planets.forEach(function(p,idx){\n      var x = CX + p.orbit*Math.cos(p.angle);\n      var y = CY + p.orbit*Math.sin(p.angle)*0.92; // 轻微椭圆，避免超出画布\n      p.x = x; p.y = y;\n\n      // 光晕\n      var g = ctx.createRadialGradient(x,y,p.r*0.6,x,y,p.r*2.4);\n      g.addColorStop(0,\"rgba(255,255,255,.28)\");\n      g.addColorStop(1,\"rgba(255,255,255,0)\");\n      ctx.fillStyle = g;\n      ctx.beginPath();\n      ctx.arc(x,y,p.r*2.4,0,Math.PI*2);\n      ctx.fill();\n\n      // 土星环（示意）\n      if(p.name===\"土星\"){\n        ctx.save();\n        ctx.translate(x,y);\n        ctx.rotate(-0.35);\n        ctx.strokeStyle = \"rgba(227,207,154,.75)\";\n        ctx.lineWidth = 3;\n        ctx.beginPath();\n        ctx.ellipse(0,0,p.r*2.1,p.r*0.7,0,0,Math.PI*2);\n        ctx.stroke();\n        ctx.restore();\n      }\n\n      // 本体\n      ctx.fillStyle = p.color;\n      if(idx===selected){\n        ctx.shadowColor = \"#f7c948\";\n        ctx.shadowBlur = 18;\n      }\n      ctx.beginPath();\n      ctx.arc(x,y,p.r,0,Math.PI*2);\n      ctx.fill();\n      ctx.shadowBlur = 0;\n\n      // 名称标签\n      if(showLabels){\n        ctx.fillStyle = (idx===selected) ? \"#f7c948\" : \"#cdd8f5\";\n        ctx.font = \"16px 'Noto Sans CJK SC',sans-serif\";\n        ctx.textAlign = \"center\";\n        ctx.fillText(p.name, x, y - p.r - 10);\n      }\n    });\n  }\n\n  function frame(ts){\n    if(lastTs===null) lastTs = ts;\n    var dt = (ts - lastTs)/1000;\n    lastTs = ts;\n    if(running){\n      t += dt*speed;\n      planets.forEach(function(p){\n        p.angle += dt*speed*(Math.PI*2/p.period)/12; // 除以12：整体放慢便于课堂观察\n      });\n    }\n    draw();\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n\n  // 控件\n  document.getElementById(\"btnToggle\").addEventListener(\"click\",function(){\n    running = !running;\n  });\n  document.getElementById(\"speed\").addEventListener(\"input\",function(e){\n    speed = parseFloat(e.target.value);\n  });\n  document.getElementById(\"orbits\").addEventListener(\"change\",function(e){\n    showOrbits = e.target.checked;\n  });\n  document.getElementById(\"labels\").addEventListener(\"change\",function(e){\n    showLabels = e.target.checked;\n  });\n\n  // 点击行星高亮 + 表格滚动提示\n  function canvasPos(evt){\n    var rect = canvas.getBoundingClientRect();\n    var px = (evt.touches ? evt.touches[0].clientX : evt.clientX) - rect.left;\n    var py = (evt.touches ? evt.touches[0].clientY : evt.clientY) - rect.top;\n    return { x: px * (W/rect.width), y: py * (H/rect.height) };\n  }\n  function pick(pos){\n    for(var i=0;i<planets.length;i++){\n      var p = planets[i];\n      if(p.x!=null && Math.hypot(pos.x-p.x, pos.y-p.y) <= Math.max(p.r+12,18)){\n        return i;\n      }\n    }\n    return -1;\n  }\n  canvas.addEventListener(\"click\",function(evt){\n    var pos = canvasPos(evt);\n    selected = pick(pos);\n    var rows = document.querySelectorAll(\"#tbody tr\");\n    rows.forEach(function(tr,i){\n      tr.style.background = (i===selected) ? \"rgba(247,201,72,.14)\" : \"\";\n    });\n  });\n\n  // 填充表格\n  var tbody = document.getElementById(\"tbody\");\n  planets.forEach(function(p,idx){\n    var tr = document.createElement(\"tr\");\n    tr.innerHTML =\n      '<td><span class=\"dot\" style=\"background:'+p.color+'\"></span>'+p.name+'（'+p.en+'）</td>'+\n      '<td>第 '+(idx+1)+' 位</td>'+\n      '<td>'+p.dist+'</td>'+\n      '<td>'+p.year+'</td>'+\n      '<td>'+p.type+'</td>'+\n      '<td>'+p.fact+'</td>';\n    tbody.appendChild(tr);\n  });\n})();\n</script>\n</body>\n</html>\n",
