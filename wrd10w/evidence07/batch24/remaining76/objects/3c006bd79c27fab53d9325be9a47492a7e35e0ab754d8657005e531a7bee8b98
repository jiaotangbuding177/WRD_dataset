#!/usr/bin/env python3
"""检查 xlsx/xls 工作簿结构：每个 sheet 的合并单元格、非空单元格内容、公式标记、数字格式。
用途：读模板「填报须知」、识别合计行(公式)与明细行(要填的叶子行)、读源报表数据。

用法:
  python3 inspect_xlsx.py <文件1.xlsx> [文件2.xls ...]

输出到 stdout，逐文件逐 sheet。.xls 旧格式自动经 LibreOffice 转成 xlsx 后读取。
退出码: 0 成功; 2 输入/用法错误。
"""
import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

from openpyxl import load_workbook


def to_xlsx_if_needed(path: Path, tmpdir: Path) -> Path:
    """旧 .xls 转 xlsx（openpyxl 不支持读 .xls）。"""
    if path.suffix.lower() != ".xls":
        return path
    outdir = tmpdir / "xls_conv"
    outdir.mkdir(exist_ok=True)
    cmd = ["soffice", "--headless", "--norestore", "--convert-to", "xlsx",
           "--outdir", str(outdir), str(path)]
    try:
        subprocess.run(cmd, check=True, capture_output=True, timeout=180)
    except (subprocess.SubprocessError, OSError) as e:
        raise SystemExit("无法用 soffice 转换 %s: %s" % (path, e))
    conv = outdir / (path.stem + ".xlsx")
    if not conv.exists():
        raise SystemExit("soffice 转换 %s 未产出文件" % path)
    return conv


def fmt_tag(cell) -> str:
    tags = []
    if cell.data_type == "f" or (isinstance(cell.value, str) and cell.value.startswith("=")):
        tags.append("F")
    nf = cell.number_format
    if nf and nf != "General":
        tags.append("fmt:%s" % nf)
    return "[%s]" % ",".join(tags) if tags else ""


def dump(path: Path) -> None:
    print("=" * 20, "文件:", path.name, "=" * 20)
    wb = load_workbook(path, data_only=False)
    for ws in wb.worksheets:
        print("\n--- Sheet: %s （%s） ---" % (ws.title, ws.dimensions))
        if ws.merged_cells.ranges:
            print("合并单元格:", ", ".join(str(r) for r in ws.merged_cells.ranges))
        for row in ws.iter_rows():
            cells = []
            for c in row:
                if c.value is None:
                    continue
                v = str(c.value)
                if len(v) > 60:
                    v = v[:57] + "..."
                cells.append("%s: %s %s" % (c.coordinate, v, fmt_tag(c)))
            if cells:
                print("  " + " | ".join(cells))


def main(argv):
    ap = argparse.ArgumentParser(description="检查工作簿结构（详见模块docstring）")
    ap.add_argument("files", nargs="+", help="xlsx/xls 文件（可多个）")
    args = ap.parse_args(argv)
    paths = [Path(f) for f in args.files]
    for p in paths:
        if not p.is_file():
            print("文件不存在: %s" % p, file=sys.stderr)
            return 2
    with tempfile.TemporaryDirectory() as td:
        tmpdir = Path(td)
        for p in paths:
            dump(to_xlsx_if_needed(p, tmpdir))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
