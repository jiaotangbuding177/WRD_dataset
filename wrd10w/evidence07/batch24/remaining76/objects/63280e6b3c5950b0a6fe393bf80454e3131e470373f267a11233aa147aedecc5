{"type": "message", "id": "b257c9df-d210-47f0-a906-1dac4de14d5d", "parentId": "7b741553-d9ad-4923-8c35-8a4417454f36", "timestamp": "2026-10-24T03:48:32.181Z", "message": {"role": "toolResult", "toolCallId": "call8463856951bd4cf49727bc423d7a2b4f", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"把补写段落插入 docx 指定位置，继承邻段格式并去除高亮，写回新文件。\n\n用法（原样可执行）:\n  python3 backfill_apply.py <原文档.docx> (--insert-after \"锚点段文本子串\" |\n      --insert-before \"锚点段文本子串\") --text-file <补充段落.txt> --out <输出.docx>\n      [--copy-format-from \"格式基准段文本子串\"] [--clear-highlight] [--drop-empty-after]\n\n行为:\n- 锚点段 = 正文文本包含锚点子串的段落（须恰好命中一段，多个或零个报错）。\n  --insert-after：新段落逐个插到锚点段之后；--insert-before：插到锚点段之前\n  （用于表格之后/下一节标题之前的章节级插入：锚定下一节标题，新段落落表后正文区）。\n  --text-file 每个非空行 = 一个新段落。\n- 格式默认继承锚点段的 pPr；指定 --copy-format-from 时改从该段复制 pPr 与首个文字 run\n  的 rPr（如锚点是标题而正文格式应以相邻正文段为准）。\n- --drop-empty-after：after 模式删除锚点段之后紧连的空白占位段；before 模式删除锚点段\n  之前紧连的空白占位段（标记空缺的空段，可多个）。\n- --clear-highlight：去掉锚点段及上述紧连空白段内所有 w:highlight（清理标记空缺的黄底）。\n  新段落 run 一律不带高亮。被删空白段内挂着的批注锚点（commentRange/commentReference）\n  自动移入首个（before 模式为最后一个）插入段落，批注不丢锚；其余批注/修订原样保留。\n- 写出后自校验：XML 可解析、逐行核对插入文本已存在，失败退出 2 并删除坏输出。\n\n退出码: 0 成功; 1 参数/定位错误（输出文件不动）; 2 写出后自校验失败。\n\"\"\"\nimport argparse\nimport re\nimport sys\nimport zipfile\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\n\nP_RE = re.compile(r\"<w:p(?:\\s[^>]*)?(?:/>|>.*?</w:p>)\", re.S)\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(\"&apos;\", \"'\"))\n\n\ndef escape(text):\n    return (text.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n                .replace('\"', \"&quot;\"))\n\n\ndef para_text(p_xml):\n    return unescape(\"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p_xml, re.S)))\n\n\ndef find_paragraph(xml, needle):\n    \"\"\"返回正文文本包含 needle 的唯一段落 span；0 或多个命中时报错返回 None。\"\"\"\n    hits = [m for m in P_RE.finditer(xml) if needle in para_text(m.group(0))]\n    if not hits:\n        return None, \"no paragraph contains anchor text: %r\" % needle\n    if len(hits) > 1:\n        texts = [para_text(m.group(0))[:60] for m in hits]\n        return None, \"anchor matches %d paragraphs, extend the text to be unique: %s\" % (len(hits), texts)\n    return hits[0], None\n\n\ndef trailing_empty_spans(xml, anchor_end):\n    \"\"\"锚点段之后紧连的空白占位段 span 列表（遇非空段即停）。\"\"\"\n    spans = []\n    pos = anchor_end\n    while True:\n        m = P_RE.match(xml, pos)\n        if not m or para_text(m.group(0)).strip():\n            break\n        spans.append(m.span())\n        pos = m.end()\n    return spans\n\n\ndef leading_empty_spans(xml, anchor_start):\n    \"\"\"锚点段之前紧连的空白占位段 span 列表（遇非空段即停，向前扫）。\"\"\"\n    spans = []\n    pos = anchor_start\n    while True:\n        prev = None\n        for m in P_RE.finditer(xml):\n            if m.end() == pos:\n                prev = m\n                break\n            if m.end() > pos:\n                break\n        if prev is None or para_text(prev.group(0)).strip():\n            break\n        spans.append(prev.span())\n        pos = prev.start()\n    return spans\n\n\nCOMMENT_MARK_RE = re.compile(\n    r\"<w:commentRange(?:Start|End)\\b[^>]*/>\"\n    r\"|<w:r\\b[^>]*>(?:(?!</w:r>).)*?<w:commentReference\\b[^>]*/>(?:(?!</w:r>).)*?</w:r>\",\n    re.S)\n\n\ndef extract_comment_markers(xml_fragment):\n    \"\"\"取出被删空段里的批注锚点（commentRange 与 commentReference run）。\"\"\"\n    return COMMENT_MARK_RE.findall(xml_fragment)\n\n\ndef strip_highlight(xml):\n    return re.sub(r\"<w:highlight\\b[^>]*/>\", \"\", xml)\n\n\ndef copy_format(xml, span):\n    \"\"\"取该段的 pPr 与首个文字 run 的 rPr（去高亮）。\"\"\"\n    p_xml = span.group(0)\n    m = re.search(r\"<w:pPr\\b[^>]*>.*?</w:pPr>\", p_xml, re.S)\n    ppr = strip_highlight(m.group(0)) if m else \"\"\n    rpr = \"\"\n    for run in re.finditer(r\"<w:r(?:\\s[^>]*)?>.*?</w:r>\", p_xml, r