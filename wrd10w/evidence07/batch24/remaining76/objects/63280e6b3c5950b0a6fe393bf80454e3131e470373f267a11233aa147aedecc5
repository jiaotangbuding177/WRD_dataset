{"type": "message", "id": "7bb32531-6db0-49db-bf3d-1340caf7486b", "parentId": "25ef55fd-b5f8-48b2-9919-9d1fd06c5046", "timestamp": "2026-10-24T03:48:32.083Z", "message": {"role": "toolResult", "toolCallId": "call17ac2beb496c4b6db99f70438287c52b", "toolName": "read", "content": [{"type": "text", "text": "\"\"\"Extract plain text from a .docx contract into a JSON file, with\nkeyword/window access for long documents.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> paragraph, unescape XML entities. Default mode writes {source_file,\nparagraphs, text} JSON to --out. Long documents: use --grep to print only\nmatching paragraph numbers plus a bounded text window, or --lines START-END to\nre-read a known window, instead of loading the whole text into context.\nOnly .docx is supported; scanned PDFs must be OCR'd first.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--out', help='full extraction JSON; omit when using --grep/--lines')\n    parser.add_argument('--grep', help='locate keyword: print matching paragraph numbers + bounded text windows only')\n    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')\n    parser.add_argument('--lines', help='print only paragraph range like 120-140 (1-based, inclusive)')\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph\n    # numbers drift against locate_gaps/fill_cell body indices\n    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    total = len(paragraphs)\n\n    def print_window(start, end):\n        for i in range(max(0, start - 1), min(total, end)):\n            print('p' + str(i + 1) + ': ' + paragraphs[i])\n\n    if args.lines:\n        match = re.fullmatch(r'(\\d+)-(\\d+)', args.lines.strip())\n        if not match:\n            print('extract_contract_text error: --lines expects START-END like 120-140', file=sys.stderr)\n            return 2\n        start, end = int(match.group(1)), int(match.group(2))\n        if start < 1 or end < start:\n            print('extract_contract_text error: --lines range invalid', file=sys.stderr)\n            return 2\n        print_window(start, end)\n        return 0\n    if args.grep is not None:\n        hits = [i + 1 for i, text in enumerate(paragraphs) if args.grep in text]\n        if not hits:\n            print('no match for: ' + args.grep)\n            return 1\n        width = max(0, args.context)\n        windows = []\n        for hit in hits:\n            start, end = hit - width, hit + width\n            if windows and start <= windows[-1][1] + 1:\n                windows[-1][1] = end\n            else:\n                windows.append([start, end])\n        print('total ' + str(total) + ' paragraphs; hit ' + str(len(hits)) + ': ' +\n              ', '.join(str(h) for h in hits))\n        for start, end in windows:\n            print('--- window p' + str(start) + '-p' + str(end) + ' ---')\n            print_window(start, end)\n        return 0\n    if not args.out:\n        print('extract_contract_text error: --out required without --grep/--lines', file=sys.stderr)\n        return 2\n    result = {'source_file': src.name, 'paragraphs': total, 'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(total) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "\"\"\"Extract plain text from a .docx contract into a JSON file, with\nkeyword/window access for long documents.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> paragraph, unescape XML entities. Default mode writes {source_file,\nparagraphs, text} JSON to --out. Long documents: use --grep to print only\nmatching paragraph numbers plus a bounded text window, or --lines START-END to\nre-read a known window, instead of loading the whole text into context.\nOnly .docx is supported; scanned PDFs must be OCR'd first.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--out', help='full extraction JSON; omit when using --grep/--lines')\n    parser.add_argument('--grep', help='locate keyword: print matching paragraph numbers + bounded text windows only')\n    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')\n    parser.add_argument('--lines', help='print only paragraph range like 120-140 (1-based, inclusive)')\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph\n    # numbers drift against locate_gaps/fill_cell body indices\n    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    total = len(paragraphs)\n\n    def print_window(start, end):\n        for i in range(max(0, start - 1), min(total, end)):\n            print('p' + str(i + 1) + ': ' + paragraphs[i])\n\n    if args.lines:\n        match = re.fullmatch(r'(\\d+)-(\\d+)', args.lines.strip())\n        if not match:\n            print('extract_contract_text error: --lines expects START-END like 120-140', file=sys.stderr)\n            return 2\n        start, end = int(match.group(1)), int(match.group(2))\n        if start < 1 or end < start:\n            print('extract_contract_text error: --lines range invalid', file=sys.stderr)\n            return 2\n        print_window(start, end)\n        return 0\n    if args.grep is not None:\n        hits = [i + 1 for i, text in enumerate(paragraphs) if args.grep in text]\n        if not hits:\n            print('no match for: ' + args.grep)\n            return 1\n        width = max(0, args.context)\n        windows = []\n        for hit in hits:\n            start, end = hit - width, hit + width\n            if windows and start <= windows[-1][1] + 1:\n                windows[-1][1] = end\n            else:\n                windows.append([start, end])\n        print('total ' + str(total) + ' paragraphs; hit ' + str(len(hits)) + ': ' +\n              ', '.join(str(h) for h in hits))\n        for start, end in windows:\n            print('--- window p' + str(start) + '-p' + str(end) + ' ---')\n            print_window(start, end)\n        return 0\n    if not args.out:\n        print('extract_contract_text error: --out required without --grep/--lines', file=sys.stderr)\n        return 2\n    result = {'source_file': src.name, 'paragraphs': total, 'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(total) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}, "isError": false, "timestamp": 1792813712079, "__openclaw": {"runId": "0e7df38c-36fe-4f51-a8ea-860c4d202f48"}}}
