{"type": "message", "id": "cce322fa-8ab9-4bf2-b498-ac521cb01033", "parentId": "37473df8-8976-45f4-ae18-fdc8c00f7cdf", "timestamp": "2026-10-23T04:46:58.531Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call9947fe9b94474f52956e18316642b939", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"凭据脱敏 + 接口权限闸（库 + CLI）。\n\n库用法（目标项目里直接 import 本文件即可，无第三方依赖）:\n    from redact import redact, assert_draft_only\n\n    # 异常/日志出口统一过 redact；extra 传入本进程可能持有的密钥原文做纵深抹除\n    safe = redact(str(err), extra_secrets=[os.environ.get(\"WECHAT_APP_SECRET\", \"\")])\n\n    # 请求发出前调闸：命中发布/群发类端点直接抛 PermissionError\n    assert_draft_only(url)\n\nCLI 用法:\n    python redact.py --text \"https://api.x.com/token?access_token=***\"\n    python redact.py --file err.log --redact-value \"$SOME_SECRET\" --redact-value \"$OTHER\"\n    python redact.py --check-url \"https://api.weixin.qq.com/cgi-bin/freepublish/submit\"\n\n退出码: 0 正常；3 权限闸拦截（--check-url 命中禁用端点）。\n\"\"\"\n\nimport argparse\nimport sys\nimport re\n\n# URL 查询参数与 key=value 形式里视为敏感的参数名\n_SENSITIVE_PARAM = re.compile(\n    r\"(?i)(access_token|app_?secret|secret|token|api_?key|apikey|password|passwd|auth_code|sign|appid)\"\n)\n\n# key=value / \"key\": \"value\" 形式（引号可选）\n_KV = re.compile(\n    r\"(?i)(access_token|app_?secret|secret|token|api_?key|apikey|password|passwd|auth_code)\"\n    r\"(\\s*[=:]\\s*)(['\\\"]?)([^'\\\"&\\s,;}]{4,})(\\3)\"\n)\n\n# 代码级禁用的端点片段（小写匹配）；草稿-only 闸默认拦截这些\nBLOCKED_ENDPOINTS = (\n    \"message/mass\",\n    \"mass/sendall\",\n    \"sendall\",\n    \"freepublish\",\n    \"custom/send\",\n    \"tags/message\",\n)\n\n\ndef redact(text, extra_secrets=()):\n    \"\"\"抹除 text 中的敏感参数值与 extra_secrets 原文，返回安全文本。\"\"\"\n    if text is None:\n        return \"\"\n    text = str(text)\n    # 1) key=value / \"key\": \"value\" / URL 查询参数：值替换为 ***（保留参数名，便于排错）\n    text = _KV.sub(lambda m: m.group(1) + m.group(2) + m.group(3) + \"***\" + m.group(4), text)\n    # 2) 纵深抹除：调用方提供的密钥原文，出现即整段替换，不留首尾片段\n    for s in extra_secrets:\n        if s and len(str(s)) >= 4:\n            text = text.replace(str(s), \"***\")\n    return text\n\n\ndef assert_draft_only(url):\n    \"\"\"草稿-only 闸：url 命中发布/群发类端点时抛 PermissionError。放行返回 True。\"\"\"\n    u = str(url).lower()\n    for frag in BLOCKED_ENDPOINTS:\n        if frag in u:\n            raise PermissionError(\"draft-only policy: blocked endpoint fragment '%s' in %s\" % (frag, redact(url)))\n    return True\n\n\ndef _mask_url(url):\n    \"\"\"对 URL 查询串里的敏感参数值打码（与 _KV 独立处理 ?a=b&c=d）。\"\"\"\n    def repl(m):\n        name = m.group(1)\n        return name + \"=\" + (\"***\" if _SENSITIVE_PARAM.search(name) else m.group(2))\n    return re.sub(r\"([\\w.-]+)=([^&\\s]*)\", repl, url)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"凭据脱敏与草稿-only 权限闸\")\n    ap.add_argument(\"--text\", help=\"要脱敏的文本\")\n    ap.add_argument(\"--file\", help=\"要脱敏的文件（逐行输出）\")\n    ap.add_argument(\"--redact-value\", action=\"append\", default=[], metavar=\"VALUE\", help=\"额外要抹除的密钥原文，可重复\")\n    ap.add_argument(\"--check-url\", help=\"只做权限闸检查：命中禁用端点则退出码 3\")\n    args = ap.parse_args()\n\n    if args.check_url:\n        try:\n            assert_draft_only(args.check_url)\n        except PermissionError as e:\n            print(\"BLOCKED:\", e)\n            return 3\n        print(\"ALLOWED:\", _mask_url(args.check_url))\n        return 0\n\n    if args.file:\n        with open(args.file, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            for line in f:\n                print(redact(line.rstrip(\"\\n\"), extra_secrets=args.redact_value))\n        return 0\n\n    if args.text is not None:\n        print(redact(args.text, extra_secrets=args.redact_value))\n        return 0\n\n    ap.print_help()\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "path": "/workspace/outputs/skill/scripts/redact.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"inpu