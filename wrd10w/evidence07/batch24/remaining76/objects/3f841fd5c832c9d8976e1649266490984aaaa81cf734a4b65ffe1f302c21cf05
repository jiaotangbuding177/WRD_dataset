{"type": "message", "id": "64fd513f-bfbe-42ed-8bf0-be54d7868c56", "parentId": "1a72feba-0422-4082-a3a4-13dc5ded84db", "timestamp": "2026-10-23T04:47:47.791Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call4cf3d522276048dfb3c9a93ad43ef2b7", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"就绪检测三件事（无第三方依赖，stdlib only）。\n\n用法:\n  1) 凭据泄漏点扫描（离线，不动目标文件）\n     python readiness_check.py scan <目标代码目录> [--forbid-literal STR ...] [--include-tests] [--json]\n\n  2) 公网出口 IP 检测（>=3 源取 >=2 一致才算稳定）\n     python readiness_check.py egress [--expect-ip x.x.x.x] [--json]\n\n  3) IP 白名单探测（假凭据，无需真实 AppSecret）\n     python readiness_check.py probe --token-url <token接口URL> [--json]\n     # 例: --token-url \"https://api.weixin.qq.com/cgi-bin/token?grant_type=client_credential\"\n\n退出码: scan 0=干净 1=有发现 2=用法/目录错误; egress 0=稳定且(如给定)匹配 1=不稳定/不匹配 2=全部源不可达;\n        probe 0=IP已过白名单 1=IP未过白名单 2=无法判定。\n输出永不回显密钥值：命中行统一先过 redact() 再打印。\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport urllib.request\nimport urllib.error\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom redact import redact, BLOCKED_ENDPOINTS  # noqa: E402\n\n# 检测器：CLI 密钥参数 / 输出密钥 / input 密钥 / 禁用端点\n_SECRET_NAME = re.compile(r\"(?i)(app_?secret|access_token|secret|api_?key|apikey|password|passwd|auth_code|token)\")\n_CLI_PARAM = re.compile(r\"add_argument\\(\\s*['\\\"](--[\\w-]+)['\\\"]\")\n_OUTPUT_CALL = re.compile(r\"\\b(print|logging\\.\\w+|logger\\.\\w+|sys\\.stderr\\.write|sys\\.stdout\\.write)\\s*\\(\")\n_INPUT_CALL = re.compile(r\"\\binput\\s*\\(\")\n_SKIP_LINE = re.compile(r\"\\bredact\\b|\\*\\*\\*\")  # 已脱敏/已打码的行不算发现\n\nEGRESS_SOURCES = (\n    \"https://ipinfo.io/ip\",\n    \"https://ifconfig.me/ip\",\n    \"https://api.ipify.org\",\n)\n\n# 假凭据探测的 errcode 解读（来自真实会话实测）\nPROBE_VERDICT = {\n    40164: (\"fail\", \"IP 不在公众号白名单（40164）——先加白名单，不请求凭据\"),\n    40013: (\"pass\", \"假 appid 被识别为无效（40013）——IP 已过白名单\"),\n    40125: (\"pass\", \"假 secret 被识别为无效（40125）——IP 已过白名单\"),\n}\n\n\ndef _iter_files(root, include_tests):\n    for dirpath, dirnames, filenames in os.walk(root):\n        dirnames[:] = [d for d in dirnames if d not in (\".git\", \"__pycache__\", \"node_modules\")]\n        if not include_tests and any(p in (\"tests\", \"test\") for p in dirpath[len(root):].split(os.sep)):\n            continue\n        for fn in filenames:\n            path = os.path.join(dirpath, fn)\n            try:\n                if os.path.getsize(path) > 2 * 1024 * 1024:\n                    continue\n                with open(path, \"rb\") as f:\n                    if b\"\\0\" in f.read(4096):\n                        continue\n            except OSError:\n                continue\n            yield path\n\n\ndef _findings_for_line(line):\n    \"\"\"返回该行命中的规则 id 列表。\"\"\"\n    rules = []\n    for m in _CLI_PARAM.finditer(line):\n        if _SECRET_NAME.search(m.group(1)):\n            rules.append(\"cli_secret_param\")\n    if _OUTPUT_CALL.search(line) and _SECRET_NAME.search(line) and not _SKIP_LINE.search(line):\n        rules.append(\"output_secret\")\n    if _INPUT_CALL.search(line) and _SECRET_NAME.search(line):\n        rules.append(\"input_secret\")\n    low = line.lower()\n    for frag in BLOCKED_ENDPOINTS:\n        if frag in low:\n            rules.append(\"blocked_endpoint:\" + frag)\n    return rules\n\n\ndef cmd_scan(args):\n    root = os.path.abspath(args.dir)\n    if not os.path.isdir(root):\n        print(\"ERROR: not a directory: %s\" % root)\n        return 2\n    findings = []\n    env_files = []\n    for path in _iter_files(root, args.include_tests):\n        rel = os.path.relpath(path, root)\n        if os.path.basename(path) == \".env\":\n            env_files.append(rel)  # 只报存在，绝不读内容\n            continue\n        try:\n            with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n                for i, line in enumerate(f, 1):\n                    for rule in _findings_for_line(line):\n                        findings.append({\"file\": rel, \"line\": i, \"rule\": rule,\n                                         \"context\": redact(line.strip())[:200]})\n        except OSError:\n            continue\n        for lit in args.forbid_literal:\n            if lit in open(path, \"r\", encoding=\"utf-8\", errors=\"replace\").read():\n                findings.append({\"file\": rel, \"line\": 0, \"rule\": \"forbid_literal\",\n                                 \"context\": \"字面量必须全仓库消失: %r\" % lit})\n    if args.json:\n        print(json.dumps({\"dir\": root, \"findings\": findings, \"env_files\": env_files},\n                         ensure_ascii=False, indent=2))\n    else:\n        if env_files:\n            for e in env_files:\n                print(\"ENV_FILE  %s（内容未读取；确认是否应存在/是否 chmod 600，且不入库）\" % e)\n        for fd in findings:\n            loc = \"%s:%s\" % (fd[\"file\"], fd[\"line\"] if fd[\"line\"] else \"-\")\n            print(\"%s  %s  %s\" % (fd[\"rule\"], loc, fd[\"context\"]))\n        print(\"---\")\n        print(\"findings=%d env_files=%d（tests/ 默认排除，--include-tests 开启；命中只是线索，按上下文人工判定，不盲改）\"\n              % (len(findings), len(env_files)))\n    return 1 if findings else 0\n\n\ndef _http_get(url, timeout=8):\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"curl/8.0\"})\n    with urllib.request.urlopen(req, timeout=timeout) as resp:\n        return resp.read().decode(\"utf-8\", \"replace\").strip()\n\n\ndef cmd_egress(args):\n    ips = []\n    details = []\n    for src in EGRESS_SOURCES:\n        try:\n            ip = _http_get(src)\n            ok = re.match(r\"^\\d{1,3}(\\.\\d{1,3}){3}$\", ip)\n            details.append({\"source\": src, \"ip\": ip if ok else None, \"ok\": bool(ok),\n                            \"error\": None if ok else \"bad response: %r\" % ip[:40]})\n            if ok:\n                ips.append(ip)\n        except Exception as e:  # noqa: BLE001 —— 单源失败只记录，不影响其他源\n            details.append({\"source\": src, \"ip\": None, \"ok\": False, \"error\": \"%s: %s\" % (type(e).__name__, e)})\n    stable = None\n    if ips:\n        counts = {}\n        for ip in ips:\n            counts[ip] = counts.get(ip, 0) + 1\n        best, n = max(counts.items(), key=lambda kv: kv[1])\n        if n >= 2:\n            stable = best\n    result = {\"stable\": stable, \"sources\": details}\n    if stable is None:\n        result[\"verdict\"] = \"INCONCLUSIVE\"\n        result[\"reason\"] = \"有效源不足 2 个一致（单源会抖动，不能单源下结论）\"\n        rc = 2\n    elif args.expect_ip and stable != args.expect_ip:\n        result[\"verdict\"] = \"FAIL\"\n        result[\"reason\"] = \"出口 IP 与目标不一致——立即停真实联调，标记 BLOCKED_BY_UNSTABLE_EGRESS_IP，不请求凭据\"\n        rc = 1\n    else:\n        result[\"verdict\"] = \"PASS\"\n        result[\"reason\"] = \"出口 IP 稳定\" + (\"且与目标一致\" if args.expect_ip else \"（未提供 --expect-ip，仅报稳定值）\")\n        rc = 0\n    if args.json:\n        print(json.dumps(result, ensure_ascii=False, indent=2))\n    else:\n        print(\"EGRESS_IP_STABLE:\", result[\"verdict\"], \"|\", result.get(\"reason\", \"\"))\n        for d in details:\n            print(\"  source=%s ip=%s ok=%s err=%s\" % (d[\"source\"], d[\"ip\"], d[\"ok\"], d[\"error\"]))\n        print(\"提示: 正式报告前再用独立进程跑一遍本命令，双路一致才算双路验证。\")\n    return rc\n\n\ndef cmd_probe(args):\n    url = args.token_url\n    sep = \"&\" if \"?\" in url else \"?\"\n    probe_url = \"%s%sappid=DUMMY_APPID&secret=***\" % (url, sep)\n    try:\n        body = _http_get(probe_url)\n    except Exception as e:  # noqa: BLE001\n        print(json.dumps({\"verdict\": \"inconclusive\", \"error\": \"%s: %s\" % (type(e).__name__, e)}, ensure_ascii=False))\n        return 2\n    try:\n        data = json.loads(body)\n    except ValueError:\n        data = {\"raw\": redact(body)[:200]}\n    errcode = data.get(\"errcode\")\n    verdict, reason = PROBE_VERDICT.get(errcode, (\"inconclusive\",\n        \"errcode=%s 非 40164/40013/40125，人工判读 errmsg（假凭据不应成功换取 token）\" % errcode))\n    out = {\"verdict\": verdict, \"errcode\": errcode, \"errmsg\": data.get(\"errmsg\"), \"reason\": reason,\n           \"probe_url\": redact(probe_url)}\n    print(json.dumps(out, ensure_ascii=False, indent=2))\n    return {\"pass\": 0, \"fail\": 1, \"inconclusive\": 2}[verdict]\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"凭据就绪检测（scan / egress / probe）\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    p1 = sub.add_parser(\"scan\", help=\"凭据泄漏点扫描\")\n    p1.add_argument(\"dir\")\n    p1.add_argument(\"--forbid-literal\", action=\"append\", default=[],\n                    help=\"要求全仓库不出现的字面量（如旧 CLI 密钥参数名），可重复\")\n    p1.add_argument(\"--include-tests\", action=\"store_true\", help=\"扫描 tests/ 目录（默认排除）\")\n    p1.add_argument(\"--json\", action=\"store_true\")\n    p1.set_defaults(fn=cmd_scan)\n\n    p2 = sub.add_parser(\"egress\", help=\"公网出口 IP 多源检测\")\n    p2.add_argument(\"--expect-ip\", help=\"目标固定出口 IP；不一致即 FAIL\")\n    p2.add_argument(\"--json\", action=\"store_true\")\n    p2.set_defaults(fn=cmd_egress)\n\n    p3 = sub.add_parser(\"probe\", help=\"IP 白名单探测（假凭据）\")\n    p3.add_argument(\"--token-url\", required=True, help=\"token 接口 URL（不带 appid/secret）\")\n    p3.add_argument(\"--json\", action=\"store_true\", help=argparse.SUPPRESS)\n    p3.set_defaults(fn=cmd_probe)\n\n    args = ap.parse_args()\n    sys.exit(args.fn(args))\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/readiness_check.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792730818643, "responseId": "chatcmpl-1792730818730", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "cc94f710-45fe