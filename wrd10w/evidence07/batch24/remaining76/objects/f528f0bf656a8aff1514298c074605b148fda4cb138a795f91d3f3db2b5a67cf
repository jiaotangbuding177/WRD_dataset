#!/usr/bin/env python3
"""把某个项目行拆出明细行：默认折叠隐藏，可展开全部完整显示（历史会话确认的正确形态）。

用法:
  python3 detail_group.py 汇总.xlsx --label 服务费 \
      --details "微康益生菌:30000,松淼税务咨询:4000,青岛知企邦:5000" \
      --out 输出.xlsx [--dropdown true|false]

效果（对话中两次纠偏后用户确认的形态，别再做成数据验证替换单元格值）：
- 明细行插在项目行下方，行分组折叠（行号左侧 ➕/➖），默认隐藏，展开后名称+金额全部完整显示；
- 项目行金额改为 =SUM(明细区间)，小计公式行号自动平移且因引用项目行原位不变而不破坏；
- 项目行名称/金额单元格保留数据验证下拉（仅查看辅助，不校验不弹错，--dropdown false 关闭）；
- 原件不动，结果另存 --out；退出码: 0 成功; 2 参数/文件/未找到标签行错误。
"""
import argparse
import copy as copymod
import re
import sys
from pathlib import Path

from openpyxl import load_workbook
from openpyxl.styles import Font
from openpyxl.worksheet.datavalidation import DataValidation


def shift_formulas(ws, min_row, offset):
    if offset == 0:
        return
    ref_re = re.compile(r'(\$?)([A-Z]{1,3})(\$?)(\d+)')
    for row in ws.iter_rows():
        for cell in row:
            v = cell.value
            if isinstance(v, str) and v.startswith("="):
                parts, last = [], 0
                for m in ref_re.finditer(v):
                    parts.append(v[last:m.start()])
                    r = int(m.group(4))
                    if r >= min_row:
                        r += offset
                    parts.append("%s%s%s%d" % (m.group(1), m.group(2), m.group(3), r))
                    last = m.end()
                parts.append(v[last:])
                cell.value = "".join(parts)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("file", help="汇总表 xlsx（原件不动）")
    ap.add_argument("--label", required=True, help="要拆明细的项目行名称，如 服务费")
    ap.add_argument("--details", required=True,
                    help="明细列表，逗号分隔，每项 名称:金额，如 微康益生菌:30000,松淼税务咨询:4000")
    ap.add_argument("--out", required=True, help="输出文件")
    ap.add_argument("--dropdown", default="true", help="项目行单元格是否保留查看型下拉（默认 true）")
    args = ap.parse_args()

    items = []
    for part in args.details.split(","):
        part = part.strip()
        if not part:
            continue
        name, _, amt = part.rpartition(":")
        if not name or not amt:
            print("detail_group error: 明细项格式应为 名称:金额，收到 [%s]" % part, file=sys.stderr)
            return 2
        try:
            value = float(amt)
        except ValueError:
            print("detail_group error: 金额不是数字: [%s]" % amt, file=sys.stderr)
            return 2
        items.append((name, int(value) if value == int(value) else value))
    if not items:
        print("detail_group error: --details 为空", file=sys.stderr)
        return 2
    if not Path(args.file).is_file():
        print("detail_group error: 文件不存在", file=sys.stderr)
        return 2

    wb = load_workbook(args.file)
    ws = wb.worksheets[0]

    label_cell = None
    for row in ws.iter_rows():
        for cell in row:
            if isinstance(cell.value, str) and cell.value.strip() == args.label:
                label_cell = cell
                break
        if label_cell:
            break
    if label_cell is None:
        print("detail_group error: 未找到项目行 [%s]" % args.label, file=sys.stderr)
        return 2
    row0, col0 = label_cell.row, label_cell.column
    amount_cell = ws.cell(row=row0, column=col0 + 1)

    n = len(items)
    insert_at = row0 + 1
    shift_formulas(ws, insert_at, n)
    ws.insert_rows(insert_at, n)

    for i, (name, value) in enumerate(items):
        r = insert_at + i
        for col in range(1, min(col0 + 3, ws.max_column) + 1):
            ws.cell(row=r, column=col)._style = copymod.copy(ws.cell(row=row0, column=col)._style)
        ws.cell(row=r, column=col0, value=name)
        ws.cell(row=r, column=col0 + 1, value=value)
        dim = ws.row_dimensions[r]
        dim.outline_level = 1
        dim.hidden = True

    col_l = ws.cell(row=row0, column=col0).column_letter
    col_a = amount_cell.column_letter
    amount_cell.value = "=SUM(%s%d:%s%d)" % (col_a, insert_at, col_a, insert_at + n - 1)

    if args.dropdown.lower() != "false":
        options = ",".join("%s%s" % (name, amt) for name, amt in items)
        if len(options) > 250:
            print("detail_group: 下拉选项超长，已跳过数据验证（明细仍可分组展开查看）", file=sys.stderr)
        else:
            for target in (ws.cell(row=row0, column=col0), amount_cell):
                dv = DataValidation(type="list", formula1='"%s"' % options,
                                    allow_blank=True, showErrorMessage=False)
                ws.add_data_validation(dv)
                dv.add(target)

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    wb.save(out)
    total = sum(v for _, v in items)
    print("完成: [%s](第%d行) 拆出 %d 笔明细（第%d~%d行，默认折叠），" % (args.label, row0, n, insert_at, insert_at + n - 1))
    print("金额列改为 =SUM(%s%d:%s%d)，明细合计 %.2f；原件未动，已另存 %s" % (col_a, insert_at, col_a, insert_at + n - 1, total, out))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
