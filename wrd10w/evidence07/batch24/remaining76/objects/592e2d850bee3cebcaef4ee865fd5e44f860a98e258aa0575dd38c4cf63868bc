import hashlib, json, os, shutil, subprocess, sys
from pathlib import Path

REP = Path('/workspace/outputs/reproduction_inputs')
BIND = Path('/workspace/outputs/making_records/bindings')
SH = Path('/workspace/outputs/candidate/skill')

def fresh(p):
    p = Path(p)
    if p.exists(): shutil.rmtree(p)
    p.mkdir(parents=True)
    return p

def pin(p):
    p = Path(p); raw = p.read_bytes()
    return {'path': str(p), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}

def run(name, argv):
    r = subprocess.run(argv, capture_output=True, text=True)
    print('=== CASE', name, 'exit', r.returncode)
    print('STDOUT:', r.stdout.strip()[:400])
    print('STDERR:', r.stderr.strip()[:400])
    return r

