{"type": "message", "id": "ba64e858-ef4b-4250-9e0a-951b696a5bd7", "parentId": "b5308c3c-1de6-410e-af69-7be64298777d", "timestamp": "2026-10-23T12:09:03.302Z", "message": {"role": "toolResult", "toolCallId": "callc98bf55b1c9a40e4b50e3950025f938c", "toolName": "read", "content": [{"type": "text", "text": "\"\"\"Scan a contract document (PDF/TXT/DOCX) for keywords, with context.\n\nMethod: PDF is converted to text via pdftotext (a scanned PDF yields empty\noutput and this script tells you to OCR first); .docx is parsed from the\nOOXML zip (document + headers + footers); .txt is read directly. Reports each\nkeyword occurrence with surrounding context and its line number in the\nderived text, so clause locations survive back into the source review.\n\nExit codes: 0 ok, 2 usage/input error (missing file, no keywords, empty text\nlayer, unsupported type).\n\"\"\"\nimport argparse\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef pdf_to_text(path):\n    with tempfile.NamedTemporaryFile(suffix='.txt', delete=False) as tmp:\n        tmp_path = tmp.name\n    try:\n        proc = subprocess.run(['pdftotext', str(path), tmp_path],\n                              capture_output=True, text=True)\n        if proc.returncode != 0:\n            raise ValueError('pdftotext failed: ' + proc.stderr.strip()[:200])\n        text = Path(tmp_path).read_text(encoding='utf-8', errors='replace')\n    finally:\n        Path(tmp_path).unlink(missing_ok=True)\n    if not text.strip():\n        raise ValueError('no text layer: likely a scanned PDF; OCR first '\n                         '(pdftoppm -r 300 -gray -png, then tesseract -l chi_sim)')\n    return text\n\n\ndef docx_to_text_parts(path):\n    try:\n        archive = zipfile.ZipFile(path)\n    except (OSError, zipfile.BadZipFile) as error:\n        raise ValueError('cannot open docx: ' + str(error))\n    parts = []\n    try:\n        members = sorted(n for n in archive.namelist()\n                         if re.fullmatch(r'word/(document|header\\d*|footer\\d*)\\.xml', n))\n        if not members:\n            raise ValueError('not a valid docx: no word/document.xml')\n        for member in members:\n            xml = archive.read(member).decode('utf-8')\n            lines = []\n            for paragraph in re.findall(r'<w:p[ >].*?</w:p>', xml, re.S):\n                lines.append(unescape(''.join(\n                    re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S))))\n            parts.append((member, '\\n'.join(lines)))\n    finally:\n        archive.close()\n    if not any(text.strip() for _, text in parts):\n        raise ValueError('docx has no extractable text')\n    return parts\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input', help='contract file: .pdf / .txt / .docx')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_text_keywords error: no keywords given', file=sys.stderr)\n        return 2\n    src = Path(args.input)\n    if not src.is_file():\n        print('scan_text_keywords error: input not found: ' + str(src), file=sys.stderr)\n        return 2\n    suffix = src.suffix.lower()\n    try:\n        if suffix == '.pdf':\n            parts = [('pdf-text-layer', pdf_to_text(src))]\n        elif suffix == '.txt':\n            text = src.read_text(encoding='utf-8', errors='replace')\n            if not text.strip():\n                raise ValueError('text file is empty')\n            parts = [('text', text)]\n        elif suffix == '.docx':\n            parts = docx_to_text_parts(src)\n        else:\n            raise ValueError('unsupported input type ' + suffix\n                             + ': expected .pdf / .txt / .docx')\n    except ValueError as error:\n        print('scan_text_keywords error: ' + str(error), file=sys.stderr)\n        return 2\n    hits = []\n    for member, text in parts:\n        lines = text.split('\\n')\n        for number, line in enumerate(lines, start=1):\n            for keyword in keywords:\n                start = 0\n                while True:\n                    index = line.find(keyword, start)\n                    if index < 0:\n                        break\n                    hits.append({'keyword': keyword, 'part': member, 'line': number,\n                                 'context': line.strip()[:120]})\n                    start = index + len(keyword)\n    result = {'source_file': src.name, 'keywords': keywords,\n              'parts_scanned': len(parts), 'total': len(hits), 'hits': hits}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '\n          + str(len(parts)) + ' part(s) -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "\"\"\"Scan a contract document (PDF/TXT/DOCX) for keywords, with context.\n\nMethod: PDF is converted to text via pdftotext (a scanned PDF yields empty\noutput and this script tells you to OCR first); .docx is parsed from the\nOOXML zip (document + headers + footers); .txt is read directly. Reports each\nkeyword occurrence with surrounding context and its line number in the\nderived text, so clause locations survive back into the source review.\n\nExit codes: 0 ok, 2 usage/input error (missing file, no keywords, empty text\nlayer, unsupported type).\n\"\"\"\nimport argparse\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef pdf_to_text(path):\n    with tempfile.NamedTemporaryFile(suffix='.txt', delete=False) as tmp:\n        tmp_path = tmp.name\n    try:\n        proc = subprocess.run(['pdftotext', str(path), tmp_path],\n                              capture_output=True, text=True)\n        if proc.returncode != 0:\n            raise ValueError('pdftotext failed: ' + proc.stderr.strip()[:200])\n        text = Path(tmp_path).read_text(encoding='utf-8', errors='replace')\n    finally:\n        Path(tmp_path).unlink(missing_ok=True)\n    if not text.strip():\n        raise ValueError('no text layer: likely a scanned PDF; OCR first '\n                         '(pdftoppm -r 300 -gray -png, then tesseract -l chi_sim)')\n    return text\n\n\ndef docx_to_text_parts(path):\n    try:\n        archive = zipfile.ZipFile(path)\n    except (OSError, zipfile.BadZipFile) as error:\n        raise ValueError('cannot open docx: ' + str(error))\n    parts = []\n    try:\n        members = sorted(n for n in archive.namelist()\n                         if re.fullmatch(r'word/(document|header\\d*|footer\\d*)\\.xml', n))\n        if not members:\n            raise ValueError('not a valid docx: no word/document.xml')\n        for member in members:\n            xml = archive.read(member).decode('utf-8')\n            lines = []\n            for paragraph in re.findall(r'<w:p[ >].*?</w:p>', xml, re.S):\n                lines.append(unescape(''.join(\n                    re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S))))\n            parts.append((member, '\\n'.join(lines)))\n    finally:\n        archive.close()\n    if not any(text.strip() for _, text in parts):\n        raise ValueError('docx has no extractable text')\n    return parts\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input', help='contract file: .pdf / .txt / .docx')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_text_keywords error: no keywords given', file=sys.stderr)\n        return 2\n    src = Path(args.input)\n    if not src.is_file():\n        print('scan_text_keywords error: input not found: ' + str(src), file=sys.stderr)\n        return 2\n    suffix = src.suffix.lower()\n    try:\n        if suffix == '.pdf':\n            parts = [('pdf-text-layer', pdf_to_text(src))]\n        elif suffix == '.txt':\n            text = src.read_text(encoding='utf-8', errors='replace')\n            if not text.strip():\n                raise ValueError('text file is empty')\n            parts = [('text', text)]\n        elif suffix == '.docx':\n            parts = docx_to_text_parts(src)\n        else:\n            raise ValueError('unsupported input type ' + suffix\n                             + ': expected .pdf / .txt / .docx')\n    except ValueError as error:\n        print('scan_text_keywords error: ' + str(error), file=sys.stderr)\n        return 2\n    hits = []\n    for member, text in parts:\n        lines = text.split('\\n')\n        for number, line in enumerate(lines, start=1):\n            for keyword in keywords:\n                start = 0\n                while True:\n                    index = line.find(keyword, start)\n                    if index < 0:\n                        break\n                    hits.append({'keyword': keyword, 'part': member, 'line': number,\n                                 'context': line.strip()[:120]})\n                    start = index + len(keyword)\n    result = {'source_file': src.name, 'keywords': keywords,\n              'parts_scanned': len(parts), 'total': len(hits), 'hits': hits}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '\n          + str(len(parts)) + ' part(s) -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}, "isError": false, "timestamp": 1792757343299, "__openclaw": {"runId": "4cdfcf5f-9f2b-441e-bc6c-5fee5eea211b"}}}
