#!/usr/bin/env python3
"""Parse a wjx (问卷星) questionnaire page into a structure spec JSON.

Public usage:
    python {SKILL}/scripts/parse_wjx.py <问卷URL或已保存的HTML路径> --out {OUT}/spec_raw.json [--timeout 20]

Input : wjx share page URL (https://v.wjx.cn/vm/xxx.aspx) or a locally saved HTML file.
Output: spec JSON {source, fetched_at, title, intro, questions, warnings, note}.
        questions: [{"type":"radio|checkbox|text|other","title","required","options","wjx_type"}]
        题目文案仅为结构参考；按用户新场景改写后再交给 build_questionnaire.py。
Exit  : 0 parsed >=1 questions; 1 page fetched but no questions found; 2 fetch/IO/usage error.
Errors: single-line "parse_wjx_error: ..." on stderr.
"""
from __future__ import annotations

import argparse
import html as html_mod
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

UA = (
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/124.0 Safari/537.36"
)
TYPE_MAP = {"1": "text", "3": "radio", "4": "checkbox"}
TAG_RE = re.compile(r"<[^>]+>")
WS_RE = re.compile(r"\s+")


class ParseError(Exception):
    pass


def strip_tags(raw: str) -> str:
    text = TAG_RE.sub("", raw)
    text = html_mod.unescape(text)
    return WS_RE.sub(" ", text).strip()


def load_html(source: str, timeout: int) -> str:
    if re.match(r"^https?://", source, flags=re.I):
        try:
            import requests
        except ImportError as error:
            raise ParseError(f"requests not available: {error}")
        try:
            resp = requests.get(source, headers={"User-Agent": UA}, timeout=timeout)
        except Exception as error:  # network, DNS, timeout...
            raise ParseError(f"fetch failed: {error}")
        if resp.status_code != 200:
            raise ParseError(f"fetch failed: HTTP {resp.status_code} for {source}")
        raw = resp.content
        encoding = None
        head = raw[:2048].decode("ascii", errors="ignore")
        m = re.search(r'charset=["\']?([\w-]+)', head, flags=re.I)
        if m:
            encoding = m.group(1)
        for enc in filter(None, [encoding, "utf-8"]):
            try:
                return raw.decode(enc)
            except UnicodeDecodeError:
                continue
        return raw.decode("utf-8", errors="replace")
    path = Path(source)
    if not path.is_file():
        raise ParseError(f"local file not found: {source}")
    data = path.read_bytes()
    for enc in ("utf-8", "gb18030"):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", errors="replace")


def extract_title(page: str) -> str:
    m = re.search(r"<title>(.*?)</title>", page, flags=re.I | re.S)
    if not m:
        return ""
    title = strip_tags(m.group(1))
    # wjx titles often carry a suffix like "问卷星级" noise; keep plain text as-is
    return title


def extract_intro(page: str) -> str:
    m = re.search(r'id="divDesc".*?<span class="description">(.*?)</span>', page, flags=re.I | re.S)
    return strip_tags(m.group(1)) if m else ""


def field_chunks(page: str) -> list[tuple[dict, str]]:
    """Split the page into (attrs, chunk) pairs, one per question field div."""
    starts = [
        m for m in re.finditer(r"<div class='field[^>]*topic='\d+'[^>]*>", page)
        if "field-label" not in m.group(0)
    ]
    end = page.find("</fieldset>")
    chunks = []
    for i, m in enumerate(starts):
        attrs_src = m.group(0)
        attrs = {
            k: v
            for k, v in re.findall(r"([\w-]+)='([^']*)'", attrs_src)
        }
        if "topic" not in attrs:
            continue
        chunk_end = starts[i + 1].start() if i + 1 < len(starts) else (end if end != -1 else len(page))
        chunks.append((attrs, page[m.start():chunk_end]))
    return chunks


def parse_question(attrs: dict, chunk: str) -> dict:
    wjx_type = attrs.get("type", "")
    qtype = TYPE_MAP.get(wjx_type, "other")
    m = re.search(r"<div class='topichtml'>(.*?)</div>", chunk, flags=re.S)
    title = re.sub(r"<span class='qtypetip'>.*?</span>", "", m.group(1), flags=re.S) if m else ""
    title = strip_tags(title)
    title = re.sub(r"^\d+、", "", title).strip()
    required = attrs.get("req", "0") == "1" and "选填" not in title
    options = [strip_tags(o) for o in re.findall(r"<div class='label'[^>]*>(.*?)</div>", chunk, flags=re.S)]
    if not options:
        options = [strip_tags(o) for o in re.findall(r'<div class="label"[^>]*>(.*?)</div>', chunk, flags=re.S)]
    question = {"type": qtype, "title": title, "required": required}
    if qtype in ("radio", "checkbox"):
        question["options"] = options
    if qtype == "text":
        placeholder = re.search(r"placeholder='([^']*)'", chunk)
        if placeholder:
            question["placeholder"] = html_mod.unescape(placeholder.group(1))
    maxsel = re.search(r"maxsel='(\d+)'", chunk)
    if qtype == "checkbox" and maxsel:
        question["max"] = int(maxsel.group(1))
    if qtype == "other":
        question["wjx_type"] = wjx_type
        if options:
            question["options"] = options
    return question


def main() -> int:
    parser = argparse.ArgumentParser(description="Parse a wjx questionnaire page into a structure spec.")
    parser.add_argument("source", help="wjx page URL or locally saved HTML file")
    parser.add_argument("--out", required=True, help="path of the spec JSON to write")
    parser.add_argument("--timeout", type=int, default=20, help="fetch timeout seconds for URLs")
    args = parser.parse_args()
    try:
        page = load_html(args.source, args.timeout)
        title = extract_title(page)
        intro = extract_intro(page)
        chunks = field_chunks(page)
        questions = [parse_question(attrs, chunk) for attrs, chunk in chunks]
        warnings = []
        for idx, q in enumerate(questions, 1):
            if q["type"] == "other":
                warnings.append(f"Q{idx}: 未识别的问卷星题型 type={q.get('wjx_type')}，需人工转换成 radio/checkbox/text")
            elif q["type"] in ("radio", "checkbox") and len(q.get("options", [])) < 2:
                warnings.append(f"Q{idx}: 选项少于2个，解析可能不完整")
            elif q["type"] in ("radio", "checkbox") and not q.get("options"):
                warnings.append(f"Q{idx}: 未解析到选项")
        if not questions:
            warnings.append("页面中未找到任何题目（可能不是问卷页、问卷已停止或需要登录）")
        spec = {
            "source": args.source,
            "fetched_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "title": title,
            "intro": intro,
            "questions": questions,
            "warnings": warnings,
            "note": "题目文案仅为结构参考；按用户新场景改写 title/options 后另存 spec 再运行 build_questionnaire.py",
        }
        try:
            with open(args.out, "w", encoding="utf-8") as handle:
                json.dump(spec, handle, ensure_ascii=False, indent=2)
        except OSError as error:
            raise ParseError(f"cannot write output: {error}")
    except ParseError as error:
        print(f"parse_wjx_error: {error}", file=sys.stderr)
        return 2
    if not questions:
        print("parse_wjx_warning: 0 questions parsed; see warnings in output", file=sys.stderr)
        return 1
    print(f"parsed {len(questions)} questions -> {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
