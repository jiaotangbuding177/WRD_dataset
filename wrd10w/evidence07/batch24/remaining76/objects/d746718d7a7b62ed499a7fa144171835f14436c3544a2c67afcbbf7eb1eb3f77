#!/usr/bin/env python3
"""Structural self-check for a generated questionnaire HTML.

Public usage:
    python {SKILL}/scripts/check_questionnaire.py {OUT}/<问卷名>.html [--spec {OUT}/spec.json]

Checks:
  1. tag pairing balance (HTML structure)
  2. JS syntax of every <script> block via `node --check` (skipped with warning if node missing)
  3. required features present (records, admin entry, CSV export, submitter fields)
  4. with --spec: embedded QDATA matches the spec (title, question count, submitter labels)

Exit: 0 = all checks passed (warnings possible); 1 = problems found; 2 = usage/IO error.
"""
from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
import tempfile
from html.parser import HTMLParser
from pathlib import Path

VOID_TAGS = {
    "area", "base", "br", "col", "embed", "hr", "img", "input",
    "link", "meta", "param", "source", "track", "wbr",
}


class PairingChecker(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.stack: list[tuple[str, int]] = []
        self.errors: list[str] = []

    def handle_starttag(self, tag: str, attrs) -> None:
        if tag not in VOID_TAGS:
            self.stack.append((tag, self.getpos()[0]))

    def handle_endtag(self, tag: str) -> None:
        if tag in VOID_TAGS:
            return
        if not self.stack:
            self.errors.append(f"line {self.getpos()[0]}: closing </{tag}> without matching opening tag")
            return
        open_tag, line = self.stack.pop()
        if open_tag != tag:
            self.errors.append(f"line {self.getpos()[0]}: </{tag}> closes <{open_tag}> opened at line {line}")


def check_pairing(text: str) -> list[str]:
    checker = PairingChecker()
    try:
        checker.feed(text)
        checker.close()
    except Exception as error:
        return [f"HTML parse failed: {error}"]
    for tag, line in checker.stack:
        checker.errors.append(f"line {line}: <{tag}> never closed")
    return checker.errors


def check_js(text: str) -> tuple[list[str], list[str]]:
    errors, warnings = [], []
    node = shutil.which("node")
    if not node:
        return errors, ["node not found; skipped JS syntax check"]
    blocks = re.findall(r"<script[^>]*>(.*?)</script>", text, flags=re.S | re.I)
    with tempfile.TemporaryDirectory() as tmp:
        for i, block in enumerate(blocks):
            if not block.strip():
                continue
            path = Path(tmp) / f"script_{i}.js"
            path.write_text(block, encoding="utf-8")
            proc = subprocess.run([node, "--check", str(path)], capture_output=True, text=True, timeout=30)
            if proc.returncode != 0:
                first = (proc.stderr or proc.stdout).strip().splitlines()
                errors.append(f"script block {i}: JS syntax error: {first[0] if first else proc.returncode}")
    return errors, warnings


def check_features(text: str) -> list[str]:
    errors = []
    for marker, desc in [
        ("localStorage", "submission record storage"),
        ("exportCSV", "CSV export"),
        ("提交记录管理", "admin entry"),
        ("记录编号", "record id"),
        ("QDATA-BEGIN", "embedded QDATA config block"),
    ]:
        if marker not in text:
            errors.append(f"missing expected feature: {desc} (marker {marker!r} not found)")
    return errors


def extract_qdata(text: str):
    m = re.search(r"/\* QDATA-BEGIN \*/\s*const QDATA = (.*?);\s*/\* QDATA-END \*/", text, flags=re.S)
    if not m:
        return None
    try:
        return json.loads(m.group(1).replace("<\\/", "</"))
    except json.JSONDecodeError:
        return None


def check_spec(text: str, spec_path: str) -> list[str]:
    errors = []
    try:
        spec = json.loads(Path(spec_path).read_text(encoding="utf-8-sig"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        return [f"cannot read spec {spec_path}: {error}"]
    qdata = extract_qdata(text)
    if qdata is None:
        return ["embedded QDATA block missing or not valid JSON"]
    if qdata.get("title") != spec.get("title"):
        errors.append(f"title mismatch: html={qdata.get('title')!r} spec={spec.get('title')!r}")
    if len(qdata.get("questions", [])) != len(spec.get("questions", [])):
        errors.append(
            f"question count mismatch: html={len(qdata.get('questions', []))} spec={len(spec.get('questions', []))}"
        )
    labels_html = [f.get("label") for f in qdata.get("submitter_fields", [])]
    labels_spec = [f.get("label") for f in spec.get("submitter_fields", [])]
    if labels_html != labels_spec:
        errors.append(f"submitter fields mismatch: html={labels_html} spec={labels_spec}")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description="Structural self-check for a generated questionnaire HTML.")
    parser.add_argument("html", help="generated questionnaire HTML file")
    parser.add_argument("--spec", help="spec JSON to cross-check against the embedded QDATA")
    args = parser.parse_args()
    try:
        text = Path(args.html).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        print(f"check_questionnaire_error: cannot read {args.html}: {error}", file=sys.stderr)
        return 2
    errors, warnings = [], []
    errors += check_pairing(text)
    js_errors, js_warnings = check_js(text)
    errors += js_errors
    warnings += js_warnings
    errors += check_features(text)
    if args.spec:
        errors += check_spec(text, args.spec)
    report = {"html": args.html, "errors": errors, "warnings": warnings}
    print(json.dumps(report, ensure_ascii=False, indent=2))
    if errors:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
