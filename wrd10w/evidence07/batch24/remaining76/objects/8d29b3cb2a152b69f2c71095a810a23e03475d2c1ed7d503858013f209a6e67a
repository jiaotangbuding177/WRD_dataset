"""Fill rubric scores and opinions into an editable .docx feedback form.

Method (learned from real scoring-feedback conversations):
1. Load score_results.json: {"rows":[{"label":"...","value":"..."},...],
   "total":{"label":"...","value":"..."} (optional)}.
2. For each row, locate the table row whose cell text equals the label
   (stripped exact match), and write the value into the last cell of that row.
3. Before writing, detect vertical merge (w:vMerge) in the target column and
   remove it so each row's cell is independent; otherwise adjacent rows share
   one cell and overwrite each other (a real template defect seen twice).
4. If "total" is present, write it too and verify that the numeric row values
   sum to the total; a mismatch is an error, never silently exported.
5. Re-open the saved file and re-read every written cell; any mismatch fails.

Exit codes: 0 success with a JSON write report on stdout; 2 on any error with
the reason on stderr (label not found, invalid JSON, unreadable docx,
verification mismatch, missing input file).

Usage:
    python fill_scored_feedback.py SCORE_RESULTS_JSON FEEDBACK_FORM_DOCX --out OUTPUT_DOCX
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

from docx import Document
from docx.oxml.ns import qn


def fail(message: str) -> "int":
    print("fill_feedback_error: " + message, file=sys.stderr)
    return 2


def cell_text(cell) -> str:
    return cell.text.strip()


def unmerge_column(table, grid_col: int) -> int:
    """Remove w:vMerge from every cell in the given grid column; return count."""
    removed = 0
    for row in table.rows:
        pos = 0
        for tc in row._tr.findall(qn("w:tc")):
            tc_pr = tc.find(qn("w:tcPr"))
            span = 1
            if tc_pr is not None:
                gs = tc_pr.find(qn("w:gridSpan"))
                if gs is not None:
                    span = int(gs.get(qn("w:val"), "1"))
            if pos <= grid_col < pos + span and tc_pr is not None:
                vm = tc_pr.find(qn("w:vMerge"))
                if vm is not None:
                    tc_pr.remove(vm)
                    removed += 1
            pos += span
    return removed


def write_cell(cell, value: str) -> None:
    paragraph = cell.paragraphs[0]
    if paragraph.runs:
        paragraph.runs[0].text = value
        for run in paragraph.runs[1:]:
            run.text = ""
    else:
        paragraph.add_run(value)
    for extra in cell.paragraphs[1:]:
        for run in list(extra.runs):
            run.text = ""


def find_row(document, label: str):
    """Return (table, row) whose some cell text equals label, else (None, None)."""
    for table in document.tables:
        for row in table.rows:
            for cell in row.cells:
                if cell_text(cell) == label:
                    return table, row
    return None, None


def last_cell_of_row(row):
    tcs = row._tr.findall(qn("w:tc"))
    if not tcs:
        return None
    from docx.table import _Cell
    return _Cell(tcs[-1], row)


def read_back(path: Path, writes):
    """Re-open the saved file and verify every written cell shows its value."""
    document = Document(str(path))
    results = []
    for item in writes:
        table, row = find_row(document, item["label"])
        if row is None:
            results.append({"label": item["label"], "verified": False,
                            "reason": "label_not_found_after_save"})
            continue
        cell = last_cell_of_row(row)
        shown = cell_text(cell) if cell is not None else ""
        results.append({"label": item["label"], "value": item["value"],
                        "shown": shown, "verified": shown == item["value"]})
    return results


def main(argv) -> int:
    args = argv[1:]
    if len(args) != 4 or args[2] != "--out":
        print("fill_feedback_error: usage: python fill_scored_feedback.py "
              "SCORE_RESULTS_JSON FEEDBACK_FORM_DOCX --out OUTPUT_DOCX", file=sys.stderr)
        return 2
    scores_path, form_path, out_path = (Path(args[0]), Path(args[1]), Path(args[3]))
    if not scores_path.is_file():
        return fail(f"score_results file not found: {scores_path}")
    if not form_path.is_file():
        return fail(f"feedback form file not found: {form_path}")
    try:
        data = json.loads(scores_path.read_text(encoding="utf-8-sig"))
    except (UnicodeError, ValueError) as error:
        return fail(f"score_results is not valid JSON: {error}")
    rows = data.get("rows") if isinstance(data, dict) else None
    if not isinstance(rows, list) or not rows or not all(
            isinstance(r, dict) and isinstance(r.get("label"), str) and r.get("label").strip()
            and isinstance(r.get("value"), str) for r in rows):
        return fail('score_results must be {"rows":[{"label":str,"value":str},...], "total":{...} optional}')
    total = data.get("total")
    if total is not None and not (isinstance(total, dict) and isinstance(total.get("label"), str)
                                  and isinstance(total.get("value"), str)):
        return fail('"total" must be {"label":str,"value":str} when present')
    try:
        document = Document(str(form_path))
    except Exception as error:
        return fail(f"feedback form is not a readable .docx: {error}")

    unmerged = 0
    writes = list(rows)
    if total is not None:
        writes = writes + [total]
    report_rows = []
    for item in writes:
        label, value = item["label"].strip(), item["value"]
        table, row = find_row(document, label)
        if row is None:
            return fail(f"label_not_found: no table cell exactly equals {label!r}")
        target = last_cell_of_row(row)
        if target is None:
            return fail(f"empty_target_row: row for {label!r} has no cells")
        tcs = row._tr.findall(qn("w:tc"))
        pos, grid_col = 0, 0
        for index, tc in enumerate(tcs):
            if tc is tcs[-1]:
                grid_col = pos
                break
            tc_pr = tc.find(qn("w:tcPr"))
            span = 1
            if tc_pr is not None:
                gs = tc_pr.find(qn("w:gridSpan"))
                if gs is not None:
                    span = int(gs.get(qn("w:val"), "1"))
            pos += span
        unmerged += unmerge_column(table, grid_col)
        target = last_cell_of_row(row)
        write_cell(target, value)
        report_rows.append({"label": label, "value": value, "table": 0, "cell": "last"})
    if total is not None:
        numeric = [float(r["value"]) for r in rows
                   if _as_number(r["value"]) is not None]
        total_value = _as_number(total["value"])
        if total_value is not None:
            summed = sum(numeric)
            if abs(summed - total_value) > 1e-9:
                return fail(f"total_mismatch: row values sum to {summed:g} "
                            f"but total declares {total_value:g}")
    out_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        document.save(str(out_path))
    except Exception as error:
        return fail(f"cannot save output docx: {error}")
    verification = read_back(out_path, writes)
    bad = [v for v in verification if not v["verified"]]
    if bad:
        return fail(f"verification_failed: {json.dumps(bad, ensure_ascii=False)}")
    report = {"output": str(out_path), "written": report_rows,
              "unmerged_cells": unmerged,
              "total_check": ({"sum": sum(float(r["value"]) for r in rows if _as_number(r["value"]) is not None),
                               "declared": total["value"], "pass": True}
                              if total is not None and _as_number(total["value"]) is not None else None),
              "read_back": verification}
    print(json.dumps(report, ensure_ascii=False))
    return 0


def _as_number(text: str):
    try:
        return float(str(text).strip())
    except ValueError:
        return None


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
