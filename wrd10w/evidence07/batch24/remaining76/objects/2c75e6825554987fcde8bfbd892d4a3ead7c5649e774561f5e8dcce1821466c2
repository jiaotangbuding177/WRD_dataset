{"type": "message", "id": "120c67b4-2231-45ed-9409-ce65aa4f196e", "parentId": "55ee49e0-20b5-4394-a9c0-c760e4eef1bd", "timestamp": "2026-10-23T05:17:13.295Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call516b5ee9728b44dead0488a119fe92d3", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"按确认口径的维度-字段 JSON 生成字段体系 md + xlsx 采集表。\n\n用法:\n  python3 build_field_system.py DIMENSIONS.json --out-dir OUT [--name 文档主标题] [--md-scores] [--html-rowspan]\n\n输入 JSON 结构见 templates/dimensions.template.json。\n退出码: 0 成功; 2 输入读取/解析失败; 3 输入结构不合法; 4 输出写出失败。\n\"\"\"\nimport argparse\nimport html\nimport json\nimport sys\nfrom pathlib import Path\n\n\ndef fail(code, msg):\n    print(f\"错误(退出{code}): {msg}\", file=sys.stderr)\n    sys.exit(code)\n\n\ndef load_input(path):\n    p = Path(path)\n    if not p.is_file():\n        fail(2, f\"输入文件不存在: {p}\")\n    try:\n        data = json.loads(p.read_text(encoding=\"utf-8\"))\n    except Exception as e:\n        fail(2, f\"JSON 解析失败: {e}\")\n    if not isinstance(data, dict) or not isinstance(data.get(\"boards\"), list) or not data[\"boards\"]:\n        fail(3, '输入需为 {\"boards\": [...]}，boards 为非空数组')\n    for i, b in enumerate(data[\"boards\"]):\n        if not isinstance(b, dict) or not b.get(\"name\"):\n            fail(3, f\"boards[{i}] 缺 name\")\n        if b.get(\"kind\") not in (\"score\", \"support\"):\n            fail(3, f\"boards[{i}].kind 必须是 score 或 support\")\n        sls = b.get(\"second_levels\")\n        if not isinstance(sls, list) or not sls:\n            fail(3, f\"boards[{i}]({b['name']}) 缺非空 second_levels\")\n        for j, sl in enumerate(sls):\n            if not isinstance(sl, dict) or not sl.get(\"name\"):\n                fail(3, f\"boards[{i}].second_levels[{j}] 缺 name\")\n            fs = sl.get(\"fields\")\n            if not isinstance(fs, list):\n                fail(3, f\"二级维度 {sl['name']} 缺 fields 数组(可为空数组)\")\n            for k, f in enumerate(fs):\n                if not isinstance(f, dict) or not f.get(\"name\"):\n                    fail(3, f\"{sl['name']}.fields[{k}] 缺 name\")\n    return data\n\n\ndef totals(data):\n    score_boards = [b for b in data[\"boards\"] if b[\"kind\"] == \"score\"]\n    n_sl = sum(len(b[\"second_levels\"]) for b in data[\"boards\"])\n    n_f = sum(len(sl[\"fields\"]) for b in data[\"boards\"] for sl in b[\"second_levels\"])\n    return score_boards, n_sl, n_f\n\n\ndef md_cell(text):\n    return str(text if text is not None else \"\").replace(\"|\", \"\\\\|\").replace(\"\\n\", \" \")\n\n\ndef md_table(headers, rows):\n    out = [\"| \" + \" | \".join(headers) + \" |\", \"|\" + \"|\".join([\"---\"] * len(headers)) + \"|\"]\n    for r in rows:\n        out.append(\"| \" + \" | \".join(md_cell(c) for c in r) + \" |\")\n    return \"\\n\".join(out)\n\n\ndef html_table(headers, rows, spans):\n    \"\"\"spans: 每行列表，元素为 None(被上方 rowspan 吞并) 或 (text, rowspan)。\"\"\"\n    out = [\"<table>\", \"<thead><tr>\" + \"\".join(f\"<th>{html.escape(str(h))}</th>\" for h in headers) + \"</tr></thead>\", \"<tbody>\"]\n    for r in rows:\n        cells = [\"<tr>\"]\n        for v in r:\n            if v is None:\n                continue\n            text, rs = v\n            attr = f' rowspan=\"{rs}\"' if rs > 1 else \"\"\n            cells.append(f\"<td{attr}>{html.escape(str(text))}</td>\")\n        cells.append(\"</tr>\")\n        out.append(\"\".join(cells))\n    out.append(\"</tbody></table>\")\n    return \"\\n\".join(out)\n\n\ndef build_markdown(data, name, md_scores, html_rowspan):\n    score_boards, n_sl, n_f = totals(data)\n    n_score, n_support = len(score_boards), len(data[\"boards\"]) - len(score_boards)\n    L = [f\"# {name}\", \"\",\n         f\"字段统计：{len(data['boards'])} 个板块（{n_score} 评分 + {n_support} 支撑）、{n_sl} 个二级维度、{n_f} 个字段\",\n         \"\", \"## 一、评分框架总览\", \"\"]\n    ov_rows = []\n    for b in score_boards:\n        for j, sl in enumerate(b[\"second_levels\"]):\n            if html_rowspan:\n                ov_rows.append([(b[\"name\"], len(b[\"second_levels\"])) if j == 0 else None,\n                                (sl[\"name\"], 1)])\n            else:\n                ov_rows.append([b[\"name\"] if j == 0 else \"\", sl[\"name\"]])\n    ov_headers = [\"一级维度\", \"二级维度\"] + ([\"满分\"] if md_scores else [])\n    if md_scores and not html_rowspan:\n        for r in ov_rows:\n            pass\n    if html_rowspan:\n        if md_scores:\n            for r in ov_rows:\n                pass  # 满分列与 rowspan 组合不常用，总览仅两级列\n        L.append(html_table([\"一级维度\", \"二级维度\"], ov_rows, True))\n    else:\n        rows = []\n        for b in score_boards:\n            for j, sl in enumerate(b[\"second_levels\"]):\n                rows.append([b[\"name\"] if j == 0 else \"\", sl[\"name\"]] + ([sl.get(\"score\", \"\")] if md_scores else []))\n        L.append(md_table(ov_headers, rows))\n    L += [\"\", \"## 二、字段清单\", \"\"]\n    for b in data[\"boards\"]:\n        L += [f\"### {b['name']}\", \"\"]\n        rows, hrows = [], []\n        for sl in b[\"second_levels\"]:\n            if not sl[\"fields\"]:\n                rows.append([sl[\"name\"], \"（本维度暂未挂字段，按用户确认口径补充）\", \"\", \"\", \"\"])\n                hrows.append([[(sl[\"name\"], 1)], None, None, None, None])\n            for f in sl[\"fields\"]:\n                rows.append([sl[\"name\"], f[\"name\"], f.get(\"desc\", \"\"), f.get(\"evidence\", \"\"), f.get(\"required\", \"\")])\n                hrows.append([[(sl[\"name\"], len(sl[\"fields\"]))] if f is sl[\"fields\"][0] else [None],\n                              None, None, None, None])\n        if html_rowspan:\n            fixed = []\n            for sl_i, sl in enumerate(b[\"second_levels\"]):\n                fl = sl[\"fields\"] or [None]\n                for fi, f in enumerate(fl):\n                    if f is None:\n                        fixed.append([(\"（待补充）\", 1), (\"本维度暂未挂字段，按用户确认口径补充\", 1), (\"\", 1), (\"\", 1), (\"\", 1)])\n                    else:\n                        fixed.append([((sl[\"name\"], len(sl[\"fields\"])) if fi == 0 else None),\n                                      (f[\"name\"], 1), (f.get(\"desc\", \"\"), 1), (f.get(\"evidence\", \"\"), 1), (f.get(\"required\", \"\"), 1)])\n            L.append(html_table([\"二级维度\", \"字段名\", \"说明\", \"佐证材料\", \"必填性\"], fixed, True))\n        else:\n            L.append(md_table([\"二级维度\", \"字段名\", \"说明\", \"佐证材料\", \"必填性\"], rows))\n        L.append(\"\")\n    L += [\"## 三、评分表\", \"\"]\n    sc_headers = [\"一级维度\", \"二级维度\"] + ([\"满分\"] if md_scores else []) + [\"得分\", \"评分说明\"]\n    sc_rows = []\n    for b in score_boards:\n        for j, sl in enumerate(b[\"second_levels\"]):\n            sc_rows.append([b[\"name\"] if j == 0 else \"\", sl[\"name\"]]\n                           + ([sl.get(\"score\", \"\")] if md_scores else []) + [\"\", \"\"])\n    L.append(md_table(sc_headers, sc_rows))\n    stds = data.get(\"rating_standards\")\n    if stds:\n        L += [\"\", \"评级标准\", \"\"]\n        L += [f\"- {s}\" for s in stds]\n    return \"\\n\".join(L) + \"\\n\"\n\n\ndef build_xlsx(data, name, out_dir):\n    try:\n        from openpyxl import Workbook\n        from openpyxl.styles import Font\n        from openpyxl.utils import get_column_letter\n    except ImportError:\n        print(\"警告: 未安装 openpyxl，跳过 xlsx 生成（仅输出 md）\")\n        return None\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"字段清单\"\n    headers = [\"序号\", \"板块\", \"一级维度\", \"二级维度\", \"满分\", \"字段名\", \"说明\", \"佐证材料\", \"必填性\"]\n    ws.append(headers)\n    for c in range(1, len(headers) + 1):\n        ws.cell(row=1, column=c).font = Font(bold=True)\n    idx = 0\n    for b in data[\"boards\"]:\n        for sl in b[\"second_levels\"]:\n            for f in sl[\"fields\"]:\n                idx += 1\n                ws.append([idx, b[\"name\"], b[\"name\"], sl[\"name\"],\n                           sl.get(\"score\", \"\") if b[\"kind\"] == \"score\" else \"\",\n                           f[\"name\"], f.get(\"desc\", \"\"), f.get(\"evidence\", \"\"), f.get(\"required\", \"\")])\n    for col, w in zip(\"ABCDEFGHI\", [6, 16, 16, 20, 8, 24, 40, 24, 10]):\n        ws.column_dimensions[col].width = w\n    ws.freeze_panes = \"A2\"\n    ws.auto_filter.ref = f\"A1:{get_column_letter(len(headers))}{ws.max_row}\"\n    ws2 = wb.create_sheet(\"评分表\")\n    h2 = [\"一级维度\", \"二级维度\", \"满分\", \"得分\", \"评分说明\"]\n    ws2.append(h2)\n    for c in range(1, len(h2) + 1):\n        ws2.cell(row=1, column=c).font = Font(bold=True)\n    for b in data[\"boards\"]:\n        if b[\"kind\"] != \"score\":\n            continue\n        for sl in b[\"second_levels\"]:\n            ws2.append([b[\"name\"], sl[\"name\"], sl.get(\"score\", \"\"), \"\", \"\"])\n    r = ws2.max_row + 2\n    for s in data.get(\"rating_standards\", []):\n        ws2.cell(row=r, column=1, value=s)\n        r += 1\n    for col, w in zip(\"ABCDE\", [18, 24, 8, 8, 50]):\n        ws2.column_dimensions[col].width = w\n    ws2.freeze_panes = \"A2\"\n    xlsx_path = out_dir / f\"{name}.xlsx\"\n    wb.save(xlsx_path)\n    return xlsx_path\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"按确认口径生成字段体系 md+xlsx\")\n    ap.add_argument(\"dimensions\", help=\"维度-字段 JSON 路径\")\n    ap.add_argument(\"--out-dir\", required=True, help=\"输出目录\")\n    ap.add_argument(\"--name\", default=None, help=\"文档主标题，默认取 JSON 的 title\")\n    ap.add_argument(\"--md-scores\", action=\"store_true\", help=\"md 正文保留满分/分数列（默认按历史口径去除，仅 xlsx 带分）\")\n    ap.add_argument(\"--html-rowspan\", action=\"store_true\", help=\"字段清单用 HTML rowspan 表格实现合并单元格效果\")\n    args = ap.parse_args()\n    data = load_input(args.dimensions)\n    name = args.name or data.get(\"title\") or \"评估信息字段体系\"\n    out_dir = Path(args.out_dir)\n    try:\n        out_dir.mkdir(parents=True, exist_ok=True)\n    except Exception as e:\n        fail(4, f\"无法创建输出目录 {out_dir}: {e}\")\n    md = build_markdown(data, name, args.md_scores, args.html_rowspan)\n    