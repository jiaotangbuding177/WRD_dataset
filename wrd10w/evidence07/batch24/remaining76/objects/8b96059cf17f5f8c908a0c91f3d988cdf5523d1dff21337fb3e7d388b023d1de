rgs.last)]\n        cmd += [args.input, prefix]\n        try:\n            subprocess.run(cmd, check=True, capture_output=True, timeout=1800)\n        except subprocess.SubprocessError as e:\n            print(\"ocr_pdf error: pdftoppm 转图失败: %s\" % e, file=sys.stderr)\n            return 3\n        images = sorted(glob.glob(prefix + \"-*.png\"))\n        if not images:\n            print(\"ocr_pdf error: 未产出页图\", file=sys.stderr)\n            return 3\n        for i, img in enumerate(images, 1):\n            r = subprocess.run(\n                [\"tesseract\", img, \"-\", \"-l\", args.lang],\n                capture_output=True, timeout=600,\n            )\n            if r.returncode != 0:\n                print(\"ocr_pdf error: tesseract 第 %d 页失败: %s\"\n                      % (i, r.stderr.decode(\"utf-8\", \"replace\")[:200]), file=sys.stderr)\n                return 3\n            text = r.stdout.decode(\"utf-8\", \"replace\").strip()\n            pages.append(\"===== 第 %d 页 =====\\n%s\" % (i, text))\n\n    out = \"\\n\\n\".join(pages) + \"\\n\"\n    out_path = os.path.dirname(os.path.abspath(args.out))\n    os.makedirs(out_path, exist_ok=True)\n    with open(args.out, \"w\", encoding=\"utf-8\") as f:\n        f.write(out)\n    print(\"ocr_pdf: %d 页 -> %s（%d 字符）\" % (len(pages), args.out, len(out)))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"对无文本层的扫描版/图片型 PDF 做 OCR，产出带页码标记的 .txt。\n\n用法（原样可执行）:\n  python3 ocr_pdf.py <扫描版.pdf> --out <输出.txt> [--lang chi_sim] [--dpi 300] [--first N] [--last N]\n\n行为:\n- pdftoppm 转页图（png）后逐页 tesseract OCR（默认 chi_sim，中文项目不需要 eng 混合）。\n- 输出每页前加 \"===== 第 N 页 =====\" 标记，便于报告中标注依据页码。\n- 退出码: 0 成功; 2 输入缺失/用法错误; 3 转换或 OCR 失败。\n注意: OCR 结果有识别噪声（如\"直接\"误成\"宣接\"），报告引用的关键数字须对照原图核对。\n\"\"\"\nimport argparse\nimport glob\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\n\n\ndef main(argv=None):\n    ap = argparse.Argume