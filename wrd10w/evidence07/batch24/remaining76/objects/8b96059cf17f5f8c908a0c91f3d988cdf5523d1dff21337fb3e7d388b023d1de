{"type": "message", "id": "1082f618-9214-41c9-a722-b55a17afafb3", "parentId": "d9098aef-0c3f-4035-a831-88d6a69c6340", "timestamp": "2026-10-23T06:03:12.449Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在编写本路线的核心新程序：按坐标/锚点把内容填入DOCX表单（保留模板格式），随后实测。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-ad8ace5e372e4c5ea08ecb6e\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call4a1940f628e5403ca3ecca46d7c66875", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"把映射好的内容填入 DOCX 表格/段落表单，保留原模板格式。\n\n用法（原样可执行）:\n  python3 fill_docx_tables.py <模板.docx> --values <values.json> --out <成品.docx>\n\nvalues.json 结构（tables/paragraphs 均可选，按需给）:\n{\n  \"tables\": [\n    {\"table\": 0,\n     \"cells\": [\n       {\"row\": 2, \"col\": 1, \"text\": \"87\", \"mode\": \"replace\"},\n       {\"row\": 3, \"col\": 2, \"text\": \"依据：…\", \"mode\": \"append\"}\n     ]}\n  ],\n  \"paragraphs\": [\n    {\"anchor\": \"评审意见：\", \"text\": \"……\", \"mode\": \"insert_after\"}\n  ]\n}\n\n行为:\n- cell replace: 清空单元格写入 text；text 中 \\n 分多行，行格式沿用原第一行。\n- cell append: 在单元格末尾追加新行写入 text，格式沿用原最后一行。\n- paragraph replace: 用 text 替换命中段落全文；insert_after: 在其后插入新段；append: 在段末续写。\n- anchor 命中含该文字的第一个段落（区分表格内外，段落指表格外的正文段落）。\n- 表格序号 0 起，与提取文本中 ===== TABLE ===== 出现顺序一致；合并单元格坐标可能与\n  提取文本列对齐不一致，填前先对照提取文本核对。\n- 退出码: 0 全部命中并写出; 2 输入/用法错误; 3 有定位未命中（成品仍写出，stdout 报 failed 清单）。\n不联网；不修改模板文件。\n\"\"\"\nimport copy\nimport json\nimport os\nimport sys\n\nfrom docx import Document\nfrom docx.text.paragraph import Paragraph\n\n\ndef set_line(p, text):\n    \"\"\"把段落文本设为 text，保留第一个 run 的格式，删除其余 run。\"\"\"\n    runs = list(p.runs)\n    if runs:\n        runs[0].text = text\n        for r in runs[1:]:\n            r._element.getparent().remove(r._element)\n    else:\n        p.add_run(text)\n\n\ndef write_multiline(p0, text):\n    \"\"\"在段落 p0 位置写入可能多行的 text：首行写进 p0，其余行克隆 p0 依次插入。\"\"\"\n    lines = text.split(\"\\n\")\n    set_line(p0, lines[0])\n    prev = p0._element\n    for line in lines[1:]:\n        newp = copy.deepcopy(p0._element)\n        prev.addnext(newp)\n        prev = newp\n        set_line(Paragraph(newp, p0._parent), line)\n\n\ndef fill_cell(cell, text, mode):\n    if mode == \"replace\":\n        for p in cell.paragraphs[1:]:\n            p._element.getparent().remove(p._element)\n        write_multiline(cell.paragraphs[0], text)\n    elif mode == \"append\":\n        last = cell.paragraphs[-1]\n        if last.text.strip() or last.runs:\n            newp = copy.deepcopy(last._element)\n            last._element.addnext(newp)\n            set_line(Paragraph(newp, last._parent), text)\n        else:\n            write_multiline(last, text)\n    else:\n        raise ValueError(\"不支持的 cell mode: %s\" % mode)\n\n\ndef find_anchor(doc, anchor):\n    for p in doc.paragraphs:\n        if anchor in p.text:\n            return p\n    return None\n\n\ndef main(argv):\n    import argparse\n    ap = argparse.ArgumentParser(description=\"按坐标/锚点填写 DOCX 表单\")\n    ap.add_argument(\"template\", help=\"模板/目标 .docx\")\n    ap.add_argument(\"--values\", required=True, help=\"填写映射 values.json\")\n    ap.add_argument(\"--out\", required=True, help=\"输出成品 .docx\")\n    args = ap.parse_args(argv)\n\n    if not os.path.isfile(args.template):\n        print(\"fill_docx_tables error: 模板不存在: %s\" % args.template, file=sys.stderr)\n        return 2\n    try:\n        with open(args.values, \"r\", encoding=\"utf-8\") as f:\n            spec = json.load(f)\n    except (OSError, ValueError) as e:\n        print(\"fill_docx_tables error: values 读取失败: %s\" % e, file=sys.stderr)\n        return 2\n    if not isinstance(spec, dict):\n        print(\"fill_docx_tables error: values.json 顶层必须是对象\", file=sys.stderr)\n        return 2\n    if not args.out.lower().endswith(\".docx\"):\n        print(\"fill_docx_tables error: --out 必须是 .docx\", file=sys.stderr)\n        return 2\n\n    doc = Document(args.template)\n    applied, failed = [], []\n\n    tables = doc.tables\n    for ti, tspec in enumerate(spec.get(\"tables\") or []):\n        tidx = tspec.get(\"table\")\n        if not isinstance(tidx, int) or not (0 <= tidx < len(tables)):\n            failed.append({\"kind\": \"table\", \"table\": tidx,\n                           \"error\": \"表格序号越界（共 %d 个表格）\" % len(tables)})\n            continue\n        tb = tables[tidx]\n        nrows, ncols = len(tb.rows), len(tb.columns)\n        for cspec in tspec.get(\"cells\") or []:\n            row, col = cspec.get(\"row\"), cspec.get(\"col\")\n            if not isinstance(row, int) or not isinstance(col, int) \\\n                    or not (0 <= row < nrows) or not (0 <= col < ncols):\n                failed.append({\"kind\": \"cell\", \"table\": tidx, \"row\": row, \"col\": col,\n                               \"error\": \"坐标越界（表 %d 实际 %d 行 %d 列）\" % (tidx, nrows, ncols)})\n                continue\n            try:\n                fill_cell(tb.rows[row].cells[col], str(cspec.get(\"text\", \"\")),\n                          cspec.get(\"mode\", \"replace\"))\n                applied.append({\"kind\": \"cell\", \"table\": tidx, \"row\": row,\n                                \"col\": col, \"mode\": cspec.get(\"mode\", \"replace\")})\n            except Exception as e:\n                failed.append({\"kind\": \"cell\", \"table\": tidx, \"row\": row, \"col\": col,\n                               \"error\": str(e)})\n\n    for pspec in spec.get(\"paragraphs\") or []:\n        anchor = pspec.get(\"anchor\")\n        p = find_anchor(doc, anchor or \"\")\n        if p is None:\n            failed.append({\"kind\": \"paragraph\", \"anchor\": anchor, \"error\": \"未找到锚点段落\"})\n            continue\n        mode = pspec.get(\"mode\", \"replace\")\n        text = str(pspec.get(\"text\", \"\"))\n        try:\n            if mode == \"replace\":\n                write_multiline(p, text)\n            elif mode == \"insert_after\":\n                newp = copy.deepcopy(p._element)\n                p._element.addnext(newp)\n                write_multiline(Paragraph(newp, p._parent), text)\n            elif mode == \"append\":\n                p.add_run(text)\n            else:\n                raise ValueError(\"不支持的 paragraph mode: %s\" % mode)\n            applied.append({\"kind\": \"paragraph\", \"anchor\": anchor, \"mode\": mode})\n        except Exception as e:\n            failed.append({\"kind\": \"paragraph\", \"anchor\": anchor, \"error\": str(e)})\n\n    outdir = os.path.dirname(os.path.abspath(args.out))\n    os.makedirs(outdir, exist_ok=True)\n    doc.save(args.out)\n    print(json.dumps({\"applied\": len(applied), \"failed\": failed,\n                      \"out\": args.out}, ensure_ascii=False))\n    return 3 if failed else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n", "path": "/workspace/outputs/skill/scripts/fill_docx_tables.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792735305173, "responseId": "chatcmpl-1792735305228", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "a8a4fd3c-b4f8-4d77-8313-073be031dfb2"}}}
