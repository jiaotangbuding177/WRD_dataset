#!/usr/bin/env python3
"""把源报表数据按「Sheet!单元格」映射填入 xlsx 模板，保留模板公式/格式/结构。

用法:
  python3 fill_xlsx.py <模板.xlsx> --values <values.json> --out <成品.xlsx> [--force] [--overwrite]

values.json 结构（"表名!单元格": 数值或文字，金额写数值不写千分位字符串）:
{
  "资产负债表!B5": 1076.49,
  "资产负债表!C5": 2488.39,
  "利润表!B4": "按实际科目的文字"
}

防呆规则:
- 目标单元格是公式（合计行）→ 拒绝写入并报错（--force 可越过，慎用）。
- 目标单元格已有非0非空值 → 列出清单要求 --overwrite 才覆盖。
- 表名不存在 / 单元格坐标非法 → 报错退出，一个都不写。
- 写完后重新读回逐项校验，输出已写清单。

退出码: 0 全部写入并复核一致; 2 用法/输入错误; 3 有防呆冲突（公式/覆盖/坐标），未生成成品。
"""
import argparse
import json
import re
import sys
from pathlib import Path

from openpyxl import load_workbook

CELL_RE = re.compile(r"^[A-Z]{1,3}[1-9][0-9]*$")


def main(argv):
    ap = argparse.ArgumentParser(description="按映射填 xlsx 模板（详见模块docstring）")
    ap.add_argument("template")
    ap.add_argument("--values", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--force", action="store_true", help="允许写入公式单元格")
    ap.add_argument("--overwrite", action="store_true", help="允许覆盖已有非0值")
    args = ap.parse_args(argv)

    try:
        with open(args.values, encoding="utf-8") as f:
            values = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        print("读 values.json 失败: %s" % e, file=sys.stderr)
        return 2
    if not isinstance(values, dict) or not values:
        print("values.json 应为非空对象", file=sys.stderr)
        return 2
    tpl = Path(args.template)
    if not tpl.is_file():
        print("模板不存在: %s" % tpl, file=sys.stderr)
        return 2

    wb = load_workbook(tpl, data_only=False)
    conflicts, plan = [], []
    for key, val in values.items():
        if "!" not in key:
            conflicts.append("%s: 缺少 Sheet! 前缀" % key)
            continue
        sheet, coord = key.rsplit("!", 1)
        coord = coord.replace("$", "").upper()
        if sheet not in wb.sheetnames:
            conflicts.append("%s: 表 %r 不存在（现有: %s）" % (key, sheet, "/".join(wb.sheetnames)))
            continue
        if not CELL_RE.match(coord):
            conflicts.append("%s: 单元格坐标非法" % key)
            continue
        ws = wb[sheet]
        cell = ws[coord]
        cur = cell.value
        if cell.data_type == "f" or (isinstance(cur, str) and cur.startswith("=")):
            if not args.force:
                conflicts.append("%s: 是公式单元格(=%s)，合计行不应手填；确认要覆盖加 --force" % (key, cur))
                continue
        elif cur not in (None, 0, "0", "") and cur != val:
            if not args.overwrite:
                conflicts.append("%s: 已有值 %r，覆盖需 --overwrite" % (key, cur))
                continue
        plan.append((sheet, coord, val, cur))

    if conflicts:
        print("未写入，先解决 %d 个冲突:" % len(conflicts))
        for c in conflicts:
            print("  - " + c)
        return 3

    for sheet, coord, val, _ in plan:
        wb[sheet][coord] = val
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    wb.save(out)

    # 读回复核
    wb2 = load_workbook(out, data_only=False)
    bad = []
    for sheet, coord, val, _ in plan:
        got = wb2[sheet][coord].value
        if got != val:
            bad.append("%s!%s 期望 %r 实得 %r" % (sheet, coord, val, got))
    print("已写入 %d 个单元格 -> %s" % (len(plan), out))
    for sheet, coord, val, old in plan:
        print("  %s!%s: %r%s" % (sheet, coord, val, "（覆盖 %r）" % old if old not in (None, 0, "0", "") else ""))
    if bad:
        print("读回不一致 %d 项:" % len(bad), file=sys.stderr)
        for b in bad:
            print("  " + b, file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
