{"type": "message", "id": "f40f9971-123b-489e-989c-f23966587c99", "parentId": "5b4406d7-2579-4dc7-ac9d-52fd8bcc1345", "timestamp": "2026-10-23T05:39:18.462Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "callab7bc5d7cb5343d6bca305883d3dd00a", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"定位 docx 中的空段（待补写位置）、批注及其锚定段落、邻段格式。\n\n用法（原样可执行）:\n  python3 locate_gaps.py <文件.docx> [--out <结果.json>]\n\n输出内容:\n- comments: 每条批注的 id/作者/日期/文本，及其 commentRangeStart/End 落在哪些段落（锚点）。\n- empty_paragraphs: 正文空段（仅空白），附前后最近非空段落的文本与格式摘要\n  （样式/编号/缩进/对齐 + 首个文字 run 的字体字号高亮），作为补写时的格式基准。\n- 所有输出仅供补写决策参考，最终判断由执行者结合全文确认。\n\n退出码: 0 成功; 2 输入缺失/非 docx/解析失败。不联网、不修改输入文件。\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\nP_RE = re.compile(r\"<w:p(?:\\s[^>]*)?(?:/>|>.*?</w:p>)\", re.S)\nRANGE_MARK_RE = re.compile(r'<w:commentRange(Start|End)\\b[^>]*w:id=\"([^\"]+)\"[^>]*/>')\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(\"&apos;\", \"'\"))\n\n\ndef para_text(p_xml):\n    return unescape(\"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p_xml, re.S)))\n\n\ndef first_attr(xml, tag):\n    m = re.search(r\"<%s\\b[^>]*>\" % tag, xml)\n    if not m:\n        return None\n    val = re.search(r'w:val=\"([^\"]*)\"', m.group(0))\n    return val.group(1) if val else \"\"\n\n\ndef ppr_summary(p_xml):\n    m = re.search(r\"<w:pPr\\b[^>]*>.*?</w:pPr>\", p_xml, re.S)\n    if not m:\n        return {}\n    ppr = m.group(0)\n    out = {}\n    style = first_attr(ppr, \"w:pStyle\")\n    if style:\n        out[\"style\"] = style\n    num_id = first_attr(ppr, \"w:numId\")\n    ilvl = first_attr(ppr, \"w:ilvl\")\n    if num_id:\n        out[\"numId\"] = num_id\n        out[\"ilvl\"] = ilvl or \"0\"\n    ind = re.search(r\"<w:ind\\b[^>]*/>\", ppr)\n    if ind:\n        attrs = dict(re.findall(r'(w:[\\w-]+)=\"([^\"]*)\"', ind.group(0)))\n        out[\"ind\"] = {k: v for k, v in attrs.items() if k != \"w:val\"}\n    jc = first_attr(ppr, \"w:jc\")\n    if jc:\n        out[\"jc\"] = jc\n    return out\n\n\ndef run_rpr_summary(p_xml):\n    for run in re.finditer(r\"<w:r(?:\\s[^>]*)?>.*?</w:r>\", p_xml, re.S):\n        r_xml = run.group(0)\n        if not re.search(r\"<w:t(?:\\s[^>]*)?>\", r_xml):\n            continue\n        m = re.search(r\"<w:rPr\\b[^>]*>.*?</w:rPr>\", r_xml, re.S)\n        if not m:\n            return {}\n        rpr = m.group(0)\n        out = {}\n        fonts = re.search(r\"<w:rFonts\\b[^>]*/>\", rpr)\n        if fonts:\n            attrs = dict(re.findall(r'(w:[\\w-]+)=\"([^\"]*)\"', fonts.group(0)))\n            out[\"fonts\"] = {k: v for k, v in attrs.items()}\n        sz = first_attr(rpr, \"w:sz\")\n        if sz:\n            out[\"sz_half_pt\"] = sz\n        hl = first_attr(rpr, \"w:highlight\")\n        if hl:\n            out[\"highlight\"] = hl\n        return out\n    return {}\n\n\ndef read_comments(archive):\n    if \"word/comments.xml\" not in archive.namelist():\n        return []\n    xml = archive.read(\"word/comments.xml\").decode(\"utf-8\", \"replace\")\n    out = []\n    for m in re.finditer(r\"<w:comment\\b[^>]*>\", xml):\n        end = xml.find(\"</w:comment>\", m.end())\n        if end < 0:\n            continue\n        cid = re.search(r'w:id=\"([^\"]+)\"', m.group(0))\n        author = re.search(r'w:author=\"([^\"]*)\"', m.group(0))\n        date = re.search(r'w:date=\"([^\"]*)\"', m.group(0))\n        body = \" \".join(\n            t.strip()\n            for t in (unescape(x) for x in re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", xml[m.end():end], re.S))\n            if t.strip())\n        out.append({\n            \"id\": cid.group(1) if cid else \"\",\n            \"author\": author.group(1) if author else \"\",\n            \"date\": date.group(1) if date else \"\",\n            \"text\": body,\n        })\n    return out\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"定位 docx 空段、批注锚点与邻段格式\")\n    ap.add_argument(\"input\", help=\".docx 文件\")\n    ap.add_argument(\"--out\", help=\"输出 JSON 路径；缺省打印 stdout\")\n    args = ap.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError(\"input not found: %s\" % src)\n        if src.suffix.lower() != \".docx\":\n            raise ValueError(\"unsupported input type %s: expected .docx\" % src.suffix)\n        archive = zipfile.ZipFile(src)\n    except (OSError, ValueError, zipfile.BadZipFile) as e:\n        print(\"locate_gaps error: %s\" % e, file=sys.stderr)\n        return 2\n    try:\n        doc_xml = archive.read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n        comments = read_comments(archive)\n    finally:\n        archive.close()\n\n    spans = []\n    for m in P_RE.finditer(doc_xml):\n        spans.append((m.start(), m.end(), m.group(0)))\n    texts = [para_text(s[2]) for s in spans]\n\n    anchor_map = {}\n    for m in RANGE_MARK_RE.finditer(doc_xml):\n        pos, kind, cid = m.start(), m.group(1), m.group(2)\n        for idx, (s, e, _) in enumerate(spans):\n            if s <= pos < e:\n                anchor_map.setdefault(cid, {\"start\": [], \"end\": []})[kind].append(idx)\n                break\n\n    comment_entries = []\n    anchored = set()\n    for c in comments:\n        a = anchor_map.get(c[\"id\"], {\"start\": [], \"end\": []})\n        paras = sorted(set(a[\"start\"]) | set(a[\"end\"]))\n        anchored.add(c[\"id\"])\n        comment_entries.append({\n            **c,\n            \"anchor_paragraphs\": paras,\n            \"anchor_texts\": [texts[i] for i in paras],\n        })\n    for cid, a in anchor_map.items():\n        if cid not in anchored:\n            paras = sorted(set(a[\"start\"]) | set(a[\"end\"]))\n            comment_entries.append({\n                \"id\": cid, \"author\": \"\", \"date\": \"\", \"text\": \"\",\n                \"anchor_paragraphs\": paras,\n                \"anchor_texts\": [texts[i] for i in paras],\n            })\n\n    def neighbor(idx, step):\n        j = idx + step\n        while 0 <= j < len(texts):\n            if texts[j].strip():\n                return {\"index\": j, \"text\": texts[j][:120], \"ppr\": ppr_summary(spans[j][2]),\n                        \"run_format\": run_rpr_summary(spans[j][2])}\n            j += step\n        return None\n\n    empties = []\n    for idx, t in enumerate(texts):\n        if t.strip():\n            continue\n        empties.append({\n            \"index\": idx,\n            \"prev_nonempty\": neighbor(idx, -1),\n            \"next_nonempty\": neighbor(idx, +1),\n        })\n\n    result = {\n        \"source\": src.name,\n        \"paragraph_count\": len(texts),\n        \"comments\": comment_entries,\n        \"empty_paragraphs\": empties,\n    }\n    payload = json.dumps(result, ensure_ascii=False, indent=1) + \"\\n\"\n    if args.out:\n        out = Path(args.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(payload, encoding=\"utf-8\")\n        print(\"paragraphs=%d comments=%d empty=%d -> %s\"\n              % (len(texts), len(comment_entries), len(empties), args.out))\n    else:\n        sys.stdout.write(payload)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/locate_gaps.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792733922779, "responseId": "chatcmpl-1792733922851", "__openclaw": {"runId": "a7f343ca-e4f8-4ee3-aabb-7051df385def"}}}
