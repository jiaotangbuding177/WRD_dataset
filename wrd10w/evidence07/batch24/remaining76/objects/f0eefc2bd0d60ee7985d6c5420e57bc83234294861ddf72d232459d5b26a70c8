{"type": "message", "id": "336a9b58-592f-40b3-8b7d-cfc65d643272", "parentId": "71dff643-abf3-4400-a9b3-a053ce98c792", "timestamp": "2026-10-23T05:42:42.958Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "还有一个遗漏：黄色高亮位于锚点后的空占位符段落上，该段落仍被保留。我会添加 `--drop-empty-after` 参数，以吸收掉紧随锚点之后的空白占位符段落（这是常见情况），并让 `--clear-highlight` 参数也能覆盖它们。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-07e96cf664c84449af0f8394\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call6e910697fc5b472fa20a7ca228880047", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"把补写段落插入 docx 指定位置，继承邻段格式并去除高亮，写回新文件。\n\n用法（原样可执行）:\n  python3 backfill_apply.py <原文档.docx> --insert-after \"锚点段文本子串\" \\\n      --text-file <补充段落.txt> --out <输出.docx> [--copy-format-from \"格式基准段文本子串\"] \\\n      [--clear-highlight] [--drop-empty-after]\n\n行为:\n- 锚点段 = 正文文本包含 --insert-after 子串的段落（须恰好命中一段，多个或零个报错）。\n  新段落逐个插到锚点段之后；--text-file 每个非空行 = 一个新段落。\n- 格式默认继承锚点段的 pPr；指定 --copy-format-from 时改从该段复制 pPr 与首个文字 run\n  的 rPr（如锚点是标题而正文格式应以相邻正文段为准）。\n- --drop-empty-after：删除锚点段之后紧连的空白占位段（标记空缺的空段，可多个）。\n- --clear-highlight：去掉锚点段及上述紧连空白段内所有 w:highlight（清理标记空缺的黄底）。\n  新段落 run 一律不带高亮。批注/修订与其余正文原样保留。\n- 写出后自校验：XML 可解析、逐行核对插入文本已存在，失败退出 2 并删除坏输出。\n\n退出码: 0 成功; 1 参数/定位错误（输出文件不动）; 2 写出后自校验失败。\n\"\"\"\nimport argparse\nimport re\nimport sys\nimport zipfile\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\n\nP_RE = re.compile(r\"<w:p(?:\\s[^>]*)?(?:/>|>.*?</w:p>)\", re.S)\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(\"&apos;\", \"'\"))\n\n\ndef escape(text):\n    return (text.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n                .replace('\"', \"&quot;\"))\n\n\ndef para_text(p_xml):\n    return unescape(\"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p_xml, re.S)))\n\n\ndef find_paragraph(xml, needle):\n    \"\"\"返回正文文本包含 needle 的唯一段落 span；0 或多个命中时报错返回 None。\"\"\"\n    hits = [m for m in P_RE.finditer(xml) if needle in para_text(m.group(0))]\n    if not hits:\n        return None, \"no paragraph contains anchor text: %r\" % needle\n    if len(hits) > 1:\n        texts = [para_text(m.group(0))[:60] for m in hits]\n        return None, \"anchor matches %d paragraphs, extend the text to be unique: %s\" % (len(hits), texts)\n    return hits[0], None\n\n\ndef trailing_empty_spans(xml, anchor_end):\n    \"\"\"锚点段之后紧连的空白占位段 span 列表（遇非空段即停）。\"\"\"\n    spans = []\n    pos = anchor_end\n    while True:\n        m = P_RE.match(xml, pos)\n        if not m or para_text(m.group(0)).strip():\n            break\n        spans.append(m.span())\n        pos = m.end()\n    return spans\n\n\ndef strip_highlight(xml):\n    return re.sub(r\"<w:highlight\\b[^>]*/>\", \"\", xml)\n\n\ndef copy_format(xml, span):\n    \"\"\"取该段的 pPr 与首个文字 run 的 rPr（去高亮）。\"\"\"\n    p_xml = span.group(0)\n    m = re.search(r\"<w:pPr\\b[^>]*>.*?</w:pPr>\", p_xml, re.S)\n    ppr = strip_highlight(m.group(0)) if m else \"\"\n    rpr = \"\"\n    for run in re.finditer(r\"<w:r(?:\\s[^>]*)?>.*?</w:r>\", p_xml, re.S):\n        r_xml = run.group(0)\n        if not re.search(r\"<w:t(?:\\s[^>]*)?>\", r_xml):\n            continue\n        m2 = re.search(r\"<w:rPr\\b[^>]*>.*?</w:rPr>\", r_xml, re.S)\n        if m2:\n            rpr = strip_highlight(m2.group(0))\n        break\n    return ppr, rpr\n\n\ndef build_paragraph(ppr, rpr, text):\n    runs = \"\".join(\"<w:r>%s<w:t xml:space=\\\"preserve\\\">%s</w:t></w:r>\" % (rpr, escape(line))\n                   for line in text.split(\"\\n\"))\n    return \"<w:p>%s%s</w:p>\" % (ppr, runs)\n\n\ndef rewrite_docx(src, doc_xml, out_path):\n    tmp = out_path.with_suffix(out_path.suffix + \".tmp\")\n    with zipfile.ZipFile(src) as zin, zipfile.ZipFile(tmp, \"w\", zipfile.ZIP_DEFLATED) as zout:\n        for item in zin.infolist():\n            if item.filename == \"word/document.xml\":\n                zout.writestr(item, doc_xml)\n            else:\n                zout.writestr(item, zin.read(item.filename))\n    tmp.replace(out_path)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"向 docx 锚点段后插入补写段落（继承格式、去高亮）\")\n    ap.add_argument(\"input\", help=\"原文档 .docx\")\n    ap.add_argument(\"--insert-after\", required=True, help=\"锚点段文本子串，新段落插在其后\")\n    ap.add_argument(\"--text-file\", required=True, help=\"补充段落文本，每个非空行=一个新段落\")\n    ap.add_argument(\"--out\", required=True, help=\"输出 docx 路径\")\n    ap.add_argument(\"--copy-format-from\", help=\"格式基准段文本子串；缺省继承锚点段格式\")\n    ap.add_argument(\"--clear-highlight\", action=\"store_true\",\n                    help=\"去掉锚点段及紧连空白段的 w:highlight\")\n    ap.add_argument(\"--drop-empty-after\", action=\"store_true\",\n                    help=\"删除锚点段后紧连的空白占位段\")\n    args = ap.parse_args()\n    src = Path(args.input)\n    out = Path(args.out)\n    if not src.is_file() or src.suffix.lower() != \".docx\":\n        print(\"backfill_apply error: input not found or not .docx: %s\" % src, file=sys.stderr)\n        return 1\n    tf = Path(args.text_file)\n    if not tf.is_file():\n        print(\"backfill_apply error: text file not found: %s\" % tf, file=sys.stderr)\n        return 1\n    lines = [ln.strip() for ln in tf.read_text(encoding=\"utf-8-sig\").splitlines() if ln.strip()]\n    if not lines:\n        print(\"backfill_apply error: text file has no non-empty lines\", file=sys.stderr)\n        return 1\n    try:\n        doc_xml = zipfile.ZipFile(src).read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n    except (OSError, zipfile.BadZipFile, KeyError) as e:\n        print(\"backfill_apply error: cannot read document.xml: %s\" % e, file=sys.stderr)\n        return 1\n\n    span, err = find_paragraph(doc_xml, args.insert_after)\n    if err:\n        print(\"backfill_apply error: %s\" % err, file=sys.stderr)\n        return 1\n    fmt_span = span\n    if args.copy_format_from:\n        fmt_span, err = find_paragraph(doc_xml, args.copy_format_from)\n        if err:\n            print(\"backfill_apply error: %s\" % err, file=sys.stderr)\n            return 1\n    ppr, rpr = copy_format(doc_xml, fmt_span)\n    new_xml = \"\".join(build_paragraph(ppr, rpr, ln) for ln in lines)\n\n    empties = trailing_empty_spans(doc_xml, span.end())\n    drop_end = empties[-1][1] if (args.drop_empty_after and empties) else span.end()\n    updated = doc_xml[:span.end()] + new_xml + doc_xml[drop_end:]\n    if args.clear_highlight:\n        clear_to = (empties[-1][1] if empties else span.end())\n        updated = (updated[:span.start()]\n                   + strip_highlight(updated[span.start():clear_to])\n                   + updated[clear_to:])\n\n    try:\n        ET.fromstring(updated)\n    except ET.ParseError as e:\n        print(\"backfill_apply error: resulting XML not well-formed: %s\" % e, file=sys.stderr)\n        return 1\n    rewrite_docx(src, updated, out)\n\n    # 自校验：重读输出，逐行核对插入文本存在\n    try:\n        check = zipfile.ZipFile(out).read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n    except (OSError, zipfile.BadZipFile, KeyError) as e:\n        print(\"backfill_apply error: cannot re-read output: %s\" % e, file=sys.stderr)\n        return 2\n    body = \"\\n\".join(para_text(m.group(0)) for m in P_RE.finditer(check))\n    missing = [ln for ln in lines if ln not in body]\n    if missing:\n        out.unlink(missing_ok=True)\n        print(\"backfill_apply error: lines missing after write: %s\" % missing, file=sys.stderr)\n        return 2\n    dropped = len(empties) if (args.drop_empty_after and empties) else 0\n    print(\"inserted %d paragraph(s) after anchor %r, dropped %d empty placeholder(s) -> %s\"\n          % (len(lines), args.insert_after, dropped, out))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/backfill_apply.py"}}], "api": "openai-completions", "pro