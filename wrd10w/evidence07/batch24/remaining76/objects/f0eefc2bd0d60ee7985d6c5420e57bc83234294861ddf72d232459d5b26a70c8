{"type": "message", "id": "2df1f8bb-99c6-48a1-8bd8-257ebbd43920", "parentId": "ece72910-2e0f-4776-a0c1-69c937ce3b78", "timestamp": "2026-10-23T05:36:01.812Z", "message": {"role": "toolResult", "toolCallId": "call3215dcd235104fe29525635ee5cafbbb", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"提取 .docx 正文之外的审查材料：批注、文本框/形状文字、空占位与疑似重复词。\n\n用法（原样可执行）:\n  python3 docx_extras.py <文件.docx> [--out <结果.json>]\n\n方法:\n- 直接解 OOXML zip，读 word/comments.xml（批注：作者/日期/文本，按 id 列出）与\n  word/document.xml 中所有 w:txbxContent 文本框（python-docx 的 paragraphs 会漏\n  掉这些内容，须单独取）。\n- 顺带做两类机械预扫（仅供初筛，最终判断由审查阶段结合上下文确认）：\n  * 相邻重复词（如「股东会股东会」「债务债务」，2字以上中文词直接相连重复）；\n  * 空占位（成对括号内为空、连续问号/空缺下划线，如「（）」「？？」「？亿」）。\n- --out 缺省打印到 stdout。退出码: 0 成功; 2 输入缺失/非 docx/解析失败。\n不联网、不修改输入文件。\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(\"&apos;\", \"'\"))\n\n\ndef paragraphs_from_xml(xml):\n    for p in re.findall(r\"<w:p[ >].*?</w:p>\", xml, re.S):\n        yield \"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p, re.S))\n\n\ndef extract_comments(archive):\n    if \"word/comments.xml\" not in archive.namelist():\n        return []\n    xml = archive.read(\"word/comments.xml\").decode(\"utf-8\", \"replace\")\n    out = []\n    for m in re.finditer(r\"<w:comment\\b[^>]*>\", xml):\n        tag = m.group(0)\n        cid = re.search(r'w:id=\"([^\"]+)\"', tag)\n        author = re.search(r'w:author=\"([^\"]*)\"', tag)\n        date = re.search(r'w:date=\"([^\"]*)\"', tag)\n        end = xml.find(\"</w:comment>\", m.end())\n        if end < 0:\n            continue\n        body = \" \".join(\n            t.strip()\n            for t in (unescape(x) for x in re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", xml[m.end():end], re.S))\n            if t.strip()\n        )\n        out.append({\n            \"id\": cid.group(1) if cid else \"\",\n            \"author\": unescape(author.group(1)) if author else \"\",\n            \"date\": date.group(1) if date else \"\",\n            \"text\": body,\n        })\n    return out\n\n\ndef extract_textboxes(archive):\n    if \"word/document.xml\" not in archive.namelist():\n        return []\n    xml = archive.read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n    out = []\n    for i, tb in enumerate(re.finditer(r\"<w:txbxContent>.*?</w:txbxContent>\", xml, re.S), 1):\n        text = \"\\n\".join(\n            t for t in\n            (unescape(ptext) for ptext in paragraphs_from_xml(tb.group(0)))\n            if t.strip()\n        )\n        if text.strip():\n            out.append({\"index\": i, \"text\": text})\n    return out\n\n\nDUP_WORD = re.compile(r\"([\\u4e00-\\u9fff]{2,})\\1\")\nEMPTY_PLACEHOLDER = re.compile(r\"（\\s*）|\\(\\s*\\)|？{2,}|？[亿万元]|_{3,}\")\n\n\ndef prescan_lines(lines):\n    dups, holes = [], []\n    for lineno, line in enumerate(lines, 1):\n        for m in DUP_WORD.finditer(line):\n            dups.append({\"line\": lineno, \"text\": m.group(0), \"context\": line[max(0, m.start() - 10):m.end() + 10]})\n        for m in EMPTY_PLACEHOLDER.finditer(line):\n            holes.append({\"line\": lineno, \"text\": m.group(0), \"context\": line[max(0, m.start() - 10):m.end() + 10]})\n    return dups, holes\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"提取 docx 批注/文本框并做机械预扫\")\n    ap.add_argument(\"input\", help=\".docx 文件\")\n    ap.add_argument(\"--out\", help=\"输出 JSON 路径；缺省打印 stdout\")\n    args = ap.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError(\"input not found: %s\" % src)\n        if src.suffix.lower() != \".docx\":\n            raise ValueError(\"unsupported input type %s: expected .docx\" % src.suffix)\n        archive = zipfile.ZipFile(src)\n    except (OSError, ValueError, zipfile.BadZipFile) as e:\n        print(\"docx_extras error: %s\" % e, file=sys.stderr)\n        return 2\n    try:\n        comments = extract_comments(archive)\n        textboxes = extract_textboxes(archive)\n        doc_xml = archive.read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n        body_lines = [unescape(ptext) for ptext in paragraphs_from_xml(doc_xml)]\n        dups, holes = prescan_lines(body_lines)\n    finally:\n        archive.close()\n    result = {\n        \"source\": src.name,\n        \"comments\": comments,\n        \"textboxes\": textboxes,\n        \"prescan\": {\"duplicate_words\": dups, \"empty_placeholders\": holes},\n    }\n    payload = json.dumps(result, ensure_ascii=False, indent=1) + \"\\n\"\n    if args.out:\n        out = Path(args.out)\n        out.parent.mkdir(parents=True, exist_ok=True)\n        out.write_text(payload, encoding=\"utf-8\")\n        print(\"comments=%d textboxes=%d dup=%d placeholder=%d -> %s\"\n              % (len(comments), len(textboxes), len(dups), len(holes), args.out))\n    else:\n        sys.stdout.write(payload)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"提取 .docx 正文之外的审查材料：批注、文本框/形状文字、空占位与疑似重复词。\n\n用法（原样可执行）:\n  python3 docx_extras.py <文件.docx> [--out <结果.json>]\n\n方法:\n- 直接解 OOXML zip，读 word/comments.xml（批注：作者/日期/文本，按 id 列出）与\n  word/document.xml 中所有 w:txbxContent 文本框（python-docx 的 paragraphs 会漏\n  掉这些内容，须单独取）。\n- 顺带做两类机械预扫（仅供初筛，最终判断由审查阶段结合上下文确认）：\n  * 相邻重复词（如「股东会股东会」「债务债务」，2字以上中文词直接相连重复）；\n  * 空占位（成对括号内为空、连续问号/空缺下划线，如「（）」「？？」「？亿」）。\n- --out 缺省打印到 stdout。退出码: 0 成功; 2 输入缺失/非 docx/解析失败。\n不联网、不修改输入文件。\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(