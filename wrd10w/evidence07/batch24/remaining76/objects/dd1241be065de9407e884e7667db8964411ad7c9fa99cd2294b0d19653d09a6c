"""Scan a contract document (PDF/TXT/DOCX) for keywords, with context.

Method: PDF is converted to text via pdftotext (a scanned PDF yields empty
output and this script tells you to OCR first); .docx is parsed from the
OOXML zip (document + headers + footers); .txt is read directly. Reports each
keyword occurrence with surrounding context and its line number in the
derived text, so clause locations survive back into the source review.

Exit codes: 0 ok, 2 usage/input error (missing file, no keywords, empty text
layer, unsupported type).
"""
import argparse
import json
import re
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path


def unescape(text):
    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')
                .replace('&quot;', '"').replace('&apos;', "'"))


def pdf_to_text(path):
    with tempfile.NamedTemporaryFile(suffix='.txt', delete=False) as tmp:
        tmp_path = tmp.name
    try:
        proc = subprocess.run(['pdftotext', str(path), tmp_path],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            raise ValueError('pdftotext failed: ' + proc.stderr.strip()[:200])
        text = Path(tmp_path).read_text(encoding='utf-8', errors='replace')
    finally:
        Path(tmp_path).unlink(missing_ok=True)
    if not text.strip():
        raise ValueError('no text layer: likely a scanned PDF; OCR first '
                         '(pdftoppm -r 300 -gray -png, then tesseract -l chi_sim)')
    return text


def docx_to_text_parts(path):
    try:
        archive = zipfile.ZipFile(path)
    except (OSError, zipfile.BadZipFile) as error:
        raise ValueError('cannot open docx: ' + str(error))
    parts = []
    try:
        members = sorted(n for n in archive.namelist()
                         if re.fullmatch(r'word/(document|header\d*|footer\d*)\.xml', n))
        if not members:
            raise ValueError('not a valid docx: no word/document.xml')
        for member in members:
            xml = archive.read(member).decode('utf-8')
            lines = []
            for paragraph in re.findall(r'<w:p[ >].*?</w:p>', xml, re.S):
                lines.append(unescape(''.join(
                    re.findall(r'<w:t[^>]*>(.*?)</w:t>', paragraph, re.S))))
            parts.append((member, '\n'.join(lines)))
    finally:
        archive.close()
    if not any(text.strip() for _, text in parts):
        raise ValueError('docx has no extractable text')
    return parts


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('input', help='contract file: .pdf / .txt / .docx')
    parser.add_argument('--keywords', required=True, help='comma separated keywords')
    parser.add_argument('--out', required=True)
    args = parser.parse_args()
    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]
    if not keywords:
        print('scan_text_keywords error: no keywords given', file=sys.stderr)
        return 2
    src = Path(args.input)
    if not src.is_file():
        print('scan_text_keywords error: input not found: ' + str(src), file=sys.stderr)
        return 2
    suffix = src.suffix.lower()
    try:
        if suffix == '.pdf':
            parts = [('pdf-text-layer', pdf_to_text(src))]
        elif suffix == '.txt':
            text = src.read_text(encoding='utf-8', errors='replace')
            if not text.strip():
                raise ValueError('text file is empty')
            parts = [('text', text)]
        elif suffix == '.docx':
            parts = docx_to_text_parts(src)
        else:
            raise ValueError('unsupported input type ' + suffix
                             + ': expected .pdf / .txt / .docx')
    except ValueError as error:
        print('scan_text_keywords error: ' + str(error), file=sys.stderr)
        return 2
    hits = []
    for member, text in parts:
        lines = text.split('\n')
        for number, line in enumerate(lines, start=1):
            for keyword in keywords:
                start = 0
                while True:
                    index = line.find(keyword, start)
                    if index < 0:
                        break
                    hits.append({'keyword': keyword, 'part': member, 'line': number,
                                 'context': line.strip()[:120]})
                    start = index + len(keyword)
    result = {'source_file': src.name, 'keywords': keywords,
              'parts_scanned': len(parts), 'total': len(hits), 'hits': hits}
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
    print(str(len(hits)) + ' hits for ' + str(len(keywords)) + ' keywords across '
          + str(len(parts)) + ' part(s) -> ' + args.out)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
