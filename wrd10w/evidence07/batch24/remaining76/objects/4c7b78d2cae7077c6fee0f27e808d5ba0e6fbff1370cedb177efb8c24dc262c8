= child.read_bytes()\n        entries.append({\"name\": child.name, \"kind\": \"file\",\n                        \"sha256\": hashlib.sha256(data).hexdigest(), \"bytes\": len(data)})\nnames = [e['name'] for e in entries]\nassert names == sorted(names) and len(names) == len(set(names))\ndigest = hashlib.sha256(json.dumps(entries, ensure_ascii=False, sort_keys=True,\n                                   separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()\nlisting = {\"kind\": \"directory_listing\", \"path\": str(root), \"entries\": entries, \"sha256\": digest}\nfor p in replay['programs']:\n    for c in p['cases']:\n        fp = c.get('fixture_provenance', {})\n        if fp.get('origin') == 'absent_path':\n            fp['parent_directory_pin'] = listing\njson.dump(replay, open('outputs/replay.json', 'w', encoding='utf-8'), ensure_ascii=False, indent=2)\njson.dump(manifest, open('outputs/resource_manifest.json', 'w', encoding='utf-8'), ensure_ascii=False, indent=2)\nprint('replay programs:', [(p['path'], [d['kind'] for d in p['dependencies']]) for p in replay['programs']])\nprint('manifest deps   :', [(r['path'], [d['kind'] for d in r['dependencies']]) for r in manifest['resources']])\nprint('listing entries :', names)\nprint('listing sha256  :', digest)\nEOF"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792610474475, "responseId": "chatcmpl-1792610474541", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "9f489c6f-6c10-47d5-9712-13afcf1dc7f9"}}}
