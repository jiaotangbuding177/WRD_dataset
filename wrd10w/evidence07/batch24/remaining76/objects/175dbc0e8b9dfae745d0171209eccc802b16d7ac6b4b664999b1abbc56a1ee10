{"type": "message", "id": "11abdc8f-5353-4515-b33e-923547ee6a60", "parentId": "cad16134-c187-41ea-80c7-020be346f812", "timestamp": "2026-10-23T19:08:30.692Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call7926adb560f049fe9344f4b756a0ef71", "name": "read", "arguments": {"path": "/workspace/inputs/previous_skill/scripts/render_docx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792782507544, "responseId": "chatcmpl-1792782507588", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "8431a8fc-8277-4d36-b8e6-b76e0fca2296"}}}
{"type": "message", "id": "d6c5f635-74c9-457d-9d86-f73834692e7a", "parentId": "11abdc8f-5353-4515-b33e-923547ee6a60", "timestamp": "2026-10-23T19:08:30.735Z", "message": {"role": "toolResult", "toolCallId": "call7926adb560f049fe9344f4b756a0ef71", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"render_docx.py -- 组织架构部门职能/岗位说明书 docx 渲染器。\n\n用法:\n  python3 render_docx.py build  --in SPEC.json --out OUT.docx [--force]\n  python3 render_docx.py verify --file OUT.docx --in SPEC.json\n\nSPEC 结构见 templates/spec.example.json。支持四种 block:\n  company_overview / dept / job / org_unit(委员会、PMO等机构)\n\n退出码: 0=成功 2=用法或spec错误 3=verify不通过\n\"\"\"\nimport argparse, json, sys\nfrom docx import Document\nfrom docx.shared import Pt, Cm, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\n\nREQUIRED = {\n    \"job\": [\"title\", \"summary\", \"duties\"],\n    \"dept\": [\"name\", \"positioning\", \"functions\"],\n    \"org_unit\": [\"name\", \"positioning\", \"functions\"],\n    \"company_overview\": [\"title\", \"rows\"],\n}\n\n\ndef set_font(run, name, size, bold=False):\n    run.font.name = name\n    run._element.rPr.rFonts.set(qn(\"w:eastAsia\"), name)\n    run.font.size = Pt(size)\n    run.font.bold = bold\n\n\ndef para(doc, text, font, size, bold=False, align=None, space_after=4):\n    p = doc.add_paragraph()\n    if align is not None:\n        p.alignment = align\n    p.paragraph_format.space_after = Pt(space_after)\n    set_font(p.add_run(text), font, size, bold)\n    return p\n\n\ndef cell_text(cell, text, font, size, bold=False):\n    cell.text = \"\"\n    p = cell.paragraphs[0]\n    set_font(p.add_run(str(text)), font, size, bold)\n\n\ndef add_table(doc, header, rows, font_body, font_label, size, widths=None):\n    t = doc.add_table(rows=1 + len(rows), cols=len(header))\n    t.style = \"Table Grid\"\n    t.alignment = WD_TABLE_ALIGNMENT.CENTER\n    for j, h in enumerate(header):\n        cell_text(t.rows[0].cells[j], h, font_label, size, bold=True)\n        if widths:\n            t.rows[0].cells[j].width = Cm(widths[j])\n    for i, row in enumerate(rows, start=1):\n        for j, v in enumerate(row):\n            cell_text(t.rows[i].cells[j], v, font_body, size)\n            if widths:\n                t.rows[i].cells[j].width = Cm(widths[j])\n    return t\n\n\ndef weights_check(duties, where, problems):\n    ws = [d.get(\"weight\") for d in duties]\n    if all(w is not None for w in ws):\n        total = sum(ws)\n        if abs(total - 100) > 0.01:\n            problems.append(f\"{where}: 工作内容权重合计 {total} != 100\")\n    elif any(w is not None for w in ws):\n        problems.append(f\"{where}: 权重要么全填要么全空，当前部分填写\")\n\n\ndef render_job(doc, b, cfg, problems):\n    fb, fl, st, sx = cfg[\"font_body\"], cfg[\"font_label\"], cfg[\"size_body\"], cfg[\"size_title\"]\n    para(doc, \"岗位职责说明书\", fl, sx + 4, bold=True, align=WD_ALIGN_PARAGRAPH.CENTER, space_after=8)\n    info_rows = [\n        [\"职位名称\", b.get(\"title\", \"\"), \"职位代码\", b.get(\"code\", \"\"), \"所属部门\", b.get(\"dept\", \"\")],\n        [\"职系\", b.get(\"family\", \"\"), \"职级\", b.get(\"grade\", \"\"), \"直接上级\", b.get(\"reports_to\", \"\")],\n        [\"薪金\", b.get(\"salary\", \"待定\"), \"日期\", b.get(\"date\", \"\"), \"核准人\", b.get(\"approver\", \"\")],\n    ]\n    add_table(doc, [], [], fb, fl, st)  # placeholder to keep style consistent\n    doc.element.body.remove(doc.tables[-1]._element)  # remove empty; build custom below\n    t = doc.add_table(rows=3, cols=6)\n    t.style = \"Table Grid\"\n    t.alignment = WD_TABLE_ALIGNMENT.CENTER\n    for i, row in enumerate(info_rows):\n        for j, v in enumerate(row):\n            bold = j % 2 == 0\n            cell_text(t.rows[i].cells[j], v, fl if bold else fb, st, bold=bold)\n    para(doc, \"职位概要\", fl, st, bold=True)\n    para(doc, b[\"summary\"], fb, st)\n    para(doc, \"工作内容\", fl, st, bold=True)\n    weights_check(b[\"duties\"], f\"job[{b.get('title','?')}].duties\", problems)\n    for d in b[\"duties\"]:\n        w = d.get(\"weight\")\n        prefix = f\"{w}%  \" if w is not None else \"-  \"\n        para(doc, prefix + d[\"text\"], fb, st)\n    para(doc, \"任职资格\", fl, st, bold=True)\n    q = b.get(\"quals\", {})\n    for key, label in ((\"education\", \"教育背景\"), (\"training\", \"培训经历\"), (\"experience\", \"经验\"),\n                       (\"skills\", \"技能技巧\"), (\"attitude\", \"态度\")):\n        if q.get(key):\n            para(doc, f\"{label}：{q[key]}\", fb, st)\n    cond = b.get(\"conditions\", {})\n    para(doc, \"工作条件\", fl, st, bold=True)\n    para(doc, f\"工作场所：{cond.get('workplace', '')}\", fb, st)\n    para(doc, f\"危险性：{cond.get('hazards', '无')}\", fb, st)\n    if b.get(\"signature\", True):\n        para(doc, \"同意以上岗位职责内容并承诺认真履行。员工签名：______\", fb, st)\n\n\ndef render_dept(doc, b, cfg, problems):\n    fb, fl, st = cfg[\"font_body\"], cfg[\"font_label\"], cfg[\"size_body\"]\n    para(doc, f\"{b['name']}——部门职能说明书\", fl, cfg[\"size_title\"], bold=True, space_after=6)\n    add_table(doc, [\"部门名称\", \"部门代码\", \"所属中心\", \"部门定位\"],\n              [[b[\"name\"], b.get(\"code\", \"\"), b.get(\"center\", \"\"), b[\"positioning\"]]],\n              fb, fl, st)\n    para(doc, \"核心职能\", fl, st, bold=True)\n    ws = [f.get(\"weight\") for f in b[\"functions\"]]\n    if any(w is not None for w in ws):\n        if not all(w is not None for w in ws):\n            problems.append(f\"dept[{b['name']}]: 职能权重要么全填要么全空\")\n        elif abs(sum(ws) - 100) > 0.01:\n            problems.append(f\"dept[{b['name']}]: 职能权重合计 {sum(ws)} != 100\")\n    rows = [[(f\"{f.get('weight')}%\" if f.get('weight') is not None else str(i + 1)),\n             f[\"item\"], f.get(\"detail\", \"\")] for i, f in enumerate(b[\"functions\"])]\n    add_table(doc, [\"序号/权重\", \"职能模块\", \"具体职责\"], rows, fb, fl, st)\n    if b.get(\"staffing\"):\n        para(doc, f\"编制建议：{b['staffing']}\", fb, st)\n    if b.get(\"boundary\"):\n        para(doc, f\"部门边界：{b['boundary']}\", fb, st)\n\n\ndef render_org_unit(doc, b, cfg, problems):\n    fb, fl, st = cfg[\"font_body\"], cfg[\"font_label\"], cfg[\"size_body\"]\n    para(doc, f\"{b['name']}——职能说明书\", fl, cfg[\"size_title\"], bold=True, space_after=6)\n    add_table(doc, [\"机构名称\", \"机构代码\", \"类型\", \"组成成员\", \"议事频次\", \"主要输出物\"],\n              [[b[\"name\"], b.get(\"code\", \"\"), b.get(\"unit_type\", \"\"), b.get(\"members\", \"\"),\n                b.get(\"meeting\", \"\"), b.get(\"outputs\", \"\")]], fb, fl, st)\n    para(doc, \"机构定位\", fl, st, bold=True)\n    para(doc, b[\"positioning\"], fb, st)\n    para(doc, \"核心职能\", fl, st, bold=True)\n    for f in b[\"functions\"]:\n        para(doc, \"◆ \" + f[\"item\"], fb, st, bold=False)\n        for sub in f.get(\"subs\", []):\n            para(doc, \"    - \" + sub, fb, st)\n\n\ndef render_company(doc, b, cfg, problems):\n    fb, fl, st = cfg[\"font_body\"], cfg[\"font_label\"], cfg[\"size_body\"]\n    para(doc, b[\"title\"], fl, cfg[\"size_title\"], bold=True, space_after=6)\n    add_table(doc, [\"项目\", \"内容\"], b[\"rows\"], fb, fl, st)\n\n\nRENDER = {\"job\": render_job, \"dept\": render_dept, \"org_unit\": render_org_unit,\n          \"company_overview\": render_company}\n\n\ndef build(spec_path, out_path, force):\n    with open(spec_path, encoding=\"utf-8\") as f:\n        spec = json.load(f)\n    problems = []\n    doc_cfg = spec.get(\"doc\", {})\n    cfg = {\n        \"font_label\": doc_cfg.get(\"fonts\", {}).get(\"label\", \"黑体\"),\n        \"font_body\": doc_cfg.get(\"fonts\", {}).get(\"body\", \"宋体\"),\n        \"size_body\": doc_cfg.get(\"sizes\", {}).get(\"body\", 9),\n        \"size_title\": doc_cfg.get(\"sizes\", {}).get(\"title\", 12),\n    }\n    doc = Document()\n    section = doc.sections[0]\n    section.page_width, section.page_height = Cm(21), Cm(29.7)\n    title = spec.get(\"doc\", {}).get(\"title\")\n    if title:\n        para(doc, title, cfg[\"font_label\"], cfg[\"size_title\"] + 4, bold=True,\n             align=WD_ALIGN_PARAGRAPH.CENTER, space_after=10)\n    for i, b in enumerate(spec.get(\"blocks\", [])):\n        btype = b.get(\"type\")\n        if btype not in RENDER:\n            print(f\"spec错误: blocks[{i}] type={btype!r} 不是有效类型 {sorted(RENDER)}\", file=sys.stderr)\n            return 2\n        for key in REQUIRED[btype]:\n            if not b.get(key):\n                print(f\"spec错误: blocks[{i}] ({btype}) 缺必填字段 {key}\", file=sys.stderr)\n                return 2\n        RENDER[btype](doc, b, cfg, problems)\n        if i < len(spec[\"blocks\"]) - 1:\n            doc.add_page_break()\n    if problems:\n        print(\"spec警告/错误:\\n\" + \"\\n\".join(problems), file=sys.stderr)\n        return 2\n    import os\n    if os.path.exists(out_path) and not force:\n        print(f\"输出已存在: {out_path}（用 --force 覆盖）\", file=sys.stderr)\n        return 2\n    doc.save(out_path)\n    print(f\"已生成: {out_path}（blocks={len(spec['blocks'])}）\")\n    return 0\n\n\ndef verify(file_path, spec_path):\n    with open(spec_path, encoding=\"utf-8\") as f:\n        spec = json.load(f)\n    doc = Document(file_path)\n    errors = []\n    texts = \"\\n\".join(p.text for p in doc.paragraphs)\n    for t in doc.tables:\n        for row in t.rows:\n            for c in row.cells:\n                texts += \"\\n\" + c.text\n    expect = [(b.get(\"title\") or b.get(\"name\")) for b in spec.get(\"blocks\", [])\n              if b.get(\"type\") in (\"job\", \"dept\", \"org_unit\", \"company_overview\")]\n    for name in expect:\n        if name and name not in texts:\n            errors.append(f\"文档中找不到标题/名称: {name}\")\n    n_job = sum(1 for b in spec[\"blocks\"] if b.get(\"type\") == \"job\")\n    n_sig = texts.count(\"员工签名\")\n    if n_job and n_sig < n_job:\n        errors.append(f\"签收栏数量 {n_sig} < 岗位数 {n_job}\")\n    if not doc.paragraphs:\n        errors.append(\"文档为空\")\n    if errors:\n        print(\"verify不通过:\\n\" + \"\\n\".join(errors), file=sys.stderr)\n        return 3\n    print(f\"verify通过: 段落={len(doc.paragraphs)} 表格={len(doc.tables)} 签收栏={n_sig}\")\n    return 0\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"action\", choices=[\"build\", \"verify\"])\n    ap.add_argument(\"--in\", dest=\"inp\")\n    ap.add_argument(\"--out\", dest=\"out\")\n    ap.add_argument(\"--file\", dest=\"file\")\n    ap.add_argument(\"--force\", action=\"store_true\")\n    a = ap.parse_args()\n    if a.action == \"build\":\n        if not a.inp or not a.out:\n            ap.error(\"build 需要 --in 与 --out\")\n        sys.exit(build(a.inp, a.out, a.force))\n    if not a.file or not a.inp:\n        ap.error(\"verify 需要 --file 与 --in\")\n    sys.exit(verify(a.file, a.inp))\n\n\nif __name__ == \"__main__\":\n    main()\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792782510733, "__openclaw": {"runId": "8431a8fc-8277-4d36-b8e6-b76e0fca2296"}}}
