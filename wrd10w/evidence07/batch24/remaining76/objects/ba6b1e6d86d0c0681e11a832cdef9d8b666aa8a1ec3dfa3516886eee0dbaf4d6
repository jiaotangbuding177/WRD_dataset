ite_text(XCU, encoding=\"utf-8\")\n        outdir = Path(td) / \"conv\"\n        outdir.mkdir()\n        cmd = [\"soffice\", \"-env:UserInstallation=file://%s\" % profile,\n               \"--headless\", \"--norestore\", \"--convert-to\", \"xlsx\",\n               \"--outdir\", str(outdir), str(src.resolve())]\n        try:\n            subprocess.run(cmd, check=True, capture_output=True, timeout=300)\n        except (subprocess.SubprocessError, OSError) as e:\n            print(\"soffice 重算失败: %s\" % e, file=sys.stderr)\n            return 3\n        conv = outdir / (src.stem + \".xlsx\")\n        if not conv.is_file():\n            print(\"soffice 未产出重算文件\", file=sys.stderr)\n            return 3\n        shutil.copy2(conv, out)\n\n    # 验证：所有公式单元格应有缓存值\n    wb_f = load_workbook(out, data_only=False)\n    wb_v = load_workbook(out, data_only=True)\n    n_formula = n_missing = 0\n    missing_samples = []\n    for ws_f, ws_v in zip(wb_f.worksheets, wb_v.worksheets):\n        for row in ws_f.iter_rows():\n            for c in row:\n                if c.data_type == \"f\" or (isinstance(c.value, str) and c.value.startswith(\"=\")):\n                    n_formula += 1\n                    cached = ws_v[c.coordinate].value\n                    if cached is None:\n                        n_missing += 1\n                        if len(missing_samples) < 10:\n                            missing_samples.append(\"%s!%s = %s\" % (ws_f.title, c.coordinate, c.value))\n    print(\"重算完成 -> %s；公式单元格 %d 个，缺缓存值 %d 个\" % (out, n_formula, n_missing))\n    if n_missing:\n        for m in missing_samples:\n            print(\"  缓存缺失: \" + m, file=sys.stderr)\n        return 3\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n", "path": "/workspace/outputs/skill/scripts/recalc_xlsx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": 