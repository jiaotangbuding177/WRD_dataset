{"type": "message", "id": "ace9a881-accd-461a-aabe-384ae42c488c", "parentId": "e9cb2deb-f165-4120-a3e5-b17abfd7e010", "timestamp": "2026-10-23T18:16:18.787Z", "message": {"role": "toolResult", "toolCallId": "callb19252c395464d3c8c663bbef301a54e", "toolName": "exec", "content": [{"type": "text", "text": "\"\"\"Extract plain text from a .docx contract into a JSON file, with\nkeyword/window access for long documents.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> paragraph, unescape XML entities. Default mode writes {source_file,\nparagraphs, text} JSON to --out. Long documents: use --grep to print only\nmatching paragraph numbers plus a bounded text window, or --lines START-END to\nre-read a known window, instead of loading the whole text into context.\nOnly .docx is supported; scanned PDFs must be OCR'd first.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--out', help='full extraction JSON; omit when using --grep/--lines')\n    parser.add_argument('--grep', help='locate keyword: print matching paragraph numbers + bounded text windows only')\n    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')\n    parser.add_argument('--lines', help='print only paragraph range like 120-140 (1-based, inclusive)')\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph\n    # numbers drift against locate_gaps/fill_cell body indices\n    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    total = len(paragraphs)\n\n    def print_window(start, end):\n        for i in range(max(0, start - 1), min(total, end)):\n            print('p' + str(i + 1) + ': ' + paragraphs[i])\n\n    if args.lines:\n        match = re.fullmatch(r'(\\d+)-(\\d+)', args.lines.strip())\n        if not match:\n            print('extract_contract_text error: --lines expects START-END like 120-140', file=sys.stderr)\n            return 2\n        start, end = int(match.group(1)), int(match.group(2))\n        if start < 1 or end < start:\n            print('extract_contract_text error: --lines range invalid', file=sys.stderr)\n            return 2\n        print_window(start, end)\n        return 0\n    if args.grep is not None:\n        hits = [i + 1 for i, text in enumerate(paragraphs) if args.grep in text]\n        if not hits:\n            print('no match for: ' + args.grep)\n            return 1\n        width = max(0, args.context)\n        windows = []\n        for hit in hits:\n            start, end = hit - width, hit + width\n            if windows and start <= windows[-1][1] + 1:\n                windows[-1][1] = end\n            else:\n                windows.append([start, end])\n        print('total ' + str(total) + ' paragraphs; hit ' + str(len(hits)) + ': ' +\n              ', '.join(str(h) for h in hits))\n        for start, end in windows:\n            print('--- window p' + str(start) + '-p' + str(end) + ' ---')\n            print_window(start, end)\n        return 0\n    if not args.out:\n        print('extract_contract_text error: --out required without --grep/--lines', file=sys.stderr)\n        return 2\n    result = {'source_file': src.name, 'paragraphs': total, 'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(total) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n=====BACKFILL\n#!/usr/bin/env python3\n\"\"\"把补写段落插入 docx 指定位置，继承邻段格式并去除高亮，写回新文件。\n\n用法（原样可执行）:\n  python3 backfill_apply.py <原文档.docx> (--insert-after \"锚点段文本子串\" |\n      --insert-before \"锚点段文本子串\") --text-file <补充段落.txt> --out <输出.docx>\n      [--copy-format-from \"格式基准段文本子串\"] [--clear-highlight] [--drop-empty-after]\n\n行为:\n- 锚点段 = 正文文本包含锚点子串的段落（须恰好命中一段，多个或零个报错）。\n  --insert-after：新段落逐个插到锚点段之后；--insert-before：插到锚点段之前\n  （用于表格之后/下一节标题之前的章节级插入：锚定下一节标题，新段落落表后正文区）。\n  --text-file 每个非空行 = 一个新段落。\n- 格式默认继承锚点段的 pPr；指定 --copy-format-from 时改从该段复制 pPr 与首个文字 run\n  的 rPr（如锚点是标题而正文格式应以相邻正文段为准）。\n- --drop-empty-after：after 模式删除锚点段之后紧连的空白占位段；before 模式删除锚点段\n  之前紧连的空白占位段（标记空缺的空段，可多个）。\n- --clear-highlight：去掉锚点段及上述紧连空白段内所有 w:highlight（清理标记空缺的黄底）。\n  新段落 run 一律不带高亮。批注/修订与其余正文原样保留。\n- 写出后自校验：XML 可解析、逐行核对插入文本已存在，失败退出 2 并删除坏输出。\n\n退出码: 0 成功; 1 参数/定位错误（输出文件不动）; 2 写出后自校验失败。\n\"\"\"\nimport argparse\nimport re\nimport sys\nimport zipfile\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\n\nP_RE = re.compile(r\"<w:p(?:\\s[^>]*)?(?:/>|>.*?</w:p>)\", re.S)\n\n\ndef unescape(text):\n    return (text.replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\")\n                .replace(\"&quot;\", '\"').replace(\"&apos;\", \"'\"))\n\n\ndef escape(text):\n    return (text.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n                .replace('\"', \"&quot;\"))\n\n\ndef para_text(p_xml):\n    return unescape(\"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p_xml, re.S)))\n\n\ndef find_paragraph(xml, needle):\n    \"\"\"返回正文文本包含 needle 的唯一段落 span；0 或多个命中时报错返回 None。\"\"\"\n    hits = [m for m in P_RE.finditer(xml) if needle in para_text(m.group(0))]\n    if not hits:\n        return None, \"no paragraph contains anchor text: %r\" % needle\n    if len(hits) > 1:\n        texts = [para_text(m.group(0))[:60] for m in hits]\n        return None, \"anchor matches %d paragraphs, extend the text to be unique: %s\" % (len(hits), texts)\n    return hits[0], None\n\n\ndef trailing_empty_spans(xml, anchor_end):\n    \"\"\"锚点段之后紧连的空白占位段 span 列表（遇非空段即停）。\"\"\"\n    spans = []\n    pos = anchor_end\n    while True:\n        m = P_RE.match(xml, pos)\n        if not m or para_text(m.group(0)).strip():\n            break\n        spans.append(m.span())\n        pos = m.end()\n    return spans\n\n\ndef leading_empty_spans(xml, anchor_start):\n    \"\"\"锚点段之前紧连的空白占位段 span 列表（遇非空段即停，向前扫）。\"\"\"\n    spans = []\n    pos = anchor_start\n    while True:\n        prev = None\n        for m in P_RE.finditer(xml):\n            if m.end() == pos:\n                prev = m\n                break\n            if m.end() > pos:\n                break\n        if prev is None or para_text(prev.group(0)).strip():\n            break\n        spans.append(prev.span())\n        pos = prev.start()\n    return spans\n\n\ndef strip_highlight(xml):\n    return re.sub(r\"<w:highlight\\b[^>]*/>\", \"\", xml)\n\n\ndef copy_format(xml, span):\n    \"\"\"取该段的 pPr 与首个文字 run 的 rPr（去高亮）。\"\"\"\n    p_xml = span.group(0)\n    m = re.search(r\"<w:pPr\\b[^>]*>.*?</w:pPr>\", p_xml, re.S)\n    ppr = strip_highlight(m.group(0)) if m else \"\"\n    rpr = \"\"\n    for run in re.finditer(r\"<w:r(?:\\s[^>]*)?>.*?</w:r>\", p_xml, re.S):\n        r_xml = run.group(0)\n        if not re.search(r\"<w:t(?:\\s[^>]*)?>\", r_xml):\n            continue\n        m2 = re.search(r\"<w:rPr\\b[^>]*>.*?</w:rPr>\", r_xml, re.S)\n        if m2:\n            rpr = strip_highlight(m2.group(0))\n        break\n    return ppr, rpr\n\n\ndef build_paragraph(ppr, rpr, text):\n    runs = \"\".join(\"<w:r>%s<w:t xml:space=\\\"preserve\\\">%s</w:t></w:r>\" % (rpr, escape(line))\n                   for line in text.split(\"\\n\"))\n    return \"<w:p>%s%s</w:p>\" % (ppr, runs)\n\n\ndef rewrite_docx(src, doc_xml, out_path):\n    tmp = out_path.with_suffix(out_path.suffix + \".tmp\")\n    with zipfile.ZipFile(src) as zin, zipfile.ZipFile(tmp, \"w\", zipfile.ZIP_DEFLATED) as zout:\n        for item in zin.infolist():\n            if item.filename == \"word/document.xml\":\n                zout.writestr(item, doc_xml)\n            else:\n                zout.writestr(item, zin.read(item.filename))\n    tmp.replace(out_path)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"向 docx 锚点段后插入补写段落（继承格式、去高亮）\")\n    ap.add_argument(\"input\", help=\"原文档 .docx\")\n    ap.add_argument(\"--insert-after\", help=\"锚点段文本子串，新段落插在其后\")\n    ap.add_argument(\"--insert-before\", help=\"锚点段文本子串，新段落插在其前（如锚定下一节标题）\")\n    ap.add_argument(\"--text-file\", required=True, help=\"补充段落文本，每个非空行=一个新段落\")\n    ap.add_argument(\"--out\", required=True, help=\"输出 docx 路径\")\n    ap.add_argument(\"--copy-format-from\", help=\"格式基准段文本子串；缺省继承锚点段格式\")\n    ap.add_argument(\"--clear-highlight\", action=\"store_true\",\n                    help=\"去掉锚点段及紧连空白段的 w:highlight\")\n    ap.add_argument(\"--drop-empty-after\", action=\"store_true\",\n                    help=\"删除锚点段后紧连的空白占位段\")\n    args = ap.parse_args()\n    if bool(args.insert_after) == bool(args.insert_before):\n        print(\"backfill_apply error: exactly one of --insert-after / --insert-before is required\", file=sys.stderr)\n        return 1\n    before = args.insert_before is not None\n    needle = args.insert_before if before else args.insert_after\n    src_path = Path(args.input)\n    out = Path(args.out)\n    if not src_path.is_file() or src_path.suffix.lower() != \".docx\":\n        print(\"backfill_apply error: input not found or not .docx: %s\" % src_path, file=sys.stderr)\n        return 1\n    tf = Path(args.text_file)\n    if not tf.is_file():\n        print(\"backfill_apply error: text file not found: %s\" % tf, file=sys.stderr)\n        return 1\n    lines = [ln.strip() for ln in tf.read_text(encoding=\"utf-8-sig\").splitlines() if ln.strip()]\n    if not lines:\n        print(\"backfill_apply error: text file has no non-empty lines\", file=sys.stderr)\n        return 1\n    try:\n        doc_xml = zipfile.ZipFile(src_path).read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n    except (OSError, zipfile.BadZipFile, KeyError) as e:\n        print(\"backfill_apply error: cannot read document.xml: %s\" % e, file=sys.stderr)\n        return 1\n\n    span, err = find_paragraph(doc_xml, needle)\n    if err:\n        print(\"backfill_apply error: %s\" % err, file=sys.stderr)\n        return 1\n    fmt_span = span\n    if args.copy_format_from:\n        fmt_span, err = find_paragraph(doc_xml, args.copy_format_from)\n        if err:\n            print(\"backfill_apply error: %s\" % err, file=sys.stderr)\n            return 1\n    ppr, rpr = copy_format(doc_xml, fmt_span)\n    new_xml = \"\".join(build_paragraph(ppr, rpr, ln) for ln in lines)\n\n    if before:\n        empties = leading_empty_spans(doc_xml, span.start())\n        drop_start = empties[0][0] if (args.drop_empty_after and empties) else span.start()\n        updated = doc_xml[:drop_start] + new_xml + doc_xml[drop_start:]\n        if args.clear_highlight:\n            clear_from = (empties[0][0] if empties else span.start())\n            updated = (updated[:clear_from]\n                       + strip_highlight(updated[clear_from:span.end()])\n                       + updated[span.end():])\n    else:\n        empties = trailing_empty_spans(doc_xml, span.end())\n        drop_end = empties[-1][1] if (args.drop_empty_after and empties) else span.end()\n        updated = doc_xml[:span.end()] + new_xml + doc_xml[drop_end:]\n        if args.clear_highlight:\n            clear_to = (empties[-1][1] if empties else span.end())\n            updated = (updated[:span.start()]\n                       + strip_highlight(updated[span.start():clear_to])\n                       + updated[clear_to:])\n\n    try:\n        ET.fromstring(updated)\n    except ET.ParseError as e:\n        print(\"backfill_apply error: resulting XML not well-formed: %s\" % e, file=sys.stderr)\n        return 1\n    rewrite_docx(src_path, updated, out)\n\n    # 自校验：重读输出，逐行核对插入文本存在\n    try:\n        check = zipfile.ZipFile(out).read(\"word/document.xml\").decode(\"utf-8\", \"replace\")\n    except (OSError, zipfile.BadZipFile, KeyError) as e:\n        print(\"backfill_apply error: cannot re-read output: %s\" % e, file=sys.stderr)\n        return 2\n    body = \"\\n\".join(para_text(m.group(0)) for m in P_RE.finditer(check))\n    missing = [ln for ln in lines if ln not in body]\n    if missing:\n        out.unlink(missing_ok=True)\n        print(\"backfill_apply error: lines missing after write: %s\" % missing, file=sys.stderr)\n        return 2\n    dropped = len(empties) if (args.drop_empty_after and empties) else 0\n    side = \"before\" if before else \"after\"\n    print(\"inserted %d paragraph(s) %s anchor %r, dropped %d empty placeholder(s) -> %s\"\n          % (len(lines), side, needle, dropped, out))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["status", "exitCode", "exitSignal", "exitReason", "durationMs", "aggregated", "noOutputTimedOut", "cwd"], "status": "complet