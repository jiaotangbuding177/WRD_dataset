     ]\n\n    return {\n        \"tables\": as_list(tables),\n        \"figures\": as_list(figures),\n        \"tables_total\": len(tables),\n        \"figures_total\": len(figures),\n        \"numeric_lines\": numeric_lines,\n        \"numbers_total\": numbers_total,\n        \"chars\": len(text),\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=\"扫描论文文本中的表/图引用与数值\")\n    parser.add_argument(\"input\", help=\"已提取的论文文本（.txt/.md）\")\n    parser.add_argument(\"--out\", required=True, help=\"输出 scan.json 路径\")\n    args = parser.parse_args(argv)\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError(\"input not found: \" + str(src))\n        if src.suffix.lower() not in SUPPORTED:\n            raise ValueError(\"unsupported input type \" + src.suffix + \": expected .txt or .md\")\n        try:\n            text = src.read_text(encoding=\"utf-8\")\n        except UnicodeError as error:\n            raise ValueError(\"input is not valid UTF-8 text: \" + str(error))\n    except (OSError, ValueError) as error:\n        print(\"scan_numeric_refs error: \" + str(error), file=sys.stderr)\n        return 2\n    result = scan_text(text)\n    result[\"source\"] = src.name\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=1) + \"\\n\", encoding=\"utf-8\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"扫描已提取的论文文本，产出表/图引用与数值出现清单（供一致性核对与报告引用）。\n\n用法（原样可执行）:\n  python3 scan_numeric_refs.py <提取文本.txt|.md> --out <scan.json>\n\n方法:\n- 逐行扫描，识别 表X(-Y)/Table X、图X(-Y)/Figure X/Fig.X 引用并记录行号；\n- 统计含数值的行数与数值总个数（整数/小数）；\n- 输出 JSON：tables/figures（按引用串排序，mentions 为升序行号）、\n  tables_total、figures_total、numeric_lines、numbers_total、chars。\n- 退出码: 0 成功（静默，结果只写 --out 文件）；2 输入缺失/类型不支持/无法读取。\n不联网、不修改输入文件；不判定一致性结论，结论由审查阶段结合源数据判断。\n