{"type": "message", "id": "55faa1e1-d8ae-476c-916a-2ceb58462251", "parentId": "fcfafaf0-9732-4fbd-8221-915ab5c20811", "timestamp": "2026-10-22T20:00:52.837Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "callab568bca9ad1497a99e0975a56c2c24e", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"校验概念验证报告的量化评分一致性。\n\n用法（原样可执行）:\n  python3 check_scores.py <报告.md> [--stale \"32分,68分,32/100\"] [--expect-total 70] [--out check.json]\n\n检查项:\n1. 评分表各行指标得分之和 == 总分行声明分数（历史上两次出现加总不一致：50 vs 63、67 vs 70）。\n2. 指标满分列之和 == 总分满分（通常 100）。\n3. --expect-total N：总分行分数等于用户要求的分数。\n4. --stale：全文不得残留旧分数字符串（改分后常见残留，须清零）。\n\n识别的表格形式: | 指标 | 得分 | 满分 | 说明 | 或 | 指标 | N/M | 说明 |；总分行第一列含\"总分\"，\n分数取行内 \"N/M\" 模式，否则取前两个纯数字单元格（得分在前）。\n退出码: 0 全部通过; 2 输入缺失; 3 有检查失败（明细同时打印与写 --out）。\n\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport sys\n\nBOLD = re.compile(r\"\\*{1,2}\")\nRATIO = re.compile(r\"(\\d+)\\s*/\\s*(\\d+)\")\nPURE_NUM = re.compile(r\"^\\*{0,2}(\\d+(?:\\.\\d+)?)\\*{0,2}$\")\n\n\ndef clean(cell):\n    return BOLD.sub(\"\", cell).strip()\n\n\ndef parse_tables(text):\n    tables, cur = [], []\n    for lineno, raw in enumerate(text.splitlines(), 1):\n        s = raw.strip()\n        if s.startswith(\"|\") and s.count(\"|\") >= 2:\n            cells = [c.strip() for c in s.strip(\"|\").split(\"|\")]\n            if all(set(c) <= set(\"-: \") and \"-\" in c for c in cells):\n                continue  # 分隔行\n            cur.append((lineno, cells))\n        elif cur:\n            tables.append(cur)\n            cur = []\n    if cur:\n        tables.append(cur)\n    return tables\n\n\ndef extract_scores(text):\n    indicators, totals = [], []\n    for table in parse_tables(text):\n        header = table[0][1] if table else []\n        if not any(\"指标\" in clean(c) or \"维度\" in clean(c) for c in header):\n            continue\n        named = {clean(c): i for i, c in enumerate(header)}\n        for lineno, cells in table[1:]:\n            name = clean(cells[0]) if cells else \"\"\n            rownums = []\n            for c in cells[1:]:\n                m = RATIO.search(c)\n                if m:\n                    rownums = [(int(m.group(1)), int(m.group(2)))]\n                    break\n            if not rownums:\n                nums = []\n                if \"得分\" in named and named[\"得分\"] < len(cells):\n                    m = PURE_NUM.match(cells[named[\"得分\"]])\n                    if m:\n                        nums.append(float(m.group(1)))\n                if \"满分\" in named and named[\"满分\"] < len(cells):\n                    m = PURE_NUM.match(cells[named[\"满分\"]])\n                    if m:\n                        nums.append(float(m.group(1)))\n                if not nums:\n                    for c in cells[1:]:\n                        m = PURE_NUM.match(c)\n                        if m:\n                            nums.append(float(m.group(1)))\n                        if len(nums) == 2:\n                            break\n                if nums:\n                    rownums = [(nums[0], nums[1] if len(nums) > 1 else None)]\n            if \"总分\" in name and rownums:\n                totals.append({\"line\": lineno, \"name\": name, \"score\": rownums[0][0],\n                               \"max\": rownums[0][1]})\n            elif rownums and name:\n                indicators.append({\"line\": lineno, \"name\": name, \"score\": rownums[0][0],\n                                   \"max\": rownums[0][1]})\n    return indicators, totals\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser(description=\"评分一致性校验\")\n    ap.add_argument(\"input\", help=\"报告 .md 路径\")\n    ap.add_argument(\"--stale\", default=\"\", help=\"逗号分隔的旧分数字符串，须全文清零\")\n    ap.add_argument(\"--expect-total\", type=float, default=None, help=\"用户要求的总分\")\n    ap.add_argument(\"--out\", default=None, help=\"结果 JSON 输出路径\")\n    args = ap.parse_args(argv)\n    if not os.path.isfile(args.input):\n        pr