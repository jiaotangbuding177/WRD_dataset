{"type": "message", "id": "14a686f8-0a6c-41d3-9d27-e0c7e02b7449", "parentId": "988cfbf3-876c-4948-8016-39c8ae10873d", "timestamp": "2026-10-22T19:59:02.247Z", "message": {"role": "toolResult", "toolCallId": "called246dd60fa94f3b8ebf30ce71a2b62e", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"Export a news digest markdown file as .md copy or .docx document.\n\nUsage:\n  python export_digest.py DIGEST.md --format md|docx --out OUTPUT [--engine auto|pandoc|builtin]\n\n--format md    : normalized copy (UTF-8, single trailing newline).\n--format docx  : Word document. Engine auto tries pandoc first (best fidelity:\n                 real tables/lists/headings); falls back to the built-in\n                 stdlib generator (real w:tbl tables, bold headings, bullets)\n                 when pandoc is missing or fails.\nEvery produced docx is re-opened and parsed before exit; the command fails\nloudly (exit 2, stderr 'export_digest_error: ...') instead of writing a\nbroken file. The input file is never modified.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport shutil\nimport subprocess\nimport sys\nimport zipfile\nfrom pathlib import Path\nfrom xml.sax.saxutils import escape\n\nCT = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n    '<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">'\n    '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>'\n    '<Default Extension=\"xml\" ContentType=\"application/xml\"/>'\n    '<Override PartName=\"/word/document.xml\" '\n    'ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>'\n    '</Types>'\n)\nRELS = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n    '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">'\n    '<Relationship Id=\"rId1\" '\n    'Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" '\n    'Target=\"word/document.xml\"/>'\n    '</Relationships>'\n)\n\n\ndef fail(message):\n    print('export_digest_error: ' + message, file=sys.stderr)\n    raise SystemExit(2)\n\n\ndef paragraph(text, bold=False, size=22):\n    run_props = '<w:b/>' if bold else ''\n    if size != 22:\n        run_props += '<w:sz w:val=\"%d\"/><w:szCs w:val=\"%d\"/>' % (size, size)\n    return (\n        '<w:p><w:r><w:rPr>' + run_props + '</w:rPr>'\n        '<w:t xml:space=\"preserve\">' + escape(text) + '</w:t></w:r></w:p>'\n    )\n\n\ndef table_row_cells(line):\n    stripped = line.strip()\n    if stripped.startswith('|'):\n        stripped = stripped[1:]\n    if stripped.endswith('|'):\n        stripped = stripped[:-1]\n    return [c.strip() for c in stripped.split('|')]\n\n\ndef is_separator_row(cells):\n    return bool(cells) and all(\n        set(c) <= set('-: ') and any(ch in c for ch in '-') for c in cells\n    )\n\n\ndef table_xml(rows):\n    grid = ''.join('<w:gridCol/>' for _ in range(max(len(r) for r in rows)))\n    body = []\n    for i, cells in enumerate(rows):\n        bold = i == 0\n        tcs = ''.join(\n            '<w:tc><w:tcPr/>' + paragraph(c, bold=bold) + '</w:tc>' for c in cells\n        )\n        body.append('<w:tr>' + tcs + '</w:tr>')\n    return (\n        '<w:tbl><w:tblPr><w:tblBorders>'\n        + ''.join(\n            '<w:%s w:val=\"single\" w:sz=\"4\" w:color=\"999999\"/>' % side\n            for side in ('top', 'left', 'bottom', 'right', 'insideH', 'insideV')\n        )\n        + '</w:tblBorders></w:tblPr><w:tblGrid>' + grid + '</w:tblGrid>'\n        + ''.join(body) + '</w:tbl>'\n    )\n\n\ndef document_xml(text):\n    body = []\n    lines = text.splitlines()\n    i = 0\n    while i < len(lines):\n        line = lines[i].rstrip()\n        if line.lstrip().startswith('|') and line.count('|') >= 2:\n            rows = []\n            while i < len(lines) and lines[i].lstrip().startswith('|'):\n                cells = table_row_cells(lines[i])\n                if not is_separator_row(cells):\n                    rows.append(cells)\n                i += 1\n            if rows:\n                body.append(table_xml(rows))\n            continue\n        if not line.strip():\n            i += 1\n            continue\n        if line.startswith('### '):\n            body.append(paragraph(line[4:], bold=True, size=26))\n        elif line.startswith('## '):\n            body.append(paragraph(line[3:], bold=True, size=30))\n        elif line.startswith('# '):\n            body.append(paragraph(line[2:], bold=True, size=36))\n        elif line.startswith('- ') or line.startswith('* '):\n            body.append(paragraph('\\u2022 ' + line[2:]))\n        else:\n            body.append(paragraph(line))\n        i += 1\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n        '<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">'\n        '<w:body>' + ''.join(body) + '<w:sectPr/></w:body></w:document>'\n    )\n\n\ndef write_builtin_docx(text, out):\n    with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as package:\n        package.writestr('[Content_Types].xml', CT)\n        package.writestr('_rels/.rels', RELS)\n        package.writestr('word/document.xml', document_xml(text))\n\n\ndef verify_docx(path):\n    try:\n        with zipfile.ZipFile(path) as z:\n            if z.testzip() is not None:\n                return 'corrupt zip entry'\n            xml = z.read('word/document.xml').decode('utf-8')\n    except Exception as exc:  # noqa: BLE001\n        return 'unreadable docx: %s' % exc\n    if '<w:body' not in xml or 'w:document' not in xml:\n        return 'document.xml missing body'\n    return None\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        prog='export_digest.py',\n        description='Export a news digest markdown file as .md copy or .docx document.',\n    )\n    parser.add_argument('input', help='digest markdown document')\n    parser.add_argument('--format', default='md', choices=('md', 'docx'),\n                        help='output format (default: md)')\n    parser.add_argument('--out', required=True, help='output file path')\n    parser.add_argument('--engine', default='auto', choices=('auto', 'pandoc', 'builtin'),\n                        help='docx engine (default: auto = pandoc then builtin)')\n    args = parser.parse_args()\n\n    source = Path(args.input)\n    if not source.is_file():\n        fail('digest input not found: %s' % args.input)\n    try:\n        text = source.read_text(encoding='utf-8-sig')\n    except UnicodeError:\n        fail('digest input is not valid UTF-8 text: %s' % args.input)\n    if not text.endswith('\\n'):\n        text += '\\n'\n\n    out = Path(args.out)\n    if str(out.parent) not in ('', '.'):\n        try:\n            out.parent.mkdir(parents=True, exist_ok=True)\n        except OSError as exc:\n            fail('output directory not writable: %s (%s)' % (out.parent, exc))\n\n    if args.format == 'md':\n        try:\n            out.write_text(text, encoding='utf-8')\n        except OSError as exc:\n            fail('cannot write output: %s (%s)' % (out, exc))\n        print('exported md digest to %s' % out)\n        return 0\n\n    notes = []\n    if args.engine in ('auto', 'pandoc') and shutil.which('pandoc'):\n        proc = subprocess.run(\n            ['pandoc', '-f', 'gfm', '-t', 'docx', '-o', str(out), str(source)],\n            capture_output=True, text=True,\n        )\n        if proc.returncode == 0:\n            problem = verify_docx(out)\n            if problem is None:\n                print('exported docx digest to %s (pandoc)' % out)\n                return 0\n            notes.append('pandoc output failed verification: %s' % problem)\n        else:\n            notes.append('pandoc failed: %s' % proc.stderr.strip()[:200])\n    elif args.engine == 'pandoc':\n        fail('pandoc requested but not found on PATH')\n\n    write_builtin_docx(text, out)\n    problem = verify_docx(out)\n    if problem is not None:\n        fail('generated docx failed verification: %s' % problem)\n    suffix = (' (%s; used builtin generator)' % '; '.join(notes)) if notes else ' (builtin generator)'\n    print('exported docx digest to %s%s' % (out, suffix))\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"Export a news digest markdown file as .md copy or .docx document.\n\nUsage:\n  python export_digest.py DIGEST.md --format md|docx --out OUTPUT [--engine auto|pandoc|builtin]\n\n--format md    : normalized copy (UTF-8, single trailing newline).\n--format docx  : Word document. Engine auto tries pandoc first (best fidelity:\n                 real tables/lists/headings); falls back to the built-in\n                 stdlib generator (real w:tbl tables, bold headings, bullets)\n                 when pandoc is missing or fails.\nEvery produced docx is re-opened and parsed before exit; the command fails\nloudly (exit 2, stderr 'export_digest_error: ...') instead of writing a\nbroken file. The input file is never modified.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport shutil\nimport subprocess\nimport sys\nimport zipfile\nfrom pathlib import Path\nfrom xml.sax.saxutils import escape\n\nCT = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n    '<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">'\n    '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>'\n    '<Default Extension=\"xml\" ContentType=\"application/xml\"/>'\n    '<Override PartName=\"/word/document.xml\" '\n    'ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>'\n    '</Types>'\n)\nRELS = (\n    '<?xml versi