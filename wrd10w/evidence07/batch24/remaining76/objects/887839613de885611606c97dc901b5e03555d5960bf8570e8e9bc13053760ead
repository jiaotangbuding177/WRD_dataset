     fail(f\"path does not exist: {raw}\")\n    if not files:\n        fail(\"no PNG/JPEG images found in the given paths\")\n    return files\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Merge page images into a one-image-per-page PDF.\")\n    parser.add_argument(\"paths\", nargs=\"+\",\n                        help=\"image files or directories (directories sorted by name)\")\n    parser.add_argument(\"--out\", required=True, help=\"output PDF path\")\n    args = parser.parse_args()\n\n    files = collect(args.paths)\n    frames = []\n    for image_path in files:\n        try:\n            data = image_path.read_bytes()\n        except OSError as error:\n            fail(f\"cannot read {image_path}: {error}\")\n        if image_format(data) is None:\n            fail(f\"not a PNG/JPEG file: {image_path}\")\n        try:\n            frame = Image.open(image_path)\n            frame.load()\n        except OSError as error:\n            fail(f\"cannot decode {image_path}: {error}\")\n        frames.append(frame.convert(\"RGB\"))\n\n    out = Path(args.out)\n    try:\n        if out.parent and not out.parent.exists():\n            out.parent.mkdir(parents=True, exist_ok=True)\n        first, rest = frames[0], frames[1:]\n        first.save(str(out), \"PDF\", save_all=True, append_images=rest)\n    except OSError as error:\n        fail(f\"cannot write pdf file: {error}\")\n    print(f\"{out} ({len(frames)} pages)\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"Merge page images (PNG/JPEG) into one PDF, one full page per image.\n\nMethod: collect image files from the given paths (files or directories;\ndirectories are scanned and sorted by filename), validate each is a real PNG\nor JPEG by magic bytes, then write a PDF whose page order and native pixel\nsize match the images. Used to deliver image-page decks as a catalog 