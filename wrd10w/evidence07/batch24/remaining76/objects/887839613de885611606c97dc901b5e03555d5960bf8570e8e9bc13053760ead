le\", \"\")).strip():\n        fail(\"spec must be a JSON object with non-empty 'title'\")\n    return spec\n\n\ndef draw_centered(draw, y, text, font, color, width):\n    left, top, right, bottom = draw.textbbox((0, 0), text, font=font)\n    draw.text(((width - (right - left)) // 2, y), text, font=font, fill=color)\n    return bottom - top\n\n\n[92 more lines in file. Use offset=61 to continue.]"}], "details": {"kind": "truncated", "content": "#!/usr/bin/env python3\n\"\"\"程序化封面/标题页：背景图压暗 + 中文标题 + 副标题 + 多列清单 + 底部信息。\n\n中文一律用本机 Noto Sans CJK 真字体渲染，零乱码（生图模型画中文必乱码）。\n输入：规格 JSON + 可选背景图；输出：PNG 封面页（再交 images_to_pdf.py 合册）。\n\n公开用法：\n  python make_cover.py COVER_SPEC_JSON --out COVER.png\n错误：exit 2（cover_error: ...）输入/路径/格式问题。\n\"\"\"\nimport argparse\nimport json\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFont\n\n\ndef fail(message: str) -> None:\n    print(\"cover_error: \" + message, file=sys.stderr)\n    raise SystemExit(2)\n\n\ndef find_font(size: int) -> ImageFont.FreeTypeFont:\n    if shutil.which(\"fc-match\"):\n        try:\n            raw = subprocess.run([\"fc-match\", \"-f\", \"%{file}\", \"Noto Sans CJK SC\"],\n                                 capture_output=True, text=True, timeout=10).stdout.strip()\n        except subprocess.SubprocessError:\n            raw = \"\"\n        for path in filter(None, [raw, \"/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc\"]):\n            candidate = Path(path)\n            if candidate.is_file():\n                try:\n                    return ImageFont.truetype(str(candidate), size)\n                except OSError:\n                    continue\n    fail(\"no CJK font found (need Noto Sans CJK SC)\")\n\n\ndef load_spec(path: str) -> dict:\n    try:\n        with open(path, encoding=\"utf-8-sig\") as handle:\n            spec = json.load(handle)\n    except OSError as error:\n        fail(f\"cannot read spec: {error}\")\n    except (UnicodeEr