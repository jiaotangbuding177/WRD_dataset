{"type": "message", "id": "e176b782-369c-4899-bb3c-43af578fd459", "parentId": "5d2e7898-a0f0-4a47-9066-6098908ff7c9", "timestamp": "2026-10-23T19:02:30.213Z", "message": {"role": "toolResult", "toolCallId": "call8cb964ac4f4f49d29fc9166530e01211", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"Convert an advisory-report Markdown file into a styled Word document.\n\nStyle (proven in source session conv_8487ad8077f4): A4, centered dark-blue H1,\ndark-blue H2/H3, light-blue table header shading, page header line + page\nnumber footer, CJK fonts (headings 黑体, body 宋体).\n\nNumbering discipline (session pitfall, msg 30/32): NO Word auto-numbering is\nused. Ordered list numbers stay as literal text authored in the Markdown, and\nbullets render as \"• \" text — this cannot collide with auto-numbering or\ngrow continuous 1-15 counters. Numbering rhythm (per-section restart) is the\nauthor's job in the Markdown.\n\nMarkdown subset: #/##/###/#### headings, paragraphs, **bold** spans, tables\n(| a | b | with --- separator), \"- \" bullets, \"N. \" ordered items, \"> \"\nblockquotes (indented gray), \"---\" rules skipped.\n\nUsage:\n  python md2docx.py 报告.md -o 报告.docx [--header 标题文本]\n\nExit codes: 0 ok, 2 usage/input error.\n\"\"\"\nimport argparse\nimport re\nimport sys\nfrom pathlib import Path\n\nfrom docx import Document\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.oxml import OxmlElement\nfrom docx.oxml.ns import qn\nfrom docx.shared import Cm, Pt, RGBColor\n\nDARK_BLUE = RGBColor(0x1F, 0x4E, 0x79)\nHEADER_BLUE_HEX = \"D9E2F3\"  # light blue table-header shading\nBODY_FONT = \"宋体\"\nHEADING_FONT = \"黑体\"\n\n\ndef _fail(msg):\n    print(\"md2docx error: \" + msg, file=sys.stderr)\n    return 2\n\n\ndef set_cjk(run, ascii_font, east_font, size, bold=False, color=None):\n    run.font.name = ascii_font\n    run.font.size = Pt(size)\n    run.font.bold = bold\n    if color is not None:\n        run.font.color.rgb = color\n    rpr = run._element.get_or_add_rPr()\n    rfonts = rpr.find(qn(\"w:rFonts\"))\n    if rfonts is None:\n        rfonts = OxmlElement(\"w:rFonts\")\n        rpr.append(rfonts)\n    rfonts.set(qn(\"w:eastAsia\"), east_font)\n\n\ndef add_runs_with_bold(par, text, ascii_font, east_font, size, color=None):\n    for i, chunk in enumerate(re.split(r\"\\*\\*(.+?)\\*\\*\", text)):\n        if not chunk:\n            continue\n        run = par.add_run(chunk)\n        set_cjk(run, ascii_font, east_font, size, bold=(i % 2 == 1), color=color)\n\n\ndef shade_cell(cell, hex_color):\n    tcpr = cell._tc.get_or_add_tcPr()\n    shd = OxmlElement(\"w:shd\")\n    shd.set(qn(\"w:val\"), \"clear\")\n    shd.set(qn(\"w:fill\"), hex_color)\n    tcpr.append(shd)\n\n\ndef add_page_field(par):\n    # Proper fldChar begin/instr/separate/cached-text/end structure, otherwise\n    # the field renders as the literal text \"PAGE\" (source session pitfall).\n    for kind in (\"begin\", \"separate\", \"end\"):\n        if kind == \"separate\":\n            run = par.add_run(\"1\")\n            set_cjk(run, \"Times New Roman\", BODY_FONT, 9)\n        run = par.add_run()\n        fld = OxmlElement(\"w:fldChar\")\n        fld.set(qn(\"w:fldCharType\"), kind)\n        run._element.append(fld)\n        if kind == \"begin\":\n            instr = OxmlElement(\"w:instrText\")\n            instr.set(qn(\"xml:space\"), \"preserve\")\n            instr.text = \" PAGE \"\n            run._element.append(instr)\n\n\ndef build(doc, lines, header_text):\n    section = doc.sections[0]\n    section.page_width, section.page_height = Cm(21.0), Cm(29.7)\n    for attr in (\"top_margin\", \"bottom_margin\"):\n        setattr(section, attr, Cm(2.54))\n    for attr in (\"left_margin\", \"right_margin\"):\n        setattr(section, attr, Cm(2.6))\n\n    hp = section.header.paragraphs[0]\n    hp.alignment = WD_ALIGN_PARAGRAPH.RIGHT\n    run = hp.add_run(header_text)\n    set_cjk(run, \"Times New Roman\", BODY_FONT, 9, color=RGBColor(0x80, 0x80, 0x80))\n\n    fp = section.footer.paragraphs[0]\n    fp.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    set_cjk(fp.add_run(\"第 \"), \"Times New Roman\", BODY_FONT, 9)\n    add_page_field(fp)\n    set_cjk(fp.add_run(\" 页\"), \"Times New Roman\", BODY_FONT, 9)\n\n    i = 0\n    while i < len(lines):\n        line = lines[i].rstrip(\"\\n\")\n        stripped = line.strip()\n        if not stripped or stripped == \"---\":\n            i += 1\n            continue\n        m = re.match(r\"^(#{1,4})\\s+(.*)$\", stripped)\n        if m:\n            level, text = len(m.group(1)), re.sub(r\"\\*\\*(.+?)\\*\\*\", r\"\\1\", m.group(2))\n            if level == 1:\n                par = doc.add_paragraph()\n                par.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                set_cjk(par.add_run(text), \"Times New Roman\", HEADING_FONT, 18, bold=True, color=DARK_BLUE)\n            else:\n                par = doc.add_heading(level=min(level - 1, 3))\n                sizes = {2: 14, 3: 12, 4: 11}\n                for run in par.runs:\n                    set_cjk(run, \"Times New Roman\", HEADING_FONT, sizes.get(level, 11),\n                            bold=True, color=DARK_BLUE)\n            i += 1\n            continue\n        if stripped.startswith(\"> \"):\n            par = doc.add_paragraph()\n            par.paragraph_format.left_indent = Cm(0.8)\n            add_runs_with_bold(par, stripped[2:], \"Times New Roman\", BODY_FONT, 10.5,\n                               color=RGBColor(0x60, 0x60, 0x60))\n            i += 1\n            continue\n        if stripped.startswith(\"|\") and i + 1 < len(lines) and re.match(r\"^\\s*\\|[\\s:|-]+\\|?\\s*$\", lines[i + 1]):\n            rows = []\n            j = i\n            while j < len(lines) and lines[j].strip().startswith(\"|\"):\n                rows.append([c.strip() for c in lines[j].strip().strip(\"|\").split(\"|\")])\n                j += 1\n            rows.pop(1)  # separator row\n            rows = [r for r in rows if r]\n            ncols = max(len(r) for r in rows)\n            table = doc.add_table(rows=len(rows), cols=ncols)\n            table.style = \"Table Grid\"\n            table.alignment = WD_TABLE_ALIGNMENT.CENTER\n            for r, row in enumerate(rows):\n                for c in range(ncols):\n                    cell = table.cell(r, c)\n                    cell.text = \"\"\n                    par = cell.paragraphs[0]\n                    text = row[c] if c < len(row) else \"\"\n                    add_runs_with_bold(par, text, \"Times New Roman\", BODY_FONT, 10.5)\n                    if r == 0:\n                        shade_cell(cell, HEADER_BLUE_HEX)\n                        for run in par.runs:\n                            run.font.bold = True\n            i = j\n            continue\n        m = re.match(r\"^-\\s+(.*)$\", stripped)\n        if m:\n            par = doc.add_paragraph()\n            par.paragraph_format.left_indent = Cm(0.5)\n            add_runs_with_bold(par, \"• \" + m.group(1), \"Times New Roman\", BODY_FONT, 10.5)\n            i += 1\n            continue\n        m = re.match(r\"^(\\d+[.、])\\s+(.*)$\", stripped)\n        if m:\n            par = doc.add_paragraph()\n            par.paragraph_format.left_indent = Cm(0.5)\n            add_runs_with_bold(par, m.group(1) + \" \" + m.group(2), \"Times New Roman\", BODY_FONT, 10.5)\n            i += 1\n            continue\n        par = doc.add_paragraph()\n        par.paragraph_format.first_line_indent = Cm(0.74)\n        add_runs_with_bold(par, stripped, \"Times New Roman\", BODY_FONT, 10.5)\n        i += 1\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"input\", help=\"markdown report\")\n    parser.add_argument(\"-o\", \"--output\", required=True, help=\"output .docx\")\n    parser.add_argument(\"--header\", default=\"\", help=\"page header text (default: first H1)\")\n    args = parser.parse_args()\n    src = Path(args.input)\n    out = Path(args.output)\n    try:\n        if not src.is_file():\n            return _fail(\"input not found: \" + str(src))\n        if src.suffix.lower() not in (\".md\", \".markdown\", \".txt\"):\n            return _fail(\"unsupported input type \" + src.suffix + \": expected .md/.markdown/.txt\")\n        lines = src.read_text(encoding=\"utf-8\").splitlines()\n    except OSError as err:\n        return _fail(str(err))\n    first_h1 = next((l.lstrip(\"# \").strip() for l in lines if l.startswith(\"# \")), \"\")\n    header_text = args.header or first_h1\n    if not any(l.strip() for l in lines):\n        return _fail(\"input is empty\")\n    doc = Document()\n    build(doc, lines, header_text)\n    try:\n        out.parent.mkdir(parents=True, exist_ok=True)\n        doc.save(str(out))\n    except OSError as err:\n        return _fail(\"cannot save output: \" + str(err))\n    print(\"OK \" + str(out))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792782150211, "__openclaw": {"runId": "e1f74ed7-5a9f-4a46-a27a-b8076607c178"}}}
