{"type": "message", "id": "84d642dc-669d-4ff0-9432-149c982ecdd1", "parentId": "ae610202-38ed-433c-9f26-918d4459ccd4", "timestamp": "2026-10-24T05:29:14.413Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在我将在一个调用中升级提取器，以支持多关键词和多窗口搜索。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-71212bac6f1149fcaca18d22\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call8622cbfd1eb742b9be1558613144d773", "name": "write", "arguments": {"content": "\"\"\"Extract plain text from a .docx contract into a JSON file, with\nkeyword/window access for long documents.\n\nMethod: open the OOXML zip, read word/document.xml, join every <w:t> run per\n<w:p> paragraph, unescape XML entities. Default mode writes {source_file,\nparagraphs, text} JSON to --out. Long documents: use one or more --grep to\nprint only matching paragraph numbers plus bounded text windows (windows\ncapped by --max-windows, each paragraph line clipped; paragraphs whose text\ntext itself degenerated into OOXML fragments are hard-clipped and flagged),\none or more --lines START-END to re-read known windows, or both together in a\nsingle invocation. Merged windows print once, in source (paragraph) order.\nOnly .docx is supported; scanned PDFs must be OCR'd first.\n\"\"\"\nimport argparse\nimport json\nimport re\nimport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\nFRAGMENT_RE = re.compile(r'<w:|</w:|<\\?xml')  # unescaped text that is itself OOXML debris\nPRINT_CAP = 400      # per-paragraph clip in --grep windows\nFRAGMENT_CAP = 160   # OOXML-fragment paragraphs are clipped much harder\n\n\ndef clip(text):\n    \"\"\"Return the printable, bounded form of one paragraph's text.\"\"\"\n    frag = bool(FRAGMENT_RE.search(text))\n    cap = FRAGMENT_CAP if frag else PRINT_CAP\n    if len(text) > cap:\n        text = text[:cap] + '…[截断,共%d字]' % len(text)\n    if frag:\n        text += '[ooxml碎片:仅作锚点定位,不作正文依据]'\n    return text\n\n\ndef parse_lines(spec):\n    \"\"\"Parse 'START-END' -> (start, end); raise ValueError on bad form.\"\"\"\n    match = re.fullmatch(r'(\\d+)-(\\d+)', spec.strip())\n    if not match:\n        raise ValueError('--lines expects START-END like 120-140')\n    start, end = int(match.group(1)), int(match.group(2))\n    if start < 1 or end < start:\n        raise ValueError('--lines range invalid: ' + spec)\n    return start, end\n\n\ndef merge_windows(ranges):\n    \"\"\"Merge overlapping/adjacent [start, end) ranges, keep source order.\"\"\"\n    merged = []\n    for start, end in sorted(ranges):\n        if merged and start <= merged[-1][1] + 1:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n    return merged\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--out', help='full extraction JSON; omit when using --grep/--lines')\n    parser.add_argument('--grep', action='append', default=[], metavar='KEYWORD',\n                        help='locate keyword: print matching paragraph numbers + bounded text windows; repeat to search several keywords in one call')\n    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')\n    parser.add_argument('--max-windows', type=int, default=8, help='cap on printed windows across all keywords (default 8)')\n    parser.add_argument('--lines', action='append', default=[], metavar='START-END',\n                        help='print only a paragraph range like 120-140 (1-based, inclusive); repeatable')\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph\n    # numbers drift against locate_gaps/fill_cell body indices\n    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    total = len(paragraphs)\n\n    try:\n        line_ranges = [parse_lines(spec) for spec in args.lines]\n    except ValueError as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n\n    def print_window(start, end):\n        for i in range(max(0, start - 1), min(total, end)):\n            print('p' + str(i + 1) + ': ' + clip(paragraphs[i]))\n\n    if args.grep or args.lines:\n        width = max(0, args.context)\n        keyword_hits = []\n        grep_ranges = []\n        no_match = []\n        for keyword in args.grep:\n            hits = [i + 1 for i, text in enumerate(paragraphs) if keyword in text]\n            keyword_hits.append((keyword, hits))\n            if not hits:\n                no_match.append(keyword)\n            for hit in hits:\n                grep_ranges.append((max(1, hit - width), hit + width))\n        print('total ' + str(total) + ' paragraphs')\n        for keyword, hits in keyword_hits:\n            shown_hits = ', '.join(str(h) for h in hits[:50]) + ('…' if len(hits) > 50 else '')\n            print('grep [' + keyword + '] hit ' + str(len(hits)) + ': ' + (shown_hits if hits else '无'))\n        windows = merge_windows(line_ranges + grep_ranges)\n        shown = windows[:max(1, args.max_windows)]\n        for start, end in shown:\n            print('--- window p' + str(start) + '-p' + str(end) + ' ---')\n            print_window(start, end)\n        if len(windows) > len(shown):\n            print('…[剩余 %d 个窗口未打印; 收窄 --grep 关键词、减小 --context、增并 --lines 或调大 --max-windows]'\n                  % (len(windows) - len(shown)))\n        return 1 if no_match and not shown else 0\n    if not args.out:\n        print('extract_contract_text error: --out required without --grep/--lines', file=sys.stderr)\n        return 2\n    fragments = [i + 1 for i, text in enumerate(paragraphs) if FRAGMENT_RE.search(text)]\n    result = {'source_file': src.name, 'paragraphs': total,\n              'ooxml_fragment_paragraphs': fragments,\n              'text': '\\n'.join(paragraphs)}\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n    print('extracted ' + str(total) + ' paragraphs -> ' + args.out)\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/extract_contract_text.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792819728787, "responseId": "chatcmpl-1792819728827", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "ba4d58d6-21f0-446d-8f82-d4d1cf785062"}}}
