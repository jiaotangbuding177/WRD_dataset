'full extraction JSON; omit when using --grep/--lines')\n    parser.add_argument('--grep', help='locate keyword: print matching paragraph numbers + bounded text windows only')\n    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')\n    parser.add_argument('--max-windows', type=int, default=8, help='cap on printed --grep windows (default 8)')\n    parser.add_argument('--lines', help='print only paragraph range like 120-140 (1-based, inclusive)')\n    args = parser.parse_args()\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError('input not found: ' + str(src))\n        if src.suffix.lower() != '.docx':\n            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')\n        with zipfile.ZipFile(src) as archive:\n            xml = archive.read('word/document.xml').decode('utf-8')\n    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:\n        print('extract_contract_text error: ' + str(error), file=sys.stderr)\n        return 2\n    paragraphs = []\n    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph\n    # numbers drift against locate_gaps/fill_cell body indices\n    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):\n        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))\n        paragraphs.append(text)\n    while paragraphs and not paragraphs[-1]:\n        paragraphs.pop()\n    total = len(paragraphs)\n\n    def print_window(start, end):\n        for i in range(max(0, start - 1), min(total, end)):\n            print('p' + str(i + 1) + ': ' + clip(paragraphs[i]))\n\n    if args.lines:\n        match = re.fullmatch(r'(\\d+)-(\\d+)', args.lines.strip())\n        if not match:\n            print('extract_contract_text error: --lines expects START-END like 120-140', file=sys.stderr)\n            