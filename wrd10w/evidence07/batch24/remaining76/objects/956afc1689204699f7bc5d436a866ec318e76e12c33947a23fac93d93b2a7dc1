{"type": "message", "id": "5323d4d9-2c17-414a-91ad-d06eecdabd2f", "parentId": "6a20617a-e8d4-462a-829b-018eb06cad80", "timestamp": "2026-10-23T05:11:38.545Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "calle5c80de9e1cd42ae80d4a1ad4dd78afb", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"按周期统计企业工作项，输出周报汇总块（markdown）。历史事故都在口径上，本脚本固化正确口径：\n状态 state/issue_state ∈ 已完成/已验收；时间 updated_at 落在周期内；只统计当前周期；按 id 去重。\n\n用法:\n  python3 weekly_stats.py --input workitems.json --start 2026-05-11 --end 2026-05-18\n  python3 weekly_stats.py --input workitems.json --last-week\n  python3 weekly_stats.py --input workitems.json --start ... --end ... --pr-input workitems_pr.json --json\n\n输入:\n  --input    Gitee 导出的工作项 JSON 数组（collect_workitems.py 产物）；字段兼容\n             state/issue_state、updated_at、type/issue_type、ident/number/id、title/subject/name。\n  --pr-input 可选，PR JSON 数组，统计 merged_at 在周期内的合并 PR（按仓库计数）。\n  --states   可选，完成状态列表，逗号分隔，默认「已完成,已验收」。\n输出:\n  stdout = markdown 汇总块（类型分布 + 工作项清单 + 口径核查线索）；--json 另附结构化结果。\n  结果为 0 时输出排查线索（state=all、分页、时间字段三大历史坑）。\n\"\"\"\nimport argparse\nimport json\nimport sys\nfrom datetime import date, timedelta\n\n\ndef norm_type(raw):\n    s = str(raw or \"\").strip().lower()\n    if not s:\n        return \"未标注\"\n    if \"需求\" in s:\n        return \"需求\"\n    if \"缺陷\" in s or \"bug\" in s:\n        return \"缺陷\"\n    if \"任务\" in s or \"task\" in s:\n        return \"任务\"\n    return str(raw).strip()\n\n\ndef parse_day(v):\n    if not v:\n        return None\n    s = str(v).strip()\n    if len(s) >= 10 and s[4] == \"-\" and s[7] == \"-\":\n        try:\n            return date.fromisoformat(s[:10])\n        except ValueError:\n            return None\n    return None\n\n\ndef field(item, names):\n    for n in names:\n        if item.get(n) not in (None, \"\"):\n            return item[n]\n    return None\n\n\ndef last_week_range(today=None):\n    t = today or date.today()\n    monday = t - timedelta(days=t.weekday() + 7)\n    return monday, monday + timedelta(days=6)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"工作项周期统计（正确口径固化）\")\n    ap.add_argument(\"--input\", required=True, help=\"工作项 JSON 数组文件\")\n    ap.add_argument(\"--start\", help=\"周期起始 YYYY-MM-DD（含）\")\n    ap.add_argument(\"--end\", help=\"周期结束 YYYY-MM-DD（含）\")\n    ap.add_argument(\"--last-week\", action=\"store_true\", help=\"用上周一~上周日作为周期\")\n    ap.add_argument(\"--states\", default=\"已完成,已验收\", help=\"完成状态，逗号分隔\")\n    ap.add_argument(\"--pr-input\", help=\"可选 PR JSON 文件，统计周期内合并 PR 按仓库计数\")\n    ap.add_argument(\"--json\", action=\"store_true\", help=\"额外输出结构化 JSON\")\n    args = ap.parse_args()\n\n    if args.last_week:\n        start, end = last_week_range()\n    elif args.start and args.end:\n        start, end = date.fromisoformat(args.start), date.fromisoformat(args.end)\n    else:\n        print(\"需要 --start/--end 或 --last-week\", file=sys.stderr)\n        sys.exit(2)\n    if start > end:\n        print(\"周期起止颠倒: %s > %s\" % (start, end), file=sys.stderr)\n        sys.exit(2)\n\n    try:\n        with open(args.input, encoding=\"utf-8\") as f:\n            items = json.load(f)\n    except (OSError, ValueError) as e:\n        print(\"读取输入失败: %s\" % e, file=sys.stderr)\n        sys.exit(2)\n    if not isinstance(items, list):\n        print(\"输入应是 JSON 数组，实际: %s\" % type(items).__name__, file=sys.stderr)\n        sys.exit(2)\n\n    ok_states = {s.strip() for s in args.states.split(\",\") if s.strip()}\n    matched, seen = [], set()\n    excluded = {\"非完成状态\": 0, \"时间不在周期\": 0, \"缺时间字段\": 0, \"重复\": 0, \"缺状态字段\": 0}\n    for it in items:\n        if not isinstance(it, dict):\n            excluded[\"非完成状态\"] += 0  # 非对象条目直接跳过，不计入任何口径\n            continue\n        state = field(it, [\"state\", \"issue_state\"])\n        ident = field(it, [\"ident\", \"number\", \"id\"])\n        key = str(ident) if ident is not None else json.dumps([field(it, [\"title\", \"subject\", \"name\"]), str(it.get(\"updated_at\"))], ensure_ascii=False)\n        if key in seen:\n            excluded[\"重复\"] += 1\n            continue\n        seen.add(key)\n        if state is None:\n            excluded[\"缺状态字段\"] += 1\n            continue\n        if str(state).strip() not in ok_states:\n            excluded[\"非完成状态\"] += 1\n            continue\n        day = parse_day(field(it, [\"updated_at\"]))\n        if day is None:\n            excluded[\"缺时间字段\"] += 1\n            continue\n        if not (start <= day <= end):\n            excluded[\"时间不在周期\"] += 1\n            continue\n        matched.append({\n            \"ident\": str(ident) if ident is not None else \"\",\n            \"title\": str(field(it, [\"title\", \"subject\", \"name\"]) or \"\").strip(),\n            \"type\": norm_type(field(it, [\"type\", \"issue_type\", \"kind\"])),\n            \"updated_at\": str(it.get(\"updated_at\") or \"\"),\n        })\n\n    by_type = {}\n    for m in matched:\n        by_type[m[\"type\"]] = by_type.get(m[\"type\"], 0) + 1\n    order = [t for t in (\"需求\", \"缺陷\", \"任务\") if t in by_type] + sorted(t for t in by_type if t not in (\"需求\", \"缺陷\", \"任务\"))\n\n    pr_lines = []\n    if args.pr_input:\n        try:\n            with open(args.pr_input, encoding=\"utf-8\") as f:\n                prs = json.load(f)\n        except (OSError, ValueError) as e:\n            print(\"读取 PR 输入失败: %s\" % e, file=sys.stderr)\n            sys.exit(2)\n        by_repo = {}\n        for pr in prs if isinstance(prs, list) else []:\n            if not isinstance(pr, dict) or not pr.get(\"merged_at\"):\n                continue\n            day = parse_day(pr.get(\"merged_at\"))\n            if day and start <= day <= end:\n                repo = pr.get(\"_repo\") or (pr.get(\"base\") or {}).get(\"repo\", {}).get(\"full_name\", \"未知仓库\")\n                by_repo[repo] = by_repo.get(repo, 0) + 1\n        total_pr = sum(by_repo.values())\n        pr_lines = [\"| %s | %d |\" % (r, c) for r, c in sorted(by_repo.items(), key=lambda x: -x[1])]\n        pr_block = \"\\n\\n### 合并 PR（按仓库）\\n\\n| 仓库 | 合并 PR |\\n|------|--------|\\n| **合计** | **%d** |\\n%s\" % (total_pr, \"\\n\".join(pr_lines)) if pr_lines else \"\\n\\n### 合并 PR\\n\\n本周期合并 PR：0 个\"\n    else:\n        pr_block = \"\"\n\n    lines = []\n    lines.append(\"## 企业工作项汇总（%s ~ %s）\" % (start.isoformat(), end.isoformat()))\n    lines.append(\"\")\n    lines.append(\"统计口径：状态 %s；时间 updated_at 在周期内；仅本周期，不累计。\" % \"/\".join(sorted(ok_states)))\n    lines.append(\"\")\n    lines.append(\"### 类型分布\")\n    lines.append(\"\")\n    lines.append(\"| 类型 | 数量 |\")\n    lines.append(\"|------|------|\")\n    for t in order:\n        lines.append(\"| %s | %d |\" % (t, by_type[t]))\n    lines.append(\"| **合计** | **%d** |\" % len(matched))\n    lines.append(\"\")\n    lines.append(\"### 工作项列表（写报告时相似项合并为「XX相关：ID1, ID2」）\")\n    lines.append(\"\")\n    for t in order:\n        group = [m for m in matched if m[\"type\"] == t]\n        lines.append(\"- **%s**（%d）：\" % (t, len(group)) + \"；\".join(\"%s %s\" % (m[\"ident\"], m[\"title\"]) if m[\"ident\"] else m[\"title\"] for m in group))\n    lines.append(pr_block.strip(\"\\n\") and pr_block or \"\")\n    check = \"、\".join(\"%s %d\" % (k, v) for k, v in excluded.items() if v)\n    if not matched:\n        lines.insert(2, \"\")\n        lines.insert(2, \"**⚠️ 统计结果为 0。重跑前先核对三处口径（历史全部踩过）：1) 采集是否带 state=all；2) 分页是否取全（per_page=100 循环到短页）；3) 时间字段是否用 updated_at 而非 finished_at。**\")\n        lines.insert(3, \"\")\n    if check:\n        lines.append(\"\")\n        lines.append(\"口径核查（被排除 %d 条）：%s。若与预期不符，先核对这些口径再改代码。\" % (sum(excluded.values()), check))\n\n    out = \"\\n\".join(lines)\n    if args.json:\n        out += \"\\n```json\\n\" + json.dumps({\"start\": start.isoformat(), \"end\": end.isoformat(), \"total\": len(matched), \"by_type\": by_type, \"excluded\": {k: v for k, v in excluded.items() if v}, \"items\": matched}, ensure_ascii=False, indent=1) + \"\\n```\"\n    print(out)\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/weekly_stats.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792732258614, "responseId": "chatcmpl-1792732258683", "__openclaw": {"runId": "1b75c64c-5720-4ef9-aa49-c58e871814a4"}}}
