#!/usr/bin/env python3
"""用真实中文字体在图片上确定性叠加文字（广告词/标签/改后文案）。

生成模型直接画中文必出乱码；图上需要出现新文字时用本脚本排版叠加，
不交给生成模型。先量好放置位置再运行；完成后用 verify_text.py 复核。
字体默认经 fc-match 解析 Noto Sans CJK SC（自动在 .ttc 中选 SC 字面），
可用 --font 指定具体 .ttf/.ttc/.otf。多行用字面 \n 分隔。
退出码：0=成功，2=输入或字体错误。
"""
import argparse
import os
import subprocess
import sys

from PIL import Image, ImageDraw, ImageFont


ANCHORS = {
    "top-left": (0.0, 0.0), "top-center": (0.5, 0.0), "top-right": (1.0, 0.0),
    "mid-left": (0.0, 0.5), "mid-center": (0.5, 0.5), "mid-right": (1.0, 0.5),
    "bottom-left": (0.0, 1.0), "bottom-center": (0.5, 1.0), "bottom-right": (1.0, 1.0),
}


def fail(code, message, exit_code=2):
    print(f"{code}: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def pick_sc_face(path, size):
    """在 .ttc 中优先选含 SC 的字面，否则用第 0 面。"""
    try:
        count = 1
        if path.lower().endswith((".ttc", ".otc")):
            count = 10
        best = None
        for index in range(count):
            try:
                font = ImageFont.truetype(path, size, index=index)
            except Exception:
                break
            name = " ".join(font.getname())
            if "SC" in name:
                return font
            if best is None:
                best = font
        return best
    except OSError as error:
        fail("font_load_error", f"{path}: {error}")


def resolve_font(path, size):
    if path:
        if not os.path.isfile(path):
            fail("font_not_found", path)
        return pick_sc_face(path, size)
    try:
        result = subprocess.run(
            ["fc-match", "-f", "%{file}", "Noto Sans CJK SC"],
            capture_output=True, text=True, timeout=30)
        font_file = result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        font_file = ""
    if not font_file or not os.path.isfile(font_file):
        fail("font_not_found", "fc-match found no Noto CJK; pass --font explicitly")
    return pick_sc_face(font_file, size)


def main():
    parser = argparse.ArgumentParser(description="在图片上用真实字体叠加中文文字")
    parser.add_argument("image", help="底图路径")
    parser.add_argument("--text", required=True,
                        help="要叠加的文字，字面 \\n 表示换行")
    parser.add_argument("--out", required=True, help="输出图片路径")
    parser.add_argument("--font", default="", help="字体文件路径；缺省 fc-match Noto CJK SC")
    parser.add_argument("--font-size", type=int, default=48)
    parser.add_argument("--color", default="#111111")
    parser.add_argument("--anchor", default="top-center", choices=sorted(ANCHORS),
                        help="文字块锚点，默认 top-center")
    parser.add_argument("--x", type=int, help="像素级左上角 x，覆盖锚点水平定位")
    parser.add_argument("--y", type=int, help="像素级左上角 y，覆盖锚点垂直定位")
    parser.add_argument("--letter-spacing", type=int, default=0,
                        help="字间距像素，>0 时逐字绘制")
    parser.add_argument("--line-spacing", type=int, default=0, help="行间距像素")
    args = parser.parse_args()
    if not os.path.isfile(args.image):
        fail("image_not_found", args.image)
    if args.font_size <= 0:
        fail("bad_font_size", "--font-size must be positive")
    font = resolve_font(args.font, args.font_size)
    image = Image.open(args.image).convert("RGB")
    draw = ImageDraw.Draw(image)
    lines = args.text.split("\\n")
    line_heights = [font.getbbox("国Ag")[3] for _ in lines]
    line_gap = args.line_spacing
    block_w = 0
    for line in lines:
        if args.letter_spacing > 0 and line:
            width = sum(draw.textlength(ch, font=font) + args.letter_spacing
                        for ch in line) - args.letter_spacing
        else:
            width = draw.textlength(line, font=font)
        block_w = max(block_w, int(width))
    block_h = sum(line_heights) + line_gap * (len(lines) - 1)
    fx, fy = ANCHORS[args.anchor]
    x = args.x if args.x is not None else int((image.width - block_w) * fx)
    y = args.y if args.y is not None else int((image.height - block_h) * fy)
    start_x, start_y = x, y
    for line, height in zip(lines, line_heights):
        if not line:
            y += height + line_gap
            continue
        if args.letter_spacing > 0:
            cursor = x
            for ch in line:
                draw.text((cursor, y), ch, font=font, fill=args.color)
                cursor += draw.textlength(ch, font=font) + args.letter_spacing
        else:
            draw.text((x, y), line, font=font, fill=args.color)
        y += height + line_gap
    image.save(args.out)
    print(f"overlay {len(lines)} line(s) at ({start_x},{start_y}) size {image.width}x{image.height} -> {args.out}")


if __name__ == "__main__":
    raise SystemExit(main())
