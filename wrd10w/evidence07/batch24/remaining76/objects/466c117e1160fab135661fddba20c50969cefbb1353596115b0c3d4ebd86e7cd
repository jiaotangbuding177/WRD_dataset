#!/usr/bin/env python3
"""把映射好的内容填入 DOCX 表格/段落表单，保留原模板格式。

用法（原样可执行）:
  python3 fill_docx_tables.py <模板.docx> --values <values.json> --out <成品.docx>

values.json 结构（tables/paragraphs 均可选，按需给）:
{
  "tables": [
    {"table": 0,
     "cells": [
       {"row": 2, "col": 1, "text": "87", "mode": "replace"},
       {"row": 3, "col": 2, "text": "依据：…", "mode": "append"}
     ]}
  ],
  "paragraphs": [
    {"anchor": "评审意见：", "text": "……", "mode": "insert_after"}
  ]
}

行为:
- cell replace: 清空单元格写入 text；text 中 \n 分多行，行格式沿用原第一行。
- cell append: 在单元格末尾追加新行写入 text，格式沿用原最后一行。
- paragraph replace: 用 text 替换命中段落全文；insert_after: 在其后插入新段；append: 在段末续写。
- anchor 命中含该文字的第一个段落（区分表格内外，段落指表格外的正文段落）。
- 表格序号 0 起，与提取文本中 ===== TABLE ===== 出现顺序一致；合并单元格坐标可能与
  提取文本列对齐不一致，填前先对照提取文本核对。
- 退出码: 0 全部命中并写出; 2 输入/用法错误; 3 有定位未命中（成品仍写出，stdout 报 failed 清单）。
不联网；不修改模板文件。
"""
import copy
import json
import os
import sys

from docx import Document
from docx.text.paragraph import Paragraph


def set_line(p, text):
    """把段落文本设为 text，保留第一个 run 的格式，删除其余 run。"""
    runs = list(p.runs)
    if runs:
        runs[0].text = text
        for r in runs[1:]:
            r._element.getparent().remove(r._element)
    else:
        p.add_run(text)


def write_multiline(p0, text):
    """在段落 p0 位置写入可能多行的 text：首行写进 p0，其余行克隆 p0 依次插入。"""
    lines = text.split("\n")
    set_line(p0, lines[0])
    prev = p0._element
    for line in lines[1:]:
        newp = copy.deepcopy(p0._element)
        prev.addnext(newp)
        prev = newp
        set_line(Paragraph(newp, p0._parent), line)


def fill_cell(cell, text, mode):
    if mode == "replace":
        for p in cell.paragraphs[1:]:
            p._element.getparent().remove(p._element)
        write_multiline(cell.paragraphs[0], text)
    elif mode == "append":
        last = cell.paragraphs[-1]
        if last.text.strip() or last.runs:
            newp = copy.deepcopy(last._element)
            last._element.addnext(newp)
            set_line(Paragraph(newp, last._parent), text)
        else:
            write_multiline(last, text)
    else:
        raise ValueError("不支持的 cell mode: %s" % mode)


def find_anchor(doc, anchor):
    for p in doc.paragraphs:
        if anchor in p.text:
            return p
    return None


def main(argv):
    import argparse
    ap = argparse.ArgumentParser(description="按坐标/锚点填写 DOCX 表单")
    ap.add_argument("template", help="模板/目标 .docx")
    ap.add_argument("--values", required=True, help="填写映射 values.json")
    ap.add_argument("--out", required=True, help="输出成品 .docx")
    args = ap.parse_args(argv)

    if not os.path.isfile(args.template):
        print("fill_docx_tables error: 模板不存在: %s" % args.template, file=sys.stderr)
        return 2
    try:
        with open(args.values, "r", encoding="utf-8") as f:
            spec = json.load(f)
    except (OSError, ValueError) as e:
        print("fill_docx_tables error: values 读取失败: %s" % e, file=sys.stderr)
        return 2
    if not isinstance(spec, dict):
        print("fill_docx_tables error: values.json 顶层必须是对象", file=sys.stderr)
        return 2
    if not args.out.lower().endswith(".docx"):
        print("fill_docx_tables error: --out 必须是 .docx", file=sys.stderr)
        return 2

    doc = Document(args.template)
    applied, failed = [], []

    tables = doc.tables
    for ti, tspec in enumerate(spec.get("tables") or []):
        tidx = tspec.get("table")
        if not isinstance(tidx, int) or not (0 <= tidx < len(tables)):
            failed.append({"kind": "table", "table": tidx,
                           "error": "表格序号越界（共 %d 个表格）" % len(tables)})
            continue
        tb = tables[tidx]
        nrows, ncols = len(tb.rows), len(tb.columns)
        for cspec in tspec.get("cells") or []:
            row, col = cspec.get("row"), cspec.get("col")
            if not isinstance(row, int) or not isinstance(col, int) \
                    or not (0 <= row < nrows) or not (0 <= col < ncols):
                failed.append({"kind": "cell", "table": tidx, "row": row, "col": col,
                               "error": "坐标越界（表 %d 实际 %d 行 %d 列）" % (tidx, nrows, ncols)})
                continue
            try:
                fill_cell(tb.rows[row].cells[col], str(cspec.get("text", "")),
                          cspec.get("mode", "replace"))
                applied.append({"kind": "cell", "table": tidx, "row": row,
                                "col": col, "mode": cspec.get("mode", "replace")})
            except Exception as e:
                failed.append({"kind": "cell", "table": tidx, "row": row, "col": col,
                               "error": str(e)})

    for pspec in spec.get("paragraphs") or []:
        anchor = pspec.get("anchor")
        p = find_anchor(doc, anchor or "")
        if p is None:
            failed.append({"kind": "paragraph", "anchor": anchor, "error": "未找到锚点段落"})
            continue
        mode = pspec.get("mode", "replace")
        text = str(pspec.get("text", ""))
        try:
            if mode == "replace":
                write_multiline(p, text)
            elif mode == "insert_after":
                newp = copy.deepcopy(p._element)
                p._element.addnext(newp)
                write_multiline(Paragraph(newp, p._parent), text)
            elif mode == "append":
                p.add_run(text)
            else:
                raise ValueError("不支持的 paragraph mode: %s" % mode)
            applied.append({"kind": "paragraph", "anchor": anchor, "mode": mode})
        except Exception as e:
            failed.append({"kind": "paragraph", "anchor": anchor, "error": str(e)})

    outdir = os.path.dirname(os.path.abspath(args.out))
    os.makedirs(outdir, exist_ok=True)
    doc.save(args.out)
    print(json.dumps({"applied": len(applied), "failed": failed,
                      "out": args.out}, ensure_ascii=False))
    return 3 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
