{"type": "message", "id": "056f0aba-e2cd-491e-81b8-6417bd67691f", "parentId": "4e559467-f599-466f-a605-aeb342f905fc", "timestamp": "2026-10-23T05:33:47.717Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "callffafabde8ef94f27aba5d0ecf406158b", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"生成法定股东名册 xlsx（openpyxl，两表：股东名册 + 填写说明）。\n\n用法（原样可执行）:\n  python3 register_xlsx.py build  --in <register_data.json> --out <股东名册.xlsx> [--force]\n  python3 register_xlsx.py verify --file <股东名册.xlsx>\n\n数据 JSON 字段（见 templates/register_data.template.json）:\n  company: name/credit_code/registered_capital/company_type/established_date/legal_rep\n           （任一字段缺失或值为 null/空串 → 该栏写「待填」）\n  shareholders: 列表，每行字段 name/cert_serial/cert_no/address/\n                subscribed_amount/subscribed_method/subscribed_date/\n                paid_amount/paid_method/paid_date/\n                acquired_date/lost_date\n                （缺失字段写「待填」；整行为 {} 时输出一行全「待填」占位）\n  blank_rows: 可选，在已填股东行之后追加 N 行空白编号行（预留给未确认股东）\n  note: 可选，出现在填写说明顶部的备注（如数据来源与核实情况）\n\nverify 行为: 用 openpyxl 读回，检查表结构与「待填」标记存在性，报告未填字段数。\n退出码：0 成功；2 用法/输入错误（stderr 说明）；输出已存在且未加 --force 时退出 2。\n\"\"\"\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nfrom openpyxl import Workbook, load_workbook\nfrom openpyxl.styles import Alignment, Border, Font, PatternFill, Side\n\nHEADER_FILL = PatternFill(\"solid\", fgColor=\"D9E2F3\")\nINFO_FILL = PatternFill(\"solid\", fgColor=\"FFF2CC\")\nTHIN = Side(style=\"thin\", color=\"999999\")\nBORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)\nWRAP = Alignment(wrap_text=True, vertical=\"center\")\nCENTER = Alignment(horizontal=\"center\", vertical=\"center\", wrap_text=True)\n\nCOLUMNS = [\n    \"序号\", \"出资证明书编号\", \"股东姓名或名称\", \"股东证件号码\", \"股东住所\",\n    \"认缴-出资额(万元)\", \"认缴-出资方式\", \"认缴-出资时间\",\n    \"实缴-出资额(万元)\", \"实缴-出资方式\", \"实缴-出资时间\",\n    \"取得股东资格日期\", \"丧失股东资格日期\",\n]\nROW_KEYS = [\n    \"cert_serial\", \"name\", \"cert_no\", \"address\",\n    \"subscribed_amount\", \"subscribed_method\", \"subscribed_date\",\n    \"paid_amount\", \"paid_method\", \"paid_date\",\n    \"acquired_date\", \"lost_date\",\n]\nCOMPANY_FIELDS = [\n    (\"credit_code\", \"统一社会信用代码\"),\n    (\"registered_capital\", \"注册资本\"),\n    (\"company_type\", \"公司类型\"),\n    (\"established_date\", \"成立日期\"),\n    (\"legal_rep\", \"法定代表人\"),\n]\n\nINSTRUCTIONS = [\n    \"1. 本表为法定股东名册（依据《公司法》有限责任公司应当置备的股东名册事项），法律文件须据实填写，不得虚构。\",\n    \"2. 「待填」表示现有资料无法确认该字段：继续收集用户提供的证明材料（身份证、出资凭证、章程、工商档案）后补填。\",\n    \"3. 公司基本栏应来自营业执照关键字段（OCR 后须人工/联网核对再入表）；股东证件号码、住所、出资额等仅在有明确来源时填写。\",\n    \"4. 联网/工商接口核实到的信息需标注来源与时间；接口不可用时以用户给定资料为准，并在备注中说明未核实项。\",\n    \"5. 实缴栏默认留待填：仅当有验资报告、银行流水等实缴凭证时填写。\",\n    \"6. 底部「法定代表人签字或公司盖章 / 填表时间」交付前由公司方完成，AI 不代签。\",\n]\n\n\ndef clean(v):\n    if v is None or (isinstance(v, str) and not v.strip()):\n        return \"待填\"\n    return str(v).strip() if isinstance(v, str) else v\n\n\ndef build(data, out_path):\n    company = data.get(\"company\") or {}\n    shareholders = data.get(\"shareholders\") or []\n    blank_rows = int(data.get(\"blank_rows\") or 0)\n    note = data.get(\"note\") or \"\"\n    if not company.get(\"name\"):\n        raise ValueError(\"company.name 缺失：股东名册必须有公司名\")\n\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \"股东名册\"\n\n    ws.merge_cells(\"A1:M1\")\n    ws[\"A1\"] = f\"{company['name']}股东名册\"\n    ws[\"A1\"].font = Font(size=14, bold=True)\n    ws[\"A1\"].alignment = CENTER\n\n    info_pairs = [f\"{label}：{clean(company.get(key))}\" for key, label in COMPANY_FIELDS]\n    ws.merge_cells(\"A2:M2\")\n    ws[\"A2\"] = \"｜\".join(info_pairs)\n    ws[\"A2\"].fill = INFO_FILL\n    ws[\"A2\"].alignment = WRAP\n\n    for col, title in enumerate(COLUMNS, start=1):\n        c = ws.cell(row=3, column=col, value=title)\n        c.font = Font(bold=True)\n        c.fill = HEADER_FILL\n        c.alignment = CENTER\n        c.border = BORDER\n\n    row = 4\n    for idx, sh in enumerate(shareholders, start=1):\n        sh = sh or {}\n        values = [idx] + [clean(sh.get(k)) for k in ROW_KEYS]\n        for col, v in enumerate(values, start=1):\n            c = ws.cell(row=row, column=col, value=v)\n            c.border = BORDER\n            c.alignment = CENTER\n        row += 1\n    for i in range(blank_rows):\n        values = [len(shareholders) + i + 1] + [\"待填\"] * len(ROW_KEYS)\n        for col, v in enumerate(values, start=1):\n            c = ws.cell(row=row, column=col, value=v)\n            c.border = BORDER\n            c.alignment = CENTER\n        row += 1\n\n    row += 1\n    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=7)\n    ws.cell(row=row, column=1, value=\"法定代表人签字或公司盖章：\")\n    ws.merge_cells(start_row=row, start_column=8, end_row=row, end_column=13)\n    ws.cell(row=row, column=8, value=\"填表时间：\")\n\n    widths = [6, 16, 14, 20, 22, 12, 12, 12, 12, 12, 12, 14, 14]\n    for col, w in enumerate(widths, start=1):\n        ws.column_dimensions[ws.cell(row=3, column=col).column_letter].width = w\n\n    ws2 = wb.create_sheet(\"填写说明\")\n    ws2.column_dimensions[\"A\"].width = 100\n    r = 1\n    if note:\n        ws2.cell(row=r, column=1, value=\"备注：\" + note).alignment = WRAP\n        r += 2\n    for line in INSTRUCTIONS:\n        c = ws2.cell(row=r, column=1, value=line)\n        c.alignment = WRAP\n        r += 1\n\n    wb.save(out_path)\n    pending = sum(\n        1 for sh in shareholders for k in ROW_KEYS\n        if clean((sh or {}).get(k)) == \"待填\"\n    ) + blank_rows * len(ROW_KEYS)\n    print(f\"written: {out_path} (股东行 {len(shareholders)}，预留空行 {blank_rows}，待填字段 {pending})\")\n\n\ndef verify(path):\n    wb = load_workbook(path)\n    if \"股东名册\" not in wb.sheetnames or \"填写说明\" not in wb.sheetnames:\n        raise ValueError(\"缺少股东名册/填写说明工作表\")\n    ws = wb[\"股东名册\"]\n    headers = [ws.cell(row=3, column=c).value for c in range(1, 14)]\n    if headers != COLUMNS:\n        raise ValueError(f\"表头与法定字段不符: {headers}\")\n    pending = 0\n    r = 4\n    while ws.cell(row=r, column=1).value not in (None, \"\"):\n        pending += sum(1 for c in range(2, 14) if ws.cell(row=r, column=c).value == \"待填\")\n        r += 1\n    print(f\"ok: 表结构一致；数据行 {r - 4}；其中「待填」单元格 {pending} 处\")\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"action\", choices=[\"build\", \"verify\"])\n    ap.add_argument(\"--in\", dest=\"src\")\n    ap.add_argument(\"--out\", dest=\"out\")\n    ap.add_argument(\"--file\", dest=\"file\")\n    ap.add_argument(\"--force\", action=\"store_true\")\n    args = ap.parse_args()\n    try:\n        if args.action == \"build\":\n            if not args.src or not args.out:\n                print(\"build 需要 --in <data.json> --out <xlsx>\", file=sys.stderr)\n                return 2\n            if Path(args.out).exists() and not args.force:\n                print(f\"输出已存在：{args.out}（加 --force 覆盖）\", file=sys.stderr)\n                return 2\n            data = json.loads(Path(args.src).read_text(encoding=\"utf-8\"))\n            build(data, args.out)\n        else:\n            if not args.file:\n                print(\"verify 需要 --file <xlsx>\", file=sys.stderr)\n                return 2\n            verify(args.file)\n        return 0\n    except FileNotFoundError as e:\n        print(f\"输入不存在: {e}\", file=sys.stderr)\n        return 2\n    except (ValueError, json.JSONDecodeError) as e:\n        print(f\"输入/数据错误: {e}\", file=sys.stderr)\n        return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "path": "/workspace/outputs/skill/scripts/register_xlsx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792733582337, "responseId": "chatcmpl-1792733582466", "__openclaw": {"runId": "8