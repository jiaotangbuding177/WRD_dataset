mport sys\nimport zipfile\nfrom pathlib import Path\n\n\ndef unescape(text):\n    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')\n                .replace('&quot;', '\"').replace('&apos;', \"'\"))\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('input')\n    parser.add_argument('--keywords', required=True, help='comma separated keywords')\n    parser.add_argument('--out', required=True)\n    args = parser.parse_args()\n    keywords = [k for k in (k.strip() for k in args.keywords.split(',')) if k]\n    if not keywords:\n        print('scan_docx_keywords error: no keywords given', file=sys.stderr)\n        return 2\n====\n#!/usr/bin/env python3\n\"\"\"Extract all text from a .pptx (PowerPoint) file into structured JSON.\n\nUses only the Python standard library (zipfile + xml.etree), so it works on\nminimal images without python-pptx (python-pptx had compatibility problems in\nthe historical source sessions).\n\nUsage:\n    python extract_pptx_text.py <input.pptx> --out <output.json>\n\nOutput JSON shape:\n{\n  \"file\": \"basename.pptx\",\n  \"bytes\": 12345,\n  \"sha256\": \"...\",\n  \"slide_count\": 32,\n  \"slides\": [{\"slide\": 1, \"text\": \"...\"}, ...]\n}\n\nExit codes: 0 success; 2 invalid input (missing file / not a zip /\nno ppt/slides part) with a one-line stderr message.\n\"\"\"\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport posixpath\nimport sys\nimport zipfile\nimport xml.etree.ElementTree as ET\n\n\ndef slide_number(name: str):\n    base = posixpath.basename(name)\n    m = re.match(r\"slide(\\d+)\\.xml$\", base)\n    return int(m.group(1)) if m else None\n\n\n====\n#!/usr/bin/env python3\n\"\"\"批量提取评审文档文本（pptx/docx/doc/pdf/md/txt -> 每文件一个 .txt + index.json）。\n\n用法（原样可执行）:\n  python3 extract_texts.py <输入文件或目录...> --out <输出目录>\n\n行为:\n- 目录会被递归展开，仅处理受支持扩展名；同目录同名输出自动加序号，不覆盖。\n- .pptx: python-pptx，递归组合形状/表格/备注，按 SLIDE 分节。\n- .docx: python-docx 段落+表格。\n- .doc:  先用