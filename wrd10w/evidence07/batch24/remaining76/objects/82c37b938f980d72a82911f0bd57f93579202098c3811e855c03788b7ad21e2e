c:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n\n    out_dir = Path(args.out)\n    texts_dir = out_dir / \"texts\"\n    texts_dir.mkdir(parents=True, exist_ok=True)\n\n    profiles = []\n    used_names = set()\n    for pdf in pdfs:\n        try:\n            text, meta = extract_one(pdf)\n        except ValueError as exc:\n            print(f\"error: {exc}\", file=sys.stderr)\n            return 2\n        stem = pdf.stem\n        txt_name = stem + \".txt\"\n        k = 1\n        while txt_name in used_names:\n            k += 1\n            txt_name = f\"{stem}_{k}.txt\"\n        used_names.add(txt_name)\n        (texts_dir / txt_name).write_text(text, encoding=\"utf-8\")\n        meta[\"text_file\"] = f\"texts/{txt_name}\"\n        profiles.append(meta)\n\n    result = {\n        \"schema\": \"resume-text-extraction-v2\",\n        \"inputs\": [\n            {\n                \"path\": str(p),\n                \"kind\": \"file\" if p.suffix.lower() == \".pdf\" else \"dir\",\n                **({\"sha256\": sha256_file(p)} if p.is_file() else {}),\n            }\n            for p in map(Path, args.inputs)\n        ],\n        \"profiles\": profiles,\n    }\n    with open(out_dir / \"index.json\", \"w\", encoding=\"utf-8\") as f:\n        json.dump(result, f, ensure_ascii=False, indent=1)\n    flagged = [p[\"file_name\"] for p in profiles if p[\"text_quality\"] != \"clean\"]\n    print(f\"extracted {len(profiles)} resume(s) -> {out_dir}\")\n    for p in profiles:\n        print(f\"  {p['text_quality']:<20} {p['file_name']} (cjk={p['cjk_chars']})\")\n    if flagged:\n        print(\n            \"low_text_or_garbled (needs OCR fallback, not extracted reliably): \" + \"; \".join(flagged),\n            file=sys.stderr,\n        )\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}, "isError": false, "timestamp": 1792837997606, "__openclaw": {"runId": "61ada3dc-cb97-4bae-b810-f5cd377c45f9"}}}
