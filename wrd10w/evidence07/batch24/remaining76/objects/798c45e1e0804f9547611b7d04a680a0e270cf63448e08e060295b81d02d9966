{
  "title": "示例：新员工入职体验调研（结构示例，按当次任务替换全部文案）",
  "intro": "本示例展示 spec.json 的字段结构。实际使用时：radio=单选、checkbox=多选（可加 max 限选）、text=填空；required 控制必填；题目与选项文案全部来自当次用户场景。",
  "cfg": {
    "admin_password": "666888",
    "submitter_note": "本问卷会记录提交人信息，仅用于统计核对，请如实填写。"
  },
  "submitter_fields": [
    {"label": "姓名", "required": true},
    {"label": "部门", "required": true},
    {"label": "联系方式", "required": false}
  ],
  "questions": [
    {
      "type": "radio",
      "title": "你入职多久了？",
      "required": true,
      "options": ["A、1个月以内", "B、1-3个月", "C、3-6个月", "D、6个月以上"]
    },
    {
      "type": "checkbox",
      "title": "以下哪些入职环节你觉得顺利？",
      "required": true,
      "max": 3,
      "options": ["A、手续办理", "B、设备与账号", "C、入职培训", "D、团队融入"]
    },
    {
      "type": "text",
      "title": "你最希望公司改进的一个环节是什么？",
      "required": false,
      "placeholder": "一句话描述即可（选填）"
    }
  ]
}
