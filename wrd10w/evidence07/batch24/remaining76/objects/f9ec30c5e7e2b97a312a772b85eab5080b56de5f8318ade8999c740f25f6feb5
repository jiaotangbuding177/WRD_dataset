{"type": "message", "id": "727c3436-5b63-4134-9baf-6ea3d531a51a", "parentId": "853c3e49-3598-421b-b79e-3a6eeb83dd80", "timestamp": "2026-10-23T07:11:55.252Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "接下来处理构建脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-d51d2d21c49144c2883ce08b\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "callc1f2d9fb34254ac493dd9bd644e7a286", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Build a self-contained interactive questionnaire HTML from a spec JSON.\n\nPublic usage:\n    python {SKILL}/scripts/build_questionnaire.py {OUT}/spec.json --out {OUT}/<问卷名>.html\n\nInput spec JSON:\n{\n  \"title\": \"问卷标题\",\n  \"intro\": \"开头说明文字（可空）\",\n  \"cfg\": {\"admin_password\": \"666888\", \"submitter_note\": \"可选，提交人说明\", \"storage_key\": \"可选，本地存储键\"},\n  \"submitter_fields\": [{\"label\": \"姓名\", \"required\": true}, ...],\n  \"questions\": [\n    {\"type\": \"radio\",    \"title\": \"...\", \"required\": true, \"options\": [\"A、...\", \"B、...\"]},\n    {\"type\": \"checkbox\", \"title\": \"...\", \"required\": true, \"options\": [\"...\"], \"max\": 3},\n    {\"type\": \"text\",     \"title\": \"...\", \"required\": false, \"placeholder\": \"...\"}\n  ]\n}\nOutput: one self-contained HTML file (UTF-8) with submitter info, submission records,\n        admin panel, CSV/JSON export, receipt download/import, print view.\nErrors: exit 2 with single-line \"build_questionnaire_error: ...\" on stderr.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport html\nimport json\nimport sys\nfrom pathlib import Path\n\nTEMPLATE_PATH = Path(__file__).resolve().parent.parent / \"templates\" / \"questionnaire.template.html\"\nKNOWN_TYPES = {\"radio\", \"checkbox\", \"text\"}\n\n\nclass BuildError(Exception):\n    pass\n\n\ndef validate(spec: dict) -> None:\n    if not isinstance(spec, dict):\n        raise BuildError(\"spec must be a JSON object\")\n    title = spec.get(\"title\")\n    if not isinstance(title, str) or not title.strip():\n        raise BuildError(\"missing or empty field: title\")\n    questions = spec.get(\"questions\")\n    if not isinstance(questions, list) or not questions:\n        raise BuildError(\"missing or empty field: questions\")\n    fields = spec.get(\"submitter_fields\")\n    if not isinstance(fields, list) or not fields:\n        raise BuildError(\"missing or empty field: submitter_fields (at least one submitter field is required)\")\n    for i, f in enumerate(fields):\n        if not isinstance(f, dict) or not isinstance(f.get(\"label\"), str) or not f[\"label\"].strip():\n            raise BuildError(f\"submitter_fields[{i}] needs a non-empty label\")\n    for i, q in enumerate(questions):\n        if not isinstance(q, dict):\n            raise BuildError(f\"questions[{i}] must be an object\")\n        if q.get(\"type\") not in KNOWN_TYPES:\n            raise BuildError(f\"questions[{i}] has unknown type: {q.get('type')!r} (supported: radio/checkbox/text)\")\n        if not isinstance(q.get(\"title\"), str) or not q[\"title\"].strip():\n            raise BuildError(f\"questions[{i}] needs a non-empty title\")\n        if q[\"type\"] in (\"radio\", \"checkbox\"):\n            options = q.get(\"options\")\n            if not isinstance(options, list) or len(options) < 2:\n                raise BuildError(f\"questions[{i}] ({q['type']}) needs an options list with >= 2 items\")\n        if \"max\" in q and q[\"type\"] == \"checkbox\":\n            if not isinstance(q[\"max\"], int) or q[\"max\"] < 1 or q[\"max\"] > len(q[\"options\"]):\n                raise BuildError(f\"questions[{i}] max must be an integer in 1..{len(q['options'])}\")\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Build a self-contained questionnaire HTML from a spec.\")\n    parser.add_argument(\"spec\", help=\"spec JSON file (see module docstring for the format)\")\n    parser.add_argument(\"--out\", required=True, help=\"path of the HTML file to write\")\n    args = parser.parse_args()\n    try:\n        try:\n            raw = open(args.spec, \"rb\").read()\n        except OSError as error:\n            raise BuildError(f\"cannot read spec file: {error}\")\n        try:\n            spec = json.loads(raw.decode(\"utf-8-sig\"))\n        except (UnicodeError, json.JSONDecodeError) as error:\n            raise BuildError(f\"invalid JSON in spec: {error}\")\n        validate(spec)\n        if not TEMPLATE_PATH.is_file():\n            raise BuildError(f\"template not found next to the skill scripts: {TEMPLATE_PATH}\")\n        template = TEMPLATE_PATH.read_text(encoding=\"utf-8\")\n        qdata = {\n            \"title\": spec[\"title\"].strip(),\n            \"intro\": spec.get(\"intro\", \"\"),\n            \"cfg\": spec.get(\"cfg\", {}) or {},\n            \"submitter_fields\": spec[\"submitter_fields\"],\n            \"questions\": spec[\"questions\"],\n        }\n        embedded = json.dumps(qdata, ensure_ascii=False).replace(\"</\", \"<\\\\/\")\n        page = (\n            template.replace(\"{{QDATA_JSON}}\", embedded)\n            .replace(\"{{TITLE}}\", html.escape(spec[\"title\"].strip(), quote=True))\n            .replace(\"{{INTRO}}\", html.escape(spec.get(\"intro\", \"\")))\n        )\n        try:\n            with open(args.out, \"w\", encoding=\"utf-8\") as handle:\n                handle.write(page)\n        except OSError as error:\n            raise BuildError(f\"cannot write output file: {error}\")\n    except BuildError as error:\n        print(f\"build_questionnaire_error: {error}\", file=sys.stderr)\n        return 2\n    print(f\"wrote {args.out} ({len(spec['questions'])} questions)\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/build_questionnaire.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792739483825, "responseId": "chatcmpl-1792739483853", "__openclaw": {"runId": "15574562-fd3b-466d-a7b2-cb9dff608585"}}}
