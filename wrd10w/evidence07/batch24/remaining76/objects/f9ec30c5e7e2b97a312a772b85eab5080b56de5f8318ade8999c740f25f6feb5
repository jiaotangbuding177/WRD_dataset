{"type": "message", "id": "1cd8eb32-3cd7-4616-859d-de2a81cd7b3e", "parentId": "a4d5d425-8a8e-442b-a0b4-9bcfe0d9ecce", "timestamp": "2026-10-23T07:12:28.848Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "接下来是检查脚本和冒烟测试脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-31be38ced3634ac88b012929\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call38765bf492f44f8cb30eaa107fc8e2cd", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Structural self-check for a generated questionnaire HTML.\n\nPublic usage:\n    python {SKILL}/scripts/check_questionnaire.py {OUT}/<问卷名>.html [--spec {OUT}/spec.json]\n\nChecks:\n  1. tag pairing balance (HTML structure)\n  2. JS syntax of every <script> block via `node --check` (skipped with warning if node missing)\n  3. required features present (records, admin entry, CSV export, submitter fields)\n  4. with --spec: embedded QDATA matches the spec (title, question count, submitter labels)\n\nExit: 0 = all checks passed (warnings possible); 1 = problems found; 2 = usage/IO error.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom html.parser import HTMLParser\nfrom pathlib import Path\n\nVOID_TAGS = {\n    \"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\",\n    \"link\", \"meta\", \"param\", \"source\", \"track\", \"wbr\",\n}\n\n\nclass PairingChecker(HTMLParser):\n    def __init__(self) -> None:\n        super().__init__(convert_charrefs=True)\n        self.stack: list[tuple[str, int]] = []\n        self.errors: list[str] = []\n\n    def handle_starttag(self, tag: str, attrs) -> None:\n        if tag not in VOID_TAGS:\n            self.stack.append((tag, self.getpos()[0]))\n\n    def handle_endtag(self, tag: str) -> None:\n        if tag in VOID_TAGS:\n            return\n        if not self.stack:\n            self.errors.append(f\"line {self.getpos()[0]}: closing </{tag}> without matching opening tag\")\n            return\n        open_tag, line = self.stack.pop()\n        if open_tag != tag:\n            self.errors.append(f\"line {self.getpos()[0]}: </{tag}> closes <{open_tag}> opened at line {line}\")\n\n\ndef check_pairing(text: str) -> list[str]:\n    checker = PairingChecker()\n    try:\n        checker.feed(text)\n        checker.close()\n    except Exception as error:\n        return [f\"HTML parse failed: {error}\"]\n    for tag, line in checker.stack:\n        checker.errors.append(f\"line {line}: <{tag}> never closed\")\n    return checker.errors\n\n\ndef check_js(text: str) -> tuple[list[str], list[str]]:\n    errors, warnings = [], []\n    node = shutil.which(\"node\")\n    if not node:\n        return errors, [\"node not found; skipped JS syntax check\"]\n    blocks = re.findall(r\"<script[^>]*>(.*?)</script>\", text, flags=re.S | re.I)\n    with tempfile.TemporaryDirectory() as tmp:\n        for i, block in enumerate(blocks):\n            if not block.strip():\n                continue\n            path = Path(tmp) / f\"script_{i}.js\"\n            path.write_text(block, encoding=\"utf-8\")\n            proc = subprocess.run([node, \"--check\", str(path)], capture_output=True, text=True, timeout=30)\n            if proc.returncode != 0:\n                first = (proc.stderr or proc.stdout).strip().splitlines()\n                errors.append(f\"script block {i}: JS syntax error: {first[0] if first else proc.returncode}\")\n    return errors, warnings\n\n\ndef check_features(text: str) -> list[str]:\n    errors = []\n    for marker, desc in [\n        (\"localStorage\", \"submission record storage\"),\n        (\"exportCSV\", \"CSV export\"),\n        (\"提交记录管理\", \"admin entry\"),\n        (\"记录编号\", \"record id\"),\n        (\"QDATA-BEGIN\", \"embedded QDATA config block\"),\n    ]:\n        if marker not in text:\n            errors.append(f\"missing expected feature: {desc} (marker {marker!r} not found)\")\n    return errors\n\n\ndef extract_qdata(text: str):\n    m = re.search(r\"/\\* QDATA-BEGIN \\*/\\s*const QDATA = (.*?);\\s*/\\* QDATA-END \\*/\", text, flags=re.S)\n    if not m:\n        return None\n    try:\n        return json.loads(m.group(1).replace(\"<\\\\/\", \"</\"))\n    except json.JSONDecodeError:\n        return None\n\n\ndef check_spec(text: str, spec_path: str) -> list[str]:\n    errors = []\n    try:\n        spec = json.loads(Path(spec_path).read_text(encoding=\"utf-8-sig\"))\n    except (OSError, UnicodeError, json.JSONDecodeError) as error:\n        return [f\"cannot read spec {spec_path}: {error}\"]\n    qdata = extract_qdata(text)\n    if qdata is None:\n        return [\"embedded QDATA block missing or not valid JSON\"]\n    if qdata.get(\"title\") != spec.get(\"title\"):\n        errors.append(f\"title mismatch: html={qdata.get('title')!r} spec={spec.get('title')!r}\")\n    if len(qdata.get(\"questions\", [])) != len(spec.get(\"questions\", [])):\n        errors.append(\n            f\"question count mismatch: html={len(qdata.get('questions', []))} spec={len(spec.get('questions', []))}\"\n        )\n    labels_html = [f.get(\"label\") for f in qdata.get(\"submitter_fields\", [])]\n    labels_spec = [f.get(\"label\") for f in spec.get(\"submitter_fields\", [])]\n    if labels_html != labels_spec:\n        errors.append(f\"submitter fields mismatch: html={labels_html} spec={labels_spec}\")\n    return errors\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Structural self-check for a generated questionnaire HTML.\")\n    parser.add_argument(\"html\", help=\"generated questionnaire HTML file\")\n    parser.add_argument(\"--spec\", help=\"spec JSON to cross-check against the embedded QDATA\")\n    args = parser.parse_args()\n    try:\n        text = Path(args.html).read_text(encoding=\"utf-8\")\n    except (OSError, UnicodeError) as error:\n        print(f\"check_questionnaire_error: cannot read {args.html}: {error}\", file=sys.stderr)\n        return 2\n    errors, warnings = [], []\n    errors += check_pairing(text)\n    js_errors, js_warnings = check_js(text)\n    errors += js_errors\n    warnings += js_warnings\n    errors += check_features(text)\n    if args.spec:\n        errors += check_spec(text, args.spec)\n    report = {\"html\": args.html, \"errors\": errors, \"warnings\": warnings}\n    print(json.dumps(report, ensure_ascii=False, indent=2))\n    if errors:\n        return 1\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/check_questionnaire.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792739515351, "responseId": "chatcmpl-1792739515377", "__openclaw": {"runId": "15574562-fd3b-466d-a7b2-cb9dff608585"}}}
