btnUnlock\" class=\"ghost\" type=\"button\">解锁</button>\n      <span class=\"error\" id=\"adminMsg\"></span>\n    </div>\n    <div id=\"adminBody\" hidden>\n      <div class=\"row\" id=\"adminCount\"></div>\n      <div id=\"recordList\"></div>\n      <div class=\"row\">\n        <button id=\"btnCSV\" class=\"ghost\" type=\"button\">导出 CSV（Excel 可开）</button>\n        <button id=\"btnJSON\" class=\"ghost\" type=\"button\">导出 JSON 备份</button>\n        <label class=\"ghost\" style=\"display:inline-block;border:1px solid var(--line);border-radius:8px;padding:8px 14px;cursor:pointer\">导入回执\n          <input type=\"file\" id=\"receiptFile\" accept=\".json,application/json\" style=\"display:none\">\n        </label>\n        <span class=\"ok\" id=\"importMsg\"></span>\n      </div>\n    </div>\n  </section>\n</main>\n<footer>本问卷为本地 HTML 文件，提交记录保存在填写设备的浏览器中；分布式收集时请让受访者提交后下载答卷回执并发回。</footer>\n<script>\n/* ============================================================\n   CFG：问卷标题/说明/管理密码/实名字段/全部题目都在下面的 JSON 里，\n   直接改这份 JSON 并刷新页面即可生效，不需要改其他代码。\n   ============================================================ */\n/* QDATA-BEGIN */\nconst QDATA = {{QDATA_JSON}};\n/* QDATA-END */\n\n(function(){\n'use strict';\nvar $=function(s){return document.querySelector(s)};\nvar storeKey='qform:'+(QDATA.cfg&&QDATA.cfg.storage_key?QDATA.cfg.storage_key:QDATA.title);\nfunction loadRecords(){try{return JSON.parse(localStorage.getItem(storeKey))||[]}catch(e){return[]}}\nfunction saveRecords(r){localStorage.setItem(storeKey,JSON.stringify(r))}\nvar records=loadRecords();\nfunction pad2(n){return String(n).length<2?'0'+n:String(n)}\nfunction nowStr(){var d=new Date();return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate())+' '+pad2(d.getHours())+':'+pad2(d.getMinutes())+':'+pad2(d.getSeconds())}\nfunction randId(){var A='ABCDEFGHJKMNPQRSTUVWXYZ23456789',s='';for(var i=0;i<4;i++){s+=A[Math.floor(Math.random()*A.length)]}var d=new Date();return 'SUB-'+d.getFullYear()+pad2(d.getMonth()+1)+pad2(d.getDate())+'-'+s}\n\ndocument.title=QDATA.title;\n$('#qTitle').textContent=QDATA.title;\n$('#qIntro').textContent=QDATA.intro||'';\n\n/* 提交人信息 */\nvar sfWrap=$('#submitterFields');\n(QDATA.submitter_fields||[]).forEach(function(f,i){\n  var row=document.createElement('div');row.className='frow';\n  var lab=document.createElement('label');lab.textContent=f.label+(f.required?' *':'（选填）');lab.htmlFor='sf_'+i;\n  var inp=document.createElement('input');inp.type='text';inp.id='sf_'+i;\n  row.appendChild(lab);row.appendChild(inp);sfWrap.appendChild(row);\n});\n$('#submitterNote').textContent=(QDATA.cfg&&QDATA.cfg.submitter_note)||'本问卷会记录提交人信息，请如实填写。';\n\n/* 题目 */\nvar qWrap=$('#questions');\n(QDATA.questions||[]).forEach(function(q,qi){\n  var sec=document.createElement('section');sec.className='card q q-'+q.type;sec.id='q'+(qi+1);\n  var h=document.createElement('h2');\n  var extra=q.type==='checkbox'?'【多选'+(q.max?'，最多 '+q.max+' 项':'')+'】':'';\n  h.textContent=(qi+1)+'、'+q.title+(q.required?' *':'')+extra;\n  sec.appendChild(h);\n  if(q.type==='text'){\n    var inp=document.createElement('input');inp.type='text';inp.className='qtext';inp.placeholder=q.placeholder||'';\n    sec.appendChild(inp);\n  }else{\n    var box=document.createElement('div');box.className='opts';\n    (q.options||[]).forEach(function(op){\n      var o=document.createElement('label');o.className='opt';\n      var inp=document.createElement('input');inp.type=(q.type==='radio')?'radio':'checkbox';inp.name='q'+(qi+1);inp.value=op;\n      var sp=document.createElement('span');sp.textContent=op;\n      o.appendChild(inp);o.appendChild(sp);box.appendChild(o);\n      if(q.type==='checkbox'&&q.max){\n        inp.addEventListener('change',function(){\n          var c=box.querySelectorAll('input:checked');\n          if(c.length>q.max){inp.checked=false;window.alert('本题最多选择 '+q.max+' 项')}\n        });\n      }\n    });\n    sec.appendChild(box);\n  }\n  qWrap.appendChild(sec);\n});\n\nfunction collect(){\n  var answers=[];\n  (QDATA.questions||[]).forEach(function(q,qi){\n    var sec=document.getElementById('q'+(qi+1));var val;\n    if(q.type==='text'){val=sec.querySelector('input').value.trim()}\n    else{val=[];sec.querySelectorAll('input:checked').forEach(function(i){val.push(i.value)})}\n    answers.push(val);\n  });\n  return answers;\n}\n\n$('#btnSubmit').addEventListener('click',function(){\n  var err=$('#formError');err.textContent='';$('#submitResult').textContent='';\n  var missing=[];\n  (QDATA.submitter_fields||[]).forEach(function(f,i){\n    var el=document.getElementById('sf_'+i);\n    if(f.required&&!el.value.trim())missing.push(f.label);\n  });\n  var answers=collect();\n  answers.forEach(function(v,i){\n    var empty=(QDATA.questions[i].type==='text')?(v===''):(v.length===0);\n    if(QDATA.questions[i].required&&empty)missing.push('第'+(i+1)+'题');\n  });\n  if(missing.length){err.textContent='还有必填项未完成：'+missing.join('、');return}\n  var submitter={};\n  (QDATA.submitter_fields||[]).forEach(function(f,i){submitter[f.label]=document.getElementById('sf_'+i).value.trim()});\n  var rec={id:randId(),submitted_at:nowStr(),submitter:submitter,answers:answers};\n  records.push(rec);saveRecords(records);\n  $('#submitResult').textContent='提交成功！记录编号 '+rec.id+'（已保存到本机）';\n  var lastBtn=$('#btnReceipt');lastBtn.style.display='inline-block';\n  lastBtn.onclick=function(){download(rec.id+'.json',JSON.stringify(rec,null,2))};\n  document.querySelectorAll('#qForm input[type=text]').forEach(function(i){i.value=''});\n  document.querySelectorAll('#qForm input[type=radio],#qForm input[type=checkbox]').forEach(function(i){i.checked=false});\n  if(!$('#adminBody').hidden)renderAdminList();\n});\n\n/* 记录管理 */\nvar adminSec=$('#secAdmin');\n$('#btnAdmin').addEventListener('click',function(){adminSec.hidden=false;adminSec.scrollIntoView({behavior:'smooth'})});\n$('#btnUnlock').addEventListener('click',function(){\n  var pw=(QDATA.cfg&&QDATA.cfg.admin_password)||'666888';\n  if($('#adminPass').value===pw){$('#adminBody').hidden=false;$('#adminMsg').textContent='';renderAdminList()}\n  else{$('#adminMsg').textContent='密码不正确'}\n});\nfunction zipAnswers(rec){\n  var obj={};\n  (QDATA.questions||[]).forEach(function(q,i){obj['Q'+(i+1)+' '+q.title]=rec.answers[i]});\n  return obj;\n}\nfunction renderAdminList(){\n  var wrap=$('#recordList');wrap.textContent='';\n  $('#adminCount').textContent='共 '+records.length+' 份提交';\n  if(!records.length){wrap.textContent='暂无提交记录';return}\n  records.forEach(function(r,ri){\n    var d=document.createElement('details');\n    var s=document.createElement('summary');\n    var who=[];for(var k in r.submitter){who.push(r.submitter[k])}\n    s.textContent=r.id+' · '+r.submitted_at+' · '+who.join(' / ');\n    var pre=document.createElement('pre');pre.textContent=JSON.stringify(zipAnswers(r),null,2);\n    var del=document.createElement('button');del.textContent='删除这条';del.className='danger';\n    del.addEventListener('click',function(){\n      if(window.confirm('删除 '+r.id+'？')){records.splice(ri,1);saveRecords(records);renderAdminList()}\n    });\n    d.appendChild(s);d.appendChild(pre);d.appendChild(del);wrap.appendChild(d);\n  });\n}\nfunction csvCell(v){v=String(v==null?'':v);return '\"'+v.replace(/\"/g,'\"\"')+'\"'}\nfunction exportCSV(){\n  var heads=['记录编号','提交时间'];\n  (QDATA.submitter_fields||[]).forEach(function(f){heads.push(f.label)});\n  (QDATA.questions||[]).forEach(function(q,i){heads.push('Q'+(i+1)+' '+q.title)});\n  var lines=[heads.map(csvCell).join(',')];\n  records.forEach(function(r){\n    var row=[r.id,r.submitted_at];\n    (QDATA.submitter_fields||[]).forEach(function(f){row.push(r.submitter[f.label]||'')});\n    (QDATA.questions||[]).forEach(function(q,i){var v=r.answers[i];row.push(Object.prototype.toString.call(v)==='[object Array]'?v.join(' | '):v)});\n    lines.push(row.map(csvCell).join(','));\n  });\n  return '\\uFEFF'+lines.join('\\r\\n');\n}\nfunction exportJSON(){return JSON.stringify({title:QDATA.title,exported_at:nowStr(),records:records},null,2)}\nfunction mergeReceipts(list){\n  var added=0,skipped=0,have={};\n  records.forEach(function(r){have[r.id]=1});\n  list.forEach(function(r){\n    if(r&&r.id&&!have[r.id]){records.push(r);have[r.id]=1;added++}else{skipped++}\n  });\n  if(added){saveRecords(records);renderAdminList()}\n  return {added:added,skipped:skipped};\n}\nfunction download(name,text){\n  var b=new Blob([text],{type:'text/plain;charset=utf-8'});\n  var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();\n  setTimeout(function(){URL.revokeObjectURL(a.href)},2000);\n}\n$('#btnCSV').addEventListener('click',function(){download(QDATA.title+'-提交记录.csv',exportCSV())});\n$('#btnJSON').addEventListener('click',function(){download(QDATA.title+'-提交记录备份.json',exportJSON())});\n$('#receiptFile').addEventListener('change',function(){\n  var f=this.files[0];if(!f)return;\n  var fr=new FileReader();\n  fr.onload=function(){\n    try{\n      var data=JSON.parse(fr.result);\n      if(Object.prototype.toString.call(data)!=='[object Array]')data=[data];\n      var res=mergeReceipts(data);\n      $('#importMsg').textContent='合并完成：新增 '+res.added+'，跳过 '+res.skipped;\n    }catch(e){$('#importMsg').textContent='回执文件不是合法 JSON'}\n  };\n  fr.readAsText(f);\n  this.value='';\n});\n\n/* 供自检/冒烟脚本调用的最小接口 */\nwindow.__qform={\n  getRecords:function(){return records},\n  exportCSV:exportCSV,\n  exportJSON:exportJSON,\n  mergeReceipts:mergeReceipts\n};\n})();\n</script>\n</body>\n</html>\n", "path": "/workspace/outputs/skill/templates/questionnaire.template.html"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792739339944, "responseId": "chatcmpl-1792739339970", "__openclaw": {"runId": "155