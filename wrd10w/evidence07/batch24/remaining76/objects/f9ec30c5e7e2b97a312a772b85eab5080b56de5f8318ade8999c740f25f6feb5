{"type": "message", "id": "8c297182-c0d3-46ac-8694-cb0953f4a7d5", "parentId": "754198e8-cdfc-455b-b77e-3c0cef05f692", "timestamp": "2026-10-23T07:11:06.205Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "接下来是解析脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-1574e3d0f9444e23a0ff65ed\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call79d95a7c25b149babc5356e5c5a5d7e4", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Parse a wjx (问卷星) questionnaire page into a structure spec JSON.\n\nPublic usage:\n    python {SKILL}/scripts/parse_wjx.py <问卷URL或已保存的HTML路径> --out {OUT}/spec_raw.json [--timeout 20]\n\nInput : wjx share page URL (https://v.wjx.cn/vm/xxx.aspx) or a locally saved HTML file.\nOutput: spec JSON {source, fetched_at, title, intro, questions, warnings, note}.\n        questions: [{\"type\":\"radio|checkbox|text|other\",\"title\",\"required\",\"options\",\"wjx_type\"}]\n        题目文案仅为结构参考；按用户新场景改写后再交给 build_questionnaire.py。\nExit  : 0 parsed >=1 questions; 1 page fetched but no questions found; 2 fetch/IO/usage error.\nErrors: single-line \"parse_wjx_error: ...\" on stderr.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport html as html_mod\nimport json\nimport re\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nUA = (\n    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \"\n    \"(KHTML, like Gecko) Chrome/124.0 Safari/537.36\"\n)\nTYPE_MAP = {\"1\": \"text\", \"3\": \"radio\", \"4\": \"checkbox\"}\nTAG_RE = re.compile(r\"<[^>]+>\")\nWS_RE = re.compile(r\"\\s+\")\n\n\nclass ParseError(Exception):\n    pass\n\n\ndef strip_tags(raw: str) -> str:\n    text = TAG_RE.sub(\"\", raw)\n    text = html_mod.unescape(text)\n    return WS_RE.sub(\" \", text).strip()\n\n\ndef load_html(source: str, timeout: int) -> str:\n    if re.match(r\"^https?://\", source, flags=re.I):\n        try:\n            import requests\n        except ImportError as error:\n            raise ParseError(f\"requests not available: {error}\")\n        try:\n            resp = requests.get(source, headers={\"User-Agent\": UA}, timeout=timeout)\n        except Exception as error:  # network, DNS, timeout...\n            raise ParseError(f\"fetch failed: {error}\")\n        if resp.status_code != 200:\n            raise ParseError(f\"fetch failed: HTTP {resp.status_code} for {source}\")\n        raw = resp.content\n        encoding = None\n        head = raw[:2048].decode(\"ascii\", errors=\"ignore\")\n        m = re.search(r'charset=[\"\\']?([\\w-]+)', head, flags=re.I)\n        if m:\n            encoding = m.group(1)\n        for enc in filter(None, [encoding, \"utf-8\"]):\n            try:\n                return raw.decode(enc)\n            except UnicodeDecodeError:\n                continue\n        return raw.decode(\"utf-8\", errors=\"replace\")\n    path = Path(source)\n    if not path.is_file():\n        raise ParseError(f\"local file not found: {source}\")\n    data = path.read_bytes()\n    for enc in (\"utf-8\", \"gb18030\"):\n        try:\n            return data.decode(enc)\n        except UnicodeDecodeError:\n            continue\n    return data.decode(\"utf-8\", errors=\"replace\")\n\n\ndef extract_title(page: str) -> str:\n    m = re.search(r\"<title>(.*?)</title>\", page, flags=re.I | re.S)\n    if not m:\n        return \"\"\n    title = strip_tags(m.group(1))\n    # wjx titles often carry a suffix like \"问卷星级\" noise; keep plain text as-is\n    return title\n\n\ndef extract_intro(page: str) -> str:\n    m = re.search(r'id=\"divDesc\".*?<span class=\"description\">(.*?)</span>', page, flags=re.I | re.S)\n    return strip_tags(m.group(1)) if m else \"\"\n\n\ndef field_chunks(page: str) -> list[tuple[dict, str]]:\n    \"\"\"Split the page into (attrs, chunk) pairs, one per question field div.\"\"\"\n    starts = [m for m in re.finditer(r\"<div class='field[^>]*>\", page)]\n    end = page.find(\"</fieldset>\")\n    chunks = []\n    for i, m in enumerate(starts):\n        attrs_src = m.group(0)\n        attrs = {\n            k: v\n            for k, v in re.findall(r\"([\\w-]+)='([^']*)'\", attrs_src)\n        }\n        if \"topic\" not in attrs:\n            continue\n        chunk_end = starts[i + 1].start() if i + 1 < len(starts) else (end if end != -1 else len(page))\n        chunks.append((attrs, page[m.start():chunk_end]))\n    return chunks\n\n\ndef parse_question(attrs: dict, chunk: str) -> dict:\n    wjx_type = attrs.get(\"type\", \"\")\n    qtype = TYPE_MAP.get(wjx_type, \"other\")\n    m = re.search(r\"<div class='topichtml'>(.*?)</div>\", chunk, flags=re.S)\n    title = strip_tags(m.group(1)) if m else \"\"\n    title = re.sub(r\"<span class='qtypetip'>.*?</span>\", \"\", m.group(1), flags=re.S) if m else \"\"\n    title = strip_tags(title)\n    title = re.sub(r\"^\\d+、\", \"\", title).strip()\n    required = attrs.get(\"req\", \"0\") == \"1\" and \"选填\" not in title\n    options = [strip_tags(o) for o in re.findall(r\"<div class='label'[^>]*>(.*?)</div>\", chunk, flags=re.S)]\n    if not options:\n        options = [strip_tags(o) for o in re.findall(r\"<div class=\"label\"[^>]*>(.*?)</div>\", chunk, flags=re.S)]\n    question = {\"type\": qtype, \"title\": title, \"required\": required}\n    if qtype in (\"radio\", \"checkbox\"):\n        question[\"options\"] = options\n    if qtype == \"text\":\n        placeholder = re.search(r\"placeholder='([^']*)'\", chunk)\n        if placeholder:\n            question[\"placeholder\"] = html_mod.unescape(placeholder.group(1))\n    maxsel = re.search(r\"maxsel='(\\d+)'\", chunk)\n    if qtype == \"checkbox\" and maxsel:\n        question[\"max\"] = int(maxsel.group(1))\n    if qtype == \"other\":\n        question[\"wjx_type\"] = wjx_type\n        if options:\n            question[\"options\"] = options\n    return question\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Parse a wjx questionnaire page into a structure spec.\")\n    parser.add_argument(\"source\", help=\"wjx page URL or locally saved HTML file\")\n    parser.add_argument(\"--out\", required=True, help=\"path of the spec JSON to write\")\n    parser.add_argument(\"--timeout\", type=int, default=20, help=\"fetch timeout seconds for URLs\")\n    args = parser.parse_args()\n    try:\n        page = load_html(args.source, args.timeout)\n        title = extract_title(page)\n        intro = extract_intro(page)\n        chunks = field_chunks(page)\n        questions = [parse_question(attrs, chunk) for attrs, chunk in chunks]\n        warnings = []\n        for idx, q in enumerate(questions, 1):\n            if q[\"type\"] == \"other\":\n                warnings.append(f\"Q{idx}: 未识别的问卷星题型 type={q.get('wjx_type')}，需人工转换成 radio/checkbox/text\")\n            elif q[\"type\"] in (\"radio\", \"checkbox\") and len(q.get(\"options\", [])) < 2:\n                warnings.append(f\"Q{idx}: 选项少于2个，解析可能不完整\")\n            elif q[\"type\"] in (\"radio\", \"checkbox\") and not q.get(\"options\"):\n                warnings.append(f\"Q{idx}: 未解析到选项\")\n        if not questions:\n            warnings.append(\"页面中未找到任何题目（可能不是问卷页、问卷已停止或需要登录）\")\n        spec = {\n            \"source\": args.source,\n            \"fetched_at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"title\": title,\n            \"intro\": intro,\n            \"questions\": questions,\n            \"warnings\": warnings,\n            \"note\": \"题目文案仅为结构参考；按用户新场景改写 title/options 后另存 spec 再运行 build_questionnaire.py\",\n        }\n        try:\n            with open(args.out, \"w\", encoding=\"utf-8\") as handle:\n                json.dump(spec, handle, ensure_ascii=False, indent=2)\n        except OSError as error:\n            raise ParseError(f\"cannot write output: {error}\")\n    except ParseError as error:\n        print(f\"parse_wjx_error: {error}\", file=sys.stderr)\n        return 2\n    if not questions:\n        print(\"parse_wjx_warning: 0 questions parsed; see warnings in output\", file=sys.stderr)\n        return 1\n    print(f\"parsed {len(questions)} questions -> {args.out}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/parse_wjx.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792739415065, "responseId": "chatcmpl-1792739415088", "__openclaw": {"runId": "15574562-fd3b-466d-a7b2-cb9dff608585"}}}
