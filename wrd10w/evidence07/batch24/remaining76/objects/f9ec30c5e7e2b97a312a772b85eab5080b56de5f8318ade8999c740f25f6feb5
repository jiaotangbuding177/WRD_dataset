{"type": "message", "id": "7f2cadda-546a-493e-bd2e-8272572d1e10", "parentId": "e1a7f974-2dbe-4a6d-8d3b-cd142d8ee3c6", "timestamp": "2026-10-23T07:02:36.910Z", "message": {"role": "toolResult", "toolCallId": "call1d0b0b65c19241ee8743c9d7f49b857e", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"Compose a self-contained teaching demo HTML page from a page spec.\n\nFills templates/teaching_page.template.html with the spec topic, section plan\nand interaction list, producing one single-file HTML document that opens\ndirectly in a browser with no backend and no external css/js.\n\nPublic usage:\n    python {SKILL}/scripts/build_teaching_page.py {INPUT}/page_spec.json --out {OUT}/teaching.html\n\nInput: page-spec JSON {\"topic\",\"request_text\",\"source_id\",\"source_message_id\",\"interactions\",\"sections\"}\nOutput: one self-contained HTML file (UTF-8).\nErrors: exit 2 with a single-line \"build_teaching_page_error: ...\" diagnostic on stderr.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport html\nimport json\nimport sys\nfrom pathlib import Path\n\nTEMPLATE_PATH = Path(__file__).resolve().parent.parent / \"templates\" / \"teaching_page.template.html\"\nSECTION_KINDS = {\"demo\", \"cards\", \"table\", \"timeline\", \"quiz\", \"text\"}\nSECTION_TITLES = {\n    \"demo\": \"互动演示\",\n    \"cards\": \"知识卡片\",\n    \"table\": \"数据对比\",\n    \"timeline\": \"探索里程碑\",\n    \"quiz\": \"课堂小测验\",\n    \"text\": \"知识讲解\",\n}\n\n\nclass BuildError(Exception):\n    pass\n\n\ndef esc(value):\n    return html.escape(str(value), quote=True)\n\n\ndef scaffold(message):\n    return f\"<div class=\\\"stage\\\">{esc(message)}</div>\"\n\n\ndef render_demo(index, section):\n    parts = [\"<div class=\\\"stage\\\">演示画布挂载区：按主题在此区域挂载具体动画脚本</div>\"]\n    body = section.get(\"body\")\n    if isinstance(body, str) and body:\n        parts.append(f\"<p>{esc(body)}</p>\")\n    controls = section.get(\"controls\")\n    if isinstance(controls, list) and controls:\n        badges = \"\".join(f\"<span>{esc(item)}</span>\" for item in controls)\n        parts.append(f\"<div class=\\\"badges\\\">{badges}</div>\")\n    return \"\\n\".join(parts)\n\n\ndef render_text(index, section):\n    return f\"<p>{esc(section.get('body', ''))}</p>\"\n\n\ndef render_cards(index, section):\n    items = section.get(\"items\")\n    if items is None:\n        return scaffold(\"卡片数据待填充：在规格的 items 列表补齐 name/desc/facts 后重跑\")\n    if not isinstance(items, list):\n        raise BuildError(f\"section {index} of kind cards needs an items list\")\n    cards = []\n    for item in items:\n        if not isinstance(item, dict):\n            raise BuildError(f\"section {index} card item must be an object\")\n        facts = item.get(\"facts\")\n        facts_html = f\"<p class=\\\"facts\\\">{esc(facts)}</p>\" if isinstance(facts, str) and facts else \"\"\n        cards.append(\n            \"<div class=\\\"card\\\"><h3>\" + esc(item.get(\"name\", \"\")) + \"</h3><p>\"\n            + esc(item.get(\"desc\", \"\")) + \"</p>\" + facts_html + \"</div>\"\n        )\n    return \"<div class=\\\"grid\\\">\\n\" + \"\\n\".join(cards) + \"\\n</div>\"\n\n\ndef render_table(index, section):\n    headers = section.get(\"headers\")\n    rows = section.get(\"rows\")\n    if headers is None and rows is None:\n        return scaffold(\"表格数据待填充：在规格补齐 headers 与 rows 后重跑\")\n    if not isinstance(headers, list) or not isinstance(rows, list):\n        raise BuildError(f\"section {index} of kind table needs headers and rows lists\")\n    head = \"\".join(f\"<th>{esc(cell)}</th>\" for cell in headers)\n    body = \"\\n\".join(\n        \"<tr>\" + \"\".join(f\"<td>{esc(cell)}</td>\" for cell in row) + \"</tr>\"\n        for row in rows\n        if isinstance(row, list)\n    )\n    return f\"<table><thead><tr>{head}</tr></thead><tbody>\\n{body}\\n</tbody></table>\"\n\n\ndef render_timeline(index, section):\n    items = section.get(\"items\")\n    if items is None:\n        return scaffold(\"时间线数据待填充：在规格的 items 列表补齐 year/event 后重跑\")\n    if not isinstance(items, list):\n        raise BuildError(f\"section {index} of kind timeline needs an items list\")\n    lines = [\n        \"<li><strong>\" + esc(item.get(\"year\", \"\")) + \"</strong> \" + esc(item.get(\"event\", \"\")) + \"</li>\"\n        for item in items\n        if isinstance(item, dict)\n    ]\n    return \"<ul class=\\\"timeline\\\">\\n\" + \"\\n\".join(lines) + \"\\n</ul>\"\n\n\ndef render_quiz(index, section):\n    questions = section.get(\"questions\")\n    if questions is None:\n        return scaffold(\"测验数据待填充：在规格的 questions 列表补齐题目与答案索引后重跑\")\n    if not isinstance(questions, list):\n        raise BuildError(f\"section {index} of kind quiz needs a questions list\")\n    blocks = []\n    for number, question in enumerate(questions, start=1):\n        if not isinstance(question, dict):\n            raise BuildError(f\"section {index} question {number} must be an object\")\n        options = question.get(\"options\")\n        answer = question.get(\"answer\")\n        if not isinstance(options, list) or not options:\n            raise BuildError(f\"section {index} question {number} needs a non-empty options list\")\n        if not isinstance(answer, int) or not 0 <= answer < len(options):\n            raise BuildError(f\"section {index} question {number} has an invalid answer index\")\n        buttons = \"\\n\".join(\n            f\"<button type=\\\"button\\\" data-correct=\\\"{'1' if position == answer else '0'}\\\">{esc(option)}</button>\"\n            for position, option in enumerate(options)\n        )\n        blocks.append(\n            \"<div class=\\\"question\\\"><p>\" + f\"{number}. \" + esc(question.get(\"question\", \"\"))\n            + \"</p><div class=\\\"options\\\">\\n\" + buttons + \"\\n</div></div>\"\n        )\n    return \"\\n\".join(blocks)\n\n\nRENDERERS = {\n    \"demo\": render_demo,\n    \"text\": render_text,\n    \"cards\": rende