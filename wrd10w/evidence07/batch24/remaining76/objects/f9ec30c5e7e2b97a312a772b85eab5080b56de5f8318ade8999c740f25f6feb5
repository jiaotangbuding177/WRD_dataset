{"type": "message", "id": "e80adbc3-06c2-474a-9ed8-169d7e46cfa3", "parentId": "6394431b-0849-4b6d-a7ed-7f457863e7ec", "timestamp": "2026-10-23T07:13:12.127Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call42763935769f4dc398ce259ebfa7cc5c", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Functional smoke test for a generated questionnaire HTML (Playwright + Chromium).\n\nPublic usage:\n    python {SKILL}/scripts/smoke_test.py {OUT}/<问卷名>.html [--spec {OUT}/spec.json]\n\nSimulates a real filling session in headless Chromium:\n  1. empty submit is blocked with an error, no record saved\n  2. fill submitter fields + answer all questions + submit -> record saved with 记录编号\n  3. second submission accumulates (on-device continuous collection)\n  4. CSV export has header + one row per record\n  5. admin panel unlocks with the configured password and lists records\n  6. receipt merge dedupes by record id\n\nWith --spec the admin password and submitter labels are read from the spec;\notherwise the embedded QDATA in the HTML is used.\nExit: 0 all passed; 1 any check failed; 2 usage/environment error.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nCHROMIUM = \"/usr/bin/chromium\"\nLAUNCH_ARGS = [\"--no-sandbox\"]\n\n\ndef fail(msg: str) -> None:\n    print(f\"FAIL: {msg}\")\n\n\ndef ok(msg: str) -> None:\n    print(f\"PASS: {msg}\")\n\n\ndef load_qdata(html_path: str):\n    text = Path(html_path).read_text(encoding=\"utf-8\")\n    import re\n\n    m = re.search(r\"/\\* QDATA-BEGIN \\*/\\s*const QDATA = (.*?);\\s*/\\* QDATA-END \\*/\", text, flags=re.S)\n    if not m:\n        return None\n    return json.loads(m.group(1).replace(\"<\\\\/\", \"</\"))\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"Functional smoke test for a questionnaire HTML.\")\n    parser.add_argument(\"html\", help=\"generated questionnaire HTML file\")\n    parser.add_argument(\"--spec\", help=\"spec JSON (optional; falls back to embedded QDATA)\")\n    args = parser.parse_args()\n    if not Path(args.html).is_file():\n        print(f\"smoke_test_error: file not found: {args.html}\", file=sys.stderr)\n        return 2\n    if args.spec:\n        cfg = json.loads(Path(args.spec).read_text(encoding=\"utf-8-sig\"))\n    else:\n        cfg = load_qdata(args.html)\n    if not cfg:\n        print(\"smoke_test_error: no spec given and no embedded QDATA found\", file=sys.stderr)\n        return 2\n\n    try:\n        from playwright.sync_api import sync_playwright\n    except ImportError as error:\n        print(f\"smoke_test_error: playwright not available: {error}\", file=sys.stderr)\n        return 2\n\n    admin_password = ***\"cfg\") or {}).get(\"admin_password\", \"666888\")\n    fields = cfg[\"submitter_fields\"]\n    questions = cfg[\"questions\"]\n    failures = []\n\n    with sync_playwright() as p:\n        browser = p.chromium.launch(executable_path=CHROMIUM, args=LAUNCH_ARGS)\n        page = browser.new_page()\n        page.goto(Path(args.html).resolve().as_uri())\n        page.wait_for_selector(\"#btnSubmit\")\n\n        # 1. empty submit blocked\n        page.click(\"#btnSubmit\")\n        if \"还有必填项未完成\" in page.text_content(\"#formError\") or \"必填\" in page.text_content(\"#formError\"):\n            ok(\"empty submit blocked with error message\")\n        else:\n            failures.append(\"empty submit did not show validation error\")\n            fail(failures[-1])\n        if page.evaluate(\"window.__qform.getRecords().length\") == 0:\n            ok(\"no record saved on invalid submit\")\n        else:\n            failures.append(\"record saved despite invalid submit\")\n            fail(failures[-1])\n\n        # 2. fill and submit\n        def fill_and_submit(name: str) -> str:\n            for i, f in enumerate(fields):\n                page.fill(f\"#sf_{i}\", name if f.get(\"required\", True) else \"\")\n            for qi, q in enumerate(questions, start=1):\n                sec = page.locator(f\"#q{qi}\")\n                if q[\"type\"] == \"radio\":\n                    sec.locator(\".opts input[type=radio]\").first.check()\n                elif q[\"type\"] == \"checkbox\":\n                    limit = min(2, len(q[\"options\"]), q.get(\"max\", 2))\n                    for oi in range(limit):\n                        sec.locator(\".opts input[type=checkbox]\").nth(oi).check()\n                else:\n                    sec.locator(\"input.qtext\").fill(f\"测试作答-{qi}\")\n            page.click(\"#btnSubmit\")\n            return page.text_content(\"#submitResult\").strip()\n\n        result = fill_and_submit(\"测试张三\")\n        if \"记录编号\" in result:\n            ok(f\"first submit succeeded ({result[:40]}...)\")\n        else:\n            failures.append(f\"first submit failed: {result}\")\n            fail(failures[-1])\n        records = page.evaluate(\"window.__qform.getRecords()\")\n        if len(records) == 1 and records[0][\"submitter\"].get(fields[0][\"label\"]) == \"测试张三\":\n            ok(\"record saved with submitter info\")\n        else:\n            failures.append(f\"record content wrong: {json.dumps(records, ensure_ascii=False)[:200]}\")\n            fail(failures[-1])\n        first_id = records[0][\"id\"] if records else \"\"\n        if records and records[0][\"id\"].startswith(\"SUB-\"):\n            ok(f\"record id format ok ({first_id})\")\n        else:\n            failures.append(f\"record id format wrong: {first_id}\")\n            fail(failures[-1])\n\n        # 3. second submission accumulates\n        page.reload()\n        page.wait_for_selector(\"#btnSubmit\")\n        fill_and_submit(\"测试李四\")\n        count = page.evaluate(\"window.__qform.getRecords().length\")\n        if count == 2:\n            ok(\"second submission accumulated (2 records)\")\n        else:\n            failures.append(f\"expected 2 records, got {count}\")\n            fail(failures[-1])\n\n        # 4. CSV export\n        csv = page.evaluate(\"window.__qform.exportCSV()\")\n        lines = [line for line in csv.split(\"\\r\\n\") if line]\n        if \"记录编号\" in lines[0] and len(lines) == 3 and \"测试张三\" in csv and \"测试李四\" in csv:\n            ok(\"CSV export has header + 2 record rows\")\n        else:\n            failures.append(f\"CSV export unexpected: {len(lines)} lines, first={lines[0][:60] if lines else ''}\")\n            fail(failures[-1])\n\n        # 5. admin unlock + list\n        page.click(\"#btnAdmin\")\n        page.fill(\"#adminPass\", \"wrongpass\")\n        page.click(\"#btnUnlock\")\n        if \"密码不正确\" in page.text_content(\"#adminMsg\"):\n            ok(\"wrong admin password rejected\")\n        else:\n            failures.append(\"wrong admin password not rejected\")\n            fail(failures[-1])\n        page.fill(\"#adminPass\", admin_password)\n        page.click(\"#btnUnlock\")\n        if not page.locator(\"#adminBody\").is_hidden():\n            listed = page.locator(\"#recordList details\").count()\n            if listed == 2:\n                ok(\"admin panel unlocked and lists 2 records\")\n            else:\n                failures.append(f\"admin record list shows {listed} entries, expected 2\")\n                fail(failures[-1])\n        else:\n            failures.append(\"admin panel did not unlock with correct password\")\n            fail(failures[-1])\n\n        # 6. receipt merge dedupes\n        receipt = page.evaluate(\"JSON.stringify(window.__qform.getRecords()[0])\")\n        res = page.evaluate(f\"window.__qform.mergeReceipts([{receipt}])\")\n        if res[\"added\"] == 0 and res[\"skipped\"] == 1:\n            ok(\"receipt import dedupes existing record id\")\n        else:\n            failures.append(f\"receipt merge unexpected: {res}\")\n            fail(failures[-1])\n\n        browser.close()\n\n    if failures:\n        print(f\"smoke_test_result: {len(failures)} failure(s)\")\n        return 1\n    print(\"smoke_test_result: all checks passed\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/smoke_test.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792739548982, "responseId": "chatcmpl-1792739549021", "__openclaw": {"runId": "15574562-fd3b-466d-a7b2-cb9dff608585"}}}
