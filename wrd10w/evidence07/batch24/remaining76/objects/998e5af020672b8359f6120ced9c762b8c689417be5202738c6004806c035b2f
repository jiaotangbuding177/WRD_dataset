5)\n\nwb = Workbook()\nws = wb.active\nws.title = \"合生纪日记账\"\nws.append([\"序号\", \"日期\", \"摘要\", \"收入\", \"支出\", \"余额\"])\nbalance = 0.0\nfor i, (d, s, inc, exp) in enumerate(ledger, 1):\n    balance += (inc or 0) - (exp or 0)\n    ws.append([i, d, s, inc, exp, round(balance, 2)])\n\nws2 = wb.create_sheet(\"合生纪康日记账\")\nws2.append([\"序号\", \"日期\", \"摘要\", \"收入\", \"支出\", \"余额\"])\nb2 = 0.0\nfor i, (d, s, inc, exp) in enumerate([\n    (\"2026-02-05\", \"合生纪出资款\", 20000, None),\n    (\"2026-03-21\", \"收息\", 0.13, None),\n    (\"2026-06-21\", \"收息\", 0.29, None),\n], 1):\n    b2 += (inc or 0) - (exp or 0)\n    ws2.append([i, d, s, inc, exp, round(b2, 2)])\nwb.save(OUT + \"/银行日记账样例.xlsx\")\n\n# ---- 2025年度汇总模板（公式结构对照真实表：小计/净现金流/累计=A4+净现金流）----\nt = Workbook()\ns = t.active\ns.title = \"现金流汇总\"\nbold = Font(bold=True)\nthin = Side(style=\"thin\")\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\ns[\"A1\"] = \"合生纪2025年年度现金流汇总\"\ns[\"A1\"].font = Font(bold=True, size=14)\ns[\"C3\"], s[\"D3\"], s[\"E3\"] = \"项目名称\", \"金额\", \"摘要\"\ns[\"A4\"] = 101500.59\nrows = {\n    4: (\"期初余额\", None, None),\n    5: (\"一、经营性流入\", None, None),\n    6: (\"经营性流入\", 0, \"\"),\n    7: (\"账户结息\", 0.14, \"\"),\n    8: (\"实收资本\", 60500, \"上海绘勉50100；上海溢新100000\"),\n    9: (\"营业收入小计\", \"=D6+D7+D8\", None),\n    10: (\"流入合计\", \"=D9\", None),\n    11: (\"二、经营性流出\", None, None),\n    12: (\"员工报销\", 932, \"\"),\n    13: (\"服务费\", 58400, \"微康30000；松淼4000；知企邦5000；墨眉1300；亚星10000；一力行5500；汶桦2600\"),\n    14: (\"专利评估服务费\", 0, \"\"),\n    15: (\"其他支出\", 91.65, \"\"),\n    16: (\"营业支出小计\", \"=D12+D13+D14+D15\", None),\n    17: (\"三、投资性流出\", None, None),\n    18: (\"长期股权投资\", 60500, \"\"),\n    19: (\"净现金流\", \"=D10-D16-D18\", None),\n    20: (\"累计净现金流\", \"=A4+D19\", None),\n}\nfor r, (label, amount, note) in rows.items():\n    s.cell(row=r, column=3, value=label)\n    if amount is not None:\n        s.cell(row=r, column=4, value=amount)\n    if note:\n        s.cell(row=r, column=5, value=note