{"type": "message", "id": "6443030a-de35-4e3a-800a-631fff6adb9b", "parentId": "78403f84-8794-4f1e-a073-feec1713dc13", "timestamp": "2026-10-23T07:04:35.592Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在是核心构建脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-7f8e0499523443bcb61345e8\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call69e8ddd38927439fa297746b48b1269d", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"按既有汇总表模板生成新期间现金流量汇总（保留公式与样式）。\n\n用法:\n  python3 summary_build.py --template 上期汇总.xlsx --journal journal.json \\\n      --start YYYY-MM-DD --end YYYY-MM-DD --out 新汇总.xlsx \\\n      [--rules rules.json] [--opening 1076.49] [--title 新标题]\n\njournal.json 由本技能 scripts/journal_extract.py 生成。\n行为:\n- 复制模板工作簿生成新表，样式/合并单元格/列宽/公式全部保留；\n- 按 rules.categories 的摘要关键词把期内流水分类，回填到模板对应项目行（金额列）；\n- extra_items 中金额非 0 的项目在 after 指定行后插入新行（复制行样式），\n  小计公式自动扩展（加号式追加 +D行，SUM 式扩展区间），其余公式行号整体平移；\n- 期初余额写入 rules.opening_cell：默认取流水开始日前最后一笔的余额，--opening 覆盖；\n- 未命中任何规则的流水逐条列出，不编造归类，人工判断后补规则重跑；\n- 退出码: 0 成功; 2 参数/文件错误; 3 模板中未找到项目行; 4 有未归类流水（文件仍生成）。\n不修改输入文件。\n\"\"\"\nimport argparse\nimport copy as copymod\nimport datetime as dt\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\n\nDEFAULT_RULES = Path(__file__).resolve().parent.parent / \"templates\" / \"summary_rules.json\"\n\n\ndef parse_date(value):\n    if value is None:\n        return None\n    if isinstance(value, dt.datetime):\n        return value.date()\n    if isinstance(value, dt.date):\n        return value\n    text = str(value).strip().replace(\"年\", \"-\").replace(\"月\", \"-\").replace(\"日\", \"\")\n    text = text.replace(\"/\", \"-\").replace(\".\", \"-\")\n    m = re.match(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})\", text)\n    if not m:\n        return None\n    try:\n        return dt.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))\n    except ValueError:\n        return None\n\n\ndef load_entries(journal_path):\n    data = json.loads(Path(journal_path).read_text(encoding=\"utf-8\"))\n    entries = []\n    for f in data.get(\"files\", []):\n        for s in f.get(\"sheets\", []):\n            for e in s.get(\"entries\", []):\n                date = parse_date(e.get(\"date\"))\n                amounts = e.get(\"amounts\", {})\n                entries.append({\n                    \"date\": date,\n                    \"summary\": (e.get(\"summary\") or \"\") + \" \" + \" \".join(e.get(\"raw\", [])),\n                    \"summary0\": e.get(\"summary\") or \"\",\n                    \"income\": amounts.get(\"income\") or amounts.get(\"amount\") if amounts.get(\"amount\", 0) and amounts.get(\"amount\", 0) > 0 and \"income\" not in amounts else amounts.get(\"income\"),\n                    \"expense\": amounts.get(\"expense\") or (amounts.get(\"amount\") if \"amount\" in amounts and \"income\" not in amounts else None),\n                    \"balance\": amounts.get(\"balance\"),\n                    \"row\": e.get(\"row\"),\n                    \"file\": f.get(\"file\"),\n                })\n    return entries\n\n\ndef classify(entries, start, end, rules):\n    \"\"\"返回 (归类结果{label:[entry]}, 未归类[entry])；首条命中生效。\"\"\"\n    cats = rules.get(\"categories\", [])\n    result = {c[\"label\"]: [] for c in cats}\n    for c in rules.get(\"extra_items\", []):\n        result.setdefault(c[\"label\"], [])\n    unmatched = []\n    for e in entries:\n        if not (start <= e[\"date\"] <= end):\n            continue\n        has_income = e[\"income\"] is not None and e[\"income\"] != 0\n        has_expense = e[\"expense\"] is not None and e[\"expense\"] != 0\n        hit = None\n        for c in cats + rules.get(\"extra_items\", []):\n            if any(k in e[\"summary\"] for k in c.get(\"match\", [])) and not any(\n                    k in e[\"summary\"] for k in c.get(\"exclude\", [])):\n                scope = c.get(\"scope\")\n                if scope == \"income\" and has_income:\n                    hit = c\n                    break\n                if scope == \"expense\" and has_expense:\n                    hit = c\n                    break\n        if hit:\n            result[hit[\"label\"]].append(e)\n        else:\n            unmatched.append(e)\n    return result, unmatched\n\n\ndef find_label_layout(ws, labels):\n    \"\"\"扫描工作表定位项目名称列（命中标签最多的列）及各标签所在行。\"\"\"\n    col_hits = {}\n    label_rows = {}\n    for row in ws.iter_rows():\n        for cell in row:\n            v = cell.value\n            if not isinstance(v, str):\n                continue\n            text = v.strip()\n            for lb in labels:\n                if text == lb and lb not in label_rows:\n                    label_rows[lb] = cell.row\n                    col_hits[cell.column] = col_hits.get(cell.column, 0) + 1\n    if not label_rows:\n        return None, {}\n    label_col = max(col_hits, key=col_hits.get)\n    return label_col, label_rows\n\n\ndef shift_formulas(ws, min_row, offset):\n    \"\"\"insert_rows 不会平移公式引用，这里手工把行号 >= min_row 的引用 +offset。\"\"\"\n    if offset == 0:\n        return\n    ref_re = re.compile(r'(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\n    for row in ws.iter_rows():\n        for cell in row:\n            v = cell.value\n            if isinstance(v, str) and v.startswith(\"=\"):\n                parts, last = [], 0\n                for m in ref_re.finditer(v):\n                    parts.append(v[last:m.start()])\n                    r = int(m.group(4))\n                    if r >= min_row:\n                        r += offset\n                    parts.append(\"%s%s%s%d\" % (m.group(1), m.group(2), m.group(3), r))\n                    last = m.end()\n                parts.append(v[last:])\n                cell.value = \"\".join(parts)\n\n\ndef copy_row_style(ws, src_row, dst_row, col_start, col_end):\n    for col in range(col_start, col_end + 1):\n        s, d = ws.cell(row=src_row, column=col), ws.cell(row=dst_row, column=col)\n        if s.has_style:\n            d.font = copymod.copy(s.font)\n            d.border = copymod.copy(s.border)\n            d.fill = copymod.copy(s.fill)\n            d.number_format = s.number_format\n            d.alignment = copymod.copy(s.alignment)\n        d._style = copymod.copy(s._style)\n    if src_row in ws.row_dimensions:\n        dst = ws.row_dimensions[dst_row]\n        src = ws.row_dimensions[src_row]\n        dst.height = src.height\n\n\ndef extend_subtotals(ws, label_col, anchor_row, new_rows):\n    \"\"\"新行插入后，把引用了锚点行的小计公式补上新行：加号式追加，SUM 式扩区间。\"\"\"\n    marker = rules.get(\"subtotal_marker\", \"小计\")\n    col = get_column_letter(label_col + 1)\n    first, last = new_rows[0], new_rows[-1]\n    for row in ws.iter_rows():\n        for cell in row:\n            v = cell.value\n            if not (isinstance(v, str) and v.startswith(\"=\")):\n                continue\n            lb = ws.cell(row=cell.row, column=label_col).value\n            if not (isinstance(lb, str) and marker in lb):\n                continue\n            # 加号式: =D12+D13+D15 且含锚点行\n            plus_refs = re.findall(r'%s(\\d+)' % col, v)\n            if anchor_row in [int(x) for x in plus_refs]:\n                adds = \"+\".join(\"%s%d\" % (col, r) for r in new_rows)\n                cell.value = v + \"+\" + adds\n                continue\n            # SUM 式: =SUM(D13:D15) 且锚点在区间\n            for m in re.finditer(r'SUM\\(%s(\\d+):%s(\\d+)\\)' % (col, col), v):\n                lo, hi = int(m.group(1)), int(m.group(2))\n                if lo <= anchor_row <= hi:\n                    new_lo, new_hi = min(lo, first), max(hi, last)\n                    cell.value = v[:m.start()] + \"SUM(%s%d:%s%d)\" % (col, new_lo, col, new_hi) + v[m.end():]\n                    break\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--template\", required=True, help=\"上期汇总表 xlsx（作为格式与公式模板）\")\n    ap.add_argument(\"--journal\",