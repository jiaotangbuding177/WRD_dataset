{
  "_填写须知": "job.duties 与 dept.functions 的 weight 合计必须=100（全空也合法），填完自查；此为 build 退出2最常见原因。本键与渲染无关，仅作提醒。",
  "doc": {
    "title": "示例公司-部门职能与岗位说明书",
    "fonts": {"label": "黑体", "body": "宋体"},
    "sizes": {"body": 9, "title": 12}
  },
  "_紧凑写法": "多岗位文档推荐：顶层 defaults 注入所有 job 块公共字段（如 date/approver/salary），job.duties 元素直接写 \"30% 职责文字\" 字符串（无数字前缀即无权重），quals 可写字符串列表逐行渲染，dept.functions 元素可写 \"30% 模块 | 具体职责\"。只有用户给的模板格式需要精细控制时才用下方完整 dict 写法。下面第2个 job 块即紧凑示例。",
  "blocks": [
    {
      "type": "company_overview",
      "title": "公司概况",
      "rows": [
        ["公司定位", "{{一句话定位，取自用户给的背景}}"],
        ["主营业务", "{{用户给的产品/业务}}"],
        ["组织架构", "{{用户给的中心-部门清单}}"]
      ]
    },
    {
      "type": "dept",
      "name": "{{软件开发部}}",
      "code": "{{YF-SW}}",
      "center": "{{研发中心}}",
      "positioning": "{{一句话部门定位，取自用户架构与业务背景}}",
      "functions": [
        {"item": "{{职能模块1}}", "weight": 30, "detail": "{{具体职责}}"},
        {"item": "{{职能模块2}}", "weight": 25, "detail": "{{具体职责}}"},
        {"item": "{{职能模块3}}", "weight": 45, "detail": "{{具体职责}}"}
      ],
      "staffing": "{{编制建议，如 经理1人+工程师2-3人}}",
      "boundary": "{{与兄弟部门的分工边界，新增/易混淆部门必写}}"
    },
    {
      "type": "job",
      "title": "{{软件工程师}}",
      "code": "{{YF-SW-01}}",
      "dept": "{{软件开发部}}",
      "family": "{{专业序列P}}",
      "grade": "{{P5}}",
      "reports_to": "{{软件开发部经理}}",
      "salary": "{{留空或'待定'，用户未给不编造}}",
      "date": "{{YYYY-MM-DD或留空}}",
      "approver": "{{核准人，用户未给留空}}",
      "summary": "{{一句话职位概要：负责什么，达成什么}}",
      "duties": [
        {"weight": 30, "text": "{{职责1，权重可按模板惯例 30/25/15/15/10/5}}"},
        {"weight": 25, "text": "{{职责2}}"},
        {"weight": 15, "text": "{{职责3}}"},
        {"weight": 15, "text": "{{职责4}}"},
        {"weight": 10, "text": "{{职责5}}"},
        {"weight": 5, "text": "{{职责6}}"}
      ],
      "quals": {
        "education": "{{学历/专业门槛，仅取自用户材料}}",
        "training": "{{培训经历，无则省略该键}}",
        "experience": "{{年限与领域经验}}",
        "skills": "{{技能技巧，逐项}}",
        "attitude": "{{态度要求}}"
      },
      "conditions": {"workplace": "{{工作场所}}", "hazards": "{{危险性，默认'无'}}"},
      "signature": true
    },
    {
      "type": "job",
      "title": "{{硬件工程师（紧凑写法示例）}}",
      "dept": "{{研发部}}",
      "summary": "{{一句话职位概要}}",
      "duties": [
        "40% {{职责1}}",
        "30% {{职责2}}",
        "30% {{职责3}}"
      ],
      "quals": [
        "教育背景：{{本科及以上，XX专业}}",
        "经验：{{N年XX经验}}",
        "技能：{{逐项技能}}"
      ]
    },
    {
      "type": "org_unit",
      "name": "{{项目管理办公室}}",
      "code": "{{ZKXF-PMO}}",
      "unit_type": "{{常设管理机构 / 委员会}}",
      "members": "{{组成成员}}",
      "meeting": "{{议事频次，如 每季度一次}}",
      "outputs": "{{主要输出物}}",
      "positioning": "{{一句话机构定位}}",
      "functions": [
        {"item": "{{职能模块}}", "subs": ["{{子项1}}", "{{子项2}}"]},
        {"item": "{{职能模块2}}", "subs": ["{{子项}}"]}
      ]
    }
  ]
}
