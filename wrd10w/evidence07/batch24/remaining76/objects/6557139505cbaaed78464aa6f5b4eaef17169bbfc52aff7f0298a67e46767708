\"mentions\": bucket[ref][\"mentions\"]}\n            for ref in sorted(bucket)\n        ]\n\n    return {\n        \"tables\": as_list(tables),\n        \"figures\": as_list(figures),\n        \"tables_total\": len(tables),\n        \"figures_total\": len(figures),\n        \"numeric_lines\": numeric_lines,\n        \"numbers_total\": numbers_total,\n        \"chars\": len(text),\n    }\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=\"扫描论文文本中的表/图引用与数值\")\n    parser.add_argument(\"input\", help=\"已提取的论文文本（.txt/.md）\")\n    parser.add_argument(\"--out\", required=True, help=\"输出 scan.json 路径\")\n    args = parser.parse_args(argv)\n    src = Path(args.input)\n    try:\n        if not src.is_file():\n            raise ValueError(\"input not found: \" + str(src))\n        if src.suffix.lower() not in SUPPORTED:\n            raise ValueError(\"unsupported input type \" + src.suffix + \": expected .txt or .md\")\n        try:\n            text = src.read_text(encoding=\"utf-8\")\n        except UnicodeError as error:\n            raise ValueError(\"input is not valid UTF-8 text: \" + str(error))\n    except (OSError, ValueError) as error:\n        print(\"scan_numeric_refs error: \" + str(error), file=sys.stderr)\n        return 2\n    result = scan_text(text)\n    result[\"source\"] = src.name\n    out = Path(args.out)\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(result, ensure_ascii=False, indent=1) + \"\\n\", encoding=\"utf-8\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792609087353, "responseId": "chatcmpl-1792609087454", "__openclaw": {"runId": "1651bade-2179-4bcd-86d6-2c2b5b67baeb"}}}
