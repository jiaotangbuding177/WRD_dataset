#!/usr/bin/env python3
"""凭据脱敏 + 接口权限闸（库 + CLI）。

库用法（目标项目里直接 import 本文件即可，无第三方依赖）:
    from redact import redact, assert_draft_only

    # 异常/日志出口统一过 redact；extra 传入本进程可能持有的密钥原文做纵深抹除
    safe = redact(str(err), extra_secrets=[os.environ.get("WECHAT_APP_SECRET", "")])

    # 请求发出前调闸：命中发布/群发类端点直接抛 PermissionError
    assert_draft_only(url)

CLI 用法:
    python redact.py --text "https://api.x.com/token?access_token=ABC123"
    python redact.py --file err.log --redact-value "$SOME_SECRET" --redact-value "$OTHER"
    python redact.py --check-url "https://api.weixin.qq.com/cgi-bin/freepublish/submit"

退出码: 0 正常；3 权限闸拦截（--check-url 命中禁用端点）。
"""

import argparse
import sys
import re

# URL 查询参数与 key=value 形式里视为敏感的参数名
_SENSITIVE_PARAM = re.compile(
    r"(?i)(access_token|app_?secret|secret|token|api_?key|apikey|password|passwd|auth_code|sign|appid)"
)

# key=value / "key": "value" / 'key'='value' 形式（名字与值均可带引号）
_KV = re.compile(
    r"(?i)(['\"]?)(access_token|app_?secret|secret|token|api_?key|apikey|password|passwd|auth_code)(['\"]?)"
    r"(\s*[=:]\s*)(['\"]?)([^'\"&\s,;}]{4,})(\5)"
)

# 代码级禁用的端点片段（小写匹配）；草稿-only 闸默认拦截这些
BLOCKED_ENDPOINTS = (
    "message/mass",
    "mass/sendall",
    "sendall",
    "freepublish",
    "custom/send",
    "tags/message",
)


def redact(text, extra_secrets=()):
    """抹除 text 中的敏感参数值与 extra_secrets 原文，返回安全文本。"""
    if text is None:
        return ""
    text = str(text)
    # 1) key=value / "key": "value" / URL 查询参数：值替换为 ***（保留参数名与引号，便于排错）
    text = _KV.sub(lambda m: m.group(1) + m.group(2) + m.group(3) + m.group(4) + m.group(5) + "***" + m.group(7), text)
    # 2) 纵深抹除：调用方提供的密钥原文，出现即整段替换，不留首尾片段
    for s in extra_secrets:
        if s and len(str(s)) >= 4:
            text = text.replace(str(s), "***")
    return text


def assert_draft_only(url):
    """草稿-only 闸：url 命中发布/群发类端点时抛 PermissionError。放行返回 True。"""
    u = str(url).lower()
    for frag in BLOCKED_ENDPOINTS:
        if frag in u:
            raise PermissionError("draft-only policy: blocked endpoint fragment '%s' in %s" % (frag, redact(url)))
    return True


def _mask_url(url):
    """对 URL 查询串里的敏感参数值打码（与 _KV 独立处理 ?a=b&c=d）。"""
    def repl(m):
        name = m.group(1)
        return name + "=" + ("***" if _SENSITIVE_PARAM.search(name) else m.group(2))
    return re.sub(r"([\w.-]+)=([^&\s]*)", repl, url)


def main():
    ap = argparse.ArgumentParser(description="凭据脱敏与草稿-only 权限闸")
    ap.add_argument("--text", help="要脱敏的文本")
    ap.add_argument("--file", help="要脱敏的文件（逐行输出）")
    ap.add_argument("--redact-value", action="append", default=[], metavar="VALUE", help="额外要抹除的密钥原文，可重复")
    ap.add_argument("--check-url", help="只做权限闸检查：命中禁用端点则退出码 3")
    args = ap.parse_args()

    if args.check_url:
        try:
            assert_draft_only(args.check_url)
        except PermissionError as e:
            print("BLOCKED:", e)
            return 3
        print("ALLOWED:", _mask_url(args.check_url))
        return 0

    if args.file:
        with open(args.file, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                print(redact(line.rstrip("\n"), extra_secrets=args.redact_value))
        return 0

    if args.text is not None:
        print(redact(args.text, extra_secrets=args.redact_value))
        return 0

    ap.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
