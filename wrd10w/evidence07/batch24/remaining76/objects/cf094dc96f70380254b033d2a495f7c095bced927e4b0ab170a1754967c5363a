r}\")\n    except (UnicodeError, json.JSONDecodeError) as error:\n        fail(f\"invalid spec JSON: {error}\")\n    if not isinstance(spec, dict) or not str(spec.get(\"title\", \"\")).strip():\n        fail(\"spec must be a JSON object with non-empty 'title'\")\n    return spec\n\n\ndef draw_centered(draw: ImageDraw.ImageDraw, y: int, text: str, font,\n                  color: str, width: int, tracking: int = 0) -> int:\n    if tracking:\n        text = (\" \".join(list(text))).replace(\"  \", \" \") if len(text) <= 8 else text\n    left, top, right, bottom = draw.textbbox((0, 0), text, font=font)\n    draw.text(((width - (right - left)) // 2, y), text, font=font, fill=color)\n    return bottom - top\n\n\ndef wrap_to_width(draw: ImageDraw.ImageDraw, text: str, font, max_w: int):\n    lines, current = [], \"\"\n    for char in text:\n        trial = current + char\n        if draw.textbbox((0, 0), trial, font=font)[2] > max_w and current:\n            lines.append(current)\n            current = char\n        else:\n            current = trial\n    if current:\n        lines.append(current)\n    return lines\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"程序化生成封面页 PNG\")\n    parser.add_argument(\"spec\", help=\"封面规格 JSON 路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出 PNG 路径\")\n    args = parser.parse_args()\n    spec = load_spec(args.spec)\n\n    size = spec.get(\"page_size\") or [1920, 1080]\n    if (not isinstance(size, list) or len(size) != 2\n            or not all(isinstance(v, int) and 100 <= v <= 8192 for v in size)):\n        fail(\"page_size must be [width, height] ints in 100..8192\")\n    width, height = size\n    accent = spec.get(\"accent\", \"#d4af37\")\n    bg_dark = float(spec.get(\"bg_dark\", 0.55))\n    if not 0 <= bg_dark <= 1:\n        fail(\"bg_dark must be within 0..1\")\n\n    bg_path = spec.get(\"background\")\n    if bg_path:\n        source = Path(bg_path)\n        if not source.is_file():\n            fail(f\"background image not found: {bg_path}\")\n        try:\n            background = Image.open(source).convert(\"RGB\")\n        except OSError as error:\n            fail(f\"cannot decode background: {error}\")\n        scale = max(width / background.width, height / background.height)\n        background = background.resize(\n            (round(background.width * scale), round(background.height * scale)))\n        left = (background.width - width) // 2\n        top = (background.height - height) // 2\n        background = background.crop((left, top, left + width, top + height))\n    else:\n        background = Image.new(\"RGB\", (width, height), \"#101418\")\n    overlay = Image.new(\"L\", (width, height), round(255 * bg_dark))\n    background = Image.composite(Image.new(\"RGB\", (width, height), \"#000000\"),\n                                 background, overlay)\n    draw = ImageDraw.Draw(background)\n\n    title_font = find_font(round(height * 0.16))\n    subtitle_font = find_font(round(height * 0.045))\n    list_font = find_font(round(height * 0.038))\n    footer_font = find_font(round(height * 0.032))\n\n    y = round(height * 0.16)\n    y += draw_centered(draw, y, spec[\"title\"], title_font, accent, width) + round(height * 0.04)\n    line_w = round(width * 0.24)\n    draw.rectangle(((width - line_w) // 2, y, (width + line_w) // 2, y + 4), fill=accent)\n    y += round(height * 0.035)\n    for sub_line in str(spec.get(\"subtitle\", \"\")).split(\"\\n\"):\n        if sub_line.strip():\n            y += draw_centered(draw, y, sub_line, subtitle_font, \"#e8e8e8\", width) + 8\n\n    items = [str(item) for item in spec.get(\"items\", []) if str(item).strip()]\n    if items:\n        columns = int(spec.get(\"list_columns\", 2))\n        if not 1 <= columns <= 3:\n            fail(\"list_columns must be 1..3\")\n        rows = (len(items) + columns - 1) // columns\n        col_w = round(width * 0.86) // columns\n        x0 = round(width * 0.07)\n        max_row_h = list_font.size + 14\n        list_h = rows * max_row_h\n        y_list = min(y + round(height * 0.05), height - list_h - round(height * 0.16))\n        for index, item in enumerate(items):\n            row, col = divmod(index, columns)\n            draw.text((x0 + col * col_w, y_list + row * max_row_h), item,\n                      font=list_font, fill=\"#f0f0f0\")\n\n    footer = str(spec.get(\"footer\", \"\")).strip()\n    if footer:\n        for footer_line in footer.split(\"\\n\"):\n            draw_centered(draw, height - round(height * 0.09), footer_line, footer_font,\n                          \"#c8c8c8\", width)\n\n    out = Path(args.out)\n    try:\n        if out.parent and not out.parent.exists():\n            out.parent.mkdir(parents=True, exist_ok=True)\n        background.save(out)\n    except OSError as error:\n        fail(f\"cannot write output: {error}\")\n    print(f\"{out} ({width}x{height})\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792732319738, "responseId": "chatcmpl-1792732319769", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "089e8360-f115-4f70-89b6-811cdf8eab6d"}}}
