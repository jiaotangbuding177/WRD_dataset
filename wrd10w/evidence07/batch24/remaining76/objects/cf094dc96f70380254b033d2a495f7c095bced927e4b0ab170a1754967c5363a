{"type": "message", "id": "d9c03c30-28f5-4543-bf56-8b9620b70aee", "parentId": "de4e7074-3dcc-411d-b5fe-c096d977a95e", "timestamp": "2026-10-23T05:15:49.087Z", "message": {"role": "assistant", "content": [{"type": "toolCall", "id": "call5d855a046a3e4d76bced597853c723b8", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"单款包装展开刀模绘制：盒体六面 + 插舌 + 裁切线/折线区分 + mm 尺寸标注。\n\n结构（插舌封底盒）：横向四面板 背面(W)-左侧(D)-正面(W)-右侧(D)，\n正面上下各接 同宽顶盖/底盖(D) 与 插舌(15mm)。裁切线黑实线、折线红虚线、\n标注蓝色。正面主视觉图与背面款式列表按参数嵌入；精确尺寸由代码保证，\n不受生图随机性影响（生图模型画不出可用刀模）。\n\n公开用法：\n  python make_dieline.py --width 80 --depth 80 --height 80 \\\n    --front FRONT.png --title \"S1 单款包装刀模 · 02 主体\" \\\n    --spec \"350g 白卡 · 四色+专金\" --list \"款1,款2,款3\" --out DIELINE.png\n错误：exit 2（dieline_error: ...）。\n\"\"\"\nimport argparse\nimport sys\nfrom pathlib import Path\n\nfrom PIL import Image, ImageDraw, ImageFont\n\nCUT = \"#111111\"\nFOLD = \"#cc2222\"\nDIM = \"#2255cc\"\n\n\ndef fail(message: str) -> None:\n    print(\"dieline_error: \" + message, file=sys.stderr)\n    raise SystemExit(2)\n\n\ndef find_font(size: int):\n    for path in (\"/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc\",\n                 \"/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc\"):\n        if Path(path).is_file():\n            try:\n                return ImageFont.truetype(path, size)\n            except OSError:\n                continue\n    try:\n        return ImageFont.truetype(\"DejaVuSans.ttf\", size)\n    except OSError:\n        fail(\"no usable font found\")\n\n\ndef dashed_line(draw, x0, y0, x1, y1, dash=8, gap=6, width=2):\n    import math\n    length = math.hypot(x1 - x0, y1 - y0)\n    if length == 0:\n        return\n    steps = int(length // (dash + gap)) + 1\n    for i in range(steps):\n        start = i * (dash + gap)\n        end = min(start + dash, length)\n        if start >= length:\n            break\n        t0, t1 = start / length, end / length\n        draw.line((x0 + (x1 - x0) * t0, y0 + (y1 - y0) * t0,\n                   x0 + (x1 - x0) * t1, y0 + (y1 - y0) * t1), fill=FOLD, width=width)\n\n\ndef edge(draw, p0, p1, fold: bool) -> None:\n    if fold:\n        dashed_line(draw, p0[0], p0[1], p1[0], p1[1])\n    else:\n        draw.line((*p0, *p1), fill=CUT, width=3)\n\n\ndef rect_edges(draw, box, folds=()) -> None:\n    x0, y0, x1, y1 = box\n    sides = [((x0, y0), (x1, y0)), ((x1, y0), (x1, y1)),\n             ((x1, y1), (x0, y1)), ((x0, y1), (x0, y0))]\n    for index, (p0, p1) in enumerate(sides):\n        edge(draw, p0, p1, index in folds)\n\n\ndef dim_h(draw, x0, x1, y, label: str, font) -> None:\n    draw.line((x0, y, x1, y), fill=DIM, width=2)\n    for x in (x0, x1):\n        draw.line((x - 5, y - 5, x + 5, y + 5), fill=DIM, width=2)\n    draw.text(((x0 + x1) // 2 - draw.textbbox((0, 0), label, font=font)[2] // 2,\n               y + 6), label, font=font, fill=DIM)\n\n\ndef dim_v(draw, y0, y1, x, label: str, font) -> None:\n    draw.line((x, y0, x, y1), fill=DIM, width=2)\n    for y in (y0, y1):\n        draw.line((x - 5, y - 5, x + 5, y + 5), fill=DIM, width=2)\n    draw.text((x + 8, (y0 + y1) // 2 - font.size // 2), label, font=font, fill=DIM)\n\n\ndef label(draw, box, text: str, font, fill=\"#888888\") -> None:\n    x0, y0, x1, y1 = box\n    w = draw.textbbox((0, 0), text, font=font)[2]\n    draw.text(((x0 + x1) // 2 - w // 2, (y0 + y1) // 2 - font.size // 2), text,\n              font=font, fill=fill)\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"绘制单款包装展开刀模 PNG\")\n    parser.add_argument(\"--width\", type=float, required=True, help=\"盒宽 mm\")\n    parser.add_argument(\"--depth\", type=float, required=True, help=\"盒深 mm\")\n    parser.add_argument(\"--height\", type=float, required=True, help=\"盒高 mm\")\n    parser.add_argument(\"--front\", default=\"\", help=\"正面主视觉图 PNG 路径（可选）\")\n    parser.add_argument(\"--title\", default=\"单款包装展开刀模\")\n    parser.add_argument(\"--spec\", default=\"350g 白卡 · 四色印刷\", help=\"纸材/工艺说明\")\n    parser.add_argument(\"--list\", default=\"\", help=\"背面款式列表，逗号分隔（可选）\")\n    parser.add_argument(\"--scale\", type=float, default=6.0, help=\"像素/毫米\")\n    parser.add_argument(\"--out\", required=True, help=\"输出 PNG 路径\")\n    args = parser.parse_args()\n    for name in (\"width\", \"depth\", \"height\"):\n        if not 20 <= getattr(args, name) <= 500:\n            fail(f\"--{name} must be within 20..500 mm\")\n    if not 2 <= args.scale <= 20:\n        fail(\"--scale must be within 2..20 px/mm\")\n\n    s = args.scale\n    W, D, H = round(args.width * s), round(args.depth * s), round(args.height * s)\n    TUCK = round(15 * s)\n    margin = 70\n    head_h = 150\n    foot_h = 110\n    body_w = 2 * W + 2 * D\n    total_w = body_w + margin * 2\n    total_h = margin + head_h + TUCK + D + H + D + TUCK + foot_h + margin\n    canvas = Image.new(\"RGB\", (total_w, round(total_h)), \"#ffffff\")\n    draw = ImageDraw.Draw(canvas)\n    font_s = find_font(24)\n    font_m = find_font(30)\n    font_l = find_font(44)\n\n    y_head = margin\n    draw.text((margin, y_head), args.title, font=font_l, fill=\"#111111\")\n    draw.text((margin, y_head + 60),\n              f\"盒体 {args.width:g}×{args.depth:g}×{args.height:g} mm · {args.spec} · 实线=裁切线 红虚线=折线\",\n              font=font_s, fill=\"#555555\")\n\n    y0 = margin + head_h\n    strip_top = y0 + TUCK + D\n    x_back0 = margin\n    x_side0 = x_back0 + W\n    x_front0 = x_side0 + D\n    x_rside0 = x_front0 + W\n    x_end = x_rside0 + D\n\n    # 面板主体（背面/左侧/正面/右侧），竖直折线\n    for x in (x_back0, x_side0, x_front0, x_rside0, x_end):\n        edge(draw, (x, strip_top), (x, strip_top + H), x in (x_side0, x_front0, x_rside0))\n    edge(draw, (x_back0, strip_top), (x_end, strip_top), False)\n    edge(draw, (x_back0, strip_top + H), (x_end, strip_top + H), False)\n    label(draw, (x_back0, strip_top, x_side0, strip_top + H), \"背面\", font_m)\n    label(draw, (x_side0, strip_top, x_front0, strip_top + H), \"左侧面\", font_m)\n    label(draw, (x_front0, strip_top, x_rside0, strip_top + H), \"正面\", font_m)\n    label(draw, (x_rside0, strip_top, x_end, strip_top + H), \"右侧面\", font_m)\n\n    # 顶盖与底盖（正面列上下），盖深 D，插舌 TUCK\n    for cap_top, fold_bottom in ((y0, False), (strip_top + H, True)):\n        cap_box = (x_front0, cap_top, x_rside0, cap_top + D)\n        rect_edges(draw, cap_box, folds=((1 if cap_top == y0 else 3),))\n        tuck_y1 = cap_top - TUCK if cap_top == y0 else cap_top + D + TUCK\n        rect_edges(draw, (x_front0 + W // 6, min(cap_top, tuck_y1),\n                          x_rside0 - W // 6, max(cap_top, tuck_y1)),\n                   folds=(2,) if cap_top == y0 else (0,))\n        label(draw, cap_box, \"顶盖\" if cap_top == y0 else \"底盖\", font_m)\n        label(draw, (x_front0 + W // 6, min(cap_top, tuck_y1),\n                     x_rside0 - W // 6, max(cap_top, tuck_y1)), \"插舌\", font_s)\n\n    # 正面主视觉\n    if args.front:\n        front_img = Path(args.front)\n        if not front_img.is_file():\n            fail(f\"--front image not found: {args.front}\")\n        try:\n            visual = Image.open(front_img).convert(\"RGB\")\n        except OSError as error:\n            fail(f\"cannot decode front visual: {error}\")\n        box_w, box_h = W - 20, H - 20\n        scale = min(box_w / visual.width, box_h / visual.height)\n        visual = visual.resize((round(visual.width * scale), round(visual.height * scale)))\n        canvas.paste(visual, (x_front0 + (W - visual.width) // 2,\n                              strip_top + (H - visual.height) // 2))\n\n    # 背面款式列表 + 条码位\n    items = [item.strip() for item in args.list.split(\",\") if item.strip()]\n    if items:\n        columns = 2\n        rows = (len(items) + columns - 1) // columns\n        cell_w, cell_h = (W - 24) // columns, min(34 * s, (H - 80) // max(rows, 1))\n        for index, item in enumerate(items):\n            row, col = divmod(index, columns)\n            cell = (x_back0 + 12 + col * cell_w, strip_top + 10 + row * cell_h,\n                    x_back0 + 12 + (col + 1) * cell_w - 8, strip_top + 10 + (row + 1) * cell_h - 6)\n            draw.rectangle(cell, outline=\"#999999\", width=1)\n            draw.text((cell[0] + 6, cell[1] + 4), item, font=font_s, fill=\"#333333\")\n        draw.rectangle((x_back0 + W - 120, strip_top + H - 70,\n                        x_back0 + W - 16, strip_top + H - 16), outline=\"#111111\", width=2)\n        draw.text((x_back0 + W - 112, strip_top + H - 62), \"条码位\", font=font_s, fill=\"#666666\")\n\n    # 尺寸标注\n    dim_y = strip_top + H + D + TUCK + 40\n    dim_h(draw, x_back0, x_side0, dim_y, f\"{args.width:g}mm\", font_s)\n    dim_h(draw, x_side0, x_front0, dim_y, f\"{args.depth:g}mm\", font_s)\n    dim_h(draw, x_front0, x_rside0, dim_y, f\"{args.width:g}mm\", font_s)\n    dim_h(draw, x_rside0, x_end, dim_y, f\"{args.depth:g}mm\", font_s)\n    dim_v(draw, strip_top, strip_top + H, x_back0 - 40, f\"H {args.height:g}mm\", font_s)\n    dim_v(draw, y0 + TUCK, y0 + TUCK + D, x_front0 - 40, f\"D {args.depth:g}mm\", font_s)\n\n    out = Path(args.out)\n    try:\n        if out.parent and not out.parent.exists():\n            out.parent.mkdir(parents=True, exist_ok=True)\n        canvas.save(out)\n    except OSError as error:\n        fail(f\"cannot write output: {error}\")\n    print(f\"{out} ({canvas.width}x{canvas.height})\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/skill/scripts/make_dieline.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792732483542, "responseId": "chatcmpl-1792732483601", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "089e8360-f115-4f70-89b6-811cdf8eab6d"}}}
