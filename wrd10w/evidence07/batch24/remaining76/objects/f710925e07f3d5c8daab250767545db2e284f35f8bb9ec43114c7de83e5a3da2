#!/usr/bin/env python3
"""批量简历PDF文本提取（JD-简历筛选路线 s2）。

用法:
  python extract_resumes.py <简历目录或单个.pdf>... --out <输出目录>

每个输入是目录（非递归扫描 *.pdf，按文件名排序）或单个 .pdf。要求PDF含可提取
文本层；扫描图/乱码字体的简历会被标记为 low_text_or_garbled（不在此程序内OCR）。

输出（写入 --out 目录）:
  index.json      : {schema, inputs[], profiles[]}
                    profiles[] 每份简历一条摘要: {file_name, source_path, sha256,
                    pages, text_chars, cjk_chars, text_quality, text_file}
                    只含元数据与质量标记，不含正文——正文按需读 texts/ 下对应文件，
                    避免整批全文进入上下文。
  texts/<名>.txt  : 每份简历的完整提取文本（同目录同名自动加序号，不覆盖）。

text_quality: cjk_chars >= 50 为 "clean"，否则 "low_text_or_garbled"
（含义：无可靠文本层，需OCR兜底，本程序不做OCR）。

退出码: 0 = 成功（含0份PDF）；2 = 用法错误、路径不存在或PDF不可读（stderr指名文件）。
路径不重叠；重复输入按解析路径去重。
"""
import argparse
import hashlib
import json
import logging
import sys
from pathlib import Path

import pypdf

logging.getLogger("pypdf").setLevel(logging.ERROR)


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def collect_pdfs(paths):
    seen = set()
    pdfs = []
    for raw in paths:
        p = Path(raw)
        if not p.exists():
            raise FileNotFoundError(f"input path does not exist: {raw}")
        if p.is_dir():
            files = sorted(x for x in p.iterdir() if x.is_file() and x.suffix.lower() == ".pdf")
        elif p.suffix.lower() == ".pdf":
            files = [p]
        else:
            files = []
        for f in files:
            key = str(f.resolve())
            if key not in seen:
                seen.add(key)
                pdfs.append(f)
    return pdfs


def extract_one(pdf: Path):
    try:
        reader = pypdf.PdfReader(str(pdf))
        pages = [(page.extract_text() or "") for page in reader.pages]
    except Exception as exc:
        raise ValueError(f"{pdf}: not a valid PDF or unreadable ({type(exc).__name__})") from exc
    text = "\n".join(pages)
    cjk = sum(1 for ch in text if "\u4e00" <= ch <= "\u9fff")
    return text, {
        "file_name": pdf.name,
        "source_path": str(pdf),
        "sha256": sha256_file(pdf),
        "pages": len(pages),
        "text_chars": len(text),
        "cjk_chars": cjk,
        "text_quality": "clean" if cjk >= 50 else "low_text_or_garbled",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="批量简历PDF文本提取")
    parser.add_argument("inputs", nargs="+", help="简历目录或 .pdf 文件（可多个）")
    parser.add_argument("--out", required=True, help="输出目录（index.json + texts/*.txt）")
    args = parser.parse_args()

    try:
        pdfs = collect_pdfs(args.inputs)
    except (FileNotFoundError, NotADirectoryError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    out_dir = Path(args.out)
    texts_dir = out_dir / "texts"
    texts_dir.mkdir(parents=True, exist_ok=True)

    profiles = []
    used_names = set()
    for pdf in pdfs:
        try:
            text, meta = extract_one(pdf)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2
        stem = pdf.stem
        txt_name = stem + ".txt"
        k = 1
        while txt_name in used_names:
            k += 1
            txt_name = f"{stem}_{k}.txt"
        used_names.add(txt_name)
        (texts_dir / txt_name).write_text(text, encoding="utf-8")
        meta["text_file"] = f"texts/{txt_name}"
        profiles.append(meta)

    result = {
        "schema": "resume-text-extraction-v2",
        "inputs": [
            {
                "path": str(p),
                "kind": "file" if p.suffix.lower() == ".pdf" else "dir",
                **({"sha256": sha256_file(p)} if p.is_file() else {}),
            }
            for p in map(Path, args.inputs)
        ],
        "profiles": profiles,
    }
    with open(out_dir / "index.json", "w", encoding="utf-8") as f:
        json.dump(result, f, ensure_ascii=False, indent=1)
    flagged = [p["file_name"] for p in profiles if p["text_quality"] != "clean"]
    print(f"extracted {len(profiles)} resume(s) -> {out_dir}")
    for p in profiles:
        print(f"  {p['text_quality']:<20} {p['file_name']} (cjk={p['cjk_chars']})")
    if flagged:
        print(
            "low_text_or_garbled (needs OCR fallback, not extracted reliably): " + "; ".join(flagged),
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
