#!/usr/bin/env python3
"""校验概念验证报告的量化评分一致性。

用法（原样可执行）:
  python3 check_scores.py <报告.md> [--stale "32分,68分,32/100"] [--expect-total 70] [--out check.json]

检查项:
1. 评分表各行指标得分之和 == 总分行声明分数（历史上两次出现加总不一致：50 vs 63、67 vs 70）。
2. 指标满分列之和 == 总分满分（通常 100）。
3. --expect-total N：总分行分数等于用户要求的分数。
4. --stale：全文不得残留旧分数字符串（改分后常见残留，须清零）。

识别的表格形式: | 指标 | 得分 | 满分 | 说明 | 或 | 指标 | N/M | 说明 |；总分行第一列含"总分"，
分数取行内 "N/M" 模式，否则取前两个纯数字单元格（得分在前）。
退出码: 0 全部通过; 2 输入缺失; 3 有检查失败（明细同时打印与写 --out）。
"""
import argparse
import json
import os
import re
import sys

BOLD = re.compile(r"\*{1,2}")
RATIO = re.compile(r"(\d+)\s*/\s*(\d+)")
PURE_NUM = re.compile(r"^\*{0,2}(\d+(?:\.\d+)?)\*{0,2}$")


def clean(cell):
    return BOLD.sub("", cell).strip()


def parse_tables(text):
    tables, cur = [], []
    for lineno, raw in enumerate(text.splitlines(), 1):
        s = raw.strip()
        if s.startswith("|") and s.count("|") >= 2:
            cells = [c.strip() for c in s.strip("|").split("|")]
            if all(set(c) <= set("-: ") and "-" in c for c in cells):
                continue  # 分隔行
            cur.append((lineno, cells))
        elif cur:
            tables.append(cur)
            cur = []
    if cur:
        tables.append(cur)
    return tables


def extract_scores(text):
    indicators, totals = [], []
    for table in parse_tables(text):
        header = table[0][1] if table else []
        if not any("指标" in clean(c) or "维度" in clean(c) for c in header):
            continue
        named = {clean(c): i for i, c in enumerate(header)}
        for lineno, cells in table[1:]:
            name = clean(cells[0]) if cells else ""
            rownums = []
            for c in cells[1:]:
                m = RATIO.search(c)
                if m:
                    rownums = [(int(m.group(1)), int(m.group(2)))]
                    break
            if not rownums:
                nums = []
                if "得分" in named and named["得分"] < len(cells):
                    m = PURE_NUM.match(cells[named["得分"]])
                    if m:
                        nums.append(float(m.group(1)))
                if "满分" in named and named["满分"] < len(cells):
                    m = PURE_NUM.match(cells[named["满分"]])
                    if m:
                        nums.append(float(m.group(1)))
                if not nums:
                    for c in cells[1:]:
                        m = PURE_NUM.match(c)
                        if m:
                            nums.append(float(m.group(1)))
                        if len(nums) == 2:
                            break
                if nums:
                    rownums = [(nums[0], nums[1] if len(nums) > 1 else None)]
            if "总分" in name and rownums:
                totals.append({"line": lineno, "name": name, "score": rownums[0][0],
                               "max": rownums[0][1]})
            elif rownums and name:
                indicators.append({"line": lineno, "name": name, "score": rownums[0][0],
                                   "max": rownums[0][1]})
    return indicators, totals


def main(argv=None):
    ap = argparse.ArgumentParser(description="评分一致性校验")
    ap.add_argument("input", help="报告 .md 路径")
    ap.add_argument("--stale", default="", help="逗号分隔的旧分数字符串，须全文清零")
    ap.add_argument("--expect-total", type=float, default=None, help="用户要求的总分")
    ap.add_argument("--out", default=None, help="结果 JSON 输出路径")
    args = ap.parse_args(argv)
    if not os.path.isfile(args.input):
        print("check_scores error: 输入不存在: %s" % args.input, file=sys.stderr)
        return 2
    with open(args.input, encoding="utf-8") as f:
        text = f.read()

    problems = []
    result = {"input": args.input, "problems": problems}
    indicators, totals = extract_scores(text)
    result["indicators"] = indicators
    result["totals"] = totals
    if not indicators:
        problems.append("未在评分表中识别到指标行（表头需含'指标'/'维度'，行格式见脚本说明）")
    if not totals:
        problems.append("未识别到总分行（第一列需含'总分'）")
    else:
        total = totals[-1]
        if len(totals) > 1:
            problems.append("识别到 %d 个总分行，取最后一个（行 %d），请人工确认" % (len(totals), total["line"]))
        s = sum(i["score"] for i in indicators)
        result["indicator_sum"] = s
        result["total_score"] = total["score"]
        if abs(s - total["score"]) > 1e-9:
            problems.append("指标得分之和 %g ≠ 总分 %g（第 %d 行）" % (s, total["score"], total["line"]))
        ms = [i["max"] for i in indicators if i["max"] is not None]
        if ms and total["max"] is not None:
            sm = sum(ms)
            result["max_sum"] = sm
            if abs(sm - total["max"]) > 1e-9:
                problems.append("指标满分之和 %g ≠ 总分满分 %g（第 %d 行）" % (sm, total["max"], total["line"]))
        if args.expect_total is not None and abs(total["score"] - args.expect_total) > 1e-9:
            problems.append("总分 %g ≠ 用户要求 %g" % (total["score"], args.expect_total))

    stale_hits = {}
    for token in [t.strip() for t in args.stale.split(",") if t.strip()]:
        lines = [n for n, line in enumerate(text.splitlines(), 1) if token in line]
        if lines:
            stale_hits[token] = lines
    result["stale_hits"] = stale_hits
    if stale_hits:
        problems.append("残留旧分数字符串: %s" % json.dumps(stale_hits, ensure_ascii=False))

    if args.out:
        os.makedirs(os.path.dirname(os.path.abspath(args.out)) or ".", exist_ok=True)
        with open(args.out, "w", encoding="utf-8") as f:
            json.dump(result, f, ensure_ascii=False, indent=1)
    if problems:
        print(json.dumps(result, ensure_ascii=False, indent=1))
        print("check_scores: %d 项检查失败" % len(problems), file=sys.stderr)
        return 3
    print("check_scores: 通过（指标 %d 项，和=%g，总分=%g%s）"
          % (len(indicators), result.get("indicator_sum", -1), result.get("total_score", -1),
             "，无残留" if args.stale else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
