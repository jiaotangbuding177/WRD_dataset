#!/usr/bin/env python3
"""检查生成的 SOP docx 是否结构齐全、无遗留占位符。

用法:
  python3 check_sop_docx.py <交付.docx> --steps "步骤A,步骤B,..." [--modules "目标,操作要点,注意事项,常见问题"] [--out 报告.json]

行为:
- 提取 docx 全文文本（段落+表格）。
- 逐个核对 --steps 里的步骤名是否出现在正文中。
- 以每个步骤名为分界切片，检查切片内 --modules 的每个模块关键词是否出现。
- 检查遗留占位符：【、TODO、待补充（--allow-placeholders 跳过该检查）。
- --out 给出 JSON 报告（可选）。
- 退出码: 0 通过; 1 有问题; 2 用法/输入错误。
"""
import argparse
import json
import sys

PLACEHOLDERS = ["【", "TODO", "待补充"]


def extract_text(path):
    from docx import Document
    doc = Document(path)
    parts = [p.text for p in doc.paragraphs]
    for table in doc.tables:
        for row in table.rows:
            for cell in row.cells:
                parts.append(cell.text)
    return "\n".join(parts)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("docx")
    ap.add_argument("--steps", required=True, help="逗号分隔的步骤名，按顺序")
    ap.add_argument("--modules", default="目标,操作要点,注意事项,常见问题",
                    help="每步应包含的模块关键词，逗号分隔")
    ap.add_argument("--allow-placeholders", action="store_true")
    ap.add_argument("--out", help="JSON 报告输出路径")
    args = ap.parse_args()

    steps = [s.strip() for s in args.steps.split(",") if s.strip()]
    modules = [m.strip() for m in args.modules.split(",") if m.strip()]
    if not steps:
        print("--steps 不能为空", file=sys.stderr)
        sys.exit(2)

    try:
        text = extract_text(args.docx)
    except Exception as e:
        print(f"无法读取 docx: {e}", file=sys.stderr)
        sys.exit(2)

    problems = []

    # 步骤名定位（按出现顺序切分）
    positions = []
    for s in steps:
        idx = text.find(s, positions[-1][1] if positions else 0)
        if idx < 0:
            problems.append(f"步骤名未找到: {s}")
            positions.append((s, -1))
        else:
            positions.append((s, idx))

    found = [(s, i) for (s, i) in positions if i >= 0]
    for k, (s, i) in enumerate(found):
        end = found[k + 1][1] if k + 1 < len(found) else len(text)
        seg = text[i:end]
        for m in modules:
            if m not in seg:
                problems.append(f"步骤「{s}」缺少模块关键词「{m}」")

    if not args.allow_placeholders:
        for ph in PLACEHOLDERS:
            if ph in text:
                problems.append(f"发现遗留占位符「{ph}」")

    report = {
        "docx": args.docx,
        "chars": len(text),
        "steps": [s for s, _ in positions],
        "problems": problems,
        "pass": not problems,
    }
    if args.out:
        with open(args.out, "w", encoding="utf-8") as f:
            json.dump(report, f, ensure_ascii=False, indent=2)
    if problems:
        for p in problems:
            print("PROBLEM:", p)
        sys.exit(1)
    print(f"PASS: {len(steps)} 个步骤 × {len(modules)} 模块齐全，无遗留占位符（{len(text)} 字）")


if __name__ == "__main__":
    main()
