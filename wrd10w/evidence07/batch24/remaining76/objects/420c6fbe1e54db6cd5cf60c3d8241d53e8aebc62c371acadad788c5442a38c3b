"""Extract plain text from a .docx contract into a JSON file, with
keyword/window access for long documents.

Method: open the OOXML zip, read word/document.xml, join every <w:t> run per
<w:p> paragraph, unescape XML entities. Default mode writes {source_file,
paragraphs, text} JSON to --out. Long documents: use one or more --grep to
print only matching paragraph numbers plus bounded text windows (windows
capped by --max-windows, each paragraph line clipped; paragraphs whose text
text itself degenerated into OOXML fragments are hard-clipped and flagged),
one or more --lines START-END to re-read known windows, or both together in a
single invocation. Merged windows print once, in source (paragraph) order.
Only .docx is supported; scanned PDFs must be OCR'd first.
"""
import argparse
import json
import re
import sys
import zipfile
from pathlib import Path


def unescape(text):
    return (text.replace('&amp;', '&').replace('&lt;', '<').replace('&gt;', '>')
                .replace('&quot;', '"').replace('&apos;', "'"))


FRAGMENT_RE = re.compile(r'<w:|</w:|<\?xml')  # unescaped text that is itself OOXML debris
PRINT_CAP = 400      # per-paragraph clip in --grep windows
FRAGMENT_CAP = 160   # OOXML-fragment paragraphs are clipped much harder


def clip(text):
    """Return the printable, bounded form of one paragraph's text."""
    frag = bool(FRAGMENT_RE.search(text))
    cap = FRAGMENT_CAP if frag else PRINT_CAP
    if len(text) > cap:
        text = text[:cap] + '…[截断,共%d字]' % len(text)
    if frag:
        text += '[ooxml碎片:仅作锚点定位,不作正文依据]'
    return text


def parse_lines(spec):
    """Parse 'START-END' -> (start, end); raise ValueError on bad form."""
    match = re.fullmatch(r'(\d+)-(\d+)', spec.strip())
    if not match:
        raise ValueError('--lines expects START-END like 120-140')
    start, end = int(match.group(1)), int(match.group(2))
    if start < 1 or end < start:
        raise ValueError('--lines range invalid: ' + spec)
    return start, end


def merge_windows(ranges):
    """Merge overlapping/adjacent [start, end) ranges, keep source order."""
    merged = []
    for start, end in sorted(ranges):
        if merged and start <= merged[-1][1] + 1:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('input')
    parser.add_argument('--out', help='full extraction JSON; omit when using --grep/--lines')
    parser.add_argument('--grep', action='append', default=[], metavar='KEYWORD',
                        help='locate keyword: print matching paragraph numbers + bounded text windows; repeat to search several keywords in one call')
    parser.add_argument('--context', type=int, default=0, help='extra paragraphs around each --grep match (default 0)')
    parser.add_argument('--max-windows', type=int, default=8, help='cap on printed windows across all keywords (default 8)')
    parser.add_argument('--lines', action='append', default=[], metavar='START-END',
                        help='print only a paragraph range like 120-140 (1-based, inclusive); repeatable')
    args = parser.parse_args()
    src = Path(args.input)
    try:
        if not src.is_file():
            raise ValueError('input not found: ' + str(src))
        if src.suffix.lower() != '.docx':
            raise ValueError('unsupported input type ' + src.suffix + ': expected .docx (convert or OCR other formats first)')
        with zipfile.ZipFile(src) as archive:
            xml = archive.read('word/document.xml').decode('utf-8')
    except (OSError, ValueError, KeyError, zipfile.BadZipFile, UnicodeError) as error:
        print('extract_contract_text error: ' + str(error), file=sys.stderr)
        return 2
    paragraphs = []
    # self-closing <w:p/> (empty paragraphs) must be counted too, or paragraph
    # numbers drift against locate_gaps/fill_cell body indices
    for match in re.findall(r'<w:p/>|<w:p[ >].*?</w:p>', xml, re.S):
        text = unescape(''.join(re.findall(r'<w:t[^>]*>(.*?)</w:t>', match, re.S)))
        paragraphs.append(text)
    while paragraphs and not paragraphs[-1]:
        paragraphs.pop()
    total = len(paragraphs)

    try:
        line_ranges = [parse_lines(spec) for spec in args.lines]
    except ValueError as error:
        print('extract_contract_text error: ' + str(error), file=sys.stderr)
        return 2

    def print_window(start, end):
        for i in range(max(0, start - 1), min(total, end)):
            print('p' + str(i + 1) + ': ' + clip(paragraphs[i]))

    if args.grep or args.lines:
        width = max(0, args.context)
        keyword_hits = []
        grep_ranges = []
        no_match = []
        for keyword in args.grep:
            hits = [i + 1 for i, text in enumerate(paragraphs) if keyword in text]
            keyword_hits.append((keyword, hits))
            if not hits:
                no_match.append(keyword)
            for hit in hits:
                grep_ranges.append((max(1, hit - width), hit + width))
        print('total ' + str(total) + ' paragraphs')
        for keyword, hits in keyword_hits:
            shown_hits = ', '.join(str(h) for h in hits[:50]) + ('…' if len(hits) > 50 else '')
            print('grep [' + keyword + '] hit ' + str(len(hits)) + ': ' + (shown_hits if hits else '无'))
        windows = merge_windows(line_ranges + grep_ranges)
        shown = windows[:max(1, args.max_windows)]
        for start, end in shown:
            print('--- window p' + str(start) + '-p' + str(end) + ' ---')
            print_window(start, end)
        if len(windows) > len(shown):
            print('…[剩余 %d 个窗口未打印; 收窄 --grep 关键词、减小 --context、增并 --lines 或调大 --max-windows]'
                  % (len(windows) - len(shown)))
        return 1 if no_match and not shown else 0
    if not args.out:
        print('extract_contract_text error: --out required without --grep/--lines', file=sys.stderr)
        return 2
    fragments = [i + 1 for i, text in enumerate(paragraphs) if FRAGMENT_RE.search(text)]
    result = {'source_file': src.name, 'paragraphs': total,
              'ooxml_fragment_paragraphs': fragments,
              'text': '\n'.join(paragraphs)}
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
    print('extracted ' + str(total) + ' paragraphs -> ' + args.out)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
