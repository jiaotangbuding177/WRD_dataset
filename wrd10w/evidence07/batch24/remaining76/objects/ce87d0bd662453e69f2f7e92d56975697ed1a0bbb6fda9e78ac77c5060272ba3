    (\"table\", (\"表格\", \"对比\")),\n    (\"timeline\", (\"里程碑\", \"时间线\", \"历史\", \"探索\")),\n    (\"quiz\", (\"测验\", \"选择题\")),\n]\nSECTION_TITLES = {\n    \"demo\": \"互动演示\",\n    \"cards\": \"知识卡片\",\n    \"table\": \"数据对比\",\n    \"timeline\": \"探索里程碑\",\n    \"quiz\": \"课堂小测验\",\n}\n\n\nclass SpecError(Exception):\n    pass\n\n\ndef text_leaves(value):\n    if isinstance(value, str):\n        yield value\n    elif isinstance(value, list):\n        for item in value:\n            yield from text_leaves(item)\n    elif isinstance(value, dict):\n        for item in value.values():\n            yield from text_leaves(item)\n\n\ndef clean_request(text):\n    cleaned = POLITE_PREFIX.sub(\"\", text.strip())\n    cleaned = REQUEST_VERB.sub(\"\", cleaned, count=1)\n    cleaned = HTML_TOKEN.sub(\"\", cleaned)\n    return cleaned.strip(STRIP_CHARS)\n\n\ndef extract_topic(cleaned):\n    match = SUBJECT_PATTERN.search(cleaned)\n    if match:\n        return match.group(0)\n    return cleaned\n\n\ndef detect(text, rules, seen):\n    found = []\n    for key, words in rules:\n        if key in seen:\n            continue\n        if any(word in text for word in words):\n            seen.add(key)\n            found.append(key)\n    return found\n\n\ndef build_spec(record):\n    if not isinstance(record, dict):\n        raise SpecError(\"conversation must be a JSON object\")\n    messages = record.get(\"messages\")\n    if not isinstance(messages, list):\n        raise SpecError(\"conversation must have a messages list\")\n    session_id = record.get(\"session_id\", record.get(\"source_id\"))\n    if not isinstance(session_id, str) or not session_id:\n        raise SpecError(\"conversation needs a string session_id\")\n    texts = []\n    for message in messages:\n        if not isinstance(message, dict) or not isinstance(message.get(\"id\"), str) or not message[\"id\"]:\n            raise SpecError(\"every message needs a non-empty string id\")\n        body = \"\".join(text_leaves(message.get(\"content\", \"\")))\n        texts.append((message[\"id\"], body))\n    request = next(\n        ((mid, body) for mid, body in texts if REQUEST_PATTERN.search(body)),\n        texts[0] if texts else (\"\", \"\"),\n    )\n    request_id, request_text = request\n    topic = extract_topic(clean_request(request_text))\n    corpus = \"\\n\".join(body for _, body in texts)\n    interactions = detect(corpus, INTERACTION_RULES, set())\n    sections = [\n        {\"kind\": kind, \"title\": SECTION_TITLES[kind]}\n        for kind in detect(corpus, SECTION_RULES, set())\n    ]\n    return {\n        \"topic\": topic,\n        \"request_text\": request_text,\n        \"source_id\": session_id,\n        \"source_message_id\": request_id,\n        \"interactions\": interactions,\n        \"sections\": sections,\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Extract a teaching-page spec from a conversation JSON.\")\n    parser.add_argument(\"source\", help=\"conversation JSON file to read\")\n    parser.add_argument(\"--out\", required=True, help=\"path of the page-spec JSON to write\")\n    args = parser.parse_args()\n    try:\n        try:\n            raw = open(args.source, \"rb\").read()\n        except OSError as error:\n            raise SpecError(f\"cannot read source file: {error}\")\n        try:\n            record = json.loads(raw.decode(\"utf-8-sig\"))\n        except (UnicodeError, json.JSONDecodeError) as error:\n            raise SpecError(f\"invalid JSON in conversation file: {error}\")\n        spec = build_spec(record)\n        payload = json.dumps(spec, ensure_ascii=False, indent=2, sort_keys=True) + \"\\n\"\n        try:\n            with open(args.out, \"w\", encoding=\"utf-8\") as handle:\n                handle.write(payload)\n        except OSError as error:\n            raise SpecError(f\"cannot write output file: {error}\")\n    except SpecError as error:\n        print(f\"extract_topic_spec_error: {error}\",