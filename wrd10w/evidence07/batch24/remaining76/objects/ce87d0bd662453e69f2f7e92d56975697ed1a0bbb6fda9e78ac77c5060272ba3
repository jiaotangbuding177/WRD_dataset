splay:flex;align-items:center;justify-content:center;color:var(--muted);margin:14px 0;text-align:center;padding:0 16px}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}\n.card{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:14px}\n.card h3{color:var(--accent);font-size:16px;margin-bottom:6px}\n.card p{color:var(--muted);font-size:14px}\n.card p.facts{color:var(--warn);font-size:13px;margin-top:6px}\ntable{width:100%;border-collapse:collapse;font-size:14px}\nth,td{border:1px solid var(--line);padding:8px 10px;text-align:left}\nth{background:var(--bg);color:var(--accent)}\n.timeline{list-style:none}\n.timeline li{border-left:2px solid var(--accent);padding:6px 0 6px 16px;position:relative}\n.timeline li::before{content:\"\";position:absolute;left:-6px;top:14px;width:10px;height:10px;border-radius:50%;background:var(--accent)}\n.quiz .question{margin-top:14px}\n.quiz .question>p{margin-bottom:6px}\n.quiz .options{display:flex;flex-wrap:wrap;gap:8px}\n.quiz button{background:var(--bg);border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:6px 14px;cursor:pointer}\n.quiz button.correct{border-color:#39d98a;color:#39d98a}\n.quiz button.wrong{border-color:var(--warn);color:var(--warn)}\n.quiz .verdict{margin-top:8px;color:var(--muted);font-size:14px}\nfooter{text-align:center;color:var(--muted);font-size:13px;padding:24px}\n@media (max-width:640px){header h1{font-size:22px}}\n</style>\n</head>\n<body>\n<nav id=\"top-nav\">{{NAV_ITEMS}}</nav>\n<header><h1>{{TITLE}}</h1><p>{{SUBTITLE}}</p></header>\n<main>\n{{SECTIONS}}\n</main>\n<footer>{{TITLE}} · 教学演示页 · 直接用浏览器打开本文件即可演示</footer>\n<script>\ndocument.querySelectorAll('.quiz .options').forEach(function(group){\n  if(group.dataset.bound==='1'){return}\n  group.dataset.bound='1';\n  group.addEventListener('click',function(event){\n    var btn=event.target.closest('button');\n    if(!btn||group.dataset.done==='1'){return}\n    group.dataset.done