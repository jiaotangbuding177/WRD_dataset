def pin(p):
    raw = Path(p).read_bytes()
    return {'path': str(Path(p).absolute()), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}

def fix(name, purpose, derivation):
    return {'path': name, 'pin': pin(REP/name), 'source_id': 'conv_b8618dade74b',
            'message_ids': [MSG_B], 'origin': 'generated_fixture', 'generated': True,
            'purpose': purpose, 'derivation': derivation}

