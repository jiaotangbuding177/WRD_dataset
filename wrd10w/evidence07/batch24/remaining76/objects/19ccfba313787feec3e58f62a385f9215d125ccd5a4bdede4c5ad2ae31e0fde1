ext.encode('utf-8')\n                entries.append({'source_id': sid, 'message_id': mid, 'leaf_path': pointer,\n                                'text': text, 'data': data, 'leaf_sha256': hashlib.sha256(data).hexdigest()})\n    return ids, entries\n\n\ndef encoded(payload):\n    return (json.dumps(payload, ensure_ascii=False, separators=(',', ':'), allow_nan=False) + '\\n').encode('utf-8')\n\n\ndef make_batch(paths, cursor=None, max_bytes=6500):\n    if type(max_bytes) is not int or not 2048 <= max_bytes <= 6500:\n        raise ValueError('Use a total native tool output budget between 2048 and 6500 UTF8 bytes')\n    ids, entries = source_entries(paths)\n    cursor = '0:0' if cursor is None else cursor\n    if not isinstance(cursor, str) or not re.fullmatch(r'[0-9]+:[0-9]+', cursor):\n        raise ValueError('Cursor must be the exact previous next_cursor leafIndex:byteOffset')\n    index, offset = map(int, cursor.split(':'))\n    if index > len(entries) or (index == len(entries) and offset):\n        raise ValueError('Cursor outside source leaves')\n    chunks = []\n\n    def frame(next_index, next_offset):\n        done = next_index == len(entries)\n        return {'schema': SCHEMA, 'source_ids': ids, 'cursor_in': cursor, 'chunks': chunks,\n                'next_cursor': None if done else f'{next_index}:{next_offset}', 'complete': done,\n                'file_read_is_not_model_receipt': True}\n\n    while index < len(entries):\n        entry = entries[index]\n        if offset > len(entry['data']):\n            raise ValueError('Cursor outside original UTF8 leaf')\n        # Reject a fabricated cursor in the middle of a UTF8 code point.\n        entry['data'][:offset].decode('utf-8')\n        remaining = entry['data'][offset:].decode('utf-8')\n        if not remaining:\n            index += 1\n            offset = 0\n            continue\n\n        def candidate(count):\n            text = remaining[:count]\n            raw = text.encode('utf-8')\n            end =