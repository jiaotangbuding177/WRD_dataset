#!/usr/bin/env python3
"""用户反馈分析与研发工作项关联管线（openpyxl，无状态子命令）。

用法（原样可执行，全部参数按当前任务实际文件传入）:
  python3 feedback_xlsx.py profile <反馈表.xlsx>
  python3 feedback_xlsx.py dump   <反馈表.xlsx> [--sheet <表名>] --out rows.json
  python3 feedback_xlsx.py annotate <反馈表.xlsx> --ann <标注.json> --out <反馈分析.xlsx>
                                    [--sheet <表名>] [--text-col 反馈内容]
  python3 feedback_xlsx.py match  <反馈表.xlsx> <工作项表.xlsx> --kw <关键词.json>
                                    --out coverage.json [--sheet <反馈表名>]
                                    [--dim-col 问题类型] [--title-col 标题]
  python3 feedback_xlsx.py trace  <反馈表.xlsx> --ann <标注.json> --out trace.md
                                    [--sheet <表名>] [--text-col 反馈内容]
                                    [--id-col 问卷编号] [--date-col 填写日期]
                                    [--account-col 账号] [--cat-col 问题细化类型]
                                    [--max-quote 100]

子命令:
  profile   快速摸底：各表行数/列名/每列类型、缺失数、取值分布Top、日期范围。
  dump      导出行为 JSON（含稳定 _row=Excel 行号），供逐条标注。
  annotate  合并标注生成增强版反馈分析xlsx：统计概览表 + 反馈分析表，
            原始列全部保留，按优先级着色，冻结标题+自动筛选。
            标注JSON格式: {"<_row>": {"细化类型":..,"根因":..,"建议":..,"优先级":..}}
            （键为 dump 输出的 _row 字符串；四个键可任选，列名固定。）
  match     按关键词把反馈维度匹配到工作项，输出覆盖度JSON：
            每维度反馈数/匹配到的工作项标题/覆盖度/未覆盖反馈的 _row 列表。
            关键词JSON格式: {"<维度名>": ["关键词", ...]}
  trace     按细化类型输出可追溯清单md：`#问卷编号` `填写日期` `账号` → 用户原话，
            末尾附多次反馈用户清单（反馈>=2次）。

退出码：0 成功；2 用法/输入错误（stderr 说明）。
"""
import argparse
import datetime as dt
import json
import sys
from collections import Counter
from pathlib import Path

from openpyxl import Workbook, load_workbook
from openpyxl.styles import Alignment, Font, PatternFill
from openpyxl.utils import get_column_letter

NEW_COLS = ["问题细化类型", "根因分析", "改进建议", "优先级"]
PRIORITY_FILL = {
    "P0": PatternFill("solid", fgColor="FFC7CE"),
    "P1": PatternFill("solid", fgColor="FFEB9C"),
    "P2": PatternFill("solid", fgColor="C6EFCE"),
}
HEADER_FILL = PatternFill("solid", fgColor="D9E2F3")
WRAP = Alignment(wrap_text=True, vertical="top")


def _fail(msg):
    sys.stderr.write("2: %s\n" % msg)
    raise SystemExit(2)


def _load(path, sheet=None):
    try:
        wb = load_workbook(path, data_only=True)
    except Exception as e:
        _fail("无法打开 %s: %s" % (path, e))
    name = sheet
    if name is None:
        # 取数据行最多的表，避免误选说明页
        best, best_n = wb.sheetnames[0], -1
        for n in wb.sheetnames:
            nrow = wb[n].max_row or 0
            if nrow > best_n:
                best, best_n = n, nrow
        name = best
    if name not in wb.sheetnames:
        _fail("%s 无工作表 %s（现有: %s）" % (path, name, ",".join(wb.sheetnames)))
    ws = wb[name]
    rows = list(ws.iter_rows(values_only=True))
    while rows and all(c is None for c in rows[-1]):
        rows.pop()
    if len(rows) < 2:
        _fail("%s!%s 数据不足（需表头+至少1行）" % (path, name))
    header = [str(c).strip() if c is not None else "列%d" % (i + 1)
              for i, c in enumerate(rows[0])]
    data = [dict(zip(header, r)) for r in rows[1:]]
    return header, data, name


def _cellstr(v):
    if v is None:
        return ""
    if isinstance(v, (dt.datetime, dt.date)):
        return v.strftime("%Y-%m-%d") if not getattr(v, "hour", 0) else v.strftime("%Y-%m-%d %H:%M")
    return str(v).strip()


def cmd_profile(args):
    header, data, name = _load(args.xlsx, args.sheet)
    cols = []
    for h in header:
        vals = [_cellstr(d.get(h)) for d in data]
        nonempty = [v for v in vals if v]
        is_date = all(_is_date(v) for v in nonempty[:50]) and nonempty
        col = {"name": h, "missing": len(vals) - len(nonempty)}
        if is_date:
            col["type"] = "date"
            col["range"] = [min(nonempty), max(nonempty)]
        else:
            col["type"] = "text"
            dist = Counter(nonempty)
            if len(dist) <= max(20, len(data) // 5):
                col["top_values"] = [[v, n] for v, n in dist.most_common(15)]
            else:
                col["distinct"] = len(dist)
        cols.append(col)
    print(json.dumps({"sheet": name, "rows": len(data), "columns": cols},
                     ensure_ascii=False, indent=1))


def _is_date(v):
    if not v:
        return False
    try:
        dt.datetime.strptime(v[:10], "%Y-%m-%d")
        return True
    except ValueError:
        return False


def cmd_dump(args):
    header, data, name = _load(args.xlsx, args.sheet)
    out = [{"_row": str(i + 2), **{h: _cellstr(d.get(h)) for h in header}}
           for i, d in enumerate(data)]
    Path(args.out).write_text(json.dumps(
        {"source": str(args.xlsx), "sheet": name, "rows": out},
        ensure_ascii=False, indent=1), encoding="utf-8")
    print("dumped %d rows -> %s" % (len(out), args.out))


def cmd_annotate(args):
    header, data, name = _load(args.xlsx, args.sheet)
    try:
        ann = json.loads(Path(args.ann).read_text(encoding="utf-8"))
    except Exception as e:
        _fail("标注文件读取失败 %s: %s" % (args.ann, e))
    if not isinstance(ann, dict):
        _fail("标注JSON须为对象 {\"_row\": {...}}")
    unknown = [k for k in ann if k not in {str(i + 2) for i in range(len(data))}]
    if unknown:
        _fail("标注含未知行号(应为Excel行号字符串): %s" % ",".join(unknown[:10]))
    wb = Workbook()
    # 统计概览
    ws = wb.active
    ws.title = "统计概览"
    ws.column_dimensions["A"].width = 20
    ws.column_dimensions["B"].width = 12
    ws.column_dimensions["C"].width = 60
    n = len(data)
    rows = [("%s 反馈统计概览" % Path(args.xlsx).stem, ""), ("反馈总数", n, "")]
    for c in NEW_COLS:
        vals = [_ann_of(ann, str(i + 2)).get(_short(c)) for i in range(n)]
        dist = Counter(v for v in vals if v)
        total_filled = sum(dist.values())
        rows.append((c, total_filled,
                     "；".join("%s %d条" % (k, v) for k, v in dist.most_common()) or "未标注"))
    for i, row in enumerate(rows, start=1):
        a = row[0]
        b = row[1] if len(row) > 1 else ""
        c = row[2] if len(row) > 2 else ""
        ws["A%d" % i] = a
        ws["A%d" % i].font = Font(bold=True)
        ws["B%d" % i] = b
        ws["C%d" % i] = c
        ws["C%d" % i].alignment = WRAP
    ws["A1"].font = Font(bold=True, size=14)
    # 反馈分析
    ws = wb.create_sheet("反馈分析")
    full_header = list(header) + NEW_COLS
    for j, h in enumerate(full_header, start=1):
        c = ws.cell(row=1, column=j, value=h)
        c.fill = HEADER_FILL
        c.font = Font(bold=True)
        c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    for i, d in enumerate(data):
        r = i + 2
        a = _ann_of(ann, str(r))
        vals = [_cellstr(d.get(h)) for h in header] + [
            a.get("细化类型", ""), a.get("根因", ""), a.get("建议", ""), a.get("优先级", "")]
        for j, v in enumerate(vals, start=1):
            c = ws.cell(row=r, column=j, value=v)
            c.alignment = WRAP
        p = a.get("优先级", "")
        if p in PRIORITY_FILL:
            for j in range(1, len(full_header) + 1):
                ws.cell(row=r, column=j).fill = PRIORITY_FILL[p]
    widths = {"反馈内容": 50, "问题描述": 50}
    for j, h in enumerate(full_header, start=1):
        ws.column_dimensions[get_column_letter(j)].width = widths.get(h, 14)
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = "A1:%s%d" % (get_column_letter(len(full_header)), len(data) + 1)
    out = Path(args.out)
    if out.exists() and not args.force:
        _fail("输出已存在: %s（覆盖请加 --force）" % out)
    out.parent.mkdir(parents=True, exist_ok=True)
    wb.save(out)
    print("annotated %d rows (%d annotated) -> %s"
          % (len(data), sum(1 for i in range(len(data)) if _ann_of(ann, str(i + 2))), out))


def _short(col):
    return {"问题细化类型": "细化类型"}.get(col, col.replace("分析", "").replace("改进", "")) \
        if col in ("问题细化类型", "根因分析", "改进建议") else col


def _ann_of(ann, row):
    a = ann.get(row) or {}
    return {"细化类型": a.get("细化类型", ""), "根因": a.get("根因", ""),
            "建议": a.get("建议", ""), "优先级": a.get("优先级", "")}


def cmd_match(args):
    _, fb, _ = _load(args.xlsx, args.sheet)
    _, wi, wi_name = _load(args.workitems)
    try:
        kw = json.loads(Path(args.kw).read_text(encoding="utf-8"))
    except Exception as e:
        _fail("关键词文件读取失败 %s: %s" % (args.kw, e))
    if not isinstance(kw, dict) or not kw:
        _fail("关键词JSON须为非空对象 {\"维度\": [关键词...]}")
    wi_text = []
    for d in wi:
        title = _cellstr(d.get(args.title_col))
        body = " ".join(_cellstr(v) for v in d.values())
        wi_text.append({"title": title or body[:30], "body": body})

    if args.dim_col not in fb[0]:
        sys.stderr.write("提示: 反馈表无维度列 %r，改用关键词全文匹配定位维度\n" % args.dim_col)
        args.dim_col = None

    def fulltext(d):
        return " ".join(_cellstr(v) for v in d.values())

    coverage = []
    matched_rows = set()
    for dim, words in kw.items():
        terms = [dim] + [w for w in words if w]
        # 定位维度：按维度列取值匹配
        rows_in_dim = []
        for i, d in enumerate(fb):
            hay = _cellstr(d.get(args.dim_col)) if args.dim_col else fulltext(d)
            if any(t in hay for t in terms):
                rows_in_dim.append((i, d))
        hits, uncovered = [], []
        for i, d in rows_in_dim:
            hit = [w["title"] for w in wi_text if any(t in w["body"] for t in terms)]
            if hit:
                matched_rows.add(id(d))
                hits.extend(hit)
            else:
                uncovered.append(str(i + 2))
        n = len(rows_in_dim)
        coverage.append({
            "维度": dim, "反馈数": n,
            "匹配工作项": sorted(set(hits)),
            "覆盖度": round((n - len(uncovered)) / n, 2) if n else 0.0,
            "未覆盖_row": uncovered,
        })
    res = {"feedback_sheet": args.sheet or "(auto)", "workitem_sheet": wi_name,
           "工作项总数": len(wi), "matched_feedback": len(matched_rows),
           "coverage": coverage}
    Path(args.out).write_text(json.dumps(res, ensure_ascii=False, indent=1), encoding="utf-8")
    print("matched -> %s (dimensions=%d)" % (args.out, len(coverage)))


def cmd_trace(args):
    header, data, name = _load(args.xlsx, args.sheet)
    try:
        ann = json.loads(Path(args.ann).read_text(encoding="utf-8"))
    except Exception as e:
        _fail("标注文件读取失败 %s: %s" % (args.ann, e))
    for opt, col in [("id_col", args.id_col), ("date_col", args.date_col),
                     ("account_col", args.account_col), ("text_col", args.text_col)]:
        if col not in header:
            _fail("列 %r 不存在，现有列: %s（用 --%s 指定）"
                  % (col, ",".join(header), opt.replace("_", "-")))
    if args.cat_col not in header:
        args.cat_col = None  # 分类一律以标注为准时可不传该列
    groups = {}
    user_count = Counter()
    for i, d in enumerate(data):
        a = _ann_of(ann, str(i + 2))
        cat = a.get("细化类型") or (_cellstr(d.get(args.cat_col)) if args.cat_col else "") or "未分类"
        quote = _cellstr(d.get(args.text_col))[:args.max_quote]
        line = "`#%s` `%s` `%s` → %s" % (
            _cellstr(d.get(args.id_col)) or "?", _cellstr(d.get(args.date_col)) or "?",
            _cellstr(d.get(args.account_col)) or "?", quote or "(空)")
        groups.setdefault(cat, []).append(line)
        acct = _cellstr(d.get(args.account_col))
        if acct:
            user_count[acct] += 1
    lines = ["# 反馈可追溯清单", "", "来源: %s（%s），共 %d 条" % (args.xlsx, name, len(data)), ""]
    for cat in sorted(groups, key=lambda c: -len(groups[c])):
        lines += ["## %s（%d条）" % (cat, len(groups[cat])), ""] + groups[cat] + [""]
    repeat = [(u, c) for u, c in user_count.most_common() if c >= 2]
    if repeat:
        lines += ["## 多次反馈用户（≥2次，%d人）" % len(repeat), "",
                  "| 账号 | 反馈次数 |", "|---|---|"]
        lines += ["| %s | %d |" % (u, c) for u, c in repeat]
    Path(args.out).write_text("\n".join(lines) + "\n", encoding="utf-8")
    print("trace %d categories -> %s" % (len(groups), args.out))


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("profile")
    p.add_argument("xlsx")
    p.add_argument("--sheet")
    p.set_defaults(fn=cmd_profile)

    p = sub.add_parser("dump")
    p.add_argument("xlsx")
    p.add_argument("--sheet")
    p.add_argument("--out", required=True)
    p.set_defaults(fn=cmd_dump)

    p = sub.add_parser("annotate")
    p.add_argument("xlsx")
    p.add_argument("--ann", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--sheet")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_annotate)

    p = sub.add_parser("match")
    p.add_argument("xlsx")
    p.add_argument("workitems")
    p.add_argument("--kw", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--sheet")
    p.add_argument("--dim-col", default="问题类型")
    p.add_argument("--title-col", default="标题")
    p.set_defaults(fn=cmd_match)

    p = sub.add_parser("trace")
    p.add_argument("xlsx")
    p.add_argument("--ann", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--sheet")
    p.add_argument("--text-col", default="反馈内容")
    p.add_argument("--id-col", default="问卷编号")
    p.add_argument("--date-col", default="填写日期")
    p.add_argument("--account-col", default="账号")
    p.add_argument("--cat-col", default="问题细化类型")
    p.add_argument("--max-quote", type=int, default=100)
    p.set_defaults(fn=cmd_trace)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
