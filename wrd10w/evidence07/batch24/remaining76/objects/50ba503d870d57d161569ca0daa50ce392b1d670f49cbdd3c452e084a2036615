<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{TITLE}}</title>
<style>
:root{--ink:#1f2937;--muted:#6b7280;--accent:#2563eb;--line:#e5e7eb;--bg:#f3f4f6;--warn:#dc2626;--ok:#059669}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Noto Sans SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--ink);line-height:1.65}
header.page-head{max-width:860px;margin:28px auto 0;padding:0 16px}
header.page-head h1{font-size:26px}
.intro{color:var(--muted);margin-top:8px;white-space:pre-wrap}
main{max-width:860px;margin:0 auto;padding:8px 16px 60px}
section.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;margin-top:18px}
section.card h2{font-size:17px;margin-bottom:10px}
.hint{color:var(--muted);font-size:13px;margin-bottom:10px}
.frow{margin:10px 0}
.frow label{display:block;font-size:14px;margin-bottom:4px}
input[type=text]{width:100%;max-width:420px;border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:14px}
.q .opts{display:flex;flex-direction:column;gap:6px}
.q label.opt{display:flex;align-items:flex-start;gap:8px;border:1px solid var(--line);border-radius:8px;padding:8px 12px;cursor:pointer;font-size:14px}
.q label.opt:hover{border-color:var(--accent)}
.q input{margin-top:4px}
.error{color:var(--warn);font-size:14px;margin-top:12px;min-height:20px}
.ok{color:var(--ok);font-size:14px}
.actions{margin:16px 0}
button{border:none;border-radius:8px;padding:10px 20px;font-size:14px;cursor:pointer}
button.primary{background:var(--accent);color:#fff}
button.ghost{background:#fff;border:1px solid var(--line);color:var(--ink);padding:6px 14px}
button.danger{background:#fee2e2;color:var(--warn);padding:4px 10px;font-size:12px}
.admin-entry{margin-top:20px;text-align:center}
#secAdmin .row{margin:10px 0}
#recordList details{border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin:8px 0}
#recordList summary{cursor:pointer;font-size:13px}
#recordList pre{background:var(--bg);border-radius:8px;padding:8px;font-size:12px;white-space:pre-wrap;margin-top:8px}
footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
@media print{
 body{background:#fff}
 #btnPrint,#btnSubmit,.admin-entry,#secAdmin,.actions button,#btnReceipt{display:none!important}
 section.card{border:none;break-inside:avoid}
}
</style>
</head>
<body>
<header class="page-head">
  <h1 id="qTitle">{{TITLE}}</h1>
  <div class="intro" id="qIntro">{{INTRO}}</div>
  <div style="margin-top:10px"><button id="btnPrint" class="ghost" onclick="window.print()">打印问卷</button></div>
</header>
<main>
  <form id="qForm" onsubmit="return false;">
    <section class="card" id="secSubmitter">
      <h2>提交人信息</h2>
      <p class="hint" id="submitterNote"></p>
      <div id="submitterFields"></div>
    </section>
    <div id="questions"></div>
    <div class="error" id="formError"></div>
    <div class="actions">
      <button id="btnSubmit" class="primary" type="button">提交问卷</button>
      <button id="btnReceipt" class="ghost" type="button" style="display:none">下载我的答卷回执</button>
      <span id="submitResult" class="ok"></span>
    </div>
  </form>
  <div class="admin-entry"><button id="btnAdmin" class="ghost" type="button">🔒 提交记录管理</button></div>
  <section class="card" id="secAdmin" hidden>
    <h2>提交记录管理</h2>
    <div class="row">
      <input type="password" id="adminPass" placeholder="管理密码" style="max-width:200px">
      <button id="btnUnlock" class="ghost" type="button">解锁</button>
      <span class="error" id="adminMsg"></span>
    </div>
    <div id="adminBody" hidden>
      <div class="row" id="adminCount"></div>
      <div id="recordList"></div>
      <div class="row">
        <button id="btnCSV" class="ghost" type="button">导出 CSV（Excel 可开）</button>
        <button id="btnJSON" class="ghost" type="button">导出 JSON 备份</button>
        <label class="ghost" style="display:inline-block;border:1px solid var(--line);border-radius:8px;padding:8px 14px;cursor:pointer">导入回执
          <input type="file" id="receiptFile" accept=".json,application/json" style="display:none">
        </label>
        <span class="ok" id="importMsg"></span>
      </div>
    </div>
  </section>
</main>
<footer>本问卷为本地 HTML 文件，提交记录保存在填写设备的浏览器中；分布式收集时请让受访者提交后下载答卷回执并发回。</footer>
<script>
/* ============================================================
   CFG：问卷标题/说明/管理密码/实名字段/全部题目都在下面的 JSON 里，
   直接改这份 JSON 并刷新页面即可生效，不需要改其他代码。
   ============================================================ */
/* QDATA-BEGIN */
const QDATA = {{QDATA_JSON}};
/* QDATA-END */

(function(){
'use strict';
var $=function(s){return document.querySelector(s)};
var storeKey='qform:'+(QDATA.cfg&&QDATA.cfg.storage_key?QDATA.cfg.storage_key:QDATA.title);
function loadRecords(){try{return JSON.parse(localStorage.getItem(storeKey))||[]}catch(e){return[]}}
function saveRecords(r){localStorage.setItem(storeKey,JSON.stringify(r))}
var records=loadRecords();
function pad2(n){return String(n).length<2?'0'+n:String(n)}
function nowStr(){var d=new Date();return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate())+' '+pad2(d.getHours())+':'+pad2(d.getMinutes())+':'+pad2(d.getSeconds())}
function randId(){var A='ABCDEFGHJKMNPQRSTUVWXYZ23456789',s='';for(var i=0;i<4;i++){s+=A[Math.floor(Math.random()*A.length)]}var d=new Date();return 'SUB-'+d.getFullYear()+pad2(d.getMonth()+1)+pad2(d.getDate())+'-'+s}

document.title=QDATA.title;
$('#qTitle').textContent=QDATA.title;
$('#qIntro').textContent=QDATA.intro||'';

/* 提交人信息 */
var sfWrap=$('#submitterFields');
(QDATA.submitter_fields||[]).forEach(function(f,i){
  var row=document.createElement('div');row.className='frow';
  var lab=document.createElement('label');lab.textContent=f.label+(f.required?' *':'（选填）');lab.htmlFor='sf_'+i;
  var inp=document.createElement('input');inp.type='text';inp.id='sf_'+i;
  row.appendChild(lab);row.appendChild(inp);sfWrap.appendChild(row);
});
$('#submitterNote').textContent=(QDATA.cfg&&QDATA.cfg.submitter_note)||'本问卷会记录提交人信息，请如实填写。';

/* 题目 */
var qWrap=$('#questions');
(QDATA.questions||[]).forEach(function(q,qi){
  var sec=document.createElement('section');sec.className='card q q-'+q.type;sec.id='q'+(qi+1);
  var h=document.createElement('h2');
  var extra=q.type==='checkbox'?'【多选'+(q.max?'，最多 '+q.max+' 项':'')+'】':'';
  h.textContent=(qi+1)+'、'+q.title+(q.required?' *':'')+extra;
  sec.appendChild(h);
  if(q.type==='text'){
    var inp=document.createElement('input');inp.type='text';inp.className='qtext';inp.placeholder=q.placeholder||'';
    sec.appendChild(inp);
  }else{
    var box=document.createElement('div');box.className='opts';
    (q.options||[]).forEach(function(op){
      var o=document.createElement('label');o.className='opt';
      var inp=document.createElement('input');inp.type=(q.type==='radio')?'radio':'checkbox';inp.name='q'+(qi+1);inp.value=op;
      var sp=document.createElement('span');sp.textContent=op;
      o.appendChild(inp);o.appendChild(sp);box.appendChild(o);
      if(q.type==='checkbox'&&q.max){
        inp.addEventListener('change',function(){
          var c=box.querySelectorAll('input:checked');
          if(c.length>q.max){inp.checked=false;window.alert('本题最多选择 '+q.max+' 项')}
        });
      }
    });
    sec.appendChild(box);
  }
  qWrap.appendChild(sec);
});

function collect(){
  var answers=[];
  (QDATA.questions||[]).forEach(function(q,qi){
    var sec=document.getElementById('q'+(qi+1));var val;
    if(q.type==='text'){val=sec.querySelector('input').value.trim()}
    else{val=[];sec.querySelectorAll('input:checked').forEach(function(i){val.push(i.value)})}
    answers.push(val);
  });
  return answers;
}

$('#btnSubmit').addEventListener('click',function(){
  var err=$('#formError');err.textContent='';$('#submitResult').textContent='';
  var missing=[];
  (QDATA.submitter_fields||[]).forEach(function(f,i){
    var el=document.getElementById('sf_'+i);
    if(f.required&&!el.value.trim())missing.push(f.label);
  });
  var answers=collect();
  answers.forEach(function(v,i){
    var empty=(QDATA.questions[i].type==='text')?(v===''):(v.length===0);
    if(QDATA.questions[i].required&&empty)missing.push('第'+(i+1)+'题');
  });
  if(missing.length){err.textContent='还有必填项未完成：'+missing.join('、');return}
  var submitter={};
  (QDATA.submitter_fields||[]).forEach(function(f,i){submitter[f.label]=document.getElementById('sf_'+i).value.trim()});
  var rec={id:randId(),submitted_at:nowStr(),submitter:submitter,answers:answers};
  records.push(rec);saveRecords(records);
  $('#submitResult').textContent='提交成功！记录编号 '+rec.id+'（已保存到本机）';
  var lastBtn=$('#btnReceipt');lastBtn.style.display='inline-block';
  lastBtn.onclick=function(){download(rec.id+'.json',JSON.stringify(rec,null,2))};
  document.querySelectorAll('#qForm input[type=text]').forEach(function(i){i.value=''});
  document.querySelectorAll('#qForm input[type=radio],#qForm input[type=checkbox]').forEach(function(i){i.checked=false});
  if(!$('#adminBody').hidden)renderAdminList();
});

/* 记录管理 */
var adminSec=$('#secAdmin');
$('#btnAdmin').addEventListener('click',function(){adminSec.hidden=false;adminSec.scrollIntoView({behavior:'smooth'})});
$('#btnUnlock').addEventListener('click',function(){
  var pw=(QDATA.cfg&&QDATA.cfg.admin_password)||'666888';
  if($('#adminPass').value===pw){$('#adminBody').hidden=false;$('#adminMsg').textContent='';renderAdminList()}
  else{$('#adminMsg').textContent='密码不正确'}
});
function zipAnswers(rec){
  var obj={};
  (QDATA.questions||[]).forEach(function(q,i){obj['Q'+(i+1)+' '+q.title]=rec.answers[i]});
  return obj;
}
function renderAdminList(){
  var wrap=$('#recordList');wrap.textContent='';
  $('#adminCount').textContent='共 '+records.length+' 份提交';
  if(!records.length){wrap.textContent='暂无提交记录';return}
  records.forEach(function(r,ri){
    var d=document.createElement('details');
    var s=document.createElement('summary');
    var who=[];for(var k in r.submitter){who.push(r.submitter[k])}
    s.textContent=r.id+' · '+r.submitted_at+' · '+who.join(' / ');
    var pre=document.createElement('pre');pre.textContent=JSON.stringify(zipAnswers(r),null,2);
    var del=document.createElement('button');del.textContent='删除这条';del.className='danger';
    del.addEventListener('click',function(){
      if(window.confirm('删除 '+r.id+'？')){records.splice(ri,1);saveRecords(records);renderAdminList()}
    });
    d.appendChild(s);d.appendChild(pre);d.appendChild(del);wrap.appendChild(d);
  });
}
function csvCell(v){v=String(v==null?'':v);return '"'+v.replace(/"/g,'""')+'"'}
function exportCSV(){
  var heads=['记录编号','提交时间'];
  (QDATA.submitter_fields||[]).forEach(function(f){heads.push(f.label)});
  (QDATA.questions||[]).forEach(function(q,i){heads.push('Q'+(i+1)+' '+q.title)});
  var lines=[heads.map(csvCell).join(',')];
  records.forEach(function(r){
    var row=[r.id,r.submitted_at];
    (QDATA.submitter_fields||[]).forEach(function(f){row.push(r.submitter[f.label]||'')});
    (QDATA.questions||[]).forEach(function(q,i){var v=r.answers[i];row.push(Object.prototype.toString.call(v)==='[object Array]'?v.join(' | '):v)});
    lines.push(row.map(csvCell).join(','));
  });
  return '\uFEFF'+lines.join('\r\n');
}
function exportJSON(){return JSON.stringify({title:QDATA.title,exported_at:nowStr(),records:records},null,2)}
function mergeReceipts(list){
  var added=0,skipped=0,have={};
  records.forEach(function(r){have[r.id]=1});
  list.forEach(function(r){
    if(r&&r.id&&!have[r.id]){records.push(r);have[r.id]=1;added++}else{skipped++}
  });
  if(added){saveRecords(records);renderAdminList()}
  return {added:added,skipped:skipped};
}
function download(name,text){
  var b=new Blob([text],{type:'text/plain;charset=utf-8'});
  var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();
  setTimeout(function(){URL.revokeObjectURL(a.href)},2000);
}
$('#btnCSV').addEventListener('click',function(){download(QDATA.title+'-提交记录.csv',exportCSV())});
$('#btnJSON').addEventListener('click',function(){download(QDATA.title+'-提交记录备份.json',exportJSON())});
$('#receiptFile').addEventListener('change',function(){
  var f=this.files[0];if(!f)return;
  var fr=new FileReader();
  fr.onload=function(){
    try{
      var data=JSON.parse(fr.result);
      if(Object.prototype.toString.call(data)!=='[object Array]')data=[data];
      var res=mergeReceipts(data);
      $('#importMsg').textContent='合并完成：新增 '+res.added+'，跳过 '+res.skipped;
    }catch(e){$('#importMsg').textContent='回执文件不是合法 JSON'}
  };
  fr.readAsText(f);
  this.value='';
});

/* 供自检/冒烟脚本调用的最小接口 */
window.__qform={
  getRecords:function(){return records},
  exportCSV:exportCSV,
  exportJSON:exportJSON,
  mergeReceipts:mergeReceipts
};
})();
</script>
</body>
</html>
