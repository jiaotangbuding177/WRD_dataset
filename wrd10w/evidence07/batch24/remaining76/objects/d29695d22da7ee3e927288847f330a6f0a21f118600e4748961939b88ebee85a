#!/usr/bin/env python3
"""Export a news digest markdown file as .md copy or .docx document.

Usage:
  python export_digest.py DIGEST.md --format md|docx --out OUTPUT [--engine auto|pandoc|builtin]

--format md    : normalized copy (UTF-8, single trailing newline).
--format docx  : Word document. Engine auto tries pandoc first (best fidelity:
                 real tables/lists/headings); falls back to the built-in
                 stdlib generator (real w:tbl tables, bold headings, bullets)
                 when pandoc is missing or fails.
Every produced docx is re-opened and parsed before exit; the command fails
loudly (exit 2, stderr 'export_digest_error: ...') instead of writing a
broken file. The input file is never modified.
"""
from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import zipfile
from pathlib import Path
from xml.sax.saxutils import escape

CT = (
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
    '<Default Extension="xml" ContentType="application/xml"/>'
    '<Override PartName="/word/document.xml" '
    'ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
    '</Types>'
)
RELS = (
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
    '<Relationship Id="rId1" '
    'Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" '
    'Target="word/document.xml"/>'
    '</Relationships>'
)


def fail(message):
    print('export_digest_error: ' + message, file=sys.stderr)
    raise SystemExit(2)


def paragraph(text, bold=False, size=22):
    run_props = '<w:b/>' if bold else ''
    if size != 22:
        run_props += '<w:sz w:val="%d"/><w:szCs w:val="%d"/>' % (size, size)
    return (
        '<w:p><w:r><w:rPr>' + run_props + '</w:rPr>'
        '<w:t xml:space="preserve">' + escape(text) + '</w:t></w:r></w:p>'
    )


def table_row_cells(line):
    stripped = line.strip()
    if stripped.startswith('|'):
        stripped = stripped[1:]
    if stripped.endswith('|'):
        stripped = stripped[:-1]
    return [c.strip() for c in stripped.split('|')]


def is_separator_row(cells):
    return bool(cells) and all(
        set(c) <= set('-: ') and any(ch in c for ch in '-') for c in cells
    )


def table_xml(rows):
    grid = ''.join('<w:gridCol/>' for _ in range(max(len(r) for r in rows)))
    body = []
    for i, cells in enumerate(rows):
        bold = i == 0
        tcs = ''.join(
            '<w:tc><w:tcPr/>' + paragraph(c, bold=bold) + '</w:tc>' for c in cells
        )
        body.append('<w:tr>' + tcs + '</w:tr>')
    return (
        '<w:tbl><w:tblPr><w:tblBorders>'
        + ''.join(
            '<w:%s w:val="single" w:sz="4" w:color="999999"/>' % side
            for side in ('top', 'left', 'bottom', 'right', 'insideH', 'insideV')
        )
        + '</w:tblBorders></w:tblPr><w:tblGrid>' + grid + '</w:tblGrid>'
        + ''.join(body) + '</w:tbl>'
    )


def document_xml(text):
    body = []
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i].rstrip()
        if line.lstrip().startswith('|') and line.count('|') >= 2:
            rows = []
            while i < len(lines) and lines[i].lstrip().startswith('|'):
                cells = table_row_cells(lines[i])
                if not is_separator_row(cells):
                    rows.append(cells)
                i += 1
            if rows:
                body.append(table_xml(rows))
            continue
        if not line.strip():
            i += 1
            continue
        if line.startswith('### '):
            body.append(paragraph(line[4:], bold=True, size=26))
        elif line.startswith('## '):
            body.append(paragraph(line[3:], bold=True, size=30))
        elif line.startswith('# '):
            body.append(paragraph(line[2:], bold=True, size=36))
        elif line.startswith('- ') or line.startswith('* '):
            body.append(paragraph('\u2022 ' + line[2:]))
        else:
            body.append(paragraph(line))
        i += 1
    return (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
        '<w:body>' + ''.join(body) + '<w:sectPr/></w:body></w:document>'
    )


def write_builtin_docx(text, out):
    with zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as package:
        package.writestr('[Content_Types].xml', CT)
        package.writestr('_rels/.rels', RELS)
        package.writestr('word/document.xml', document_xml(text))


def verify_docx(path):
    try:
        with zipfile.ZipFile(path) as z:
            if z.testzip() is not None:
                return 'corrupt zip entry'
            xml = z.read('word/document.xml').decode('utf-8')
    except Exception as exc:  # noqa: BLE001
        return 'unreadable docx: %s' % exc
    if '<w:body' not in xml or 'w:document' not in xml:
        return 'document.xml missing body'
    return None


def main():
    parser = argparse.ArgumentParser(
        prog='export_digest.py',
        description='Export a news digest markdown file as .md copy or .docx document.',
    )
    parser.add_argument('input', help='digest markdown document')
    parser.add_argument('--format', default='md', choices=('md', 'docx'),
                        help='output format (default: md)')
    parser.add_argument('--out', required=True, help='output file path')
    parser.add_argument('--engine', default='auto', choices=('auto', 'pandoc', 'builtin'),
                        help='docx engine (default: auto = pandoc then builtin)')
    args = parser.parse_args()

    source = Path(args.input)
    if not source.is_file():
        fail('digest input not found: %s' % args.input)
    try:
        text = source.read_text(encoding='utf-8-sig')
    except UnicodeError:
        fail('digest input is not valid UTF-8 text: %s' % args.input)
    if not text.endswith('\n'):
        text += '\n'

    out = Path(args.out)
    if str(out.parent) not in ('', '.'):
        try:
            out.parent.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            fail('output directory not writable: %s (%s)' % (out.parent, exc))

    if args.format == 'md':
        try:
            out.write_text(text, encoding='utf-8')
        except OSError as exc:
            fail('cannot write output: %s (%s)' % (out, exc))
        print('exported md digest to %s' % out)
        return 0

    notes = []
    if args.engine in ('auto', 'pandoc') and shutil.which('pandoc'):
        proc = subprocess.run(
            ['pandoc', '-f', 'gfm', '-t', 'docx', '-o', str(out), str(source)],
            capture_output=True, text=True,
        )
        if proc.returncode == 0:
            problem = verify_docx(out)
            if problem is None:
                print('exported docx digest to %s (pandoc)' % out)
                return 0
            notes.append('pandoc output failed verification: %s' % problem)
        else:
            notes.append('pandoc failed: %s' % proc.stderr.strip()[:200])
    elif args.engine == 'pandoc':
        fail('pandoc requested but not found on PATH')

    write_builtin_docx(text, out)
    problem = verify_docx(out)
    if problem is not None:
        fail('generated docx failed verification: %s' % problem)
    suffix = (' (%s; used builtin generator)' % '; '.join(notes)) if notes else ' (builtin generator)'
    print('exported docx digest to %s%s' % (out, suffix))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
