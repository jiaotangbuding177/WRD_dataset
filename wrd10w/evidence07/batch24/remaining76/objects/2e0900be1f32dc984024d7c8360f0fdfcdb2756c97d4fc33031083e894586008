{"type": "message", "id": "1e1ba861-9c6f-404b-8d0b-6359323b439a", "parentId": "eafd4ee5-c727-40d0-8426-f17b5c204dbe", "timestamp": "2026-10-21T19:15:42.444Z", "message": {"role": "toolResult", "toolCallId": "call8054a5e8e35c4f74ac8aeffe4afbcfe5", "toolName": "exec", "content": [{"type": "text", "text": "615 /workspace/inputs/making_tools/contract.py\n\"\"\"One canonical making-side contract and fail-fast, side-effect-free preflight.\"\"\"\nimport ast, copy, hashlib, json, re, shlex\nfrom pathlib import Path, PurePosixPath, PureWindowsPath\nROOT = next((p for p in Path(__file__).resolve().parents if (p / 'research/pipelines/wrd_workflow_library_v4/reproduction.py').is_file()), None)\nASSERTIONS = ('contains', 'not_contains', 'text_equals', 'json_equals', 'json_count', 'json_keys', 'source_mapping', 'field_preservation', 'explicit_error', 'zip_members', 'zip_xml_contains', 'zip_member_count', 'sha256')\nSCHEMA = 'wrd-making-contract-v4'\n\ndef pin(path):\n    p = Path(path)\n    raw = p.read_bytes()\n    return {'path': str(p), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}\n\ndef read(path):\n    return json.loads(Path(path).read_text(encoding='utf-8-sig'))\n\ndef directory_listing_pin(directory):\n    \"\"\"Pin the real immediate parent listing, never a nonexistent file.\"\"\"\n    directory = Path(directory).absolute()\n    if any((p.is_symlink() for p in (directory, *directory.parents))) or not directory.is_dir():\n        raise ValueError('unsafe_or_missing_parent_directory')\n    entries = []\n    for p in sorted(directory.iterdir(), key=lambda x: x.name):\n        if p.is_symlink():\n            raise ValueError('symlink_in_parent_directory')\n        if p.is_file():\n            actual = pin(p)\n            entries.append({'name': p.name, 'kind': 'file', 'sha256': actual['sha256'], 'bytes': actual['bytes']})\n        elif p.is_dir():\n            entries.append({'name': p.name, 'kind': 'directory'})\n        else:\n            raise ValueError('unsupported_parent_directory_entry')\n    digest = hashlib.sha256(json.dumps(entries, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()\n    return {'kind': 'directory_listing', 'path': str(directory.resolve()), 'entries': entries, 'sha256': digest}\n\ndef absent_reference(root, relative_path, *, source_id, message_ids, source_record_sha256, source_material_pin, absent_root='INPUT'):\n    \"\"\"Build a newly generated invalid-input observation from actual directories.\n\n This observes absence in the current read-only input tree. It never claims\n there were historical bytes at that path and deliberately has no file pin.\n \"\"\"\n    if absent_root not in ('INPUT', 'FIXTURE'):\n        raise ValueError('absence_root_must_be_readonly')\n    if not isinstance(relative_path, str) or not relative_path or any((c in relative_path for c in ('\\\\', ':', '\\x00'))) or PurePosixPath(relative_path).is_absolute() or any((p in ('', '.', '..') for p in relative_path.split('/'))):\n        raise ValueError('unsafe_absent_relative_path')\n    root = Path(root).absolute()\n    target = root / relative_path\n    if any((p.is_symlink() for p in (target, *target.parents))) or not target.resolve().is_relative_to(root.resolve()):\n        raise ValueError('unsafe_absence_target')\n    if target.exists():\n        raise ValueError('declared_absent_path_actually_exists')\n    return {'origin': 'absent_path', 'source_id': source_id, 'message_ids': message_ids, 'source_record_sha256': source_record_sha256, 'absent_root': absent_root, 'absent_relative_path': relative_path, 'parent_directory_pin': directory_listing_pin(target.parent), 'source_material_pin': source_material_pin, 'generated': True, 'purpose': 'invalid_input', 'derivation': 'New missing-path negative observed in the actual read-only input tree; no historical or nonexistent-file bytes are claimed.'}\n\ndef consumer_assertions():\n    if ROOT is None:\n        return set(ASSERTIONS)\n    tree = ast.parse((ROOT / 'research/pipelines/wrd_workflow_library_v4/reproduction.py').read_text(encoding='utf-8-sig'))\n    fn = next((x for x in tree.body if isinstance(x, ast.FunctionDef) and x.name == '_assertion'))\n    found = set()\n    for node in ast.walk(fn):\n        if isinstance(node, ast.Compare) and isinstance(node.left, ast.Name) and (node.left.id == 'kind'):\n            for rhs in node.comparators:\n                if isinstance(rhs, ast.Constant) and isinstance(rhs.value, str):\n                    found.add(rhs.value)\n                elif isinstance(rhs, (ast.Tuple, ast.List)):\n                    found.update((x.value for x in rhs.elts if isinstance(x, ast.Constant) and isinstance(x.value, str)))\n    return found\n\ndef specification():\n    if set(ASSERTIONS) != consumer_assertions():\n        raise RuntimeError('Producer/consumer contract drift; stop before model dispatch')\n    return {'schema': SCHEMA, 'consumer': pin(ROOT / 'research/pipelines/wrd_workflow_library_v4/reproduction.py') if ROOT else None, 'assertion_kinds': list(ASSERTIONS), 'record_count_operator': 'json_count with pointer and integer value', 'error_operator': 'contains with path $stderr/$stdout or explicit_error for JSON; never stderr_contains', 'source_mapping': 'Exact declared JSON value at pointer; use pointer, not undeclared map_by projections', 'program_required': ['path', 'documented_usage', 'public_argv', 'interface', 'dependencies', 'cases'], 'program_case_kinds': ['normal', 'boundary', 'invalid_input'], 'non_program_required': ['path', 'assertions', 'fixture_refs'], 'normal_and_composition_output': 'Full expected JSON/text/SHA, or json_count plus exact source_mapping; Office requires part structure plus actual text', 'stdout_output': {'declaration': {'path': '$stdout', 'min_bytes': 1}, 'assertion_path': '$stdout', 'complete_assertion_required': True, 'unasserted_physical_files': 'HOLD'}, 'source_learning': 'All selected real messages must actually be received; maker full_read:true alone is not evidence', 'artifact_byte_policy': 'Frozen skill bytes never hand edited; making/validation records stay outside skill', 'scope': 'Contract validation is not program execution, source comprehension, delivery success or Actor savings'}\n\ndef render():\n    s = specification()\n    return '# 制作说明：按同一份合同交付，制作记录放技能外\\n\\n按真实学习会话沉淀可复用的最短路线与资源，不能读取正式250题目/答案/消费轨迹。完整阅读所选来源，不能用每条前300字或自报full_read代替；保留原生接收记录。业务值是输入，不能写死整题；程序用于替代公共操作，不给业务执行器添加检查循环。\\n\\nskill内只放原生SKILL.md、必要阶段说明与可复用程序/空模板/资料。首页最多1500字符4096字节，直给路线、关键判断和资源正确入口；细节按需。制作、复现及版本记录均放outputs外置文件，不进技能。\\n\\n机器合同见making_contract.json，来自独立复现器实际支持的同一版本。交付outputs/candidate/skill、evidence.json、resource_manifest.json、replay.json、reproduction_inputs/。失败确需放弃才写hold.json；正常不需要该文件。\\n\\n每个程序声明单行、在技能文档中逐字存在的documented_usage，以及完全相同的public_argv；公开用法针对普通当前输入，不能依赖制作侧FIXTURE或夹解释文字。给normal、boundary、invalid_input和组合接续，原样执行公开命令，检查完整输出与输入对应，不能只help或退出0。\\n\\nassertions只准使用：' + ', '.join(s['assertion_kinds']) + '。\\n数量检查用{\"kind\":\"json_count\",\"path\":\"result.json\",\"pointer\":\"/records\",\"value\":2}，不是record_count/count_of。完整对应检查用{\"kind\":\"source_mapping\",\"path\":\"result.json\",\"pointer\":\"/sources\",\"value\":[\"原件a\",\"原件b\"]}，直接比较该JSON位置，不使用map_by猜测。错误文本用{\"kind\":\"contains\",\"path\":\"$stderr\",\"value\":\"明确错误原因\"}，不是stderr_contains。完整JSON可用json_equals；完整文本可用text_equals；完整文件可用sha256。Office文件还要zip_members/zip_member_count和zip_xml_contains实查生成文档正文，不能只查程序自报JSON。\\n\\n正常资源如果仅把完整数据写到stdout，可在outputs明确声明{\"path\":\"$stdout\",\"min_bytes\":1}，并对$stdout给出完整text_equals/json_equals/sha256或完整计数对应断言。仍检查原样命令、全部输入、退出码和未声明文件；不能只用contains，也不要求程序额外造无用文件。\\n\\n非程序资源必须提供path、assertions和fixture_refs；不使用checks/content_checks别名，不把空检查当PASS。manifest.interface.usage要与实际文档入口一致，全部依赖锁定原固定镜像。每个真实输入的fixture_provenance必须绑定命令实际读取的那一份真实材料；不能声明会话JSON却执行PDF目录。派生边界文件明确generated及派生来源，不能冒充历史原件。\\n\\n先用制作侧preflight.py检查元数据形状与公开用法，再执行全部程序并记录实际输出；这不是业务任务要求，也不投给业务执行器。检查失败保留原文件和真实错误，不能改检查器/伪造断言/预填答案。生成完成不等于程序通过；独立复现、两套真实开发同环境无技能/workflow对照及减负准入均在外层执行。缺材料、用法不清或资源不可靠必须HOLD。\\n'\n\ndef preflight(skill, replay, resources):\n    skill = Path(skill)\n    issues = []\n\n    def add(code, where, domain='candidate_contract'):\n        issues.append({'code': code, 'at': where, 'domain': domain})\n    files = {p.relative_to(skill).as_posix() for p in skill.rglob('*') if p.is_file()}\n    docs = '\\n'.join(((skill / x).read_text(encoding='utf-8-sig') for x in files if Path(x).suffix.lower() == '.md'))\n    specs = resources.get('resources', []) if isinstance(resources, dict) else resources\n    manifest = {x.get('path'): x for x in specs}\n    programs = replay.get('programs', [])\n    executables = {p for p in files if Path(p).suffix.lower() in _consumer_constants()['EXECUTABLE_SUFFIXES']}\n    if {x.get('path') for x in programs} != executables:\n        add('executable_coverage_mismatch', 'programs')\n\n    def assertions(values, where):\n        if not isinstance(values, list) or not values:\n            add('assertions_missing', where)\n            return\n        for i, a in enumerate(values):\n            pos = f'{where}/{i}'\n            kind = a.get('kind')\n            if kind not in ASSERTIONS:\n                add('unsupported_assertion:' + str(kind), pos, 'producer_consumer_contract')\n                continue\n            if kind in ('json_equals', 'json_count', 'json_keys', 'source_mapping', 'field_preservation', 'explicit_error'):\n                if 'count_of' in a or 'map_by' in a:\n                    add('undeclared_json_selection_semantics', pos, 'producer_consumer_contract')\n            if not a.get('path'):\n                add('assertion_path_missing', pos)\n\n    def case(c, where):\n        if c.get('kind', 'composition' if where.startswith('composition_cases/') else None) not in ('normal', 'boundary', 'invalid_input', 'composition'):\n            add('case_kind_invalid', where)\n        refs = c.get('inputs', [c.get('fixture_provenance')])\n        if not isin