{
  "name": "AI Builders Digest 每周总览",
  "schedule": {
    "kind": "cron",
    "expr": "0 12 * * 5",
    "tz": "Asia/Shanghai"
  },
  "payload": {
    "kind": "agentTurn",
    "message": "汇总本周 AI Builders 情报，生成一份当周总览 MD 文档。",
    "timeoutSeconds": 300
  },
  "delivery": {
    "mode": "none"
  },
  "output": {
    "format": "md",
    "filename_pattern": "{date}-AI Builders Digest 每周总览.md",
    "output_dir": "成果文件/AI Builders Digest 每周总览"
  }
}
