tion = specification\ndef _v7_clean(value):\n if isinstance(value, dict): return {k:_v7_clean(v) for k,v in value.items() if k!='composition_cases'}\n if isinstance(value, list): return [_v7_clean(v) for v in value if v!='composition_cases']\n return value\ndef specification():\n value=_v7_clean(_v7_original_specification())\n value['schema']=SCHEMA\n value['normal_output']=value.pop('normal_and_composition_output',None)\n value['resource_layout']='Independent ordinary copies inside each skill'\n return value\n\ndef render():\n return '# 技能制作要求（148）\\n\\n从提供的真实会话学习可复用的最短工作路线，不读取正式250题目或答案。\\n先读making_input_index.json，完整读取所选会话的全部原文；用提供的原文分块工具按需续读，不能以摘要或自报读完代替。\\n同路线先合并来源再制作；仅业务值变化不另造技能，部分路线不同各自保留。\\n每个技能自带完整的scripts、templates、references等必要资源。可复制已可靠复现的资源，\\n但必须是本技能内的普通文件副本；不依赖公共资源目录、另一技能目录或链接。\\n首页轻量，直给路线、关键分岔和正确入口；细节按需读取。\\n每个程序写清方法、参数、输入输出，按公开命令实际复现正常、边界、错误输入并核完整输出。\\n不要求、不生成、不标注独立的组合用例。不要为满足制作检查增加业务执行步骤。\\n输入入口沿用原生输入目录；临时验证样例由包外验证管道临时绑定，不能把技能改到制作目录。\\n程序和模板不要预填具体测试题答案。制作、来源证据、验证、版本记录全部放技能外。\\n交付candidate/skill、evidence.json、resource_manifest.json、replay.json和外置reproduction_inputs。\\nreplay只需programs、fixtures、non_executable_resources及必要限制说明；无需composition_cases。\\n机器字段及支持的断言以配套making_contract.json和preflight.py为准。\\n生成完成不代表通过；独立验证与真实同条件业务减负检验后才允许冻结。\\n'\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792584848338, "__openclaw": {"runId": "ab7dcaf7-6611-4002-b195-f492d72dcaf7"}}}
