{
  "name": "每周投融资事件汇总",
  "schedule": {
    "kind": "cron",
    "expr": "0 7 * * 1",
    "tz": "Asia/Shanghai"
  },
  "payload": {
    "kind": "agentTurn",
    "message": "检索并整理上一周国内与海外的投融资事件，按行业细分，逐项给出项目简介、融资金额、估值、时间与投资方，输出为PDF报告。",
    "timeoutSeconds": 3600
  },
  "delivery": {
    "mode": "announce"
  },
  "output": {
    "format": "pdf",
    "filename_pattern": "{date}-每周投融资事件汇总.pdf",
    "output_dir": "成果文件/投融资周报"
  }
}
