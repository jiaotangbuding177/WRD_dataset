{"type": "message", "id": "d5e4a90b-8ca4-471f-b4ba-18794211be8c", "parentId": "207a8b39-3426-4656-ab1e-fbffc56aa917", "timestamp": "2026-10-23T10:40:18.773Z", "message": {"role": "toolResult", "toolCallId": "callf4ea06a39f5241e18a0e87926700efa2", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"规范DOCX目录后处理：注入标题书签+带页码的目录条目，LibreOffice 实测页码，设置 Word 打开自动更新域。\n\n用法:\n  python3 fix_toc.py INPUT.docx OUTPUT.docx [--offset N] [--keep-work DIR]\n\n适用: docx-js 等生成、含 TOC 域（\\o \"1-2\"）和 Heading1/Heading2 标题的 docx。\n行为:\n  1) document.xml 给每个正文标题段落注入 _Toc_hN 书签（幂等，已有则跳过）。\n  2) 找到 TOC 域（docx-js 的 sdt 包裹或裸域段落），去 sdt 包裹，注入带点线引导 + PAGEREF 域的\n     目录条目段落（幂等：条目已存在时只更新页码缓存值，不重复注入）。\n  3) settings.xml 写入 updateFields（Word 打开自动刷新域；插在 w:compat 之前满足 schema 顺序）。\n  4) 重打包 → LibreOffice 渲染 PDF → 逐页定位标题（排除目录页）→ 回填真实显示页码\n     （默认显示页码 = 物理页号 - 首个标题物理页号 + 1，即正文页码从 1 起算；--offset N 则 = 物理页号 - N）。\n  5) 输出后再渲染验证，打印页数与目录条目页码供抽查。\n退出码: 0 成功; 2 输入问题（无 TOC 域 / 无标题 / 文件不存在）; 3 中间步骤失败。\n已知边界: 标题文本若在目录页之后的更早正文页以完全相同整串出现会被提前匹配（罕见）；\n缓存页码在 Word 打开后会被 updateFields 刷新，最终以 Word 为准；脚本保证 LibreOffice 渲染下即已正确。\n\"\"\"\nimport argparse\nimport html\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport zipfile\n\nDOT_ALL = re.DOTALL\n\n\ndef fail(code, msg):\n    print(f\"fix_toc: ERROR {msg}\", file=sys.stderr)\n    sys.exit(code)\n\n\ndef read_zip(path):\n    with zipfile.ZipFile(path) as z:\n        return {n: z.read(n) for n in z.namelist()}\n\n\ndef write_zip(path, files):\n    names = list(files.keys())\n    if \"[Content_Types].xml\" in files:  # 放最前，兼容性最好\n        names.remove(\"[Content_Types].xml\")\n        names.insert(0, \"[Content_Types].xml\")\n    with zipfile.ZipFile(path, \"w\", zipfile.ZIP_DEFLATED) as z:\n        for n in names:\n            z.writestr(n, files[n])\n\n\ndef para_text(p_xml):\n    ts = re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", p_xml, DOT_ALL)\n    return html.unescape(\"\".join(ts))\n\n\ndef find_headings(doc_xml):\n    \"\"\"返回 [(level, text, span)]，文档顺序；只认 pStyle Heading1/Heading2 的正文标题段落。\"\"\"\n    out = []\n    for m in re.finditer(r\"<w:p\\b[^>]*>.*?</w:p>\", doc_xml, DOT_ALL):\n        p = m.group(0)\n        sm = re.search(r'<w:pStyle w:val=\"(Heading[12])\"\\s*/>', p)\n        if not sm:\n            continue\n        text = para_text(p).strip()\n        if text:\n            out.append((sm.group(1), text, m.span()))\n    return out\n\n\ndef inject_bookmarks(doc_xml, headings):\n    \"\"\"给每个标题段落注入 _Toc_hN 书签（从后往前注入避免 span 偏移）；幂等。\n    返回 (新xml, [(name, level, text)])，entries 为文档顺序。\"\"\"\n    entries = [None] * len(headings)\n    result = doc_xml\n    for i in range(len(headings) - 1, -1, -1):\n        level, text, (s, e) = headings[i]\n        name = f\"_Toc_h{i}\"\n        entries[i] = (name, level, text)\n        if f'w:name=\"{name}\"' in result:\n            continue\n        p = result[s:e]\n        bm = (f'<w:bookmarkStart w:id=\"{9000 + i}\" w:name=\"{name}\"/>'\n              f'<w:bookmarkEnd w:id=\"{9000 + i}\"/>')\n        if \"</w:pPr>\" in p:\n            new_p = p.replace(\"</w:pPr>\", \"</w:pPr>\" + bm, 1)\n        else:\n            new_p = p.replace(\">\", \">\" + bm, 1)\n        result = result[:s] + new_p + result[e:]\n    return result, entries\n\n\ndef toc_entry_xml(name, level, text, first, last):\n    ind = '<w:ind w:left=\"420\"/>' if level == \"Heading2\" else \"\"\n    runs = \"\"\n    if first:\n        runs += ('<w:r><w:fldChar w:fldCharType=\"begin\" w:dirty=\"true\"/></w:r>'\n                 '<w:r><w:instrText xml:space=\"preserve\"> TOC \\\\o \"1-2\" \\\\h \\\\z \\\\u </w:instrText></w:r>'\n                 '<w:r><w:fldChar w:fldCharType=\"separate\"/></w:r>')\n    runs += (f'<w:hyperlink w:anchor=\"{name}\" w:history=\"1\">'\n             f'<w:r><w:rPr><w:rFonts w:hint=\"eastAsia\"/></w:rPr>'\n             f'<w:t xml:space=\"preserve\">{html.escape(text)}</w:t></w:r>'\n             '<w:r><w:tab/></w:r>'\n             '<w:r><w:fldChar w:fldCharType=\"begin\"/></w:r>'\n             f'<w:r><w:instrText xml:space=\"preserve\"> PAGEREF {name} \\\\h </w:instrText></w:r>'\n             '<w:r><w:fldChar w:fldCharType=\"separate\"/></w:r>'\n             '<w:r><w:t>1</w:t></w:r>'\n             '<w:r><w:fldChar w:fldCharType=\"end\"/></w:r>'\n             '</w:hyperlink>')\n    if last:\n        runs += '<w:r><w:fldChar w:fldCharType=\"end\"/></w:r>'\n    return ('<w:p><w:pPr>'\n            '<w:tabs><w:tab w:val=\"right\" w:leader=\"dot\" w:pos=\"9026\"/></w:tabs>'\n            f'{ind}'\n            '<w:spacing w:after=\"80\"/>'\n            '</w:pPr>' + runs + '</w:p>')\n\n\ndef inject_toc_entries(doc_xml, entries):\n    \"\"\"把 TOC sdt（或裸 TOC 域段落）替换为：域起始+条目段落+域结束。幂等：条目已存在则原样返回。\"\"\"\n    if \"PAGEREF _Toc_h0\" in doc_xml:\n        return doc_xml\n    sdt_m = None\n    for m in re.finditer(r\"<w:sdt>.*?</w:sdt>\", doc_xml, DOT_ALL):\n        if re.search(r\"<w:instrText[^>]*>[^<]*TOC \", m.group(0)):\n            sdt_m = m\n            break\n    if sdt_m is None:\n        for m in re.finditer(r\"<w:p\\b[^>]*>.*?</w:p>\", doc_xml, DOT_ALL):\n            if re.search(r\"<w:instrText[^>]*>[^<]*TOC \", m.group(0)):\n                sdt_m = m\n                break\n    if sdt_m is None:\n        fail(2, \"未找到 TOC 域（生成 docx 时需包含 TableOfContents）\")\n    if not entries:\n        fail(2, \"未找到 Heading1/Heading2 标题，无法生成目录条目\")\n    block = \"\".join(\n        toc_entry_xml(name, lv, tx, i == 0, i == len(entries) - 1)\n        for i, (name, lv, tx) in enumerate(entries))\n    return doc_xml[:sdt_m.start()] + block + doc_xml[sdt_m.end():]\n\n\ndef set_update_fields(settings_xml):\n    if \"<w:updateFields\" in settings_xml:\n        return settings_xml\n    tag = '<w:updateFields w:val=\"true\"/>'\n    if \"<w:compat\" in settings_xml:\n        return settings_xml.replace(\"<w:compat\", tag + \"<w:compat\", 1)\n    m = re.search(r\"(<w:settings\\b[^>]*>)\", settings_xml)\n    if not m:\n    