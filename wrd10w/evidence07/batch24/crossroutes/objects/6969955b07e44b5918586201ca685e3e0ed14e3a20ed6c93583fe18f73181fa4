{"type": "message", "id": "bb2971e4-a428-4209-800b-fa318785a063", "parentId": "894d1436-41c7-46ee-ac79-8c9cbe1e569c", "timestamp": "2026-10-23T10:40:16.295Z", "message": {"role": "toolResult", "toolCallId": "call397e3d0a97c54f2b855bee27fa356cc6", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env node\n/**\n * 规范DOCX生成器：封面（无页眉页脚）→ 目录独占一页 → 正文（页码从1起算）。\n * 用法: node make_docx.js content.json OUTPUT.docx\n *   content.json 结构见 templates/content.example.json（字段注释齐全）。\n * 生成后必须再跑: python3 fix_toc.py OUTPUT.docx OUTPUT_final.docx（目录条目+页码+自动更新域）。\n * 依赖: docx（npm）；本容器已全局安装，直接 node 即可；若报 Cannot find module 'docx'，\n *   设 NODE_PATH=$(npm root -g) 再运行。\n */\nconst fs = require(\"fs\");\nconst {\n  Document, Packer, Paragraph, TextRun, HeadingLevel, AlignmentType,\n  Table, TableRow, TableCell, WidthType, BorderStyle, ShadingType, VerticalAlign,\n  Header, Footer, PageNumber, PageNumberType, TableOfContents, SectionType,\n} = require(\"docx\");\n\nconst [contentPath, outPath] = process.argv.slice(2);\nif (!contentPath || !outPath) {\n  console.error(\"用法: node make_docx.js content.json OUTPUT.docx\");\n  process.exit(2);\n}\nconst C = JSON.parse(fs.readFileSync(contentPath, \"utf8\"));\n\nconst FONT = { ascii: \"Calibri\", eastAsia: C.fontEastAsia || \"Noto Sans CJK SC\" };\nconst PAGE_BODY_DXA = 9026; // A4 减去左右 1440 twips 页边距后的正文宽度\n\n// —— 关键结论加粗：段落文本中出现的 boldTerms 子串加粗（不改文字本身） ——\nfunction boldRuns(text) {\n  const terms = (C.boldTerms || []).slice().sort((a, b) => b.length - a.length);\n  const runs = [];\n  let rest = text, plain = \"\";\n  const flush = () => { if (plain) { runs.push(new TextRun({ text: plain, font: FONT })); plain = \"\"; } };\n  while (rest) {\n    let hit = null;\n    for (const t of terms) { if (t && rest.startsWith(t)) { hit = t; break; } }\n    if (hit) {\n      flush();\n      runs.push(new TextRun({ text: hit, bold: true, font: FONT }));\n      rest = rest.slice(hit.length);\n    } else {\n      plain += rest[0];\n      rest = rest.slice(1);\n    }\n  }\n  flush();\n  return runs;\n}\n\nfunction para(block) {\n  if (block.bold) {\n    // 整段加粗：直接重建\n    return new Paragraph({ children: [new TextRun({ text: block.text, bold: true, font: FONT })], spacing: { after: 120, line: 360 } });\n  }\n  return new Paragraph({ children: boldRuns(block.text), spacing: { after: 120, line: 360 } });\n}\n\nfunction makeTable(block) {\n  const widths = block.widths && block.widths.length === (block.headers || []).length\n    ? block.widths : (block.headers || [\"字段\", \"内容\"]).map(() => 1 / (block.headers || [1, 1]).length);\n  const colDxa = widths.map(w => Math.round(w * PAGE_BODY_DXA));\n  const thin = { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" };\n  const borders = { top: thin, bottom: thin, left: thin, right: thin };\n  const rows = [];\n  if (block.headers) {\n    rows.push(new TableRow({\n      tableHeader: true,\n      children: block.headers.map((h, i) => new TableCell({\n        width: { size: colDxa[i], type: WidthType.DXA },\n        shading: { type: ShadingType.CLEAR, fill: \"DEEBF7\" },\n        margins: { top: 60, bottom: 60, left: 120, right: 120 },\n        verticalAlign: VerticalAlign.CENTER,\n        children: [new Paragraph({ children: [new TextRun({ text: h, bold: true, font: FONT })] })],\n      })),\n    }));\n  }\n  (block.rows || []).forEach((row, ri) => {\n    rows.push(new TableRow({\n      children: row.map((cell, ci) => new TableCell({\n        width: { size: colDxa[ci] || 2000, type: WidthType.DXA },\n        shading: ri % 2 === 1 ? { type: ShadingType.CLEAR, fill: \"F2F8FD\" } : undefined,\n        margins: { top: 60, bottom: 60, left: 120, right: 120 },\n        verticalAlign: VerticalAlign.CENTER,\n        children: [new Paragraph({\n          children: (block.boldAllCells || block.boldCol === ci)\n            ? [new TextRun({ text: String(cell), bold: true, font: FONT })]\n            : boldRuns(String(cell)).length ? boldRuns(String(cell)) : [new TextRun({ text: String(cell), font: FONT })],\n        })],\n      })),\n    }));\n  });\n  return new Table({\n    width: { size: PAGE_BODY_DXA, type: WidthType.DXA },\n    columnWidths: colDxa,\n    alignment: AlignmentType.CENTER,\n    borders: { ...borders, insideHorizontal: thin, insideVertical: thin },\n    rows,\n  });\n}\n\nfunction blockToChildren(block) {\n  if (block.type === \"h2\") {\n    return [new Paragraph({ heading: HeadingLevel.HEADING_2, children: [new TextRun({ text: block.text, font: FONT })] })];\n  }\n  if (block.type === \"list\") {\n    return block.items.map(it => new Paragraph({\n      bullet: { level: 0 }, spacing: { after: 80, line: 360 },\n      children: boldRuns(it),\n    }));\n  }\n  if (block.type === \"table\") {\n    const out = [makeTable(block)];\n    out.push(new Paragraph({ spacing: { after: 160 }, children: [] }));\n    return out;\n  }\n  return [para(block)]; // p\n}\n\nconst bodyChildren = [];\nfor (const sec of C.sections) {\n  bodyChildren.push(new Paragraph({\n    heading: HeadingLevel.HEADING_1,\n    children: [new TextRun({ text: sec.h1, font: FONT })],\n  }));\n  for (const b of sec.blocks || []) bodyChildren.push(...blockToChildren(b));\n}\n\n// 封面信息表\nconst metaTable = new Table({\n  alignment: AlignmentType.CENTER,\n  width: { size: 6600, type: WidthType.DXA },\n  columnWidths: [2200, 4400],\n  borders: {\n    top: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n    bottom: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n    left: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n    right: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n    insideHorizontal: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n    insideVertical: { style: BorderStyle.SINGLE, size: 4, color: \"BFBFBF\" },\n  },\n  rows: (C.meta || []).map(([k, v]) => new TableRow({\n    children: [\n      new TableCell({\n        width: { size: 2200, type: WidthType.DXA },\n        shading: { type: ShadingType.CLEAR, fill: \"DEEBF7\" },\n        margins: { top: 80, bottom: 80, left: 140, right: 140 },\n        children: [new Paragraph({ alignment: AlignmentType.CENTER, children: [new TextRun({ text: k, bold: true, font: FONT })] })],\n      }),\n      new TableCell({\n        width: { size: 4400, type: WidthType.DXA },\n        margins: { top: 80, bottom: 80, left: 140, right: 140 },\n        children: [new Paragraph({ children: [new TextRun({ text: v, font: FONT })] })],\n      }),\n    ],\n  })),\n});\n\nconst doc = new Document({\n  styles: {\n    default: { document: { run: { font: FONT, size: 22 } } },\n    paragraphStyles: [\n      { // 拉开一二级标题字号差（16pt / 14pt）\n        id: \"Heading1\", name: \"Heading 1\", basedOn: \"Normal\", next: \"Normal\", quickFormat: true,\n        run: { size: 32, bold: true, color: \"1F4E79\", font: FONT },\n        paragraph: { spacing: { before: 360, after: 200 } },\n      },\n      {\n        id: \"Heading2\", name: \"Heading 2\", basedOn: \"Normal\", next: \"Normal\", quickFormat: true,\n        run: { size: 28, bold: true, color: \"2E74B5\", font: FONT },\n        paragraph: { spacing: { before: 280, after: 160 } },\n      },\n    ],\n  },\n  sections: [\n    { // 第1节：封面 —— 不指定 headers/footers，天然无页眉页脚\n      properties: {},\n      children: [\n        new Paragraph({ spacing: { before: 3200 }, children: [] }),\n        new Paragraph({\n          alignment: AlignmentType.CENTER, spacing: { after: 600 },\n          children: [new TextRun({ text: C.title, bold: true, size: 56, color: \"1F4E79\", font: FONT })],\n        }),\n        ...(C.subtitle ? [new Paragraph({\n          alignment: AlignmentType.CENTER, spacing: { after: 800 },\n          children: [new TextRun({ text: C.subtitle, size: 26, color: \"595959\", font: FONT })],\n        })] : []),\n        metaTable,\n      ],\n    },\n    { // 第2节：目录独占一页；标题用非标题样式，避免“目录”二字进目录\n      properties: { type: SectionType.NEXT_PAGE },\n      children: [\n        new Paragraph({\n          alignment: AlignmentType.CENTER, spacing: { after: 400 },\n          children: [new TextRun({ text: \"目  录\", bold: true, size: 32, font: FONT })],\n        }),\n        new TableOfContents(\"目录\", { hyperlink: true, headingStyleRange: \"1-2\" }),\n      ],\n    },\n    { // 第3节：正文 —— 页眉右上+分隔线，页脚“第 X 页”，页码从 1 重新起算\n      properties: { type: SectionType.NEXT_PAGE, page: { pageNumbers: { start: 1 } } },\n      headers: {\n        default: new Header({\n          children: [new Paragraph({\n            alignment: AlignmentType.RIGHT,\n            border: { bottom: { style: BorderStyle.SINGLE, size: 6, color: \"9DC3E6\", space: 2 } },\n            children: [new TextRun({ text: C.headerText || C.title, size: 18, color: \"595959\", font: FONT })],\n          })],\n        }),\n      },\n      footers: {\n        default: new Footer({\n          children: [new Paragraph({\n            alignment: AlignmentType.CENTER,\n            children: [new TextRun({ children: [\"第 \", PageNumber.CURRENT, \" 页\"], size: 18, color: \"595959\", font: FONT })],\n          })],\n        }),\n      },\n      children: bodyChildren,\n    },\n  ],\n});\n\nPacker.toBuffer(doc).then(buf => {\n  fs.writeFileSync(outPath, buf);\n  console.log(`make_docx: 已生成 ${outPath}（${buf.length} 字节）。下一步: python3 fix_toc.py ${outPath} <输出_final.docx>`);\n}).catch(e => { console.error(e); process.exit(3); });\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792752016294, "__openclaw": {"runId": "626cd16d-8f03-4756-846b-b319acc3a978"}}}
