s:10px;padding:8px 14px;font-size:14px}\n#panel button{background:#1d2a52;color:#dfe6f5;border:1px solid #3a4a80;border-radius:6px;padding:4px 14px;cursor:pointer}\n#panel label{display:flex;gap:6px;align-items:center}\n#speed{width:140px}\n</style>\n</head>\n<body>\n<canvas id=\"stage\"></canvas>\n<div id=\"caption\">__TITLE__</div>\n<div id=\"panel\">\n<button id=\"playBtn\">暂停</button>\n<label>速度 <input id=\"speed\" type=\"range\" min=\"0.1\" max=\"5\" step=\"0.1\"> <span id=\"speedVal\"></span></label>\n<label><input id=\"orbits\" type=\"checkbox\" checked> 轨道</label>\n<label><input id=\"labels\" type=\"checkbox\" checked> 标签</label>\n</div>\n<script>\nconst SPEC = __SPEC_JSON__;\nconst STARS = __STARS_JSON__;\nconst canvas = document.getElementById(\"stage\");\nconst ctx = canvas.getContext(\"2d\");\nconst playBtn = document.getElementById(\"playBtn\");\nconst speedInput = document.getElementById(\"speed\");\nconst speedVal = document.getElementById(\"speedVal\");\nconst orbitsBox = document.getElementById(\"orbits\");\nconst labelsBox = document.getElementById(\"labels\");\nlet playing = true;\nlet speed = SPEC.speed;\nlet days = 0;\nlet last = null;\nfunction resize(){ canvas.width = innerWidth; canvas.height = innerHeight; }\naddEventListener(\"resize\", resize);\nresize();\nplayBtn.addEventListener(\"click\", () => { playing = !playing; playBtn.textContent = playing ? \"暂停\" : \"播放\"; });\nspeedInput.value = String(SPEC.speed);\nspeedVal.textContent = SPEC.speed.toFixed(1) + \"×\";\nspeedInput.addEventListener(\"input\", () => { speed = parseFloat(speedInput.value); speedVal.textContent = speed.toFixed(1) + \"×\"; });\nfunction draw(){\n  const w = canvas.width, h = canvas.height;\n  ctx.fillStyle = \"#05060f\"; ctx.fillRect(0, 0, w, h);\n  ctx.fillStyle = \"#cfd8ea\";\n  for (const s of STARS) { ctx.globalAlpha = 0.25 + 0.4 * s[2] / 1.4; ctx.fillRect(s[0] * w, s[1] * h, s[2], s[2]); }\n  ctx.globalAlpha = 1;\n  const cx = w / 2, cy = h / 2;\n  let maxOrbit = 1;\n  for (const o of SPEC.objects) { if (o.orbit > maxOrbit) maxOrbit = o.orbit; }\n  const scale = Math.min(w, h) / 2.15 / maxOrbit;\n  if (orbitsBox.checked) {\n    ctx.strokeStyle = \"rgba(140,160,220,0.25)\"; ctx.lineWidth = 1;\n    for (const o of SPEC.objects) {\n      if (o.orbit > 0) { ctx.beginPath(); ctx.ellipse(cx, cy, o.orbit * scale, o.orbit * scale * 0.45, 0, 0, Math.PI * 2); ctx.stroke(); }\n    }\n  }\n  const phase = 2.399963;\n  SPEC.objects.forEach((o, i) => {\n    const r = o.orbit * scale;\n    const ang = Math.PI * 2 * days / o.period + i * phase;\n    const x = cx + r * Math.cos(ang), y = cy + r * Math.sin(ang) * 0.45;\n    if (o.orbit === 0) {\n      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, o.size * scale * 3.5);\n      g.addColorStop(0, o.color); g.addColorStop(1, \"rgba(0,0,0,0)\");\n      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, o.size * scale * 3.5, 0, Math.PI * 2); ctx.fill();\n      ctx.fillStyle = o.color; ctx.beginPath(); ctx.arc(cx, cy, Math.max(o.size * scale, 2), 0, Math.PI * 2); ctx.fill();\n    } else {\n      const rad = Math.max(o.size * scale, 1.5);\n      ctx.fillStyle = o.color; ctx.beginPath(); ctx.arc(x, y, rad, 0, Math.PI * 2); ctx.fill();\n      if (o.ring) { ctx.strokeStyle = o.color; ctx.globalAlpha = 0.7; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.ellipse(x, y, rad * 2.1, rad * 0.7, -0.4, 0, Math.PI * 2); ctx.stroke(); ctx.globalAlpha = 1; }\n    }\n    if (labelsBox.checked) { ctx.fillStyle = \"#dfe6f5\"; ctx.font = \"12px sans-serif\"; ctx.textAlign = \"center\"; ctx.fillText(o.name, x, y + Math.max(o.size * scale, 1.5) + 14); }\n  });\n}\nfunction frame(ts){\n  if (last === null) last = ts;\n  const dt = (ts - last) / 1000; last = ts;\n  if (playing) days += dt * speed;\n  draw();\n  requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n'''\n\n\ndef fail(message):\n    print(f'{ERROR_PREFIX}: {message}', file=sys.stderr)\n    return 2\n\n\ndef number(value, name, minimum, exclusive=False):\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        raise ValueError(f'{name} must be a number')\n    value = float(value)\n    if exclusive and value <= minimum:\n        raise ValueError(f'{name} must be > {minimum}')\n    if not exclusive and value < minimum:\n        raise ValueError(f'{name} must be >= {minimum}')\n    return value\n\n\ndef normalize(spec):\n    if not isinstance(spec, dict):\n        raise ValueError('demo_spec must be a JSON object')\n    title = spec.get('title')\n    if not isinstance(title, str) or not title.strip():\n        raise ValueError('demo_spec.title must be a non-empty string')\n    objects = spec.get('objects')\n    if not isinstance(objects, list) or not objects:\n        raise ValueError('demo_spec.objects must be a non-empty list')\n    normalized = []\n    for i, item in enumerate(objects):\n        if not isinstance(item, dict):\n            raise ValueError(f'demo_spec.objects[{i}] must be an object')\n        name = item.get('name')\n        if not isinstance(name, str) or not name.strip():\n            raise ValueError(f'demo_spec.objects[{i}].name must be a non-empty string')\n        color = item.get('color', PALETTE[i % len(PALETTE)])\n        if not isinstance(color, str) or not color.strip():\n            raise ValueError(f'demo_spec.objects[{i}].color must be a non-empty string')\n        normalized.append({\n            'name': name,\n            'color': color,\n            'orbit': number(item.get('orbit', 12), f'demo_spec.objects[{i}].orbit', 0),\n            'size': number(item.get('size', 4), f'demo_spec.objects[{i}].size', 0, True),\n            'period': number(item.get('period', 1.0), f'demo_spec.objects[{i}].period', 0, True),\n            'ring': bool(item.get('ring', False)),\n        })\n    speed = number(spec.get('speed', 1.0), 'demo_spec.speed', 0, True)\n    stars = spec.get('stars', 0)\n    if isinstance(stars, bool) or not isinstance(stars, int) or not 0 <= stars <= 2000:\n        raise ValueError('demo_spec.stars must be an integer between 0 and 2000')\n    labels = spec.get('labels', True)\n    if not isinstance(labels, bool):\n        raise ValueError('demo_spec.labels must be a boolean')\n    return {'title': title.strip(), 'objects': normalized, 'speed': speed, 'stars': stars, 'labels': labels}\n\n\ndef safe_json(value):\n    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).replace('<', '\\\\u003c').replace('>', '\\\\u003e')\n\n\ndef star_field(count):\n    rng = random.Random(STAR_SEED)\n    return [[round(rng.random(), 4), round(rng.random(), 4), round(rng.uniform(0.4, 1.4), 3)] for _ in range(count)]\n\n\ndef render(spec):\n    safe_title = html_mod.escape(spec['title'], quote=True)\n    page = HTML_TEMPLATE\n    page = page.replace('__TITLE__', safe_title)\n    page = page.replace('__SPEC_JSON__', safe_json(spec))\n    page = page.replace('__STARS_JSON__', safe_json(star_field(spec['stars'])))\n    return page\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(\n        description='Build a single-file HTML demo animation from a demo spec JSON.')\n    parser.add_argument('spec', help='Path to the demo spec JSON (title, objects, speed, stars, labels)')\n    parser.add_argument('--out', required=True,\n                        help='Output path for the single-file HTML animation')\n    args = parser.parse_args(argv)\n    try:\n        with open(args.spec, 'r', encoding='utf-8-sig') as handle:\n            raw = handle.read()\n    except OSError as error:\n        return fail(f'cannot read demo spec {args.spec}: {error}')\n    try:\n        spec = json.loads(raw)\n    except (json.JSONDecodeError, UnicodeError) as error:\n        return fail(f'invalid demo_spec JSON: {error}')\n    try:\n        spec = normalize(spec)\n    except ValueError as error:\n        return fail(f'invalid demo_spec: {error}')\n    parent = os.path.dirname(os.path.abspath(args.out))\n    try:\n        os.makedirs(parent, exist_ok=True)\n        with open(args.out, 'w', encoding='utf-8', newline='\\n') as handle:\n            handle.write(render(spec))\n    except OSError as error:\n        return fail(f'cannot write animation output: {error}')\n    return 0\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792609380429, "responseId": "chatcmpl-1792609380503", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "4098f37b-4eb3-45a0-8862-02fbaae2d48c"}}}
