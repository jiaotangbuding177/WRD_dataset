{"type": "message", "id": "a7d0a110-d2d9-493a-9bc7-e425749a72ba", "parentId": "cdcd90d5-71b2-48c5-b850-47ee83a90a7f", "timestamp": "2026-10-24T04:37:00.230Z", "message": {"role": "toolResult", "toolCallId": "callc5d3c96108ce470198f206cca5587ca8", "toolName": "exec", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"静态介绍图 + 逐页旁白音频 → 解说视频（推拉平移镜头、淡入淡出、同步字幕，16:9 MP4）。\n\n用法:\n  python make_video.py PAGES_JSON --images IMAGES_DIR --audio AUDIO_DIR --out OUT.mp4 [选项]\n\nPAGES_JSON 格式:\n  {\n    \"title\": \"可选，视频标题\",\n    \"pages\": [\n      {\"id\": \"p01\", \"title\": \"封面\", \"image\": \"slide_001.png\",\n       \"narration\": \"旁白文本。按句合成。\", \"motion\": \"zoom_in\"}\n    ]\n  }\n  image 相对 --images 目录解析，也可是绝对路径；motion 可选\n  zoom_in|zoom_out|pan_left|pan_right|pan_up|still，缺省按页序轮换。\n\n主要选项:\n  --auto-tts      缺页音频时自动调用 tts_page.py 逐句合成（默认只报错列出缺页）\n  --only p01,p02  只构建指定页（先做样片/重做点名页），输出为这几页的成片\n  --force         忽略已存在的页分段缓存，全部重做\n  --no-subtitles  不烧录字幕\n  --width/--height/--fps  默认 1920x1080 30fps；--tail 默认 0.6s 页尾余量\n  --font          字幕字体名，默认 Noto Sans CJK SC\n  --tmpdir        分段与字幕工作目录，默认 OUT 同目录 .video_tmp\n\n退出码: 2 = 输入/缺素材错误（stderr 前缀 video_error:）。\n每页分段缓存在 --tmpdir/segs/{id}.mp4，已存在则跳过（改了对应素材请 --force 或删除该段）。\n\"\"\"\nimport argparse, json, os, shlex, subprocess, sys\n\n\ndef sh(cmd):\n    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True)\n\n\ndef media_duration(path):\n    r = sh([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n            \"-of\", \"default=noprint_wrappers=1:nokey=1\", path])\n    try:\n        return float(r.stdout.strip())\n    except (ValueError, TypeError):\n        return 0.0\n\n\ndef ass_time(sec):\n    h = int(sec // 3600)\n    m = int(sec % 3600 // 60)\n    s = sec % 60\n    return f\"{h}:{m:02d}:{s:05.2f}\"\n\n\ndef write_ass(path, timings, font, W, H):\n    lines = [\n        \"[Script Info]\", \"ScriptType: v4.00+\", f\"PlayResX: {W}\", f\"PlayResY: {H}\",\n        \"WrapStyle: 0\", \"\", \"[V4+ Styles]\",\n        \"Format: Name, Fontname, Fontsize, PrimaryColour, OutlineColour, BackColour, Bold, Outline, Shadow, Alignment, MarginL, MarginR, MarginV\",\n        f\"Style: Sub,{font},44,&H00FFFFFF,&H00101010,&H7F000000,0,3,1,2,110,110,52\",\n        \"\", \"[Events]\", \"Format: Layer, Start, End, Style, Text\",\n    ]\n    for t in timings:\n        text = t[\"text\"].replace(\"\\n\", \" \")\n        lines.append(f\"Dialogue: 0,{ass_time(t['start'])},{ass_time(t['end'])},Sub,{text}\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\")\n\n\ndef zoompan_expr(motion, frames):\n    F = max(frames, 1)\n    if motion == \"zoom_in\":\n        return f\"zoompan=z='1+0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"\n    if motion == \"zoom_out\":\n        return f\"zoompan=z='1.10-0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_right\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)*on/{F}':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_left\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)*(1-on/{F})':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_up\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)*(1-on/{F})'\"\n    return \"zoompan=z='1.001':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"  # still\n\n\ndef build_page(page, idx, a):\n    \"\"\"构建单页分段 mp4，返回分段路径。\"\"\"\n    pid = page[\"id\"]\n    seg = os.path.join(a.segs, f\"{pid}.mp4\")\n    if os.path.exists(seg) and not a.force:\n        print(f\"[skip] {pid} 分段已存在: {seg}\")\n        return seg\n    audio = os.path.join(a.audio, f\"{pid}.wav\")\n    timings_path = os.path.join(a.audio, f\"{pid}.timings.json\")\n    if not os.path.exists(audio):\n        print(f\"video_error: 缺页音频 {audio}（先跑 tts_page.py 或加 --auto-tts）\", file=sys.stderr)\n        sys.exit(2)\n\n    adur = media_duration(audio)\n    if adur <= 0:\n        print(f\"video_error: 音频无效 {audio}\", file=sys.stderr)\n        sys.exit(2)\n    D = adur + a.tail\n    frames = max(int(round(D * a.fps)), 2)\n\n    img = page[\"image\"]\n    if not os.path.isabs(img):\n        img = os.path.join(a.images, img)\n    if not os.path.exists(img):\n        print(f\"video_error: 缺图片 {img}\", file=sys.stderr)\n        sys.exit(2)\n\n    motion = page.get(\"motion\") or [\"zoom_in\", \"pan_right\", \"zoom_out\", \"pan_left\"][idx % 4]\n    SW, SH = int(a.width * 1.15) // 2 * 2, int(a.height * 1.15) // 2 * 2\n    fade_out = min(0.5, D / 3)\n    vf = (\n        f\"scale={SW}:{SH}:force_original_aspect_ratio=increase,crop={SW}:{SH},\"\n        f\"{zoompan_expr(motion, frames)}:d={frames}:s={a.width}x{a.height}:fps={a.fps},\"\n        f\"format=yuv420p,fade=t=in:st=0:d=0.4,fade=t=out:st={D - fade_out:.3f}:d={fade_out:.3f}\"\n    )\n    if not a.no_subtitles and os.path.exists(timings_path):\n        ass = os.path.join(a.assdir, f\"{pid}.ass\")\n        with open(timings_path, encoding=\"utf-8\") as f:\n            write_ass(ass, json.load(f), a.font, a.width, a.height)\n        esc = ass.replace(\"\\\\\", \"/\").replace(\":\", \"\\\\:\").replace(\"'\", \"\\\\\\\\\\\"\")\n        vf += f\",subtitles='{esc}'\"\n    elif not a.no_subtitles:\n        print(f\"[warn] {pid} 无 timings.json，跳过本页字幕\")\n\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", img, \"-i\", audio,\n            \"-filter_complex\", f\"[0:v]{vf}[v];[1:a]apad=whole_dur={D:.3f}[a]\",\n            \"-map\", \"[v]\", \"-map\", \"[a]\", \"-t\", f\"{D:.3f}\",\n            \"-c:v\", \"libx264\", \"-preset\", \"veryfast\", \"-crf\", \"20\",\n            \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-pix_fmt\", \"yuv420p\", seg])\n    if r.returncode != 0:\n        print(f\"video_error: 页 {pid} 合成失败: {r.stderr[-400:]}\", file=sys.stderr)\n        sys.exit(2)\n    print(f\"[ok] {pid} {D:.1f}s motion={motion} -> {seg}\")\n    return seg\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"pages_json\")\n    ap.add_argument(\"--images\", required=True)\n    ap.add_argument(\"--audio\", required=True)\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--width\", type=int, default=1920)\n    ap.add_argument(\"--height\", type=int, default=1080)\n    ap.add_argument(\"--fps\", type=int, default=30)\n    ap.add_argument(\"--tail\", type=float, default=0.6)\n    ap.add_argument(\"--auto-tts\", action=\"store_true\")\n    ap.add_argument(\"--only\", default=\"\")\n    ap.add_argument(\"--force\", action=\"store_true\")\n    ap.add_argument(\"--no-subtitles\", action=\"store_true\")\n    ap.add_argument(\"--font\", default=\"Noto Sans CJK SC\")\n    ap.add_argument(\"--tts-cmd\", default=\"python3 /opt/eval-adapter/ecnu_tools.py speech\")\n    ap.add_argument(\"--tmpdir\", default=\"\")\n    a = ap.parse_args()\n\n    with open(a.pages_json, encoding=\"utf-8\") as f:\n        plan = json.load(f)\n    pages = plan.get(\"pages\") or []\n    if not pages:\n        print(\"video_error: pages 为空\", file=sys.stderr)\n        sys.exit(2)\n    if a.only:\n        want = [x.strip() for x in a.only.split(\",\") if x.strip()]\n        order = {p[\"id\"]: i for i, p in enumerate(pages)}\n        missing = [w for w in want if w not in order]\n        if missing:\n            print(f\"video_error: --only 中不存在的页: {missing}\", file=sys.stderr)\n            sys.exit(2)\n        pages = sorted((p for p in pages if p[\"id\"] in want),\n                       key=lambda p: order[p[\"id\"]])\n\n    out_dir = os.path.dirname(os.path.abspath(a.out))\n    os.makedirs(out_dir, exist_ok=True)\n    tmpdir = a.tmpdir or os.path.join(out_dir, \".video_tmp\")\n    a.segs = os.path.join(tmpdir, \"segs\")\n    a.assdir = os.path.join(tmpdir, \"ass\")\n    os.makedirs(a.segs, exist_ok=True)\n    os.makedirs(a.assdir, exist_ok=True)\n\n    if a.auto_tts:\n        here = os.path.dirname(os.path.abspath(__file__))\n        for p in pages:\n            if not os.path.exists(os.path.join(a.audio, f\"{p['id']}.wav\")):\n                r = sh([sys.executable, os.path.join(here, \"tts_page.py\"),\n                        \"--id\", p[\"id\"], \"--audio-dir\", a.audio,\n                        \"--text\", p[\"narration\"], \"--tts-cmd\", a.tts_cmd])\n                print(r.stdout.strip())\n                if r.returncode != 0:\n                    sys.stderr.write(r.stderr)\n                    print(f\"video_error: {p['id']} TTS 失败\", file=sys.stderr)\n                    sys.exit(2)\n    else:\n        lack = [p[\"id\"] for p in pages\n                if not os.path.exists(os.path.join(a.audio, f\"{p['id']}.wav\"))]\n        if lack:\n            print(f\"video_error: 缺页音频: {lack}（--auto-tts 可自动合成）\", file=sys.stderr)\n            sys.exit(2)\n\n    segs = [build_page(p, i, a) for i, p in enumerate(pages)]\n\n    concat = os.path.join(tmpdir, \"concat.txt\")\n    with open(concat, \"w\", encoding=\"utf-8\") as f:\n        for s in segs:\n            f.write(f\"file '{os.path.abspath(s)}'\\n\")\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"concat\", \"-safe\", \"0\",\n            \"-i\", concat, \"-c\", \"copy\", \"-movflags\", \"+faststart\", a.out])\n    if r.returncode != 0:\n        print(f\"video_error: 拼接失败: {r.stderr[-300:]}\", file=sys.stderr)\n        sys.exit(2)\n    total = media_duration(a.out)\n    print(json.dumps({\"out\": a.out, \"pages\": len(pages),\n                      \"duration_sec\": round(total, 2),\n                      \"resolution\": f\"{a.width}x{a.height}\", \"fps\": a.fps},\n                     ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["status", "exitCode", "exitSignal", "exitReason", "durationMs", "aggregated", "noOutputTimedOut", "cwd"], "status": "completed", "cwd": "/workspace", "exitCode": 0, "exitSignal": null}, "isError": false, "timestamp": 1792816620228, "__openclaw":