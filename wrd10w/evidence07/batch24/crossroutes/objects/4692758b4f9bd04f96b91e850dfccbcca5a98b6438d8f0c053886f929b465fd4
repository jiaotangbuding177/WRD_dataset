wav_duration(raw) > 0.1:\n            n = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", raw,\n                    \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", wav_path])\n            if os.path.exists(raw):\n                os.remove(raw)\n            if n.returncode == 0 and wav_duration(wav_path) > 0.1:\n                return True\n        else:\n            last_err = (r.stderr or r.stdout or \"\").strip().splitlines()\n            last_err = last_err[-1][:200] if last_err else f\"exit={r.returncode}\"\n        if os.path.exists(raw):\n            os.remove(raw)\n        sys.stderr.write(f\"tts retry {attempt + 1}/{retries} failed ({last_err}): {text[:20]}...\\n\")\n    return False\n\n\ndef make_silence(path):\n    sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"lavfi\",\n        \"-i\", f\"anullsrc=r=44100:cl=mono\", \"-t\", str(GAP_SEC),\n        \"-c:a\", \"pcm_s16le\", path])\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--id\", required=True)\n    ap.add_argument(\"--audio-dir\", required=True)\n    ap.add_argument(\"--text\", required=True)\n    ap.add_argument(\"--tts-cmd\", default=\"python3 /opt/eval-adapter/ecnu_tools.py speech\")\n    ap.add_argument(\"--retries\", type=int, default=3)\n    args = ap.parse_args()\n\n    os.makedirs(args.audio_dir, exist_ok=True)\n    sents = split_sentences(args.text)\n    if not sents:\n        print(\"tts_error: empty narration text\", file=sys.stderr)\n        sys.exit(3)\n\n    # 句子音频持久化在 audio_dir 下，重跑时已有句子直接复用（断点续传）\n    tmpdir = os.path.join(args.audio_dir, f\"sents_{args.id}\")\n    os.makedirs(tmpdir, exist_ok=True)\n    silence = os.path.join(tmpdir, \"gap.wav\")\n    make_silence(silence)\n\n    pieces, timings, t = [], [], 0.0\n    for i, s in enumerate(sents):\n        wav = os.path.join(tmpdir, f\"sent_{i:03d}.wav\")\n        if not (os.path.exists(wav) and wav_duration(wav) > 0.1):\n            if not synth_sentence(s, wav, args.tts_cmd, args.retries):\n                print(f\"tts_error: sentence {i} failed after {args.retries} retries: {s[:40]}\",\n                      file=sys.stderr)\n                sys.exit(3)\n        dur = wav_duration(wav)\n        pieces.append(wav)\n        timings.append({\"text\": s, \"start\": round(t, 3), \"end\": round(t + dur, 3)})\n        t += dur\n        if i < len(sents) - 1:\n            pieces.append(silence)\n            t += GAP_SEC\n\n    # 拼接：filter_complex concat，避免 concat demuxer 对格式差异敏感\n    inputs, n = [], 0\n    for p in pieces:\n        inputs += [\"-i\", p]\n        if p == silence:\n            n += 1\n    fc = \"\".join(f\"[{k}:a]\" for k in range(len(pieces))) + f\"concat=n={len(pieces)}:v=0:a=1[out]\"\n    page_wav = os.path.join(args.audio_dir, f\"{args.id}.wav\")\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\"] + inputs +\n           [\"-filter_complex\", fc, \"-map\", \"[out]\",\n            \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", page_wav])\n    if r.returncode != 0:\n        print(f\"tts_error: concat failed: {r.stderr[-300:]}\", file=sys.stderr)\n        sys.exit(3)\n\n    timings_path = os.path.join(args.audio_dir, f\"{args.id}.timings.json\")\n    with open(timings_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(timings, f, ensure_ascii=False, indent=1)\n    total = wav_duration(page_wav)\n    print(json.dumps({\"id\": args.id, \"page_wav\": page_wav,\n                      \"timings\": timings_path, \"sentences\": len(sents),\n                      \"duration_sec\": round(total, 2)}, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()"}], "details": {"status": "completed", "exitCode": 0, "exitSignal": null, "exitReason": "exit", "durationMs": 12, "aggregated": "#!/usr/bin/env python3\n\"\"\"逐句TTS一页解说词，拼接成页音频并产出逐句时间轴（供字幕同步）。\n\n用法:\n  python tts_page.py --id p01 --audio-dir OUT/audio \\\n      --text \"第一句。第二句。第三句。\" [--tts-cmd \"python3 /opt/eval-adapter/ecnu_tools.py speech\"]\n\n产出:\n  {audio-