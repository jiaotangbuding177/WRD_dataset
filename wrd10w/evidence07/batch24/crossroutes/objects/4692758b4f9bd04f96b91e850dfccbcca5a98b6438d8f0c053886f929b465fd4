  for p in parts:\n        if merged and (len(merged[-1]) < min_chars or len(p) < min_chars):\n            merged[-1] += p\n        else:\n            merged.append(p)\n    return merged\n\n\ndef synth_sentence(text, wav_path, tts_cmd, retries):\n    \"\"\"合成一句并归一化到统一格式；返回 (\"ok\"|\"fail\"|\"endpoint\", last_err)。\n    \"fail\"=瞬时错误已重试仍失败；\"endpoint\"=端点类错误，勿重试。\"\"\"\n    last_err = \"\"\n    for attempt in range(retries):\n        raw = wav_path + \".raw\"\n        r = sh(shlex.split(tts_cmd) + [\"--text\", text, \"--output\", raw])\n        if r.returncode == 0 and os.path.exists(raw) and wav_duration(raw) > 0.1:\n            n = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", raw,\n                    \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", wav_path])\n            if os.path.exists(raw):\n                os.remove(raw)\n            if n.returncode == 0 and wav_duration(wav_path) > 0.1:\n                return \"ok\"\n        else:\n            last_err = (r.stderr or r.stdout or \"\").strip().splitlines()\n            last_err = last_err[-1][:200] if last_err else f\"exit={r.returncode}\"\n            if any(p in last_err.lower() for p in ENDPOINT_ERR_PATTERNS):\n                return \"endpoint\", last_err\n        if os.path.exists(raw):\n            os.remove(raw)\n        sys.stderr.write(f\"tts retry {attempt + 1}/{retries} failed ({last_err}): {text[:20]}...\\n\")\n    return \"fail\", last_err\n\n\ndef make_silence(path):\n    sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"lavfi\",\n        \"-i\", f\"anullsrc=r=44100:cl=mono\", \"-t\", str(GAP_SEC),\n        \"-c:a\", \"pcm_s16le\", path])\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--id\", required=True)"}], "details": {"status": "completed", "exitCode": 0, "exitSignal": null, "exitReason": "exit", "durationMs": 32, "aggregated": "#!/usr/bin/env python3\n\"\"\"逐句TTS一页解说词，拼接成页音频并产出逐句时间轴（供字幕同步）。\n\n用法:\n  python tts_page.py --id p01 --audio-di