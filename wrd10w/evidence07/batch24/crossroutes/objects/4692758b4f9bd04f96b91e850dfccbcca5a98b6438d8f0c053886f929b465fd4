 0 and os.path.exists(raw) and wav_duration(raw) > 0.1:\n@@\n         else:\n             last_err = (r.stderr or r.stdout or \"\").strip().splitlines()\n             last_err = last_err[-1][:200] if last_err else f\"exit={r.returncode}\"\n+            if any(p in last_err.lower() for p in ENDPOINT_ERR_PATTERNS):\n+                return \"endpoint\"\n@@\n         wav = os.path.join(tmpdir, f\"sent_{i:03d}.wav\")\n         if not (os.path.exists(wav) and wav_duration(wav) > 0.1):\n-            if not synth_sentence(s, wav, args.tts_cmd, args.retries):\n+            status = synth_sentence(s, wav, args.tts_cmd, args.retries)\n+            if status == \"endpoint\":\n+                print(f\"tts_error: 端点类错误不重试，整页失败（句子 {i}）: {s[:40]}\\n\"\n+                      f\"  最近报错: {last_err_hint}\\n\"\n+                      f\"  请立即换本地回退: --tts-cmd \\\"python3 {skill_dir}/scripts/tts_cmd.py\\\"\"\n+                      \"（或其它本地TTS命令），不要反复探测同一端点\",\n+                      file=sys.stderr)\n+                sys.exit(3)\n+            if status != \"ok\":\n                 print(f\"tts_error: sentence {i} failed after {args.retries} retries: {s[:40]}\",\n                       file=sys.stderr)\n                 sys.exit(3)\n*** End Patch\n***"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792816700791, "responseId": "chatcmpl-1792816700874", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "5779540b-f12a-4ab0-9850-f4b2162bd22e"}}}
