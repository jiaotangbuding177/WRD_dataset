{"type": "message", "id": "f4e041bd-b76e-45bb-b390-95d246202652", "parentId": "40633271-89f6-40dc-a2fd-e6a99ad1abc9", "timestamp": "2026-10-24T04:40:06.511Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在启动内置的备用包装脚本 `tts_cmd.py`。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-bdf14896ab4c4abca1bd8d5f\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call5373d536ef554179a4db44ce828e470f", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"本地TTS回退wrapper（供 make_video.py / tts_page.py 的 --tts-cmd 使用）。\n\n用法:\n  python tts_cmd.py --text \"要朗读的文本\" --output out.wav \\\n      [--engine auto|piper|edge|gtts] [--voice zh-CN-XiaoxiaoNeural]\n\n引擎 auto 选择顺序（首个可用即用，全部失败退出码 1）:\n  piper   离线优先；需音色模型：环境变量 PIPER_MODEL 指向 .onnx，\n          或 ~/.local/share/piper 下有 .onnx（自动取第一个）。\n          自动处理 piper 裸 raw 输出（补 WAV 头再转码），exit=0 但文件无效不再是坑。\n  edge    edge-tts（在线微软，本环境常见可用；429/网络问题时换引擎或稍后重试）。\n  gtts    gTTS（在线谷歌，需 pip install gtts；有 429 限流风险，失败频繁换前两者）。\n\n输出统一归一化 44.1kHz 单声道 WAV，接口为 --text/--output，可直接作 --tts-cmd。\n\"\"\"\nimport argparse, glob, os, shutil, subprocess, sys, wave\n\n\ndef sh(cmd):\n    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True,\n                          env=dict(os.environ))\n\n\ndef valid_wav(path):\n    try:\n        with wave.open(path, \"rb\") as w:\n            return w.getnframes() > 100\n    except Exception:\n        return False\n\n\ndef normalize(src, out):\n    \"\"\"任意可读音频 → 44.1kHz 单声道 pcm_s16le WAV。\"\"\"\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", src,\n            \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", out])\n    return r.returncode == 0 and valid_wav(out)\n\n\ndef piper_model():\n    m = os.environ.get(\"PIPER_MODEL\", \"\")\n    if m and os.path.exists(m):\n        return m\n    for base in (os.path.expanduser(\"~/.local/share/piper\"), \"/opt/piper/voices\"):\n        hits = sorted(glob.glob(os.path.join(base, \"**\", \"*.onnx\"), recursive=True))\n        if hits:\n            return hits[0]\n    return \"\"\n\n\ndef try_piper(text, out):\n    exe = shutil.which(\"piper\")\n    if not exe:\n        return False, \"piper 未安装\"\n    model = piper_model()\n    if not model:\n        return False, \"piper 无音色模型（设 PIPER_MODEL 或放 ~/.local/share/piper/*.onnx）\"\n    tmp = out + \".piper_tmp\"\n    r = subprocess.run([exe, \"-m\", model, \"--output-raw\"], input=text.encode(\"utf-8\"),\n                       stdout=open(tmp, \"wb\"), stderr=subprocess.PIPE,\n                       env=dict(os.environ))\n    if r.returncode != 0 or not os.path.exists(tmp):\n        return False, f\"piper 运行失败: {(r.stderr or b'').decode(errors='replace')[-200:]}\"\n    # 裸 s16le raw（22050Hz 单声道）补 WAV 头\n    headered = out + \".piper_raw.wav\"\n    with wave.open(headered, \"wb\") as w:\n        w.setnchannels(1)\n        w.setsampwidth(2)\n        w.setframerate(int(os.environ.get(\"PIPER_RATE\", \"22050\")))\n        with open(tmp, \"rb\") as f:\n            w.writeframes(f.read())\n    os.remove(tmp)\n    ok = normalize(headered, out)\n    if os.path.exists(headered):\n        os.remove(headered)\n    return (ok, \"\" if ok else \"piper 输出转码失败\")\n\n\ndef try_edge(text, out, voice):\n    exe = shutil.which(\"edge-tts\")\n    cmd = [exe] if exe else [sys.executable, \"-m\", \"edge_tts\"]\n    if not exe:\n        try:\n            import edge_tts  # noqa: F401\n        except ImportError:\n            return False, \"edge-tts 未安装\"\n    mp3 = out + \".mp3\"\n    r = sh(cmd + [\"--voice\", voice, \"--text\", text, \"--write-media\", mp3])\n    if r.returncode != 0 or not os.path.exists(mp3) or os.path.getsize(mp3) < 200:\n        err = (r.stderr or r.stdout or \"\").strip().splitlines()\n        err = err[-1][:200] if err else f\"exit={r.returncode}\"\n        return False, f\"edge-tts 失败: {err}（429/网络问题时稍后重试或换引擎）\"\n    ok = normalize(mp3, out)\n    if os.path.exists(mp3):\n        os.remove(mp3)\n    return (ok, \"\" if ok else \"edge-tts 输出转码失败\")\n\n\ndef try_gtts(text, out):\n    try:\n        from gtts import gTTS\n    except ImportError:\n        return False, \"gTTS 未安装（pip install gtts）；注意 gTTS 有 429 限流风险，优先 piper/edge\"\n    mp3 = out + \".mp3\"\n    try:\n        gTTS(text, lang=\"zh\").save(mp3)\n    except Exception as e:\n        return False, f\"gTTS 失败: {str(e)[:200]}（429 限流常见，换 piper/edge 引擎）\"\n    ok = normalize(mp3, out)\n    if os.path.exists(mp3):\n        os.remove(mp3)\n    return (ok, \"\" if ok else \"gTTS 输出转码失败\")\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--text\", required=True)\n    ap.add_argument(\"--output\", required=True)\n    ap.add_argument(\"--engine\", default=\"auto\", choices=[\"auto\", \"piper\", \"edge\", \"gtts\"])\n    ap.add_argument(\"--voice\", default=\"zh-CN-XiaoxiaoNeural\")\n    args = ap.parse_args()\n\n    chain = [args.engine] if args.engine != \"auto\" else [\"piper\", \"edge\", \"gtts\"]\n    reasons = []\n    for eng in chain:\n        if eng == \"piper\":\n            ok, why = try_piper(args.text, args.output)\n        elif eng == \"edge\":\n            ok, why = try_edge(args.text, args.output, args.voice)\n        else:\n            ok, why = try_gtts(args.text, args.output)\n        if ok:\n            print(f\"tts_cmd: engine={eng} -> {args.output}\")\n            sys.exit(0)\n        reasons.append(f\"[{eng}] {why}\")\n        sys.stderr.write(f\"tts_cmd: engine {eng} 不可用: {why}\\n\")\n    print(f\"tts_cmd: 全部引擎失败（{' | '.join(reasons)}）\", file=sys.stderr)\n    sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/tts_cmd.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 17928167