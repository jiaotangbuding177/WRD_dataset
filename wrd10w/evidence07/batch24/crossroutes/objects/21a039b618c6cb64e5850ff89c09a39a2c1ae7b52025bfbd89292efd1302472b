{"type": "message", "id": "164a3d19-3e2b-4a3b-b792-eaac27b3a31a", "parentId": "2700a612-86e2-4266-b377-62e0a8fe7877", "timestamp": "2026-10-23T13:06:22.322Z", "message": {"role": "toolResult", "toolCallId": "callaabfcf6f7a5840b196c8cc315074267a", "toolName": "exec", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"逐句TTS一页解说词，拼接成页音频并产出逐句时间轴（供字幕同步）。\n\n用法:\n  python tts_page.py --id p01 --audio-dir OUT/audio \\\n      --text \"第一句。第二句。第三句。\" [--tts-cmd \"python3 /opt/eval-adapter/ecnu_tools.py speech\"]\n\n产出:\n  {audio-dir}/{id}.wav           本页完整旁白音频（44.1kHz 单声道 pcm_s16le）\n  {audio-dir}/{id}.timings.json  [{\"text\":..., \"start\":..., \"end\":...}, ...] 秒，页内相对时间\n\n行为:\n- 按中英文句号/问叹号/分号/换行切句，过短碎句并入下一句；句间插入 0.3s 静音。\n- 逐句合成：某句失败只重试该句（--retries 次），已生成句子直接复用（断点续传）。\n- 全部句子失败退出码 3（stderr 前缀 tts_error:），部分成功不写页输出。\n\"\"\"\nimport argparse, json, os, re, subprocess, sys\n\nGAP_SEC = 0.3\n\n\ndef sh(cmd, **kw):\n    return subprocess.run(cmd, capture_output=True, text=True, **kw)\n\n\ndef wav_duration(path):\n    r = sh([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n            \"-of\", \"default=noprint_wrappers=1:nokey=1\", path])\n    try:\n        return float(r.stdout.strip())\n    except (ValueError, TypeError):\n        return 0.0\n\n\ndef split_sentences(text, min_chars=10):\n    parts = re.split(r\"(?<=[。！？；!?;])|\\n+\", text.strip())\n    parts = [p.strip() for p in parts if p and p.strip()]\n    merged = []\n    for p in parts:\n        if merged and (len(merged[-1]) < min_chars or len(p) < min_chars):\n            merged[-1] += p\n        else:\n            merged.append(p)\n    return merged\n\n\ndef synth_sentence(text, wav_path, tts_cmd, retries):\n    \"\"\"合成一句并归一化到统一格式；返回 True/False。\"\"\"\n    last_err = \"\"\n    for attempt in range(retries):\n        raw = wav_path + \".raw\"\n        r = sh(tts_cmd.split() + [\"--text\", text, \"--output\", raw])\n        if r.returncode == 0 and os.path.exists(raw) and wav_duration(raw) > 0.1:\n            n = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", raw,\n                    \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", wav_path])\n            if os.path.exists(raw):\n                os.remove(raw)\n            if n.returncode == 0 and wav_duration(wav_path) > 0.1:\n                return True\n        else:\n            last_err = (r.stderr or r.stdout or \"\").strip().splitlines()\n            last_err = last_err[-1][:200] if last_err else f\"exit={r.returncode}\"\n        if os.path.exists(raw):\n            os.remove(raw)\n        sys.stderr.write(f\"tts retry {attempt + 1}/{retries} failed ({last_err}): {text[:20]}...\\n\")\n    return False\n\n\ndef make_silence(path):\n    sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"lavfi\",\n        \"-i\", f\"anullsrc=r=44100:cl=mono\", \"-t\", str(GAP_SEC),\n        \"-c:a\", \"pcm_s16le\", path])\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--id\", required=True)\n    ap.add_argument(\"--audio-dir\", required=True)\n    ap.add_argument(\"--text\", required=True)\n    ap.add_argument(\"--tts-cmd\", default=\"python3 /opt/eval-adapter/ecnu_tools.py speech\")\n    ap.add_argument(\"--retries\", type=int, default=3)\n    args = ap.parse_args()\n\n    os.makedirs(args.audio_dir, exist_ok=True)\n    sents = split_sentences(args.text)\n    if not sents:\n        print(\"tts_error: empty narration text\", file=sys.stderr)\n        sys.exit(3)\n\n    # 句子音频持久化在 audio_dir 下，重跑时已有句子直接复用（断点续传）\n    tmpdir = os.path.join(args.audio_dir, f\"sents_{args.id}\")\n    os.makedirs(tmpdir, exist_ok=True)\n    silence = os.path.join(tmpdir, \"gap.wav\")\n    make_silence(silence)\n\n    pieces, timings, t = [], [], 0.0\n    for i, s in enumerate(sents):\n        wav = os.path.join(tmpdir, f\"sent_{i:03d}.wav\")\n        if not (os.path.exists(wav) and wav_duration(wav) > 0.1):\n            if not synth_sentence(s, wav, args.tts_cmd, args.retr