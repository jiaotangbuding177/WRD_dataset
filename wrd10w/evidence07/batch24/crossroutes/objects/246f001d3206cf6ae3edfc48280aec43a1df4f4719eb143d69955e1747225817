#!/usr/bin/env python3
"""Compose a self-contained teaching demo HTML page from a page spec.

Fills templates/teaching_page.template.html with the spec topic, section plan
and interaction list, producing one single-file HTML document that opens
directly in a browser with no backend and no external css/js.

Public usage:
    python {SKILL}/scripts/build_teaching_page.py {INPUT}/page_spec.json --out {OUT}/teaching.html

Input: page-spec JSON {"topic","request_text","source_id","source_message_id","interactions","sections"}
Output: one self-contained HTML file (UTF-8).
Errors: exit 2 with a single-line "build_teaching_page_error: ..." diagnostic on stderr.
"""
from __future__ import annotations

import argparse
import html
import json
import sys
from pathlib import Path

TEMPLATE_PATH = Path(__file__).resolve().parent.parent / "templates" / "teaching_page.template.html"
SECTION_KINDS = {"demo", "cards", "table", "timeline", "quiz", "text"}
SECTION_TITLES = {
    "demo": "互动演示",
    "cards": "知识卡片",
    "table": "数据对比",
    "timeline": "探索里程碑",
    "quiz": "课堂小测验",
    "text": "知识讲解",
}


class BuildError(Exception):
    pass


def esc(value):
    return html.escape(str(value), quote=True)


def scaffold(message):
    return f"<div class=\"stage\">{esc(message)}</div>"


def render_demo(index, section):
    parts = ["<div class=\"stage\">演示画布挂载区：按主题在此区域挂载具体动画脚本</div>"]
    body = section.get("body")
    if isinstance(body, str) and body:
        parts.append(f"<p>{esc(body)}</p>")
    controls = section.get("controls")
    if isinstance(controls, list) and controls:
        badges = "".join(f"<span>{esc(item)}</span>" for item in controls)
        parts.append(f"<div class=\"badges\">{badges}</div>")
    return "\n".join(parts)


def render_text(index, section):
    return f"<p>{esc(section.get('body', ''))}</p>"


def render_cards(index, section):
    items = section.get("items")
    if items is None:
        return scaffold("卡片数据待填充：在规格的 items 列表补齐 name/desc/facts 后重跑")
    if not isinstance(items, list):
        raise BuildError(f"section {index} of kind cards needs an items list")
    cards = []
    for item in items:
        if not isinstance(item, dict):
            raise BuildError(f"section {index} card item must be an object")
        facts = item.get("facts")
        facts_html = f"<p class=\"facts\">{esc(facts)}</p>" if isinstance(facts, str) and facts else ""
        cards.append(
            "<div class=\"card\"><h3>" + esc(item.get("name", "")) + "</h3><p>"
            + esc(item.get("desc", "")) + "</p>" + facts_html + "</div>"
        )
    return "<div class=\"grid\">\n" + "\n".join(cards) + "\n</div>"


def render_table(index, section):
    headers = section.get("headers")
    rows = section.get("rows")
    if headers is None and rows is None:
        return scaffold("表格数据待填充：在规格补齐 headers 与 rows 后重跑")
    if not isinstance(headers, list) or not isinstance(rows, list):
        raise BuildError(f"section {index} of kind table needs headers and rows lists")
    head = "".join(f"<th>{esc(cell)}</th>" for cell in headers)
    body = "\n".join(
        "<tr>" + "".join(f"<td>{esc(cell)}</td>" for cell in row) + "</tr>"
        for row in rows
        if isinstance(row, list)
    )
    return f"<table><thead><tr>{head}</tr></thead><tbody>\n{body}\n</tbody></table>"


def render_timeline(index, section):
    items = section.get("items")
    if items is None:
        return scaffold("时间线数据待填充：在规格的 items 列表补齐 year/event 后重跑")
    if not isinstance(items, list):
        raise BuildError(f"section {index} of kind timeline needs an items list")
    lines = [
        "<li><strong>" + esc(item.get("year", "")) + "</strong> " + esc(item.get("event", "")) + "</li>"
        for item in items
        if isinstance(item, dict)
    ]
    return "<ul class=\"timeline\">\n" + "\n".join(lines) + "\n</ul>"


def render_quiz(index, section):
    questions = section.get("questions")
    if questions is None:
        return scaffold("测验数据待填充：在规格的 questions 列表补齐题目与答案索引后重跑")
    if not isinstance(questions, list):
        raise BuildError(f"section {index} of kind quiz needs a questions list")
    blocks = []
    for number, question in enumerate(questions, start=1):
        if not isinstance(question, dict):
            raise BuildError(f"section {index} question {number} must be an object")
        options = question.get("options")
        answer = question.get("answer")
        if not isinstance(options, list) or not options:
            raise BuildError(f"section {index} question {number} needs a non-empty options list")
        if not isinstance(answer, int) or not 0 <= answer < len(options):
            raise BuildError(f"section {index} question {number} has an invalid answer index")
        buttons = "\n".join(
            f"<button type=\"button\" data-correct=\"{'1' if position == answer else '0'}\">{esc(option)}</button>"
            for position, option in enumerate(options)
        )
        blocks.append(
            "<div class=\"question\"><p>" + f"{number}. " + esc(question.get("question", ""))
            + "</p><div class=\"options\">\n" + buttons + "\n</div></div>"
        )
    return "\n".join(blocks)


RENDERERS = {
    "demo": render_demo,
    "text": render_text,
    "cards": render_cards,
    "table": render_table,
    "timeline": render_timeline,
    "quiz": render_quiz,
}


def render_sections(sections):
    rendered = []
    navs = []
    for index, section in enumerate(sections):
        if not isinstance(section, dict):
            raise BuildError(f"section {index} must be an object")
        kind = section.get("kind")
        if not isinstance(kind, str) or not kind:
            raise BuildError(f"section {index} missing required field: kind")
        if kind not in SECTION_KINDS:
            raise BuildError(f"unknown section kind: {kind}")
        title = section.get("title") if isinstance(section.get("title"), str) and section.get("title") else SECTION_TITLES[kind]
        body = RENDERERS[kind](index, section)
        rendered.append(f"<section id=\"sec-{index}\"><h2>{esc(title)}</h2>\n{body}\n</section>")
        navs.append(f"<a href=\"#sec-{index}\">{esc(title)}</a>")
    return "\n".join(navs), "\n".join(rendered)


def main():
    parser = argparse.ArgumentParser(description="Compose a self-contained teaching demo HTML page.")
    parser.add_argument("spec", help="page-spec JSON file to read")
    parser.add_argument("--out", required=True, help="path of the HTML file to write")
    args = parser.parse_args()
    try:
        try:
            raw = open(args.spec, "rb").read()
        except OSError as error:
            raise BuildError(f"cannot read spec file: {error}")
        try:
            spec = json.loads(raw.decode("utf-8-sig"))
        except (UnicodeError, json.JSONDecodeError) as error:
            raise BuildError(f"invalid JSON in page spec: {error}")
        if not isinstance(spec, dict):
            raise BuildError("page spec must be a JSON object")
        for field in ("topic", "interactions", "sections"):
            if field not in spec:
                raise BuildError(f"missing required field: {field}")
        if not isinstance(spec["topic"], str):
            raise BuildError("missing required field: topic")
        if not isinstance(spec["interactions"], list):
            raise BuildError("interactions must be a list")
        if not isinstance(spec["sections"], list):
            raise BuildError("sections must be a list")
        if not TEMPLATE_PATH.is_file():
            raise BuildError(f"template not found next to the skill scripts: {TEMPLATE_PATH}")
        template = TEMPLATE_PATH.read_text(encoding="utf-8")
        nav_items, sections_html = render_sections(spec["sections"])
        subtitle = spec.get("request_text", "") if isinstance(spec.get("request_text", ""), str) else ""
        page = (
            template.replace("{{TITLE}}", esc(spec["topic"]))
            .replace("{{SUBTITLE}}", esc(subtitle))
            .replace("{{NAV_ITEMS}}", nav_items)
            .replace("{{SECTIONS}}", sections_html)
        )
        try:
            with open(args.out, "w", encoding="utf-8") as handle:
                handle.write(page)
        except OSError as error:
            raise BuildError(f"cannot write output file: {error}")
    except BuildError as error:
        print(f"build_teaching_page_error: {error}", file=sys.stderr)
        return 2
    print(f"wrote {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
