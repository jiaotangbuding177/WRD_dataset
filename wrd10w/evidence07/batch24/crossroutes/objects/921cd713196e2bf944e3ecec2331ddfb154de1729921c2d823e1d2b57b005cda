{"type": "message", "id": "896fa4d6-ceb8-4c93-b969-b9be111471d9", "parentId": "caddacc2-5555-4d5d-b8f3-9cd20975c1a9", "timestamp": "2026-10-24T08:18:33.743Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在我来处理可复用的事实检查脚本（用于替代临时内联 python 命令的可靠解决方案）。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-ff795bf28e7c40afbbc54353\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call7ba9e0f11b664a95a6b4dd117e6fdd0f", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"关键事实比对：核对关键事实原文是否保留在成品文档中（替代临时 python -c 内联脚本）。\n\n用法（原样可执行）:\n  python3 factcheck.py 成品.docx|txt|md [--source 原材料.md|txt|docx] --term 事实1 --term 事实2 [--terms-file terms.json] [--out report.json]\n\n行为:\n- 成品/原材料提取纯文本：.docx 解 zip 取 word/document.xml 的全部 w:t（含表格）；\n  .txt/.md 直读；.pdf 需系统 pdftotext。\n- 匹配前去掉全部空白字符（避免换行/空格/跨 run 造成漏判）。\n- 关键事实来自 --term（可重复）与 --terms-file（JSON：字符串数组或 {\"terms\":[...]}）。\n- 给 --source 时同时核对原材料：成品缺失而原材料也没有 → 多半是笔误；\n  原材料有而成品缺失 → 整理时漏搬，须补上。\n- --out 给出时写 JSON 报告（逐条 in_final/in_source）。\n退出码: 0 全部在位; 2 用法/读取错误; 4 有关键事实缺失（缺失清单见 stdout 与报告）。\n\"\"\"\nimport argparse\nimport html\nimport json\nimport re\nimport subprocess\nimport sys\nimport zipfile\n\n\ndef extract_text(path):\n    ext = path.lower().rsplit(\".\", 1)[-1]\n    if ext == \"docx\":\n        with zipfile.ZipFile(path) as z:\n            xml = z.read(\"word/document.xml\").decode(\"utf-8\")\n        return html.unescape(\"\".join(re.findall(r\"<w:t(?:\\s[^>]*)?>(.*?)</w:t>\", xml, re.S)))\n    if ext == \"pdf\":\n        r = subprocess.run([\"pdftotext\", path, \"-\"], capture_output=True, text=True)\n        if r.returncode != 0:\n            raise ValueError(f\"pdftotext 失败: {r.stderr.strip()[:200]}\")\n        return r.stdout\n    if ext in (\"txt\", \"md\"):\n        with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            return f.read()\n    raise ValueError(f\"不支持的类型 .{ext}（支持 docx/txt/md/pdf）\")\n\n\ndef norm(text):\n    return re.sub(r\"\\s+\", \"\", text)\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"关键事实保留比对\")\n    ap.add_argument(\"final\", help=\"成品文件（docx/txt/md/pdf）\")\n    ap.add_argument(\"--source\", help=\"可选：原材料文件，用于区分漏搬与笔误\")\n    ap.add_argument(\"--term\", action=\"append\", default=[], help=\"关键事实原文子串，可重复\")\n    ap.add_argument(\"--terms-file\", help=\"JSON 文件：字符串数组或 {\\\"terms\\\":[...]}\")\n    ap.add_argument(\"--out\", help=\"可选：JSON 报告输出路径\")\n    args = ap.parse_args()\n\n    terms = list(args.term)\n    if args.terms_file:\n        with open(args.terms_file, \"r\", encoding=\"utf-8\") as f:\n            data = json.load(f)\n        items = data.get(\"terms\", []) if isinstance(data, dict) else data\n        if not isinstance(items, list) or not all(isinstance(t, str) for t in items):\n            print(\"factcheck: ERROR --terms-file 须是字符串数组或 {\\\"terms\\\":[...]}\", file=sys.stderr)\n            return 2\n        terms.extend(items)\n    terms = [t for t in (t.strip() for t in terms) if t]\n    if not terms:\n        print(\"factcheck: ERROR 未给出任何 --term/--terms-file\", file=sys.stderr)\n        return 2\n\n    try:\n        final_text = norm(extract_text(args.final))\n        source_text = norm(extract_text(args.source)) if args.source else None\n    except (OSError, ValueError, zipfile.BadZipFile, KeyError) as e:\n        print(f\"factcheck: ERROR {e}\", file=sys.stderr)\n        return 2\n\n    results = []\n    missing = []\n    for t in terms:\n        key = norm(t)\n        in_final = key in final_text\n        in_source = (key in source_text) if source_text is not None else None\n        results.append({\"term\": t, \"in_final\": in_final, \"in_source\": in_source})\n        if not in_final:\n            missing.append(t)\n            hint = \"（原材料也没有，疑似 --term 笔误）\" if in_source is False else \"（原材料有，成品漏搬，须补上）\" if in_source else \"\"\n            print(f\"[MISS] {t}{hint}\")\n        else:\n            print(f\"[OK]   {t}\")\n\n    report = {\