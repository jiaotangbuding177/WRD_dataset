#!/usr/bin/env python3
"""静态介绍图 + 逐页旁白音频 → 解说视频（推拉平移镜头、淡入淡出、同步字幕，16:9 MP4）。

用法:
  python make_video.py PAGES_JSON --images IMAGES_DIR --audio AUDIO_DIR --out OUT.mp4 [选项]

PAGES_JSON 格式:
  {
    "title": "可选，视频标题",
    "pages": [
      {"id": "p01", "title": "封面", "image": "slide_001.png",
       "narration": "旁白文本。按句合成。", "motion": "zoom_in"}
    ]
  }
  image 相对 --images 目录解析，也可是绝对路径；motion 可选
  zoom_in|zoom_out|pan_left|pan_right|pan_up|still，缺省按页序轮换。

主要选项:
  --auto-tts      缺页音频时自动调用 tts_page.py 逐句合成（默认只报错列出缺页）
  --only p01,p02  只构建指定页（先做样片/重做点名页），输出为这几页的成片
  --force         忽略已存在的页分段缓存，全部重做
  --no-subtitles  不烧录字幕
  --width/--height/--fps  默认 1920x1080 30fps；--tail 默认 0.6s 页尾余量
  --font          字幕字体名，默认 Noto Sans CJK SC
  --tmpdir        分段与字幕工作目录，默认 OUT 同目录 .video_tmp

退出码: 2 = 输入/缺素材错误（stderr 前缀 video_error:）。
每页分段缓存在 --tmpdir/segs/{id}.mp4，已存在则跳过（改了对应素材请 --force 或删除该段）。
"""
import argparse, json, os, shlex, subprocess, sys


def sh(cmd):
    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True)


def media_duration(path):
    r = sh(["ffprobe", "-v", "error", "-show_entries", "format=duration",
            "-of", "default=noprint_wrappers=1:nokey=1", path])
    try:
        return float(r.stdout.strip())
    except (ValueError, TypeError):
        return 0.0


def ass_time(sec):
    h = int(sec // 3600)
    m = int(sec % 3600 // 60)
    s = sec % 60
    return f"{h}:{m:02d}:{s:05.2f}"


def write_ass(path, timings, font, W, H):
    lines = [
        "[Script Info]", "ScriptType: v4.00+", f"PlayResX: {W}", f"PlayResY: {H}",
        "WrapStyle: 0", "", "[V4+ Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, OutlineColour, BackColour, Bold, Outline, Shadow, Alignment, MarginL, MarginR, MarginV",
        f"Style: Sub,{font},44,&H00FFFFFF,&H00101010,&H7F000000,0,3,1,2,110,110,52",
        "", "[Events]", "Format: Layer, Start, End, Style, Text",
    ]
    for t in timings:
        text = t["text"].replace("\n", " ")
        lines.append(f"Dialogue: 0,{ass_time(t['start'])},{ass_time(t['end'])},Sub,{text}")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


def zoompan_expr(motion, frames):
    F = max(frames, 1)
    if motion == "zoom_in":
        return f"zoompan=z='1+0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'"
    if motion == "zoom_out":
        return f"zoompan=z='1.10-0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'"
    if motion == "pan_right":
        return f"zoompan=z='1.08':x='(iw-iw/zoom)*on/{F}':y='(ih-ih/zoom)/2'"
    if motion == "pan_left":
        return f"zoompan=z='1.08':x='(iw-iw/zoom)*(1-on/{F})':y='(ih-ih/zoom)/2'"
    if motion == "pan_up":
        return f"zoompan=z='1.08':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)*(1-on/{F})'"
    return "zoompan=z='1.001':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'"  # still


def build_page(page, idx, a):
    """构建单页分段 mp4，返回分段路径。"""
    pid = page["id"]
    seg = os.path.join(a.segs, f"{pid}.mp4")
    if os.path.exists(seg) and not a.force:
        print(f"[skip] {pid} 分段已存在: {seg}")
        return seg
    audio = os.path.join(a.audio, f"{pid}.wav")
    timings_path = os.path.join(a.audio, f"{pid}.timings.json")
    if not os.path.exists(audio):
        print(f"video_error: 缺页音频 {audio}（先跑 tts_page.py 或加 --auto-tts）", file=sys.stderr)
        sys.exit(2)

    adur = media_duration(audio)
    if adur <= 0:
        print(f"video_error: 音频无效 {audio}", file=sys.stderr)
        sys.exit(2)
    D = adur + a.tail
    frames = max(int(round(D * a.fps)), 2)

    img = page["image"]
    if not os.path.isabs(img):
        img = os.path.join(a.images, img)
    if not os.path.exists(img):
        print(f"video_error: 缺图片 {img}", file=sys.stderr)
        sys.exit(2)

    motion = page.get("motion") or ["zoom_in", "pan_right", "zoom_out", "pan_left"][idx % 4]
    SW, SH = int(a.width * 1.15) // 2 * 2, int(a.height * 1.15) // 2 * 2
    fade_out = min(0.5, D / 3)
    vf = (
        f"scale={SW}:{SH}:force_original_aspect_ratio=increase,crop={SW}:{SH},"
        f"{zoompan_expr(motion, frames)}:d={frames}:s={a.width}x{a.height}:fps={a.fps},"
        f"format=yuv420p,fade=t=in:st=0:d=0.4,fade=t=out:st={D - fade_out:.3f}:d={fade_out:.3f}"
    )
    if not a.no_subtitles and os.path.exists(timings_path):
        ass = os.path.join(a.assdir, f"{pid}.ass")
        with open(timings_path, encoding="utf-8") as f:
            write_ass(ass, json.load(f), a.font, a.width, a.height)
        esc = ass.replace("\\", "/").replace(":", "\\:").replace("'", "\\\\\"")
        vf += f",subtitles='{esc}'"
    elif not a.no_subtitles:
        print(f"[warn] {pid} 无 timings.json，跳过本页字幕")

    r = sh(["ffmpeg", "-y", "-v", "error", "-i", img, "-i", audio,
            "-filter_complex", f"[0:v]{vf}[v];[1:a]apad=whole_dur={D:.3f}[a]",
            "-map", "[v]", "-map", "[a]", "-t", f"{D:.3f}",
            "-c:v", "libx264", "-preset", "veryfast", "-crf", "20",
            "-c:a", "aac", "-b:a", "160k", "-pix_fmt", "yuv420p", seg])
    if r.returncode != 0:
        print(f"video_error: 页 {pid} 合成失败: {r.stderr[-400:]}", file=sys.stderr)
        sys.exit(2)
    print(f"[ok] {pid} {D:.1f}s motion={motion} -> {seg}")
    return seg


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("pages_json")
    ap.add_argument("--images", required=True)
    ap.add_argument("--audio", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--width", type=int, default=1920)
    ap.add_argument("--height", type=int, default=1080)
    ap.add_argument("--fps", type=int, default=30)
    ap.add_argument("--tail", type=float, default=0.6)
    ap.add_argument("--auto-tts", action="store_true")
    ap.add_argument("--only", default="")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--no-subtitles", action="store_true")
    ap.add_argument("--font", default="Noto Sans CJK SC")
    ap.add_argument("--tts-cmd", default="python3 /opt/eval-adapter/ecnu_tools.py speech")
    ap.add_argument("--tmpdir", default="")
    a = ap.parse_args()

    with open(a.pages_json, encoding="utf-8") as f:
        plan = json.load(f)
    pages = plan.get("pages") or []
    if not pages:
        print("video_error: pages 为空", file=sys.stderr)
        sys.exit(2)
    if a.only:
        want = [x.strip() for x in a.only.split(",") if x.strip()]
        order = {p["id"]: i for i, p in enumerate(pages)}
        missing = [w for w in want if w not in order]
        if missing:
            print(f"video_error: --only 中不存在的页: {missing}", file=sys.stderr)
            sys.exit(2)
        pages = sorted((p for p in pages if p["id"] in want),
                       key=lambda p: order[p["id"]])

    out_dir = os.path.dirname(os.path.abspath(a.out))
    os.makedirs(out_dir, exist_ok=True)
    tmpdir = a.tmpdir or os.path.join(out_dir, ".video_tmp")
    a.segs = os.path.join(tmpdir, "segs")
    a.assdir = os.path.join(tmpdir, "ass")
    os.makedirs(a.segs, exist_ok=True)
    os.makedirs(a.assdir, exist_ok=True)

    if a.auto_tts:
        here = os.path.dirname(os.path.abspath(__file__))
        for p in pages:
            if not os.path.exists(os.path.join(a.audio, f"{p['id']}.wav")):
                r = sh([sys.executable, os.path.join(here, "tts_page.py"),
                        "--id", p["id"], "--audio-dir", a.audio,
                        "--text", p["narration"], "--tts-cmd", a.tts_cmd])
                print(r.stdout.strip())
                if r.returncode != 0:
                    sys.stderr.write(r.stderr)
                    print(f"video_error: {p['id']} TTS 失败", file=sys.stderr)
                    sys.exit(2)
    else:
        lack = [p["id"] for p in pages
                if not os.path.exists(os.path.join(a.audio, f"{p['id']}.wav"))]
        if lack:
            print(f"video_error: 缺页音频: {lack}（--auto-tts 可自动合成）", file=sys.stderr)
            sys.exit(2)

    segs = [build_page(p, i, a) for i, p in enumerate(pages)]

    concat = os.path.join(tmpdir, "concat.txt")
    with open(concat, "w", encoding="utf-8") as f:
        for s in segs:
            f.write(f"file '{os.path.abspath(s)}'\n")
    r = sh(["ffmpeg", "-y", "-v", "error", "-f", "concat", "-safe", "0",
            "-i", concat, "-c", "copy", "-movflags", "+faststart", a.out])
    if r.returncode != 0:
        print(f"video_error: 拼接失败: {r.stderr[-300:]}", file=sys.stderr)
        sys.exit(2)
    total = media_duration(a.out)
    print(json.dumps({"out": a.out, "pages": len(pages),
                      "duration_sec": round(total, 2),
                      "resolution": f"{a.width}x{a.height}", "fps": a.fps},
                     ensure_ascii=False))


if __name__ == "__main__":
    main()
