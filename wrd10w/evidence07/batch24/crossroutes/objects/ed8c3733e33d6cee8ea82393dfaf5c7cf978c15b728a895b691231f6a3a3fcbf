oves\", [])\n    if moves:\n        move_section = \"\\n\".join(\"- \" + m[\"from\"] + \" → \" + m[\"to\"] for m in moves)\n    else:\n        move_section = \"无移动。\"\n    summary = plan.get(\"summary\", {})\n    return (template\n            .replace(\"{{KB_NAME}}\", plan.get(\"kb_name\", \"kb\"))\n            .replace(\"{{TOTAL_FILES}}\", str(summary.get(\"total_files\", 0)))\n            .replace(\"{{TOTAL_BYTES}}\", str(summary.get(\"total_bytes\", 0)))\n            .replace(\"{{CATEGORY_TABLE}}\", category_table)\n            .replace(\"{{DUPLICATE_SECTION}}\", duplicate_section)\n            .replace(\"{{MOVE_SECTION}}\", move_section))\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(description=\"用整理计划与模板生成知识库整理报告Markdown\")\n    parser.add_argument(\"plan\", help=\"整理计划JSON路径（kb_organize.py 产出）\")\n    parser.add_argument(\"--template\", required=True, help=\"报告模板MD路径\")\n    parser.add_argument(\"--out\", required=True, help=\"输出报告MD路径\")\n    args = parser.parse_args()\n    if not os.path.isfile(args.plan):\n        return fail(\"plan file not found: \" + args.plan)\n    try:\n        with open(args.plan, encoding=\"utf-8-sig\") as fh:\n            plan = json.load(fh)\n    except (OSError, ValueError) as error:\n        return fail(\"plan is not valid JSON: \" + str(error))\n    if not isinstance(plan, dict) or plan.get(\"schema\") != SCHEMA:\n        return fail(\"plan schema mismatch (expected \" + SCHEMA + \")\")\n    if not os.path.isfile(args.template):\n        return fail(\"template file not found: \" + args.template)\n    try:\n        with open(args.template, encoding=\"utf-8-sig\") as fh:\n            template = fh.read()\n    except OSError as error:\n        return fail(\"cannot read template: \" + str(error))\n    report = render(plan, template)\n    try:\n        with open(args.out, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(report)\n    except OSError as error:\n        return fail(\"cannot write output: \" + str(error))\n    print(\"report written: \" + args.out)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "path": "/workspace/outputs/candidate/skill/scripts/kb_report.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792599493396, "responseId": "chatcmpl-1792599493435", "__openclaw": {"runId": "508f609e-ae47-4b7b-bc44-4b9f6f066a6f"}}}
