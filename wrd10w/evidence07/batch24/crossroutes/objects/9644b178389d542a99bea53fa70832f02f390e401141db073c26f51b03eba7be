('source_id', 'message_id'))\n            if not text(ref.get('source_id')) or not text(ref.get('message_id')):\n                add('resource_source_reference_fields_missing', pos)\n    catalog = seq(replay.get('fixtures', []), 'fixtures')\n    catalog_keys = set()\n    for i, f in enumerate(catalog):\n        pos = 'fixtures/' + str(i)\n        f = obj(f, pos)\n        source(f, pos)\n        if f.get('origin') == 'generated_fixture':\n            obj(f, pos, _REQUIRED['generated_fixture'])\n            relative(f.get('path'), pos + '/path')\n            if f.get('generated') is not True or f.get('purpose') not in _PURPOSES or (not text(f.get('derivation'))):\n                add('generated_fixture_derivation_or_purpose_missing', pos)\n        p = obj(f.get('pin'), pos + '/pin')\n        key = (str(p.get('path')), str(p.get('sha256')))\n        if key in catalog_keys:\n            add('duplicate_fixture_identity', pos)\n        catalog_keys.add(key)\n\n    def case_check(c, at, composition=False):\n        c = obj(c, at)\n        kind = c.get('kind', 'composition' if composition else None)\n        refs = c.get('inputs', [c.get('fixture_provenance')])\n        for i, ref in enumerate(seq(refs, at + '/inputs', True)):\n            source(ref, at + '/inputs/' + str(i), allow_absent=kind == 'invalid_input')\n            if isinstance(ref, dict) and ref.get('origin') == 'generated_fixture' and isinstance(ref.get('pin'), dict) and ((str(ref['pin'].get('path')), str(ref['pin'].get('sha256'))) not in catalog_keys):\n                add('generated_fixture_not_catalogued', at)\n        commands = seq(c.get('commands', [c.get('argv')]), at + '/commands', True)\n        for i, argv in enumerate(commands):\n            command(argv, at + '/commands/' + str(i))\n        expected = c.get('expected_exit', 0)\n        if type(expected) is not int or (kind != 'invalid_input' and expected != 0):\n            add('invalid_expected_exit', at)\n        if any((isinstance(ref, dict) and ref.get('origin') == 'absent_path' for ref in refs)):\n            if kind != 'invalid_input' or type(expected) is not int or expected == 0:\n                add('absent_input_requires_nonzero_error_exit', at)\n            if not any((isinstance(a, dict) and a.get('kind') in ('contains', 'text_equals', 'json_equals', 'explicit_error') and (a.get('path') in ('$stdout', '$stderr') or a.get('kind') == 'explicit_error') for a in c.get('assertions', []))):\n                add('absent_input_requires_actual_error_content_assertion', at)\n        exits = c.get('expected_exits', [0] * max(0, len(commands) - 1) + [expected])\n        if not isinstance(exits, list) or len(exits) != len(commands) or any((type(x) is not int for x in exits)):\n            add('per_command_exit_contract_invalid', at)\n        if any((isinstance(ref, dict) and ref.get('origin') == 'absent_path' for ref in refs)):\n            if not isinstance(exits, list) or not exits or exits[-1] != expected or (exits[-1] == 0):\n                add('absent_input_final_exit_must_match_nonzero_error_contract', at)\n            for ref in refs:\n                if not isinstance(ref, dict) or ref.get('origin') != 'absent_path':\n                    continue\n                token = '{' + str(ref.get('absent_root')) + '}/' + str(ref.get('absent_relative_path'))\n                if not any((isinstance(arg, str) and (arg == token or arg.endswith('=' + token)) for argv in commands if isinstance(argv, list) for arg in argv[2:])):\n                    add('absent_input_path_must_be_explicitly_supplied', at)\n        outputs = seq(c.get('outputs', []), at + '/outputs')\n        paths = []\n        for i, o in enumerate(outputs):\n            o = obj(o, at + '/outputs/' + str(i), ('path',))\n            relative(o.get('path'), at + '/outputs/' + str(i))\n            paths.append(str(o.get('path')))\n            if type(o.get('min_bytes', 1)) is not int or o.get('min_bytes', 1) < 1:\n                add('output_min_bytes