            return False\n        return True\n\n    def filepin(value, at):\n        value = obj(value, at, _REQUIRED['pin'])\n        path = value.get('path')\n        if not text(path) or not (PurePosixPath(path).is_absolute() or PureWindowsPath(path).is_absolute()):\n            add('pin_path_must_be_absolute', at)\n        if not re.fullmatch('[a-f0-9]{64}', str(value.get('sha256', ''))):\n            add('pin_sha256_invalid', at)\n        if type(value.get('bytes')) is not int or value.get('bytes', -1) < 0:\n            add('pin_bytes_invalid', at)\n\n    def source(ref, at, allow_absent=False):\n        if isinstance(ref, dict) and ref.get('origin') == 'absent_path':\n            if not allow_absent:\n                add('absent_path_only_invalid_input', at)\n            if 'pin' in ref:\n                add('absent_path_must_not_have_fake_file_pin', at)\n            for key in specification()['absent_input']['provenance_required']:\n                if key not in ref:\n                    add('absence_required_field_missing:' + key, at)\n            if not text(ref.get('source_id')):\n                add('source_id_missing', at)\n            if any((not text(x) for x in seq(ref.get('message_ids'), at + '/message_ids', True))):\n                add('message_ids_invalid', at)\n            if not re.fullmatch('[a-f0-9]{64}', str(ref.get('source_record_sha256', ''))):\n                add('source_record_sha256_invalid', at)\n            if ref.get('absent_root') not in ('INPUT', 'FIXTURE'):\n                add('absence_root_must_be_readonly', at)\n            relative(ref.get('absent_relative_path'), at + '/absent_relative_path')\n            listing = obj(ref.get('parent_directory_pin'), at + '/parent_directory_pin', ('kind', 'path', 'entries', 'sha256'))\n            if listing.get('kind') != 'directory_listing':\n                add('absence_directory_listing_kind_invalid', at)\n            lp = listing.get('path')\n            if not text(lp) or not (PurePosixPath(lp).is_absolute() or PureWindowsPath(lp).is_absolute()):\n                add('absence_parent_path_not_absolute', at)\n            entries = seq(listing.get('entries'), at + '/parent_directory_pin/entries')\n            names = []\n            for i, entry in enumerate(entries):\n                ep = at + '/parent_directory_pin/entries/' + str(i)\n                entry = obj(entry, ep, ('name', 'kind'))\n                name = entry.get('name')\n                names.append(name)\n                if not relative(name, ep + '/name') or (isinstance(name, str) and '/' in name):\n                    add('absence_listing_name_invalid', ep)\n                if entry.get('kind') == 'file':\n                    if not re.fullmatch('[a-f0-9]{64}', str(entry.get('sha256', ''))) or type(entry.get('bytes')) is not int or entry.get('bytes', -1) < 0:\n                        add('absence_listing_file_identity_invalid', ep)\n                elif entry.get('kind') != 'directory':\n                    add('absence_listing_entry_kind_invalid', ep)\n            if all((isinstance(n, str) for n in names)) and (names != sorted(names) or len(names) != len(set(names))):\n                add('absence_listing_not_sorted_unique', at)\n            try:\n                digest = hashlib.sha256(json.dumps(entries, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()\n                if listing.get('sha256') != digest:\n                    add('absence_listing_digest_mismatch', at)\n            except (TypeError, ValueError):\n                add('absence_listing_not_canonical_json', at)\n            filepin(ref.get('source_material_pin'), at + '/source_material_pin')\n            if ref.get('generated') is not True or ref.get('purpose') != 'invalid_input' or (not text(ref.get('derivation'))):\n                add('absence_negative_test_declaration_missing', at)\n            return\n        ref = obj(ref, at, _REQUIRED['provenance'])\n        if not text(ref.get('source_id')):\n            add('source_id_missing', at)\n        if any((not text(x) for x in seq(ref.get('message_ids'), at + '/message_ids', True))):\n            add('message_ids_invalid', at)\n        if 'source_record_sha256' in ref and (not re.fullmatch('[a-f0-9]{64}', str(ref['source_record_sha256']))):\n            add('source_record_sha256_invalid', at)\n        if ref.get('origin') not in ('real_source', 'generated_fixture'):\n            add('fixture_origin_invalid', at)\n        filepin(ref.get('pin'), at + '/pin')\n\n    def identity(value, deps, at):\n        value = obj(value, at, _REQUIRED['interface'])\n        if value.get('kind') not in ('program', 'template', 'material', 'config'):\n            add('interface_kind_invalid', at)\n        for key in ('usage', 'contract_version'):\n            if not text(value.get(key)):\n                add('interface_' + key + '_missing', at)\n        for key in ('inputs', 'outputs'):\n            if any((not text(x) for x in seq(value.get(key), at + '/' + key, True))):\n                add('interface_' + key + '_invalid', at)\n        deps = seq(deps, at + '/dependencies')\n        for i, dep in enumerate(deps):\n            dep = obj(dep, at + '/dependencies/' + str(i))\n            if dep.get('kind') == 'runtime':\n                if not text(dep.get('name')) or not text(dep.get('version')) or dep.get('identity_sha256') != _FIXED_IMAGE.split(':')[1]:\n                    add('runtime_dependency_not_fixed_image', at)\n            elif dep.get('kind') == 'resource':\n                if any((not re.fullmatch('[a-f0-9]{64}', str(dep.get(k, ''))) for k in ('resource_id', 'content_sha256'))):\n                    add('resource_dependency_identity_missing', at)\n            else:\n                add('dependency_kind_invalid', at)\n        if value.get('kind') == 'program' and (not any((isinstance(d, dict) and d.get('kind') == 'runtime' for d in deps))):\n            add('program_requires_pinned_runtime_dependency', at)\n    files = set()\n    if not skill.is_dir() or skill.is_symlink():\n        add('skill_directory_missing_or_linked', 'skill')\n    else:\n        for p in skill.rglob('*'):\n            if p.is_symlink():\n                add('package_symlink_forbidden', str(p))\n            elif p.is_file():\n                files.add(p.relative_to(skill).as_posix())\n    docs = ''\n    for name in sorted(files):\n        if any((part.lower() in constants['MAKING_NAMES'] or 'validation_history' in part.lower() or part.lower() == 'reproduction_inputs' for part in Path(name).parts)) or Path(name).suffix.lower() in ('.log', '.pyc'):\n            add('making_record_inside_skill', name)\n        if Path(name).suffix.lower() == '.md':\n            try:\n                docs += '\\n' + (skill / name).read_text(encoding='utf-8-sig')\n            except (OSError, UnicodeError):\n                add('package_document_unreadable', name)\n    if 'SKILL.md' not in files:\n        add('homepage_missing', 'SKILL.md')\n    else:\n        try:\n            home = (skill / 'SKILL.md').read_text(encoding='utf-8-sig')\n            if len(home) > 1500 or len(home.encode('utf-8')) > 4096:\n                add('homepage_not_lightweight', 'SKILL.md')\n            if not home.startswith('---') or not re.search('(?m)^name:', home) or (not re.search('(?m)^description:', home)):\n                add('native_frontmatter_missing', 'SKILL.md')\n        except (OSError, UnicodeError):\n            add('homepage_unreadable', 'SKILL.md')\n\n    def command(value, at):\n        if not isinstance(value, list) or len(value) < 2 or any((not isinstance(x, str) or not x or '\\x00' in x for x in value)):\n            add('argv_must_be_nonempty_strings', at)\n            return None\n        expanded = []\n        for arg in value:\n            if any((s in arg for s in ('://', '$' + '{', '$(', '`'))) or arg in ('-c', '-e', '-m', '--eval', '--command', '&&', ';', '|', '>', '>>', '<'):\n                add('forbidden_inline_network_or_shell_argument', at)\n            actual = arg\n            for token, target in constants['TOKENS'].items():\n                actual = actual.replace('{' + token + '}', target)\n            if re.search('\\\\{[A-Z_]+\\\\}', actual) or re.search('(?:^|[=/])\\\\.\\\\.(?:/|$)', actual):\n                add('unknown_token_or_traversal_in_argv', at)\n            expanded.append(actual)\n        if expanded[0] not in constants['INTERPRETERS']:\n            add('unsupported_interpreter', at)\n            return None\n        if not expanded[1].startswith('/skill/'):\n            add('only_direct_packaged_script_argv', at)\n            return None\n        script = expanded[1][7:]\n        if not relative(script, at) or script not in files or Path(script).suffix.lower() not in constants['INTERPRETERS'][expanded[0]]:\n            add('packaged_script_missing_or_wrong_interpreter', at)\n        return script\n\n    def assertion_checks(values, at):\n        targets = set()\n        categories = []\n        exhaustive = False\n        values = seq(values, at, True)\n        for i, a in enumerate(values):\n            pos = at + '/' + str(i)\n            a = obj(a, pos, ('kind', 'path'))\n            kind = a.get('kind')\n            path = a.get('path')\n            if kind not in ASSERTIONS:\n                add('unsupported_assertion:' + str(kind), pos)\n                continue\n            if path in ('stdout', 'stderr'):\n                add('log_path_requires_dollar_prefix', pos)\n            elif path not in ('$stdout', '$stderr'):\n                relative(path, pos + '/path')\n            if isinstance(path, str):\n                targets.add(path)\n            if 'count_of' in a or 'map_by' in a:\n                add('undeclared_json_selection_semantics', pos)\n            value = a.get('value', a.get('expected'))\n            pointer = a.get('pointer', '')\n            if not isinstance(pointer, str) or (pointer and (not pointer.startswith('/'))):\n                add('invalid_json_pointer', pos)\n            if kind in ('contains', 'not_contains', 'text_equals'):\n                if not text(value) or value.strip().upper() in ('PASS', 'SUCCESS', 'OK', 'TRUE'):\n                    add('vacuous_or_invalid_text_assertion', pos)\n                exhaustive |= kind == 'text_equals'\n            elif kind in ('json_equals', 'source_mapping', 'field_preservation'):\n                if value is None:\n                    add('expected_json_value_missing', pos)\n                categories.append('source_mapping' if kind == 'source_mapping' else 'field_preservation')\n                exhaustive |= pointer == ''\n            elif kind == 'json_count':\n                if type(value) is not int or value < 0:\n                    add('json_count_value_invalid', pos)\n                categories.append('record_count')\n            elif kind == 'json_keys':\n                if not isinstance(value, list) or not value or any((not text(x) for x in value)):\n                    add('json_keys_value_invalid', pos)\n            elif kind == 'explicit_error':\n                categories.append('explicit_error')\n            elif kind == 'sha256':\n                if not re.fullmatch('[a-f0-9]{64}', str(value)):\n                    add('expected_sha256_invalid', pos)\n                exhaustive = True\n            elif kind == 'zip_members':\n                if not isinstance(value, list) or not value:\n                    add('zip_members_must_be_nonempty_list', pos)\n                else:\n                    for member in value:\n                        relative(member, pos + '/value')\n                categories.append('artifact_structure')\n            elif kind == 'zip_xml_contains':\n                relative(a.get('member'), pos + '/member')\n                if not text(value):\n                    add('zip_xml_expected_text_missing', pos)\n                categories.append('artifact_structure