ssage.get(\"id\"), str) or not message[\"id\"]:\n            raise SpecError(\"every message needs a non-empty string id\")\n        body = \"\".join(text_leaves(message.get(\"content\", \"\")))\n        texts.append((message[\"id\"], body))\n    request_id, request_text = \"\", \"\"\n    for mid, body in texts:\n        line = request_line(body)\n        if line:\n            request_id, request_text = mid, line\n            break\n    if not request_text and texts:\n        request_id, request_text = texts[0]\n    topic = extract_topic(clean_request(request_text))\n    corpus = \"\\n\".join(body for _, body in texts)\n    interactions = detect(corpus, INTERACTION_RULES, set())\n    sections = [\n        {\"kind\": kind, \"title\": SECTION_TITLES[kind]}\n        for kind in detect(corpus, SECTION_RULES, set())\n    ]\n    return {\n        \"topic\": topic,\n        \"request_text\": request_text,\n        \"source_id\": session_id,\n        \"source_message_id\": request_id,\n        \"interactions\": interactions,\n        \"sections\": sections,\n    }\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Extract a teaching-page spec from a conversation JSON.\")\n    parser.add_argument(\"source\", help=\"conversation JSON file to read\")\n    parser.add_argument(\"--out\", required=True, help=\"path of the page-spec JSON to write\")\n    args = parser.parse_args()\n    try:\n        try:\n            raw = open(args.source, \"rb\").read()\n        except OSError as error:\n            raise SpecError(f\"cannot read source file: {error}\")\n        try:\n            record = json.loads(raw.decode(\"utf-8-sig\"))\n        except (UnicodeError, json.JSONDecodeError) as error:\n            raise SpecError(f\"invalid JSON in conversation file: {error}\")\n        spec = build_spec(record)\n        payload = json.dumps(spec, ensure_ascii=False, indent=2, sort_keys=True) + \"\\n\"\n        try:\n            with open(args.out, \"w\", encoding=\"utf-8\")