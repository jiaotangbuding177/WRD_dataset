    \"demo\": \"互动演示\",\n    \"cards\": \"知识卡片\",\n    \"table\": \"数据对比\",\n    \"timeline\": \"探索里程碑\",\n    \"quiz\": \"课堂小测验\",\n}\n\n\nclass SpecError(Exception):\n    pass\n\n\ndef text_leaves(value):\n    if isinstance(value, str):\n        yield value\n    elif isinstance(value, list):\n        for item in value:\n            yield from text_leaves(item)\n    elif isinstance(value, dict):\n        for item in value.values():\n            yield from text_leaves(item)\n\n\ndef request_line(text):\n    \"\"\"Return the actual request sentence from a message that may carry setup preamble.\"\"\"\n    lines = [line for line in text.splitlines() if REQUEST_PATTERN.search(line)]\n    return lines[-1] if lines else \"\"\n\n\ndef clean_request(text):\n    cleaned = POLITE_PREFIX.sub(\"\", text.strip())\n    cleaned = REQUEST_VERB.sub(\"\", cleaned, count=1)\n    cleaned = HTML_TOKEN.sub(\"\", cleaned)\n    return cleaned.strip(STRIP_CHARS)\n\n\ndef extract_topic(cleaned):\n    match = SUBJECT_PATTERN.search(cleaned)\n    if match:\n        return match.group(0)\n    return cleaned\n\n\ndef detect(text, rules, seen):\n    found = []\n    for key, words in rules:\n        if key in seen:\n            continue\n        if any(word in text for word in words):\n            seen.add(key)\n            found.append(key)\n    return found\n\n\ndef build_spec(record):\n    if not isinstance(record, dict):\n        raise SpecError(\"conversation must be a JSON object\")\n    messages = record.get(\"messages\")\n    if not isinstance(messages, list):\n        raise SpecError(\"conversation must have a messages list\")\n    session_id = record.get(\"session_id\", record.get(\"source_id\"))\n    if not isinstance(session_id, str) or not session_id:\n        raise SpecError(\"conversation needs a string session_id\")\n    texts = []\n    for message in messages:\n        if not isinstance(message, dict) or not isinstance(message.get(\"id\"), str) or not message[\"id\"]:\n           