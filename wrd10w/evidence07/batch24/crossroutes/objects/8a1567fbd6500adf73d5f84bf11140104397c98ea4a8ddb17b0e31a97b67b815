{"type": "message", "id": "822207ff-6e68-4cc4-af13-50fb2a7019fe", "parentId": "6261a7fd-0f9f-4fd4-9f00-6cb5cc2d163e", "timestamp": "2026-10-22T18:00:45.689Z", "message": {"role": "toolResult", "toolCallId": "call941ec964815f4ec791aefabe3b311852", "toolName": "read", "content": [{"type": "text", "text": "#!/usr/bin/env python3\n\"\"\"Assemble per-slide images into a directly usable image-type PPTX file.\n\nMethod: read the slide plan JSON (same schema as build_slide_plan.py output),\nvalidate that every slide references an existing PNG/JPEG image inside the\n--images directory, then write a 16:9 (12192000x6858000 EMU) PPTX package in\npage order. Each slide holds one full-bleed picture; the package is built with\nonly the Python standard library (zipfile with ZIP_STORED and fixed member\ntimestamps), so output bytes are deterministic for identical inputs.\n\nPublic usage:\n  python assemble_image_ppt.py PLAN_JSON --images IMAGES_DIR --out RESULT_PPTX\n\nInputs: slide plan JSON (pages 1..50, slides list whose length equals pages,\nevery slide has a safe relative image_path); images directory holding those\nPNG/JPEG files.\nOutputs: PPTX file at the --out path; stdout prints the output path.\nErrors: exit 2 with 'pptx_error: ...' on stderr for unreadable/invalid plan,\nslides/pages count mismatch, missing or unsafe image_path, missing image\nfile, unsupported image format, or an unwritable output path. Nothing is\nwritten when validation fails.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nimport zipfile\nfrom pathlib import Path, PurePosixPath\n\nSLIDE_W_EMU = 12192000\nSLIDE_H_EMU = 6858000\nFIXED_ZIP_DATE = (1980, 1, 1, 0, 0, 0)\n\nNS = {\n    \"a\": \"http://schemas.openxmlformats.org/drawingml/2006/main\",\n    \"p\": \"http://schemas.openxmlformats.org/presentationml/2006/main\",\n    \"r\": \"http://schemas.openxmlformats.org/officeDocument/2006/relationships\",\n    \"ct\": \"http://schemas.openxmlformats.org/package/2006/content-types\",\n    \"rel\": \"http://schemas.openxmlformats.org/package/2006/relationships\",\n    \"cp\": \"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\",\n    \"dc\": \"http://purl.org/dc/elements/1.1/\",\n    \"dcterms\": \"http://purl.org/dc/terms/\",\n    \"xsi\": \"http://www.w3.org/2001/XMLSchema-instance\",\n    \"ep\": \"http://schemas.openxmlformats.org/officeDocument/2006/extended-properties\",\n}\n\nCONTENT_TYPES = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<Types xmlns=\"{NS[\"ct\"]}\">'\n    '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>'\n    '<Default Extension=\"xml\" ContentType=\"application/xml\"/>'\n    '<Default Extension=\"png\" ContentType=\"image/png\"/>'\n    '<Default Extension=\"jpeg\" ContentType=\"image/jpeg\"/>'\n    '<Default Extension=\"jpg\" ContentType=\"image/jpeg\"/>'\n    '<Override PartName=\"/ppt/presentation.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml\"/>'\n    '<Override PartName=\"/ppt/slideMasters/slideMaster1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slideMaster+xml\"/>'\n    '<Override PartName=\"/ppt/slideLayouts/slideLayout1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slideLayout+xml\"/>'\n    '<Override PartName=\"/ppt/theme/theme1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.theme+xml\"/>'\n    '<Override PartName=\"/docProps/core.xml\" ContentType=\"application/vnd.openxmlformats-package.core-properties+xml\"/>'\n    '<Override PartName=\"/docProps/app.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.extended-properties+xml\"/>'\n    \"{SLIDE_OVERRIDES}\"\n    \"</Types>\"\n)\n\nROOT_RELS = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<Relationships xmlns=\"{NS[\"rel\"]}\">'\n    '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"ppt/presentation.xml\"/>'\n    '<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/>'\n    '<Relationship Id=\"rId3\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties\" Target=\"docProps/app.xml\"/>'\n    \"</Relationships>\"\n)\n\nCORE_XML = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<cp:coreProperties xmlns:cp=\"{NS[\"cp\"]}\" xmlns:dc=\"{NS[\"dc\"]}\" '\n    f'xmlns:dcterms=\"{NS[\"dcterms\"]}\" xmlns:xsi=\"{NS[\"xsi\"]}\">'\n    \"<dc:title></dc:title><dc:creator>image-ppt</dc:creator>\"\n    \"<cp:lastModifiedBy>image-ppt</cp:lastModifiedBy>\"\n    '<dcterms:created xsi:type=\"dcterms:W3CDTF\">2026-01-01T00:00:00Z</dcterms:created>'\n    '<dcterms:modified xsi:type=\"dcterms:W3CDTF\">2026-01-01T00:00:00Z</dcterms:modified>'\n    \"</cp:coreProperties>\"\n)\n\n\ndef app_xml(slides: int) -> str:\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n        f'<Properties xmlns=\"{NS[\"ep\"]}\" '\n        f'xmlns:vt=\"http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes\">'\n        \"<Application>assemble_image_ppt</Application>\"\n        f\"<Slides>{slides}</Slides>\"\n        \"<PresentationFormat>Widescreen</PresentationFormat>\"\n        \"</Properties>\"\n    )\n\n\ndef presentation_xml(slides: int) -> str:\n    ids = \"\".join(\n        f'<p:sldId id=\"{256 + index}\" r:id=\"rId{index + 2}\"/>'\n        for index in range(slides)\n    )\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n        f'<p:presentation xmlns:a=\"{NS[\"a\"]}\" xmlns:r=\"{NS[\"r\"]}\" xmlns:p=\"{NS[\"p\"]}\">'\n        '<p:sldMasterIdLst><p:sldMasterId id=\"2147483648\" r:id=\"rId1\"/></p:sldMasterIdLst>'\n        f'<p:sldIdLst>{ids}</p:sldIdLst>'\n        f'<p:sldSz cx=\"{SLIDE_W_EMU}\" cy=\"{SLIDE_H_EMU}\"/>'\n        '<p:notesSz cx=\"6858000\" cy=\"9144000\"/>'\n        \"</p:presentation>\"\n    )\n\n\ndef presentation_rels(slides: int) -> str:\n    parts = [\n        '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"slideMasters/slideMaster1.xml\"/>'\n    ]\n    parts.extend(\n        f'<Relationship Id=\"rId{index + 2}\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide{index + 1}.xml\"/>'\n        for index in range(slides)\n    )\n    body = \"\".join(parts)\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n        f'<Relationships xmlns=\"{NS[\"rel\"]}\">{body}</Relationships>'\n    )\n\n\nEMPTY_SPTREE = (\n    '<p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr>'\n    '<p:grpSpPr><a:xfrm><a:off x=\"0\" y=\"0\"/><a:ext cx=\"0\" cy=\"0\"/>'\n    '<a:chOff x=\"0\" y=\"0\"/><a:chExt cx=\"0\" cy=\"0\"/></a:xfrm></p:grpSpPr>'\n)\n\nSLIDE_MASTER = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<p:sldMaster xmlns:a=\"{NS[\"a\"]}\" xmlns:r=\"{NS[\"r\"]}\" xmlns:p=\"{NS[\"p\"]}\">'\n    f'<p:cSld><p:bg><p:bgPr><a:solidFill><a:srgbClr val=\"FFFFFF\"/></a:solidFill>'\n    f\"<a:effectLst/></p:bgPr></p:bg>{EMPTY_SPTREE}</p:spTree></p:cSld>\"\n    '<p:clrMap bg1=\"lt1\" tx1=\"dk1\" bg2=\"lt2\" tx2=\"dk2\" accent1=\"accent1\" '\n    'accent2=\"accent2\" accent3=\"accent3\" accent4=\"accent4\" accent5=\"accent5\" '\n    'accent6=\"accent6\" hlink=\"hlink\" folHlink=\"folHlink\"/>'\n    \"</p:sldMaster>\"\n)\n\nSLIDE_MASTER_RELS = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<Relationships xmlns=\"{NS[\"rel\"]}\">'\n    '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/slideLayout1.xml\"/>'\n    '<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme\" Target=\"../theme/theme1.xml\"/>'\n    \"</Relationships>\"\n)\n\nSLIDE_LAYOUT = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<p:sldLayout xmlns:a=\"{NS[\"a\"]}\" xmlns:r=\"{NS[\"r\"]}\" xmlns:p=\"{NS[\"p\"]}\" '\n    f'type=\"blank\" preserve=\"1\"><p:cSld name=\"Blank\">{EMPTY_SPTREE}</p:spTree></p:cSld>'\n    '<p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sldLayout>'\n)\n\nSLIDE_LAYOUT_RELS = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<Relationships xmlns=\"{NS[\"rel\"]}\">'\n    '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"../slideMasters/slideMaster1.xml\"/>'\n    \"</Relationships>\"\n)\n\nTHEME = (\n    '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n    f'<a:theme xmlns:a=\"{NS[\"a\"]}\" name=\"Minimal\"><a:themeElements>'\n    '<a:clrScheme name=\"Minimal\"><a:dk1><a:srgbClr val=\"000000\"/></a:dk1>'\n    '<a:lt1><a:srgbClr val=\"FFFFFF\"/></a:lt1><a:dk2><a:srgbClr val=\"44546A\"/></a:dk2>'\n    '<a:lt2><a:srgbClr val=\"E7E6E6\"/></a:lt2><a:accent1><a:srgbClr val=\"4472C4\"/></a:accent1>'\n    '<a:accent2><a:srgbClr val=\"ED7D31\"/></a:accent2><a:accent3><a:srgbClr val=\"A5A5A5\"/></a:accent3>'\n    '<a:accent4><a:srgbClr val=\"FFC000\"/></a:accent4><a:accent5><a:srgbClr val=\"5B9BD5\"/></a:accent5>'\n    '<a:accent6><a:srgbClr val=\"70AD47\"/></a:accent6><a:hlink><a:srgbClr val=\"0563C1\"/></a:hlink>'\n    '<a:folHlink><a:srgbClr val=\"954F72\"/></a:folHlink></a:clrScheme>'\n    '<a:fontScheme name=\"Minimal\"><a:majorFont><a:latin typeface=\"Calibri Light\"/>'\n    '<a:ea typeface=\"\"/><a:cs typeface=\"\"/></a:majorFont><a:minorFont>'\n    '<a:latin typeface=\"Calibri\"/><a:ea typeface=\"\"/><a:cs typeface=\"\"/></a:minorFont></a:fontScheme>'\n    '<a:fmtScheme name=\"Minimal\"><a:fillStyleLst>'\n    '<a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill>'\n    '<a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill>'\n    '<a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:fillStyleLst>'\n    '<a:lnStyleLst><a:ln w=\"6350\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln>'\n    '<a:ln w=\"12700\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln>'\n    '<a:ln w=\"19050\"><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:ln></a:lnStyleLst>'\n    '<a:effectStyleLst><a:effectStyle><a:effectLst/></a:effectStyle>'\n    '<a:effectStyle><a:effectLst/></a:effectStyle><a:effectStyle><a:effectLst/></a:effectStyle></a:effectStyleLst>'\n    '<a:bgFillStyleLst><a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill>'\n    '<a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill>'\n    '<a:solidFill><a:schemeClr val=\"phClr\"/></a:solidFill></a:bgFillStyleLst>'\n    '</a:fmtScheme></a:themeElements></a:theme>'\n)\n\n\ndef slide_xml(index: int) -> str:\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n        f'<p:sld xmlns:a=\"{NS[\"a\"]}\" xmlns:r=\"{NS[\"r\"]}\" xmlns:p=\"{NS[\"p\"]}\">'\n        f'<p:cSld>{EMPTY_SPTREE}'\n        f'<p:pic><p:nvPicPr><p:cNvPr id=\"2\" name=\"Picture {index}\"/>'\n        '<p:cNvPicPr><a:picLocks noChangeAspect=\"1\"/></p:cNvPicPr><p:nvPr/></p:nvPicPr>'\n        '<p:blipFill><a:blip r:embed=\"rId1\"/><a:stretch><a:fillRect/></a:stretch></p:blipFill>'\n        f'<p:spPr><a:xfrm><a:off x=\"0\" y=\"0\"/><a:ext cx=\"{SLIDE_W_EMU}\" cy=\"{SLIDE_H_EMU}\"/></a:xfrm>'\n        '<a:prstGeom prst=\"rect\"><a:avLst/></a:prstGeom></p:spPr></p:pic>'\n        '</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>'\n    )\n\n\ndef slide_rels(index: int, extension: str) -> str:\n    return (\n        '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\\r\\n'\n        f'<Relationships xmlns=\"{NS[\"rel\"]}\">'\n        '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/image\" '\n        f'Target=\"../media/image{index}.{extension}\"/>'\n        '<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/slideLayout1.xml\"/>'\n        \"</Relationships>\"\n    )\n\n\ndef fail(message: str) -> None:\n    print(\"pptx_error: \" + message, file=sys.stderr)\n    raise SystemExit(2)\n\n\ndef image_format(data: bytes):\n    if data.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\"):\n        return \"png\"\n    if data.startswith(b\"\\xff\\xd8\\xff\"):\n        return \"jpeg\"\n    return None\n\n\ndef load_plan(path: str, images_dir: Path):\n    try:\n        raw = Path(path).read_bytes()\n    except OSError as error:\n        fail(f\"cannot read plan file: {error}\")\n    try:\n        plan = json.loads(raw.decode(\"utf-8-sig\"))\n    except (UnicodeError, ValueError) as error:\n        fail(f\"plan is not valid JSON: {error}\")\n    if not isinstance(plan, dict):\n        fail(\"plan must be a JSON object\")\n    pages = plan.get(\"pages\")\n    if isinstance(pages, bool) or not isinstance(pages, int) or not 1 <= pages <= 50:\n        fail(\"pages must be an integer between 1 and 50\")\n    slides = plan.get(\"slides\")\n    if not isinstance(slides, list):\n        fail(\"slides must be a list\")\n    if len(slides) != pages:\n        fail(f\"slides count {len(slides)} does not match pages {pages}\")\n    entries = []\n    for position, slide in enumerate(slides, start=1):\n        if not isinstance(slide, dict):\n            fail(f\"slide {position} must be a JSON object\")\n        image_path = slide.get(\"image_path\")\n        if (\n            not isinstance(image_path, str)\n            or not image_path\n            or PurePosixPath(image_path).is_absolute()\n            or any(part in (\"\", \".\", \"..\") for part in image_path.split(\"/\"))\n            or \"\\\\\" in image_path\n            or \":\" in image_path\n        ):\n            fail(f\"slide {position} has an unsafe image_path\")\n        image = images_dir / image_path\n        try:\n            resolved = image.resolve()\n            resolved.relative_to(images_dir.resolve())\n        except (OSError, ValueError):\n            fail(f\"slide {position} image escapes the images directory\")\n        if not image.is_file():\n            fail(f\"slide {position} image file is missing: {image_path}\")\n        try:\n            data = image.read_bytes()\n        except OSError as error:\n            fail(f\"cannot read slide {position} image: {error}\")\n        extension = image_format(data)\n        if extension is None:\n            fail(f\"slide {position} image is not a PNG or JPEG file\")\n        entries.append((image_path, extension, data))\n    return pages, entries\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Assemble per-slide images into a 16:9 image-type PPTX.\"\n    )\n    parser.add_argument(\"plan\", help=\"slide plan JSON path\")\n    parser.add_argument(\"--images\", required=True, help=\"directory holding the slide images\")\n    parser.add_argument(\"--out\", required=True, help=\"output PPTX path\")\n    args = parser.parse_args()\n\n    images_dir = Path(args.images)\n    if not images_dir.is_dir():\n        fail(\"images directory does not exist\")\n    pages, entries = load_plan(args.plan, images_dir)\n\n    out = Path(args.out)\n    try:\n        if out.parent and not out.parent.exists():\n            out.parent.mkdir(parents=True, exist_ok=True)\n    except OSError as error:\n        fail(f\"cannot create output directory: {error}\")\n\n    slide_overrides = \"\".join(\n        f'<Override PartName=\"/ppt/slides/slide{index}.xml\" '\n        'ContentType=\"application/vnd.openxmlformats-officedocument.presentationml.slide+xml\"/>'\n        for index in range(1, pages + 1)\n    )\n    parts: list[tuple[str, str]] = [\n        (\"[Content_Types].xml\", CONTENT_TYPES.replace(\"{SLIDE_OVERRIDES}\", slide_overrides)),\n        (\"_rels/.rels\", ROOT_RELS),\n        (\"docProps/core.xml\", CORE_XML),\n        (\"docProps/app.xml\", app_xml(pages)),\n        (\"ppt/presentation.xml\", presentation_xml(pages)),\n        (\"ppt/_rels/presentation.xml.rels\", presentation_rels(pages)),\n        (\"ppt/slideMasters/slideMaster1.xml\", SLIDE_MASTER),\n        (\"ppt/slideMasters/_rels/slideMaster1.xml.rels\", SLIDE_MASTER_RELS),\n        (\"ppt/slideLayouts/slideLayout1.xml\", SLIDE_LAYOUT),\n        (\"ppt/slideLayouts/_rels/slideLayout1.xml.rels\", SLIDE_LAYOUT_RELS),\n        (\"ppt/theme/theme1.xml\", THEME),\n    ]\n    for index, (image_path, extension, data) in enumerate(entries, start=1):\n        parts.append((f\"ppt/slides/slide{index}.xml\", slide_xml(index)))\n        parts.append((f\"ppt/slides/_rels/slide{index}.xml.rels\", slide_rels(index, extension)))\n    media: dict[str, bytes] = {}\n    for index, (image_path, extension, data) in enumerate(entries, start=1):\n        name = f\"image{index}.{ 'jpg' if extension == 'jpeg' else extension }\"\n        media[f\"ppt/media/{name}\"] = data\n\n    try:\n        with zipfile.ZipFile(out, \"w\", compression=zipfile.ZIP_STORED) as package:\n            for name, content in parts:\n                if name.startswith(\"ppt/media/\"):\n                    continue\n                info = zipfile.ZipInfo(name, date_time=FIXED_ZIP_DATE)\n                info.external_attr = 0o600 << 16\n                package.writestr(info, content.encode(\"utf-8\"))\n            for name, data in media.items():\n                info = zipfile.ZipInfo(name, date_time=FIXED_ZIP_DATE)\n                info.external_attr = 0o600 << 16\n                package.writestr(info, data)\n    except OSError as error:\n        fail(f\"cannot write PPTX file: {error}\")\n    print(str(out))\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}], "details": {"persistedDetailsTruncated": true, "originalDetailsBytesAtLeast": 8193, "originalDetailKeys": ["kind", "content"]}, "isError": false, "timestamp": 1792692045677, "__openclaw": {"runId": "d3bcabd8-2a0f-452e-b05a-59523ea21ae9"}}}
