#!/usr/bin/env python3
"""规范DOCX目录后处理：注入标题书签+带页码的目录条目，LibreOffice 实测页码，设置 Word 打开自动更新域。

用法:
  python3 fix_toc.py INPUT.docx OUTPUT.docx [--offset N] [--keep-work DIR]

适用: docx-js 等生成、含 TOC 域（\o "1-2"）和 Heading1/Heading2 标题的 docx。
行为:
  1) document.xml 给每个正文标题段落注入 _Toc_hN 书签（幂等，已有则跳过）。
  2) 找到 TOC 域（docx-js 的 sdt 包裹或裸域段落），去 sdt 包裹，注入带点线引导 + PAGEREF 域的
     目录条目段落（幂等：条目已存在时只更新页码缓存值，不重复注入）。
  3) settings.xml 写入 updateFields（Word 打开自动刷新域；插在 w:compat 之前满足 schema 顺序）。
  4) 重打包 → LibreOffice 渲染 PDF → 逐页定位标题（排除目录页）→ 回填真实显示页码
     （默认显示页码 = 物理页号 - 首个标题物理页号 + 1，即正文页码从 1 起算；--offset N 则 = 物理页号 - N）。
  5) 输出后再渲染验证，打印页数与目录条目页码供抽查。
退出码: 0 成功; 2 输入问题（无 TOC 域 / 无标题 / 文件不存在）; 3 中间步骤失败。
已知边界: 标题文本若在目录页之后的更早正文页以完全相同整串出现会被提前匹配（罕见）；
缓存页码在 Word 打开后会被 updateFields 刷新，最终以 Word 为准；脚本保证 LibreOffice 渲染下即已正确。
"""
import argparse
import html
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile

DOT_ALL = re.DOTALL


def fail(code, msg):
    print(f"fix_toc: ERROR {msg}", file=sys.stderr)
    sys.exit(code)


def read_zip(path):
    with zipfile.ZipFile(path) as z:
        return {n: z.read(n) for n in z.namelist()}


def write_zip(path, files):
    names = list(files.keys())
    if "[Content_Types].xml" in files:  # 放最前，兼容性最好
        names.remove("[Content_Types].xml")
        names.insert(0, "[Content_Types].xml")
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        for n in names:
            z.writestr(n, files[n])


def para_text(p_xml):
    ts = re.findall(r"<w:t(?:\s[^>]*)?>(.*?)</w:t>", p_xml, DOT_ALL)
    return html.unescape("".join(ts))


def find_headings(doc_xml):
    """返回 [(level, text, span)]，文档顺序；只认 pStyle Heading1/Heading2 的正文标题段落。"""
    out = []
    for m in re.finditer(r"<w:p\b[^>]*>.*?</w:p>", doc_xml, DOT_ALL):
        p = m.group(0)
        sm = re.search(r'<w:pStyle w:val="(Heading[12])"\s*/>', p)
        if not sm:
            continue
        text = para_text(p).strip()
        if text:
            out.append((sm.group(1), text, m.span()))
    return out


def inject_bookmarks(doc_xml, headings):
    """给每个标题段落注入 _Toc_hN 书签（从后往前注入避免 span 偏移）；幂等。
    返回 (新xml, [(name, level, text)])，entries 为文档顺序。"""
    entries = [None] * len(headings)
    result = doc_xml
    for i in range(len(headings) - 1, -1, -1):
        level, text, (s, e) = headings[i]
        name = f"_Toc_h{i}"
        entries[i] = (name, level, text)
        if f'w:name="{name}"' in result:
            continue
        p = result[s:e]
        bm = (f'<w:bookmarkStart w:id="{9000 + i}" w:name="{name}"/>'
              f'<w:bookmarkEnd w:id="{9000 + i}"/>')
        if "</w:pPr>" in p:
            new_p = p.replace("</w:pPr>", "</w:pPr>" + bm, 1)
        else:
            new_p = p.replace(">", ">" + bm, 1)
        result = result[:s] + new_p + result[e:]
    return result, entries


def toc_entry_xml(name, level, text, first, last):
    ind = '<w:ind w:left="420"/>' if level == "Heading2" else ""
    runs = ""
    if first:
        runs += ('<w:r><w:fldChar w:fldCharType="begin" w:dirty="true"/></w:r>'
                 '<w:r><w:instrText xml:space="preserve"> TOC \\o "1-2" \\h \\z \\u </w:instrText></w:r>'
                 '<w:r><w:fldChar w:fldCharType="separate"/></w:r>')
    runs += (f'<w:hyperlink w:anchor="{name}" w:history="1">'
             f'<w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr>'
             f'<w:t xml:space="preserve">{html.escape(text)}</w:t></w:r>'
             '<w:r><w:tab/></w:r>'
             '<w:r><w:fldChar w:fldCharType="begin"/></w:r>'
             f'<w:r><w:instrText xml:space="preserve"> PAGEREF {name} \\h </w:instrText></w:r>'
             '<w:r><w:fldChar w:fldCharType="separate"/></w:r>'
             '<w:r><w:t>1</w:t></w:r>'
             '<w:r><w:fldChar w:fldCharType="end"/></w:r>'
             '</w:hyperlink>')
    if last:
        runs += '<w:r><w:fldChar w:fldCharType="end"/></w:r>'
    return ('<w:p><w:pPr>'
            '<w:tabs><w:tab w:val="right" w:leader="dot" w:pos="9026"/></w:tabs>'
            f'{ind}'
            '<w:spacing w:after="80"/>'
            '</w:pPr>' + runs + '</w:p>')


def inject_toc_entries(doc_xml, entries):
    """把 TOC sdt（或裸 TOC 域段落）替换为：域起始+条目段落+域结束。幂等：条目已存在则原样返回。"""
    if "PAGEREF _Toc_h0" in doc_xml:
        return doc_xml
    sdt_m = None
    for m in re.finditer(r"<w:sdt>.*?</w:sdt>", doc_xml, DOT_ALL):
        if re.search(r"<w:instrText[^>]*>[^<]*TOC ", m.group(0)):
            sdt_m = m
            break
    if sdt_m is None:
        for m in re.finditer(r"<w:p\b[^>]*>.*?</w:p>", doc_xml, DOT_ALL):
            if re.search(r"<w:instrText[^>]*>[^<]*TOC ", m.group(0)):
                sdt_m = m
                break
    if sdt_m is None:
        fail(2, "未找到 TOC 域（生成 docx 时需包含 TableOfContents）")
    if not entries:
        fail(2, "未找到 Heading1/Heading2 标题，无法生成目录条目")
    block = "".join(
        toc_entry_xml(name, lv, tx, i == 0, i == len(entries) - 1)
        for i, (name, lv, tx) in enumerate(entries))
    return doc_xml[:sdt_m.start()] + block + doc_xml[sdt_m.end():]


def set_update_fields(settings_xml):
    if "<w:updateFields" in settings_xml:
        return settings_xml
    tag = '<w:updateFields w:val="true"/>'
    if "<w:compat" in settings_xml:
        return settings_xml.replace("<w:compat", tag + "<w:compat", 1)
    m = re.search(r"(<w:settings\b[^>]*>)", settings_xml)
    if not m:
        fail(3, "settings.xml 结构异常")
    return settings_xml[:m.end()] + tag + settings_xml[m.end():]


def render_pdf(docx_path, outdir):
    r = subprocess.run(
        ["soffice", "--headless", "--convert-to", "pdf", "--outdir", outdir, docx_path],
        capture_output=True, text=True, timeout=180)
    pdf = os.path.join(outdir, os.path.splitext(os.path.basename(docx_path))[0] + ".pdf")
    if not os.path.exists(pdf):
        fail(3, f"LibreOffice 渲染失败: {r.stdout} {r.stderr}")
    return pdf


def pdf_pages_text(pdf):
    r = subprocess.run(["pdftotext", "-enc", "UTF-8", pdf, "-"],
                       capture_output=True, text=True, timeout=60)
    return [re.sub(r"\s+", "", pg) for pg in r.stdout.split("\f")]


def measure_pages(pdf, entries):
    """返回 ({name: 物理页号1基}, 首个标题物理页号)。目录页=出现>=半数标题文本的页，正文搜索从其后开始。"""
    pages = pdf_pages_text(pdf)
    texts = [re.sub(r"\s+", "", t) for _, _, t in entries]
    toc_page = None
    for i, pg in enumerate(pages):
        hits = sum(1 for t in texts if t and t in pg)
        if hits >= max(2, len(texts) // 2):
            toc_page = i
            break
    if toc_page is None:
        fail(3, "未能在 PDF 中定位目录页（目录条目未渲染？）")
    result = {}
    for (name, _, text), t in zip(entries, texts):
        page_no = None
        for i in range(toc_page + 1, len(pages)):
            if t in pages[i]:
                page_no = i + 1
                break
        if page_no is None:
            fail(3, f"未能在正文中定位标题「{text}」")
        result[name] = page_no
    return result, page_no_of_first(entries, result)


def page_no_of_first(entries, result):
    return result[entries[0][0]]


def update_numbers(doc_xml, entries, page_map, offset):
    for name, _, _ in entries:
        shown = page_map[name] - offset
        if shown < 1:
            fail(3, f"页码偏移异常：{name} 物理页 {page_map[name]}，offset {offset}")
        pat = re.compile(
            r"( PAGEREF " + re.escape(name) + r" \\h </w:instrText></w:r>"
            r'<w:r><w:fldChar w:fldCharType="separate"/></w:r>'
            r"<w:r>(?:<w:rPr>(?:(?!</w:rPr>).)*</w:rPr>)?<w:t[^>]*>)[^<]*(</w:t>)",
            DOT_ALL)
        doc_xml, n = pat.subn(r"\g<1>" + str(shown) + r"\g<2>", doc_xml, count=1)
        if n != 1:
            fail(3, f"未找到 {name} 的页码缓存文本（条目形态不符）")
    return doc_xml


def main(argv):
    ap = argparse.ArgumentParser(description="规范DOCX目录后处理（书签+条目+实测页码+updateFields）")
    ap.add_argument("input")
    ap.add_argument("output")
    ap.add_argument("--offset", type=int, default=None,
                    help="显示页码=物理页号-offset；默认自动=物理页号-首个标题物理页号+1（正文从1起算）")
    ap.add_argument("--keep-work", default=None, help="保留中间工作目录（调试用）")
    args = ap.parse_args(argv)

    if not os.path.isfile(args.input):
        fail(2, f"输入文件不存在: {args.input}")
    work = tempfile.mkdtemp(prefix="fix_toc_")

    try:
        files = read_zip(args.input)
        if "word/document.xml" not in files or "word/settings.xml" not in files:
            fail(2, "不是有效的 docx（缺 document.xml/settings.xml）")
        doc = files["word/document.xml"].decode("utf-8")

        headings = find_headings(doc)
        doc, entries = inject_bookmarks(doc, headings)
        doc = inject_toc_entries(doc, entries)
        files["word/document.xml"] = doc.encode("utf-8")
        files["word/settings.xml"] = set_update_fields(
            files["word/settings.xml"].decode("utf-8")).encode("utf-8")

        pass1 = os.path.join(work, "pass1.docx")
        write_zip(pass1, files)
        pdf = render_pdf(pass1, work)
        page_map, first_body_page = measure_pages(pdf, entries)
        offset = args.offset if args.offset is not None else first_body_page - 1

        doc = update_numbers(files["word/document.xml"].decode("utf-8"),
                             entries, page_map, offset)
        files["word/document.xml"] = doc.encode("utf-8")
        write_zip(args.output, files)

        pdf2 = render_pdf(args.output, work)
        final_pages = len([p for p in pdf_pages_text(pdf2) if p])
        print(f"fix_toc: OK 输出 {args.output}，渲染实测共 {final_pages} 页，页码偏移 offset={offset}")
        for name, lv, text in entries:
            print(f"  目录条目  {text}  ->  第 {page_map[name] - offset} 页")
        return 0
    finally:
        if args.keep_work:
            keep = os.path.join(args.keep_work, os.path.basename(work))
            shutil.copytree(work, keep, dirs_exist_ok=True)
            print(f"fix_toc: 中间文件保留在 {keep}")
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
