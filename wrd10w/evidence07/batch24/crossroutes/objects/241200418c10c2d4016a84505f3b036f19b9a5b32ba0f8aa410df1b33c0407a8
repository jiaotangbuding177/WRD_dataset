{"type": "message", "id": "d44188ce-0007-4b62-a3b0-00d0c1e4243b", "parentId": "aa0dfb29-a265-4005-ba6b-10657d5566b1", "timestamp": "2026-10-23T03:00:44.464Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "现在我来制作视频组装脚本。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-9843eae9bc6f46be92d85f1c\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call7c2bf25713cc490292a88ac4b343d788", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"静态介绍图 + 逐页旁白音频 → 解说视频（推拉平移镜头、淡入淡出、同步字幕，16:9 MP4）。\n\n用法:\n  python make_video.py PAGES_JSON --images IMAGES_DIR --audio AUDIO_DIR --out OUT.mp4 [选项]\n\nPAGES_JSON 格式:\n  {\n    \"title\": \"可选，视频标题\",\n    \"pages\": [\n      {\"id\": \"p01\", \"title\": \"封面\", \"image\": \"slide_001.png\",\n       \"narration\": \"旁白文本。按句合成。\", \"motion\": \"zoom_in\"}\n    ]\n  }\n  image 相对 --images 目录解析，也可是绝对路径；motion 可选\n  zoom_in|zoom_out|pan_left|pan_right|pan_up|still，缺省按页序轮换。\n\n主要选项:\n  --auto-tts      缺页音频时自动调用 tts_page.py 逐句合成（默认只报错列出缺页）\n  --only p01,p02  只构建指定页（先做样片/重做点名页），输出为这几页的成片\n  --force         忽略已存在的页分段缓存，全部重做\n  --no-subtitles  不烧录字幕\n  --width/--height/--fps  默认 1920x1080 30fps；--tail 默认 0.6s 页尾余量\n  --font          字幕字体名，默认 Noto Sans CJK SC\n  --tmpdir        分段与字幕工作目录，默认 OUT 同目录 .video_tmp\n\n退出码: 2 = 输入/缺素材错误（stderr 前缀 video_error:）。\n每页分段缓存在 --tmpdir/segs/{id}.mp4，已存在则跳过（改了对应素材请 --force 或删除该段）。\n\"\"\"\nimport argparse, json, os, shlex, subprocess, sys\n\n\ndef sh(cmd):\n    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True)\n\n\ndef media_duration(path):\n    r = sh([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n            \"-of\", \"default=noprint_wrappers=1:nokey=1\", path])\n    try:\n        return float(r.stdout.strip())\n    except (ValueError, TypeError):\n        return 0.0\n\n\ndef ass_time(sec):\n    h = int(sec // 3600)\n    m = int(sec % 3600 // 60)\n    s = sec % 60\n    return f\"{h}:{m:02d}:{s:05.2f}\"\n\n\ndef write_ass(path, timings, font, W, H):\n    lines = [\n        \"[Script Info]\", \"ScriptType: v4.00+\", f\"PlayResX: {W}\", f\"PlayResY: {H}\",\n        \"WrapStyle: 0\", \"\", \"[V4+ Styles]\",\n        \"Format: Name, Fontname, Fontsize, PrimaryColour, OutlineColour, BackColour, Bold, Outline, Shadow, Alignment, MarginL, MarginR, MarginV\",\n        f\"Style: Sub,{font},44,&H00FFFFFF,&H00101010,&H7F000000,0,3,1,2,110,110,52\",\n        \"\", \"[Events]\", \"Format: Layer, Start, End, Style, Text\",\n    ]\n    for t in timings:\n        text = t[\"text\"].replace(\"\\n\", \" \")\n        lines.append(f\"Dialogue: 0,{ass_time(t['start'])},{ass_time(t['end'])},Sub,{text}\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(lines) + \"\\n\")\n\n\ndef zoompan_expr(motion, frames):\n    F = max(frames, 1)\n    if motion == \"zoom_in\":\n        return f\"zoompan=z='1+0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"\n    if motion == \"zoom_out\":\n        return f\"zoompan=z='1.10-0.10*on/{F}':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_right\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)*on/{F}':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_left\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)*(1-on/{F})':y='(ih-ih/zoom)/2'\"\n    if motion == \"pan_up\":\n        return f\"zoompan=z='1.08':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)*(1-on/{F})'\"\n    return \"zoompan=z='1.001':x='(iw-iw/zoom)/2':y='(ih-ih/zoom)/2'\"  # still\n\n\ndef build_page(page, idx, a):\n    \"\"\"构建单页分段 mp4，返回分段路径。\"\"\"\n    pid = page[\"id\"]\n    seg = os.path.join(a.segs, f\"{pid}.mp4\")\n    if os.path.exists(seg) and not a.force:\n        print(f\"[skip] {pid} 分段已存在: {seg}\")\n        return seg\n    audio = os.path.join(a.audio_dir, f\"{pid}.wav\")\n    timings_path = os.path.join(a.audio_dir, f\"{pid}.timings.json\")\n    if not os.path.exists(audio):\n        print(f\"video_error: 缺页音频 {audio}（先跑 tts_page.py 或加 --auto-tts）\", file=sys.stderr)\n        sys.exit(2)\n\n    adur = media_duration(audio)\n    if adur <= 0:\n        print(f\"video_error: 音频无效 {audio}\", file=sys.stderr)\n        sys.exit(2)\n    D = adur + a.tail\n    frames = max(int(round(D * a.fps)), 2)\n\n    img = page[\"image\"]\n    if not os.path.isabs(img):\n        img = os.path.join(a.images, img)\n    if not os.path.exists(img):\n        print(f\"video_error: 缺图片 {img}\", file=sys.stderr)\n        sys.exit(2)\n\n    motion = page.get(\"motion\") or [\"zoom_in\", \"pan_right\", \"zoom_out\", \"pan_left\"][idx % 4]\n    SW, SH = int(a.width * 1.15) // 2 * 2, int(a.height * 1.15) // 2 * 2\n    fade_out = min(0.5, D / 3)\n    vf = (\n        f\"scale={SW}:{SH}:force_original_aspect_ratio=increase,crop={SW}:{SH},\"\n        f\"{zoompan_expr(motion, frames)}:d={frames}:s={a.width}x{a.height}:fps={a.fps},\"\n        f\"format=yuv420p,fade=t=in:st=0:d=0.4,fade=t=out:st={D - fade_out:.3f}:d={fade_out:.3f}\"\n    )\n    if not a.no_subtitles and os.path.exists(timings_path):\n        ass = os.path.join(a.assdir, f\"{pid}.ass\")\n        with open(timings_path, encoding=\"utf-8\") as f:\n            write_ass(ass, json.load(f), a.font, a.width, a.height)\n        esc = ass.replace(\"\\\\\", \"/\").replace(\":\", \"\\\\:\").replace(\"'\", \"\\\\\\\\\\\"\")\n        vf += f\",subtitles='{esc}'\"\n    elif not a.no_subtitles:\n        print(f\"[warn] {pid} 无 timings.json，跳过本页字幕\")\n\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", img, \"-i\", audio,\n            \"-filter_complex\", f\"[0:v]{vf}[v];[1:a]apad=whole_dur={D:.3f}[a]\",\n            \"-map\", \"[v]\", \"-map\", \"[a]\", \"-t\", f\"{D:.3f}\",\n            \"-c:v\", \"libx264\", \"-preset\", \"veryfast\", \"-crf\", \"20\",\n            \"-c:a\", \"aac\", \"-b:a\", \"160k\", \"-pix_fmt\", \"yuv420p\", seg])\n    if r.returncode != 0:\n        print(f\"video_error: 页 {pid} 合成失败: {r.stderr[-400:]}\", file=sys.stderr)\n        sys.exit(2)\n    prin