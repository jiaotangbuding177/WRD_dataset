{"type": "message", "id": "01833e11-e75c-487a-8409-24048f874395", "parentId": "a96988f0-e811-44a0-a0fb-02a2986a630d", "timestamp": "2026-10-23T02:59:41.577Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "环境已确认：`ffmpeg 5.1`、`PIL`、用于 TTS 的 `ecnu_tools.py` 语音功能，以及 `Noto Sans CJK SC` 字体。对话记录提供了清晰的操作流程：先剧本 → 逐句 TTS（支持断点续传） → Ken Burns 动效 + 同步字幕 + 淡入淡出 → 先小样后全片。现在我来构建这个技能。", "textSignature": "{\"v\":1,\"id\":\"commentary-0-023f2808ee6243359e2a0e04\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "call874ca3bb5e3942f18fa50c672ba43438", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"逐句TTS一页解说词，拼接成页音频并产出逐句时间轴（供字幕同步）。\n\n用法:\n  python tts_page.py --id p01 --audio-dir OUT/audio \\\n      --text \"第一句。第二句。第三句。\" [--tts-cmd \"python3 /opt/eval-adapter/ecnu_tools.py speech\"]\n\n产出:\n  {audio-dir}/{id}.wav           本页完整旁白音频（44.1kHz 单声道 pcm_s16le）\n  {audio-dir}/{id}.timings.json  [{\"text\":..., \"start\":..., \"end\":...}, ...] 秒，页内相对时间\n\n行为:\n- 按中英文句号/问叹号/分号/换行切句，过短碎句并入下一句；句间插入 0.3s 静音。\n- 逐句合成：某句失败只重试该句（--retries 次），已生成句子直接复用（断点续传）。\n- 全部句子失败退出码 3（stderr 前缀 tts_error:），部分成功不写页输出。\n\"\"\"\nimport argparse, json, os, re, subprocess, sys, tempfile\n\nGAP_SEC = 0.3\n\n\ndef sh(cmd, **kw):\n    return subprocess.run(cmd, capture_output=True, text=True, **kw)\n\n\ndef wav_duration(path):\n    r = sh([\"ffprobe\", \"-v\", \"error\", \"-show_entries\", \"format=duration\",\n            \"-of\", \"default=noprint_wrappers=1:nokey=1\", path])\n    try:\n        return float(r.stdout.strip())\n    except (ValueError, TypeError):\n        return 0.0\n\n\ndef split_sentences(text, min_chars=10):\n    parts = re.split(r\"(?<=[。！？；!?;])|\\n+\", text.strip())\n    parts = [p.strip() for p in parts if p and p.strip()]\n    merged = []\n    for p in parts:\n        if merged and (len(merged[-1]) < min_chars or len(p) < min_chars):\n            merged[-1] += p\n        else:\n            merged.append(p)\n    return merged\n\n\ndef synth_sentence(text, wav_path, tts_cmd, retries):\n    \"\"\"合成一句并归一化到统一格式；返回 True/False。\"\"\"\n    for attempt in range(retries):\n        raw = wav_path + \".raw\"\n        r = sh(tts_cmd.split() + [\"--text\", text, \"--output\", raw])\n        if r.returncode == 0 and os.path.exists(raw) and wav_duration(raw) > 0.1:\n            n = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-i\", raw,\n                    \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", wav_path])\n            if os.path.exists(raw):\n                os.remove(raw)\n            if n.returncode == 0 and wav_duration(wav_path) > 0.1:\n                return True\n        elif os.path.exists(raw):\n            os.remove(raw)\n        sys.stderr.write(f\"tts retry {attempt + 1}/{retries} failed: {text[:20]}...\\n\")\n    return False\n\n\ndef make_silence(path):\n    sh([\"ffmpeg\", \"-y\", \"-v\", \"error\", \"-f\", \"lavfi\",\n        \"-i\", f\"anullsrc=r=44100:cl=mono\", \"-t\", str(GAP_SEC),\n        \"-c:a\", \"pcm_s16le\", path])\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--id\", required=True)\n    ap.add_argument(\"--audio-dir\", required=True)\n    ap.add_argument(\"--text\", required=True)\n    ap.add_argument(\"--tts-cmd\", default=\"python3 /opt/eval-adapter/ecnu_tools.py speech\")\n    ap.add_argument(\"--retries\", type=int, default=3)\n    args = ap.parse_args()\n\n    os.makedirs(args.audio_dir, exist_ok=True)\n    sents = split_sentences(args.text)\n    if not sents:\n        print(\"tts_error: empty narration text\", file=sys.stderr)\n        sys.exit(3)\n\n    tmpdir = tempfile.mkdtemp(prefix=\"tts_\")\n    silence = os.path.join(tmpdir, \"gap.wav\")\n    make_silence(silence)\n\n    pieces, timings, t = [], [], 0.0\n    for i, s in enumerate(sents):\n        wav = os.path.join(tmpdir, f\"sent_{i:03d}.wav\")\n        if not (os.path.exists(wav) and wav_duration(wav) > 0.1):\n            if not synth_sentence(s, wav, args.tts_cmd, args.retries):\n                print(f\"tts_error: sentence {i} failed after {args.retries} retries: {s[:40]}\",\n                      file=sys.stderr)\n                sys.exit(3)\n        dur = wav_duration(wav)\n        pieces.append(wav)\n        timings.append({\"text\": s, \"start\": round(t, 3), \"end\": round(t + dur, 3)})\n        t += dur\n        if i < len(sents) - 1:\n            pieces.append(silence)\n            t += GAP_SEC\n\n    # 拼接：filter_complex concat，避免 concat demuxer 对格式差异敏感\n    inputs, n = [], 0\n    for p in pieces:\n        inputs += [\"-i\", p]\n        if p == silence:\n            n += 1\n    fc = \"\".join(f\"[{k}:a]\" for k in range(len(pieces))) + f\"concat=n={len(pieces)}:v=0:a=1[out]\"\n    page_wav = os.path.join(args.audio_dir, f\"{args.id}.wav\")\n    r = sh([\"ffmpeg\", \"-y\", \"-v\", \"error\"] + inputs +\n           [\"-filter_complex\", fc, \"-map\", \"[out]\",\n            \"-ar\", \"44100\", \"-ac\", \"1\", \"-c:a\", \"pcm_s16le\", page_wav])\n    if r.returncode != 0:\n        print(f\"tts_error: concat failed: {r.stderr[-300:]}\", file=sys.stderr)\n        sys.exit(3)\n\n    timings_path = os.path.join(args.audio_dir, f\"{args.id}.timings.json\")\n    with open(timings_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(timings, f, ensure_ascii=False, indent=1)\n    total = wav_duration(page_wav)\n    print(json.dumps({\"id\": args.id, \"page_wav\": page_wav,\n                      \"timings\": timings_path, \"sentences\": len(sents),\n                      \"duration_sec\": round(total, 2)}, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "/workspace/outputs/skill/scripts/tts_page.py"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1792724245930, "r