#!/usr/bin/env python3
"""关键事实比对：核对关键事实原文是否保留在成品文档中（替代临时 python -c 内联脚本）。

用法（原样可执行）:
  python3 factcheck.py 成品.docx|txt|md [--source 原材料.md|txt|docx] --term 事实1 --term 事实2 [--terms-file terms.json] [--out report.json]

行为:
- 成品/原材料提取纯文本：.docx 解 zip 取 word/document.xml 的全部 w:t（含表格）；
  .txt/.md 直读；.pdf 需系统 pdftotext。
- 匹配前去掉全部空白字符（避免换行/空格/跨 run 造成漏判）。
- 关键事实来自 --term（可重复）与 --terms-file（JSON：字符串数组或 {"terms":[...]}）。
- 给 --source 时同时核对原材料：成品缺失而原材料也没有 → 多半是笔误；
  原材料有而成品缺失 → 整理时漏搬，须补上。
- --out 给出时写 JSON 报告（逐条 in_final/in_source）。
退出码: 0 全部在位; 2 用法/读取错误; 4 有关键事实缺失（缺失清单见 stdout 与报告）。
"""
import argparse
import html
import json
import re
import subprocess
import sys
import zipfile


def extract_text(path):
    ext = path.lower().rsplit(".", 1)[-1]
    if ext == "docx":
        with zipfile.ZipFile(path) as z:
            xml = z.read("word/document.xml").decode("utf-8")
        return html.unescape("".join(re.findall(r"<w:t(?:\s[^>]*)?>(.*?)</w:t>", xml, re.S)))
    if ext == "pdf":
        r = subprocess.run(["pdftotext", path, "-"], capture_output=True, text=True)
        if r.returncode != 0:
            raise ValueError(f"pdftotext 失败: {r.stderr.strip()[:200]}")
        return r.stdout
    if ext in ("txt", "md"):
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    raise ValueError(f"不支持的类型 .{ext}（支持 docx/txt/md/pdf）")


def norm(text):
    return re.sub(r"\s+", "", text)


def main():
    ap = argparse.ArgumentParser(description="关键事实保留比对")
    ap.add_argument("final", help="成品文件（docx/txt/md/pdf）")
    ap.add_argument("--source", help="可选：原材料文件，用于区分漏搬与笔误")
    ap.add_argument("--term", action="append", default=[], help="关键事实原文子串，可重复")
    ap.add_argument("--terms-file", help="JSON 文件：字符串数组或 {\"terms\":[...]}")
    ap.add_argument("--out", help="可选：JSON 报告输出路径")
    args = ap.parse_args()

    terms = list(args.term)
    if args.terms_file:
        with open(args.terms_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        items = data.get("terms", []) if isinstance(data, dict) else data
        if not isinstance(items, list) or not all(isinstance(t, str) for t in items):
            print("factcheck: ERROR --terms-file 须是字符串数组或 {\"terms\":[...]}", file=sys.stderr)
            return 2
        terms.extend(items)
    terms = [t for t in (t.strip() for t in terms) if t]
    if not terms:
        print("factcheck: ERROR 未给出任何 --term/--terms-file", file=sys.stderr)
        return 2

    try:
        final_text = norm(extract_text(args.final))
        source_text = norm(extract_text(args.source)) if args.source else None
    except (OSError, ValueError, zipfile.BadZipFile, KeyError) as e:
        print(f"factcheck: ERROR {e}", file=sys.stderr)
        return 2

    results = []
    missing = []
    for t in terms:
        key = norm(t)
        in_final = key in final_text
        in_source = (key in source_text) if source_text is not None else None
        results.append({"term": t, "in_final": in_final, "in_source": in_source})
        if not in_final:
            missing.append(t)
            hint = "（原材料也没有，疑似 --term 笔误）" if in_source is False else "（原材料有，成品漏搬，须补上）" if in_source else ""
            print(f"[MISS] {t}{hint}")
        else:
            print(f"[OK]   {t}")

    report = {
        "final": args.final,
        "source": args.source,
        "total": len(terms),
        "ok": len(terms) - len(missing),
        "missing": missing,
        "results": results,
    }
    if args.out:
        with open(args.out, "w", encoding="utf-8") as f:
            json.dump(report, f, ensure_ascii=False, indent=2)
    print(f"factcheck: {report['ok']}/{report['total']} 在位，缺失 {len(missing)}")
    return 4 if missing else 0


if __name__ == "__main__":
    sys.exit(main())
