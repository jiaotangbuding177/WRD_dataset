names:\\n            z.writestr(n, files[n])\\n\\n\\ndef para_text(p_xml):\\n    ts = re.findall(r\\\"<w:t(?:\\\\s[^>]*)?>(.*?)</w:t>\\\", p_xml, DOT_ALL)\\n    return html.unescape(\\\"\\\".join(ts))\\n\\n\\ndef find_headings(doc_xml):\\n    \\\"\\\"\\\"返回 [(level, text, para_span)]，按文档顺序；只认 pStyle Heading1/Heading2 的正文标题段落。\\\"\\\"\\\"\\n    out = []\\n    for m in re.finditer(r\\\"<w:p\\\\b[^>]*>.*?</w:p>\\\", doc_xml, DOT_ALL):\\n        p = m.group(0)\\n        sm = re.search(r'<w:pStyle w:val=\\\"(Heading[12])\\\"\\\\s*/>', p)\\n        if not sm:\\n            continue\\n        text = para_text(p).strip()\\n        if text:\\n            out.append((sm.group(1), text, m.span()))\\n    return out\\n\\n\\ndef inject_bookmarks(doc_xml, headings):\\n    \\\"\\\"\\\"给每个标题段落注入 _Toc_hN 书签；幂等。返回新 xml 与 [(name, level, text)]。\\\"\\\"\\\"\\n    entries = []\\n    result = doc_xml\\n    for i, (level, text, (s, e)) in enumerate(headings):\\n        name = f\\\"_Toc_h{i}\\\"\\n        entries.append((name, level, text))\\n        if f'w:name=\\\"{name}\\\"' in result:\\n            continue\\n        p = result[s:e]\\n        bm = (f'<w:bookmarkStart w:id=\\\"{9000 + i}\\\" w:name=\\\"{name}\\\"/>'\\n              f'<w:bookmarkEnd w:id=\\\"{9000 + i}\\\"/>')\\n        if \\\"</w:pPr>\\\" in p:\\n            new_p = p.replace(\\\"</w:pPr>\\\", \\\"</w:pPr>\\\" + bm, 1)\\n        else:\\n            new_p = p.replace(\\\">\\\", \\\">\\\" + bm, 1)  # 无 pPr 的段落：插在开标签后\\n        result = result[:s] + new_p + result[e:]\\n    return result, entries\\n\\n\\ndef toc_entry_xml(name, level, text, first, last):\\n    ind = '<w:ind w:left=\\\"420\\\"/>' if level == \\\"Heading2\\\" else \\\"\\\"\\n    runs = \\\"\\\"\\n    if first:\\n        runs += ('<w:r><w:fldChar w:fldCharType=\\\"begin\\\" w:dirty=\\\"true\\\"/></w:r>'\\n                 '<w:r><w:instrText xml:space=\\\"preserve\\\"> TOC \\\\\\\\o \\\"1-2\\\" \\\\\\\\h \\\\\\\\z \\\\\\\\u </w:instrText></w:r>'\\n                 '<w:r><w:fldChar w:fldCharType=\\\"separate\\\"/></w:r>')\\n    runs += (f'<w:hyperlink w:anchor=\\\"{name}\\\" w:history=\\\"1\\\">'\\n             f'<w:r><w:rPr><w:rFonts w:hint=\\\"eastAsia\\\"/></w:rPr><w:t xml:space=\\\"preserve\\\">{html.escape(text)}</w:t></w:r>'\\n             f'<w:r><w:tab/></w:r>'\\n             f'<w:r><w:fldChar w:fldCharType=\\\"begin\\\"/></w:r>'\\n             f'<w:r><w:instrText xml:space=\\\"preserve\\\"> PAGEREF {name} \\\\\\\\h </w:instrText></w:r>'\\n             f'<w:r><w:fldChar w:fldCharType=\\\"separate\\\"/></w:r>'\\n             f'<w:r><w:t>1</w:t></w:r>'\\n             f'<w:r><w:fldChar w:fldCharType=\\\"end\\\"/></w:r>'\\n             f'</w:hyperlink>')\\n    if last:\\n        runs += '<w:r><w:fldChar w:fldCharType=\\\"end\\\"/></w:r>'\\n    return ('<w:p><w:pPr>'\\n            '<w:tabs><w:tab w:val=\\\"right\\\" w:leader=\\\"dot\\\" w:pos=\\\"9026\\\"/></w:tabs>'\\n            f'{ind}'\\n            '<w:spacing w:after=\\\"80\\\"/>'\\n            '</w:pPr>' + runs + '</w:p>')\\n\\n\\ndef inject_toc_entries(doc_xml, entries):\\n    \\\"\\\"\\\"把 docx-js 的 TOC sdt（或裸 TOC 域段落）替换为：域起始+条目段落+域结束。幂等：条目已存在则不动。\\\"\\\"\\\"\\n    if \\\"PAGEREF _Toc_h0\\\" in doc_xml:\\n        return doc_xml  # 已注入过\\n    # 定位包含 TOC instrText 的 sdt\\n    sdt_m = None\\n    for m in re.finditer(r\\\"<w:sdt>.*?</w:sdt>\\\", doc_xml, DOT_ALL):\\n        if re.search(r\\\"<w:instrText[^>]*>[^<]*TOC \\\", m.group(0)):\\n            sdt_m = m\\n            break\\n    if sdt_m is None:\\n        # 裸段落形态：包含 TOC instrText 的段落\\n        for m in re.finditer(r\\\"<w:p\\\\b[^>]*>.*?</w:p>\\\", doc_xml, DOT_ALL):\\n            if re.search(r\\\"<w:instrText[^>]*>[^<]*TOC \\\", m.group(0)):\\n                sdt_m = m\\n                break\\n    if sdt_m is None:\\n        fail(2, \\\"未找到 TOC 域（需要 docx 生成时包含 TableOfContents）\\\")\\n    if not entries:\\n        fail(2, \\\"未找到 Heading1/Heading2 标题，无法生成目录条目\\\")\\n    block = \\\"\\\".join(\\n        toc_entry_xml(name, lv, tx, i == 0, i == len(entries) - 1)\\n        for i, (name, lv, tx) in enumerate(entries))\\n    return doc_xml[:sdt_m.start()] + block + doc_xml[sdt_m.end():]\\n\\n\\ndef set_update_fields(settings_xml):\\n    if \\\"<w:updateFields\\\" in settings_xml:\\n        return settings_xml\\n    tag = \\\"<w:updateFields w:val=\\\\\\\"true\\\\\\\"/>\\\"\\n    if \\\"<w:compat\\\" in settings_xml:\\n        return settings_xml.replace(\\\"<w:compat\\\", tag + \\\"<w:compat\\\", 1)\\n    m = re.search(r\\\"(<w:settings\\\\b[^>]*>)\\\", settings_xml)\\n    if not m:\\n        fail(3, \\\"settings.xml 结构异常\\\")\\n    return settings_xml[:m.end()] + tag + settings_xml[m.end():]\\n\\n\\ndef render_pdf(docx_path, outdir):\\n    r = subprocess.run(\\n        [\\\"soffice\\\", \\\"--headless\\\", \\\"--convert-to\\\", \\\"pdf\\\", \\\"--outdir\\\", outdir, docx_path],\\n        capture_output=True, text=True, timeout=180)\\n    pdf = os.path.join(outdir, os.path.splitext(os.path.basename(docx_path))[0] + \\\".pdf\\\")\\n    if not os.path.exists(pdf):\\n        fail(3, f\\\"LibreOffice 渲染失败: {r.stdout} {r.stderr}\\\")\\n    return pdf\\n\\n\\ndef pdf_pages_text(pdf):\\n    r = subprocess.run([\\\"pdftotext\\\", \\\"-enc\\\", \\\"UTF-8\\\", pdf, \\\"-\\\"],\\n                       capture_output=True, text=True, timeout=60)\\n    return [re.sub(r\\\"\\\\s+\\\", \\\"\\\", pg) for pg in r.stdout.split(\\\"\\\\f\\\")]\\n\\n\\ndef measure_pages(pdf, entries):\\n    \\\"\\\"\\\"返回 {name: 物理页号(1基)}。目录页=出现>=半数标题文本的页，正文搜索从其后开始。\\\"\\\"\\\"\\n    pages = pdf_pages_text(pdf)\\n    texts = [re.sub(r\\\"\\\\s+\\\", \\\"\\\", t) for _, _, t in entries]\\n    toc_page = None\\n    for i, pg in enumerate(pages):\\n        hits = sum(1 for t in texts if t and t in pg)\\n        if hits >= max(2, len(texts) // 2):\\n            toc_page = i\\n            break\\n    if toc_page is None:\\n        fail(3, \\\"未能在 PDF 中定位目录页（目录条目未渲染？）\\\")\\n    result = {}\\n    for (name, _, text), t in zip(entries, texts):\\n        page_no = None\\n        for i in range(toc_page + 1, len(pages)):\\n            if t in pages[i]:\\n                page_no = i + 1\\n                break\\n        if page_no is None:\\n            fail(3, f\\\"未能在正文中定位标题「{text}」\\\")\\n        result[name] = page_no\\n    return result, toc_page + 1, len([p for p in pages if p])\\n\\n\\ndef update_numbers(doc_xml, entries, page_map, offset):\\n    for name, _, _ in entries:\\n        shown = page_map[name] - offset\\n        if shown < 1:\\n            fail(3, f\\\"页码偏移异常：{name} 物理页 {page_map[name]}，offset {offset}\\\")\\n        # 我们自己注入的条目形态精确可控；宽松点允许 separate 与 w:t 之间有 rPr\\n        pat = re.compile(\\n            r\\\"( PAGEREF \\\" + re.escape(name) + r\\\" \\\\\\\\h </w:instrText></w:r>\\\"\\n            r\\\"<w:r><w:fldChar w:fldCharType=\\\\\\\"separate\\\\\\\"/></w:r>\\\"\\n            r\\\"<w:r>(?:<w:rPr>(?:(?!</w:rPr>).)*</w:rPr>)?<w:t[^>]*>)[^<]*(</w:t>)\\\",\\n            DOT_ALL)\\n        doc_xml, n = pat.subn(r\\\"\\\\g<1>\\\" + str(shown) + r\\\"\\\\g<2>\\\", doc_xml, count=1)\\n        if n != 1:\\n            fail(3, f\\\"未找到 {name} 的页码缓存文本（条目形态不符）\\\")\\n    return doc_xml\\n\\n\\ndef main(argv):\\n    ap = argparse.ArgumentParser(description=\\\"规范DOCX目录后处理（书签+条目+实测页码+updateFields）\\\")\\n    ap.add_argument(\\\"input\\\")\\n    ap.add_argument(\\\"output\\\")\\n    ap.add_argument(\\\"--offset\\\", type=int, default=None,\\n                    help=\\\"显示页码=物理页号-offset；默认自动：物理页号-首个标题物理页号+1（正文页码从1起算）\\\")\\n    ap.add_argument(\\\"--keep-work\\\", default=None, help=\\\"保留中间工作目录到指定路径（调试用）\\\")\\n    args = ap.parse_args(argv)\\n\\n    if not os.path.isfile(args.input):\\n        fail(2, f\\\"输入文件不存在: {args.input}\\\")\\n    work = tempfile.mkdtemp(prefix=\\\"fix_toc_\\\")\\n    if args.keep_work:\\n        shutil.rmtree(args.keep_work, ignore_errors=True)\\n        os.makedirs(args.keep_work, exist_ok=True)\\n\\n    try:\\n        files = read_zip(args.input)\\n        if \\\"word/document.xml\\\" not in files or \\\"word/settings.xml\\\" not in files:\\n            fail(2, \\\"不是有效的 docx（缺 document.xml/settings.xml）\\\")\\n        doc = files[\\\"word/document.xml\\\"].decode(\\\"utf-8\\\")\\n\\n        headings = find_headings(doc)\\n        doc, entries = inject_bookmarks(doc, headings)\\n        doc = inject_toc_entries(doc, entries)\\n        files[\\\"word/document.xml\\\"] = doc.encode(\\\"utf-8\\\")\\n        files[\\\"word/settings.xml\\\"] = set_update_fields(\\n            files[\\\"word/settings.xml\\\"].decode(\\\"utf-8\\\")).encode(\\\"utf-8\\\")\\n\\n        pass1 = os.path.join(work, \\\"pass1.docx\\\")\\n        write_zip(pass1, files)\\n        pdf = render_pdf(pass1, work)\\n        page_map, first_body_page, n_pages = measure_pages(pdf, entries)\\n        offset = args.offset if args.offset is not None else first_body_page - 1\\n\\n        doc = update_numbers(files[\\\"word/document.xml\\\"].decode(\\\"utf-8\\\"),\\n                             entries, page_map, offset)\\n        files[\\\"word/document.xml\\\"] = doc.encode(\\\"utf-8\\\")\\n        write_zip(args.output, files)\\n\\n        # 最终验证：能渲染 + 打印映射\\n        pdf2 = render_pdf(args.output, work)\\n        final_pages = len([p for p in pdf_pages_text(pdf2) if p])\\n        print(f\\\"fix_toc: OK 共{final_pages}页（渲染实测），正文页码偏移 offset={offset}\\\")\\n        for name, lv, text in entries:\\n            print(f\\\"  目录条目  {text}  ->  第 {page_map[name] - offset} 页\\\")\\n        return 0\\n    finally:\\n        if args.keep_work:\\n            shutil.copytree(work, os.path.join(args.keep_work, os.path.basename(work)),\\n                            dirs_exist_ok=True)\\n            print(f\\\"fix_toc: 中间文件保留在 {args.keep_work}\\\")\\n        else:\\n            shutil.rmtree(work, ignore_errors=True)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv[1:]))\\n\"\n}"}], "details": {}, "isError": true, "timestamp": 1792730