#!/usr/bin/env python3
"""本地TTS回退wrapper（供 make_video.py / tts_page.py 的 --tts-cmd 使用）。

用法:
  python tts_cmd.py --text "要朗读的文本" --output out.wav \
      [--engine auto|piper|edge|gtts] [--voice zh-CN-XiaoxiaoNeural]

引擎 auto 选择顺序（首个可用即用，全部失败退出码 1）:
  piper   离线优先；需音色模型：环境变量 PIPER_MODEL 指向 .onnx，
          或 ~/.local/share/piper 下有 .onnx（自动取第一个）。
          自动处理 piper 裸 raw 输出（补 WAV 头再转码），exit=0 但文件无效不再是坑。
  edge    edge-tts（在线微软，本环境常见可用；429/网络问题时换引擎或稍后重试）。
  gtts    gTTS（在线谷歌，需 pip install gtts；有 429 限流风险，失败频繁换前两者）。

输出统一归一化 44.1kHz 单声道 WAV，接口为 --text/--output，可直接作 --tts-cmd。
"""
import argparse, glob, os, shutil, subprocess, sys, wave


def sh(cmd):
    return subprocess.run([str(c) for c in cmd], capture_output=True, text=True,
                          env=dict(os.environ))


def valid_wav(path):
    try:
        with wave.open(path, "rb") as w:
            return w.getnframes() > 100
    except Exception:
        return False


def normalize(src, out):
    """任意可读音频 → 44.1kHz 单声道 pcm_s16le WAV。"""
    r = sh(["ffmpeg", "-y", "-v", "error", "-i", src,
            "-ar", "44100", "-ac", "1", "-c:a", "pcm_s16le", out])
    return r.returncode == 0 and valid_wav(out)


def piper_model():
    m = os.environ.get("PIPER_MODEL", "")
    if m and os.path.exists(m):
        return m
    for base in (os.path.expanduser("~/.local/share/piper"), "/opt/piper/voices"):
        hits = sorted(glob.glob(os.path.join(base, "**", "*.onnx"), recursive=True))
        if hits:
            return hits[0]
    return ""


def try_piper(text, out):
    exe = shutil.which("piper")
    if not exe:
        return False, "piper 未安装"
    model = piper_model()
    if not model:
        return False, "piper 无音色模型（设 PIPER_MODEL 或放 ~/.local/share/piper/*.onnx）"
    tmp = out + ".piper_tmp"
    r = subprocess.run([exe, "-m", model, "--output-raw"], input=text.encode("utf-8"),
                       stdout=open(tmp, "wb"), stderr=subprocess.PIPE,
                       env=dict(os.environ))
    if r.returncode != 0 or not os.path.exists(tmp):
        return False, f"piper 运行失败: {(r.stderr or b'').decode(errors='replace')[-200:]}"
    # 裸 s16le raw（22050Hz 单声道）补 WAV 头
    headered = out + ".piper_raw.wav"
    with wave.open(headered, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(os.environ.get("PIPER_RATE", "22050")))
        with open(tmp, "rb") as f:
            w.writeframes(f.read())
    os.remove(tmp)
    ok = normalize(headered, out)
    if os.path.exists(headered):
        os.remove(headered)
    return (ok, "" if ok else "piper 输出转码失败")


def try_edge(text, out, voice):
    exe = shutil.which("edge-tts")
    cmd = [exe] if exe else [sys.executable, "-m", "edge_tts"]
    if not exe:
        try:
            import edge_tts  # noqa: F401
        except ImportError:
            return False, "edge-tts 未安装"
    mp3 = out + ".mp3"
    r = sh(cmd + ["--voice", voice, "--text", text, "--write-media", mp3])
    if r.returncode != 0 or not os.path.exists(mp3) or os.path.getsize(mp3) < 200:
        err = (r.stderr or r.stdout or "").strip().splitlines()
        err = err[-1][:200] if err else f"exit={r.returncode}"
        return False, f"edge-tts 失败: {err}（429/网络问题时稍后重试或换引擎）"
    ok = normalize(mp3, out)
    if os.path.exists(mp3):
        os.remove(mp3)
    return (ok, "" if ok else "edge-tts 输出转码失败")


def try_gtts(text, out):
    try:
        from gtts import gTTS
    except ImportError:
        return False, "gTTS 未安装（pip install gtts）；注意 gTTS 有 429 限流风险，优先 piper/edge"
    mp3 = out + ".mp3"
    try:
        gTTS(text, lang="zh").save(mp3)
    except Exception as e:
        return False, f"gTTS 失败: {str(e)[:200]}（429 限流常见，换 piper/edge 引擎）"
    ok = normalize(mp3, out)
    if os.path.exists(mp3):
        os.remove(mp3)
    return (ok, "" if ok else "gTTS 输出转码失败")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--text", required=True)
    ap.add_argument("--output", required=True)
    ap.add_argument("--engine", default="auto", choices=["auto", "piper", "edge", "gtts"])
    ap.add_argument("--voice", default="zh-CN-XiaoxiaoNeural")
    args = ap.parse_args()

    chain = [args.engine] if args.engine != "auto" else ["piper", "edge", "gtts"]
    reasons = []
    for eng in chain:
        if eng == "piper":
            ok, why = try_piper(args.text, args.output)
        elif eng == "edge":
            ok, why = try_edge(args.text, args.output, args.voice)
        else:
            ok, why = try_gtts(args.text, args.output)
        if ok:
            print(f"tts_cmd: engine={eng} -> {args.output}")
            sys.exit(0)
        reasons.append(f"[{eng}] {why}")
        sys.stderr.write(f"tts_cmd: engine {eng} 不可用: {why}\n")
    print(f"tts_cmd: 全部引擎失败（{' | '.join(reasons)}）", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
