    def assertion_checks(values, at):
        targets = set()
        categories = []
        exhaustive = False
        values = seq(values, at, True)
        for i, a in enumerate(values):
            pos = at + '/' + str(i)
            a = obj(a, pos, ('kind', 'path'))
            kind = a.get('kind')
            path = a.get('path')
            if kind not in ASSERTIONS:
                add('unsupported_assertion:' + str(kind), pos)
                continue
            if path in ('stdout', 'stderr'):
                add('log_path_requires_dollar_prefix', pos)
            elif path not in ('$stdout', '$stderr'):
                relative(path, pos + '/path')
            if isinstance(path, str):
                targets.add(path)
            if 'count_of' in a or 'map_by' in a:
                add('undeclared_json_selection_semantics', pos)
            value = a.get('value', a.get('expected'))
            pointer = a.get('pointer', '')
            if not isinstance(pointer, str) or (pointer and (not pointer.startswith('/'))):
                add('invalid_json_pointer', pos)
            if kind in ('contains', 'not_contains', 'text_equals'):
                if not text(value) or value.strip().upper() in ('PASS', 'SUCCESS', 'OK', 'TRUE'):
                    add('vacuous_or_invalid_text_assertion', pos)
                exhaustive |= kind == 'text_equals'
            elif kind in ('json_equals', 'source_mapping', 'field_preservation'):
                if value is None:
                    add('expected_json_value_missing', pos)
                categories.append('source_mapping' if kind == 'source_mapping' else 'field_preservation')
                exhaustive |= pointer == ''
            elif kind == 'json_count':
                if type(value) is not int or value < 0:
                    add('json_count_value_invalid', pos)
                categories.append('record_count')
            elif kind == 'json_keys':
                if not isinstance(value, list) or not value or any((not text(x) for x in value)):
                    add('json_keys_value_invalid', pos)
            elif kind == 'explicit_error':
                categories.append('explicit_error')
            elif kind == 'sha256':
                if not re.fullmatch('[a-f0-9]{64}', str(value)):
                    add('expected_sha256_invalid', pos)
                exhaustive = True
            elif kind == 'zip_members':
                if not isinstance(value, list) or not value:
                    add('zip_members_must_be_nonempty_list', pos)
                else:
                    for member in value:
                        relative(member, pos + '/value')
                categories.append('artifact_structure')
            elif kind == 'zip_xml_contains':
                relative(a.get('member'), pos + '/member')
                if not text(value):
                    add('zip_xml_expected_text_missing', pos)
                categories.append('artifact_structure')
            elif kind == 'zip_member_count':
                if not text(a.get('pattern')) or type(value) is not int or value < 0:
                    add('zip_member_count_spec_invalid', pos)
                else:
                    try:
                        re.compile(a['pattern'])
                    except re.error:
                        add('zip_member_count_regex_invalid', pos)
                categories.append('artifact_structure')
        complete = exhaustive or {'record_count', 'source_mapping'} <= set(categories) or (categories.count('artifact_structure') >= 2 and any((isinstance(a, dict) and a.get('kind') == 'zip_xml_contains' for a in values)))
        return (targets, complete, categories)
