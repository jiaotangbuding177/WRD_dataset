        for i, argv in enumerate(commands):
            command(argv, at + '/commands/' + str(i))
        expected = c.get('expected_exit', 0)
        if type(expected) is not int or (kind != 'invalid_input' and expected != 0):
            add('invalid_expected_exit', at)
