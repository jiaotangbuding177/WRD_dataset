def pin(path):
    p = Path(path)
    raw = p.read_bytes()
    return {'path': str(p), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}

def read(path):
    return json.loads(Path(path).read_text(encoding='utf-8-sig'))

def directory_listing_pin(directory):
    """Pin the real immediate parent listing, never a nonexistent file."""
    directory = Path(directory).absolute()
    if any((p.is_symlink() for p in (directory, *directory.parents))) or not directory.is_dir():
        raise ValueError('unsafe_or_missing_parent_directory')
    entries = []
    for p in sorted(directory.iterdir(), key=lambda x: x.name):
        if p.is_symlink():
            raise ValueError('symlink_in_parent_directory')
        if p.is_file():
            actual = pin(p)
            entries.append({'name': p.name, 'kind': 'file', 'sha256': actual['sha256'], 'bytes': actual['bytes']})
        elif p.is_dir():
            entries.append({'name': p.name, 'kind': 'directory'})
        else:
            raise ValueError('unsupported_parent_directory_entry')
    digest = hashlib.sha256(json.dumps(entries, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()
    return {'kind': 'directory_listing', 'path': str(directory.resolve()), 'entries': entries, 'sha256': digest}

def absent_reference(root, relative_path, *, source_id, message_ids, source_record_sha256, source_material_pin, absent_root='INPUT'):
    """Build a newly generated invalid-input observation from actual directories.

 This observes absence in the current read-only input tree. It never claims
 there were historical bytes at that path and deliberately has no file pin.
 """
    if absent_root not in ('INPUT', 'FIXTURE'):
        raise ValueError('absence_root_must_be_readonly')
    if not isinstance(relative_path, str) or not relative_path or any((c in relative_path for c in ('\\', ':', '\x00'))) or PurePosixPath(relative_path).is_absolute() or any((p in ('', '.', '..') for p in relative_path.split('/'))):
        raise ValueError('unsafe_absent_relative_path')
    root = Path(root).absolute()
    target = root / relative_path
    if any((p.is_symlink() for p in (target, *target.parents))) or not target.resolve().is_relative_to(root.resolve()):
        raise ValueError('unsafe_absence_target')
    if target.exists():
        raise ValueError('declared_absent_path_actually_exists')
    return {'origin': 'absent_path', 'source_id': source_id, 'message_ids': message_ids, 'source_record_sha256': source_record_sha256, 'absent_root': absent_root, 'absent_relative_path': relative_path, 'parent_directory_pin': directory_listing_pin(target.parent), 'source_material_pin': source_material_pin, 'generated': True, 'purpose': 'invalid_input', 'derivation': 'New missing-path negative observed in the actual read-only input tree; no historical or nonexistent-file bytes are claimed.'}

