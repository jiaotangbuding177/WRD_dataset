            if '$stdout' in paths:
                stdout_assertions = [a for a in c.get('assertions', []) if isinstance(a, dict) and a.get('path') == '$stdout']
                _, stdout_complete, _ = assertion_checks(stdout_assertions, at + '/stdout_assertions')
                if not stdout_complete:
                    add('stdout_output_completeness_not_declared', at)
        elif expected == 0 and 'explicit_error' not in categories:
            add('invalid_input_silently_succeeds', at)
        if kind in ('normal', 'composition') and (not complete):
