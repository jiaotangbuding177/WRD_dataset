import json, hashlib, os, sys

BASE = "/workspace"
OUT = os.path.join(BASE, "outputs")
INP = os.path.join(BASE, "inputs", "conversations")

errors = []

def err(loc, msg):
    errors.append({"location": loc, "error": msg})

# Load inputs
sources = {}
for sid in ["conv_d1ef29d65e7a", "conv_41874c950938", "conv_246b5e915810"]:
    p = os.path.join(INP, sid + ".json")
    with open(p, encoding="utf-8") as f:
        d = json.load(f)
    sources[sid] = {m["id"]: m["content"] for m in d["messages"]}

VALID_DECISIONS = {"NEW_CANDIDATE", "REUSE_PARTIAL", "DEFER", "NO_VALUE"}
VALID_BASIS = {"explicit_user", "derived_quality"}
VALID_CHECK = {"literal", "structural", "semantic_review"}

def check_evidence(refs, loc, counter):
    for i, r in enumerate(refs or []):
        rl = f"{loc}.evidence_refs[{i}]"
        sid = r.get("source_id"); mid = r.get("message_id"); q = r.get("quote")
        if sid not in sources:
            err(rl, f"unknown source_id {sid}"); continue
        if mid not in sources[sid]:
            err(rl, f"unknown message_id {mid}"); continue
        if not isinstance(q, str) or not q.strip():
            err(rl, "empty quote"); continue
        counter["total"] += 1
        counter["by_source"][sid] = counter.get("by_source", {}).get(sid, 0) + 1
        if q not in sources[sid][mid]:
            err(rl, f"quote is NOT a contiguous substring of message content: {q[:50]!r}")
        else:
            counter["verified"] += 1

counter = {"total": 0, "verified": 0, "by_source": {}}

# ---- Load outputs ----
outs = {}
for name in ["source_profiles.json", "workflow_candidates.json", "source_only_rubric.json"]:
    p = os.path.join(OUT, name)
    try:
        with open(p, encoding="utf-8") as f:
            outs[name] = json.load(f)
    except Exception as e:
        err(name, f"JSON parse failure: {e}")

profiles = outs.get("source_profiles.json", {}).get("profiles", [])
cands = outs.get("workflow_candidates.json", {})
rubric = outs.get("source_only_rubric.json", {}).get("cases", [])

# 1. top-level non-empty
if not profiles: err("source_profiles.json", "profiles empty")
if not cands.get("candidates"): err("workflow_candidates.json", "candidates empty")
if not cands.get("source_decisions"): err("workflow_candidates.json", "source_decisions empty")
if not rubric: err("source_only_rubric.json", "cases empty")

# schemas/origins
if outs.get("source_profiles.json", {}).get("schema") != "wrd-v10-source-profiles-v1": err("source_profiles.json", "schema mismatch")
if cands.get("schema") != "wrd-v10-source-only-workflow-candidates-v1": err("workflow_candidates.json", "schema mismatch")
if outs.get("source_only_rubric.json", {}).get("schema") != "wrd-v10-source-only-rubric-v1": err("source_only_rubric.json", "schema mismatch")
for name, o in outs.items():
    if o.get("annotation_origin") != "fresh_source_only_native_teacher": err(name, "annotation_origin mismatch")
if cands.get("reuse_benefit_empirically_verified") is not False: err("workflow_candidates.json", "reuse_benefit flag must be false")

# 2. source coverage
expected_sources = set(sources.keys())
p_srcs = {p.get("source_id") for p in profiles}
if p_srcs != expected_sources: err("profiles", f"source coverage mismatch: {p_srcs}")

profile_units = set()
for p in profiles:
    if p.get("source_group_id") not in {"v10_group_78010452aa3b5495ae3b", "v10_group_e01ef7b301b343eaca00", "v10_group_5d20e289903cc4917b2e"}:
        err(p.get("source_id"), "bad source_group_id")
    if p.get("historical_persona_is_source_material") is not True: err(p.get("source_id"), "persona flag missing")
    for tu in p.get("task_units", []):
        key = (p["source_id"], tu["task_unit_id"])
        profile_units.add(key)
        loc = f"{p['source_id']}/{tu['task_unit_id']}"
        if not tu.get("request_summary", "").strip(): err(loc, "empty request_summary")
        check_evidence(tu.get("evidence_refs"), loc, counter)
        for fi, fa in enumerate(tu.get("facts", [])):
            if fa.get("epistemic_status") != "user_provided_not_independently_verified":
                err(f"{loc}.facts[{fi}]", "bad epistemic_status")
            if not fa.get("evidence_refs"): err(f"{loc}.facts[{fi}]", "fact without evidence")
            check_evidence(fa.get("evidence_refs"), f"{loc}.facts[{fi}]", counter)
        for ri, rq in enumerate(tu.get("requirements", [])):
            if not rq.get("evidence_refs"): err(f"{loc}.requirements[{ri}]", "requirement without evidence")
            check_evidence(rq.get("evidence_refs"), f"{loc}.requirements[{ri}]", counter)
        for ci, co in enumerate(tu.get("corrections", [])):
            if not co.get("evidence_refs"): err(f"{loc}.corrections[{ci}]", "correction without evidence")
            check_evidence(co.get("evidence_refs"), f"{loc}.corrections[{ci}]", counter)

cand_units = set()
for sd in cands.get("source_decisions", []):
    key = (sd.get("source_id"), sd.get("task_unit_id"))
    cand_units.add(key)
    if sd.get("decision") not in VALID_DECISIONS:
        err(f"source_decisions/{key}", f"bad decision {sd.get('decision')}")
    if sd.get("decision") in {"NEW_CANDIDATE", "REUSE_PARTIAL"} and not sd.get("candidate_id"):
        err(f"source_decisions/{key}", "missing candidate_id")
    check_evidence(sd.get("evidence_refs"), f"source_decisions/{key}", counter)
missing_dec = profile_units - cand_units
if missing_dec: err("source_decisions", f"task units without decision: {sorted(missing_dec)}")

# 3. workflow dependency validation (only existing predecessors, no cycles)
valid_candidate_ids = {c.get("candidate_id") for c in cands.get("candidates", [])}
for c in cands.get("candidates", []):
    cid = c.get("candidate_id")
    if c.get("decision") not in VALID_DECISIONS: err(f"candidate/{cid}", "bad decision")
    for ref in c.get("source_task_units", []):
        if (ref.get("source_id"), ref.get("task_unit_id")) not in profile_units:
            err(f"candidate/{cid}", f"unknown source_task_unit {ref}")
    for sd_ref in c.get("non_applicable_or_partial_sources", []):
        if isinstance(sd_ref, dict) and (sd_ref.get("source_id"), sd_ref.get("task_unit_id")) not in profile_units:
            err(f"candidate/{cid}", f"unknown non_applicable unit {sd_ref}")
    check_evidence(c.get("evidence_refs"), f"candidate/{cid}", counter)
    steps = {s.get("step_id") for s in c.get("workflow", [])}
    dep_edges = {}
    for s in c.get("workflow", []):
        sid_ = s.get("step_id")
        deps = s.get("depends_on", [])
        for d in deps:
            if d not in steps:
                err(f"candidate/{cid}/{sid_}", f"depends_on unknown step {d}")
        dep_edges[sid_] = [d for d in deps if d in steps]
        for fld in ("inputs", "outputs"):
            if not isinstance(s.get(fld), list): err(f"candidate/{cid}/{sid_}", f"{fld} not list")
    # cycle check (DFS)
    state = {}
    def dfs(n):
        state[n] = 1
        for m in dep_edges.get(n, []):
            if state.get(m) == 1: err(f"candidate/{cid}", f"dependency cycle at {n}->{m}")
            elif state.get(m) is None: dfs(m)
        state[n] = 2
    for n in dep_edges: 
        if state.get(n) is None: dfs(n)

for sd in cands.get("source_decisions", []):
    cid = sd.get("candidate_id")
    if cid and cid not in valid_candidate_ids:
        err(f"source_decisions/{sd.get('source_id')}/{sd.get('task_unit_id')}", f"candidate_id {cid} not defined")

# 4. rubric
rubric_units = set()
for case in rubric:
    key = (case.get("source_id"), case.get("task_unit_id"))
    rubric_units.add(key)
    loc = f"rubric/{key}"
    if not case.get("output_boundary", "").strip(): err(loc, "empty output_boundary")
    for cr in case.get("criteria", []):
        cl = f"{loc}/{cr.get('criterion_id')}"
        if cr.get("basis") not in VALID_BASIS: err(cl, f"bad basis {cr.get('basis')}")
        if cr.get("check_method") not in VALID_CHECK: err(cl, f"bad check_method {cr.get('check_method')}")
        if cr.get("basis") == "derived_quality" and not (cr.get("derivation_reason") or "").strip():
            err(cl, "derived_quality without derivation_reason")
        if not cr.get("anchors") or not all(k in cr["anchors"] for k in ("0", "0.5", "1")):
            err(cl, "anchors missing 0/0.5/1")
        if not cr.get("evidence_refs"): err(cl, "criterion without evidence")
        check_evidence(cr.get("evidence_refs"), cl, counter)
missing_cases = profile_units - rubric_units
if missing_cases: err("rubric", f"task units without rubric case: {sorted(missing_cases)}")

# 5. SHA of outputs
shas = {}
for name in ["source_profiles.json", "workflow_candidates.json", "source_only_rubric.json"]:
    p = os.path.join(OUT, name)
    h = hashlib.sha256(open(p, "rb").read()).hexdigest()
    shas[name] = h

status = "pass" if not errors else "fail"
report = {
    "schema": "wrd-v10-self-check-v1",
    "annotation_origin": "fresh_source_only_native_teacher",
    "status": status,
    "inputs_read": {sid: len(sources[sid]) for sid in sources},
    "coverage": {
        "profiles": len(profiles),
        "profile_task_units": len(profile_units),
        "candidates": len(cands.get("candidates", [])),
        "source_decisions": len(cands.get("source_decisions", [])),
        "rubric_cases": len(rubric)
    },
    "evidence_counts": {
        "total_refs": counter["total"],
        "verified_contiguous_quote": counter["verified"],
        "by_source": counter["by_source"]
    },
    "output_file_sha256": shas,
    "errors": errors,
    "semantic_quality_note": "pass only proves structure/quote/enum/dependency checks; it does not certify semantic quality or any reuse benefit"
}
with open(os.path.join(OUT, "self_check.json"), "w", encoding="utf-8") as f:
    json.dump(report, f, ensure_ascii=False, indent=2)

print("STATUS:", status)
print("evidence refs:", counter["total"], "verified:", counter["verified"])
print("errors:", len(errors))
for e in errors[:40]:
    print("  -", e["location"], "::", e["error"])
