{"content":"{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"wrd-draft-v1\",\n  \"title\": \"按用途成稿（draft）schema\",\n  \"description\": \"成稿 JSON 是账本到交付文本之间的可校验中间产物：文本 + fact ID 引用 + 声明数字 + 长度/段落/交付状态。目标Word未提供时只交文本并显式声明 TEXT_ONLY 状态。\",\n  \"type\": \"object\",\n  \"required\": [\"schema\", \"draft_id\", \"document_kind\", \"text\", \"fact_refs\"],\n  \"properties\": {\n    \"schema\": {\"const\": \"wrd-draft-v1\"},\n    \"draft_id\": {\"type\": \"string\"},\n    \"document_kind\": {\n      \"enum\": [\"official_report\", \"one_paragraph\"],\n      \"description\": \"official_report=官方汇报；one_paragraph=一段话成稿（默认段落上限1）。\"\n    },\n    \"text\": {\"type\": \"string\", \"minLength\": 1},\n    \"word_target\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"用户给了字数要求时必填。counting_mode 缺省为 non_whitespace（去空白字符计数），口径必须对用户可解释。\",\n      \"properties\": {\n        \"char_limit\": {\"type\": \"integer\", \"minimum\": 1},\n        \"counting_mode\": {\"enum\": [\"all_characters\", \"non_whitespace\"]}\n      }\n    },\n    \"paragraph_constraints\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"min\": {\"type\": \"integer\", \"minimum\": 1},\n        \"max\": {\"type\": [\"integer\", \"null\"]}\n      }\n    },\n    \"word_delivery\": {\n      \"type\": \"object\",\n      \"description\": \"交付状态必须显式。target_provided=false 时校验器输出 TEXT_ONLY_NO_WORD_TARGET。\",\n      \"properties\": {\n        \"target_provided\": {\"type\": \"boolean\"},\n        \"written\": {\"type\": \"boolean\"},\n        \"note\": {\"type\": \"string\"}\n      }\n    },\n    \"fact_refs\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"description\": \"成稿使用的账本事实 ID 与陈述角色。as_type 闭包由校验器检查。\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"fact_id\", \"as_type\"],\n        \"properties\": {\n          \"fact_id\": {\"type\": \"string\"},\n          \"as_type\": {\n            \"enum\": [\"achieved_fact\", \"planned_goal\", \"context\", \"requirement\"],\n            \"description\": \"planned_goal 事实只允许 as_type=planned_goal；声明成 achieved_fact 为硬错误。\"\n          }\n        }\n      }\n    },\n    \"declared_numbers\": {\n      \"type\": \"array\",\n      \"description\": \"成稿文本中使用的每个核心数字逐条声明：value/unit/subject 必须与账本一致，且数值必须出现在文本中。未声明的文本数字会被列入 NEEDS_SEMANTIC_REVIEW。\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"fact_id\", \"value\"],\n        \"properties\": {\n          \"fact_id\": {\"type\": \"string\"},\n          \"value\": {\"type\": \"string\"},\n          \"unit\": {\"type\": [\"string\", \"null\"]},\n          \"subject\": {\"type\": [\"string\", \"null\"]}\n        }\n      }\n    },\n    \"notes\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n  }\n}\n","role":"tool","tool_call_id":"call88543c00a1034a30b92e8223a9f567e9"}
