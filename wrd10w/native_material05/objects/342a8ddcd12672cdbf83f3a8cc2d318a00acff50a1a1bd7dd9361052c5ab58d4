ubstring of message content: {q[:50]!r}\")\n        else:\n            counter[\"verified\"] += 1\n\ncounter = {\"total\": 0, \"verified\": 0, \"by_source\": {}}\n\n# ---- Load outputs ----\nouts = {}\nfor name in [\"source_profiles.json\", \"workflow_candidates.json\", \"source_only_rubric.json\"]:\n    p = os.path.join(OUT, name)\n    try:\n        with open(p, encoding=\"utf-8\") as f:\n            outs[name] = json.load(f)\n    except Exception as e:\n        err(name, f\"JSON parse failure: {e}\")\n\nprofiles = outs.get(\"source_profiles.json\", {}).get(\"profiles\", [])\ncands = outs.get(\"workflow_candidates.json\", {})\nrubric = outs.get(\"source_only_rubric.json\", {}).get(\"cases\", [])\n\n# 1. top-level non-empty\nif not profiles: err(\"source_profiles.json\", \"profiles empty\")\nif not cands.get(\"candidates\"): err(\"workflow_candidates.json\", \"candidates empty\")\nif not cands.get(\"source_decisions\"): err(\"workflow_candidates.json\", \"source_decisions empty\")\nif not rubric: err(\"source_only_rubric.json\", \"cases empty\")\n\n# schemas/origins\nif outs.get(\"source_profiles.json\", {}).get(\"schema\") != \"wrd-v10-source-profiles-v1\": err(\"source_profiles.json\", \"schema mismatch\")\nif cands.get(\"schema\") != \"wrd-v10-source-only-workflow-candidates-v1\": err(\"workflow_candidates.json\", \"schema mismatch\")\nif outs.get(\"source_only_rubric.json\", {}).get(\"schema\") != \"wrd-v10-source-only-rubric-v1\": err(\"source_only_rubric.json\", \"schema mismatch\")\nfor name, o in outs.items():\n    if o.get(\"annotation_origin\") != \"fresh_source_only_native_teacher\": err(name, \"annotation_origin mismatch\")\nif cands.get(\"reuse_benefit_empirically_verified\") is not False: err(\"workflow_candidates.json\", \"reuse_benefit flag must be false\")\n\n# 2. source coverage\nexpected_sources = set(sources.keys())\np_srcs = {p.get(\"source_id\") for p in profiles}\nif p_srcs != expected_sources: err(\"profiles\", f\"source coverage mismatch: {p_srcs}\")\n\nprofile_units = set()\nfor p in profiles:\n    if p.get(\"source_group_id\") not in {\"v10_group_78010452aa3b5495ae3b\", \"v10_group_e01ef7b301b343eaca00\", \"v10_group_5d20e289903cc4917b2e\"}:\n        err(p.get(\"source_id\"), \"bad source_group_id\")\n    if p.get(\"historical_persona_is_source_material\") is not True: err(p.get(\"source_id\"), \"persona flag missing\")\n    for tu in p.get(\"task_units\", []):\n        key = (p[\"source_id\"], tu[\"task_unit_id\"])\n        profile_units.add(key)\n        loc = f\"{p['source_id']}/{tu['task_unit_id']}\"\n        if not tu.get(\"request_summary\", \"\").strip(): err(loc, \"empty request_summary\")\n        check_evidence(tu.get(\"evidence_refs\"), loc, counter)\n        for fi, fa in enumerate(tu.get(\"facts\", [])):\n            if fa.get(\"epistemic_status\") != \"user_provided_not_independently_verified\":\n                err(f\"{loc}.facts[{fi}]\", \"bad epistemic_status\")\n            if not fa.get(\"evidence_refs\"): err(f\"{loc}.facts[{fi}]\", \"fact without evidence\")\n            check_evidence(fa.get(\"evidence_refs\"), f\"{loc}.facts[{fi}]\", counter)\n        for ri, rq in enumerate(tu.get(\"requirements\", [])):\n            if not rq.get(\"evidence_refs\"): err(f\"{loc}.requirements[{ri}]\", \"requirement without evidence\")\n            check_evidence(rq.get(\"evidence_refs\"), f\"{loc}.requirements[{ri}]\", counter)\n        for ci, co in enumerate(tu.get(\"corrections\", [])):\n            if not co.get(\"evidence_refs\"): err(f\"{loc}.corrections[{ci}]\", \"correction without evidence\")\n            check_evidence(co.get(\"evidence_refs\"), f\"{loc}.corrections[{ci}]\", counter)\n\ncand_units = set()\nfor sd in cands.get(\"source_decisions\", []):\n    key = (sd.get(\"source_id\"), sd.get(\"task_unit_id\"))\n    cand_units.add(key)\n    if sd.get(\"decision\") not in VALID_DECISIONS:\n        err(f\"source_decisions/{key}\", f\"bad decision {sd.get('decision')}\")\n    if sd.get(\"decision\") in {\"NEW_CANDIDATE\", \"REUSE_PARTIAL\"} and not sd.get(\"candidate_id\"):\n        err(f\"source_decisions/{key}\", \"missing candidate_id\")\n    check_evidence(sd.get(\"evidence_refs\"), f\"source_decisions/{key}\", counter)\nmissing_dec = profile_units - cand_units\nif missing_dec: err(\"source_decisions\", f\"task units without decision: {sorted(missing_dec)}\")\n\n# 3. workflow dependency validation (only existing predecessors, no cycles)\nvalid_candidate_ids = {c.get(\"candidate_id\") for c in cands.get(\"candidates\", [])}\nfor c in cands.get(\"candidates\", []):\n    cid = c.get(\"candidate_id\")\n    if c.get(\"decision\") not in VALID_DECISIONS: err(f\"candidate/{cid}\", \"bad decision\")\n    for ref in c.get(\"source_task_units\", []):\n        if (ref.get(\"source_id\"), ref.get(\"task_unit_id\")) not in profile_units:\n            err(f\"candidate/{cid}\", f\"unknown source_task_unit {ref}\")\n    for sd_ref in c.get(\"non_applicable_or_partial_sources\", []):\n        if isinstance(sd_ref, dict) and (sd_ref.get(\"source_id\"), sd_ref.get(\"task_unit_id\")) not in profile_units:\n            err(f\"candidate/{cid}\", f\"unknown non_applicable unit {sd_ref}\")\n    check_evidence(c.get(\"evidence_refs\"), f\"candidate/{cid}\", counter)\n    steps = {s.get(\"step_id\") for s in c.get(\"workflow\", [])}\n    dep_edges = {}\n    for s in c.get(\"workflow\", []):\n        sid_ = s.get(\"step_id\")\n        deps = s.get(\"depends_on\", [])\n        for d in deps:\n            if d not in steps:\n                err(f\"candidate/{cid}/{sid_}\", f\"depends_on unknown step {d}\")\n        dep_edges[sid_] = [d for d in deps if d in steps]\n        for fld in (\"inputs\", \"outputs\"):\n            if not isinstance(s.get(fld), list): err(f\"candidate/{cid}/{sid_}\", f\"{fld} not list\")\n    # cycle check (DFS)\n    state = {}\n    def dfs(n):\n        state[n] = 1\n        for m in dep_edges.get(n, []):\n            if state.get(m) == 1: err(f\"candidate/{cid}\", f\"dependency cycle at {n}->{m}\")\n            elif state.get(m) is None: dfs(m)\n        state[n] = 2\n    for n in dep_edges: \n        if state.get(n) is None: dfs(n)\n\nfor sd in cands.get(\"source_decisions\", []):\n    cid = sd.get(\"candidate_id\")\n    if cid and cid not in valid_candidate_ids:\n        err(f\"source_decisions/{sd.get('source_id')}/{sd.get('task_unit_id')}\", f\"candidate_id {cid} not defined\")\n\n# 4. rubric\nrubric_units = set()\nfor case in rubric:\n    key = (case.get(\"source_id\"), case.get(\"task_unit_id\"))\n    rubric_units.add(key)\n    loc = f\"rubric/{key}\"\n    if not case.get(\"output_boundary\", \"\").strip(): err(loc, \"empty output_boundary\")\n    for cr in case.get(\"criteria\", []):\n        cl = f\"{loc}/{cr.get('criterion_id')}\"\n        if cr.get(\"basis\") not in VALID_BASIS: err(cl, f\"bad basis {cr.get('basis')}\")\n        if cr.get(\"check_method\") not in VALID_CHECK: err(cl, f\"bad check_method {cr.get('check_method')}\")\n        if cr.get(\"basis\") == \"derived_quality\" and not (cr.get(\"derivation_reason\") or \"\").strip():\n            err(cl, \"derived_quality without derivation_reason\")\n        if not cr.get(\"anchors\") or not all(k in cr[\"anchors\"] for k in (\"0\", \"0.5\", \"1\")):\n            err(cl, \"anchors missing 0/0.5/1\")\n        if not cr.get(\"evidence_refs\"): err(cl, \"criterion without evidence\")\n        check_evidence(cr.get(\"evidence_refs\"), cl, counter)\nmissing_cases = profile_units - rubric_units\nif missing_cases: err(\"rubric\", f\"task units without rubric case: {sorted(missing_cases)}\")\n\n# 5. SHA of outputs\nshas = {}\nfor name in [\"source_profiles.json\", \"workflow_candidates.json\", \"source_only_rubric.json\"]:\n    p = os.path.join(OUT, name)\n    h = hashlib.sha256(open(p, \"rb\").read()).hexdigest()\n    shas[name] = h\n\nstatus = \"pass\" if not errors else \"fail\"\nreport = {\n    \"schema\": \"wrd-v10-self-check-v1\",\n    \"annotation_origin\": \"fresh_source_only_native_teacher\",\n    \"status\": status,\n    \"inputs_read\": {sid: len(sources[sid]) for sid in sources},\n    \"coverage\": {\n        \"profiles\": len(profiles),\n        \"profile_task_units\": len(profile_units),\n        \"candidates\": len(cands.get(\"candidates\", [])),\n        \"source_decisions\": len(cands.get(\"source_decisions\", [])),\n        \"rubric_cases\": len(rubric)\n    },\n    \"evidence_counts\": {\n        \"total_refs\": counter[\"total\"],\n        \"verified_contiguous_quote\": counter[\"verified\"],\n        \"by_source\": counter[\"by_source\"]\n    },\n    \"output_file_sha256\": shas,\n    \"errors\": errors,\n    \"semantic_quality_note\": \"pass only proves structure/quote/enum/dependency checks; it does not certify semantic quality or any reuse benefit\"\n}\nwith open(os.path.join(OUT, \"self_check.json\"), \"w\", encoding=\"utf-8\") as f:\n    json.dump(report, f, ensure_ascii=False, indent=2)\n\nprint(\"STATUS:\", status)\nprint(\"evidence refs:\", counter[\"total\"], \"verified:\", counter[\"verified\"])\nprint(\"errors:\", len(errors))\nfor e in errors[:40]:\n    print(\"  -\", e[\"location\"], \"::\", e[\"error\"])\nEOF\nmkdir -p /workspace/tmp && python /workspace/tmp_selfcheck.py", "workdir": "/workspace"}}], "api": "openai-completions", "provider": "ecnu", "model": "glm-5.3-flash", "usage": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 0, "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0}}, "stopReason": "toolUse", "timestamp": 1793033874974, "responseId": "chatcmpl-1793033875000", "openclawDelivery": {"textPhaseRequiresTerminal": true}, "__openclaw": {"runId": "70440373-0506-42d3-ad0c-4a77f31a11a0"}}}
