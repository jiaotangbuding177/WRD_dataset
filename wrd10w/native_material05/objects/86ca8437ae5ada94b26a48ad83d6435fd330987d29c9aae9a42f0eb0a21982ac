{"type": "message", "id": "461cc3d5-669e-4596-b96b-f1af130b735f", "parentId": "e4027dda-491b-477e-80dc-2d982fd0b71e", "timestamp": "2026-10-27T05:35:07.430Z", "message": {"role": "assistant", "content": [{"type": "text", "text": "`apply_patch` is failing here; I'll write the full fixed files directly.", "textSignature": "{\"v\":1,\"id\":\"commentary-0-207928f437764fa4be9db6ba\",\"phase\":\"commentary\"}"}, {"type": "toolCall", "id": "callb27c3d6252ca4b3299af4082dc77563a", "name": "write", "arguments": {"content": "#!/usr/bin/env python3\n\"\"\"Shared CV PDF extraction helpers for the cv-jd-interview-screening skill.\n\nDesign rules:\n- Explicit errors (missing/empty/corrupt/zero-page PDF, no text layer) are\n  returned, never fabricated into an empty success.\n- Text is returned per page; candidate identity is anchored by file content\n  (sha256), never by filename conventions.\n- Whitespace normalization is shared with evidence_check.py so literal quotes\n  are matched identically in both tools.\n- Display filtering (watermark heuristic) applies to the cleaned text/lines\n  only; raw per-page text is retained so legitimate evidence is never erased\n  and literal quote checks always see the real PDF text.\n\"\"\"\n\nimport hashlib\nimport re\nimport sys\nfrom pathlib import Path\n\ntry:\n    import pymupdf\nexcept ImportError:  # pragma: no cover\n    pymupdf = None\n\n\nclass ExtractError(Exception):\n    \"\"\"Raised with a precise reason when a PDF cannot be extracted.\"\"\"\n\n\n# A watermark line: a single long alphanumeric token alone on one line,\n# typical of resume-platform trackers. Dropped from cleaned (display) text.\n_WATERMARK_RE = re.compile(r\"^[A-Za-z0-9_-]{24,}$\")\n\n\ndef normalize(text):\n    \"\"\"Collapse all whitespace so quotes match across PDF line breaks.\"\"\"\n    return re.sub(r\"\\s+\", \"\", text)\n\n\ndef clean_page_text(raw):\n    lines = []\n    for line in raw.splitlines():\n        stripped = line.strip()\n        if not stripped:\n            continue\n        if _WATERMARK_RE.match(stripped):\n            continue\n        lines.append(stripped)\n    return lines\n\n\ndef extract_pdf(path):\n    \"\"\"Extract per-page text from one PDF path. Raises ExtractError.\"\"\"\n    if pymupdf is None:\n        raise ExtractError(\"pymupdf not available in this environment\")\n    p = Path(path)\n    if not p.exists():\n        raise ExtractError(f\"file not found: {p}\")\n    try:\n        data = p.read_bytes()\n    except OSError as exc:\n        raise ExtractError(f\"unreadable file: {p}: {exc}\")\n    if len(data) == 0:\n        raise ExtractError(f\"empty file (0 bytes): {p}\")\n    if not data.startswith(b\"%PDF-\"):\n        raise ExtractError(f\"not a PDF (bad header): {p}\")\n    try:\n        doc = pymupdf.open(stream=data, filetype=\"pdf\")\n    except Exception as exc:\n        raise ExtractError(f\"corrupt/unopenable PDF: {p}: {exc}\")\n    if doc.page_count == 0:\n        raise ExtractError(f\"PDF has zero pages: {p}\")\n    pages = []\n    saw_any_text = False\n    for i, page in enumerate(doc):\n        raw = page.get_text()\n        if raw.strip():\n            saw_any_text = True\n        cleaned = clean_page_text(raw)\n        pages.append({\n            \"page\": i + 1,\n            \"lines\": cleaned,\n            \"text\": \"\\n\".join(cleaned),\n            # Unfiltered page text is retained so display filtering can never\n            # erase legitimate evidence (literal quotes validate against it).\n            \"raw_text\": raw,\n        })\n    doc.close()\n    if not saw_any_text:\n        # No text layer anywhere: a scanned/image-only PDF. This is an explicit\n        # unusable state (needs OCR), never a quiet empty success.\n        raise ExtractError(\n            f\"no usable text layer (scanned image; needs OCR): {p}\")\n    sha = hashlib.sha256(data).hexdigest()\n    identity_lines = pages[0][\"lines\"][:6]\n    return {\n        \"file\": str(p),\n        \"candidate_id\": \"cv_\" + sha[:12],\n        \"sha256\": sha,\n        \"bytes\": len(data),\n        \"page_count\": len(pages),\n        \"identity_lines\": identity_lines,\n        \"pages\": pages,\n    }\n\n\ndef extract_many(paths):\n    \"\"\"Extract a batch. Returns (results, errors); candidates never mix\n    because each result carries its own candidate_id and page list.\"\"\"\n    results, errors = [], []\n    for path in paths:\n        try:\n            results.append(extract_pdf(path))\n        except ExtractError as exc:\n            errors.append({\"file\": str(path), \"error\": str(exc)})\n    return results, errors\n\n\ndef find_quote(cv, quote, page=None):\n    \"\"\"Locate a normalized literal quote. Returns dict with ok/reason and the\n    page(s) where the quote actually occurs (for mismatch diagnostics).\n    Matching runs against each page's raw_text so display-side filtering\n    (e.g. the watermark heuristic) cannot hide real PDF text from evidence\n    checks.\"\"\"\n    norm = normalize(quote)\n    if not norm:\n        return {\"ok\": False, \"reason\": \"empty quote\"}\n    hits = [\n        pg[\"page\"] for pg in cv[\"pages\"]\n        if norm in normalize(pg.get(\"raw_text\", pg[\"text\"]))\n    ]\n    if page is not None and (page < 1 or page > cv[\"page_count\"]):\n        return {\n            \"ok\": False,\n            \"reason\": f\"page {page} out of range (1..{cv['page_count']})\",\n            \"found_pages\": hits,\n        }\n    if page is not None:\n        if page in hits:\n            return {\"ok\": True, \"page\": page}\n        return {\"ok\": False, \"reason\": \"quote not on claimed page\", \"found_pages\": hits}\n    if hits:\n        return {\"ok\": True, \"page\": hits[0]}\n    return {\"ok\": False, \"reason\": \"quote not found in document\", \"found_pages\": []}\n\n\nif __name__ == \"__main__\":\n    print(\"cvlib is a library; run cv_extract.py or evidence_check.py\", file=sys.stderr)\n    sys.exit(1)\n", "path": 