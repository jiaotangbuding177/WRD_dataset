urn 2\n    if not isinstance(claims, list):\n        print(json.dumps({\"ok\": False, \"error\": \"claims must be a JSON array\"},\n                         ensure_ascii=False))\n        return 2\n\n    cache = {}\n    report, any_fail = [], False\n    for idx, claim in enumerate(claims):\n        entry = {\"index\": idx, \"file\": claim.get(\"file\"), \"ok\": False}\n        path = claim.get(\"file\")\n        if not path:\n            entry[\"reason\"] = \"claim missing 'file'\"\n            any_fail = True\n        else:\n            if path not in cache:\n                try:\n                    cache[path] = (cvlib.extract_pdf(path), None)\n                except cvlib.ExtractError as exc:\n                    cache[path] = (None, str(exc))\n            cv, err = cache[path]\n            if err:\n                entry[\"reason\"] = \"file error: \" + err\n                any_fail = True\n            else:\n                entry[\"candidate_id\"] = cv[\"candidate_id\"]\n                res = cvlib.find_quote(cv, claim.get(\"quote\", \"\"), claim.get(\"page\"))\n                entry.update(res)\n                if not res[\"ok\"]:\n                    any_fail = True\n        report.append(entry)\n\n    out = {\"ok\": not any_fail, \"claims\": report}\n    payload = json.dumps(out, ensure_ascii=False, indent=2)\n    if args.json_out:\n        Path(args.json_out).write_text(payload, encoding=\"utf-8\")\n    print(payload)\n    return 0 if not any_fail else 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}], "details": {"kind": "text", "content": "#!/usr/bin/env python3\n\"\"\"Validate literal quotes cited from CV PDFs (quote/page/candidate claims).\n\nUsage:\n  evidence_check.py CLAIMS.json [--json OUT.json]\n\nCLAIMS.json: array of\n  [{\"file\": \"path/to/cv.pdf\", \"quote\": \"literal text from the CV\",\n    \"page\": 2}, ...]                 # page optional but recommended\nQuotes are whitespace-normalized (line breaks inside a quote are fine).\