{"content":"#!/usr/bin/env node\n/**\n * verify_animation.mjs —— 实际渲染验证生成的 HTML 动画。\n * 检查: 加载无控制台错误; 播放中画面持续变化; 暂停后停止变化; 继续恢复; 重置后 HUD 时间归零。\n * 用法: node verify_animation.mjs PAGE.html --screenshot out.png [--out result.json] [--url-base http://127.0.0.1:PORT]\n * 退出码: 0 全部通过; 1 有检查失败或运行错误。\n */\nimport { createRequire } from 'node:module';\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nconst require = createRequire(import.meta.url);\nlet chromium;\ntry {\n  ({ chromium } = require('playwright'));\n} catch (e) {\n  console.error('verify_animation: 无法加载 playwright: ' + e.message);\n  process.exit(1);\n}\n\nfunction arg(name, fallback = null) {\n  const i = process.argv.indexOf('--' + name);\n  return i > 0 ? process.argv[i + 1] : fallback;\n}\n\nconst pagePath = process.argv[2];\nif (!pagePath || !fs.existsSync(pagePath)) {\n  console.error('verify_animation: 请提供存在的 HTML 路径');\n  process.exit(1);\n}\nconst screenshot = arg('screenshot', 'screenshot.png');\nconst resultOut = arg('out', null);\nconst urlBase = arg('url-base', null); // 如提供则用 http 而非 file://\n\nconst url = urlBase\n  ? urlBase.replace(/\\/$/, '') + '/' + path.basename(pagePath)\n  : 'file://' + path.resolve(pagePath);\n\nconst result = {\n  url,\n  consoleErrors: [],\n  pageErrors: [],\n  checks: {},\n  ok: false,\n};\n\nfunction fail(msg) {\n  result.checks[msg] = false;\n}\nfunction pass(msg, detail) {\n  result.checks[msg] = detail === undefined ? true : detail;\n}\n\nconst browser = await chromium.launch({\n  executablePath: '/usr/bin/chromium',\n  args: ['--no-sandbox'],\n});\ntry {\n  const page = await browser.newPage({ viewport: { width: 1100, height: 760 } });\n  page.on('console', (m) => {\n    if (m.type() === 'error') result.consoleErrors.push(m.text());\n  });\n  page.on('pageerror', (e) => result.pageErrors.push(String(e)));\n\n  await page.goto(url, { waitUntil: 'load', timeout: 15000 });\n\n  const hasWrd = await page.evaluate(() => typeof window.WRD === 'object' && !!window.WRD.Loop);\n  hasWrd ? pass('WRD scaffold 已加载') : fail('WRD scaffold 已加载');\n\n  const bootError = await page.$('.wrd-error');\n  bootError ? fail('无启动错误') : pass('无启动错误');\n  if (bootError) {\n    result.bootError = (await bootError.textContent()).trim();\n  }\n\n  // 播放中: rAF 帧数增长 + 画布像素实际变化\n  await page.waitForTimeout(400);\n  const shot = async () =>\n    page.evaluate(() => document.getElementById('wrd-canvas').toDataURL());\n  const f1 = await page.evaluate(() => window.WRD.frames);\n  const c1 = await shot();\n  await page.waitForTimeout(800);\n  const f2 = await page.evaluate(() => window.WRD.frames);\n  const c2 = await shot();\n  (f2 > f1) ? pass('播放中帧数增长', { f1, f2 }) : fail('播放中帧数增长');\n  (c1 !== c2) ? pass('播放中画面内容变化') : fail('播放中画面内容变化');\n\n  // HUD 时间在走\n  const hudTime = () =>\n    page.evaluate(() => {\n      const rows = document.querySelectorAll('.wrd-hud-row');\n      for (const r of rows) {\n        if (r.children[0] && r.children[0].textContent.includes('时间')) {\n          return parseFloat(r.children[1].textContent);\n        }\n      }\n      return NaN;\n    });\n  const t1 = await hudTime();\n  await page.waitForTimeout(600);\n  const t2 = await hudTime();\n  (!Number.isNaN(t1) && t2 > t1) ? pass('HUD 时间推进', { t1, t2 }) : fail('HUD 时间推进');\n\n  // 暂停后画面与时间冻结\n  await page.click('.wrd-btn-toggle');\n  await page.waitForTimeout(300);\n  const label = await page.textContent('.wrd-btn-toggle');\n  label.includes('继续') ? pass('暂停按钮切换为“继续”', label.trim()) : fail('暂停按钮切换为“继续”');\n  const p1 = await page.evaluate(() => window.WRD.frames);\n  const pc = await shot();\n  const pt = await hudTime();\n  await page.waitForTimeout(700);\n  const p2 = await page.evaluate(() => window.WRD.frames);\n  const pc2 = await shot();\n  const pt2 = await hudTime();\n  // 暂停时循环仍重绘同一静止画面,故用画布像素与HUD时间判定冻结\n  (pc === pc2 && pt === pt2)\n    ? pass('暂停后画面/时间冻结', { pt, pt2 })\n    : fail('暂停后画面/时间冻结');\n\n  // 继续后恢复\n  await page.click('.wrd-btn-toggle');\n  await page.waitForTimeout(500);\n  const r1 = await page.evaluate(() => window.WRD.frames);\n  await page.waitForTimeout(500);\n  const r2 = await page.evaluate(() => window.WRD.frames);\n  (r2 > r1) ? pass('继续后恢复播放') : fail('继续后恢复播放');\n\n  // 重置: HUD 时间归零且仍在播放\n  await page.click('.wrd-btn-reset');\n  const resetOk = await page\n    .waitForFunction(\n      () => {\n        const rows = document.querySelectorAll('.wrd-hud-row');\n        for (const r of rows) {\n          if (r.children[0] && r.children[0].textContent.includes('时间')) {\n            return parseFloat(r.children[1].textContent) < 0.4;\n          }\n        }\n        return false;\n      },\n      { timeout: 2000 }\n    )\n    .then(() => true)\n    .catch(() => false);\n  resetOk ? pass('重置后 HUD 时间归零') : fail('重置后 HUD 时间归零');\n  await page.waitForTimeout(300);\n  const z1 = await page.evaluate(() => window.WRD.frames);\n  await page.waitForTimeout(400);\n  const z2 = await page.evaluate(() => window.WRD.frames);\n  (z2 > z1) ? pass('重置后仍在播放') : fail('重置后仍在播放');\n\n  result.consoleErrorCount = result.consoleErrors.length;\n  result.pageErrorCount = result.pageErrors.length;\n  (result.consoleErrors.length === 0 && result.pageErrors.length === 0)\n    ? pass('无console/页面错误')\n    : fail('无console/页面错误');\n\n  await page.screenshot({ path: screenshot, fullPage: true });\n  result.screenshot = path.resolve(screenshot);\n  pass('截图已保存', result.screenshot);\n} catch (e) {\n  fail('脚本运行完成');\n  result.runtimeError = String(e);\n} finally {\n  await browser.close();\n}\n\nresult.ok = Object.values(result.checks).every((v) => v !== false);\nif (resultOut) fs.writeFileSync(resultOut, JSON.stringify(result, null, 2));\nconsole.log(JSON.stringify(result, null, 2));\nprocess.exit(result.ok ? 0 : 1);\n====\nfrom pathlib import Path\r\nimport json,subprocess,sys\r\nW=Path('/workspace');S=W/'outputs/skill';O=W/'outputs/independent_retest';O.mkdir(parents=True,exist_ok=True)\r\nrows=[]\r\ndef run(label,args):\r\n r=subprocess.run(list(map(str,args)),capture_output=True,text=True);row={'label':label,'argv':list(map(str,args)),'rc':r.returncode,'stdout':r.stdout,'stderr':r.stderr};rows.append(row);return r,row\r\ndef mark(row,ok,expected):row.update(pass_=bool(ok),expected=expected)\r\ndef gen(label,cfg,topic,out):return run(label,[sys.executable,S/'scripts/gen_animation.py','--config',cfg,'--topic',topic,'--scaffold',S/'assets/scaffold.js','--out',out])\r\ndef verify(label,page):\r\n r,row=run(label,['node',S/'scripts/verify_animation.mjs',page,'--out',O/(label+'.json'),'--screenshot',O/(label+'.png')])\r\n try:report=json.loads((O/(label+'.json')).read_text())\r\n except (ValueError,OSError):report=None\r\n return r,report,row\r\nmaker=O/'maker.html';ball=O/'ball.html'\r\nfor name,cfg,topic,target in [('maker',W/'outputs/fixtures/skating/config.json',W/'outputs/fixtures/skating/topic.js',maker),('ball',S/'examples/ball_bounce/config.json',S/'examples/ball_bounce/topic.js',ball)]:\r\n r,row=gen(name+'_generate',cfg,topic,target);mark(row,r.returncode==0 and target.exists(),'Unchanged public generation CLI produces a self-contained actual page.')\r\n r,report,row=verify(name+'_baseline_verify',target);mark(row,r.returncode==0 and isinstance(report,dict) and report.get('ok') is True,'Actual Maker and distinct declared synthetic example pass public runtime/control verification.')\r\n# Only these two intended mutations differ from the baseline Maker page.\r\n# A failed check must name the disabled function, never borrow another error.\r\nfor label,selector,handler,words in [\r\n ('resume_disabled','.wrd-btn-toggle',\"let n=0;function(e){if(++n>=2){e.stopImmediatePropagation();e.preventDefault();}}\",['继续','恢复','resume']),\r\n ('reset_disabled','.wrd-btn-reset',\"function(e){e.stopImmediatePropagation();e.preventDefault();}\",['重置','reset']),\r\n]:\r\n if label=='resume_disabled':code=\"{let n=0;document.querySelector('.wrd-btn-toggle').addEventListener('click',function(e){if(++n>=2){e.stopImmediatePropagation();e.preventDefault();}},true);}\"\r\n else:code=\"document.querySelector('.wrd-btn-reset').addEventListener('click',function(e){e.stopImmediatePropagation();e.preventDefault();},true);\"\r\n p=O/(label+'.html');p.write_text(maker.read_text().replace('</body>','<script>'+code+'</script></body>'))\r\n r,report,row=verify(label,p)\r\n checks=report.get('checks',{}) if isinstance(report,dict) else {}\r\n own_failure=any(value is False and any(w in key.lower() for w in words) for key,value in checks.items())\r\n mark(row,r.returncode!=0 and isinstance(report,dict) and report.get('ok') is False and own_failure,'Intentionally disabled '+label+' is rejected for that same function, not unrelated pixels, missing file or another failed assertion.')\r\ncfg=json.loads((S/'examples/ball_bounce/config.json').read_text());cfg['subtitle']=42;p=O/'subtitle_integer.json';p.write_text(json.dumps(cfg));bad=O/'bad_subtitle.html'\r\nr,row=gen('subtitle_type_error',p,S/'examples/ball_bounce/topic.js',bad);text=(r.stdout+r.stderr).lower()\r\nmark(row,r.returncode==2 and not bad.exists() and 'subtitle' in text and any(x in text for x in ['string','字符串']) and 'traceback' not in text,'Invalid optional subtitle type has field-specific string diagnosis/exit2 and produces no page.')\r\n# The original module exposes only HUD values, so sample its public height,\r\n# rather than requiring a particular rewritten state representation.\r\nprobe=O/'ball_step_probe.mjs';probe.write_text(\"\"\"import fs from 'node:fs';import vm from 'node:vm';const c={window:{}};vm.createContext(c);vm.runInContext(fs.readFileSync('/workspace/outputs/skill/examples/ball_bounce/topic.js','utf8'),c);const cfg=JSON.parse(fs.readFileSync('/workspace/outputs/skill/examples/ball_bounce/config.json','utf8'));const sim=c.window.TopicSim.create(cfg,{},{});const height=()=>parseFloat(sim.hudValues().find(x=>x.label.includes('高度')).value);const start=height();let heights=[];for(let i=0;i<500;i++){sim.step(1/120);heights.push(height());}let low=heights.findIndex(x=>x<=0.03);const bounced=low>=0&&heights.slice(low+1).some(x=>x>0.1);console.log(JSON.stringify({dropHeight:cfg.physics.dropHeight,start,first:heights[0],min:Math.min(...heights),max:Math.max(...heights),contactIndex:low,bounced,heights}));\"\"\")\r\nr,row=run('synthetic_height_fall_and_bounce',['node',probe])\r\ntry:v=json.loads(r.stdout)\r\nexcept ValueError:v={}\r\nh=v.get('dropHeight',0)\r\nmark(row,r.returncode==0 and h>0 and abs(v.get('start',-999)-h)<0.02 and h-0.1<v.get('first',-999)<=h+0.02 and v.get('min',-999)>=-0.02 and v.get('max',999)<=h+0.05 and v.get('bounced') is True,'Positive initial height persists after the first1/120s, then decreases to ground and rebounds with no below-ground or energy-gaining jump; synthetic example only, not expert gold.')\r\nresult={'new_authored_deterministic_test':True,'tests':rows,'pass':sum(r['pass_'] for r in rows),'total':len(rows)}\r\n(O/'RESULTS.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({'pass':result['pass'],'total':result['total']}));raise SystemExit(0 if result['pass']==result['total'] else 1)","role":"tool","tool_call_id":"callb93f78dcae8b435b8f9d3c414ba18833"}
