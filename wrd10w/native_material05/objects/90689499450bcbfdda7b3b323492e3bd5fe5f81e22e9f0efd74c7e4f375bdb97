from pathlib import Path
import json,subprocess,sys
W=Path('/workspace');S=W/'outputs/skill';O=W/'outputs/independent_retest';O.mkdir(parents=True,exist_ok=True)
rows=[]
def run(label,args):
 r=subprocess.run(list(map(str,args)),capture_output=True,text=True);row={'label':label,'argv':list(map(str,args)),'rc':r.returncode,'stdout':r.stdout,'stderr':r.stderr};rows.append(row);return r,row
