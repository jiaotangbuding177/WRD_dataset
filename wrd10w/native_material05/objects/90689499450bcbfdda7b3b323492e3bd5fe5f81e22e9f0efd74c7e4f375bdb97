def verify(label,page):
 r,row=run(label,['node',S/'scripts/verify_animation.mjs',page,'--out',O/(label+'.json'),'--screenshot',O/(label+'.png')])
 try:report=json.loads((O/(label+'.json')).read_text())
 except (ValueError,OSError):report=None
 return r,report,row
