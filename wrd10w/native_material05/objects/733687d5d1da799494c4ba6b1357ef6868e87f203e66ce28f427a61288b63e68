def load(p):return json.loads(Path(p).read_text(encoding='utf-8-sig'))
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def save(p,x):
    p.parent.mkdir(parents=True,exist_ok=True)
    assert not p.exists()
    p.write_text(json.dumps(x,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')


def ordinary_files(root):
    pending=[root]
    result=[]
    while pending:
        folder=pending.pop()
        for item in os.scandir(folder):
            p=Path(item.path);s=p.lstat()
            assert not item.is_symlink() and not getattr(s,'st_file_attributes',0)&stat.FILE_ATTRIBUTE_REPARSE_POINT
            if item.is_dir(follow_symlinks=False):pending.append(p)
            elif item.is_file(follow_symlinks=False):result.append(p)
    return sorted(result)


