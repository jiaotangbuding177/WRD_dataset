import { createRequire } from 'node:module';
const require = createRequire(import.meta.url);
const { chromium } = require('playwright');
const browser = await chromium.launch({ executablePath: '/usr/bin/chromium', args: ['--no-sandbox'] });
const page = await browser.newPage();
const errs = [];
page.on('pageerror', e => errs.push(String(e)));
await page.goto('file:///workspace/outputs/demo_skating_forces.html', { waitUntil: 'load' });
const sample = () => page.evaluate(() => {
  const rows = document.querySelectorAll('.wrd-hud-row');
  const o = {};
  for (const r of rows) o[r.children[0].textContent] = r.children[1].textContent;
  return o;
});
const out = [];
for (const waitMs of [2000, 4000, 6000, 8000, 10000, 12000]) {
  await page.waitForTimeout(waitMs === 2000 ? 2000 : 2000);
  out.push(await sample());
}
await browser.close();
console.log(JSON.stringify({ samples: out, pageErrors: errs }, null, 1));
