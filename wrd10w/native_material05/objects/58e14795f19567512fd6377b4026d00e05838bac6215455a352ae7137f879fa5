{q[:50]!r}\\\")\\n        else:\\n            counter[\\\"verified\\\"] += 1\\n\\ncounter = {\\\"total\\\": 0, \\\"verified\\\": 0, \\\"by_source\\\": {}}\\n\\n# ---- Load outputs ----\\nouts = {}\\nfor name in [\\\"source_profiles.json\\\", \\\"workflow_candidates.json\\\", \\\"source_only_rubric.json\\\"]:\\n    p = os.path.join(OUT, name)\\n    try:\\n        with open(p, encoding=\\\"utf-8\\\") as f:\\n            outs[name] = json.load(f)\\n    except Exception as e:\\n        err(name, f\\\"JSON parse failure: {e}\\\")\\n\\nprofiles = outs.get(\\\"source_profiles.json\\\", {}).get(\\\"profiles\\\", [])\\ncands = outs.get(\\\"workflow_candidates.json\\\", {})\\nrubric = outs.get(\\\"source_only_rubric.json\\\", {}).get(\\\"cases\\\", [])\\n\\n# 1. top-level non-empty\\nif not profiles: err(\\\"source_profiles.json\\\", \\\"profiles empty\\\")\\nif not cands.get(\\\"candidates\\\"): err(\\\"workflow_candidates.json\\\", \\\"candidates empty\\\")\\nif not cands.get(\\\"source_decisions\\\"): err(\\\"workflow_candidates.json\\\", \\\"source_decisions empty\\\")\\nif not rubric: err(\\\"source_only_rubric.json\\\", \\\"cases empty\\\")\\n\\n# schemas/origins\\nif outs.get(\\\"source_profiles.json\\\", {}).get(\\\"schema\\\") != \\\"wrd-v10-source-profiles-v1\\\": err(\\\"source_profiles.json\\\", \\\"schema mismatch\\\")\\nif cands.get(\\\"schema\\\") != \\\"wrd-v10-source-only-workflow-candidates-v1\\\": err(\\\"workflow_candidates.json\\\", \\\"schema mismatch\\\")\\nif outs.get(\\\"source_only_rubric.json\\\", {}).get(\\\"schema\\\") != \\\"wrd-v10-source-only-rubric-v1\\\": err(\\\"source_only_rubric.json\\\", \\\"schema mismatch\\\")\\nfor name, o in outs.items():\\n    if o.get(\\\"annotation_origin\\\") != \\\"fresh_source_only_native_teacher\\\": err(name, \\\"annotation_origin mismatch\\\")\\nif cands.get(\\\"reuse_benefit_empirically_verified\\\") is not False: err(\\\"workflow_candidates.json\\\", \\\"reuse_benefit flag must be false\\\")\\n\\n# 2. sourc