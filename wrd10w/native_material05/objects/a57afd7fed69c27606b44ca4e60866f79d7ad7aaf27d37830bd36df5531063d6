"""Recheck selected private byte ancestry against all 1107 bindings and boundaries."""
from pathlib import Path
from collections import defaultdict
import gzip
import hashlib
import importlib.util
import json
import re
import sys

ROOT = Path(__file__).resolve().parents[3]
BASE = ROOT / 'output/20261027_wrd_main_v10'
CLEAN = BASE / 'clean_inputs'
OUT = BASE / 'runtime_preflight/jobs/phase2_mechanisms_02'
RAW = ROOT / 'benchmark/enterprise_input_closed_v11_20261012'


def load(p):
    return json.loads(Path(p).read_text(encoding='utf-8-sig'))


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def rows(p):
    with (gzip.open if str(p).endswith('.gz') else open)(p, 'rt', encoding='utf-8-sig') as f:
        return [json.loads(x) for x in f if x.strip()]


def main():
    spec = importlib.util.spec_from_file_location('closure_original_rules', ROOT / 'research/data_prep/wrd_main_v10/prepare_clean_inputs.py')
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    binding_file = ROOT / 'output/20261021_workflow_skill_library/source_bindings.json'
    bindings = load(binding_file)
    inventory_file = ROOT / 'research/plans/20261027_wrd_main_v10/CLEAN_ACTOR_INVENTORY.json'
    existing = load(inventory_file)['source_id_to_existing_split']
    original226file = RAW / 'contracts/evaluation.jsonl'
    protected226 = {x['session_id'] for x in rows(original226file)}
    Hfile = ROOT / 'output/20261026_ablation_v2/holdout_registry.json'
    H = set(re.findall(r'conv_[0-9a-f]{12}', Hfile.read_text(encoding='utf-8-sig')))
    assert len(protected226) == 226 and len(H) == 12
    entriesfile = ROOT / 'output/20261026_wrd_dataset_v9/coordination/entrypoint_controller.native_paths.source_closed.jsonl.gz'
    cases = load(OUT / 'CASES.json')['cases']
    selected_ids = {c['source_id'] for c in cases}
    selected_hashes = {r['sha256'] for c in cases for r in c['resources'][1:]}
    u = module.Union()
    all_hash_refs = defaultdict(set)
    authentic_hash_refs = defaultdict(set)
    selected_bindings = {}
    # Only original group and material metadata are used; protected bodies never
    # enter an output, model input, task specification, or quality criterion.
    for sid, b in bindings.items():
        original = Path(b['conversation']['path'])
        raw = original.read_bytes()
        assert hashlib.sha256(raw).hexdigest() == b['conversation']['sha256']
        header = json.loads(raw)
        u.join('source:' + sid, 'original_group:' + str(header.get('leakage_component_id', sid)))
        if sid in selected_ids:
            selected_bindings[sid] = b
        for m in b['materials']:
            h = m.get('sha256')
            if h in selected_hashes:
                all_hash_refs[h].add(sid)
            if module.material_class(m) == 'AUTHENTIC_USER_INPUT' and h:
                u.join('source:' + sid, 'private_actual_material:' + h)
                authentic_hash_refs[h].add(sid)
    for e in rows(entriesfile):
        for sid in e.get('source_ids', []):
            if sid in bindings:
                u.join('source:' + e['source_id'], 'source:' + sid)
    forbidden = {u.find('source:' + sid) for sid in protected226 | H}
    static = {u.find('source:' + sid) for sid, split in existing.items() if split in {'dev', 'test'} and sid in bindings}
    members = defaultdict(list)
    for sid in bindings:
        members[u.find('source:' + sid)].append(sid)
    scope = {x['source_id']: x for x in rows(CLEAN / 'source_scope.metadata.jsonl.gz')}
    source_rows = []
    for c in cases:
        sid = c['source_id']
        component = u.find('source:' + sid)
        assert component not in forbidden | static and scope[sid]['status'] == 'TRAIN'
        computed = 'v10_group_' + hashlib.sha256(module.js(sorted(members[component])).encode()).hexdigest()[:20]
        assert computed == c['source_group_id'] == scope[sid]['component_id']
        source_rows.append({'case': c['label'], 'source_id': sid, 'source_group_id': computed,
            'all_actual_group_member_source_ids': sorted(members[component]),
            'component_has_original226_newH_or_static_ancestor': False,
            'original_conversation_pin': selected_bindings[sid]['conversation'],
            'original_source_record_pin': {k: selected_bindings[sid][k] for k in ['physical_line','source_record_sha256']}})
    freeze = load(RAW / 'release_freeze_v11.json')
    manifest_path = RAW / freeze['manifest']
    assert sha(manifest_path) == freeze['manifest_sha256']
    sealed = {x.get('path', x.get('relative_path')): x for x in rows(manifest_path)}
    material_rows = []
    for h in sorted(selected_hashes):
        assert not any(s in protected226 | H or existing.get(s) in {'dev','test'} for s in all_hash_refs[h])
        for sid in authentic_hash_refs[h]:
            assert u.find('source:' + sid) not in forbidden | static
            for m in bindings[sid]['materials']:
                if m.get('sha256') != h or module.material_class(m) != 'AUTHENTIC_USER_INPUT':
                    continue
                original = Path(m.get('path', RAW / m['relative_path']))
                assert sha(original) == h
                assert sealed[m['relative_path']]['sha256'] == h
                material_rows.append({'sha256': h, 'original_source_id': sid,
                    'all_known_hash_references_across_1107_sources': sorted(all_hash_refs[h]),
                    'all_authentic_original_input_refs': sorted(authentic_hash_refs[h]),
                    'original_binding': m, 'original_file_bytes_match': True,
                    'v11_sealed_file_sha256': sealed[m['relative_path']]['sha256'],
                    'v11_sealed_at_utc': freeze['sealed_at_utc'],
                    'protected_or_static_same_byte_reference': False,
                    'not_a_generated_skill_or_old_Teacher_artifact': True})
    rag_audit = load(OUT / 'cases/cv_E2/original_two_user_messages.audit_only.json')
    rag = rag_audit['user_messages'][0]['content']
    current = rag_audit['user_messages'][1]['content']
    headers = re.findall(r'\[资料\s+\d+\]\s*文件:\s*(.*?)\s+路径:\s*([^\r\n]+)', rag)
    expected_names = {Path(m['original_binding']['relative_path']).name: m['sha256'] for m in material_rows if m['original_source_id'] == 'conv_fb33437938a8'}
    assert len(headers) == 18 and {x[0] for x in headers} == set(expected_names)
    detected = set(re.findall(r'conv_[0-9a-f]{12}', rag))
    assert not detected
    markers = {k: len(re.findall(pattern, rag, re.I)) for k, pattern in {
        'skill_homepage':r'SKILL\.md', 'WRD':r'\bWRD\b', 'output_artifact_path':r'/outputs/',
        'route_candidates':r'route_candidates', 'review_json':r'review\.json',
        'test_task_ID':r'\bT[0-9]{4}\b', 'source_or_case_ID_fields':r'\b(?:source_id|case_id)\b'}.items()}
    assert not any(markers.values())
    used = load(OUT / 'cases/cv_E2/source_input.json')
    assert used['current_original_request']['content'] == current
    full_first = OUT / 'cases/cv_E2/original_two_user_messages.audit_only.json'
    report = {'schema':'wrd-phase2-six-source-used-input-closure-v1',
        'status':'PASS_USED_NEW_TASK_VIEW_FULL_ORIGINAL_RAG_RETAINED_AUDIT_ONLY',
        'source_rows':source_rows, 'material_rows':material_rows,
        'original226_count':226, 'newH_count':12, 'binding_sources_checked':len(bindings),
        'used_JD_literal_sha256_utf8':hashlib.sha256(current.encode()).hexdigest(),
        'RAG_audit':{'original_full_two_user_messages_path':str(full_first),'sha256':sha(full_first),
            'first_message_characters':len(rag), 'all_18_named_retrieval_headers_map_to_six_actual_train_PDFs':True,
            'named_reference_map':expected_names,'explicit_other_source_ids_found':sorted(detected),
            'explicit_old_artifact_or_test_ID_marker_counts':markers,
            'absence_of_markers_is_not_a_full_semantic_provenance_certificate':True,
            'entire_retrieved_excerpt_text_not_admitted_or_mounted_in_recommended_view':True,
            'not_claimed_every_RAG_token_byte_equal_to_PDF_extraction':True,
            'used_new_view_does_not_reuse_old_mixed_Teacher_answers_or_review':True,
            'new_view_delta_path':str(OUT/'INPUT_VIEW_DELTAS.json')},
        'protected_bodies_not_supplied_to_actors_or_used_for_quality_labels':True,
        'source_ID_train_alone_was_not_used_as_the_closure_proof':True,
        'personal_addressing_and_language_preferences_retained_in_source_and_final_common_prompts':True,
        'new_model_or_native_sessions':0,'training_started':False,
        'input_pins':[{'path':str(p),'sha256':sha(p)} for p in [binding_file,inventory_file,original226file,Hfile,entriesfile,manifest_path]],
        'script_sha256':sha(Path(__file__))}
    path=OUT/'SOURCE_CLOSURE.json'
    assert not path.exists()
    path.write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
    print(json.dumps({'status':report['status'],'sources':len(source_rows),'actual_PDFs':len(material_rows),'source_closure_sha256':sha(path)},ensure_ascii=False))


if __name__ == '__main__':
    main()
