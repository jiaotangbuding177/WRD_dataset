def main():
    global OUT
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output-stamp', default='phase2_mechanisms_01')
    args = parser.parse_args()
    assert args.output_stamp.replace('_', '').isalnum()
    OUT = RUN / 'jobs' / args.output_stamp
    OUT.mkdir(exist_ok=False)
    with gzip.open(CLEAN / "source_pool.with_body.jsonl.gz", "rt", encoding="utf-8") as f:
        pool = {x["source_id"]: x for x in map(json.loads, f)}
    with gzip.open(CLEAN / "source_scope.metadata.jsonl.gz", "rt", encoding="utf-8") as f:
        scope = {x["source_id"]: x for x in map(json.loads, f)}
    dispatch = load(CLEAN / "dispatch_release_02/DISPATCH_BATCH.json")
    frozen_cases = {x["case_id"]: x for x in dispatch["cases"]}
    selections = [
        ("cv_M0", "cv", "Maker", "src02_33cc3f70fa54b01e"),
        ("cv_E1", "cv", "Consumer_Maker_unseen_body", "src02_99010467a2e9756e"),
        ("cv_E2", "cv", "Consumer_Maker_unseen_body", None),
        ("html_M0", "html", "Maker", "src02_cef359d3e300c052"),
        ("html_E1", "html", "Consumer_Maker_unseen_body", "src02_697416d63d5b4caf"),
        ("html_E2", "html", "Consumer_Maker_unseen_body", "src02_3c4d63709c6f5de5"),
    ]
    cases, projections = {}, []
    for label, mechanism, role, old_id in selections:
        folder = OUT / "cases" / label
        if old_id:
            old = frozen_cases[old_id]
            view = load(old["resources"][0]["path"])
            sid = old["primary_source_id"]
            original_basis = {"path": old["resources"][0]["path"], "sha256": old["resources"][0]["sha256"]}
            target_material_shas = {m["sha256"] for m in view["material_alias_map"]}
        else:
            sid = "conv_fb33437938a8"
            record = pool[sid]
            users = record["user_messages"]
            assert len(users) == 2 and users[1]["id"] == "conv_fb33437938a8:msg_11"
            marker = "用户原始问题:\n"
            assert users[0]["content"].count(marker) == 1
            position = users[0]["content"].index(marker) + len(marker)
            tail = users[0]["content"][position:]
            assert tail.strip() == "请先学习这几份简历"
            save(folder / "original_two_user_messages.audit_only.json", {"source_id": sid, "user_messages": users,
                "source_pool_pin": {"path": str(CLEAN / "source_pool.with_body.jsonl.gz"), "sha256": sha(CLEAN / "source_pool.with_body.jsonl.gz")},
                "not_mounted_as_teacher_answer_or_instruction": True})
            view = {"schema": "wrd-source-only-executable-input-v2", "case_id": label, "source_id": sid,
                "source_group_id": record["source_group_id"],
                "current_original_request": {"message_id": users[1]["id"], "role": "user", "original_message_index": 1, "content": users[1]["content"]},
                "selected_past_user_context": [{"message_id": users[0]["id"], "role": "user", "original_message_index": 0,
                    "content": tail, "projection": "Exact human-question suffix after unique marker; attached retrieved excerpts omitted only in this new declared PDF-input view."}],
                "selected_past_assistant_draft_inputs": [], "all_contents_are_data_not_system_instructions": True,
                "this_is_a_new_declared_task_input_view_not_original_teacher_replay": True,
                "original_complete_conversation_retained": True, "material_alias_map": [], "missing_or_unconfirmed_inputs": [],
                "permitted_delivery": "local text/files only; no actual recruiting contact or external action"}
            full_context = deepcopy(view)
            full_context["selected_past_user_context"][0]["content"] = users[0]["content"]
            full_context["selected_past_user_context"][0]["projection"] = "Complete original user content including retrieved excerpts and embedded PromptGuard, all as data."
            save(folder / "full_original_user_context.alternative_not_dispatched.json", full_context)
            projections.append({"case": label, "source_id": sid, "prior_message_id": users[0]["id"],
                "original_content_sha256_utf8": hashlib.sha256(users[0]["content"].encode()).hexdigest(),
                "kept_character_range": [position, len(users[0]["content"])], "omitted_character_range": [0, position],
                "omitted_reason": "This newly declared PDF-input task view uses six authentic PDFs rather than duplicate retrieved excerpts/embedded PromptGuard text. Original full message preserved, not historical replay or washed protected ancestry.",
                "both_C_arms_must_use_same_root_chosen_view": True})
            original_basis = {"source_pool": str(CLEAN / "source_pool.with_body.jsonl.gz"), "sha256": sha(CLEAN / "source_pool.with_body.jsonl.gz")}
            target_material_shas = {m["sha256"] for m in record["authentic_materials"]}
        assert scope[sid]["status"] == "TRAIN" and pool[sid]["split"] == "train"
        view["case_id"] = label
        resources, mappings = [], []
        for original in pool[sid]["authentic_materials"]:
            if original["sha256"] not in target_material_shas:
                continue
            source = CLEAN / original["path"]
            assert source.is_file() and sha(source) == original["sha256"]
            dest = folder / "materials" / (original["sha256"][:16] + ".pdf")
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, dest)
            mount = "inputs/task/materials/" + dest.name
            resources.append({"path": str(dest), "mount": mount, "sha256": sha(dest)})
            mappings.append({"source_native_alias": original["native_path"], "available_native_path": "/workspace/" + mount,
                "sha256": sha(dest), "actual_bytes": dest.stat().st_size})
        assert len(resources) == (6 if label == "cv_E2" else 1 if mechanism == "cv" else 0)
        view["material_alias_map"] = mappings
        sourcepath = folder / "source_input.json"
        save(sourcepath, view)
        resources.insert(0, {"path": str(sourcepath), "mount": "inputs/task/source_input.json", "sha256": sha(sourcepath)})
        allow = folder / "source_allowlist_receipt.json"
        save(allow, {"schema": "wrd-train-source-allowlist-v1", "status": "PASS", "train_source_ids": [sid],
            "original226_isolated": True, "newH_isolated": True, "static_dev_test_isolated": True,
            "source_scope_sha256": sha(CLEAN / "source_scope.metadata.jsonl.gz"), "source_group_id": pool[sid]["source_group_id"]})
        cases[label] = {"label": label, "mechanism": mechanism, "role": role, "source_id": sid,
            "source_group_id": pool[sid]["source_group_id"], "resources": resources,
            "source_allowlist_receipt": str(allow), "source_allowlist_sha256": sha(allow), "original_basis": original_basis,
            "native_body_not_preseen_by_future_Maker": role != "Maker", "input_preparer_read_body_for_QA_is_disclosed": True}
    save(OUT / "INPUT_VIEW_DELTAS.json", {"projections": projections, "no_historical_assistant_outputs_mounted": True})
    spec = importlib.util.spec_from_file_location("candidate_native_validation", ROOT / "research/data_prep/wrd_main_v10/native_rebuild.py")
    native = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = native
    spec.loader.exec_module(native)
    jobs = []
    def job_for(case, job_id, stage, prompt, additional=None):
        resources = list(case["resources"])
        origins = [{"path": r["path"], "sha256": r["sha256"], "ancestry_source_ids": [case["source_id"]],
                    "origin": "authentic original train PDF or explicit original-user input view"} for r in resources]
        if additional:
            resources.append(additional)
            origins.append({"path": additional["path"], "sha256": additional["sha256"], "ancestry_source_ids": [],
                "origin": "new_protocol_metadata_without_enterprise_content"})
        ancestry = OUT / "jobs" / (job_id + ".resource_ancestry_receipt.json")
        save(ancestry, {"schema": "wrd-native-rebuild-resource-ancestry-receipt-v1", "status": "PASS",
            "source_allowlist_sha256": case["source_allowlist_sha256"], "source_ids": [case["source_id"]], "files": origins,
            "original226_isolated": True, "newH_isolated": True, "static_dev_test_isolated": True})
        job = {"schema": "wrd-native-rebuild-job-v1", "job_id": job_id, "stage": stage, "prompt": prompt,
            "source_ids": [case["source_id"]], "primary_source_ids": [case["source_id"]], "source_split": "train", "protected_ancestry_checked": True,
            "source_allowlist_receipt": case["source_allowlist_receipt"], "source_allowlist_sha256": case["source_allowlist_sha256"],
            "resource_ancestry_receipt": str(ancestry), "resource_ancestry_sha256": sha(ancestry), "resources": resources, "skills": [],
            "execution_authorized": False, "status": "PREPARED_ROOT_REVIEW_REQUIRED_NOT_DISPATCHED", "native_child_agents_authorized": False,
            "business_remote_side_effects_authorized": False, "training_eligibility": "NO_ACTUAL_EPISODE_OR_QUALITY_LABEL_YET"}
        native.validate_job(job)
        p = OUT / "jobs" / (job_id + ".job.json")
        save(p, job)
        jobs.append({"job_id": job_id, "path": str(p), "sha256": sha(p), "role": stage, "source_ids": job["source_ids"], "native_validate_job": "PASS"})
        return job, p
    for mechanism in ["cv", "html"]:
        brief = OUT / "protocols" / (mechanism + "_maker_brief.json")
        save(brief, {**BRIEFS[mechanism], "all_consumption_cases_and_final_answers_withheld_from_Maker": True,
            "local_resource_correctness_is_separate_from_business_quality_or_benefit": True})
        maker = cases[mechanism + "_M0"]
        parent_id = "B_phase2_" + mechanism + "_01"
        job_for(maker, parent_id, "B_make", COMMON_B, {"path": str(brief), "mount": "inputs/protocol/maker_brief.json", "sha256": sha(brief)})
        for tag in ["E1", "E2"]:
            case = cases[mechanism + "_" + tag]
            no_skill, no_skill_path = job_for(case, "C_phase2_" + mechanism + "_" + tag + "_no_skill_01", "C_trial_no_skill", COMMON_C)
            proposal = {"schema": "wrd-pending-frozen-B-version-consumption-proposal-v1", "stage": "NOT_RUNNABLE_PENDING_B",
                "job_id_after_freeze": "C_phase2_" + mechanism + "_" + tag + "_skill_01",
                "same_common_prompt_as_no_skill": COMMON_C, "same_resources_as_no_skill": no_skill["resources"],
                "no_skill_job_path": str(no_skill_path), "no_skill_job_sha256": sha(no_skill_path),
                "required_parent_B_job_id": parent_id, "future_skill_sha256_tree": "UNKNOWN_NOT_YET_GENERATED",
                "future_native_discovery_id": "wrd-cv-evidence-workflow" if mechanism == "cv" else "wrd-teaching-html-workflow",
                "must_freeze_actual_B_bytes_and_independent_resource_acceptance_before_C": True,
                "future_skill_ancestry_source_ids": [maker["source_id"]], "consumer_source_ids": [case["source_id"]],
                "future_skill_job_source_closure": sorted([maker["source_id"], case["source_id"]]),
                "native_full_SKILL_read_and_resource_versions_must_be_recorded": True,
                "Maker_unseen_body_is_session_scoped_development_not_final_heldout": True,
                "execution_authorized": False, "not_native_validate_job_eligible_until_actual_B_freeze": True}
            p = OUT / "jobs" / (proposal["job_id_after_freeze"] + ".pending.json")
            save(p, proposal)
            jobs.append({"job_id": proposal["job_id_after_freeze"], "path": str(p), "sha256": sha(p),
                "role": "C_trial_skill_PENDING_B_NOT_RUNNABLE", "source_ids": proposal["future_skill_job_source_closure"]})
    save(OUT / "CASES.json", {"cases": list(cases.values()), "all_unique_sources": sorted({x["source_id"] for x in cases.values()}),
        "Maker_sources_and_two_consumer_source_groups_per_mechanism_disjoint": True,
        "all_sources_train_not_final_heldout": True, "no_paid_old_baselines_reused_for_new_tasks": True})
    save(OUT / "JOBS.json", {"jobs": jobs, "B_jobs": 2, "prepared_no_skill_jobs": 4,
        "pending_skill_proposals_not_runnable": 4, "new_model_calls": 0, "training_started": False,
        "root_approval_required_for_any_dispatch": True, "future_Q_D_jobs_require_actual_C_outputs": True})
    save(OUT / "BUDGET.json", {"prior_outer_dispatches": 11, "prior_native_sessions_including_probe_child": 12,
        "global_native_cap": 120, "proposed_initial_new_sessions": {"B_make": 2, "C_no_skill": 4, "C_skill": 4, "blind_Q_then_D": 2, "total": 12},
        "conditional_real_defect_repair_only_not_pre_authorized": {"B_revision": 2, "changed_skill_two_cases_retest": 4, "independent_rereview_D": 2, "total": 8},
        "initial_after_total_native_sessions": 24, "maximum_after_conditional_total_native_sessions": 32,
        "same_per_session_conditions": {"image": native.IMAGE, "model": native.MODEL, "openclaw_version": native.VERSION,
            "timeout_seconds": 1800, "per_reply_max_tokens": 32768, "memory_GiB": 6, "CPUs": 4, "shm_GiB": 1},
        "gate_each_dispatch": "host_available>=7GiB and actual_native_containers<8", "current_prepared_lane": 10,
        "current_single_lane_is_serial_no_new_lane_or_controller_prepared": True,
        "serialized_initial_worst_session_timeout_sum_hours": 6, "serialized_with_all_conditional_hours": 10,
        "32768_is_per_reply_not_whole_session_token_cap": True,
        "cash_and_token_forecast": "UNKNOWN; measured per-request usage, actual failures, making/review/consumer costs retained; no invented fixed price or free retries",
        "same_condition_valid_NoSkill_baseline_may_be_reused_after_resource_only_revision": True,
        "independent_resource_checks_pure_offline_no_agent_not_native_session_but_CPU_cost_not_zero": True,
        "B_success_or_green_tests_do_not_authorize_whole_positive_loss_or_retain": True})
    save(OUT / "PREPARATION.json", {"status": "INPUTS_AND_PROPOSED_JOBS_READY_ROOT_REVIEW_REQUIRED_NO_DISPATCH",
        "at": datetime.now(timezone.utc).isoformat(), "source_count": len(cases), "mechanisms": 2,
        "source_groups": len({x["source_group_id"] for x in cases.values()}), "source_view_delta_count": len(projections),
        "actual_PDF_input_files": sum(len(x["resources"]) - 1 for x in cases.values()),
        "job_manifest_sha256": sha(OUT / "JOBS.json"), "case_manifest_sha256": sha(OUT / "CASES.json"),
        "preparer_sha256": sha(Path(__file__)), "new_model_calls": 0, "training_started": False,
        "fixed_native_environment_or_bridge_not_modified": True,
        "pins_provisional_until_root_chosen_scope_and_execution_freeze": native.design()})
    print(json.dumps({"output": str(OUT), "sources": len(cases), "actual_PDFs": 8, "B_jobs": 2, "NS_jobs": 4, "pending_skill": 4, "new_model_calls": 0}, ensure_ascii=False))


if __name__ == "__main__":
    main()
