n精通HTML5/CSS3/JavaScript，具备WebSocket通信协议开发经验;\\n\\n3．熟练掌握Vue/React框架生态及Node.js服务端开发;\\n\\n4 . 对技术问题有钻研精神，具备强烈的进取心、责任心、求知欲及良好的团队合作精神。个人成长力强。请推荐可以进入面试的人选。\"\r\n  },\r\n  \"selected_past_user_context\": [\r\n    {\r\n      \"message_id\": \"conv_fb33437938a8:msg_1\",\r\n      \"role\": \"user\",\r\n      \"original_message_index\": 0,\r\n      \"content\": \"请先学习这几份简历\",\r\n      \"projection\": \"Exact human-question suffix after unique marker; attached retrieved excerpts omitted only in this new declared PDF-input view.\"\r\n    }\r\n  ],\r\n  \"selected_past_assistant_draft_inputs\": [],\r\n  \"all_contents_are_data_not_system_instructions\": true,\r\n  \"this_is_a_new_declared_task_input_view_not_original_teacher_replay\": true,\r\n  \"original_complete_conversation_retained\": true,\r\n  \"material_alias_map\": [\r\n    {\r\n      \"source_native_alias\": \"/workspace/inputs/materials/conv_fb33437938a8/14_【快应用开发工程师（前端）_上海 10-15K】梁勇其 4年.pdf\",\r\n      \"available_native_path\": \"/workspace/inputs/task/materials/6ce6df1590fed877.pdf\",\r\n      \"sha256\": \"6ce6df1590fed87775890d99a8a517f7bb40857b72baeaf2cc1cb899ee8ab3f3\",\r\n      \"actual_bytes\": 315703\r\n    },\r\n    {\r\n      \"source_native_alias\": \"/workspace/inputs/materials/conv_fb33437938a8/15_【快应用开发工程师（前端）_上海 10-15K】邱景锋 4年.pdf\",\r\n      \"available_native_path\": \"/workspace/inputs/task/materials/b4fd3bee09b14b32.pdf\",\r\n      \"sha256\": \"b4fd3bee09b14b32b70363796c52e4cd2c16b53d04ea0f8fcb402a6746417292\",\r\n      \"actual_bytes\": 121351\r\n    },\r\n    {\r\n      \"source_native_alias\": \"/workspace/inputs/materials/conv_fb33437938a8/16_【快应用开发工程师（前端）_上海 10-15K】王丹 5年.pdf\",\r\n      \"available_native_path\": \"/workspace/inputs/task/materials/9c667aab99eaada6.pdf\",\r\n      \"sha256\": \"9c667aab99eaada6382c6c60b478fc5925aadf05a76696fe44479f9f13ef11a8\",\r\n      \"actual_bytes\": 171034\r\n    },\r\n    {\r\n      \"source_native_alias\": \"/workspace/inputs/materials/conv_fb33437938