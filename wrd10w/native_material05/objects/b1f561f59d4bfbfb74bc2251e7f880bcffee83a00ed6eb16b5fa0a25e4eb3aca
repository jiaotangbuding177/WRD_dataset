data: {"id":"chatcmpl-1793068628817","object":"chat.completion.chunk","created":1793068628,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"calla545875ac6714675bd98341d82c52f5d","type":"function","function":{"name":"edit","arguments":"{\"edits\":[{\"newText\":\"def iter_evidence_refs(node, path=\\\"$\\\"):\\n    \\\"\\\"\\\"递归遍历 JSON 树，产出 (kind, path, payload) 三元组：\\n\\n    - (\\\"ref\\\", path, ref)：合法位置上的 dict 引用对象，待字段级校验；\\n    - (\\\"not_list\\\", path, value)：任何位置上的 evidence_refs 不是列表（形状错误）；\\n    - (\\\"item_not_object\\\", path, value)：evidence_refs 列表内出现非对象元素（形状错误）。\\n\\n    任何键名恰为 evidence_refs 的位置都被形状核验，保证嵌套结构（如 task_switches\\n    等自定义字段）内的引用既不漏检、也不跳过畸形形状。空列表本身合法——可选引用\\n    为空不等于必需事实缺证（必需事实缺证由账本基础检查按 fact_type 另行判定）；\\n    空列表只是不产生逐条引用校验。\\n    \\\"\\\"\\\"\\n    if isinstance(node, dict):\\n        for k, v in node.items():\\n            if k == \\\"evidence_refs\\\":\\n                if not isinstance(v, list):\\n                    yield \\\"not_list\\\", path + \\\".evidence_refs\\\", v\\n                else:\\n                    for i, ref in enumerate(v):\\n                        if isinstance(ref, dict):\\n                            yield \\\"ref\\\", \\\"%s.evidence_refs[%d]\\\" % (path, i), ref\\n                        else:\\n                            yield \\\"item_not_object\\\", \\\"%s.evidence_refs[%d]\\\" % (path, i), ref\\n            else:\\n                yield from iter_evidence_refs(v, path + \\\".\\\" + str(k))\\n    elif isinstance(node, list):\\n        for i, v in enumerate(node):\\n            yield from iter_evidence_refs(v, \\\"%s[%d]\\\" % (path, i))\",\"oldText\":\"def iter_evidence_refs(node, path=\\\"$\\\"):\\n    \\\"\\\"\\\"递归遍历 JSON 树，产出 (path, ref)。\\n\\n    任何键名恰为 evidence_refs 的列表，其每个 dict 元素都被独立校验。\\n    这保证嵌套结构（如 task_switches 等自定义字段）内的引用不会漏检。\\n    \\\"\\\"\\\"\\n    if isinstance(node, dict):\\n        for k, v in node.items():\\n            if k == \\\"evidence_refs\\\" and isinstance(v, list):\\n                for i, ref in enumerate(v):\\n                    if isinstance(ref, dict):\\n                        yield \\\"%s.evidence_refs[%d]\\\" % (path, i), ref\\n            else:\\n                yield from iter_evidence_refs(v, path + \\\".\\\" + str(k))\\n    elif isinstance(node, list):\\n        for i, v in enumerate(node):\\n            yield from iter_evidence_refs(v, \\\"%s[%d]\\\" % (path, i))\"},{\"newText\":\"    # ---------- 3) 递归校验全部 evidence_refs（账本+成稿，含任意嵌套，含形状核验） ----------\\n    ok = True\\n    for root_name, root in ((\\\"ledger\\\", ledger), (\\\"draft\\\", draft)):\\n        for kind, path, payload in iter_evidence_refs(root):\\n            if kind == \\\"not_list\\\":\\n                fail(\\\"evidence_refs_not_list\\\",\\n                     \\\"evidence_refs 必须是列表，实际为 %s: %r\\\" % (type(payload).__name__, payload),\\n                     \\\"%s:%s\\\" % (root_name, path))\\n                ok = False\\n                continue\\n            if kind == \\\"item_not_object\\\":\\n                fail(\\\"evidence_refs_item_not_object\\\",\\n                     \\\"evidence_refs 列表元素必须是对象，实际为 %s: %r\\\" % (type(payload).__name__, payload),\\n                     \\\"%s:%s\\\" % (root_name, path))\\n                ok = False\\n                continue\\n            ref = payload\\n            sid = ref.get(\\\"source_id\\\")\",\"oldText\":\"    # ---------- 3) 递归校验全部 evidence_refs（账本+成稿，含任意嵌套） ----------\\n    ok = True\\n    for root_name, root in ((\\\"ledger\\\", ledger), (\\\"draft\\\", draft)):\\n        for path, ref in iter_evidence_refs(root):\\n            sid = ref.get(\\\"source_id\\\")\"},{\"newText\":\"    # ---------- 9) 类型口径复核提示（同主体+数值+单位但 fact_type 不同） ----------\\n    # 诚实边界修正：仅凭「主体/数值/单位相同而 fact_type 不同」不能确定性地判定为矛盾——\\n    # 不同年份的 actual 与 goal 同值是常见合法口径（如去年实际、今年计划），同一年内\\n    # 已完成值与目标值同值也可合法共存。程序无法可靠区分合法口径差异与真实冲突，\\n    # 因此不再输出硬性结构失败，改为列入 NEEDS_SEMANTIC_REVIEW 由人工复核；\\n    # planned_goal 被声明为已实现事实仍在第 5 步被硬性拒绝。\\n    seen = {}\\n    for fid, f in fact_map.items():\\n        if f.get(\\\"value\\\") is None:\\n            continue\\n        key = (norm(str(f.get(\\\"subject\\\") or \\\"\\\")), norm(str(f.get(\\\"value\\\"))), norm(str(f.get(\\\"unit\\\") or \\\"\\\")))\\n        seen.setdefault(key, []).append((fid, f.get(\\\"fact_type\\\"), f.get(\\\"time\\\")))\\n    for key, entries in seen.items():\\n        types = {t for _, t, _ in entries}\\n        if len(types) > 1:\\n            review(\\\"FACT_TYPE_AMBIGUOUS\\\",\\n                   \\\"同一主体/数值/单位存在多种 fact_type 声明: %s；时间/口径差异可能合法共存，\\\"\\n                   \\\"程序无法确定是否矛盾，需人工语义复核\\\" % (entries,))\\n    checks_passed.append(\\\"conflicts\\\")\",\"oldText\":\"    # ---------- 9) 事实类型冲突（同主体+数值+单位但类型不同） ----------\\n    ok = True\\n    seen = {}\\n    for fid, f in fact_map.items():\\n        if f.get(\\\"value\\\") is None:\\n            continue\\n        key = (norm(str(f.get(\\\"subject\\\") or \\\"\\\")), norm(str(f.get(\\\"value\\\"))), norm(str(f.get(\\\"unit\\\") or \\\"\\\")))\\n        seen.setdefault(key, []).append((fid, f.get(\\\"fact_type\\\")))\\n    for key, entries in seen.items():\\n        types = {t for _, t in entries}\\n        if len(types) > 1:\\n            fail(\\\"fact_type_conflict\\\",\\n                 \\\"同一主体/数值/单位存在冲突类型声明: %s -> %s\\\" % (entries, sorted(types)))\\n            ok = False\\n    if ok:\\n        checks_passed.append(\\\"conflicts\\\")\"}]}"}}]},"finish_reason":null}]}

