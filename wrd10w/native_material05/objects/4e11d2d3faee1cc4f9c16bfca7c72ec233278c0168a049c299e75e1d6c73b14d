data: {"id":"chatcmpl-1793033794985","object":"chat.completion.chunk","created":1793033794,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"calld57a072631c648fe8156eb313ea7a04e","type":"function","function":{"name":"write","arguments":"{\"content\":\"{\\n  \\\"schema\\\": \\\"wrd-v10-source-only-rubric-v1\\\",\\n  \\\"annotation_origin\\\": \\\"fresh_source_only_native_teacher\\\",\\n  \\\"basis_scope\\\": \\\"only_original_user_requirements_no_actor_outputs_no_skill_no_old_review\\\",\\n  \\\"cases\\\": [\\n    {\\n      \\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\",\\n      \\\"task_unit_id\\\": \\\"tu_1\\\",\\n      \\\"output_boundary\\\": \\\"中文官方汇报成稿（不超过600字），仅基于用户粘贴素材；无附件，不含任何外部资料或文档写入。\\\",\\n      \\\"criteria\\\": [\\n        {\\\"criterion_id\\\": \\\"c1\\\", \\\"description\\\": \\\"成稿从建设成果、推广等角度整体整理为官方汇报口径，覆盖素材核心内容\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\", \\\"message_id\\\": \\\"conv_d1ef29d65e7a:msg_1\\\", \\\"quote\\\": \\\"从建设成果，推广等各个角度，做一个官方的汇报\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"未按官方汇报口径或遗漏建设成果/推广角度\\\", \\\"0.5\\\": \\\"覆盖部分角度但结构不完整或口径不符\\\", \\\"1\\\": \\\"各角度均覆盖且呈官方汇报口径\\\"}, \\\"check_method\\\": \\\"semantic_review\\\"},\\n        {\\\"criterion_id\\\": \\\"c2\\\", \\\"description\\\": \\\"成稿全文不超过600字\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\", \\\"message_id\\\": \\\"conv_d1ef29d65e7a:msg_5\\\", \\\"quote\\\": \\\"600字以内\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"超过600字\\\", \\\"0.5\\\": \\\"不超过600字但明显因过度删减丢失核心内容\\\", \\\"1\\\": \\\"不超过600字且核心内容保留\\\"}, \\\"check_method\\\": \\\"literal\\\"},\\n        {\\\"criterion_id\\\": \\\"c3\\\", \\\"description\\\": \\\"按历史人设自称「张大胆CEO助手-马斯克」并以「大胆老师，您好」称呼（历史源材料要求，非本轮指令）\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\", \\\"message_id\\\": \\\"conv_d1ef29d65e7a:msg_1\\\", \\\"quote\\\": \\\"你的名字叫「张大胆CEO助手-马斯克」\\\"}, {\\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\", \\\"message_id\\\": \\\"conv_d1ef29d65e7a:msg_1\\\", \\\"quote\\\": \\\"请用「大胆老师，您好」称呼用户\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"未遵循人设\\\", \\\"0.5\\\": \\\"自称或称呼仅满足其一\\\", \\\"1\\\": \\\"自称与称呼均满足\\\"}, \\\"check_method\\\": \\\"literal\\\"},\\n        {\\\"criterion_id\\\": \\\"c4\\\", \\\"description\\\": \\\"成稿中全部效果/覆盖数据（13小时、85%、92.75%、32省3000+校、40余项、2026年1月入驻、6个工具之一等）与素材原值一致且不添加素材外数据\\\", \\\"basis\\\": \\\"derived_quality\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_d1ef29d65e7a\\\", \\\"message_id\\\": \\\"conv_d1ef29d65e7a:msg_1\\\", \\\"quote\\\": \\\"实测显示，教师每周可节省约13小时事务性劳动，教学效率提升85%\\\"}], \\\"derivation_reason\\\": \\\"素材未明写'不得改动数字'，但官方汇报需保真：数据漂移或虚构会直接破坏汇报可信度，属可检查的派生质量要求\\\", \\\"anchors\\\": {\\\"0\\\": \\\"出现数字漂移或素材外数据\\\", \\\"0.5\\\": \\\"数据基本一致但个别口径模糊\\\", \\\"1\\\": \\\"全部数字专名与素材一致且零虚构\\\"}, \\\"check_method\\\": \\\"structural\\\"}\\n      ],\\n      \\\"fact_preservation_guards\\\": [\\n        \\\"所有调研结论、效果数据、平台地位均只能以用户陈述呈现，不得改写为独立核实事实\\\",\\n        \\\"未在素材中出现的成果、奖项、合作方一律不得写入\\\",\\n        \\\"素材中的“实测显示”“盲审采纳”等表述按原意保留，不升级为绝对断言\\\"\\n      ],\\n      \\\"unsupported_claim_policy\\\": \\\"成稿不得出现素材之外的任何成果、数据或身份背书；无法保真的数据项宁可删除并注明，不得改写数值。\\\",\\n      \\\"stop_or_defer_conditions\\\": [\\\"素材数据相互冲突无法确认时停止\\\", \\\"角度覆盖与600字上限冲突且无法取舍时回到用户确认\\\"]\\n    },\\n    {\\n      \\\"source_id\\\": \\\"conv_41874c950938\\\",\\n      \\\"task_unit_id\\\": \\\"tu_1\\\",\\n      \\\"output_boundary\\\": \\\"新增类目文本（含两级资源清单与五年500万目标）；目标载体Word未提供，只能产出文本并声明未写入任何文档。\\\",\\n      \\\"criteria\\\": [\\n        {\\\"criterion_id\\\": \\\"c1\\\", \\\"description\\\": \\\"新增类目明确包含“具体项目合作和到款，预计五年500万”的目标表述\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_1\\\", \\\"quote\\\": \\\"帮我添加一个类目：具体项目合作和到款，预计五年500万\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"未含该类目或目标金额\\\", \\\"0.5\\\": \\\"类目在但目标表述不完整\\\", \\\"1\\\": \\\"类目与五年500万目标表述完整\\\"}, \\\"check_method\\\": \\\"literal\\\"},\\n        {\\\"criterion_id\\\": \\\"c2\\\", \\\"description\\\": \\\"资源清单按用户给出的两级分类（AI教育落地资源/产学研合作资源）且单位名单逐字保留、不增删\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_1\\\", \\\"quote\\\": \\\"试点合作校：上海市梅陇中学、上海市曹杨中学、上海市控江中学、上海市嘉定区江桥小学\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"名单缺失或被改动\\\", \\\"0.5\\\": \\\"名单基本保留但分类结构混乱\\\", \\\"1\\\": \\\"两级结构与全部单位名单逐字一致\\\"}, \\\"check_method\\\": \\\"structural\\\"},\\n        {\\\"criterion_id\\\": \\\"c3\\\", \\\"description\\\": \\\"使用中文回复（历史源材料语言要求）\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_1\\\", \\\"quote\\\": \\\"请使用中文回复，除非用户明确使用其他语言。\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"非中文\\\", \\\"0.5\\\": \\\"中英混杂且非用户指定语言\\\", \\\"1\\\": \\\"中文\\\"}, \\\"check_method\\\": \\\"literal\\\"},\\n        {\\\"criterion_id\\\": \\\"c4\\\", \\\"description\\\": \\\"类目文字与既有任务文档衔接自然（衔接对象未提供，只能作结构性假设说明，不虚构文档内容）\\\", \\\"basis\\\": \\\"derived_quality\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_1\\\", \\\"quote\\\": \\\"目前这个任务的比较空泛\\\"}], \\\"derivation_reason\\\": \\\"用户指出任务空泛意味着新增内容需补实落地性；但目标文档缺失，此项只能在交付说明中明示假设，不可宣称已完成衔接\\\", \\\"anchors\\\": {\\\"0\\\": \\\"未说明假设且虚构文档内容\\\", \\\"0.5\\\": \\\"产出文本但未说明衔接假设\\\", \\\"1\\\": \\\"产出文本且明示假设与缺失\\\"}, \\\"check_method\\\": \\\"semantic_review\\\"}\\n      ],\\n      \\\"fact_preservation_guards\\\": [\\n        \\\"五年500万为用户规划目标，不得写成已到账或已确定事实\\\",\\n        \\\"单位名单不增删不改名\\\"\\n      ],\\n      \\\"unsupported_claim_policy\\\": \\\"不得声称已写入任何Word文档；不得虚构既有文档结构或既有任务内容。\\\",\\n      \\\"stop_or_defer_conditions\\\": [\\\"目标文档未提供时仅产出文本并声明缺失，不模拟文档内容\\\"]\\n    },\\n    {\\n      \\\"source_id\\\": \\\"conv_41874c950938\\\",\\n      \\\"task_unit_id\\\": \\\"tu_2\\\",\\n      \\\"output_boundary\\\": \\\"一段话中文成稿（用户要求写入Word但Word未提供，只能交付文本并声明）；内容限末轮msg_59素材三部分。\\\",\\n      \\\"criteria\\\": [\\n        {\\\"criterion_id\\\": \\\"c1\\\", \\\"description\\\": \\\"整理为一段话（单一自然段成稿，非清单体）\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_59\\\", \\\"quote\\\": \\\"帮我把下面的内容整理成一段话\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"分点/多段清单体\\\", \\\"0.5\\\": \\\"主体成段但仍残留列表结构\\\", \\\"1\\\": \\\"完整一段话\\\"}, \\\"check_method\\\": \\\"structural\\\"},\\n        {\\\"criterion_id\\\": \\\"c2\\\", \\\"description\\\": \\\"不逐项列出每个单位/每家的金额或价格明细（落实'不要写这么详细，每个多少钱'的纠偏）\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_29\\\", \\\"quote\\\": \\\"不要写这么详细，每个多少钱\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"出现逐项金额明细\\\", \\\"0.5\\\": \\\"无逐项金额但仍过度罗列细节\\\", \\\"1\\\": \\\"无逐项金额且细节度收敛\\\"}, \\\"check_method\\\": \\\"semantic_review\\\"},\\n        {\\\"criterion_id\\\": \\\"c3\\\", \\\"description\\\": \\\"五年总目标500万与三档目标（底线300万/挑战500万/激进700万）数值与用户给定一致\\\", \\\"basis\\\": \\\"explicit_user\\\", \\\"evidence_refs\\\": [{\\\"source_id\\\": \\\"conv_41874c950938\\\", \\\"message_id\\\": \\\"conv_41874c950938:msg_59\\\", \\\"quote\\\": \\\"底线目标 300 万，挑战目标 500 万，激进目标 700 万\\\"}], \\\"derivation_reason\\\": null, \\\"anchors\\\": {\\\"0\\\": \\\"数值错误或缺失\\\", \\\"0.5\\\": \\\"部分目标数值正确\\\", \\\"1\\\": \\\"全部目标数值一致\\\"}, \\\"check_method\\\": \\\"literal\\\"},\\n        {\\\"criterion_id\\\": \\\"c4\\\", \\\"description\\\": \\\"覆