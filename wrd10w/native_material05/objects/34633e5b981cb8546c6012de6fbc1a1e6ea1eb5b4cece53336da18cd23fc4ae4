"""Command consumer for task-group-pipeline-v1; fresh Docker container per attempt."""
from __future__ import annotations
import argparse
import hashlib
import json
import os
import re
from pathlib import Path, PurePosixPath
import subprocess
import shutil
import time
import uuid

DEFAULT_IMAGE = 'skillloop-openclaw-eval:2026.9.5-tools-v5-final-20261008'
MODULE = Path(__file__).resolve().parent
RUNTIME_FILES = ('consumer.py','container_runner.py','openclaw_config.py','ecnu_tools.py',
                 'runtime_compat.py','pdf_form.py')
OBSERVATION_ARCHIVE_RESERVE_SECONDS = 30


def validate_observation_seconds(value, timeout=None):
    if type(value) is not int or value < 0:
        raise ValueError('runtime_observation_seconds must be a nonnegative integer')
    if value and timeout is not None and value + OBSERVATION_ARCHIVE_RESERVE_SECONDS >= timeout:
        raise ValueError('Observation and evidence reserve exhaust the container timeout')
    return value


def write_json(path, data):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')


def redact(value, secret):
    if isinstance(value,str): return value.replace(secret,'[REDACTED]') if secret else value
    if isinstance(value,list): return [redact(x,secret) for x in value]
    if isinstance(value,dict): return {k:redact(v,secret) for k,v in value.items()}
    return value


def project_request(raw, workspace):
    """Only explicit consumer fields; reject accidentally mounted external input."""
    workspace=Path(workspace).resolve()
    if not isinstance(raw.get('input'),str) or not raw['input'].strip(): raise ValueError('Missing task input')
    result={key:raw[key] for key in ('protocol','stage','task_id','input','context','followup_inputs','seed','services','required_commands','runtime_observation_seconds') if key in raw}
    validate_observation_seconds(result.get('runtime_observation_seconds',0))
    followups=result.get('followup_inputs',[])
    if not isinstance(followups,list) or any(not isinstance(x,str) or not x.strip() for x in followups):
        raise ValueError('Follow-up inputs must be explicit nonempty user text')
    result['resources']=[]
    for resource in raw.get('resources',[]):
        file=Path(resource['path']).resolve()
        if not file.is_relative_to(workspace): raise ValueError('Resource outside this attempt workspace')
        result['resources'].append({k:v for k,v in resource.items() if k!='path'} | {'path':'/workspace/'+file.relative_to(workspace).as_posix()})
    result['learned_skills']=[]
    for skill in raw.get('learned_skills',[]):
        directory=Path(skill['path']).resolve()
        if not directory.is_relative_to(workspace/'learned_skills'): raise ValueError('Skill outside learned library copy')
        result['learned_skills'].append({'id':skill['id'],'files':skill['files'],'path':'/workspace/'+directory.relative_to(workspace).as_posix()})
    return result


def stage_turn_resources(raw, request_path, transport):
    """Copy explicitly declared later inputs without exposing their bytes early.

    This is sequential protocol delivery, not a security boundary against an
    arbitrary root process inspecting the experiment controller's transport.
    """
    staged_root=(Path(request_path).parent/'staged_resources').resolve()
    entries=raw.get('turn_resources',[])
    if not isinstance(entries,list): raise ValueError('turn_resources must be a list')
    turns=1+len(raw.get('followup_inputs',[]));result=[];seen=set()
    for entry_index,entry in enumerate(entries):
        user_index=entry.get('user_index')
        if type(user_index) is not int or not 0<=user_index<turns:
            raise ValueError('Staged input user_index is outside the actual replay')
        resources=entry.get('resources',[])
        if not isinstance(resources,list): raise ValueError('Staged resources must be a list')
        projected=[]
        for resource_index,resource in enumerate(resources):
            source=Path(resource['path']).resolve()
            if not source.is_relative_to(staged_root) or not source.is_file() or source.is_symlink():
                raise ValueError('Staged input must be a regular file inside this attempt staged_resources')
            mount=resource['mount'];parts=PurePosixPath(mount)
            if not isinstance(mount,str) or not mount or parts.is_absolute() or any(x in ('','..','.') for x in mount.split('/')) or '\\' in mount or ':' in mount:
                raise ValueError('Invalid staged input mount')
            if mount.split('/')[0] not in ('inputs','reference_inputs'):
                raise ValueError('Staged user inputs must enter an explicit input directory')
            if (user_index,mount) in seen: raise ValueError('Duplicate staged input at one user turn')
            seen.add((user_index,mount))
            expected=resource['sha256'];actual=hashlib.sha256(source.read_bytes()).hexdigest()
            if expected!=actual: raise ValueError('Staged input hash mismatch')
            destination=Path(transport)/'staged_inputs'/str(user_index)/f'{entry_index:04d}_{resource_index:04d}'
            destination.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(source,destination)
            projected.append({'source':'/transport/'+destination.relative_to(transport).as_posix(),
                              'path':'/workspace/'+mount,'sha256':actual})
        result.append({'user_index':user_index,'resources':projected})
    return result


def docker_prefix(backend='native', distro='Ubuntu'):
    if backend=='native': return ['docker']
    if backend=='wsl': return ['wsl.exe','-d',distro,'--exec','/usr/bin/docker']
    raise ValueError('Unsupported Docker backend')


def mount_source(path,backend):
    value=str(Path(path).resolve())
    if backend=='wsl':
        normalized=value.replace('\\','/')
        if re.match(r'^[A-Za-z]:/',normalized): return '/mnt/'+normalized[0].lower()+normalized[2:]
    return value


def build_command(image, name, workspace, transport, credentials, timeout, backend='native', distro='Ubuntu'):
    mounts=[(Path(workspace),'/workspace',False),(Path(transport),'/transport',False),
            (Path(transport)/'runtime_code','/opt/eval-adapter',True),(Path(credentials),'/run/secrets/model.json',True)]
    cmd=docker_prefix(backend,distro)+['run','--name',name,'--init','--label','skillloop.owner=openclaw-eval',
         '--memory','6g','--cpus','4','--shm-size','1g','--env','OPENCLAW_EVAL_TIMEOUT='+str(timeout),
         '--env','HF_HUB_OFFLINE=0']
    for source,target,readonly in mounts:
        cmd += ['--mount','type=bind,source='+mount_source(source,backend)+',target='+target+(',readonly' if readonly else '')]
    # A container-side deadline still applies if the host adapter is interrupted.
    return cmd+[image,'timeout','--signal=TERM','--kill-after=15s',str(timeout+90)+'s',
                'python','/opt/eval-adapter/container_runner.py','/transport/request.json']


def skill_read_evidence(events, skills):
    """Conservative evidence: successful read result contains the complete SKILL.md.

    Deliberately does not infer loading from listing, a read attempt, exec mention,
    or the model's answer. Complex reads can remain unknown rather than false true.
    """
    calls={}; receipts=[]
    for event in events:
        msg=event.get('message',event)
        for block in msg.get('content',[]) if isinstance(msg.get('content'),list) else []:
            if block.get('type') not in ('toolCall','tool_use'): continue
            if block.get('name')!='read': continue
            args=block.get('arguments',block.get('input',{}))
            if isinstance(args,str):
                try: args=json.loads(args)
                except ValueError: continue
            path=args.get('path',args.get('file_path',''))
            for sid,skill in skills.items():
                if path==skill['path']: calls[block.get('id')]=(sid,path)
        call_id=msg.get('toolCallId',msg.get('tool_use_id'))
        if msg.get('role')!='toolResult' or call_id not in calls: continue
        sid,path=calls[call_id]
        text='\n'.join(b.get('text','') for b in msg.get('content',[]) if isinstance(b,dict))
        expected=skills[sid]['content'].replace('\r\n','\n').strip()
        complete=not msg.get('isError',False) and bool(expected) and expected in text.replace('\r\n','\n')
        receipts.append({'skill_id':sid,'tool_call_id':call_id,'path':path,'complete_body_observed':complete,
                         'body_sha256':hashlib.sha256(expected.encode()).hexdigest()})
    return {'kind':'openclaw_session_successful_full_read','loaded_skill_ids':sorted({r['skill_id'] for r in receipts if r['complete_body_observed']}),
            'reads':receipts,'limitation':'Only successful full native read evidence is counted; other loading routes remain unknown.'}


def tool_result_summary(events):
    tools=[]
    for event in events:
        message=event.get('message',event)
        if message.get('role')!='toolResult':continue
        details=message.get('details') or {}
        if not isinstance(details,dict):details={}
        code=details.get('exitCode',details.get('exit_code'))
        process_failure=(isinstance(code,int) and not isinstance(code,bool) and code!=0) or details.get('status') in ('failed','error','timeout','timed_out')
        native_error=bool(message.get('isError',False))
        tools.append({'name':message.get('toolName'),'call_id':message.get('toolCallId'),
                      'is_error':native_error,'process_failure':process_failure,'exit_code':code,
                      'observed_failure':native_error or process_failure})
    return {'tools':tools,'native_is_error_count':sum(t['is_error'] for t in tools),
            'structured_process_failure_count':sum(t['process_failure'] for t in tools),
            'tool_error_count':sum(t['observed_failure'] for t in tools)}


def run(request_path, response_path, image=DEFAULT_IMAGE, timeout=900, credentials=None, backend='wsl', distro='Ubuntu'):
    request_path=Path(request_path).resolve(); response_path=Path(response_path).resolve()
    workspace=Path.cwd().resolve()
    credentials=Path(credentials or os.environ.get('OPENCLAW_MODEL_CONFIG','')).resolve()
    cfg=json.loads(credentials.read_text(encoding='utf-8-sig')); secret=cfg['api_key']
    if response_path.exists(): raise ValueError('Response already exists; use a fresh attempt')
    transport=request_path.parent/'openclaw_transport'; transport.mkdir(exist_ok=False)
    code_dir=transport/'runtime_code';code_dir.mkdir()
    # Never mount test cases, fixture answers, verifiers or the rest of the repo.
    for filename in RUNTIME_FILES:
        shutil.copyfile(MODULE/filename,code_dir/filename)
    raw=json.loads(request_path.read_text(encoding='utf-8-sig'))
    payload=project_request(raw,workspace)
    payload['turn_resources']=stage_turn_resources(raw,request_path,transport)
    validate_observation_seconds(payload.get('runtime_observation_seconds',0),timeout)
    write_json(transport/'request.json',payload)
    prefix=docker_prefix(backend,distro)
    inspect=subprocess.run(prefix+['image','inspect',image,'--format','{{.Id}}'],capture_output=True,check=True)
    image_id=inspect.stdout.decode('utf-8').strip()
    name='skillloop-eval-'+uuid.uuid4().hex[:16]
    cmd=build_command(image_id,name,workspace,transport,credentials,timeout,backend,distro)
    started=time.monotonic(); outcome={'image_requested':image,'image_id':image_id,'container':name,'timeout_seconds':timeout,'backend':backend,'distro':distro}
    try:
        # The outer pipeline timeout must exceed this bounded lifetime plus cleanup.
        proc=subprocess.run(cmd,capture_output=True,timeout=timeout+120)
        for label,blob in (('stdout',proc.stdout),('stderr',proc.stderr)):
            (transport/(label+'.log')).write_text(redact(blob.decode('utf-8',errors='replace'),secret),encoding='utf-8')
        outcome['returncode']=proc.returncode
        result_path=transport/'response.json'
        if proc.returncode or not result_path.is_file(): raise RuntimeError('OpenClaw container failed; inspect openclaw_transport logs/receipt')
        result=json.loads(result_path.read_text(encoding='utf-8'))
        if not isinstance(result.get('answer'),str) or not result['answer'].strip(): raise RuntimeError('OpenClaw returned no answer')
        write_json(response_path,redact(result,secret))
        outcome['status']='completed'
    except subprocess.TimeoutExpired as exc:
        for label,blob in (('stdout',exc.stdout),('stderr',exc.stderr)):
            if blob:
                value=blob.decode('utf-8',errors='replace') if isinstance(blob,bytes) else blob
                (transport/(label+'.timeout.log')).write_text(redact(value,secret),encoding='utf-8')
        outcome.update(status='timeout',error='Container exceeded adapter deadline')
        raise RuntimeError(outcome['error']) from exc
    except Exception as exc:
        outcome.update(status='failed',error=redact(str(exc),secret)); raise
    finally:
        try:
            cleanup=subprocess.run(prefix+['rm','--force',name],capture_output=True,timeout=30)
            outcome['cleanup_returncode']=cleanup.returncode
            if cleanup.returncode:
                outcome['cleanup_error']=redact(cleanup.stderr.decode('utf-8',errors='replace'),secret)
        except Exception as exc:
            outcome['cleanup_error']=redact(str(exc),secret)
        outcome['seconds']=time.monotonic()-started
        write_json(transport/'host_receipt.json',outcome)
        if outcome.get('status')=='completed' and outcome.get('cleanup_error'):
            raise RuntimeError('Task completed but container cleanup failed; see host receipt')


def main():
    p=argparse.ArgumentParser();p.add_argument('request');p.add_argument('response')
    p.add_argument('--image',default=DEFAULT_IMAGE);p.add_argument('--timeout',type=int,default=900)
    p.add_argument('--credentials',default=None)
    p.add_argument('--backend',choices=['native','wsl'],default='wsl');p.add_argument('--distro',default='Ubuntu')
    args=p.parse_args();run(args.request,args.response,args.image,args.timeout,args.credentials,args.backend,args.distro)


if __name__=='__main__': main()
