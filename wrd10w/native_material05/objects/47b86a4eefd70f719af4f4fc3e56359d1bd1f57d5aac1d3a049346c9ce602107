import fs from 'node:fs';import vm from 'node:vm';
const c={window:{}};vm.createContext(c);
vm.runInContext(fs.readFileSync('/workspace/outputs/skill/examples/ball_bounce/topic.js','utf8'),c);
const cfg=JSON.parse(fs.readFileSync('/workspace/outputs/skill/examples/ball_bounce/config.json','utf8'));
const sim=c.window.TopicSim.create(cfg,{},{});
const height=()=>parseFloat(sim.hudValues().find(x=>x.label.includes('高度')).value);
const impact=()=>sim.hudValues().find(x=>x.label.includes('地面冲击力')).value;
const start=height();sim.step(1/120);const first=height();
let heights=[];for(let i=0;i<500;i++){sim.step(1/120);heights.push(height());}
let low=heights.findIndex(x=>x<=0.03);
const bounced=low>=0&&heights.slice(low+1).some(x=>x>0.1);
console.log(JSON.stringify({dropHeight:cfg.physics.dropHeight,start,first,firstImpact:impact(),min:Math.min(...heights),max:Math.max(...heights),contactIndex:low,bounced}));
