<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>冬天溜冰的作用力</title>
<style>
body{font-family:"Noto Sans CJK SC","Noto Sans SC",sans-serif;background:#0f1b2d;color:#e8eef7;margin:0;padding:24px}
h1{font-size:22px;margin:0 0 6px}
.wrd-subtitle{margin:0 0 16px;color:#a9bcd6;font-size:14px}
.wrd-stage{position:relative;display:inline-block}
.wrd-hud{position:absolute;top:12px;left:12px;background:rgba(8,15,28,.75);border-radius:8px;padding:10px 14px;font-size:14px;line-height:1.7;pointer-events:none}
.wrd-hud-row{display:flex;gap:14px;justify-content:space-between;min-width:190px}
.wrd-hud-label{color:#a9bcd6}
.wrd-hud-value{font-variant-numeric:tabular-nums}
.wrd-controls{margin-top:12px;display:flex;gap:10px}
.wrd-controls button{font:inherit;padding:6px 18px;border-radius:6px;border:1px solid #3b537a;background:#1b2c49;color:#e8eef7;cursor:pointer}
.wrd-controls button:hover{background:#274067}
.wrd-legend{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px 24px;font-size:13px;color:#c6d4e8;max-width:960px}
.wrd-legend .chip{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.wrd-error{color:#ff9c9c;font-size:15px;white-space:pre-wrap;margin-top:16px}
</style>
</head>
<body>
<h1>冬天溜冰的作用力</h1>
<p class="wrd-subtitle">滑冰者在冰面上的受力实时示意：蹬冰时向前加速，滑行时摩擦力与空气阻力使其减速。箭头长度∝力的大小（过小的力放大到最小可见长度），具体数值见左上角。属简化物理模型，非精确仿真。</p>
<div class="wrd-stage" id="wrd-stage">
  <canvas id="wrd-canvas"></canvas>
</div>
<div class="wrd-legend"><span><span class="chip" style="background:#9aa7bd"></span><b>重力 G</b>：大小 mg，竖直向下</span><span><span class="chip" style="background:#2a9d8f"></span><b>支持力 N</b>：冰面对滑冰者的反作用力，竖直向上，与重力平衡</span><span><span class="chip" style="background:#e63946"></span><b>蹬冰推力 F</b>：蹬冰时冰面给刀刃的反作用力，推动人向前（牛顿第三定律）</span><span><span class="chip" style="background:#f4a261"></span><b>摩擦力 f</b>：方向与运动相反；冰面摩擦系数很小，所以能滑很远</span><span><span class="chip" style="background:#8d99ae"></span><b>空气阻力</b>：与速度方向相反，随速度增大而增大</span></div>
<script>
/* wrd-anim scaffold v1 —— 可复用的时序/状态/绘制基元。
 * 只关心:画布尺寸、帧循环(暂停/继续/重置)、力箭头、HUD、控制条。
 * 不含任何具体题材(物理/领域)知识;题材代码在 topic 模块中。
 * 契约: window.TopicSim.create(config, ctx, WRD) -> {step(dt), draw(ctx), hudValues(), reset()}
 */
(function (global) {
  'use strict';

  const WRD = { frames: 0 };

  WRD.setupCanvas = function (canvas, width, height) {
    if (!canvas || !(width > 0) || !(height > 0)) {
      throw new Error('WRD.setupCanvas: 需要canvas元素与正的width/height');
    }
    const dpr = global.devicePixelRatio || 1;
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return ctx;
  };

  class Loop {
    constructor({ stepDt, step, draw, hud } = {}) {
      if (typeof step !== 'function' || typeof draw !== 'function') {
        throw new Error('WRD.Loop 需要 step(dt) 与 draw() 两个回调');
      }
      this.stepDt = stepDt || 1 / 120;
      this.step = step;
      this.draw = draw;
      this.hud = hud || null;
      this.onReset = null;
      this.playing = false;
      this._acc = 0;
      this._last = null;
      this._raf = null;
      this._tick = this._tick.bind(this);
    }
    start() {
      this.playing = true;
      if (!this._raf) this._raf = global.requestAnimationFrame(this._tick);
    }
    pause() { this.playing = false; }
    toggle() { if (this.playing) { this.pause(); } else { this.start(); } }
    reset() {
      this._acc = 0;
      if (this.onReset) this.onReset();
      if (!this._raf) this._raf = global.requestAnimationFrame(this._tick);
    }
    _tick(now) {
      this._raf = global.requestAnimationFrame(this._tick);
      if (this.playing) {
        if (this._last === null) this._last = now;
        this._acc += Math.min((now - this._last) / 1000, 0.25);
        this._last = now;
        while (this._acc >= this.stepDt) {
          this.step(this.stepDt);
          this._acc -= this.stepDt;
        }
      } else {
        this._last = now;
      }
      this.draw();
      if (this.hud) this.hud();
      WRD.frames++;
    }
  }
  WRD.Loop = Loop;

  /* 从(x1,y1)到(x2,y2)画带箭头线,可带文字标签;opts: color,width,headLen,label,labelFont */
  WRD.drawArrow = function (ctx, x1, y1, x2, y2, opts = {}) {
    const color = opts.color || '#e63946';
    const width = opts.width || 3;
    const dx = x2 - x1, dy = y2 - y1;
    const len = Math.hypot(dx, dy);
    if (!(len >= 1)) return;
    const ux = dx / len, uy = dy / len;
    const head = Math.min(opts.headLen || 10, len * 0.5);
    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2 - ux * head, y2 - uy * head);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x2, y2);
    ctx.lineTo(x2 - ux * head - uy * head * 0.45, y2 - uy * head + ux * head * 0.45);
    ctx.lineTo(x2 - ux * head + uy * head * 0.45, y2 - uy * head - ux * head * 0.45);
    ctx.closePath();
    ctx.fill();
    if (opts.label) {
      ctx.font = opts.labelFont || '14px "Noto Sans CJK SC", sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const pad = 13;
      ctx.fillText(opts.label, x2 + ux * pad, y2 + uy * pad);
    }
    ctx.restore();
  };

  /* HUD:返回 {set(items)};items=[{label,value}] 仅显示已出现过的行 */
  WRD.makeHUD = function (container) {
    const el = global.document.createElement('div');
    el.className = 'wrd-hud';
    container.appendChild(el);
    const valueEls = new Map();
    return {
      set(items) {
        if (!Array.isArray(items)) return;
        for (const it of items) {
          let v = valueEls.get(it.label);
          if (!v) {
            const row = global.document.createElement('div');
            row.className = 'wrd-hud-row';
            const l = global.document.createElement('span');
            l.className = 'wrd-hud-label';
            l.textContent = it.label;
            v = global.document.createElement('span');
            v.className = 'wrd-hud-value';
            row.appendChild(l);
            row.appendChild(v);
            el.appendChild(row);
            valueEls.set(it.label, v);
          }
          v.textContent = String(it.value);
        }
      }
    };
  };

  /* 控制条:暂停/继续 + 重置,并绑定 Space/R 键 */
  WRD.makeControls = function (container, loop, opts = {}) {
    if (!loop || typeof loop.toggle !== 'function') {
      throw new Error('WRD.makeControls 需要一个 WRD.Loop 实例');
    }
    const labels = Object.assign(
      { pause: '暂停', resume: '继续', reset: '重置' }, opts.labels || {});
    const bar = global.document.createElement('div');
    bar.className = 'wrd-controls';
    const toggleBtn = global.document.createElement('button');
    toggleBtn.className = 'wrd-btn-toggle';
    const resetBtn = global.document.createElement('button');
    resetBtn.className = 'wrd-btn-reset';
    const syncToggle = () => {
      toggleBtn.textContent = loop.playing ? labels.pause : labels.resume;
    };
    toggleBtn.addEventListener('click', () => { loop.toggle(); syncToggle(); });
    resetBtn.textContent = labels.reset;
    resetBtn.addEventListener('click', () => { loop.reset(); syncToggle(); });
    bar.appendChild(toggleBtn);
    bar.appendChild(resetBtn);
    container.appendChild(bar);
    global.document.addEventListener('keydown', (ev) => {
      if (ev.code === 'Space') { ev.preventDefault(); loop.toggle(); syncToggle(); }
      else if (ev.code === 'KeyR') { loop.reset(); syncToggle(); }
    });
    return { toggleBtn, resetBtn };
  };

  global.WRD = WRD;
})(window);

</script>
<script>
window.TopicSim = { create() { throw new Error("缺少 physics.mass"); } };

</script>
<script>

(function boot() {
  function showError(msg) {
    var d = document.createElement('div');
    d.className = 'wrd-error';
    d.textContent = '启动失败: ' + msg;
    document.body.appendChild(d);
  }
  try {
    var cfg = {"lang": "zh", "title": "冬天溜冰的作用力", "subtitle": "滑冰者在冰面上的受力实时示意：蹬冰时向前加速，滑行时摩擦力与空气阻力使其减速。箭头长度∝力的大小（过小的力放大到最小可见长度），具体数值见左上角。属简化物理模型，非精确仿真。", "canvas": {"width": 960, "height": 540}, "physics": {"mass": 65, "g": 9.8, "mu": 0.01, "thrust": 250, "vCap": 9, "strokeInterval": 2.2, "strokeDuration": 0.6, "dragK": 0.32}, "arrowScale": 0.15, "legend": [{"color": "#9aa7bd", "label": "重力 G", "desc": "大小 mg，竖直向下"}, {"color": "#2a9d8f", "label": "支持力 N", "desc": "冰面对滑冰者的反作用力，竖直向上，与重力平衡"}, {"color": "#e63946", "label": "蹬冰推力 F", "desc": "蹬冰时冰面给刀刃的反作用力，推动人向前（牛顿第三定律）"}, {"color": "#f4a261", "label": "摩擦力 f", "desc": "方向与运动相反；冰面摩擦系数很小，所以能滑很远"}, {"color": "#8d99ae", "label": "空气阻力", "desc": "与速度方向相反，随速度增大而增大"}]};
    var canvas = document.getElementById('wrd-canvas');
    var stage = document.getElementById('wrd-stage');
    if (!window.TopicSim || typeof window.TopicSim.create !== 'function') {
      throw new Error('topic 模块未定义 window.TopicSim.create(config, ctx, WRD)');
    }
    var ctx = WRD.setupCanvas(canvas, cfg.canvas.width, cfg.canvas.height);
    var sim = window.TopicSim.create(cfg, ctx, WRD);
    var loop = new WRD.Loop({
      step: function (dt) { sim.step(dt); },
      draw: function () { sim.draw(ctx); },
      hud: function () { hud.set(sim.hudValues()); }
    });
    var hud = WRD.makeHUD(stage);
    loop.onReset = function () { sim.reset(); };
    WRD.makeControls(stage, loop, { onReset: function () {} });
    hud.set(sim.hudValues());
    loop.start();
  } catch (err) {
    showError(err && err.message ? err.message : String(err));
  }
})();

</script>
</body>
</html>
