用资源。","tool_calls":[{"id":"call696b716aa29248d0a685caeb3c8e21ac","type":"function","function":{"name":"write","arguments":"{\"content\":\"/* wrd-anim scaffold v1 —— 可复用的时序/状态/绘制基元。\\n * 只关心:画布尺寸、帧循环(暂停/继续/重置)、力箭头、HUD、控制条。\\n * 不含任何具体题材(物理/领域)知识;题材代码在 topic 模块中。\\n * 契约: window.TopicSim.create(config, ctx, WRD) -> {step(dt), draw(ctx), hudValues(), reset()}\\n */\\n(function (global) {\\n  'use strict';\\n\\n  const WRD = { frames: 0 };\\n\\n  WRD.setupCanvas = function (canvas, width, height) {\\n    if (!canvas || !(width > 0) || !(height > 0)) {\\n      throw new Error('WRD.setupCanvas: 需要canvas元素与正的width/height');\\n    }\\n    const dpr = global.devicePixelRatio || 1;\\n    canvas.width = Math.round(width * dpr);\\n    canvas.height = Math.round(height * dpr);\\n    canvas.style.width = width + 'px';\\n    canvas.style.height = height + 'px';\\n    const ctx = canvas.getContext('2d');\\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\\n    return ctx;\\n  };\\n\\n  class Loop {\\n    constructor({ stepDt, step, draw, hud } = {}) {\\n      if (typeof step !== 'function' || typeof draw !== 'function') {\\n        throw new Error('WRD.Loop 需要 step(dt) 与 draw() 两个回调');\\n      }\\n      this.stepDt = stepDt || 1 / 120;\\n      this.step = step;\\n      this.draw = draw;\\n      this.hud = hud || null;\\n      this.onReset = null;\\n      this.playing = false;\\n      this._acc = 0;\\n      this._last = null;\\n      this._raf = null;\\n      this._tick = this._tick.bind(this);\\n    }\\n    start() {\\n      this.playing = true;\\n      if (!this._raf) this._raf = global.requestAnimationFrame(this._tick);\\n    }\\n    pause() { this.playing = false; }\\n    toggle() { if (this.playing) { this.pause(); } else { this.start(); } }\\n    reset() {\\n      this._acc = 0;\\n      if (this.onReset) this.onReset();\\n      if (!this._raf) this._raf = global.requestAnimationFrame(this._tick);\\n    }\\n    _tick(now) {\\n      this._raf = global.requestAnimationFrame(this._tick);\\n      if (this.playing) {\\n        if (this._last === null) this._last = now;\\n        this._acc += Math.min((now - this._last) / 1000, 0.25);\\n        this._last = now;\\n        while (this._acc >= this.stepDt) {\\n          this.step(this.stepDt);\\n          this._acc -= this.stepDt;\\n        }\\n      } else {\\n        this._last = now;\\n      }\\n      this.draw();\\n      if (this.hud) this.hud();\\n      WRD.frames++;\\n    }\\n  }\\n  WRD.Loop = Loop;\\n\\n  /* 从(x1,y1)到(x2,y2)画带箭头线,可带文字标签;opts: color,width,headLen,label,labelFont */\\n  WRD.drawArrow = function (ctx, x1, y1, x2, y2, opts = {}) {\\n    const color = opts.color || '#e63946';\\n    const width = opts.width || 3;\\n    const dx = x2 - x1, dy = y2 - y1;\\n    const len = Math.hypot(dx, dy);\\n    if (!(len >= 1)) return;\\n    const ux = dx / len, uy = dy / len;\\n    const head = Math.min(opts.headLen || 10, len * 0.5);\\n    ctx.save();\\n    ctx.strokeStyle = color;\\n    ctx.fillStyle = color;\\n    ctx.lineWidth = width;\\n    ctx.lineCap = 'round';\\n    ctx.beginPath();\\n    ctx.moveTo(x1, y1);\\n    ctx.lineTo(x2 - ux * head, y2 - uy * head);\\n    ctx.stroke();\\n    ctx.beginPath();\\n    ctx.moveTo(x2, y2);\\n    ctx.lineTo(x2 - ux * head - uy * head * 0.45, y2 - uy * head + ux * head * 0.45);\\n    ctx.lineTo(x2 - ux * head + uy * head * 0.45, y2 - uy * head - ux * head * 0.45);\\n    ctx.closePath();\\n    ctx.fill();\\n    if (opts.label) {\\n      ctx.font = opts.labelFont || '14px \\\"Noto Sans CJK SC\\\", sans-serif';\\n      ctx.textAlign = 'center';\\n      ctx.textBaseline = 'middle';\\n      const pad = 13;\\n      ctx.fillText(opts.label, x2 + ux * pad, y2 + uy * pad);\\n    }\\n    ctx.restore();\\n  };\\n\\n  /* HUD:返回 {set(items)};items=[{label,value}] 仅显示已出现过的行 */\\n  WRD.makeHUD = function (container) {\\n    const el = global.document.createElement('div');\\n    el.className = 'wrd-hud';\\n    container.appendChild(el);\\n    const valueEls = new Map();\\n    return {\\n      set(items) {\\n        if (!Array.isArray(items)) return;\\n        for (const it of items) {\\n          let v = valueEls.get(it.label);\\n          if (!v) {\\n            const row = global.document.createElement('div');\\n            row.className = 'wrd-hud-row';\\n            const l = global.document.createElement('span');\\n            l.className = 'wrd-hud-label';\\n            l.textContent = it.label;\\n            v = global.document.createElement('span');\\n            v.className = 'wrd-hud-value';\\n            row.appendChild(l);\\n            row.appendChild(v);\\n            el.appendChild(row);\\n            valueEls.set(it.label, v);\\n          }\\n          v.textContent = String(it.value);\\n        }\\n      }\\n    };\\n  };\\n\\n  /* 控制条:暂停/继续 + 重置,并绑定 Space/R 键 */\\n  WRD.makeControls = function (container, loop, opts = {}) {\\n    if (!loop || typeof loop.toggle !== 'function') {\\n      throw new Error('WRD.makeControls 需要一个 WRD.Loop 实例');\\n    }\\n    const labels = Object.assign(\\n      { pause: '暂停', resume: '继续', reset: '重置' }, opts.labels || {});\\n    const bar = global.document.createElement('div');\\n    bar.className = 'wrd-controls';\\n    const toggleBtn = global.document.createElement('button');\\n    toggleBtn.className = 'wrd-btn-toggle';\\n    const resetBtn = global.document.createElement('button');\\n    resetBtn.className = 'wrd-btn-reset';\\n    const syncToggle = () => {\\n      toggleBtn.textContent = loop.playing ? labels.pause : labels.resume;\\n    };\\n    toggleBtn.addEventListener('click', () => { loop.toggle(); syncToggle(); });\\n    resetBtn.textContent = labels.reset;\\n    resetBtn.addEventListener('click', () => { loop.reset(); syncToggle(); });\\n    bar.appendChild(toggleBtn);\\n    bar.appendChild(resetBtn);\\n    container.appendChild(bar);\\n    global.document.addEventListener('keydown', (ev) => {\\n      if (ev.code === 'Space') { ev.preventDefault(); loop.toggle(); syncToggle(); }\\n      else if (ev.code === 'KeyR') { loop.reset(); syncToggle(); }\\n    });\\n    return { toggleBtn, resetBtn };\\n  };\\n\\n  global.WRD = WRD;\\n})(window);\\n\",\"path\":\"/workspace/outputs/skill/assets/scaffold.js\"}"}}]},{"role":"tool","content":"Successfully wrote 5958 bytes to /workspace/outputs/skill/assets/scaffold.js","tool_call_id":"call696b716aa29248d0a685caeb3c8e21ac"},{"role":"assistant","content":null,"tool_calls":[{"id":"calla8782f80b98f409d8aa34a0020a0ef7e","type":"function","function":{"name":"write","arguments":"{\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"gen_animation.py —— 把 config(JSON 数据) + topic.js(题材代码) + scaffold.js\\n组装成一个自包含的可运行解释性 HTML 动画。\\n\\n用法:\\n  python gen_animation.py --config CONFIG.json --topic TOPIC.js --out OUT.html\\n\\nconfig 必需字段: canvas{width,height}(正整数), title(str)\\nconfig 可选字段: lang, subtitle, physics(任意对象,交给topic), arrowScale, legend[{color,label,desc}]\\n退出码: 0 成功; 2 配置文件缺失/非法JSON/缺必需字段; 3 topic模块缺少 TopicSim\\n\\\"\\\"\\\"\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\n\\ndef fail(code: int, msg: str) -> None:\\n    print(f\\\"gen_animation: 错误: {msg}\\\", file=sys.stderr)\\n    sys.exit(code)\\n\\n\\ndef validate(cfg: dict) -> None:\\n    canvas = cfg.get(\\\"canvas\\\")\\n    if not isinstance(canvas, dict):\\n        fail(2, \\\"config 缺少必需字段 canvas(对象)\\\")\\n    for key in (\\\"width\\\", \\\"height\\\"):\\n        v = canvas.get(key)\\n        if not isinstance(v, int) or isinstance(v, bool) or v <= 0:\\n            fail(2, f\\\"config canvas.{key} 必须是正整数, 实际: {v!r}\\\")\\n    if not isinstance(cfg.get(\\\"title\\\"), str) or not cfg[\\\"title\\\"].strip():\\n        fail(2, 'config 缺少必需字段 title(非空字符串)')\\n    legend = cfg.get(\\\"legend\\\", [])\\n    if not isinstance(legend, list):\\n        fail(2, \\\"config.legend 必须是数组\\\")\\n    for i, item in enumerate(legend):\\n        if not isinstance(item, dict) or not all(\\n            isinstance(item.get(k), str) for k in (\\\"color\\\", \\\"label\\\", \\\"desc\\\")\\n        ):\\n            fail(2, f\\\"config.legend[{i}] 需要 {{color,label,desc}} 三个字符串字段\\\")\\n\\n\\ndef js_str(s: str) -> str:\\n    return json.dumps(s, ensure_ascii=False)\\n\\n\\nSTYLE = \\\"\\\"\\\"\\nbody{font-family:\\\"Noto Sans CJK SC\\\",\\\"Noto Sans SC\\\",sans-serif;background:#0f1b2d;color:#e8eef7;margin:0;padding:24px}\\nh1{font-size:22px;margin:0 0 6px}\\n.wrd-subtitle{margin:0 0 16px;color:#a9bcd6;font-size:14px}\\n.wrd-stage{position:relative;display:inline-block}\\n.wrd-hud{position:absolute;top:12px;left:12px;background:rgba(8,15,28,.75);border-radius:8px;padding:10px 14px;font-size:14px;line-height:1.7;pointer-events:none}\\n.wrd-hud-row{display:flex;gap:14px;justify-content:space-between;min-width:190px}\\n.wrd-hud-label{color:#a9bcd6}\\n.wrd-hud-value{font-variant-numeric:tabular-nums}\\n.wrd-controls{margin-top:12px;display:flex;gap:10px}\\n.wrd-controls button{font:inherit;padding:6px 18px;border-radius:6px;border:1px solid #3b537a;background:#1b2c49;color:#e8eef7;cursor:pointer}\\n.wrd-controls button:hover{background:#274067}\\n.wrd-legend{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px 24px;font-size:13px;color:#c6d4e8;max-width:960px}\\n.wrd-legend .chip{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}\\n.wrd-error{color:#ff9c9c;font-size:15px;white-space:pre-wrap;margin-top:16px}\\n\\\"\\\"\\\"\\n\\nBOOT = \\\"\\\"\\\"\\n(function boot() {\\n  function showError(msg) {\\n    var d = document.createElement('div');\\n    d.className = 'wrd-error';\\n    d.textContent = '启动失败: ' + msg;\\n    document.body.appendChild(d);\\n  }\\n  try {\\n    var cfg = __WRD_CONFIG__;\\n    var canvas = document.getElementById('wrd-canvas');\\n    var stage = document.getElementById('wrd-stage');\\n    if (!window.TopicSim || typeof window.TopicSim.create !== 'function') {\\n      throw new Error('topic 模块未定义 window.TopicSim.create(config, c