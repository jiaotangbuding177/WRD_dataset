{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wrd-draft-v1",
  "title": "按用途成稿（draft）schema",
  "description": "成稿 JSON 是账本到交付文本之间的可校验中间产物：文本 + fact ID 引用 + 声明数字 + 长度/段落/交付状态。目标Word未提供时只交文本并显式声明 TEXT_ONLY 状态。",
  "type": "object",
  "required": ["schema", "draft_id", "document_kind", "text", "fact_refs"],
  "properties": {
    "schema": {"const": "wrd-draft-v1"},
    "draft_id": {"type": "string"},
    "document_kind": {
      "enum": ["official_report", "one_paragraph"],
      "description": "official_report=官方汇报；one_paragraph=一段话成稿（默认段落上限1）。"
    },
    "text": {"type": "string", "minLength": 1},
    "word_target": {
      "type": ["object", "null"],
      "description": "用户给了字数要求时必填。counting_mode 缺省为 non_whitespace（去空白字符计数），口径必须对用户可解释。",
      "properties": {
        "char_limit": {"type": "integer", "minimum": 1},
        "counting_mode": {"enum": ["all_characters", "non_whitespace"]}
      }
    },
    "paragraph_constraints": {
      "type": "object",
      "properties": {
        "min": {"type": "integer", "minimum": 1},
        "max": {"type": ["integer", "null"]}
      }
    },
    "word_delivery": {
      "type": "object",
      "description": "交付状态必须显式。target_provided=false 时校验器输出 TEXT_ONLY_NO_WORD_TARGET。",
      "properties": {
        "target_provided": {"type": "boolean"},
        "written": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "fact_refs": {
      "type": "array",
      "minItems": 1,
      "description": "成稿使用的账本事实 ID 与陈述角色。as_type 闭包由校验器检查。",
      "items": {
        "type": "object",
        "required": ["fact_id", "as_type"],
        "properties": {
          "fact_id": {"type": "string"},
          "as_type": {
            "enum": ["achieved_fact", "planned_goal", "context", "requirement"],
            "description": "planned_goal 事实只允许 as_type=planned_goal；声明成 achieved_fact 为硬错误。"
          }
        }
      }
    },
    "declared_numbers": {
      "type": "array",
      "description": "成稿文本中使用的每个核心数字逐条声明：value/unit/subject 必须与账本一致，且数值必须出现在文本中。未声明的文本数字会被列入 NEEDS_SEMANTIC_REVIEW。",
      "items": {
        "type": "object",
        "required": ["fact_id", "value"],
        "properties": {
          "fact_id": {"type": "string"},
          "value": {"type": "string"},
          "unit": {"type": ["string", "null"]},
          "subject": {"type": ["string", "null"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
