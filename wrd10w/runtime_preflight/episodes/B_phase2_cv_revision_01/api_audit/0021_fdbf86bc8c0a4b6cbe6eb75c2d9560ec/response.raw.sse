data: {"id":"chatcmpl-1793079246334","object":"chat.completion.chunk","created":1793079246,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call29013c220ad7436d9c37f43589bf4c17","type":"function","function":{"name":"apply_patch","arguments":"{\"input\":\"*** Begin Patch\\n*** Update File: /workspace/outputs/skill/scripts/cvlib.py\\n@@\\n-    pages = []\\n+    pages = []\\n+    saw_any_text = False\\n     for i, page in enumerate(doc):\\n         raw = page.get_text()\\n+        if raw.strip():\\n+            saw_any_text = True\\n         cleaned = clean_page_text(raw)\\n         pages.append({\\n             \\\"page\\\": i + 1,\\n             \\\"lines\\\": cleaned,\\n             \\\"text\\\": \\\"\\\\n\\\".join(cleaned),\\n+            # Unfiltered page text is retained so display filtering can never\\n+            # erase legitimate evidence (literal quotes validate against it).\\n+            \\\"raw_text\\\": raw,\\n         })\\n     doc.close()\\n+    if not saw_any_text:\\n+        raise ExtractError(\\n+            f\\\"no usable text layer (scanned image; needs OCR): {p}\\\")\\n     sha = hashlib.sha256(data).hexdigest()\\n@@\\n def find_quote(cv, quote, page=None):\\n     \\\"\\\"\\\"Locate a normalized literal quote. Returns dict with ok/reason and the\\n-    page(s) where the quote actually occurs (for mismatch diagnostics).\\\"\\\"\\\"\\n+    page(s) where the quote actually occurs (for mismatch diagnostics).\\n+    Matching runs against each page's raw_text so display-side filtering\\n+    (e.g. the watermark heuristic) cannot hide real PDF text from evidence\\n+    checks.\\\"\\\"\\\"\\n@@\\n-    hits = [pg[\\\"page\\\"] for pg in cv[\\\"pages\\\"] if norm in normalize(pg[\\\"text\\\"])]\\n+    hits = [\\n+        pg[\\\"page\\\"] for pg in cv[\\\"pages\\\"]\\n+        if norm in normalize(pg.get(\\\"raw_text\\\", pg[\\\"text\\\"]))\\n+    ]\\n*** End Patch\\n\"}"}}]},"finish_reason":null}]}

