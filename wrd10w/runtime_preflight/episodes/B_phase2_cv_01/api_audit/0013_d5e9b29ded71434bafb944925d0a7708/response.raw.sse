data: {"id":"chatcmpl-1793076938143","object":"chat.completion.chunk","created":1793076938,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call00f67325959d418ea1e3ffb5d417b3de","type":"function","function":{"name":"exec","arguments":"{\"command\":\"cat > /workspace/tmp/make_fixtures.py << 'PYEOF'\\nimport pymupdf, pathlib\\nFONT = \\\"/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc\\\"\\nFIX = pathlib.Path(\\\"/workspace/tmp/fixtures\\\")\\n\\ndef make_pdf(path, pages_text):\\n    doc = pymupdf.open()\\n    for t in pages_text:\\n        page = doc.new_page()\\n        y = 72\\n        for line in t.splitlines():\\n            page.insert_text((50, y), line, fontfile=FONT, fontname=\\\"cjk\\\", fontsize=11)\\n            y += 18\\n    doc.subset_fonts()\\n    doc.save(path, garbage=4, deflate=True)\\n    doc.close()\\n\\nmake_pdf(FIX / \\\"synthetic_cv_A.pdf\\\", [\\n    \\\"张三\\\",\\n    \\\"12年工作经验 | 人力资源经理\\\",\\n    \\\"个人优势：熟悉三支柱，擅长绩效薪酬。\\\",\\n    \\\"2018.03-至今 某机器人公司 人力资源经理，负责招聘机器人算法工程师30人。\\\",\\n])\\nmake_pdf(FIX / \\\"synthetic_cv_B.pdf\\\", [\\n    \\\"李四\\\",\\n    \\\"5年工作经验 | 招聘专员\\\",\\n    \\\"个人优势：校招经验丰富。无总监经历。\\\",\\n])\\nprint(\\\"fixtures done\\\")\\nPYEOF\\npython3 /workspace/tmp/make_fixtures.py && ls -la /workspace/tmp/fixtures/*.pdf | awk '{print $5, $9}'\"}"}}]},"finish_reason":null}]}

