data: {"id":"chatcmpl-1793076833907","object":"chat.completion.chunk","created":1793076833,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call9a68fc909c6d4af09b47dd663fb263e6","type":"function","function":{"name":"exec","arguments":"{\"command\":\"cat > /workspace/outputs/skill/scripts/cv_extract.py << 'EOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Extract per-page text + candidate identity from one or more CV PDFs.\\n\\nUsage:\\n  cv_extract.py FILE.pdf [MORE.pdf ...] [--json OUT.json] [--raw]\\n\\nOutput (stdout, or written to --json): one JSON document\\n  {\\\"results\\\": [ {file, candidate_id, sha256, bytes, page_count,\\n                 identity_lines, pages:[{page, text, lines?}]} ],\\n   \\\"errors\\\": [ {file, error} ]}\\nExit codes: 0 all files extracted; 2 every file failed; 3 some failed.\\nEach candidate is identified by content sha256 (candidate_id), so renamed\\nfiles and multi-file batches never cross-mix candidates.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parent))\\nimport cvlib\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser(description=\\\"Extract per-page text from CV PDFs\\\")\\n    ap.add_argument(\\\"files\\\", nargs=\\\"+\\\", help=\\\"one or more PDF paths\\\")\\n    ap.add_argument(\\\"--json\\\", dest=\\\"json_out\\\", help=\\\"also write JSON report to this path\\\")\\n    ap.add_argument(\\\"--raw\\\", action=\\\"store_true\\\", help=\\\"include raw cleaned lines per page\\\")\\n    args = ap.parse_args()\\n\\n    results, errors = cvlib.extract_many(args.files)\\n    if not args.raw:\\n        for r in results:\\n            for pg in r[\\\"pages\\\"]:\\n                pg.pop(\\\"lines\\\", None)\\n    report = {\\\"results\\\": results, \\\"errors\\\": errors}\\n    payload = json.dumps(report, ensure_ascii=False, indent=2)\\n    if args.json_out:\\n        Path(args.json_out).write_text(payload, encoding=\\\"utf-8\\\")\\n    print(payload)\\n    if errors and len(errors) == len(args.files):\\n        return 2\\n    if errors:\\n        return 3\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\nEOF\\ncat > /workspace/outputs/skill/scripts/evidence_check.py << 'EOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"Validate literal quotes cited from CV PDFs (quote/page/candidate claims).\\n\\nUsage:\\n  evidence_check.py CLAIMS.json [--json OUT.json]\\n\\nCLAIMS.json: array of\\n  [{\\\"file\\\": \\\"path/to/cv.pdf\\\", \\\"quote\\\": \\\"literal text from the CV\\\",\\n    \\\"page\\\": 2}, ...]                 # page optional but recommended\\nQuotes are whitespace-normalized (line breaks inside a quote are fine).\\nFails on: quote not found, quote on a different page than claimed,\\nout-of-range page, or any file-level extraction error (missing/empty/corrupt).\\nExit codes: 0 all claims valid; 2 any failure. Failure report goes to stdout\\nas JSON with per-claim reason and the page(s) where the quote actually is.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport json\\nimport sys\\nfrom pathlib import Path\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parent))\\nimport cvlib\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser(description=\\\"Check literal CV quotes against pages\\\")\\n    ap.add_argument(\\\"claims\\\", help=\\\"JSON file with claim array\\\")\\n    ap.add_argument(\\\"--json\\\", dest=\\\"json_out\\\", help=\\\"also write JSON report to this path\\\")\\n    args = ap.parse_args()\\n\\n    claims_path = Path(args.claims)\\n    if not claims_path.exists():\\n        print(json.dumps({\\\"ok\\\": False, \\\"error\\\": f\\\"claims file not found: {claims_path}\\\"},\\n                         ensure_ascii=False))\\n        return 2\\n    try:\\n        claims = json.loads(claims_path.read_text(encoding=\\\"utf-8\\\"))\\n    except (json.JSONDecodeError, OSError) as exc:\\n        print(json.dumps({\\\"ok\\\": False, \\\"error\\\": f\\\"claims file unreadable: {exc}\\\"},\\n                         ensure_ascii=False))\\n        return 2\\n    if not isinstance(claims, list):\\n        print(json.dumps({\\\"ok\\\": False, \\\"error\\\": \\\"claims must be a JSON array\\\"},\\n                         ensure_ascii=False))\\n        return 2\\n\\n    cache = {}\\n    report, any_fail = [], False\\n    for idx, claim in enumerate(claims):\\n        entry = {\\\"index\\\": idx, \\\"file\\\": claim.get(\\\"file\\\"), \\\"ok\\\": False}\\n        path = claim.get(\\\"file\\\")\\n        if not path:\\n            entry[\\\"reason\\\"] = \\\"claim missing 'file'\\\"\\n            any_fail = True\\n        else:\\n            if path not in cache:\\n                try:\\n                    cache[path] = (cvlib.extract_pdf(path), None)\\n                except cvlib.ExtractError as exc:\\n                    cache[path] = (None, str(exc))\\n            cv, err = cache[path]\\n            if err:\\n                entry[\\\"reason\\\"] = f\\\"file error: {err}\\\"\\n                any_fail = True\\n            else:\\n                entry[\\\"candidate_id\\\"] = cv[\\\"candidate_id\\\"]\\n                res = cvlib.find_quote(cv, claim.get(\\\"quote\\\", \\\"\\\"), claim.get(\\\"page\\\"))\\n                entry.update(res)\\n                if not res[\\\"ok\\\"]:\\n                    any_fail = True\\n        report.append(entry)\\n\\n    out = {\\\"ok\\\": not any_fail, \\\"claims\\\": report}\\n    payload = json.dumps(out, ensure_ascii=False, indent=2)\\n    if args.json_out:\\n        Path(args.json_out).write_text(payload, encoding=\\\"utf-8\\\")\\n    print(payload)\\n    return 0 if not any_fail else 2\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\nEOF\\necho written && python3 -c \\\"import ast; ast.parse(open('/workspace/outputs/skill/scripts/cvlib.py').read()); ast.parse(open('/workspace/outputs/skill/scripts/cv_extract.py').read()); ast.parse(open('/workspace/outputs/skill/scripts/evidence_check.py').read()); print('syntax ok')\\\"\"}"}}]},"finish_reason":null}]}

