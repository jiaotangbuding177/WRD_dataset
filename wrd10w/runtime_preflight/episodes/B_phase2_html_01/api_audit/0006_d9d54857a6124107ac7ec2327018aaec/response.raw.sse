data: {"id":"chatcmpl-1793077795336","object":"chat.completion.chunk","created":1793077795,"model":"glm-5.3-flash","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"call36cb9ef771a4497783e12bb4a139c974","type":"function","function":{"name":"write","arguments":"{\"content\":\"#!/usr/bin/env node\\n/**\\n * verify_animation.mjs —— 实际渲染验证生成的 HTML 动画。\\n * 检查: 加载无控制台错误; 播放中画面持续变化; 暂停后停止变化; 继续恢复; 重置后 HUD 时间归零。\\n * 用法: node verify_animation.mjs PAGE.html --screenshot out.png [--out result.json] [--url-base http://127.0.0.1:PORT]\\n * 退出码: 0 全部通过; 1 有检查失败或运行错误。\\n */\\nimport { createRequire } from 'node:module';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\n\\nconst require = createRequire(import.meta.url);\\nlet chromium;\\ntry {\\n  ({ chromium } = require('playwright'));\\n} catch (e) {\\n  console.error('verify_animation: 无法加载 playwright: ' + e.message);\\n  process.exit(1);\\n}\\n\\nfunction arg(name, fallback = null) {\\n  const i = process.argv.indexOf('--' + name);\\n  return i > 0 ? process.argv[i + 1] : fallback;\\n}\\n\\nconst pagePath = process.argv[2];\\nif (!pagePath || !fs.existsSync(pagePath)) {\\n  console.error('verify_animation: 请提供存在的 HTML 路径');\\n  process.exit(1);\\n}\\nconst screenshot = arg('screenshot', 'screenshot.png');\\nconst resultOut = arg('out', null);\\nconst urlBase = arg('url-base', null); // 如提供则用 http 而非 file://\\n\\nconst url = urlBase\\n  ? urlBase.replace(/\\\\/$/, '') + '/' + path.basename(pagePath)\\n  : 'file://' + path.resolve(pagePath);\\n\\nconst result = {\\n  url,\\n  consoleErrors: [],\\n  pageErrors: [],\\n  checks: {},\\n  ok: false,\\n};\\n\\nfunction fail(msg) {\\n  result.checks[msg] = false;\\n}\\nfunction pass(msg, detail) {\\n  result.checks[msg] = detail === undefined ? true : detail;\\n}\\n\\nconst browser = await chromium.launch({\\n  executablePath: '/usr/bin/chromium',\\n  args: ['--no-sandbox'],\\n});\\ntry {\\n  const page = await browser.newPage({ viewport: { width: 1100, height: 760 } });\\n  page.on('console', (m) => {\\n    if (m.type() === 'error') result.consoleErrors.push(m.text());\\n  });\\n  page.on('pageerror', (e) => result.pageErrors.push(String(e)));\\n\\n  await page.goto(url, { waitUntil: 'load', timeout: 15000 });\\n\\n  const hasWrd = await page.evaluate(() => typeof window.WRD === 'object' && !!window.WRD.Loop);\\n  hasWrd ? pass('WRD scaffold 已加载') : fail('WRD scaffold 已加载');\\n\\n  const bootError = await page.$('.wrd-error');\\n  bootError ? fail('无启动错误') : pass('无启动错误');\\n  if (bootError) {\\n    result.bootError = (await bootError.textContent()).trim();\\n  }\\n\\n  // 播放中: rAF 帧数增长 + 画布像素实际变化\\n  await page.waitForTimeout(400);\\n  const shot = async () =>\\n    page.evaluate(() => document.getElementById('wrd-canvas').toDataURL());\\n  const f1 = await page.evaluate(() => window.WRD.frames);\\n  const c1 = await shot();\\n  await page.waitForTimeout(800);\\n  const f2 = await page.evaluate(() => window.WRD.frames);\\n  const c2 = await shot();\\n  (f2 > f1) ? pass('播放中帧数增长', { f1, f2 }) : fail('播放中帧数增长');\\n  (c1 !== c2) ? pass('播放中画面内容变化') : fail('播放中画面内容变化');\\n\\n  // HUD 时间在走\\n  const hudTime = () =>\\n    page.evaluate(() => {\\n      const rows = document.querySelectorAll('.wrd-hud-row');\\n      for (const r of rows) {\\n        if (r.children[0] && r.children[0].textContent.includes('时间')) {\\n          return parseFloat(r.children[1].textContent);\\n        }\\n      }\\n      return NaN;\\n    });\\n  const t1 = await hudTime();\\n  await page.waitForTimeout(600);\\n  const t2 = await hudTime();\\n  (!Number.isNaN(t1) && t2 > t1) ? pass('HUD 时间推进', { t1, t2 }) : fail('HUD 时间推进');\\n\\n  // 暂停后画面与时间冻结\\n  await page.click('.wrd-btn-toggle');\\n  await page.waitForTimeout(300);\\n  const label = await page.textContent('.wrd-btn-toggle');\\n  label.includes('继续') ? pass('暂停按钮切换为“继续”', label.trim()) : fail('暂停按钮切换为“继续”');\\n  const p1 = await page.evaluate(() => window.WRD.frames);\\n  const pc = await shot();\\n  const pt = await hudTime();\\n  await page.waitForTimeout(700);\\n  const p2 = await page.evaluate(() => window.WRD.frames);\\n  const pc2 = await shot();\\n  const pt2 = await hudTime();\\n  (p1 === p2 && pc === pc2 && pt === pt2)\\n    ? pass('暂停后帧与画面/时间冻结', { p1, p2, pt, pt2 })\\n    : fail('暂停后帧与画面/时间冻结');\\n\\n  // 继续后恢复\\n  await page.click('.wrd-btn-toggle');\\n  await page.waitForTimeout(500);\\n  const r1 = await page.evaluate(() => window.WRD.frames);\\n  await page.waitForTimeout(500);\\n  const r2 = await page.evaluate(() => window.WRD.frames);\\n  (r2 > r1) ? pass('继续后恢复播放') : fail('继续后恢复播放');\\n\\n  // 重置: HUD 时间归零且仍在播放\\n  await page.click('.wrd-btn-reset');\\n  const resetOk = await page\\n    .waitForFunction(\\n      () => {\\n        const rows = document.querySelectorAll('.wrd-hud-row');\\n        for (const r of rows) {\\n          if (r.children[0] && r.children[0].textContent.includes('时间')) {\\n            return parseFloat(r.children[1].textContent) < 0.4;\\n          }\\n        }\\n        return false;\\n      },\\n      { timeout: 2000 }\\n    )\\n    .then(() => true)\\n    .catch(() => false);\\n  resetOk ? pass('重置后 HUD 时间归零') : fail('重置后 HUD 时间归零');\\n  await page.waitForTimeout(300);\\n  const z1 = await page.evaluate(() => window.WRD.frames);\\n  await page.waitForTimeout(400);\\n  const z2 = await page.evaluate(() => window.WRD.frames);\\n  (z2 > z1) ? pass('重置后仍在播放') : fail('重置后仍在播放');\\n\\n  result.consoleErrorCount = result.consoleErrors.length;\\n  result.pageErrorCount = result.pageErrors.length;\\n  (result.consoleErrors.length === 0 && result.pageErrors.length === 0)\\n    ? pass('无console/页面错误')\\n    : fail('无console/页面错误');\\n\\n  await page.screenshot({ path: screenshot, fullPage: true });\\n  result.screenshot = path.resolve(screenshot);\\n  pass('截图已保存', result.screenshot);\\n} catch (e) {\\n  fail('脚本运行完成');\\n  result.runtimeError = String(e);\\n} finally {\\n  await browser.close();\\n}\\n\\nresult.ok = Object.values(result.checks).every((v) => v !== false);\\nif (resultOut) fs.writeFileSync(resultOut, JSON.stringify(result, null, 2));\\nconsole.log(JSON.stringify(result, null, 2));\\nprocess.exit(result.ok ? 0 : 1);\\n\",\"path\":\"/workspace/outputs/skill/scripts/verify_animation.mjs\"}"}}]},"finish_reason":null}]}

