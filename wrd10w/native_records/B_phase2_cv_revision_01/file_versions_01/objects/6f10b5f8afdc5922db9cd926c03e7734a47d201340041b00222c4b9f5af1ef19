{"content":"#!/usr/bin/env python3\n\"\"\"Extract per-page text + candidate identity from one or more CV PDFs.\n\nUsage:\n  cv_extract.py FILE.pdf [MORE.pdf ...] [--json OUT.json] [--raw]\n\nOutput (stdout, or written to --json): one JSON document\n  {\"results\": [ {file, candidate_id, sha256, bytes, page_count,\n                 identity_lines, pages:[{page, text}]} ],\n   \"errors\": [ {file, error} ]}\nExit codes: 0 all files extracted; 2 every file failed; 3 some failed.\nEach candidate is identified by content sha256 (candidate_id), so renamed\nfiles and multi-file batches never cross-mix candidates.\n\"\"\"\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport cvlib\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Extract per-page text from CV PDFs\")\n    ap.add_argument(\"files\", nargs=\"+\", help=\"one or more PDF paths\")\n    ap.add_argument(\"--json\", dest=\"json_out\", help=\"also write JSON report to this path\")\n    ap.add_argument(\"--raw\", action=\"store_true\", help=\"include raw cleaned lines per page\")\n    args = ap.parse_args()\n\n    results, errors = cvlib.extract_many(args.files)\n    if not args.raw:\n        for r in results:\n            for pg in r[\"pages\"]:\n                pg.pop(\"lines\", None)\n    report = {\"results\": results, \"errors\": errors}\n    payload = json.dumps(report, ensure_ascii=False, indent=2)\n    if args.json_out:\n        Path(args.json_out).write_text(payload, encoding=\"utf-8\")\n    print(payload)\n    if errors and len(errors) == len(args.files):\n        return 2\n    if errors:\n        return 3\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","role":"tool","tool_call_id":"call4d07dc3e4370452c815ea4687a946b74"}
