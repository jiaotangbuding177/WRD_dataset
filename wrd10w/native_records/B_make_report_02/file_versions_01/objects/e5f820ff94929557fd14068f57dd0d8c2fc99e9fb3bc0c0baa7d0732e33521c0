{"content":"{\n  \"schema\": \"wrd-v10-independently-verified-source-fields-v1\",\n  \"annotation_origin\": \"NEW_OFFLINE_AI_SILVER_ANNOTATION_FROM_SOURCE_AND_AUDIT_NOT_ORIGINAL_TEACHER_COT_OR_ACTION\",\n  \"source_ids\": [\n    \"conv_d1ef29d65e7a\",\n    \"conv_41874c950938\",\n    \"conv_246b5e915810\"\n  ],\n  \"source_split\": \"train\",\n  \"base_A_episode\": \"D:\\\\skillloop\\\\output\\\\20261027_wrd_main_v10\\\\runtime_preflight\\\\episodes\\\\A_screen_narrative_01\",\n  \"base_A_source_profiles_sha256\": \"6eb7f9945aae72bbdf6f287c57add13f66fd0d9b3a71cc8a9a2d9889e2084c25\",\n  \"verified_user_claim_groups\": [\n    {\n      \"source_id\": \"conv_d1ef29d65e7a\",\n      \"source_group_id\": \"v10_group_78010452aa3b5495ae3b\",\n      \"user_claim_fact_groups\": [\n        {\n          \"task_unit_id\": \"tu_1\",\n          \"facts\": [\n            {\n              \"claim\": \"项目经约一年研发并结合华东师大国家级全民数字素养与技能培训基地对20多个省市、不同学段一线教师的调研，发现备课、资料搜集、个性化作业布置与批改、行政事务、家校沟通持续占用教师精力\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"通过调研了20多个省市、覆盖不同学段的一线教师后发现：备课、资料搜集、个性化作业布置与批改、行政事务、家校沟通，正在持续蚕食教师精力\"\n                }\n              ]\n            },\n            {\n              \"claim\": \"云知师AI拆解为五大场景，集成40余项AI应用，覆盖80%的备课与教学外延工作，实测教师每周节省约13小时事务性劳动、教学效率提升85%\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"它将教师日常拆解为课前备课、课中增强、课后辅导、课外管理和教师终身发展五大场景，集成40余项AI应用，覆盖80%的备课与教学外延工作。实测显示，教师每周可节省约13小时事务性劳动，教学效率提升85%\"\n                }\n              ]\n            },\n            {\n              \"claim\": \"平台为华东师大师范生培养官方平台，用户覆盖32个省份3000+所学校，融合92.75%资深教师盲审采纳的优质教学经验\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"整体用户覆盖32个省份3000+所学校\"\n                },\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"融合了92.75%资深教师盲审采纳的优质教学经验\"\n                }\n              ]\n            },\n            {\n              \"claim\": \"2026年1月入驻国家智慧教育公共服务平台AI试验场模块，为教师教学板块6个AI智能工具之一\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"2026年1月，“云知师AI”正式入驻国家智慧教育公共服务平台“AI试验场”模块\"\n                },\n                {\n                  \"source_id\": \"conv_d1ef29d65e7a\",\n                  \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n                  \"quote\": \"成为入选核心模块“教师教学”板块的6个AI智能工具之一\"\n                }\n              ]\n            }\n          ]\n        }\n      ],\n      \"fact_verification_scope\": \"claim faithfully reflects supplied user material; external real-world truth unverified; not all mentioned facts are mandatory in a compressed output\"\n    },\n    {\n      \"source_id\": \"conv_41874c950938\",\n      \"source_group_id\": \"v10_group_e01ef7b301b343eaca00\",\n      \"user_claim_fact_groups\": [\n        {\n          \"task_unit_id\": \"tu_1\",\n          \"facts\": [\n            {\n              \"claim\": \"预计五年到款目标500万元为用户设定的规划目标\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_1\",\n                  \"quote\": \"具体项目合作和到款，预计五年500万\"\n                }\n              ]\n            },\n            {\n              \"claim\": \"AI教育落地资源含市级平台（上海市科技艺术教育中心、上海科技报）、四家区级校外教育机构、四所试点合作校；产学研合作资源含安恒信息上海分公司、上海超导科技、蜜柚网络科技、上海传英信息、上海大宗商品仓单登记五家单位\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_1\",\n                  \"quote\": \"试点合作校：上海市梅陇中学、上海市曹杨中学、上海市控江中学、上海市嘉定区江桥小学\"\n                },\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_1\",\n                  \"quote\": \"安恒信息技术股份有限公司上海分公司\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"task_unit_id\": \"tu_2\",\n          \"facts\": [\n            {\n              \"claim\": \"五年总到款目标500万元，底线目标300万、挑战目标500万、激进目标700万，均为用户规划目标\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_59\",\n                  \"quote\": \"预计五年总目标：500 万元\"\n                },\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_59\",\n                  \"quote\": \"底线目标 300 万，挑战目标 500 万，激进目标 700 万\"\n                }\n              ]\n            },\n            {\n              \"claim\": \"末轮素材含三部分：AI教育落地资源（市级/区级/试点校三级体系及各家合作方向）、产学研合作资源（五家单位及各家方向）、2026-2030五年实施节奏\",\n              \"epistemic_status\": \"user_provided_not_independently_verified\",\n              \"evidence_refs\": [\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_59\",\n                  \"quote\": \"市级平台包括上海市科技艺术教育中心（AI 科创课程共建、竞赛技术支持、教师培训）和上海科技报（成果传播、科普共建）\"\n                },\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_59\",\n                  \"quote\": \"上海大宗商品仓单登记有限责任公司（AI 风控与仓单匹配）\"\n                },\n                {\n                  \"source_id\": \"conv_41874c950938\",\n                  \"message_id\": \"conv_41874c950938:msg_59\",\n                  \"quote\": \"三、五年实施节奏\"\n                }\n              ]\n            }\n          ]\n        }\n      ],\n      \"fact_verification_scope\": \"claim faithfully reflects supplied user material; external real-world truth unverified; not all mentioned facts are mandatory in a compressed output\"\n    }\n  ],\n  \"independently_source_checked_requirements\": [\n    {\n      \"source_id\": \"conv_d1ef29d65e7a\",\n      \"requirement\": \"原素材整理为官方汇报，含建设成果/推广角度\",\n      \"evidence_refs\": [\n        {\n          \"source_id\": \"conv_d1ef29d65e7a\",\n          \"message_id\": \"conv_d1ef29d65e7a:msg_1\",\n          \"quote\": \"帮我把下面这段话做一个整体的整理，从建设成果，推广等各个角度，做一个官方的汇报\"\n        }\n      ]\n    },\n    {\n      \"source_id\": \"conv_d1ef29d65e7a\",\n      \"requirement\": \"600字以内；具体字符计数口径须在资源接口中说明\",\n      \"evidence_refs\": [\n        {\n          \"source_id\": \"conv_d1ef29d65e7a\",\n          \"message_id\": \"conv_d1ef29d65e7a:msg_5\",\n          \"quote\": \"600字以内\"\n        }\n      ]\n    },\n    {\n      \"source_id\": \"conv_41874c950938\",\n      \"requirement\": \"整合为一段话，不逐单位列金额明细\",\n      \"evidence_refs\": [\n        {\n          \"source_id\": \"conv_41874c950938\",\n          \"message_id\": \"conv_41874c950938:msg_29\",\n          \"quote\": \"帮我整理成一段话写到那个word里面，不要写这么详细，每个多少钱\"\n        }\n      ]\n    },\n  